# Tape::String::Writer's numbers and escaping, written in place on the tape.
Tape.run do
  inner = Tape::String.build(8) { |w| w.append("<b>") }
  text = Tape::String.build(16) do |w|
    w.append_int(0_i64)
    w.push(32_u8)
    w.append_int(-42)
    w.push(32_u8)
    w.append_int(9223372036854775807_i64)
    w.push(32_u8)
    w.append_int(-9223372036854775807_i64 - 1_i64)
    w.push(32_u8)
    w.append_html_escaped(%(a&b<c>"d'e))
    w.push(32_u8)
    w.append(inner)
  end
  puts text.to_s
end
