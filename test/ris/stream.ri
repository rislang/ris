# Tre: nested and empty containers, growth past the first room,
# stepping over subtrees, and the misuse it refuses.
tape do
  s = Tre(Int32).new(1)
  root = s.open(0)
  s.leaf(1)
  inner = s.open(2)
  s.leaf(3)
  s.leaf(4)
  s.close(inner)
  empty = s.open(5)
  s.close(empty)
  s.leaf(6)
  s.close(root)
  kids = Ary(Int32).new(4)
  s.each_child(root) { |i| kids << s[i] }
  grand = Ary(Int32).new(2)
  s.each_child(inner) { |i| grand << s[i] }
  none = 0
  s.each_child(empty) { none += 1 }
  kids_text = Str.build(16) { |writer| kids.join(writer, ",") }
  grand_text = Str.build(8) { |writer| grand.join(writer, ",") }
  puts "#{s.size} #{kids_text} #{grand_text} #{none} #{s.stop(root)}"
  s.close(inner)
end
