module test/smtp_tape

import std/smtp::{SmtpClient}

kept = ""
tape do
  data = ".one\n..two\rthree\r\nlast"
  expected = "..one\r\n...two\r\nthree\r\nlast\r\n.\r\n"
  w = String::Builder.new(1)
  w << "prefix:"
  SmtpClient.stuffed(data, w)
  exit 1 unless w.finish == "prefix:" + expected
  kept = SmtpClient.stuffed(data).to_heap
  exit 2 unless kept == expected
  exit 3 unless SmtpClient.stuffed("") == ".\r\n"
end
exit 4 unless SmtpClient.stuffed(".one\n..two\rthree\r\nlast") == kept
puts "PASS: smtp tape and heap APIs"
