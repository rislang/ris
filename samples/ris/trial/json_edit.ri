# Reads a JSON file, changes values and writes the result back.
module samples/trial/json_edit

import std/json::{JSON}

input = Program.args[0]
output = Program.args[1]
doc = JSON.parse(File.read(input))
result = String::Builder.new
result.json do |json|
  json.object do
    json.field "name", doc["name"].as_s
    json.field "version", doc["version"].as_i + 1
    json.field "tags" do
      json.array do
        doc["tags"].as_a.each { |tag| json.string tag.as_s }
        json.string "trial"
      end
    end
    json.field "meta" do
      json.object do
        json.field "stars", doc["meta"]["stars"].as_i + 5
      end
    end
  end
end
File.write(output, result.to_s)
puts File.read(output)
