# A queue made anew per refill keeps every old one on the tape until the
# block ends: refused, with `clear` named as the way out.
@[OnTape]
struct Queue
  @items : Ary(Int32)
  @next : Int32

  def initialize
    @items = Ary(Int32).new
    @next = 0
  end

  def take : Int32
    while @next >= @items.size
      @items = Ary(Int32).new if @next > 0
      @next = 0
      @items << 1
    end
    @next = @next + 1
    @items[@next - 1]
  end
end

tape do
  queue = Queue.new
  3.times { queue.take }
end
