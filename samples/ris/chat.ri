# A chat room: what lasts lives on the heap, each request on a tape.
#
#   ./bin/ris run samples/ris/chat.ri
#
# Read it as a Rails controller's `create`: `message_params`, the 403 when
# the user is not in the room, `create` saving the message, a view
# rendered. The params and the view are on the request's tape; `create`
# is the one place anything is copied to the heap.

module Chat
  # What outlives a request lives on the heap: users, the room, and the
  # messages posted in it.
  class User
    getter id : Int32
    getter name : String

    def initialize(*, @id : Int32, @name : String)
    end
  end

  class Message
    getter user : User
    getter body : String

    def initialize(*, @user : User, @body : String)
    end
  end

  class Room
    getter users = Array(User).new
    getter messages = Array(Message).new

    def user(id : Int32) : User?
      users.find { |user| user.id == id }
    end
  end

  # The request's message, as Rails' `message_params`: its body a view
  # into the request's bytes.
  @[OnTape]
  struct MessageParams
    getter user_id : Int32
    getter body : Tape::String

    def initialize(*, @user_id : Int32, @body : Tape::String)
    end
  end

  # The action: one request, start to end on one tape (`@[Tape]`). Its
  # bytes, the params and the rendered room are freed together when it
  # ends.
  @[Tape]
  def self.create_message(room : Room, request : String) : Nil
    params = message_params(request.as_tape)
    if params.nil?
      puts "400 bad request"
    elsif user = room.user(params.user_id)
      create(room, user, params)
      render_room(room)
    else
      puts "403 user #{params.user_id} is not in the room"
    end
  end

  # "7 Ship it": a user id, one space, the text. Nil when it is not.
  def self.message_params(request : Tape::String) : MessageParams?
    space = request.index(' ') || return nil
    user_id = request[0, space].to_i? || return nil
    body = request[space + 1, request.bytesize - space - 1]
    MessageParams.new(user_id: user_id, body: body)
  end

  # As `@room.messages.create!`: the one copy to the heap, as a posted
  # message outlives its request.
  def self.create(room : Room, user : User, params : MessageParams) : Nil
    room.messages << Message.new(user: user, body: params.body.to_heap)
  end

  # The view: the newest message first, then the users by name, all
  # written into one response on the tape.
  def self.render_room(room : Room) : Nil
    count = room.messages.size
    newest = Tape::Array(Int32).new(count) { |i| count - 1 - i }
    response = Tape::String::Writer.new(256)
    response << "200 "
    newest.each_with_index do |i, k|
      message = room.messages[i]
      response << " | " if k > 0
      response << message.user.name << ": " << message.body
    end
    response << " (users "
    names = Tape::Array(String).new(room.users.size) { |i| room.users[i].name }
    names.sort_in_place
    names.join(response, ", ")
    response << ")"
    puts response
  end
end

room = Chat::Room.new
room.users << Chat::User.new(id: 31, name: "carol")
room.users << Chat::User.new(id: 7, name: "alice")
room.users << Chat::User.new(id: 12, name: "bob")
Chat.create_message(room, "7 Morning!")
Chat.create_message(room, "12 Deploy is green")
Chat.create_message(room, "7 Ship it")
Chat.create_message(room, "99 Hi")
Chat.create_message(room, "hello")
puts "kept #{room.messages.size} messages"
