# Levelled logging with named sources.
#
# `Log.info "started"` writes an `Entry` — source, severity, message and
# the UTC instant it was made — through the root logger's backend.
# `Log.for("db.pool")` answers the logger for that source: a child of
# `db`, which is a child of the root, and the same object every time the
# name is asked for. A logger with no level or backend of its own uses
# its parent's, so `Log.setup(level, backend)` reconfigures the root in
# place and every logger already handed out follows it; a child given
# its own `level=` or `backend=` keeps that until it is set back to nil.
#
# Severities in order: Trace, Debug, Info, Notice, Warn, Error, Fatal, and
# None to silence a logger. An entry below the logger's level is dropped
# before its message is built, so `log.debug { expensive }` costs nothing
# when Debug is off. The default level is Info.
#
# Backends: `IOBackend` writes each entry to an IO through a `Formatter`
# (`DefaultFormatter`: `2024-02-29T15:30:45.123456Z INFO - source: message`,
# and `... INFO - message` at the root, the source and its `: ` left
# off); `MemoryBackend` keeps the entries for a test to read back. A
# `Backend` of your own is a class with `write(entry)` and `close`.
#
# Logging is synchronous: the entry is written before the call returns,
# in the calling thread, with no queue between.
#
# **Data.** An entry carries keys and values besides its message, from
# three places, each over the one before:
#
#     Log.with_context(request_id: id) do      # every entry in this task
#       db = Log.for("db").bind(pool: "main")  # every entry of a logger
#       db.info("query", rows: 3)              # one entry
#     end
#
# `with_context` holds for the block, in the task that runs it and in the
# tasks it starts, which find their starter's context while it is open -
# where the other library's new fiber starts with none. `DefaultFormatter`
# writes the data after the message, `... - db: query -- request_id=7
# pool=main rows=3`, a value with a space, quote or `=` in it quoted.
#
# `Log.setup_from_env` sets the root's level from `LOG_LEVEL`.

module std/log

import std/time::{Time}
import std/tuple
import std/log_text::{LogText, LogField}
import std/mutex::{Mutex}

pub enum Severity
  Trace  = 0
  Debug  = 1
  Info   = 2
  Notice = 3
  Warn   = 4
  Error  = 5
  Fatal  = 6
  None   = 7

  def label : String
    case value
    when 0 then "TRACE"
    when 1 then "DEBUG"
    when 2 then "INFO"
    when 3 then "NOTICE"
    when 4 then "WARN"
    when 5 then "ERROR"
    when 6 then "FATAL"
    else        "NONE"
    end
  end

  # The severity named by *name*, case-insensitively, or nil: what a
  # `LOG_LEVEL` variable holds.
  def self.parse?(name : String) : Severity?
    case name.downcase
    when "trace"  then Trace
    when "debug"  then Debug
    when "info"   then Info
    when "notice" then Notice
    when "warn"   then Warn
    when "error"  then Error
    when "fatal"  then Fatal
    when "none"   then None
    else               nil
    end
  end

  def self.parse(name : String) : Severity
    parse?(name) || raise "not a severity: #{name.inspect}"
  end

  def to_s : String
    label
  end

  def <(other : Severity) : Bool
    value < other.value
  end

  def <=(other : Severity) : Bool
    value <= other.value
  end

  def >=(other : Severity) : Bool
    value >= other.value
  end

  def >(other : Severity) : Bool
    value > other.value
  end
end

@[OnTape]
pub struct Entry
  getter source : String
  getter severity : Severity
  getter message : String
  getter timestamp : Time
  # The task's context, the logger's bound data and the call's own, in
  # that order, a later key's value over an earlier's.
  @data : Array::View(LogField)

  def data : Hash(String, String)
    fields = Hash(String, String).new(@data.size)
    each_data { |key, value| fields[key] = value }
    fields
  end

  def initialize(@source : String, @severity : Severity, @message : String, @timestamp : Time = Time.utc, data : Hash(String, String) = {} of String => String)
    @data = data.map { |key, value| LogField.new(key, value) }.view
  end

  def each_data(& : String, String -> Nil) : Nil
    @data.each { |field| yield field.key, field.value }
  end

  def tape_data : Array(LogField)
    fields = Array(LogField).new(@data.size)
    each_data do |key, value|
      fields << LogField.new(key.as_tape, value.as_tape)
    end
    fields
  end
end

# A synchronous entry borrows its text and metadata on the caller's tape.
@[OnTape]
pub struct TapeEntry
  getter source : String
  getter severity : Severity
  getter message : String
  getter timestamp : Time
  getter data : Array(LogField)

  def initialize(@source, @severity, @message, @timestamp, @data)
  end

  def each_data(& : String, String -> Nil) : Nil
    @data.each { |field| yield field.key, field.value }
  end

  def tape_data : Array(LogField)
    @data
  end

  # A retaining backend explicitly takes ownership of an old-style entry.
  def to_heap : Entry
    data = {} of String => String
    each_data { |key, value| data[key.to_heap] = value.to_heap }
    Entry.new(@source.to_heap, @severity, @message.to_heap, @timestamp, data)
  end
end

# Immutable encoded fields, oldest first. Tasks share only read-only tape
# bytes, never a tape class reference or a mutable collection handle.
@[OnTape]
@[Share]
pub struct Metadata
  getter bytes : String

  def initialize(key : String | String, value : String | String, rest : Metadata?)
    key = key.as_tape
    value = value.as_tape
    older = rest ? rest.bytes : "".as_tape
    size = 12 + key.bytesize + value.bytesize
    writer = String::Builder.new(older.bytesize + size)
    writer.append(older)
    writer.write_bytes(key.bytesize)
    writer.write_bytes(value.bytesize)
    writer.append(key)
    writer.append(value)
    writer.write_bytes(size)
    @bytes = writer.finish
  end

  # A child keeps its own bytes before its parent's context can close.
  def copy : Metadata
    writer = String::Builder.new(@bytes.bytesize)
    writer.append(@bytes)
    Metadata.new(writer.finish)
  end

  def self.combine(older : Metadata, newer : Metadata) : Metadata
    writer = String::Builder.new(older.bytes.bytesize + newer.bytes.bytesize)
    writer.append(older.bytes)
    writer.append(newer.bytes)
    Metadata.new(writer.finish)
  end

  def self.from_bytes(bytes : String) : Metadata
    new(bytes)
  end

  protected def initialize(@bytes : String)
  end

  private def last_at : Int32
    @bytes.bytesize - @bytes.read_bytes_at(Int32, @bytes.bytesize - 4)
  end

  def key : String
    at = last_at
    @bytes[at + 8, @bytes.read_bytes_at(Int32, at)]
  end

  def value : String
    at = last_at
    count = @bytes.read_bytes_at(Int32, at)
    @bytes[at + 8 + count, @bytes.read_bytes_at(Int32, at + 4)]
  end

  def rest : Metadata?
    at = last_at
    at == 0 ? nil : Metadata.new(@bytes[0, at])
  end

  def each(& : String, String -> Nil) : Nil
    Metadata.each_field(@bytes) { |key, value| yield key, value }
  end

  def self.each_field(bytes : String, & : String, String -> Nil) : Nil
    at = 0
    while at < bytes.bytesize
      keys = bytes.read_bytes_at(Int32, at)
      values = bytes.read_bytes_at(Int32, at + 4)
      yield bytes[at + 8, keys], bytes[at + 8 + keys, values]
      at += 12 + keys + values
    end
  end

  def self.count_fields(bytes : String) : Int32
    count = 0
    each_field(bytes) { |_, _| count += 1 }
    count
  end

  def merge_into(into : Hash(String, String)) : Nil
    each { |key, value| into[key.to_heap] = value.to_heap }
  end

  def append_into(fields : Array(LogField)) : Nil
    each { |key, value| LogField.set(fields, key, value) }
  end

  def to_h : Hash(String, String)
    found = {} of String => String
    merge_into(found)
    found
  end
end

pub abstract class Formatter
  abstract def format(entry : Entry) : String

  # The line written onto a tape, then into *io* in one write.
  def format(entry : Entry | TapeEntry, io : IO) : Nil
    tape do
      w = String::Builder.new
      format(entry, w)
      w.push(10_u8)
      line = w.finish
      write_line(io, line)
    end
  end

  # IO's byte write interface requires a pointer and a byte count.
  @[TapeUnsafe]
  private def write_line(io : IO, line : String) : Nil
    io.write(line.to_unsafe, line.bytesize)
  end

  # The line written into the caller's *writer*: `format(entry)` unless a
  # formatter writes it there itself.
  def format(entry : Entry, writer : String::Builder) : Nil
    writer << format(entry)
  end
  def format(entry : TapeEntry, writer : String::Builder) : Nil
    writer << format(entry.to_heap)
  end
end

pub class DefaultFormatter < Formatter
  def format(entry : Entry) : String
    line = ""
    tape do
      w = String::Builder.new
      format(entry, w)
      line = w.finish.to_heap
    end
    line
  end

  def format(entry : Entry | TapeEntry, writer : String::Builder) : Nil
    DefaultFormatter.write(entry, writer)
  end

  def self.write(entry : Entry | TapeEntry, io : IO) : Nil
    tape do
      writer = String::Builder.new
      write(entry, writer)
      writer << '\n'
      write_line(io, writer.finish)
    end
  end

  # IO accepts bytes only for this synchronous write.
  @[TapeUnsafe]
  private def self.write_line(io : IO, line : String) : Nil
    io.write(line.to_unsafe, line.bytesize)
  end

  # Also usable without constructing a formatter or backend.
  def self.write(entry : Entry | TapeEntry, writer : String::Builder) : Nil
    entry.timestamp.to_rfc3339(6, writer)
    fields = entry.tape_data
    LogText.write(entry.source.as_tape, entry.severity.label.as_tape,
      entry.message.as_tape, fields, writer)
  end
end

@[OnTape]
pub abstract class Backend
  abstract def write(entry : Entry) : Nil
  abstract def close : Nil

  def write(entry : TapeEntry) : Nil
    write(entry.to_heap)
  end
end

@[OnTape]
pub class IOBackend < Backend
  def self.on_program(io : IO, formatter : Formatter? = nil) : IOBackend
    backend = RisRegion.program_object(IOBackend)
    backend.initialize(io, formatter)
    backend
  end

  @formatter : Formatter?
  getter io : IO

  def initialize(@io : IO, @formatter : Formatter? = nil)
  end

  def formatter : Formatter
    @formatter ||= DefaultFormatter.new
  end

  def formatter=(formatter : Formatter) : Formatter
    @formatter = formatter
  end

  def write(entry : Entry | TapeEntry) : Nil
    if formatter = @formatter
      formatter.format(entry, @io)
    else
      DefaultFormatter.write(entry, @io)
    end
    @io.flush
  end

  def close : Nil
    @io.flush
  end
end

@[OnTape]
pub struct RisLogEntry
  getter source : String
  getter severity : Severity
  getter message : String
  @data : String
  @seconds : Int64
  @nanoseconds : Int32

  def initialize(entry : TapeEntry)
    @source, @severity, @message = entry.source, entry.severity, entry.message
    @data = String.build do |writer|
      entry.each_data do |key, value|
        writer.write_bytes(key.bytesize)
        writer.write_bytes(value.bytesize)
        writer << key << value
        writer.write_bytes(12 + key.bytesize + value.bytesize)
      end
    end
    @seconds, @nanoseconds = entry.timestamp.seconds, entry.timestamp.nanoseconds
  end

  def tape_entry : TapeEntry
    TapeEntry.new(@source, @severity, @message,
      Time.unix(@seconds, @nanoseconds), data)
  end

  def data : Array(LogField)
    fields = Array(LogField).new(Metadata.count_fields(@data))
    Metadata.each_field(@data) do |key, value|
      fields << LogField.new(key, value)
    end
    fields
  end
end

# A caller-owned backend retains entry bytes on the explicit program owner.
# Its container belongs to the caller and is reused by clear.
@[OnTape]
pub class RisMemoryBackend < Backend
  getter entries : Array(RisLogEntry)

  def initialize(@owner : Program::TapeOwner)
    @entries = Array(RisLogEntry).new
  end

  def write(entry : TapeEntry) : Nil
    @entries << RisLogEntry.new(entry).copy_to(@owner)
  end

  def write(entry : Entry) : Nil
    write(TapeEntry.new(entry.source.as_tape, entry.severity,
      entry.message.as_tape, entry.timestamp, entry.tape_data))
  end

  def output : Array(String)
    lines = Array(String).new(@entries.size)
    @entries.each do |entry|
      lines << String.build do |writer|
        DefaultFormatter.write(entry.tape_entry, writer)
      end
    end
    lines
  end

  def clear : Nil
    @entries.clear
  end

  def close : Nil
  end
end

@[OnTape]
pub class MemoryBackend < Backend
  property formatter : Formatter
  getter entries : Array(Entry)

  def initialize(@formatter : Formatter = DefaultFormatter.new)
    @entries = [] of Entry
  end

  def write(entry : Entry) : Nil
    @entries << entry
  end

  def close : Nil
  end

  # The entries as the formatter would have written them.
  def output : Array(String)
    @entries.map { |e| @formatter.format(e) }
  end

  def clear : Nil
    @entries.clear
  end
end

# Entries written by a thread of their own, so a call that logs does not
# wait for the write: the entry is formatted where it is logged and
# queued, and a writer thread writes what has queued up since its last
# write, in order, in one write, to *io*'s descriptor.
#
#     AsyncBackend.open do |backend|   # closed, and drained, at the end
#       Log.setup(Severity::Info, backend)
#       ...
#     end
#
# `close` waits for every queued entry to be written and the thread to
# end; an entry written after it is refused. Entries queued when a program
# ends without `close` are lost, which the block form rules out. The
# backend is the thread that made it's, as every object not Share is.
#
# A thread needs the collector and a target with threads: under
# `-Dgc_none` or `-Dgc_boehm`, or on another target, `new` refuses.
@[OnTape]
pub class AsyncBackend < Backend
  property formatter : Formatter
  @queue : Mutex(AsyncQueue)
  @closed : Bool
  {% if !flag?(:gc_none) && !flag?(:gc_boehm) && ((flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) || (flag?(:win32) && flag?(:x86_64))) %}
    @writer : IyiThread? = nil
  {% end %}

  def initialize(io : IO = STDOUT, @formatter : Formatter = DefaultFormatter.new)
    @queue = Mutex.new { AsyncQueue.new }
    @closed = false
    handle = io.handle
    raise "AsyncBackend: the IO has no descriptor to write to" if handle < 0_i64
    {% if !flag?(:gc_none) && !flag?(:gc_boehm) && ((flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) || (flag?(:win32) && flag?(:x86_64))) %}
      queue = @queue
      @writer = IyiThread.start do
        out = IyiIO.new(handle)
        while true
          batch = queue.wait_for { |q| q.take }
          # A thread is no task, and nothing cancels it.
          raise "AsyncBackend: the writer thread was cancelled" if batch.is_a?(Cancelled)
          out.write(batch[0])
          out.flush
          break if batch[1]
        end
        nil
      end
    {% else %}
      raise "AsyncBackend: this build has no threads to write with (the collector's threads, on Linux, darwin arm64 and Windows x86_64)"
    {% end %}
  end

  # A backend for the block, closed and drained when the block ends.
  def self.open(io : IO = STDOUT, formatter : Formatter = DefaultFormatter.new, &block : AsyncBackend -> R) : R forall R
    backend = new(io, formatter)
    defer backend.close
    block.call(backend)
  end

  def write(entry : Entry) : Nil
    raise "AsyncBackend: an entry written after close" if @closed
    line = @formatter.format(entry) + "\n"
    while true
      return unless @queue.lock { |q| q.push(line) }.is_a?(Cancelled)
    end
  end

  def close : Nil
    return if @closed
    @closed = true
    while true
      break unless @queue.lock { |q| q.close }.is_a?(Cancelled)
    end
    {% if !flag?(:gc_none) && !flag?(:gc_boehm) && ((flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) || (flag?(:win32) && flag?(:x86_64))) %}
      if writer = @writer
        writer.join
      end
    {% end %}
  end
end

# The lines an `AsyncBackend` has queued, behind its Mutex.
@[OnTape]
class AsyncQueue
  @lines : Array(String)
  @closed : Bool

  def initialize
    @lines = [] of String
    @closed = false
  end

  def push(line : String) : Nil
    @lines << line
  end

  def close : Nil
    @closed = true
  end

  # Every line queued, as one string, and whether the queue is closed:
  # nil while it is empty and open, which the writer waits through.
  def take : {String, Bool}?
    return nil if @lines.empty? && !@closed
    text = @lines.join
    @lines.clear
    {text, @closed}
  end
end

# Only read-only text crosses into this scratch writer. A tape logger's
# methods may retain storage in its fields; this writer retains none.
struct EntryWriter
  def self.write_entry(source : String, b : Backend, bound : String,
                       severity : Severity, message : String, **data) : Nil
    tape do
      count = data.size + Log.context_size + Metadata.count_fields(bound)
      fields = Array(LogField).new(count)
      Log.context_into(fields)
      Metadata.each_field(bound) { |key, value| LogField.set(fields, key, value) }
      data.each do |key, value|
        name = key.to_s.as_tape
        text = LogField.text(value)
        LogField.set(fields, name, text)
      end
      b.write(TapeEntry.new(source.as_tape, severity, message,
        Time.utc, fields))
    end
  end
end

@[OnTape]
pub class Logger
  def self.on_program(source : String, level : Severity? = nil,
                      backend : Backend? = nil) : Logger
    logger = RisRegion.program_object(Logger)
    logger.initialize(RisRegion.program_text(source), level, backend)
    logger
  end

  getter source : String
  @level : Severity?
  @backend : Backend?
  @parent : Logger?
  @children : Array(Logger)?
  # What `bind` gave this logger, on every entry it and its children write.
  @bound : Metadata?

  def initialize(@source : String, level : Severity? = nil, backend : Backend? = nil, parent : Logger? = nil, bound : Metadata? = nil)
    @level = level
    @backend = backend
    @parent = parent
    @children = nil
    @bound = bound
    if bound && parent
      if older = parent.bound_node
        @bound = Metadata.combine(older, bound)
      end
    end
  end

  # A logger for the same source, its level and backend this one's, whose
  # entries all carry *data*: a request's id, a connection's peer.
  def bind(**data) : Logger
    node = nil.as(Metadata?)
    data.each do |key, value|
      node = Metadata.new(key.to_s.as_tape, LogField.text(value), node)
    end
    Logger.new(@source, nil, nil, self, node)
  end

  # This logger's own level, or the nearest ancestor's; Info at a root
  # never given one.
  def level : Severity
    if l = @level
      l
    elsif p = @parent
      p.level
    else
      Severity::Info
    end
  end

  # nil hands the decision back to the parent.
  def level=(lvl : Severity?) : Nil
    @level = lvl
  end

  def own_level : Severity?
    @level
  end

  # This logger's own backend, or the nearest ancestor's; nil silences.
  def backend : Backend?
    if b = @backend
      b
    elsif p = @parent
      p.backend
    else
      nil
    end
  end

  def backend=(b : Backend?) : Nil
    @backend = b
  end

  def own_backend : Backend?
    @backend
  end

  # The logger for *child_name* under this one, created on first ask;
  # `"a.b"` is the child `b` of the child `a`.
  def for(child_name : String) : Logger
    return self if child_name.empty?

    parts = child_name.split('.')
    current = self
    parts.each do |part|
      current = current.get_or_create_child(part)
    end
    current
  end

  protected def get_or_create_child(name : String) : Logger
    children = @children
    if children
      suffix = @parent.nil? && @source.empty? ? name : "#{@source}.#{name}"
      children.each { |child| return child if child.source == suffix }
    end

    # Only the root drops the dot: a child named "" under it has an empty
    # source too, and `Log.for(".a")` answered "a", the source of another
    # logger.
    child_source = @parent.nil? && @source.empty? ? name : "#{@source}.#{name}"
    child = Logger.new(child_source, nil, nil, self)
    unless children
      children = Array(Logger).new
      @children = children
    end
    children << child
    child
  end

  # None is a level and not a severity: an entry logged at None was
  # written by a logger set to None, the one level meant to write nothing.
  def log(severity : Severity, message : String, **data) : Nil
    log(severity, message.as_tape, **data)
  end

  def log(severity : Severity, message : String, **data) : Nil
    return if severity < level || severity == Severity::None
    if b = backend
      node = bound_node
      bytes = node ? node.bytes : "".as_tape
      EntryWriter.write_entry(@source, b, bytes, severity, message, **data)
    end
  end

  def log(severity : Severity, **data, &block : -> String) : Nil
    return if severity < level || severity == Severity::None
    return unless backend
    log(severity, block.call.as_tape, **data)
  end

  protected def bound_node : Metadata?
    if bound = @bound
      bound
    elsif parent = @parent
      parent.bound_node
    else
      nil
    end
  end

  def trace(message : String | String, **data) : Nil
    log(Severity::Trace, message, **data)
  end

  def trace(**data, &b : -> String) : Nil
    log(Severity::Trace, **data, &b)
  end

  def debug(message : String | String, **data) : Nil
    log(Severity::Debug, message, **data)
  end

  def debug(**data, &b : -> String) : Nil
    log(Severity::Debug, **data, &b)
  end

  def info(message : String | String, **data) : Nil
    log(Severity::Info, message, **data)
  end

  def info(**data, &b : -> String) : Nil
    log(Severity::Info, **data, &b)
  end

  def notice(message : String | String, **data) : Nil
    log(Severity::Notice, message, **data)
  end

  def notice(**data, &b : -> String) : Nil
    log(Severity::Notice, **data, &b)
  end

  def warn(message : String | String, **data) : Nil
    log(Severity::Warn, message, **data)
  end

  def warn(**data, &b : -> String) : Nil
    log(Severity::Warn, **data, &b)
  end

  def error(message : String | String, **data) : Nil
    log(Severity::Error, message, **data)
  end

  def error(**data, &b : -> String) : Nil
    log(Severity::Error, **data, &b)
  end

  def fatal(message : String | String, **data) : Nil
    log(Severity::Fatal, message, **data)
  end

  def fatal(**data, &b : -> String) : Nil
    log(Severity::Fatal, **data, &b)
  end

  def trace? : Bool
    level <= Severity::Trace
  end

  def debug? : Bool
    level <= Severity::Debug
  end

  def info? : Bool
    level <= Severity::Info
  end

  def notice? : Bool
    level <= Severity::Notice
  end

  def warn? : Bool
    level <= Severity::Warn
  end

  def error? : Bool
    level <= Severity::Error
  end

  def fatal? : Bool
    level <= Severity::Fatal
  end
end

# The root logger and the calls that go straight to it.
pub class Log
  @@root : Logger?

  def self.root : Logger
    if r = @@root
      r
    else
      logger = Logger.on_program("", Severity::Info, IOBackend.on_program(STDOUT))
      @@root = logger
      logger
    end
  end

  # Reconfigures the root in place, so loggers obtained earlier follow.
  def self.setup(level : Severity = Severity::Info, backend : Backend = IOBackend.on_program(STDOUT)) : Logger
    r = root
    r.level = level
    r.backend = backend
    r
  end

  # `setup`, the level read from *variable* - a severity's name, any case
  # - or *default_level* when it is unset or empty. A name that is no
  # severity is refused, the severities named.
  def self.setup_from_env(default_level : Severity = Severity::Info, backend : Backend = IOBackend.on_program(STDOUT), variable : String = "LOG_LEVEL") : Logger
    level = default_level
    if name = Program.env(variable)
      unless name.strip.empty?
        level = Severity.parse?(name.strip) || raise "Log.setup_from_env: #{variable}=#{name} is no severity (trace, debug, info, notice, warn, error, fatal or none)"
      end
    end
    setup(level, backend)
  end

  def self.for(source : String) : Logger
    root.for(source)
  end

  # Encoded contexts live in pool runs; overwrite and delete reuse bytes.
  @@contexts : Hash(UInt64, String) =
    Hash(UInt64, String).new.copy_to(Program.tape)
  # Static cleanup releases this lock without a callback environment
  # capturing either the lock receiver or task-owned metadata.
  class ContextLock < Mutex(Int32)
    def self.on_program : ContextLock
      lock = RisRegion.program_object(ContextLock)
      lock.initialize(0)
      lock
    end

    def enter : Cancelled?
      acquire
    end

    def leave : Nil
      release
    end
  end

  @@context_lock : ContextLock = ContextLock.on_program
  @@open : Atomic(UInt64) = Atomic(UInt64).new(0_u64)

  # Runs the block with *data* on every entry logged in this task and in
  # the tasks it starts, over the context already open, and answers the
  # block's answer. The context before it is back when the block ends,
  # panic or not.
  def self.with_context(**data, &block : -> R) : R forall R
    id = task_key
    own = context_of(id, true)
    node = context_node
    data.each do |key, value|
      node = Metadata.new(key.to_s.as_tape, LogField.text(value), node)
    end
    @@open.add(1_u64)
    store(id, node)
    defer restore(id, own)
    yield
  end

  def self.has_context? : Bool
    @@open.get != 0_u64
  end

  def self.context_size : Int32
    return 0 unless has_context?
    size = 0
    node = context_node
    while node
      size += 1
      node = node.rest
    end
    size
  end

  def self.context_into(fields : Array(LogField)) : Nil
    return unless has_context?
    if node = context_node
      node.append_into(fields)
    end
  end

  # The data this task's open contexts give an entry, the outermost first.
  def self.context : Hash(String, String)
    found = {} of String => String
    return found if @@open.get == 0_u64
    if node = context_node
      node.merge_into(found)
    end
    found
  end

  # This task's key in the table, its fiber's id; 0 on wasm32, which has
  # no tasks, its one program the one task.
  private def self.task_key : UInt64
    {% if flag?(:wasm32) %}
      0_u64
    {% else %}
      IyiScheduler.current.object_id
    {% end %}
  end

  # The innermost context open for this task: its own, or the nearest
  # starter's, up the groups that started it.
  private def self.context_node : Metadata?
    {% if flag?(:wasm32) %}
      context_of(0_u64)
    {% else %}
      current = IyiScheduler.current
      fiber = current
      while true
        if node = context_of(fiber.object_id, fiber != current)
          return node
        end
        group = fiber.group
        return nil unless group
        fiber = group.owner
      end
    {% end %}
  end

  # The table's blocks never park, so a wait for it is another thread's
  # moment, and a cancelled task, which a wait answers Cancelled, asks
  # again.
  private def self.context_of(id : UInt64, copy : Bool = false) : Metadata?
    while @@context_lock.enter.is_a?(Cancelled)
    end
    defer @@context_lock.leave
    node = context_locked(id)
    copy && node ? node.copy : node
  end

  protected def self.context_locked(id : UInt64) : Metadata?
    bytes = @@contexts[id]?
    bytes ? Metadata.from_bytes(bytes) : nil
  end

  private def self.store(id : UInt64, node : Metadata?) : Nil
    while @@context_lock.enter.is_a?(Cancelled)
    end
    defer @@context_lock.leave
    store_locked(id, node)
  end

  protected def self.store_locked(id : UInt64, node : Metadata?) : Nil
    if node
      @@contexts[id] = node.bytes
    else
      @@contexts.delete(id)
    end
    nil
  end

  private def self.restore(id : UInt64, own : Metadata?) : Nil
    store(id, own)
    @@open.sub(1_u64)
  end

  def self.level : Severity
    root.level
  end

  def self.level=(level : Severity) : Nil
    root.level = level
  end

  def self.backend : Backend?
    root.backend
  end

  def self.backend=(backend : Backend?) : Nil
    root.backend = backend
  end

  def self.trace(msg : String | String, **data) : Nil
    root.trace(msg, **data)
  end

  def self.trace(**data, &b : -> String) : Nil
    root.trace(**data, &b)
  end

  def self.debug(msg : String | String, **data) : Nil
    root.debug(msg, **data)
  end

  def self.debug(**data, &b : -> String) : Nil
    root.debug(**data, &b)
  end

  def self.info(msg : String | String, **data) : Nil
    root.info(msg, **data)
  end

  def self.info(**data, &b : -> String) : Nil
    root.info(**data, &b)
  end

  def self.notice(msg : String | String, **data) : Nil
    root.notice(msg, **data)
  end

  def self.notice(**data, &b : -> String) : Nil
    root.notice(**data, &b)
  end

  def self.warn(msg : String | String, **data) : Nil
    root.warn(msg, **data)
  end

  def self.warn(**data, &b : -> String) : Nil
    root.warn(**data, &b)
  end

  def self.error(msg : String | String, **data) : Nil
    root.error(msg, **data)
  end

  def self.error(**data, &b : -> String) : Nil
    root.error(**data, &b)
  end

  def self.fatal(msg : String | String, **data) : Nil
    root.fatal(msg, **data)
  end

  def self.fatal(**data, &b : -> String) : Nil
    root.fatal(**data, &b)
  end
end
