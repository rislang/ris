module test/ris/refused/proc_capture

import std/int

@[OnTape]
struct Resp
  getter id : Int64
  getter user : Tape::String

  def initialize(@id : Int64, @user : Tape::String)
  end
end

def make : Resp
  Resp.new(1_i64, Tape::String.build { |s| s.push(97_u8) })
end

# A proc may be called after the scope has ended.
Tape.scope do
  r = make
  callback = -> { r.id }
  puts callback.call
end
