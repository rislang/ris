# Rows use fixed run handles; refill the temporary row after copying.
@[OnTape]
struct Table
  getter rows : Ary(SlicePool::Run(Int32))
  @pool : SlicePool(Int32)
  @row : Ary(Int32)

  def initialize
    @rows = Ary(SlicePool::Run(Int32)).new
    @pool = SlicePool(Int32).new
    @row = Ary(Int32).new
  end

  def add(value : Int32) : Nil
    @row << value
  end

  def end_row : Nil
    row = @pool.alloc_slice(@row.size)
    i = 0
    while i < @row.size
      row[i] = @row[i]
      i += 1
    end
    @rows << row
    @row.clear
  end

  def take : Ary(Int32)
    batch = @row
    @row = Ary(Int32).new
    batch
  end
end

tape do
  table = Table.new
  table.add(1)
  table.add(2)
  table.end_row
  table.add(3)
  table.end_row
  table.add(4)
  last = table.take
  puts "#{table.rows.size} #{table.rows[0].size} #{table.rows[1][0]} #{last[0]}"
end
