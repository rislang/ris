module test/ris/refused/class_var

import std/int

@[OnTape]
struct Resp
  getter id : Int64
  getter user : Str

  def initialize(@id : Int64, @user : Str)
  end
end

def make : Resp
  Resp.new(1_i64, Str.build { |s| s.push(97_u8) })
end

# A class variable lives as long as the program.
class Last
  @@resp : Resp? = nil

  def self.keep(r : Resp) : Nil
    @@resp = r
  end
end

tape { Last.keep(make) }
