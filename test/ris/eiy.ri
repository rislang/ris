module test/eiy_driver

import std/eiy::{Eiy}

tape do
  text = "héllo <%= name %>"
  w = String::Builder.new(1)
  w << "prefix:"
  Eiy.process_string(text, w)
  code = Eiy.process_string(text)
  lexer = Eiy::TapeLexer.new("abc<%=x%>")
  first = lexer.next_token
  second = lexer.next_token
  nil
end
puts "PASS: eiy on the tape"
