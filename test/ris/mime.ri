module test/mime_tape

import std/mime::{MIME}

kept = ""
tape do
  parsed = MIME.parse?(" Text/HTML; X=one; x=\"two\\ words\"".as_tape)
  exit 1 unless parsed
  exit 2 unless parsed.essence == "text/html"
  exit 3 unless parsed.params["x"] == "two words"
  exit 4 unless MIME.parse?("a/b; x=\"bad".as_tape).nil?
  exit 5 unless MIME.from_extension("dir/INDEX.HTML".as_tape) == "text/html"
  exit 6 unless MIME.extensions("TEXT/HTML".as_tape).to_heap ==
                [".htm", ".html"]
  exit 15 unless MIME.compressible?("application/wasm".as_tape)
  exit 16 if MIME.compressible?("image/png".as_tape)
  exit 7 unless MIME.compressible?("application/a+json".as_tape)
  w = Tape::String::Writer.new(1)
  w << "prefix:"
  MIME.with_charset("text/html".as_tape, w)
  exit 8 unless w.finish == "prefix:text/html; charset=utf-8"
  kept = MIME.with_charset("text/html; charset=ascii".as_tape).to_heap
end
exit 9 unless kept == "text/html; charset=ascii"
exit 10 unless MIME.with_charset("text/plain") ==
               "text/plain; charset=utf-8"
exit 11 unless MIME.parse?("a/b; x=y") == {"a/b", {"x" => "y"}}
exit 12 unless MIME.from_extension("x.JSON") == "application/json"
exit 13 unless MIME.extensions("text/html") == [".htm", ".html"]
exit 14 unless MIME.compressible?("text/plain")
puts "PASS: mime tape and heap APIs"
