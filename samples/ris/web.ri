# web: a small web server, each request on its own tape.
#
#   ./bin/ris build -o web samples/ris/web.ri && ./web
#   curl http://localhost:3000/users/1/status
#
# `Server.answer` reads each request onto a tape, hands the block the
# request (`req`, its path a view into the bytes read) and a response
# (`res`) to write into, sends it, and frees the tape: the request, the
# view's HTML and every temporary go at once, with nothing to collect.
# Only the users table lives on, on the heap.

module samples/web

import std/socket::{IyiSocket}
import std/http::{Server, Incoming, Outgoing}

USERS = {
  1 => {"alice", "Learning sequential memory management :-)"},
  2 => {"bob", "Bumping pointers, freeing nothing"},
}

# The user id in "/users/1/status", or nil when the path is another one.
def status_id(path : Str) : Int32?
  parts = path.split('/')
  return nil unless parts.size == 4 && parts[1] == "users"
  return nil unless parts[3] == "status"
  parts[2].to_i?
end

# The view, as a Slim template would write it:
#
#   h1 = name
#   p.status = status
#
# Written straight into the response body on the request's tape, the
# text HTML-escaped on the way.
def status_view(res : Outgoing, name : String, status : String) : Nil
  res.header("Content-Type", "text/html; charset=utf-8")
  html = res.body
  html << "<h1>"
  html.append_html_escaped(name)
  html << "</h1>\n<p class=\"status\">"
  html.append_html_escaped(status)
  html << "</p>\n"
end

def not_found(res : Outgoing) : Nil
  res.status = 404
  res.header("Content-Type", "text/plain")
  res.body << "Not Found\n"
end

port = Program.args.empty? ? 3000 : Program.args[0].to_i
listener = IyiSocket.listen(port)
puts "listening on http://localhost:#{listener.local_port}/users/1/status"

Server.answer(listener) do |req, res|
  if req.method == "GET" && (id = status_id(req.path)) && (user = USERS[id]?)
    status_view(res, user[0], user[1])
  else
    not_found(res)
  end
end
