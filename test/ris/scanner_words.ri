# The same lexer on String::Scanner: no warning.
@[OnTape]
struct Words
  @scanner : String::Scanner

  def initialize(text : String)
    @scanner = String::Scanner.new(text)
  end

  def count : Int32
    n = 0
    while byte = @scanner.current_byte
      n += 1 if byte == 32
      @scanner.skip(1)
    end
    n
  end
end

tape do
  puts Words.new("a b c").count
end
