# Failure modes run in subprocesses: no heap or incidental output.
@[Ffi]
module test/ris/size_failure

@[OnTape]
struct Lexer
  def initialize
    @sc = Str::Scanner.new(Str.new("x"))
  end

  def overflow
    while @sc.offset < @sc.string.bytesize
      @sc.advance(2147483647)
      @sc.advance
    end
  end
end

case ARGV_UNSAFE[1][0]
when 97 # a: count cannot fit the tape type's public Int32 length.
  Ary(UInt8).new(2147483648_i64)
when 98 # b: check element bytes before narrowing a huge count.
  Ary(UInt64).new(4611686018427387904_i64)
when 99
  Ary(Int32).new(-1)
when 100
  Str::Builder.new(-1)
when 101
  Tre(Int32).new(-1)
when 102
  Str::Builder.new.reserve(-1)
when 103
  Str::Builder.new.reserve(2147483648_i64)
when 104
  Str.new("ab") * 2147483647
when 105
  IyiRegion.mapping_length(18446744073709551615_u64)
when 106
  IyiRegion.mapping_length(18446744073709551551_u64)
when 107
  IyiRegion.tape_bytes(18446744073709551615_u64)
when 108
  IyiRegion.tape_bytes(18446744073709551608_u64)
when 109
  IyiRegion.tape = 0_u64
  IyiRegion.tape_bytes(1_u64)
when 110
  IyiRegion.acquire(4611686018427387904_u64)
when 111
  side = 0_u64
  IyiRegion.tape_resize(0_u64, 0_u64, 0_u64,
    4611686018427387904_u64, pointerof(side))
when 112
  IyiRegion.nonnegative(-9223372036854775808_i64)
when 113
  Tape.grown(2147483647_u64)
when 114
  scanner = Str::Scanner.new(Str.new("x"))
  scanner.advance(2147483647)
  scanner.advance
when 115
  scanner = Str::Scanner.new(Str.new("x"))
  scanner.advance(-2147483648)
  scanner.advance(-1)
when 116
  Lexer.new.overflow
when 117
  side = 0_u64
  start = IyiRegion.tape_bytes(8_u64)
  IyiRegion.tape_bytes(8_u64)
  IyiRegion.tape_resize(start, start + 8_u64, 8_u64,
    16_u64, pointerof(side))
end
