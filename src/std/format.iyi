# Format strings for iyi.
#
# Provides `sprintf`, `printf`, and `String.format` / `String#%` with
# standard format specifiers:
#
#   `%[flags][width][.precision]specifier`
#
# Supported specifiers:
#   %s - string (Object#to_s)
#   %p - inspected value (Object#inspect)
#   %c - character (Char or integer ASCII code)
#   %d, %i - signed decimal integer
#   %u - unsigned decimal integer
#   %x - hexadecimal lowercase
#   %X - hexadecimal uppercase
#   %o - octal integer
#   %b - binary integer
#   %f - floating point in fixed-point decimal notation
#   %e - floating point in scientific notation (lowercase e)
#   %E - floating point in scientific notation (uppercase E)
#   %g - the shorter of %f and %e, trailing zeros trimmed (C's rule)
#   %G - the same, with an uppercase E
#   %% - literal percent sign
#
# Flags:
#   -  left-align within field (default right-align)
#   +  always show sign (+ or -)
#   (space) space before non-negative numbers if no sign
#   0  pad with zeros instead of spaces (between sign/prefix and digits)
#   #  alternate format (0x, 0X, 0o, 0b prefixes, trailing dot for float prec 0)
#
# Width: minimum field width; values wider than field are never truncated.
# Precision:
#   integers: minimum digits to appear (padded with leading zeros);
#             precision 0 on value 0 produces zero digits.
#   floats: fractional decimal places, exact and rounded half to even.
#   strings: maximum characters to include (truncated if longer).

# Where it lives:
# Outside the prelude, for the reason `socket` is: nothing in `src/iyi/`
# calls `sprintf`, and a program that formats no string should not carry
# the engine that would. `import std/format` brings `sprintf`, `printf`,
# `String.format` and `String#%` with it, and the reopenings below travel
# with the import the way `std/text`'s do (SPEC.md III.9).
#
# And against iyi's own prelude only: `String#%` is a name Crystal has, so
# `import std/format` in a `--crystal` program is refused rather than
# replacing the library's under the whole program (SPEC.md III.6).

module std/format

# ris: `UInt16#to_u64` and the other widths are `std/int`'s.
import std/int

# The prelude's own module, reopened: `bits_of` and the rest of the bit
# arithmetic are `src/iyi/float.iyi`'s, which is where `Float64#to_s`
# needs them. What this file adds is the *formatted* text - fixed and
# scientific notation with a width and a precision - which nothing in the
# prelude asks for.
module ::IyiFloatText
  # Extracts Dragon4 digits for a non-zero, finite double.
  # Returns {digits_pointer, count, k} where value = 0.d1 d2 ... dn * 10^k.
  def self.dragon4(value : Float64) : {Pointer(UInt8), Int32, Int32}
    bits = bits_of(value)
    exponent_bits = bits.unsafe_shr(52_u64) & 2047_u64
    fraction = bits & 4503599627370495_u64

    hidden = 4503599627370496_u64
    f = exponent_bits == 0_u64 ? fraction : fraction | hidden
    e = exponent_bits == 0_u64 ? -1074 : exponent_bits.to_i64.to_i32 - 1075

    unequal = fraction == 0_u64 && exponent_bits > 1_u64
    r = IyiBig.new(f)
    s = IyiBig.new(1_u64)
    if e >= 0
      r.shl(e + (unequal ? 2 : 1))
      s.shl(unequal ? 2 : 1)
      m_plus = IyiBig.new(1_u64)
      m_plus.shl(unequal ? e + 1 : e)
      m_minus = IyiBig.new(1_u64)
      m_minus.shl(e)
    else
      r.shl(unequal ? 2 : 1)
      s.shl(-e + (unequal ? 2 : 1))
      m_plus = IyiBig.new(unequal ? 2_u64 : 1_u64)
      m_minus = IyiBig.new(1_u64)
    end
    scratch = IyiBig.new(0_u64)

    even = f & 1_u64 == 0_u64

    length = 0
    probe = f
    while probe != 0_u64
      probe = probe.unsafe_shr(1_u64)
      length = length + 1
    end
    k = ((e + length - 1) * 1233) // 4096
    k = k - 1 if (e + length - 1) < 0 && ((e + length - 1) * 1233) % 4096 != 0
    k = k + 1
    if k >= 0
      s.mul_pow10(k)
    else
      r.mul_pow10(-k)
      m_plus.mul_pow10(-k)
      m_minus.mul_pow10(-k)
    end
    while (c = r.compare_sum(m_plus, s, scratch)) > 0 || (c == 0 && even)
      s.mul_small(10_u64)
      k = k + 1
    end
    while true
      r_ten = r.copy
      r_ten.mul_small(10_u64)
      m_ten = m_plus.copy
      m_ten.mul_small(10_u64)
      c = r_ten.compare_sum(m_ten, s, scratch)
      break if c > 0 || (c == 0 && even)
      r.mul_small(10_u64)
      m_plus.mul_small(10_u64)
      m_minus.mul_small(10_u64)
      k = k - 1
    end

    digits = Pointer(UInt8).new(IyiRegion.tape_bytes(24_u64))
    count = 0
    while true
      r.mul_small(10_u64)
      m_plus.mul_small(10_u64)
      m_minus.mul_small(10_u64)
      digit = r.divide_digit(s)
      low_c = r.compare(m_minus)
      low = low_c < 0 || (low_c == 0 && even)
      high_c = r.compare_sum(m_plus, s, scratch)
      high = high_c > 0 || (high_c == 0 && even)
      if !low && !high
        digits[count] = digit.to_u8
        count = count + 1
        next
      end
      if low && high
        twice = r.copy
        twice.shl(1)
        c = twice.compare(s)
        digit = digit + 1 if c > 0 || (c == 0 && digit % 2 == 1)
      elsif high
        digit = digit + 1
      end
      digits[count] = digit.to_u8
      count = count + 1
      break
    end

    {digits, count, k}
  end

  # Every digit the double has, not the shortest ones padded with zeros:
  # `round(f * 2^e * 10^places)`, half to even, as decimal digits. This is
  # what a fixed or scientific format prints, and what it did not print:
  # `%.0f` of 1e23 answered 100000000000000000000000 where the double is
  # 99999999999999991611392, `%.20f` of 0.1 answered twenty zeros where
  # the value's digits are 0.10000000000000000555, and `%e` of the
  # smallest denormal answered 5.000000e-324 for 4.940656e-324 - the
  # shortest digits, which round-trip, are not the value, and past them
  # there was nothing but zeros. `places` may be negative, a scale down.
  def self.tape_scaled_digits(f : UInt64, e : Int32, places : Int32) : Tape::String
    if quick = scaled_quick(f, e, places)
      return IyiFormat.integer_text(quick, 10)
    end
    num = IyiBig.new(f)
    den = IyiBig.new(1_u64)
    if places > 0
      num.mul_pow10(places)
    elsif places < 0
      den.mul_pow10(0 - places)
    end
    if e >= 0
      num.shl(e)
    else
      den.shl(0 - e)
    end
    quotient = IyiBig.new(0_u64)
    num.divide(den, quotient)
    # Half to even, asked of the remainder against the divisor.
    num.shl(1)
    c = num.compare(den)
    if c > 0 || (c == 0 && quotient.low_bit == 1_u64)
      quotient.add_small(1_u64)
    end
    Tape::String.build { |w| quotient.write_decimal(w) }
  end

  # `scaled_digits` in two words, when they hold it: f * 10^places is
  # under 2^117 for the places a word of ten's powers reaches, and the
  # quotient by 2^-e and its half-to-even rounding are shifts and one
  # comparison of the remainder with the half. The same integer the
  # bignum's division gives - it is the same arithmetic, exact - where
  # that division made `%.2f` three times what Go's takes. nil when the
  # value, the places or the answer do not fit.
  def self.scaled_quick(f : UInt64, e : Int32, places : Int32) : UInt64?
    return nil if places < 0 || places > 19
    power = 1_u64
    places.times { power = power &* 10_u64 }
    if e >= 0
      return nil if e > 10
      hi, lo = mul_wide(f.unsafe_shl(e.to_u64), power)
      return hi == 0_u64 ? lo : nil
    end
    hi, lo = mul_wide(f, power)
    shift = (0 - e).to_u64
    # Past 117 bits of shift the product is under half of the divisor.
    return 0_u64 if shift > 117_u64
    if shift < 64_u64
      return nil if hi.unsafe_shr(shift) != 0_u64
      quotient = lo.unsafe_shr(shift) | (shift == 0_u64 ? 0_u64 : hi.unsafe_shl(64_u64 - shift))
      rest_hi = 0_u64
      rest_lo = lo & (1_u64.unsafe_shl(shift) &- 1_u64)
      half_hi = 0_u64
      half_lo = 1_u64.unsafe_shl(shift - 1_u64)
    else
      quotient = hi.unsafe_shr(shift - 64_u64)
      rest_hi = shift == 64_u64 ? 0_u64 : hi & (1_u64.unsafe_shl(shift - 64_u64) &- 1_u64)
      rest_lo = lo
      half_hi = shift == 64_u64 ? 0_u64 : 1_u64.unsafe_shl(shift - 65_u64)
      half_lo = shift == 64_u64 ? 9223372036854775808_u64 : 0_u64
    end
    above = rest_hi > half_hi || (rest_hi == half_hi && rest_lo > half_lo)
    tie = rest_hi == half_hi && rest_lo == half_lo
    if above || (tie && quotient & 1_u64 == 1_u64)
      return nil if quotient == 18446744073709551615_u64
      quotient = quotient + 1_u64
    end
    quotient
  end

  # a * b as its high and low words, from 32-bit halves.
  def self.mul_wide(a : UInt64, b : UInt64) : {UInt64, UInt64}
    mask = 4294967295_u64
    a_lo = a & mask
    a_hi = a.unsafe_shr(32_u64)
    b_lo = b & mask
    b_hi = b.unsafe_shr(32_u64)
    low = a_lo &* b_lo
    cross1 = a_lo &* b_hi
    cross2 = a_hi &* b_lo
    high = a_hi &* b_hi
    middle = low.unsafe_shr(32_u64) &+ (cross1 & mask) &+ (cross2 & mask)
    {high &+ cross1.unsafe_shr(32_u64) &+ cross2.unsafe_shr(32_u64) &+ middle.unsafe_shr(32_u64),
     middle.unsafe_shl(32_u64) | (low & mask)}
  end

  # The most digits a format may ask for: the bignum has a fixed capacity
  # sized for a double's largest scaled boundary, and 400 places of the
  # largest double stay under it with room to spare.
  MAX_PLACES = 400

  # Fixed-point decimal format with exact places, half to even.
end

# The two operations the exact formats need that the printer's bignum did
# not have: a division by a small number, and its digits in base ten.
class ::IyiBig
  # self / small for a `small` under 2^32, self reduced to the quotient,
  # the remainder answered. A limb is 32 bits in a 64-bit word, so the
  # running remainder shifted up by a limb still fits the word.
  def div_small(small : UInt64) : UInt64
    rem = 0_u64
    index = @size - 1
    while index >= 0
      cur = rem.unsafe_shl(32_u64) | @limbs[index]
      @limbs[index] = cur // small
      rem = cur % small
      index = index - 1
    end
    while @size > 0 && @limbs[@size - 1] == 0_u64
      @size = @size - 1
    end
    rem
  end

  # Base ten, most significant digit first, nine digits per division.
  def write_decimal(w : Tape::String::Writer) : Nil
    if @size == 0
      w << "0"
      return
    end
    work = copy
    chunks = Tape::Array(UInt64).new
    while work.size > 0
      chunks << work.div_small(1000000000_u64)
    end
    i = chunks.size - 1
    while i >= 0
      text = IyiFormat.integer_text(chunks[i], 10)
      IyiFormat.repeat(w, 48_u8, 9 - text.bytesize) if i < chunks.size - 1
      w << text
      i -= 1
    end
  end
end

module ::IyiFormat
  def self.code_point(code) : Char
    raise "%c of #{code}: not a Unicode code point" if code < 0 || code > 0x10FFFF || (code >= 0xD800 && code <= 0xDFFF)
    code.to_i32.unsafe_chr
  end

  def self.text_view(value : Tape::String) : Tape::String
    value
  end

  def self.text_view(value : String) : Tape::String
    value.as_tape
  end

  def self.text_view(value) : Tape::String
    Tape::String.build { |w| w.append_value(value) }
  end

  def self.repeat(w : Tape::String::Writer, byte : UInt8,
                  count : Int32) : Nil
    count.times { w.push(byte) } if count > 0
  end

  def self.tape_string_arg(text : Tape::String, minus : Bool,
                           width : Int32, precision : Int32) : Tape::String
    Tape::String.build do |w|
      count = 0
      stop = 0
      i = 0
      while i < text.bytesize
        break if precision >= 0 && count >= precision
        i += 1
        while i < text.bytesize && (text[i] & 192_u8) == 128_u8
          i += 1
        end
        stop = i
        count += 1
      end
      repeat(w, 32_u8, width - count) unless minus
      w << text[0, stop]
      repeat(w, 32_u8, width - count) if minus
    end
  end

  def self.tape_char_arg(value, minus : Bool, width : Int32) : Tape::String
    text = text_view(value)
    case value
    when Char
      text = Tape::String.build { |w| w << value }
    when Int32, Int64, UInt64
      text = Tape::String.build { |w| w << code_point(value) }
    end
    text = " ".as_tape if text.empty?
    tape_string_arg(text, minus, width, 1)
  end

  def self.tape_digits(text : Tape::String, verb : Char, base : Int32,
                       minus : Bool, plus : Bool, space : Bool,
                       zero : Bool, hash : Bool, width : Int32,
                       precision : Int32) : Tape::String
    Tape::String.build do |w|
      negative = text.starts_with?("-")
      digits = negative ? text[1, text.bytesize - 1] : text
      nonzero = digits != "0"
      digits = "".as_tape if !nonzero && precision == 0
      sign = negative ? "-" : (verb != 'u' ? (plus ? "+" : (space ? " " : "")) : "")
      prefix = ""
      if hash && nonzero
        prefix = base == 16 ? (verb == 'X' ? "0X" : "0x") : (base == 8 ? "0o" : (base == 2 ? "0b" : ""))
      end
      zeros = precision > digits.bytesize ? precision - digits.bytesize : 0
      zero = false if precision >= 0
      pad = width - sign.bytesize - prefix.bytesize - digits.bytesize - zeros
      repeat(w, 32_u8, pad) unless minus || zero
      w << sign << prefix
      repeat(w, 48_u8, pad) if zero && !minus
      repeat(w, 48_u8, zeros)
      digits.each_byte do |byte|
        byte -= 32_u8 if verb == 'X' && byte >= 97_u8 && byte <= 102_u8
        w.push(byte)
      end
      repeat(w, 32_u8, pad) if minus
    end
  end

  def self.integer_text(value : Int64, base : Int32) : Tape::String
    Tape::String.build do |w|
      negative = value < 0
      # Negative remainders allow the signed minimum without negating it.
      digits = Tape::Array(UInt8).new(128)
      radix = base.to_i64
      temp = value
      while temp != 0
        rem = temp % radix
        d = (rem < 0 ? -rem : rem).to_i32
        digits << (d < 10 ? 48 + d : 87 + d).to_u8
        temp = temp // radix
      end
      w << "-" if negative
      w << "0" if digits.empty?
      i = digits.size - 1
      while i >= 0
        w.push(digits[i])
        i -= 1
      end
    end
  end

  def self.integer_text(value : UInt64, base : Int32) : Tape::String
    Tape::String.build do |w|
      negative = value < 0
      # Negative remainders allow the signed minimum without negating it.
      digits = Tape::Array(UInt8).new(128)
      radix = base.to_u64
      temp = value
      while temp != 0
        rem = temp % radix
        d = rem.to_i32
        digits << (d < 10 ? 48 + d : 87 + d).to_u8
        temp = temp // radix
      end
      w << "-" if negative
      w << "0" if digits.empty?
      i = digits.size - 1
      while i >= 0
        w.push(digits[i])
        i -= 1
      end
    end
  end

  def self.integer_text(value : Int128, base : Int32) : Tape::String
    Tape::String.build do |w|
      negative = value < 0
      # Negative remainders allow the signed minimum without negating it.
      digits = Tape::Array(UInt8).new(128)
      radix = base.to_i128
      temp = value
      while temp != 0
        rem = temp % radix
        d = (rem < 0 ? -rem : rem).to_i32
        digits << (d < 10 ? 48 + d : 87 + d).to_u8
        temp = temp // radix
      end
      w << "-" if negative
      w << "0" if digits.empty?
      i = digits.size - 1
      while i >= 0
        w.push(digits[i])
        i -= 1
      end
    end
  end

  def self.integer_text(value : UInt128, base : Int32) : Tape::String
    Tape::String.build do |w|
      negative = value < 0
      # Negative remainders allow the signed minimum without negating it.
      digits = Tape::Array(UInt8).new(128)
      radix = base.to_u128
      temp = value
      while temp != 0
        rem = temp % radix
        d = rem.to_i32
        digits << (d < 10 ? 48 + d : 87 + d).to_u8
        temp = temp // radix
      end
      w << "-" if negative
      w << "0" if digits.empty?
      i = digits.size - 1
      while i >= 0
        w.push(digits[i])
        i -= 1
      end
    end
  end

  def self.tape_int64(val : Int64, base : Int32, uppercase : Bool,
                      signed : Bool, minus : Bool, plus : Bool,
                      space : Bool, zero : Bool, hash : Bool,
                      width : Int32, precision : Int32) : Tape::String
    verb = uppercase ? 'X' : (signed ? 'd' : 'u')
    tape_digits(integer_text(val, base), verb, base, minus, plus, space,
      zero, hash, width, precision)
  end

  def self.tape_uint64(val : UInt64, base : Int32, uppercase : Bool,
                       signed : Bool, minus : Bool, plus : Bool,
                       space : Bool, zero : Bool, hash : Bool,
                       width : Int32, precision : Int32) : Tape::String
    verb = uppercase ? 'X' : (signed ? 'd' : 'u')
    tape_digits(integer_text(val, base), verb, base, minus, plus, space,
      zero, hash, width, precision)
  end

  def self.tape_wide(val, verb : Char, minus : Bool, plus : Bool, space : Bool, zero : Bool, hash : Bool, width : Int32, precision : Int32) : Tape::String
    base = case verb
           when 'd', 'i', 'u' then 10
           when 'x', 'X'      then 16
           when 'o'           then 8
           when 'b'           then 2
           else                    0
           end
    if base == 0
      return tape_arg(val.to_f64, verb, minus, plus, space, zero, hash, width, precision) if verb == 'f' || verb == 'e' || verb == 'E' || verb == 'g' || verb == 'G'
      # The value's own text, as every other integer's: written as its
      # digits and then asked again as a string, `%p` of 65_i128 was "65" in
      # quotes, the string's inspection; and `%c` is a code point here too,
      # where it was refused as "wants a character".
      return tape_string_arg(verb == 'p' ? val.inspect.as_tape : integer_text(val, 10), minus, width, precision) if verb == 's' || verb == 'p'
      return tape_char_arg(code_point(val), minus, width) if verb == 'c'
      raise "unknown format specifier '%#{verb}'"
    end
    # `%u` is the word's bits, as an `Int64`'s are: `%u` of -5_i128
    # printed -5.
    text = verb == 'u' && val < 0 ? integer_text(val.unsafe_to_u128, base) : integer_text(val, base)
    tape_digits(text, verb, base, minus, plus, space, zero, hash, width, precision)
  end

  def self.float_field(value : Float64, text : Tape::String,
                       minus : Bool, plus : Bool, space : Bool,
                       zero : Bool, width : Int32) : Tape::String
    Tape::String.build do |w|
      bits = IyiFloatText.bits_of(value)
      sign = bits.unsafe_shr(63_u64) != 0_u64 ? "-" : (plus ? "+" : (space ? " " : ""))
      pad = width - sign.bytesize - text.bytesize
      repeat(w, 32_u8, pad) unless minus || zero
      w << sign
      repeat(w, 48_u8, pad) if zero && !minus
      w << text
      repeat(w, 32_u8, pad) if minus
    end
  end

  def self.float_special(value : Float64, minus : Bool, plus : Bool,
                         space : Bool, width : Int32) : Tape::String?
    bits = IyiFloatText.bits_of(value)
    return nil unless bits.unsafe_shr(52_u64) & 2047_u64 == 2047_u64
    nan = bits & 4503599627370495_u64 != 0_u64
    text = if nan
             plus ? "+NaN" : (space ? " NaN" : "NaN")
           elsif bits.unsafe_shr(63_u64) != 0_u64
             "-Infinity"
           else
             plus ? "+Infinity" : (space ? " Infinity" : "Infinity")
           end
    tape_string_arg(text.as_tape, minus, width, -1)
  end

  def self.exact_digits(value : Float64, places : Int32) : Tape::String
    bits = IyiFloatText.bits_of(value)
    eb = bits.unsafe_shr(52_u64) & 2047_u64
    fraction = bits & 4503599627370495_u64
    f = eb == 0_u64 ? fraction : fraction | 4503599627370496_u64
    e = eb == 0_u64 ? -1074 : eb.to_i64.to_i32 - 1075
    IyiFloatText.tape_scaled_digits(f, e, places)
  end

  def self.fixed_text(value : Float64, places : Int32,
                      hash : Bool) : Tape::String
    limit = IyiFloatText::MAX_PLACES
    raise "precision must be at most #{limit}, not #{places}" if places > limit
    digits = exact_digits(value, places)
    Tape::String.build do |w|
      if places == 0
        w << digits
        w << "." if hash
      elsif digits.bytesize <= places
        w << "0."
        repeat(w, 48_u8, places - digits.bytesize)
        w << digits
      else
        at = digits.bytesize - places
        w << digits[0, at] << "." << digits[at, places]
      end
    end
  end

  def self.exp_text(value : Float64, places : Int32,
                    uppercase : Bool, hash : Bool) : Tape::String
    limit = IyiFloatText::MAX_PLACES
    raise "precision must be at most #{limit}, not #{places}" if places > limit
    exp = 0
    digits = "0".as_tape
    if value != 0.0
      exp = IyiFloatText.dragon4(value.abs)[2] - 1
      digits = exact_digits(value, places - exp)
      attempts = 0
      while digits.bytesize != places + 1 && attempts < 4
        exp += digits.bytesize > places + 1 ? 1 : -1
        digits = exact_digits(value, places - exp)
        attempts += 1
      end
      tail = 1
      while tail < digits.bytesize && digits[tail] == 48_u8
        tail += 1
      end
      if tail == digits.bytesize && digits.bytesize == places + 1 &&
         digits[0] == 49_u8
        lower = exact_digits(value, places - exp + 1)
        if lower.bytesize == places + 1
          exp -= 1
          digits = lower
        end
      end
    else
      digits = Tape::String.build { |w| repeat(w, 48_u8, places + 1) }
    end
    Tape::String.build do |w|
      w << digits[0, 1]
      w << "." if places > 0 || hash
      w << digits[1, places] if places > 0
      w << (uppercase ? "E" : "e") << (exp < 0 ? "-" : "+")
      magnitude = exp < 0 ? -exp : exp
      w << "0" if magnitude < 10
      w.append_int(magnitude)
    end
  end

  def self.tape_float64(val : Float64, minus : Bool, plus : Bool,
                        space : Bool, zero : Bool, hash : Bool,
                        width : Int32, precision : Int32) : Tape::String
    special = float_special(val, minus, plus, space, width)
    return special if special
    text = fixed_text(val.abs, precision < 0 ? 6 : precision, hash)
    float_field(val, text, minus, plus, space, zero, width)
  end

  def self.tape_float_exp(val : Float64, uppercase : Bool, minus : Bool,
                          plus : Bool, space : Bool, zero : Bool,
                          hash : Bool, width : Int32,
                          precision : Int32) : Tape::String
    special = float_special(val, minus, plus, space, width)
    return special if special
    text = exp_text(val.abs, precision < 0 ? 6 : precision, uppercase, hash)
    float_field(val, text, minus, plus, space, zero, width)
  end

  def self.trim_tape(text : Tape::String) : Tape::String
    return text unless text.index('.')
    stop = text.bytesize
    while stop > 0 && text[stop - 1] == 48_u8
      stop -= 1
    end
    stop -= 1 if stop > 0 && text[stop - 1] == 46_u8
    text[0, stop]
  end

  def self.tape_float_general(val : Float64, uppercase : Bool,
                              minus : Bool, plus : Bool, space : Bool,
                              zero : Bool, hash : Bool, width : Int32,
                              precision : Int32) : Tape::String
    special = float_special(val, minus, plus, space, width)
    return special if special
    prec = precision < 0 ? 6 : (precision == 0 ? 1 : precision)
    limit = IyiFloatText::MAX_PLACES + 1
    raise "precision must be at most #{limit}, not #{prec}" if prec > limit
    scientific = exp_text(val.abs, prec - 1, uppercase, hash)
    marker = scientific.index(uppercase ? 'E' : 'e') || scientific.bytesize
    exp = scientific[marker + 1, scientific.bytesize - marker - 1].to_i
    text = Tape::String.build do |w|
      if exp < -4 || exp >= prec
        mantissa = scientific[0, marker]
        w << (hash ? mantissa : trim_tape(mantissa))
        w << scientific[marker, scientific.bytesize - marker]
      else
        sig = Tape::String.build do |o|
          o << scientific[0, 1]
          o << scientific[2, marker - 2] if marker > 2
        end
        fixed = Tape::String.build do |o|
          if exp >= 0
            if exp + 1 < prec
              o << sig[0, exp + 1] << "."
              o << sig[exp + 1, prec - 1 - exp]
            else
              o << sig
            end
          else
            o << "0."
            repeat(o, 48_u8, -exp - 1)
            o << sig
          end
        end
        w << (hash ? fixed : trim_tape(fixed))
        w << "." if hash && !fixed.index('.')
      end
    end
    float_field(val, text, minus, plus, space, zero, width)
  end

  def self.tape_truncated(val : Float64, verb : Char, minus : Bool,
                          plus : Bool, space : Bool, zero : Bool,
                          hash : Bool, width : Int32,
                          precision : Int32) : Tape::String
    bits = IyiFloatText.bits_of(val)
    eb = bits.unsafe_shr(52_u64) & 2047_u64
    if eb == 2047_u64
      raise "%#{verb} wants a finite number, and #{val} is not one"
    end
    if val >= -9223372036854775808.0 && val < 9223372036854775808.0
      return tape_arg(val.to_i64, verb, minus, plus, space, zero, hash,
        width, precision)
    end
    f = (bits & 4503599627370495_u64) | 4503599627370496_u64
    e = eb.to_i64.to_i32 - 1075
    base = verb == 'x' || verb == 'X' ? 16 : (verb == 'o' ? 8 : (verb == 'b' ? 2 : 10))
    text = Tape::String.build do |w|
      w << "-" if bits.unsafe_shr(63_u64) != 0_u64
      if base == 10
        whole = IyiBig.new(f)
        whole.shl(e)
        whole.write_decimal(w)
      else
        step = base == 16 ? 4 : (base == 8 ? 3 : 1)
        w << integer_text(f.unsafe_shl((e % step).to_u64), base)
        repeat(w, 48_u8, e // step)
      end
    end
    tape_digits(text, verb, base, minus, plus, space, zero, hash,
      width, precision)
  end

  def self.tape_arg(val, verb : Char, minus : Bool, plus : Bool, space : Bool, zero : Bool, hash : Bool, width : Int32, precision : Int32) : Tape::String
    # The rest of the tower `std/int` and `std/float` make usable is
    # formatted as the prelude's own four are: `%d` of an `Int8`, `UInt32`
    # or `Float32` panicked "wants a number". A value is widened without
    # loss; an `Int128` or `UInt128` is written from its own digits.
    case val
    when Int8
      # `%u` is the word's bits at the word's own width, as an `Int32`'s
      # are below: widened first, `%u` of -5_i8 and of -5_i16 printed
      # 18446744073709551611, the bits of an `Int64`.
      return tape_arg(verb == 'u' ? val.to_i64 & 255_i64 : val.to_i64, verb, minus, plus, space, zero, hash, width, precision)
    when Int16
      return tape_arg(verb == 'u' ? val.to_i64 & 65535_i64 : val.to_i64, verb, minus, plus, space, zero, hash, width, precision)
    when UInt8
      # Widened as `Int8` is: it had every integer verb's branch of its own
      # and none of the float verbs', so `%f` of 200_u8 panicked "wants a
      # number" where `%d` printed 200.
      return tape_arg(val.to_i64, verb, minus, plus, space, zero, hash, width, precision)
    when UInt16, UInt32
      return tape_arg(val.to_u64, verb, minus, plus, space, zero, hash, width, precision)
    when Float32
      # Widened for a number's verbs only: `%s` and `%p` are the value's
      # own text, and the double's was 0.10000000149011612 for 0.1_f32.
      return tape_arg(val.to_f64, verb, minus, plus, space, zero, hash, width, precision) unless verb == 's' || verb == 'p'
    when Int128, UInt128
      return tape_wide(val, verb, minus, plus, space, zero, hash, width, precision)
    end
    case verb
    when 's'
      tape_string_arg(text_view(val), minus, width, precision)
    when 'p'
      tape_string_arg(val.inspect.as_tape, minus, width, precision)
    when 'c'
      tape_char_arg(val, minus, width)
    when 'd', 'i'
      case val
      when Int32
        tape_int64(val.to_i64, 10, false, true, minus, plus, space, zero, hash, width, precision)
      when Int64
        tape_int64(val, 10, false, true, minus, plus, space, zero, hash, width, precision)
      when UInt64
        tape_uint64(val, 10, false, true, minus, plus, space, zero, hash, width, precision)
      when Float64
        tape_truncated(val, verb, minus, plus, space, zero, hash, width, precision)
      else
        not_a_number(val, verb)
      end
    when 'u'
      case val
      when Int32
        tape_int64(val < 0 ? (val.to_i64 & 4294967295_i64) : val.to_i64, 10, false, false, minus, plus, space, zero, hash, width, precision)
      when Int64
        # Unsigned is the word's bits, as an Int32's are above: `%u` of
        # -5_i64 printed -5.
        tape_uint64(val.unsafe_to_u64, 10, false, false, minus, plus, space, zero, hash, width, precision)
      when UInt64
        tape_uint64(val, 10, false, false, minus, plus, space, zero, hash, width, precision)
      when Float64
        tape_truncated(val, verb, minus, plus, space, zero, hash, width, precision)
      else
        not_a_number(val, verb)
      end
    when 'x'
      # The sign flags hold in every base, as `%d`'s: a negative value is
      # written with its `-` (`%x` of -255 is -ff), so `+` and space are
      # the other bases' too, as the other library and Python have them.
      # `%+x` of 255 printed ff, and a column of signed deltas lost its signs
      # on one side. Only `%u` is the word's bits, and never signed.
      case val
      when Int32
        tape_int64(val.to_i64, 16, false, true, minus, plus, space, zero, hash, width, precision)
      when Int64
        tape_int64(val, 16, false, true, minus, plus, space, zero, hash, width, precision)
      when UInt64
        tape_uint64(val, 16, false, true, minus, plus, space, zero, hash, width, precision)
      when Float64
        tape_truncated(val, verb, minus, plus, space, zero, hash, width, precision)
      else
        not_a_number(val, verb)
      end
    when 'X'
      case val
      when Int32
        tape_int64(val.to_i64, 16, true, true, minus, plus, space, zero, hash, width, precision)
      when Int64
        tape_int64(val, 16, true, true, minus, plus, space, zero, hash, width, precision)
      when UInt64
        tape_uint64(val, 16, true, true, minus, plus, space, zero, hash, width, precision)
      when Float64
        tape_truncated(val, verb, minus, plus, space, zero, hash, width, precision)
      else
        not_a_number(val, verb)
      end
    when 'o'
      case val
      when Int32
        tape_int64(val.to_i64, 8, false, true, minus, plus, space, zero, hash, width, precision)
      when Int64
        tape_int64(val, 8, false, true, minus, plus, space, zero, hash, width, precision)
      when UInt64
        tape_uint64(val, 8, false, true, minus, plus, space, zero, hash, width, precision)
      when Float64
        tape_truncated(val, verb, minus, plus, space, zero, hash, width, precision)
      else
        not_a_number(val, verb)
      end
    when 'b'
      case val
      when Int32
        tape_int64(val.to_i64, 2, false, true, minus, plus, space, zero, hash, width, precision)
      when Int64
        tape_int64(val, 2, false, true, minus, plus, space, zero, hash, width, precision)
      when UInt64
        tape_uint64(val, 2, false, true, minus, plus, space, zero, hash, width, precision)
      when Float64
        tape_truncated(val, verb, minus, plus, space, zero, hash, width, precision)
      else
        not_a_number(val, verb)
      end
    when 'f'
      case val
      when Float64
        tape_float64(val, minus, plus, space, zero, hash, width, precision)
      when Int32
        tape_float64(val.to_f64, minus, plus, space, zero, hash, width, precision)
      when Int64
        tape_float64(val.to_f64, minus, plus, space, zero, hash, width, precision)
      when UInt64
        tape_float64(val.to_f64, minus, plus, space, zero, hash, width, precision)
      else
        not_a_number(val, verb)
      end
    when 'e'
      case val
      when Float64
        tape_float_exp(val, false, minus, plus, space, zero, hash, width, precision)
      when Int32
        tape_float_exp(val.to_f64, false, minus, plus, space, zero, hash, width, precision)
      when Int64
        tape_float_exp(val.to_f64, false, minus, plus, space, zero, hash, width, precision)
      when UInt64
        tape_float_exp(val.to_f64, false, minus, plus, space, zero, hash, width, precision)
      else
        not_a_number(val, verb)
      end
    when 'E'
      case val
      when Float64
        tape_float_exp(val, true, minus, plus, space, zero, hash, width, precision)
      when Int32
        tape_float_exp(val.to_f64, true, minus, plus, space, zero, hash, width, precision)
      when Int64
        tape_float_exp(val.to_f64, true, minus, plus, space, zero, hash, width, precision)
      when UInt64
        tape_float_exp(val.to_f64, true, minus, plus, space, zero, hash, width, precision)
      else
        not_a_number(val, verb)
      end
    when 'g', 'G'
      case val
      when Float64
        tape_float_general(val, verb == 'G', minus, plus, space, zero, hash, width, precision)
      when Int32
        tape_float_general(val.to_f64, verb == 'G', minus, plus, space, zero, hash, width, precision)
      when Int64
        tape_float_general(val.to_f64, verb == 'G', minus, plus, space, zero, hash, width, precision)
      when UInt64
        tape_float_general(val.to_f64, verb == 'G', minus, plus, space, zero, hash, width, precision)
      else
        not_a_number(val, verb)
      end
    else
      raise "unknown format specifier '%#{verb}'"
    end
  end

  def self.field_number(format_string : String, start : Int32, stop : Int32, what : String) : Int32
    value = 0_i64
    index = start
    while index < stop
      value = value * 10_i64 + (format_string.to_unsafe[index] - 48_u8).to_i64
      raise "#{what} must be at most 2147483647, not #{format_string[start, stop - start]}" if value > 2147483647_i64
      index = index + 1
    end
    value.to_i32
  end

  def self.field_number(format_string : Tape::String, start : Int32, stop : Int32, what : String) : Int32
    value = 0_i64
    index = start
    while index < stop
      value = value * 10_i64 + (format_string[index] - 48_u8).to_i64
      if value > 2147483647_i64
        raise "#{what} must be at most 2147483647, not " \
          "#{format_string[start, stop - start].to_heap}"
      end
      index = index + 1
    end
    value.to_i32
  end

  # A numeric verb is a claim about the argument, and an argument that is
  # not a number contradicts it: `%d` of "abc" printed abc, `%f` of a
  # `Char` printed the character, and the caller who had mistyped the
  # argument order saw their strings where their numbers should be and
  # nothing said so.
  def self.not_a_number(val, verb : Char) : NoReturn
    raise "%#{verb} wants a number, and #{val.inspect} is a #{val.class}"
  end
end

pub def sprintf(format_string : String, *args : *T) : String forall T
  sprintf(format_string, args)
end

# The argument list may be one array or tuple, as the other library takes
# it: `"%s, %s, %s, D" % ['A', 'B', 'C']`, its own example, panicked "too
# few arguments for format string" here, and `"[%s]" % ["A"]` printed
# `[["A"]]` where it prints `[A]`. Two overloads rather than one taking
# `Array | Tuple`: a union with Array in it cannot be written into an
# artifact ("can't use Array(T) in unions yet").
pub def sprintf(format_string : String, args : Array) : String
  format_list(format_string, args)
end

pub def sprintf(format_string : String, args : Tuple) : String
  format_list(format_string, args)
end

private def format_list(format_string : String, args) : String
  result = ""
  tape do
    result = sprintf(format_string.as_tape, args).to_heap
  end
  result
end

pub def sprintf(format_string : Tape::String, *args : *T) : Tape::String forall T
  sprintf(format_string, args)
end

pub def sprintf(format_string : Tape::String, args : Tuple) : Tape::String
  Tape::String.build { |w| format_list(format_string, args, w) }
end

pub def sprintf(format_string : Tape::String, args : Array) : Tape::String
  Tape::String.build { |w| format_list(format_string, args, w) }
end

pub def sprintf(format_string : Tape::String,
                writer : Tape::String::Writer, args : Tuple) : Nil
  format_list(format_string, args, writer)
end

pub def sprintf(format_string : Tape::String,
                writer : Tape::String::Writer, args : Array) : Nil
  format_list(format_string, args, writer)
end

private def format_list(format_string : Tape::String, args,
                        result : Tape::String::Writer) : Nil
  index = 0
  format_bytesize = format_string.bytesize
  format_ptr = format_string
  arg_index = 0
  # Written into one buffer: `result = result + piece` copied the whole
  # result once per piece, and a `%%` is a piece.

  while index < format_bytesize
    byte = format_ptr[index]
    if byte != 37_u8 # '%'
      start = index
      while index < format_bytesize && format_ptr[index] != 37_u8
        index = index + 1
      end
      result << format_string[start, index - start]
      next
    end

    index = index + 1
    if index >= format_bytesize
      raise "incomplete format specifier at end of string"
    end

    if format_ptr[index] == 37_u8 # '%%'
      result << '%'
      index = index + 1
      next
    end

    minus = false
    plus = false
    space = false
    zero = false
    hash = false

    parsing_flags = true
    while parsing_flags && index < format_bytesize
      case format_ptr[index]
      when 45_u8 # '-'
        minus = true
        index = index + 1
      when 43_u8 # '+'
        plus = true
        index = index + 1
      when 32_u8 # ' '
        space = true
        index = index + 1
      when 48_u8 # '0'
        zero = true
        index = index + 1
      when 35_u8 # '#'
        hash = true
        index = index + 1
      else
        parsing_flags = false
      end
    end

    zero = false if minus

    width_at = index
    while index < format_bytesize && format_ptr[index] >= 48_u8 && format_ptr[index] <= 57_u8
      index = index + 1
    end
    width = IyiFormat.field_number(format_string, width_at, index, "width")

    precision = -1
    if index < format_bytesize && format_ptr[index] == 46_u8 # '.'
      index = index + 1
      precision_at = index
      while index < format_bytesize && format_ptr[index] >= 48_u8 && format_ptr[index] <= 57_u8
        index = index + 1
      end
      precision = IyiFormat.field_number(format_string, precision_at, index, "precision")
    end

    if index >= format_bytesize
      raise "incomplete format specifier at end of string"
    end

    # A verb is ASCII; past it is a character of several bytes, named whole
    # - its lead byte read as a character of its own was `%Ã` for `%é`.
    if format_ptr[index] >= 0x80_u8
      format_string[index, format_bytesize - index].to_heap.each_char do |char|
        raise "unknown format specifier '%#{char}'"
      end
    end
    verb = format_ptr[index].unsafe_chr
    index = index + 1

    # Asked here rather than left to `Tuple#[]`, whose message is about an
    # index: a caller of `sprintf` wrote a specifier and no argument for it,
    # and that is what the panic should say.
    raise "too few arguments for format string" if arg_index >= args.size

    val = args[arg_index]
    arg_index = arg_index + 1

    result << IyiFormat.tape_arg(val, verb, minus, plus, space, zero, hash, width, precision)
  end

  # And the mirror of "too few": an argument no specifier took is a `%s`
  # somebody forgot, and it was dropped without a word.
  if arg_index < args.size
    raise "too many arguments for format string: #{args.size} given, #{arg_index} used"
  end

  nil
end

pub def printf(format_string : String, *args : *T) : Nil forall T
  print sprintf(format_string, args)
end

# The argument list as one array or tuple, as `sprintf` takes it.
pub def printf(format_string : String, args : Array) : Nil
  print sprintf(format_string, args)
end

pub def printf(format_string : String, args : Tuple) : Nil
  print sprintf(format_string, args)
end

# Qualified, because a reopening is not inside the module that writes it:
# `::String` is the prelude's type wherever this file is read, so a bare
# `sprintf` in one of these bodies is a name `String` does not have -
# `undefined method 'sprintf' for String.class`, which is R-2b saying so.
class ::String
  def self.format(format_string : String, *args : *T) : String forall T
    Std::Format.sprintf(format_string, *args)
  end

  def %(args : Tuple) : String
    Std::Format.sprintf(self, *args)
  end

  def %(arg) : String
    Std::Format.sprintf(self, arg)
  end

  def %(*args : *T) : String forall T
    Std::Format.sprintf(self, *args)
  end
end
