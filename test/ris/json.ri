# std/json on the tape: `JSON.parse(Tape::String)` reads what `JSON.parse`
# reads and refuses what it refuses, with the same sentence; a string with
# no escape is a view of the input; `JSON.write(Tape::String::Writer)`
# writes what `JSON.build` writes, plain, indented and ASCII-only; and
# neither puts anything on the GC heap.
module test/ris/json

import std/int
import std/gc::{GC}
import std/json::{JSON, Builder, Writer, Document, DocumentParser, Parser}

failures = [] of String

def check(failures : Array(String), ok : Bool, what : String) : Nil
  failures << what unless ok
end

def heap_doc(b : Builder) : Nil
  b.object do
    b.field "id", 7_i64
    b.field "name", "a \"b\"\né \u{1F600} \u0001"
    b.field "list" do
      b.array do
        b.number 1
        b.number -2_i64
        b.number 2.5
        b.bool true
        b.null
        b.object { }
        b.array { }
      end
    end
  end
end

def tape_doc(b : Writer) : Nil
  b.object do
    b.field "id", 7_i64
    b.field "name", "a \"b\"\né \u{1F600} \u0001"
    b.field "list" do
      b.array do
        b.number 1
        b.number -2_i64
        b.number 2.5
        b.bool true
        b.null
        b.object { }
        b.array { }
      end
    end
  end
end

text = %({"a": [1, -0, 2.5e3, "x\\ny\\u00e9\\ud83d\\ude00", true, false, null],) +
       %( "b\\u0041": {"c": -7, "d": "plain"}, "e": []})
Tape.use do
  doc = JSON.parse(Tape::String.new(text))
  a = doc.at(doc.root, "a")
  check(failures, doc.size(a) == 7, "array size")
  check(failures, doc.int(doc.at(a, 0)) == 1 && doc.int(doc.at(a, 1)) == 0, "integers")
  check(failures, doc.float(doc.at(a, 2)) == 2500.0, "float")
  check(failures, doc.string(doc.at(a, 3)).to_s == "x\nyé😀", "escapes decoded")
  check(failures, doc.bool(doc.at(a, 4)) && !doc.bool(doc.at(a, 5)), "bools")
  check(failures, doc.null?(doc.at(a, 6)) && doc.at(a, 7) == -1, "null, past the end")
  b = doc.at(doc.root, "bA")
  check(failures, b > 0 && doc.int(doc.at(b, "c")) == -7, "escaped key found")
  check(failures, doc.string(doc.at(b, "d")) == "plain", "a plain string")
  check(failures, doc.size(doc.at(doc.root, "e")) == 0 && doc.at(doc.root, "zz") == -1, "empty array, missing key")
  keys = [] of String
  doc.each(doc.root) { |child| keys << doc.key(child).to_s }
  check(failures, keys == ["a", "bA", "e"], "keys in order")
end

bad = [%([1,]), %({"a" 1}), %(["\\x"]), %(), %([1] 2), %({"k\\u0041":1,"kA":2}),
       %([01]), %([1e999]), %(["\\ud800"]), %({"a":1,}), %(tru), %([1.5x]),
       %(["a\nb"]), %({"a":{"b":1,"b":2}}), "[" * 300, %(["\xff"])]
many = String.build do |io|
  io << "{"
  40.times { |i| io << %("k#{i}":#{i},) }
  io << %("k39":0})
end
bad << many
bad.each do |input|
  Tape.use do
    tape = DocumentParser.new(Tape::String.new(input))
    tape.parse
    heap = Parser.new(input)
    heap.parse
    check(failures, !tape.error.nil? && tape.error == heap.error, "refused alike: #{input[0, 20].inspect} #{tape.error} | #{heap.error}")
    check(failures, JSON.parse?(Tape::String.new(input)).nil?, "parse? nil: #{input[0, 20].inspect}")
  end
end

[nil, 2, "\t"].each do |indent|
  [false, true].each do |ascii|
    heap = JSON.build(indent) do |b|
      b.ascii_only = ascii
      heap_doc(b)
    end
    tape = ""
    Tape.use do
      w = Tape::String::Writer.new(16)
      w.append("head:")
      JSON.write(w, indent, ascii) { |b| tape_doc(b) }
      tape = w.finish.to_s
    end
    check(failures, tape == "head:" + heap, "written alike, indent #{indent.inspect}, ascii #{ascii}: #{tape}")
  end
end

# A document of more keys than the builder's stack holds: their spans
# move to the heap, and a repeat among them is still seen by the end.
Tape.use do
  w = Tape::String::Writer.new(16)
  JSON.write(w) { |b| b.object { 300.times { |i| b.field "k#{i}", i } } }
  check(failures, JSON.parse(w.finish).size(0) == 300, "300 keys written and read back")
end

# `w.json` is `JSON.write(w)` with the writer first, options and all.
Tape.use do
  w = Tape::String::Writer.new(16)
  w.append("x:")
  w.json { |b| b.object { b.field "a", 1 } }
  w.json(2, true) { |b| b.array { b.string "é" } }
  check(failures, w.finish.to_s == %(x:{"a":1}[\n  "\\u00e9"\n]), "w.json writes as JSON.write")
end

# A document copied through the builder is the heap builder's text of it,
# its escapes decoded and written again, in every mode.
Tape.use do
  doc = JSON.parse(Tape::String.new(text))
  [nil, 2].each do |indent|
    [false, true].each do |ascii|
      w = Tape::String::Writer.new(16)
      JSON.write(w, indent, ascii) { |b| b.value(doc, doc.root) }
      heap = JSON.build(indent) do |b|
        b.ascii_only = ascii
        JSON.parse(text).to_json(b)
      end
      check(failures, w.finish.to_s == heap, "copied alike, indent #{indent.inspect}, ascii #{ascii}")
    end
  end
  w = Tape::String::Writer.new(16)
  JSON.write(w) do |b|
    b.object { doc.each(doc.root) { |child| b.field(doc, child); b.number doc.kind(child).value } }
  end
  check(failures, w.finish.to_s == %({"a":5,"bA":6,"e":5}), "keys copied, an escaped one decoded")
end

GC.disable
small = %({"id":1,"name":"us\\"er","tags":["a","b"],"ok":true,"n":null})
before = IyiMark.allocated_since
total = 0_i64
2000.times do
  Tape.use do
    doc = JSON.parse(Tape::String.new(small))
    w = Tape::String::Writer.new(64)
    JSON.write(w) do |b|
      b.object do
        doc.each(doc.root) { |child| b.field(doc, child); b.value(doc, child) }
      end
    end
    total = total &+ w.length
  end
end
per = (IyiMark.allocated_since - before) // 2000
GC.enable
check(failures, per == 0, "a parse and a build on the tape: #{per} heap bytes")
check(failures, total == 2000 * small.bytesize, "written #{total}")

if failures.empty?
  puts "PASS: parsed, refused alike, written alike, on the tape"
else
  failures.each { |f| puts "FAILED #{f}" }
end
