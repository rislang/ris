module test/semantic_version_driver

import std/semantic_version::{SemanticVersion}

kept = ""
owned = nil.as(SemanticVersion?)
tape do
  version = SemanticVersion.parse("1.2.3-beta.11+build.7\r\n")
  earlier = SemanticVersion.parse("1.2.3-beta.2")
  w = String::Builder.new(1)
  w << "prefix:"
  version.write(w)
  owned = version.copy_to(Program.tape)
  huge = "999999999999999999.0.0"
  kept = version.to_tape.copy_to(Program.tape)
end
puts "PASS: semantic_version views and owned copy"
