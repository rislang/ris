# spec: 3.7@64779b1c
# SPEC 3.7: a class default is made in the cycle def, as at the call.
class C
  def initialize(@n : Int32 = 0)
  end
end

@[OnTape]
struct P
  def initialize
    @nodes = Array(C).new(8)
  end

  # Answering the Array it stored into keeps the store checked.
  def node(a = -1, v = C.new)
    @nodes << v
  end

  def pipe(d : Int32) : Int32
    return 0 if d > 3
    b = other(d + 1)
    node(b).size
  end

  def other(d : Int32) : Int32
    pipe(d)
  end
end

p = P.new
puts p.pipe(0)
