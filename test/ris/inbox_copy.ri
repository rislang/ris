module test/ris/inbox_copy

# Faults run after a real receiver-side copy, outside the scheduler lock.
struct ::Str
  def self.new(text : Str) : self
    value = Str.build(text.bytesize) { |w| w << text }
    if text == "cancel-copy"
      IyiScheduler.current.cancelled = true
    elsif text == "fail-copy"
      raise "forced inbox copy failure"
    end
    value
  end
end

def check_retained(q : RisInbox(Str)) : Nil
  raise "failed copy consumed mail" unless q.size == 1
  # A leaked pin would prevent this retirement from releasing the message.
  raise "copy pin leaked" unless IyiScheduler.current.inbox_copy_slot == -1
end

group do |g|
  owner = g.spawn do
    q = g.new_inbox(Str, 1)
    q.send(Str.new("cancel-copy"))
    raise "copy cancellation" unless q.receive.is_a?(Cancelled)
    raise "copy cancelled mail" unless q.size == 1
    nil
  end
  owner.value
end
group do |g|
  owner = g.spawn do
    q = g.new_inbox(Str, 1)
    q.send(Str.new("fail-copy"))
    defer check_retained(q)
    q.receive
    nil
  end
  result = owner.value
  raise "missing copy panic" unless result.is_a?(Panicked) &&
    result.message == "forced inbox copy failure"
end
puts "PASS: inbox copy"
