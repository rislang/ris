# A PatternView is an index into its router's storage
# (doc/drafts/checker-open-questions/, Q3): kept past the def that made
# the router, it would read freed storage.
import std/router::{Router, PatternView}

def first_pattern : PatternView
  router = Router.new
  router.parse("GET /a").as(PatternView)
end

puts first_pattern.to_s
