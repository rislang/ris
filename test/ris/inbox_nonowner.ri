module test/ris/inbox_nonowner

group do |g|
  q = g.new_inbox(Int32, 1)
  thief = g.spawn { q.receive }
  result = thief.value
  raise "expected panic" unless result.is_a?(Panicked)
  raise "safe form" unless result.is_a?(Panicked) &&
    result.message.includes?("send to it, or make the inbox in the receiving task")
end
puts "PASS: inbox nonowner"
