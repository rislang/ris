module test/ris/lifetime_flow
import std/int

def make_text : Tape::String
  return Tape::String.build { |w| w.push(65_u8) }
end

def with_text(&)
  Tape.run { yield make_text }
end

def forward(&)
  yield
end

with_text { |text| puts text.to_s }
Tape.run do
  kept = nil
  items = Tape::Array(Tape::String).new(0)
  items.push(make_text)
  items.each { |text| kept = text }
  if text = kept
    puts text.to_s
  end
  nested = Tape.run { break make_text }
  if text = nested
    puts text.to_s
  end
  forward do
    local = make_text
    puts local.to_s
  end
end
