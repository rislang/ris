module test/ris/nested_containers

outer = [[1, 2], [3]]
inner = outer[0]
inner << 4
raise "nested mutation lost" unless outer[0].size == 3
raise "nested value lost" unless outer[0][2] == 4
raise "sibling changed" unless outer[1][0] == 3

source = [9]
outer << source
source << 10
raise "store did not copy run" unless outer[2].size == 1
outer[0] = [7]
raise "replacement lost" unless outer[0][0] == 7
empty = Array(Array(Int32)).new
empty << [] of Int32
empty[0] << 8
raise "empty run growth lost" unless empty[0][0] == 8
nested = [[[1]], [[2]]]
nested[0][0] << 3
raise "deep run mutation lost" unless nested[0][0][1] == 3
map = {"a" => [1, 2]}
map["a"] << 3
raise "hash run mutation lost" unless map["a"][2] == 3

copy = nested.copy_to(Program.tape)
copy[0][0] << 4
raise "copied handles lost" unless copy[0][0][2] == 4
raise "copy aliases source" unless nested[0][0].size == 2
outer.clear
raise "copied handles freed" unless copy[1][0][0] == 2
bytes = Array(Array(UInt8)).new
bytes << [] of UInt8
bytes[0].append("ab")
bytes[0].write_bytes(0x6463_u16)
raise "byte run growth lost" unless bytes[0].bytes == "abcd"
puts "PASS: nested containers"
