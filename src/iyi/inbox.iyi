# Runtime-only typed pools. All access is under IyiSchedLock except a
# pinned copy's private message bytes. No pool contains a borrowed Str.
struct RisInboxRecord
  property free_next : Int32 = -1
  property recycled : Bool = false
  property owner_prev : Int32 = -1
  property owner_next : Int32 = -1
  property group_prev : Int32 = -1
  property group_next : Int32 = -1
  property generation : UInt64 = 1_u64
  property live : Bool = false
  property closed : Bool = false
  property owner : UInt64 = 0_u64
  property group : UInt64 = 0_u64
  property capacity : Int32 = 0
  property count : Int32 = 0
  property budget : UInt64 = 0_u64
  property used : UInt64 = 0_u64
  property head : Int32 = -1
  property tail : Int32 = -1
  property pins : Int32 = 0
  # One receiver, hence one reusable typed wait node per inbox.
  property waiting : Bool = false
  property nonce : UInt64 = 0_u64

  def initialize
  end
end

struct RisInboxMessage
  property live : Bool = false
  property following : Int32 = -1
  property charge : UInt64 = 0_u64
  property text : UInt64 = 0_u64
  property length : Int32 = 0
  # Inline scalar representation; read only with the handle's T.
  property bits : UInt128 = 0_u128

  def initialize
  end
end

module RisInboxPool
  RECORDS = 4096
  MESSAGES = 65536
  @@record_free : Int32 = 0
  @@message_free : Int32 = 0
  @@storage_heads : UInt64 = 0_u64
  @@storage_maps : UInt64 = 0_u64
  @@owner_touches : UInt64 = 0_u64
  @@records : UInt64 = 0_u64
  @@messages : UInt64 = 0_u64

  def self.init : Nil
    return if @@records != 0
    @@records = __iyi_mmap(RECORDS.to_u64 * sizeof(RisInboxRecord)).address
    @@messages = __iyi_mmap(MESSAGES.to_u64 * sizeof(RisInboxMessage)).address
    @@storage_heads = __iyi_mmap(16_u64 * 8_u64).address
    i = 0
    while i < RECORDS
      record(i).value = RisInboxRecord.new
      record(i).value.free_next = i + 1 < RECORDS ? i + 1 : -1
      i += 1
    end
    i = 0
    while i < MESSAGES
      message(i).value = RisInboxMessage.new
      message(i).value.following = i + 1 < MESSAGES ? i + 1 : -1
      i += 1
    end
  end

  def self.record(slot : Int32) : Pointer(RisInboxRecord)
    Pointer(RisInboxRecord).new(@@records) + slot
  end

  def self.message(slot : Int32) : Pointer(RisInboxMessage)
    Pointer(RisInboxMessage).new(@@messages) + slot
  end

  def self.valid?(slot : Int32, generation : UInt64) : Bool
    @@records != 0 && slot >= 0 && slot < RECORDS &&
      record(slot).value.live && record(slot).value.generation == generation
  end

  def self.exhausted : NoReturn
    RisHeap.text("ris: fatal: inbox pool exhausted; use fewer live inboxes or messages\n")
    __iyi_exit(1)
  end

  def self.allocate(owner : UInt64, group : UInt64, capacity : Int32,
                    budget : UInt64) : Tuple(Int32, UInt64)
    init
    i = @@record_free
    exhausted if i < 0
    p = record(i)
    generation = p.value.generation
    @@record_free = p.value.free_next
    r = RisInboxRecord.new
    r.generation = generation
    r.live = true
    r.owner = owner
    r.group = group
    r.capacity = capacity
    r.budget = budget
    fiber = Pointer(Void).new(owner).as(IyiFiber)
    scope = Pointer(Void).new(group).as(IyiGroup)
    r.owner_next = fiber.owned_inbox_head
    r.group_next = scope.owned_inbox_head
    record(r.owner_next).value.owner_prev = i if r.owner_next >= 0
    record(r.group_next).value.group_prev = i if r.group_next >= 0
    fiber.owned_inbox_head = i
    scope.owned_inbox_head = i
    p.value = r
    {i, generation}
  end

  def self.allocate_message : Int32
    i = @@message_free
    exhausted if i < 0
    @@message_free = message(i).value.following
    m = RisInboxMessage.new
    m.live = true
    message(i).value = m
    i
  end

  # Power-of-two classes 32 bytes through 1 MiB, including the header.
  # Slabs have at least 64 KiB; larger texts map directly.
  def self.storage_size(length : Int32) : UInt64
    size = 32_u64
    needed = length.to_u64 + 16_u64
    while size < needed && size < 1048576_u64
      size *= 2_u64
    end
    size
  end

  def self.storage_head(size : UInt64) : Pointer(UInt64)
    index = 0
    n = 32_u64
    while n < size
      index += 1
      n *= 2_u64
    end
    Pointer(UInt64).new(@@storage_heads) + index
  end

  def self.allocate_text(length : Int32) : UInt64
    needed = length.to_u64 + 16_u64
    if needed > 1048576_u64
      @@storage_maps += 1_u64
      return __iyi_mmap(needed).address
    end
    size = storage_size(length)
    head = storage_head(size)
    if head.value == 0
      bytes = size < 65536_u64 ? 65536_u64 : size
      @@storage_maps += 1_u64
      base = __iyi_mmap(bytes).address
      offset = 0_u64
      while offset < bytes
        Pointer(UInt64).new(base + offset).value = head.value
        head.value = base + offset
        offset += size
      end
    end
    result = head.value
    head.value = Pointer(UInt64).new(result).value
    result
  end

  def self.release(slot : Int32) : Nil
    m = message(slot).value
    if m.text != 0
      if m.length.to_u64 + 16_u64 > 1048576_u64
        __iyi_munmap(m.text, m.length.to_u64 + 16_u64)
      else
        head = storage_head(storage_size(m.length))
        Pointer(UInt64).new(m.text).value = head.value
        head.value = m.text
      end
    end
    message(slot).value = RisInboxMessage.new
    message(slot).value.following = @@message_free
    @@message_free = slot
  end

  def self.storage_maps : UInt64
    @@storage_maps
  end

  def self.owner_touches : UInt64
    @@owner_touches
  end

  def self.recycle(p : Pointer(RisInboxRecord)) : Nil
    r = p.value
    return if r.live || r.pins != 0 || r.recycled
    return if r.generation == 18446744073709551615_u64
    r.recycled = true
    r.free_next = @@record_free
    @@record_free = (p - Pointer(RisInboxRecord).new(@@records)).to_i32
    p.value = r
  end

  def self.wake(r : Pointer(RisInboxRecord)) : Nil
    value = r.value
    if value.waiting
      fiber = Pointer(Void).new(value.owner).as(IyiFiber)
      if fiber.state == IyiFiberState::WaitingCh &&
         fiber.park_nonce == value.nonce
        IyiScheduler.ready(fiber)
      end
      value.waiting = false
      r.value = value
    end
  end

  def self.discard(r : Pointer(RisInboxRecord)) : Nil
    value = r.value
    value.closed = true
    r.value = value
    wake(r)
    value = r.value
    return if value.pins != 0
    while value.head >= 0
      next_slot = message(value.head).value.following
      release(value.head)
      value.head = next_slot
    end
    value.tail = -1
    value.count = 0
    value.used = 0_u64
    r.value = value
    recycle(r)
  end

  # Called before the task leaves the scheduler registry, including panic.
  def self.owner_died(owner : UInt64) : Nil
    fiber = Pointer(Void).new(owner).as(IyiFiber)
    while fiber.owned_inbox_head >= 0
      @@owner_touches += 1_u64
      retire(record(fiber.owned_inbox_head))
    end
  end

  def self.retire(p : Pointer(RisInboxRecord)) : Nil
    r = p.value
    fiber = Pointer(Void).new(r.owner).as(IyiFiber)
    scope = Pointer(Void).new(r.group).as(IyiGroup)
    if r.owner_prev < 0
      fiber.owned_inbox_head = r.owner_next
    else
      record(r.owner_prev).value.owner_next = r.owner_next
    end
    record(r.owner_next).value.owner_prev = r.owner_prev if r.owner_next >= 0
    if r.group_prev < 0
      scope.owned_inbox_head = r.group_next
    else
      record(r.group_prev).value.group_next = r.group_next
    end
    record(r.group_next).value.group_prev = r.group_prev if r.group_next >= 0
    r.live = false
    r.generation += 1_u64 unless r.generation == 18446744073709551615_u64
    p.value = r
    discard(p)
  end

  def self.group_ended(group : UInt64) : Nil
    scope = Pointer(Void).new(group).as(IyiGroup)
    while scope.owned_inbox_head >= 0
      retire(record(scope.owned_inbox_head))
    end
  end
end

@[Share(owns: true)]
struct RisInbox(T)
  @slot : Int32
  @generation : UInt64

  private def initialize(@slot : Int32, @generation : UInt64)
  end

  private def self.new(slot : Int32, generation : UInt64) : self
    made = uninitialized self
    pointerof(made.@slot).value = slot
    pointerof(made.@generation).value = generation
    made
  end

  def self.__create(slot : Int32, generation : UInt64) : self
    new(slot, generation)
  end

  pub struct Full
    def initialize
    end
  end

  pub struct Closed
    def initialize
    end
  end

  def send(value : T) : Nil | Full | Closed
    fiber = IyiScheduler.current
    defer __iyi_inbox_send_cleanup
    IyiSchedLock.lock
    unless RisInboxPool.valid?(@slot, @generation)
      IyiSchedLock.unlock
      return Closed.new
    end
    p = RisInboxPool.record(@slot)
    r = p.value
    if r.closed
      IyiSchedLock.unlock
      return Closed.new
    end
    charge = (sizeof(T).to_u64 + 7_u64) & 0xFFFFFFFFFFFFFFF8_u64
    {% if T == Str %}
      charge += (value.bytesize.to_u64 + 16_u64 + 7_u64) & 0xFFFFFFFFFFFFFFF8_u64
    {% end %}
    if r.count >= r.capacity || charge > r.budget - r.used
      IyiSchedLock.unlock
      return Full.new
    end
    slot = RisInboxPool.allocate_message
    m = RisInboxPool.message(slot).value
    m.charge = charge
    RisInboxPool.message(slot).value = m
    r.count += 1
    r.used += charge
    r.pins += 1
    fiber.inbox_send_slot = @slot
    fiber.inbox_send_message = slot
    p.value = r
    IyiSchedLock.unlock
    {% if T == Str %}
      m.length = value.bytesize
      IyiSchedLock.lock
      m.text = RisInboxPool.allocate_text(m.length)
      RisInboxPool.message(slot).value = m
      IyiSchedLock.unlock
      Pointer(UInt8).new(m.text + 16_u64).copy_from(value.to_unsafe, m.length)
    {% else %}
      pointerof(m.@bits).as(Pointer(T)).value = value
    {% end %}
    IyiSchedLock.lock
    r = p.value
    r.pins -= 1
    fiber.inbox_send_slot = -1
    fiber.inbox_send_message = -1
    RisInboxPool.message(slot).value = m
    if !r.live || r.closed
      r.count -= 1
      r.used -= charge
      p.value = r
      RisInboxPool.release(slot)
      RisInboxPool.discard(p) unless r.live
      IyiSchedLock.unlock
      return Closed.new
    end
    if r.tail < 0
      r.head = slot
    else
      previous = RisInboxPool.message(r.tail).value
      previous.following = slot
      RisInboxPool.message(r.tail).value = previous
    end
    r.tail = slot
    p.value = r
    RisInboxPool.wake(p)
    IyiSchedLock.unlock
    nil
  end

  def <<(value : T) : Nil | Full | Closed
    send(value)
  end

  def receive : T | Closed | Cancelled
    fiber = IyiScheduler.current
    defer __iyi_inbox_copy_cleanup
    IyiSchedLock.lock
    loop do
      unless RisInboxPool.valid?(@slot, @generation)
        IyiSchedLock.unlock
        return Closed.new
      end
      p = RisInboxPool.record(@slot)
      r = p.value
      if r.owner != fiber.object_id
        IyiSchedLock.unlock
        raise "only the inbox owner receives; send to it, or make the inbox in the receiving task"
      end
      if fiber.cancelled
        IyiSchedLock.unlock
        return Cancelled.new
      end
      if r.head >= 0
        slot = r.head
        m = RisInboxPool.message(slot).value
        r.pins += 1
        fiber.inbox_copy_slot = @slot
        p.value = r
        IyiSchedLock.unlock
        value = uninitialized T
        {% if T == Str %}
          value = Str.new(Str.new(Pointer(UInt8).new(m.text + 16_u64), m.length))
        {% else %}
          value = pointerof(m.@bits).as(Pointer(T)).value
        {% end %}
        IyiSchedLock.lock
        r = p.value
        r.pins -= 1
        fiber.inbox_copy_slot = -1
        p.value = r
        unless r.live && r.generation == @generation
          RisInboxPool.discard(p)
          IyiSchedLock.unlock
          return Closed.new
        end
        if fiber.cancelled
          IyiSchedLock.unlock
          return Cancelled.new
        end
        r.head = m.following
        r.tail = -1 if r.head < 0
        r.count -= 1
        r.used -= m.charge
        p.value = r
        RisInboxPool.release(slot)
        IyiSchedLock.unlock
        return value
      end
      if r.closed
        IyiSchedLock.unlock
        return Closed.new
      end
      r.nonce = IyiScheduler.park(fiber)
      r.waiting = true
      p.value = r
      IyiSchedLock.unlock
      IyiScheduler.reschedule
      IyiSchedLock.lock
    end
  end

  def close : Nil | Closed
    IyiSchedLock.lock
    unless RisInboxPool.valid?(@slot, @generation)
      IyiSchedLock.unlock
      return Closed.new
    end
    p = RisInboxPool.record(@slot)
    r = p.value
    r.closed = true
    p.value = r
    RisInboxPool.wake(p)
    IyiSchedLock.unlock
    nil
  end

  {% for method in [:closed?, :size, :empty?, :capacity] %}
    def {{method.id}}
      IyiSchedLock.lock
      unless RisInboxPool.valid?(@slot, @generation)
        IyiSchedLock.unlock
        return Closed.new
      end
      r = RisInboxPool.record(@slot).value
      IyiSchedLock.unlock
      {% if method == :closed? %}
        r.closed
      {% elsif method == :size %}
        r.count
      {% elsif method == :empty? %}
        r.count == 0
      {% else %}
        r.capacity
      {% end %}
    end
  {% end %}
end

impl Error for RisInbox::Full
  def message : String
    "inbox full"
  end
end

impl Error for RisInbox::Closed
  def message : String
    "inbox closed"
  end
end

class IyiGroup
  def new_inbox(type : T.class, capacity : Int32 | Int64,
                *, bytes : Int32 | Int64 | UInt64 | Nil = nil) : RisInbox(T) forall T
    {% unless T == Int8 || T == Int16 || T == Int32 || T == Int64 ||
              T == Int128 || T == UInt8 || T == UInt16 || T == UInt32 ||
              T == UInt64 || T == UInt128 || T == Float32 || T == Float64 ||
              T == Bool || T == Char || T == Symbol || T == Nil ||
              T < Enum || T == Str %}
      {% raise "RisInbox payload is not supported yet; use g.new_inbox with a scalar or Str" %}
    {% end %}
    n = RisRegion.count(RisRegion.nonnegative(capacity.to_i64))
    raise "inbox capacity 0 is refused; use request for rendezvous" if n == 0
    budget = bytes.is_a?(Nil) ? (n < 16_u64 ? 65536_u64 : n * 4096_u64) :
      bytes.is_a?(UInt64) ? bytes : RisRegion.nonnegative(bytes.to_i64)
    raise "inbox bytes must be positive; use bytes: 65536" if budget == 0
    IyiSchedLock.lock
    if @ended || @cancelled || IyiScheduler.current.cancelled
      IyiSchedLock.unlock
      raise "inbox needs a live group; use a live outer group"
    end
    slot, generation = RisInboxPool.allocate(IyiScheduler.current.object_id,
      object_id, n.to_i32, budget)
    IyiSchedLock.unlock
    RisInbox(T).__create(slot, generation)
  end
end

# Noncapturing unwind guard: a failed receive keeps its queued message.
# The owner-death hook subsequently discards it if the task actually dies.
def __iyi_inbox_copy_cleanup : Nil
  fiber = IyiScheduler.current
  slot = fiber.inbox_copy_slot
  return if slot < 0
  IyiSchedLock.lock
  p = RisInboxPool.record(slot)
  r = p.value
  r.pins -= 1
  p.value = r
  fiber.inbox_copy_slot = -1
  RisInboxPool.discard(p) unless r.live
  IyiSchedLock.unlock
end

# A reservation is private until publication. Unwind returns both credits.
def __iyi_inbox_send_cleanup : Nil
  fiber = IyiScheduler.current
  slot = fiber.inbox_send_slot
  return if slot < 0
  IyiSchedLock.lock
  p = RisInboxPool.record(slot)
  r = p.value
  message = fiber.inbox_send_message
  r.pins -= 1
  r.count -= 1
  r.used -= RisInboxPool.message(message).value.charge
  p.value = r
  RisInboxPool.release(message)
  fiber.inbox_send_slot = -1
  fiber.inbox_send_message = -1
  RisInboxPool.discard(p) unless r.live
  IyiSchedLock.unlock
end

# Test counters are read under the same lock as pool mutations.
def __ris_inbox_storage_maps : UInt64
  IyiSchedLock.lock
  value = RisInboxPool.storage_maps
  IyiSchedLock.unlock
  value
end

def __ris_inbox_owner_touches : UInt64
  IyiSchedLock.lock
  value = RisInboxPool.owner_touches
  IyiSchedLock.unlock
  value
end
