module test/ris/refused/outer_var

import std/int

@[OnTape]
struct Resp
  getter id : Int64
  getter user : Tape::String

  def initialize(@id : Int64, @user : Tape::String)
  end
end

def make : Resp
  Resp.new(1_i64, Tape::String.build { |s| s.push(97_u8) })
end

# A variable of the code around the scope outlives it.
kept = nil
Tape.scope do
  kept = make
end
puts kept.nil?
