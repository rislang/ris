# Tape values: checked sizes and allocation-free fatal size diagnostics.
#
# Main and each spawned fiber own an implicit tape: values are bumped into
# mappings, chained when full. The owning scope releases them together;
# spare mappings keep bounded warm pages for the thread's next scope.
# String, Array, Hash and RisTree store their dynamic data on the active tape.
# Retained values are copied into an explicit longer-lived owner.
#
# What keeps a tape value from outliving its scope is the compiler: every
# struct marked `@[OnTape]` is a tape type, and `Iyi::TapeChecker` and
# `TapeLifetimeChecker` refuse a tape value in a class's field, a
# non-tape struct's field, a class variable, a generic's type argument, a
# proc's captures, a `tape` block's value, or a variable of the code
# around the scope.
#
# Writers, arrays and trees hold pointers to state blocks on the tape;
# copies share that state. Its fourth word names its payload reservation
# on Linux, acquired before any element is published.
# A String is an immutable byte view.
# Copying a tape value does not copy its backing storage.

# Internal ABI: the normalizer lowers only the runtime's own tape guard to
# a cached registry entry plus an inline release on normal exits.
def __iyi_tape_release : Nil
  RisRegion.release_tape
end

# Compiler-generated initializer boundary; not a user lifetime escape hatch.
def __ris_program_init(&)
  RisRegion.program_scope { yield }
end

class Program
  # An owner parameter today; other owner kinds are added separately.
  struct TapeOwner
    def run(&)
      RisRegion.program_scope { yield }
    end
  end

  # Arguments borrow the process's bytes for the program's lifetime.
  def self.arguments : Array(String)
    {% if flag?(:win32) %}
      # Keep the existing UTF-16 command-line decoder during migration.
      legacy = args
      Array(String).new(legacy.size) { |i| String.new(legacy[i]) }
    {% else %}
      count = ARGC_UNSAFE > 0 ? ARGC_UNSAFE - 1 : 0
      Array(String).new(count) do |i|
        bytes = ARGV_UNSAFE[i + 1]
        size = 0
        while bytes[size] != 0_u8
          size += 1
        end
        String.new(bytes, size)
      end
    {% end %}
  end

  def self.tape : TapeOwner
    TapeOwner.new
  end
end

# Runs the block on the fiber's implicit tape, sharing its storage.
# Main or the spawned body releases it; scopes keeping nothing reset their
# part. Use local_tape for a separate owning scope of temporaries.
#
# Returns nothing: a block's value is the one thing that leaves it
# without an assignment the compiler can see, so it is not passed on.
# What must outlive the block is copied into a variable of the code
# around it with `copy_to(owner)`.
def tape(&) : Nil
  RisRegion.tape_scope(Tape::CAPACITY) { yield }
  nil
end

# A tape of its own, even inside a `tape` block, freed when the block
# ends: for work whose temporaries should not stay on the outer tape
# until it ends. Copy what is kept before leaving. Outer `String`s
# may be read; other outer tape values become owned data first.
def local_tape(&) : Nil
  RisRegion.tape_local(Tape::CAPACITY) { yield }
  nil
end

# Internals of the tape types: `String`, `Array`, `RisTree` and theirs.
module Tape
  # An index out of range: raised out of line, so the `[]` inlined at
  # every read keeps only its compare and branch, not the building of
  # the message, and stays cheap for LLVM's inliner where it lands.
  @[NoInline]
  def self.out_of_range(index : Int32, count : Int32, what : ::String) : NoReturn
    raise "index #{index} out of range for #{count} #{what}"
  end

  # The room an array grows to from *room*: twice as much, but no more
  # than an Int32 counts, so its size is one at every read without a
  # check there. An array at that room has no more to give.
  def self.grown(room : UInt64) : UInt64
    return 1_u64 if room == 0_u64
    limit = 2147483647_u64
    RisRegion.size_error("iyi: tape array full: ", limit) if room >= limit
    room < limit // 2_u64 + 1_u64 ? RisRegion.size_mul(room, 2_u64) : limit
  end

  # Check element bytes before count limits, and before allocating state.
  def self.storage(capacity : Int32 | Int64, width : UInt64) : UInt64
    count = RisRegion.nonnegative(capacity.to_i64)
    bytes = RisRegion.size_mul(count, width)
    RisRegion.count(count)
    RisRegion.size_add(40_u64, bytes)
  end

  CAPACITY = 67108864_u64

  def self.copy_value(value, owner)
    value.copy_to(owner)
  end

  # Implicit result placement never invokes a user-defined copy callback.
  def self.copy_value(value, owner : RisPendingCopy)
    value.__iyi_pending_copy(owner)
  end

  # Validate the public shape, not the pointers backing tape containers.
  # The compiler tracks visited types and refuses recursive class shapes.
  def self.check_copy(type : T.class, path : P.class,
                      task : Task.class = Nil) : Nil forall T, P, Task
    # The compiler checks the reflected shape without spelling private types.
  end

  # A struct is flat when each field is a number, a `Link`, a `Span` or
  # another flat struct: it has no pointer, so its bytes are its value.
  annotation Flat
  end
end

# An immutable view of static bytes or bytes belonging to a tape owner.
@[OnTape]
struct String
  def __iyi_copy_into(target : Pointer(self), work : RisCopyWork) : Nil
    target.value = String.new(self)
  end

  @ptr : Pointer(UInt8)
  @bytesize : Int32

  # Built in a local, not by `initialize`: a store through `self` in
  # `initialize` takes the collector's write barrier (codegen cannot see
  # that `self` is a stack slot there), one into a local's field does not.
  def initialize(@ptr : Pointer(UInt8), @bytesize : Int32)
  end

  def self.new(ptr : Pointer(UInt8), bytesize : Int32) : self
    RisRegion.nonnegative(bytesize.to_i64)
    made = uninitialized self
    pointerof(made.@ptr).value = ptr
    pointerof(made.@bytesize).value = bytesize
    made
  end

  # *text*'s bytes copied onto the tape: a String a program has, made a
  # tape string without a raw pointer.
  def self.new(text : String) : self
    bytes = Pointer(UInt8).new(RisRegion.tape_bytes(text.bytesize.to_u64))
    bytes.copy_from(text.to_unsafe, text.bytesize)
    new(bytes, text.bytesize)
  end

  # A view of immutable bytes. The source owner must outlive the view.
  def self.view(text : String) : self
    new(text.to_unsafe, text.bytesize)
  end

  # Allocate writable bytes on the caller's tape, including a C terminator.
  def self.new(size : Int32, & : Pointer(UInt8) -> _) : self
    RisRegion.nonnegative(size.to_i64)
    bytes = Pointer(UInt8).new(RisRegion.tape_bytes(size.to_u64 + 1_u64))
    yield bytes
    bytes[size] = 0_u8
    new(bytes, size)
  end

  def __iyi_pending_copy(owner : RisPendingCopy) : self
    copy_to(owner)
  end

  def copy_to(owner) : self
    Tape.owner_copy(self, owner)
  end

  def copy_to(owner : RisPendingCopy) : self
    if owner.is_a?(RisPendingCopy)
      return self unless owner.contains?(@ptr.address)
    end
    owner.run { String.new(self) }
  end

  def +(other : String) : String
    String.build(RisRegion.count(RisRegion.size_add(
      bytesize.to_u64, other.bytesize.to_u64)).to_i32) do |writer|
      writer.append(self)
      writer.append(other)
    end
  end

  def *(count : Int32) : String
    repeats = RisRegion.nonnegative(count.to_i64)
    room = RisRegion.count(RisRegion.size_mul(bytesize.to_u64, repeats))
    String.build(room.to_i32) do |writer|
      count.times { writer.append(self) }
    end
  end

  def size : Int32
    bytesize
  end

  def byte_at(index : Int32) : UInt8
    self[index]
  end

  def as_tape : self
    self
  end

  def hash : Int32
    value = -2128831035
    each_byte { |byte| value = (value ^ byte.to_i32) &* 16777619 }
    value
  end

  def ===(other : String) : Bool
    self == other
  end

  def bytesize : Int32
    @bytesize
  end

  def empty? : Bool
    @bytesize == 0
  end

  # The byte at *index*, from the end when negative; one out of range
  # raises rather than reading what follows. `to_unsafe` is the library's.
  # Byte order, with a prefix before the text it prefixes, as String's.
  def <(other : String) : Bool
    index = 0
    while index < @bytesize && index < other.bytesize
      a = @ptr[index]
      b = other[index]
      return a < b if a != b
      index += 1
    end
    @bytesize < other.bytesize
  end

  # One unsigned compare on the way to the byte; a negative index
  # takes the other branch, counted from the end.
  def [](index : Int32) : UInt8
    unless index.unsafe_to_u64 < @bytesize.unsafe_to_u64
      asked = index
      index = index + @bytesize
      unless asked < 0 && index.unsafe_to_u64 < @bytesize.unsafe_to_u64
        Tape.out_of_range(asked, @bytesize, "bytes")
      end
    end
    @ptr[index]
  end

  # One byte-range check, then one load where words are little-endian
  # and a load need not be aligned; elsewhere a copy into an aligned
  # local, its bytes turned around.
  def read_bytes_at(type : I.class, at : Int32) : I forall I
    {% unless I == UInt16 || I == UInt32 || I == UInt64 ||
                I == Int16 || I == Int32 || I == Int64 %}
      {% raise "little-endian fields need a 16/32/64-bit integer" %}
    {% end %}
    width = sizeof(I)
    if at < 0 || at > @bytesize - width
      raise "little-endian field out of range"
    end
    {% if flag?(:x86_64) || flag?(:aarch64) || flag?(:i386) %}
      return (@ptr + at).as(Pointer(I)).unaligned_value
    {% end %}
    value = uninitialized I
    target = pointerof(value).as(Pointer(UInt8))
    target.copy_from(@ptr + at, width)
    {% unless flag?(:x86_64) || flag?(:aarch64) || flag?(:arm) ||
                flag?(:i386) || flag?(:wasm32) %}
      i = 0
      while i < sizeof(I) // 2
        j = sizeof(I) - i - 1
        byte = target[i]
        target[i] = target[j]
        target[j] = byte
        i = i + 1
      end
    {% end %}
    value
  end

  # *count* bytes from *start*, a view of these: nothing is copied.
  def [](start : Int32, count : Int32) : String
    raise "negative count: #{count}" if count < 0
    start += @bytesize if start < 0
    if start < 0 || start > @bytesize
      raise "string slice start out of bounds"
    end
    count = @bytesize - start if count > @bytesize - start
    String.new(@ptr + start, count)
  end

  # The bytes *range* names, a view, as `Array#[](range)` reads one: a
  # negative end counts from the last, an endless one runs to it, and a
  # range that begins past the end is refused. `line[space + 1..]` is
  # the rest of the line.
  def [](range : Range(B, E)) : String forall B, E
    from = range.begin
    start = from.nil? ? 0 : from
    start = @bytesize + start if start < 0
    raise "range #{range} out of range for #{@bytesize} bytes" if start < 0 || start > @bytesize
    to = range.end
    stop = to.nil? ? @bytesize : (to < 0 ? @bytesize + to : to)
    if stop >= @bytesize
      stop = @bytesize
    elsif !range.exclusive?
      stop = stop + 1
    end
    String.new(@ptr + start, stop > start ? stop - start : 0)
  end

  def each_byte(& : UInt8 -> _) : Nil
    i = 0
    while i < @bytesize
      yield @ptr[i]
      i = i + 1
    end
  end

  # Each line, as `String#each_line` (std/text) splits them: a final
  # newline closing the last rather than opening an empty one, and a `\r`
  # before a newline left off. Each line is a view: nothing is copied.
  def each_line(& : String -> Nil) : Nil
    start = 0
    at = 0
    while at < @bytesize
      if @ptr[at] == 10_u8
        stop = at > start && @ptr[at - 1] == 13_u8 ? at - 1 : at
        yield String.new(@ptr + start, stop - start)
        start = at + 1
      end
      at = at + 1
    end
    if start < @bytesize
      # No newline after it, so a `\r` here is text: `"b\r"` is `"b\r"`.
      yield String.new(@ptr + start, @bytesize - start)
    end
  end

  # Where *char* first is from *offset*, or nil, byte-indexed as
  # `String#index` is; a char past ASCII by its UTF-8 bytes.
  def index(char : Char, offset : Int32 = 0) : Int32?
    offset += bytesize if offset < 0
    return nil if offset < 0 || offset > bytesize
    if char.ord < 128
      byte = char.ord.to_u8
      at = offset
      while at < @bytesize
        return at if @ptr[at] == byte
        at = at + 1
      end
      return nil
    end
    # Its UTF-8 bytes, matched whole where they start.
    room = uninitialized StaticArray(UInt8, 4)
    wanted = pointerof(room).as(Pointer(UInt8))
    width = 0
    char.each_byte do |byte|
      wanted[width] = byte
      width = width + 1
    end
    at = offset
    while at + width <= @bytesize
      k = 0
      while k < width && @ptr[at + k] == wanted[k]
        k = k + 1
      end
      return at if k == width
      at = at + 1
    end
    nil
  end

  def includes?(char : Char) : Bool
    !index(char).nil?
  end

  # The pieces between each *separator*, as `String#split(Char)` cuts
  # them, empty ones kept; each a view, in a new array on the tape.
  def split(separator : Char) : Array(String)
    width = separator.bytesize
    pieces = Array(String).new
    start = 0
    while at = index(separator, start)
      pieces << self[start, at - start]
      start = at + width
    end
    pieces << self[start, @bytesize - start]
    pieces
  end

  # As `String#to_i`: the digits as an Int32, a mistake when they are not
  # one. `to_i?` answers nil instead. Read on the tape, nothing copied.
  def to_i : Int32
    to_i? || raise "not a number: #{@bytesize} bytes"
  end

  def to_i? : Int32?
    to_i?(10)
  end

  def to_i64? : Int64?
    to_i64?(10)
  end

  def to_f : Float64
    first = 0
    stop = @bytesize
    while first < stop && numeric_blank?(self[first])
      first += 1
    end
    while stop > first && numeric_blank?(self[stop - 1])
      stop -= 1
    end
    IyiFloatText.parse(self[first, stop - first])
  end

  private def numeric_blank?(byte : UInt8) : Bool
    byte == 32_u8 || (byte >= 9_u8 && byte <= 13_u8)
  end

  def to_i64?(base : Int32) : Int64?
    raise "base #{base} out of range (2..36)" if base < 2 || base > 36
    index = 0
    stop = @bytesize
    while index < stop && numeric_blank?(self[index])
      index += 1
    end
    while stop > index && numeric_blank?(self[stop - 1])
      stop -= 1
    end
    return nil if index == stop

    negative = to_unsafe[index] == 45_u8
    if negative || to_unsafe[index] == 43_u8
      return nil if index + 1 == stop
      index = index + 1
    end

    # The same negative accumulation, for the type whose own `MIN` a program
    # is most likely to read back: a nanosecond timestamp is an `Int64`.
    radix = base.to_i64
    limit = -9223372036854775808_i64
    bound = limit // radix
    cutoff = 0_i64 - (limit - bound * radix)

    value = 0_i64
    while index < stop
      b = to_unsafe[index]
      digit = -1_i64
      if b >= 48_u8 && b <= 57_u8
        digit = (b - 48_u8).to_i64
      elsif b >= 97_u8 && b <= 122_u8
        digit = (b - 97_u8).to_i64 + 10_i64
      elsif b >= 65_u8 && b <= 90_u8
        digit = (b - 65_u8).to_i64 + 10_i64
      else
        return nil
      end
      return nil if digit >= radix
      return nil if value < bound || (value == bound && digit > cutoff)
      value = value * radix - digit
      index = index + 1
    end

    return value if negative
    return nil if value == limit
    0_i64 - value
  end

  # The text *span* names, a view: checked, as a span read from bytes is
  # never trusted.
  def [](span : String::Span) : String
    self[span.start, span.size]
  end

  # `[]` in `while i < text.bytesize` (TapeCheckFreeLowering): the size
  # is fixed.
  @[AlwaysInline]
  def __loop_fetch(index : Int32) : UInt8
    Tape.out_of_range(index, @bytesize, "bytes") if index < 0
    @ptr[index]
  end

  # `read_bytes_at` in `while i + room <= text.bytesize`
  # (TapeCheckFreeLowering): *room* bytes from *at* are in range.
  @[AlwaysInline]
  def __loop_read_bytes_at(type : I.class, at : Int32, room : Int32) : I forall I
    return read_bytes_at(type, at) if sizeof(I) > room || at < 0
    {% if flag?(:x86_64) || flag?(:aarch64) || flag?(:i386) %}
      (@ptr + at).as(Pointer(I)).unaligned_value
    {% else %}
      read_bytes_at(type, at)
    {% end %}
  end

  def ==(other : String) : Bool
    @bytesize == other.bytesize && same?(other.to_unsafe)
  end

  def starts_with?(prefix : String) : Bool
    prefix.bytesize <= @bytesize && String.new(@ptr, prefix.bytesize) == prefix
  end

  # Eight bytes a step, as `String#==` does: keys and paths, a hash
  # table's every probe, are mostly shorter than its 32-byte stride.
  private def same?(other : Pointer(UInt8)) : Bool
    return true if @ptr.address == other.address
    i = 0
    while i + 8 <= @bytesize
      x = (@ptr + i).as(Pointer(UInt64))
      y = (other + i).as(Pointer(UInt64))
      return false unless x.value == y.value
      i = i + 8
    end
    while i < @bytesize
      return false if @ptr[i] != other[i]
      i = i + 1
    end
    true
  end

  def to_unsafe : Pointer(UInt8)
    @ptr
  end

  def dup : String
    String.new(self)
  end

  # Copies stay on the current tape; retention requires copy_to(owner).
  def to_s : String
    dup
  end

  def to_s(io : IyiIO) : Nil
    io.write(@ptr, @bytesize)
  end

  # Writes the bytes the block pushes straight onto the tape, where the
  # string will stay: no buffer to copy out of.
  def self.build(capacity : Int32 = 64, & : String::Builder -> _) : String
    writer = String::Builder.new(capacity)
    yield writer
    writer.finish
  end

  # ris interpolation writes every part on the caller's active tape.
  # Legacy iyi output lowering uses this too, on the caller's tape.
  def self.interpolation(*parts : *T) : String forall T
    interpolate(*parts)
  end

  def self.interpolate(*parts : *T) : String forall T
    build do |writer|
      {% for i in 0...T.size %}
        writer.append_value(parts[{{i}}])
      {% end %}
    end
  end
end

# The open end of a `String` being built: the address the next byte
# goes to, the end of the room and the start, in a block on the tape that
# the struct points at. Addresses rather than a length and capacity, so a
# push is one load, one compare and one store.
@[OnTape]
struct String::Builder
  def __iyi_copy_into(target : Pointer(self), work : RisCopyWork) : Nil
    made = self.class.new(length)
    made.append(finish)
    target.value = made
  end

  @state : Pointer(UInt64)

  def initialize(capacity : Int32 | Int64 = 64)
    bytes = Tape.storage(capacity, 1_u64)
    @state = RisRegion.growing_state(bytes, 1_u64)
    start = @state.value
    (@state + 1_i64).value = start &+ capacity.to_u64
    (@state + 2_i64).value = start
    (@state + 4_i64).value = RisRegion.program_active? ? 1_u64 : 0_u64
  end

  def __iyi_pending_copy(owner : RisPendingCopy) : self
    copy_to(owner)
  end

  def copy_to(owner) : self
    Tape.owner_copy(self, owner)
  end

  def copy_to(owner : RisPendingCopy) : self
    if owner.is_a?(RisPendingCopy)
      return self unless owner.contains?(@state.address)
      cached = owner.lookup(@state.address)
      if cached != 0
        made = self
        pointerof(made.@state).value = Pointer(UInt64).new(cached)
        return made
      end
    end
    owner.run do
      made = self.class.new(length)
      owner.remember(@state.address, made.@state.address) if owner.is_a?(RisPendingCopy)
      made.append(finish)
      made
    end
  end

  @[AlwaysInline]
  def push(byte : UInt8) : Nil
    cursor = @state.value
    if cursor >= (@state + 1_i64).value
      grow(1_u64)
      cursor = @state.value
    end
    Pointer(UInt8).new(cursor).value = byte
    @state.value = cursor &+ 1_u64
  end

  def append(text : String) : Nil
    append(text.to_unsafe, text.bytesize)
  end

  def append(text : String) : Nil
    append(text.to_unsafe, text.bytesize)
  end

  def append(bytes : Pointer(UInt8), count : Int32) : Nil
    RisRegion.nonnegative(count.to_i64)
    RisRegion.count(RisRegion.size_add(length.to_u64, count.to_u64))
    cursor = @state.value
    if cursor &+ count.to_u64 > (@state + 1_i64).value
      grow(count.to_u64)
      cursor = @state.value
    end
    LibTapeCopy.memcpy(Pointer(UInt8).new(cursor), bytes, count.to_u64, false) if count > 0
    @state.value = cursor &+ count.to_u64
  end

  # Room for *max* bytes, its address yielded for the OS to write into;
  # the block answers how many it wrote. Only a `@[TapeUnsafe]` def calls
  # it, and only to hand the address to a system call: `socket.read`
  # (TapePointerChecker).
  def unsafe_append(max : Int32, & : Pointer(UInt8) -> Int32) : Int32
    room = RisRegion.nonnegative(max.to_i64)
    reserve(RisRegion.count(RisRegion.size_add(length.to_u64, room)).to_i32)
    cursor = @state.value
    written = yield Pointer(UInt8).new(cursor)
    RisRegion.size_error("iyi: tape write exceeds room: ", written.to_u64) \
      if written > max
    @state.value = cursor &+ written.to_u64 if written > 0
    written
  end

  # *value*'s bytes, little-endian, as `Array#write_bytes` writes
  # them: a codec writes a word at a time.
  def write_bytes(value : I) : Nil forall I
    {% unless I == UInt16 || I == UInt32 || I == UInt64 ||
                I == Int16 || I == Int32 || I == Int64 %}
      {% raise "little-endian fields need a 16/32/64-bit integer" %}
    {% end %}
    stored = value
    bytes = pointerof(stored).as(Pointer(UInt8))
    {% unless flag?(:x86_64) || flag?(:aarch64) || flag?(:arm) ||
                flag?(:i386) || flag?(:wasm32) %}
      i = 0
      while i < sizeof(I) // 2
        j = sizeof(I) - i - 1
        byte = bytes[i]
        bytes[i] = bytes[j]
        bytes[j] = byte
        i = i + 1
      end
    {% end %}
    append(bytes, sizeof(I))
  end

  # The first *count* bytes dropped, the rest moved down to the start, as
  # `Array#shift(n)`: a connection's buffer after a request is answered.
  # What was finished from it before is written over.
  def shift(count : Int32) : Nil
    raise "shift #{count} of #{length} bytes" if count < 0 || count > length
    start = Pointer(UInt8).new((@state + 2_i64).value)
    left = length - count
    # Down, front to back: no byte is written before it is read.
    start.copy_from(start + count, left)
    @state.value = start.address &+ left.to_u64
  end

  # *value* in decimal, written in place: `value.to_s` would make a heap
  # string for every number a page prints.
  def append_int(value : Int64) : Nil
    # The magnitude as unsigned, so the most negative value has one too.
    magnitude = value < 0 ? 0_u64 &- value.unsafe_to_u64 : value.unsafe_to_u64
    digits = uninitialized StaticArray(UInt8, 20)
    base = pointerof(digits).as(Pointer(UInt8))
    count = 0
    while true
      (base + (19 - count)).value = (48_u64 &+ magnitude % 10_u64).unsafe_to_u8
      count = count + 1
      magnitude = magnitude // 10_u64
      break if magnitude == 0_u64
    end
    push(45_u8) if value < 0
    cursor = @state.value
    if cursor &+ count.to_u64 > (@state + 1_i64).value
      grow(count.to_u64)
      cursor = @state.value
    end
    target = Pointer(UInt8).new(cursor)
    # A decimal has at most 20 bytes. Fixed stores avoid LLVM turning
    # this short stack copy into a libc memcpy in release builds.
    {% for i in 0...20 %}
      target[{{i}}] = base[20 - count + {{i}}] if {{i}} < count
    {% end %}
    @state.value = cursor &+ count.to_u64
  end

  # All UInt64 values, including the half that does not fit Int64.
  def append_uint(value : UInt64, radix : Int32 = 10) : Nil
    raise "base out of range" if radix < 2 || radix > 36
    digits = uninitialized StaticArray(UInt8, 64)
    bytes = pointerof(digits).as(Pointer(UInt8))
    left = value
    count = 0
    base = radix.to_u64
    while true
      digit = (left % base).to_i32
      bytes[63 - count] = (digit < 10 ? 48 + digit : 87 + digit).to_u8
      count += 1
      left = left // base
      break if left == 0_u64
    end
    append(bytes + (64 - count), count)
  end

  def append_int(value : Int64, radix : Int32) : Nil
    raise "base out of range" if radix < 2 || radix > 36
    magnitude = value < 0 ? 0_u64 &- value.unsafe_to_u64 : value.to_u64
    push(45_u8) if value < 0
    append_uint(magnitude, radix)
  end

  def append_int(value : Int32) : Nil
    append_int(value.to_i64)
  end

  # A piece of an interpolation: text and numbers written in place, any
  # other value as its `to_s`.
  def append_value(value : String) : Nil
    append(value)
  end

  def append_value(value : Int8 | Int16 | Int32 | Int64 | UInt8 | UInt16 | UInt32) : Nil
    append_int(value.to_i64)
  end

  def append_value(value : UInt64) : Nil
    append_uint(value)
  end

  def append_value(value : Float64) : Nil
    append_float(value)
  end

  def append_value(value : Char) : Nil
    point = value.ord
    if point < 0x80
      push(point.to_u8)
    elsif point < 0x800
      push((0xC0 | (point >> 6)).to_u8)
      push((0x80 | (point & 0x3F)).to_u8)
    elsif point < 0x10000
      push((0xE0 | (point >> 12)).to_u8)
      push((0x80 | ((point >> 6) & 0x3F)).to_u8)
      push((0x80 | (point & 0x3F)).to_u8)
    else
      push((0xF0 | (point >> 18)).to_u8)
      push((0x80 | ((point >> 12) & 0x3F)).to_u8)
      push((0x80 | ((point >> 6) & 0x3F)).to_u8)
      push((0x80 | (point & 0x3F)).to_u8)
    end
  end

  def append_value(value : Nil) : Nil
  end

  # A type that writes itself into a String::Builder does so here, on the
  # tape; any other value through its String.
  def append_value(value : T) : Nil forall T
    {% if T.methods.any? { |m| m.name == "to_s" && m.args.size == 1 && m.args[0].restriction.stringify.includes?("String::Builder") } %}
      value.to_s(self)
    {% else %}
      append(value.to_s)
    {% end %}
  end

  # *text* with `&`, `<`, `>`, `"` and `'` escaped as `ERB::Util.html_escape`
  # writes them; the runs between them are copied whole.
  # *value* as `Float64#to_s` writes it, in place: no heap string per
  # number.
  def append_float(value : Float64) : Nil
    cursor = @state.value
    if cursor &+ 32_u64 > (@state + 1_i64).value
      grow(32_u64)
      cursor = @state.value
    end
    count = IyiFloatText.write(IyiFloatText.bits_of(value), Pointer(UInt8).new(cursor))
    @state.value = cursor &+ count.to_u64
  end

  # The same for text on the tape: a template's value, a request's field.
  def append_html_escaped(text : String) : Nil
    html_escaped(text.to_unsafe, text.bytesize)
  end

  def append_html_escaped(text : String) : Nil
    html_escaped(text.to_unsafe, text.bytesize)
  end

  private def html_escaped(bytes : Pointer(UInt8), size : Int32) : Nil
    start = 0
    index = 0
    while index < size
      escaped = case bytes[index]
                when 38_u8 then "&amp;"
                when 60_u8 then "&lt;"
                when 62_u8 then "&gt;"
                when 34_u8 then "&quot;"
                when 39_u8 then "&#39;"
                else            nil
                end
      if escaped
        append(bytes + start, index - start) if index > start
        append(escaped)
        start = index + 1
      end
      index = index + 1
    end
    append(bytes + start, size - start) if size > start
  end

  def length : Int32
    (@state.value &- (@state + 2_i64).value).to_i32
  end

  # The writer cut back to its first *length* bytes: what a caller wrote
  # past them, and has copied out, is written over by what comes next.
  def truncate(length : Int32) : Nil
    raise "truncate to #{length} of #{self.length} bytes" if length < 0 || length > self.length
    @state.value = (@state + 2_i64).value &+ length.to_u64
  end

  # Empty, keeping its room, to write again: `truncate(0)`, so what was
  # finished from it before is written over.
  def clear : Nil
    @state.value = (@state + 2_i64).value
  end

  # Room for *total* bytes in all, so that writing up to them does not grow
  # the writer again: once a request's length is known, its bytes grow in
  # place even after other values have gone on the tape.
  def reserve(total : Int32 | Int64) : Nil
    room = RisRegion.count(RisRegion.nonnegative(total.to_i64))
    extra = room.to_i32 - length
    grow(extra.to_u64) if extra > 0 && @state.value &+ extra.to_u64 > (@state + 1_i64).value
  end

  @[NoInline]
  private def grow(extra : UInt64) : Nil
    start = (@state + 2_i64).value
    length = @state.value &- start
    need = RisRegion.count(RisRegion.size_add(length, extra))
    capacity = (@state + 1_i64).value &- start
    capacity = 1_u64 if capacity == 0_u64
    while capacity < need
      capacity = capacity > 2147483647_u64 // 2_u64 ? \
        2147483647_u64 : RisRegion.size_mul(capacity, 2_u64)
    end
    start = RisRegion.owned_resize(start, (@state + 1_i64).value,
      length, capacity, @state + 3_i64, (@state + 4_i64).value)
    @state.value = start &+ length
    (@state + 1_i64).value = start &+ capacity
    (@state + 2_i64).value = start
  end

  # Appends *text* and says where it is: a `Span` of the finished string.
  def append_span(text : String) : String::Span
    start = length
    append(text)
    String::Span.new(start, text.bytesize)
  end

  # The text written so far, as `String::Builder#to_s` gives it: a `String`
  # viewing the builder's bytes, nothing copied.
  def to_s : String
    start = (@state + 2_i64).value
    String.new(Pointer(UInt8).new(start), (@state.value &- start).to_i32)
  end

  def finish : String
    to_s
  end

  # *value* written as `append_value` writes it, answering the writer so
  # pieces chain as into an IO: `w << name << ": " << count`.
  def <<(value) : self
    append_value(value)
    self
  end
end

# A scanner over tape text, as std/string_scanner's `StringScanner` is
# over a String: an offset that moves forward as patterns match at it.
# What it answers are views of the text, nothing copied; offsets and
# counts are bytes. No regex and no groups: a lexer on the tape reads
# bytes, strings and characters.
@[OnTape]
struct String::Scanner
  @string : String
  @offset : Int32

  def initialize(@string : String)
    @offset = 0
  end

  # A scanner over no text: a field's first value, before the text comes.
  def initialize
    @string = "".as_tape
    @offset = 0
  end

  # The text being scanned.
  def string : String
    @string
  end

  # The offset, in bytes.
  def offset : Int32
    @offset
  end

  # Moves the offset to byte *position*: the end of the text is the
  # furthest it goes.
  def offset=(position : Int32) : Int32
    raise "scanner: offset #{position} out of range for #{@string.bytesize} bytes" if position < 0 || position > @string.bytesize
    @offset = position
  end

  # Moves *count* bytes, back when negative; overflow is fatal.
  # Reads still check bounds: past the end, eos? holds; offset= checks
  # against the text. Lowered lexer loops use the same checked addition.
  def advance(count : Int32 = 1) : Int32
    @offset = RisRegion.offset_add(@offset, count)
  end

  # Compiler cursor writeback: the checked steps already produced Int32.
  def __restore_offset(value : Int32) : Int32
    @offset = value
  end

  # Whether the offset is at the end of the text.
  def eos? : Bool
    @offset >= @string.bytesize
  end

  # The text from the offset on.
  def rest : String
    @string[@offset, @string.bytesize - @offset]
  end

  # The byte at the offset, without moving, or nil at the end.
  def current_byte : UInt8?
    eos? ? nil : @string[@offset]
  end

  # Up to *count* bytes from the offset, without moving: fewer at the end.
  def peek(count : Int32) : String
    raise "scanner: negative lookahead count: #{count}" if count < 0
    left = @string.bytesize - @offset
    @string[@offset, count < left ? count : left]
  end

  # Matches *pattern* at the offset and moves past it, answering what
  # matched, or nil without moving.
  def scan(pattern : String | Char | Int32) : String?
    size = here(pattern)
    return nil unless size
    found = @string[@offset, size]
    @offset = @offset + size
    found
  end

  # `scan`, answering how many bytes the offset moved.
  def skip(pattern : String | Char | Int32) : Int32?
    size = here(pattern)
    @offset = @offset + size if size
    size
  end

  # What `scan` would answer, without moving.
  def check(pattern : String | Char | Int32) : String?
    size = here(pattern)
    size ? @string[@offset, size] : nil
  end

  # Searches for *pattern* from the offset and moves past the match,
  # answering everything from the offset to the match's end.
  def scan_until(pattern : String | Char) : String?
    stop = until_end(pattern)
    return nil unless stop
    found = @string[@offset, stop - @offset]
    @offset = stop
    found
  end

  # `scan_until`, answering how many bytes the offset moved.
  def skip_until(pattern : String | Char) : Int32?
    stop = until_end(pattern)
    return nil unless stop
    moved = stop - @offset
    @offset = stop
    moved
  end

  # What `scan_until` would answer, without moving.
  def check_until(pattern : String | Char) : String?
    stop = until_end(pattern)
    stop ? @string[@offset, stop - @offset] : nil
  end

  # How many bytes *pattern* matches at the offset, without moving, or nil.
  def matches?(pattern : String | Char) : Int32?
    here(pattern)
  end

  # Back to the start.
  def reset : Nil
    @offset = 0
  end

  # On to the end.
  def terminate : Nil
    @offset = @string.bytesize
  end

  private def here(count : Int32) : Int32?
    raise "scanner: negative count: #{count}" if count < 0
    count <= @string.bytesize - @offset ? count : nil
  end

  private def here(text : String) : Int32?
    here(String.view(text))
  end

  private def here(text : String) : Int32?
    at?(text, @offset) ? text.bytesize : nil
  end

  private def here(char : Char) : Int32?
    at = @offset
    matched = true
    char.each_byte do |byte|
      if matched && at < @string.bytesize && @string[at] == byte
        at = at + 1
      else
        matched = false
      end
    end
    matched ? at - @offset : nil
  end

  # Where the first match from the offset ends, or nil.
  private def until_end(char : Char) : Int32?
    found = @string.index(char, @offset)
    found ? found + char.bytesize : nil
  end

  private def until_end(text : String) : Int32?
    at = @offset
    while at + text.bytesize <= @string.bytesize
      return at + text.bytesize if at?(text, at)
      at = at + 1
    end
    nil
  end

  private def at?(text : String, at : Int32) : Bool
    return false if text.bytesize > @string.bytesize - at
    i = 0
    while i < text.bytesize
      return false unless @string[at + i] == text[i]
      i = i + 1
    end
    true
  end
end

# Elements on the tape. `T` is held by value, so an element may itself be a
# tape type, which no other generic may hold.
@[OnTape]
struct Array(T)
  def __iyi_copy_into(target : Pointer(self), work : RisCopyWork) : Nil
    made = self.class.new(size)
    each { |value| made << value }
    target.value = made
    made.__iyi_copy_children(work)
  end

  protected def __iyi_copy_children(work : RisCopyWork) : Nil
    {% if T < Array %}
      each { |value| value.__iyi_copy_children(work) }
    {% else %}
      {% if T == String %}
        return if (@state + 4_i64).value == 1_u64 ||
                  (@state + 4_i64).value == 3_u64
      {% end %}
      index = size
      while index > 0
        index -= 1
        work.push(unsafe_at(index), Pointer(T).new(
          @state.value &+ index.to_u64 &* sizeof(T).to_u64))
      end
    {% end %}
  end

  @state : Pointer(UInt64)

  def initialize(capacity : Int32 | Int64 = 4,
                 storage : RisPoolStorage? = nil)
    bytes = Tape.storage(capacity, sizeof(T).to_u64)
    @state = RisRegion.growing_state(bytes, sizeof(T).to_u64, 8_u64)
    (@state + 5_i64).value = 0_u64
    (@state + 6_i64).value = 0_u64
    (@state + 7_i64).value = storage ? 0_u64 : RisArrayPool(T).children

    (@state + 1_i64).value = 0_u64
    (@state + 2_i64).value = capacity.to_u64
    (@state + 4_i64).value = RisRegion.program_active? ? 1_u64 : 0_u64
  end

  # *count* elements, the block giving each by index, in room of exactly
  # that size. Linux reserves stable storage even if later appended to;
  # the block may allocate other growing values while filling it.
  def self.new(count : Int32 | Int64, & : Int32 -> T) : self
    array = new(count)
    index = 0
    while index < count
      array.push(yield index)
      index = index + 1
    end
    array
  end

  # *count* copies of *value*, as `Array.new(size, value)`.
  def self.new(count : Int32, value : T) : self
    new(count) { |index| value }
  end

  # Unchecked: `Tape.grown` keeps the room, and so the size, an Int32.
  # The mask tells LLVM it is not negative, as the check did.
  def size : Int32
    ((@state + 1_i64).value & 0x7fffffff_u64).unsafe_to_i32
  end

  def empty? : Bool
    size == 0
  end

  # `push` that answers the array, so `Array(Int32){1, 2, 3}` builds
  # one as `Set{1, 2}` does.
  def <<(value : T) : self
    push(value)
    self
  end

  def push(value : T) : self
    size = (@state + 1_i64).value
    if size >= (@state + 2_i64).value
      if (@state + 4_i64).value >= 2_u64
        grow_run(value)
      else
        grow
      end
    end
    Pointer(T).new(@state.value &+ size &* sizeof(T).to_u64).value = stored(value)
    (@state + 1_i64).value = size &+ 1_u64
    self
  end

  # Diagnostic counts include freed slots retained for the next store.
  def __pool_usage : Tuple(Int32, Int32)
    return {0, 0} if (@state + 7_i64).value == 0_u64
    {% if T < Array %}
      pool = Pointer(RisArrayPool({{T.type_vars[0]}})).new(
        (@state + 7_i64).value)
      {pool.value.data.size, pool.value.handles.size}
    {% elsif T == String %}
      pool = Pointer(SlicePool(UInt8)).new((@state + 7_i64).value)
      {pool.value.size, 0}
    {% else %}
      {0, 0}
    {% end %}
  end

  # Nested elements are fixed handles to runs owned by this container.
  protected def stored(value : T) : T
    return value if (@state + 7_i64).value == 0_u64
    {% if T < Array %}
      pool = Pointer(RisArrayPool({{T.type_vars[0]}})).new(
        (@state + 7_i64).value)
      value.__pool_copy(pool)
    {% elsif T == String %}
      if (@state + 4_i64).value == 1_u64 ||
         (@state + 4_i64).value == 3_u64
        pool = Pointer(SlicePool(UInt8)).new((@state + 7_i64).value)
        pool.value.store(value).string
      else
        value
      end
    {% else %}
      value
    {% end %}
  end

  private def release(value : T) : Nil
    return if (@state + 7_i64).value == 0_u64
    {% if T < Array %}
      value.__release_run
    {% elsif T == String %}
      if (@state + 4_i64).value == 1_u64 ||
         (@state + 4_i64).value == 3_u64
        pool = Pointer(SlicePool(UInt8)).new((@state + 7_i64).value)
        at = (value.to_unsafe.address - pool.value.@data.@state.value).to_i32
        pool.value.free_slice(SlicePool::Run(UInt8).new(
          pool.value.@data, at, value.bytesize))
      end
    {% end %}
  end

  def __pool_copy(pool : Pointer(RisArrayPool(T))) : self
    run = if empty?
      SlicePool::Run(T).new(pool.value.data.@data, 0, 0)
    else
      pool.value.data.alloc_slice(size, self[0])
    end
    header = pool.value.handles.alloc_slice(1,
      StaticArray(UInt64, 8).new)
    state = Pointer(UInt64).new(header.@state.value +
      header.offset.to_u64 * sizeof(StaticArray(UInt64, 8)).to_u64)
    state.value = run.@state.value + run.offset.to_u64 * sizeof(T).to_u64
    (state + 1_i64).value = size.to_u64
    (state + 2_i64).value = size.to_u64
    (state + 3_i64).value = header.offset.to_u64
    (state + 4_i64).value = pool.value.program? ? 3_u64 : 2_u64
    (state + 5_i64).value = pool.address
    (state + 6_i64).value = run.offset.to_u64
    (state + 7_i64).value = pool.value.child_pool
    made = self
    pointerof(made.@state).value = state
    each_with_index { |value, i| run[i] = made.stored(value) }
    made
  end

  def __release_run : Nil
    return unless (@state + 4_i64).value >= 2_u64
    each { |value| release(value) }
    pool = Pointer(RisArrayPool(T)).new((@state + 5_i64).value)
    pool.value.data.free_slice(SlicePool::Run(T).new(pool.value.data.@data,
      (@state + 6_i64).value.to_i32, (@state + 2_i64).value.to_i32))
    pool.value.handles.free_slice(SlicePool::Run(StaticArray(UInt64, 8)).new(
      pool.value.handles.@data, (@state + 3_i64).value.to_i32, 1))
  end

  private def grow_run(fill : T) : Nil
    pool = Pointer(RisArrayPool(T)).new((@state + 5_i64).value)
    old = SlicePool::Run(T).new(pool.value.data.@data,
      (@state + 6_i64).value.to_i32, (@state + 2_i64).value.to_i32)
    capacity = Tape.grown((@state + 2_i64).value).to_i32
    run = pool.value.data.realloc_slice(old, capacity, fill)
    @state.value = run.@state.value + run.offset.to_u64 * sizeof(T).to_u64
    (@state + 2_i64).value = capacity.to_u64
    (@state + 6_i64).value = run.offset.to_u64
  end

  @[NoInline]
  private def grow : Nil
    start = @state.value
    room = (@state + 2_i64).value
    capacity = Tape.grown(room)
    width = sizeof(T).to_u64
    stop = start &+ RisRegion.size_mul(room, width)
    used = RisRegion.size_mul((@state + 1_i64).value, width)
    bytes = RisRegion.size_mul(capacity, width)
    @state.value = RisRegion.owned_resize(start, stop, used, bytes,
      @state + 3_i64, (@state + 4_i64).value, width)
    (@state + 2_i64).value = capacity
  end

  # One byte-range check, then memcpy into an aligned local.
  def read_bytes_at(type : I.class, at : Int32) : I forall I
    {% unless I == UInt16 || I == UInt32 || I == UInt64 ||
                I == Int16 || I == Int32 || I == Int64 %}
      {% raise "little-endian fields need a 16/32/64-bit integer" %}
    {% end %}
    {% unless T == UInt8 %}
      {% raise "little-endian fields require Array(UInt8)" %}
    {% end %}
    width = sizeof(I)
    if at < 0 || at > size - width
      raise "little-endian field out of range"
    end
    value = uninitialized I
    target = pointerof(value).as(Pointer(UInt8))
    target.copy_from(Pointer(UInt8).new(@state.value) + at, width)
    {% unless flag?(:x86_64) || flag?(:aarch64) || flag?(:arm) ||
                flag?(:i386) || flag?(:wasm32) %}
      i = 0
      while i < sizeof(I) // 2
        j = sizeof(I) - i - 1
        byte = target[i]
        target[i] = target[j]
        target[j] = byte
        i = i + 1
      end
    {% end %}
    value
  end

  # Overwrites a field without growing the byte pool.
  def write_bytes_at(at : Int32, value : I) : I forall I
    {% unless I == UInt16 || I == UInt32 || I == UInt64 ||
                I == Int16 || I == Int32 || I == Int64 %}
      {% raise "little-endian fields need a 16/32/64-bit integer" %}
    {% end %}
    {% unless T == UInt8 %}
      {% raise "little-endian fields require Array(UInt8)" %}
    {% end %}
    width = sizeof(I)
    if at < 0 || at > size - width
      raise "little-endian field out of range"
    end
    stored = value
    bytes = pointerof(stored).as(Pointer(UInt8))
    {% unless flag?(:x86_64) || flag?(:aarch64) || flag?(:arm) ||
                flag?(:i386) || flag?(:wasm32) %}
      i = 0
      while i < sizeof(I) // 2
        j = sizeof(I) - i - 1
        byte = bytes[i]
        bytes[i] = bytes[j]
        bytes[j] = byte
        i = i + 1
      end
    {% end %}
    (Pointer(UInt8).new(@state.value) + at).copy_from(bytes, width)
    value
  end

  # Appends a field, growing with the array's usual tape policy.
  def write_bytes(value : I) : Nil forall I
    {% unless I == UInt16 || I == UInt32 || I == UInt64 ||
                I == Int16 || I == Int32 || I == Int64 %}
      {% raise "little-endian fields need a 16/32/64-bit integer" %}
    {% end %}
    {% unless T == UInt8 %}
      {% raise "little-endian fields require Array(UInt8)" %}
    {% end %}
    count = (@state + 1_i64).value
    width = sizeof(I).to_u64
    need = RisRegion.count(RisRegion.size_add(count, width))
    while need > (@state + 2_i64).value
      if (@state + 4_i64).value >= 2_u64
        grow_run(0_u8)
      else
        grow
      end
    end
    stored = value
    bytes = pointerof(stored).as(Pointer(UInt8))
    {% unless flag?(:x86_64) || flag?(:aarch64) || flag?(:arm) ||
                flag?(:i386) || flag?(:wasm32) %}
      i = 0
      while i < sizeof(I) // 2
        j = sizeof(I) - i - 1
        byte = bytes[i]
        bytes[i] = bytes[j]
        bytes[j] = byte
        i = i + 1
      end
    {% end %}
    Pointer(UInt8).new(@state.value + count).copy_from(bytes, width.to_i32)
    (@state + 1_i64).value = need
  end

  # The bytes of *text* at the end, with one room check and one copy
  # rather than a `push` or `write_bytes` per byte or word.
  def append(text : String) : Nil
    {% unless T == UInt8 %}
      {% raise "append requires Array(UInt8)" %}
    {% end %}
    count = (@state + 1_i64).value
    width = text.bytesize.to_u64
    need = RisRegion.count(RisRegion.size_add(count, width))
    while need > (@state + 2_i64).value
      if (@state + 4_i64).value >= 2_u64
        grow_run(0_u8)
      else
        grow
      end
    end
    Pointer(UInt8).new(@state.value + count).copy_from(text.to_unsafe, width.to_i32)
    (@state + 1_i64).value = need
  end

  # As `Array#[]`: a negative index counts from the end, and one still out
  # of range raises rather than reading past the elements.
  def [](index : Int32) : T
    count = size
    unless index.unsafe_to_u64 < count.unsafe_to_u64
      asked = index
      index = index + count
      unless asked < 0 && index.unsafe_to_u64 < count.unsafe_to_u64
        Tape.out_of_range(asked, count, "elements")
      end
    end
    Pointer(T).new(@state.value &+ index.to_u64 &* sizeof(T).to_u64).value
  end

  # As `Array#[]=`, with the same range check: an element written in
  # place, which does not grow the array.
  def []=(index : Int32, value : T) : T
    count = size
    unless index.unsafe_to_u64 < count.unsafe_to_u64
      asked = index
      index = index + count
      unless asked < 0 && index.unsafe_to_u64 < count.unsafe_to_u64
        Tape.out_of_range(asked, count, "elements")
      end
    end
    replacement = stored(value)
    release(unsafe_at(index))
    Pointer(T).new(@state.value &+ index.to_u64 &* sizeof(T).to_u64).value = replacement
    value
  end

  # `[]` in `while i < a.size`, where the loop keeps *index* below the
  # size (TapeCheckFreeLowering): only a negative one is refused.
  @[AlwaysInline]
  def __loop_fetch(index : Int32) : T
    Tape.out_of_range(index, size, "elements") if index < 0
    unsafe_at(index)
  end

  @[AlwaysInline]
  def __loop_store(index : Int32, value : T) : T
    Tape.out_of_range(index, size, "elements") if index < 0
    replacement = stored(value)
    release(unsafe_at(index))
    Pointer(T).new(@state.value &+ index.to_u64 &* sizeof(T).to_u64).value = replacement
    value
  end

  # The element at *link*, checked as `[]` checks an index: a link read
  # from bytes is never trusted.
  def [](link : Array::Link(T, I)) : T forall I
    self[link.index]
  end

  def []=(link : Array::Link(T, I), value : T) : T forall I
    self[link.index] = value
  end

  # A link to the element at *index*, stored in an `I`: `UInt8`, `UInt16`
  # or `UInt32` (the default) bytes rather than a pointer's eight.
  def link(index : Int32, width : I.class = UInt32) : Array::Link(T, I) forall I
    Tape.out_of_range(index, size, "elements") if index < 0 || index >= size
    Array::Link(T, I).new(index)
  end

  # The index the next `push` takes, as a link: a node can name a child
  # before the child is pushed.
  def next_link(width : I.class = UInt32) : Array::Link(T, I) forall I
    Array::Link(T, I).new(size)
  end

  # Each element in order. The loop's own bound keeps the index in range,
  # so no element is checked again (Goose elides these too).
  def each(& : T -> Nil) : Nil
    index = 0
    count = size
    while index < count
      yield unsafe_at(index)
      index = index + 1
    end
  end

  def each_with_index(& : T, Int32 -> Nil) : Nil
    index = 0
    count = size
    while index < count
      yield unsafe_at(index), index
      index = index + 1
    end
  end

  # A new array of what the block gives for each element, sized first so
  # the block may put other values on the tape.
  def map(& : T -> U) : Array(U) forall U
    Array(U).new(size) { |index| yield unsafe_at(index) }
  end

  def sum : T
    total = T.zero
    each { |value| total = total + value }
    total
  end

  # Removal returns a caller-owned value before releasing its pool run.
  def pop : T
    raise "pop of an empty array" if empty?
    __remove_slot(size - 1)
  end

  def __remove_slot(index : Int32) : T
    value = self[index]
    result = value
    {% if T < Array || T == String %}
      if (@state + 7_i64).value != 0_u64
        result = Tape.owner_copy(value, RisCurrentTape.new)
      end
    {% end %}
    release(value)
    i = index
    while i + 1 < size
      Pointer(T).new(@state.value + i.to_u64 * sizeof(T).to_u64).value =
        unsafe_at(i + 1)
      i += 1
    end
    (@state + 1_i64).value -= 1_u64
    result
  end

  def pop? : T?
    empty? ? nil : pop
  end

  # Empty, keeping its room: the array to fill again in a loop. A new
  # array each round instead stays on the tape until the block ends,
  # every one of them (a tokenizer's queue, one per token: 110 MB for a
  # 4.5 MB page).
  def clear : Nil
    each { |value| release(value) }
    (@state + 1_i64).value = 0_u64
  end

  # `first` on an empty array is a mistake, as with `Array#first`; the
  # nilable questions answer nil.
  def first : T
    raise "first of an empty array" if empty?
    unsafe_at(0)
  end

  def first? : T?
    empty? ? nil : unsafe_at(0)
  end

  def last? : T?
    empty? ? nil : unsafe_at(size - 1)
  end

  def includes?(value : T) : Bool
    each { |element| return true if element == value }
    false
  end

  # Where a value first is, or nil.
  def index(value : T) : Int32?
    each_with_index { |element, index| return index if element == value }
    nil
  end

  def count(& : T -> Bool) : Int32
    total = 0
    each { |value| total = total + 1 if yield value }
    total
  end

  def any?(& : T -> Bool) : Bool
    each { |value| return true if yield value }
    false
  end

  def all?(& : T -> Bool) : Bool
    each { |value| return false unless yield value }
    true
  end

  def find(& : T -> Bool) : T?
    each { |value| return value if yield value }
    nil
  end

  def reduce(initial : U, & : U, T -> U) : U forall U
    accumulator = initial
    each { |value| accumulator = yield accumulator, value }
    accumulator
  end

  # The element whose key is largest, or smallest, the first of equals; a
  # NaN key is above every other, as `Array#max_by` places it.
  def max_by(& : T -> U) : T forall U
    raise "max_by of an empty array" if empty?
    best = unsafe_at(0)
    best_key = yield best
    index = 1
    count = size
    while index < count
      value = unsafe_at(index)
      key = yield value
      if best_key < key || (key.is_a?(Float) && key != key && best_key == best_key)
        best = value
        best_key = key
      end
      index = index + 1
    end
    best
  end

  def min_by(& : T -> U) : T forall U
    raise "min_by of an empty array" if empty?
    best = unsafe_at(0)
    best_key = yield best
    index = 1
    count = size
    while index < count
      value = unsafe_at(index)
      key = yield value
      if key < best_key || (key.is_a?(Float) && best_key != best_key && key == key)
        best = value
        best_key = key
      end
      index = index + 1
    end
    best
  end

  # The arrays below are new ones on the same tape, freed with it, as
  # `Array`'s are new ones on the heap; an element may be a tape value.
  def select(& : T -> Bool) : self
    result = Array(T).new(size)
    each { |value| result.push(value) if yield value }
    result
  end

  def reject(& : T -> Bool) : self
    result = Array(T).new(size)
    each { |value| result.push(value) unless yield value }
    result
  end

  def reversed : self
    count = size
    Array(T).new(count) { |index| unsafe_at(count - 1 - index) }
  end

  def dup : self
    Array(T).new(size) { |index| unsafe_at(index) }
  end

  # The two in order, as a new array; neither operand changes.
  def +(other : Array(T)) : self
    joined = Array(T).new(size + other.size)
    each { |value| joined.push(value) }
    other.each { |value| joined.push(value) }
    joined
  end

  # *other*'s elements after the last. Its length is read once, so
  # `a.concat(a)` doubles `a` rather than growing without end.
  def concat(other : Array(T)) : self
    taking = other.size
    index = 0
    while index < taking
      push(other.unchecked(index))
      index = index + 1
    end
    self
  end

  # Sorted as `Array#sort_in_place` sorts, stable: the block answers above
  # zero when its first element goes after the second.
  def sort_in_place(& : T, T -> Int32) : self
    reorder(order { |a, b| yield unsafe_at(a), unsafe_at(b) })
  end

  def sort_in_place : self
    sort_in_place { |a, b| b < a ? 1 : 0 }
  end

  # Ascending by the key each element answers, computed once each.
  def sort_in_place_by(& : T -> U) : self forall U
    keys = map { |value| yield value }
    reorder(order { |a, b| keys.unchecked(b) < keys.unchecked(a) ? 1 : 0 })
  end

  def sorted(& : T, T -> Int32) : self
    dup.sort_in_place { |a, b| yield a, b }
  end

  def sorted : self
    dup.sort_in_place
  end

  def sorted_by(& : T -> U) : self forall U
    dup.sort_in_place_by { |value| yield value }
  end

  # The elements written into *writer*, *separator* between them: where
  # `Array#join` builds a heap String, this one adds to the caller's text.
  def join(writer : String::Builder, separator : String = "") : Nil
    each_with_index do |value, index|
      writer.append(separator) if index > 0
      writer.append_value(value)
    end
  end

  # The elements joined on the current tape, as Array#join answers them.
  def join(separator : String = "") : String
    String.build(16 * (size + 1)) { |writer| join(writer, separator) }
  end

  # The indexes in sorted order, by *compare* on two of them: runs of 16
  # by insertion, then merged in pairs, as `Array#sort_in_place` does.
  # Indexes rather than elements are moved, so the scratch room is two
  # arrays of Int32 on the tape whatever `T` is.
  private def order(& : Int32, Int32 -> Int32) : Array(Int32)
    count = size
    from = Array(Int32).new(count) { |index| index }
    start = 0
    while start < count
      finish = start + 16 < count ? start + 16 : count
      index = start + 1
      while index < finish
        value = from[index]
        slot = index - 1
        while slot >= start && (yield from[slot], value) > 0
          from[slot + 1] = from[slot]
          slot = slot - 1
        end
        from[slot + 1] = value
        index = index + 1
      end
      start = finish
    end
    into = Array(Int32).new(count, 0)
    width = 16
    while width < count
      low = 0
      while low < count
        middle = low + width < count ? low + width : count
        high = middle + width < count ? middle + width : count
        left = low
        right = middle
        cursor = low
        while cursor < high
          # The left run's element on a tie: that is what keeps it stable.
          if right >= high || (left < middle && (yield from[left], from[right]) <= 0)
            into[cursor] = from[left]
            left = left + 1
          else
            into[cursor] = from[right]
            right = right + 1
          end
          cursor = cursor + 1
        end
        low = high
      end
      spare = from
      from = into
      into = spare
      width = width * 2
    end
    from
  end

  # The elements put in the order *order* names, from a copy of them.
  private def reorder(order : Array(Int32)) : self
    copy = self
    {% if T == String || T < Array %}
      copy = Tape.owner_copy(self, RisCurrentTape.new)
    {% else %}
      copy = dup
    {% end %}
    order.each_with_index { |from, to| unchecked_store(to, copy.unchecked(from)) }
    self
  end

  # The indexes in *indexes*, each checked against this array once, for
  # reads with no check after (`Array::View`).
  def values_at(indexes : Array(Int32)) : Array::View(T)
    Array::View(T).new(self, indexes)
  end

  def __iyi_pending_copy(owner : RisPendingCopy) : self
    copy_to(owner)
  end

  def copy_to(owner) : self
    Tape.owner_copy(self, owner)
  end

  def copy_to(owner : RisPendingCopy) : self
    if owner.is_a?(RisPendingCopy)
      return self unless owner.contains?(@state.address)
      cached = owner.lookup(@state.address)
      if cached != 0
        made = self
        pointerof(made.@state).value = Pointer(UInt64).new(cached)
        return made
      end
    end
    owner.run do
      made = self.class.new(size)
      owner.remember(@state.address, made.@state.address) if owner.is_a?(RisPendingCopy)
      each { |value| made << Tape.copy_value(value, owner) }
      made
    end
  end

  # For `IndexView`, whose indexes are known in range.
  protected def unchecked(index : Int32) : T
    unsafe_at(index)
  end

  protected def unchecked_store(index : Int32, value : T) : T
    replacement = stored(value)
    release(unsafe_at(index))
    Pointer(T).new(@state.value &+ index.to_u64 &* sizeof(T).to_u64).value = replacement
    value
  end

  @[AlwaysInline]
  private def unsafe_at(index : Int32) : T
    Pointer(T).new(@state.value &+ index.to_u64 &* sizeof(T).to_u64).value
  end

  # The elements' bytes, nothing copied: write them to a file or socket
  # and `load` them back. `T` must be flat (see `Tape::Flat`), with no
  # pointer in it, which `Link` and `Span` are not.
  def bytes : String
    {% begin %}
      {% for t in [T] + T.instance_vars.map(&.type) %}
        {% unless t < ::Number || t.name.starts_with?("Array::Link(") || t == ::String::Span || t.annotation(::Tape::Flat) %}
          {% raise "#{T} is not flat: #{t} in it is not a number, an Array::Link, a String::Span or an @[Tape::Flat] struct" %}
        {% end %}
      {% end %}
    {% end %}
    String.new(Pointer(UInt8).new(@state.value), RisRegion.count(
      RisRegion.size_mul(size.to_u64, sizeof(T).to_u64)).to_i32)
  end

  # The elements *bytes* holds, copied onto the tape: the length must be
  # whole elements, and each link is checked when it is followed.
  def self.load(bytes : String) : self
    {% begin %}
      {% for t in [T] + T.instance_vars.map(&.type) %}
        {% unless t < ::Number || t.name.starts_with?("Array::Link(") || t == ::String::Span || t.annotation(::Tape::Flat) %}
          {% raise "#{T} is not flat: #{t} in it is not a number, an Array::Link, a String::Span or an @[Tape::Flat] struct" %}
        {% end %}
      {% end %}
    {% end %}
    width = sizeof(T)
    raise "#{bytes.bytesize} bytes are not whole #{width}-byte elements" if bytes.bytesize % width != 0
    count = bytes.bytesize // width
    array = new(count)
    Pointer(UInt8).new(array.@state.value).copy_from(bytes.to_unsafe, bytes.bytesize)
    (array.@state + 1_i64).value = count.to_u64
    array
  end
end

# `target`'s elements in the order *indexes* names them, every index
# checked once here: Goose's index types, `u32 in nodes`. Reading through
# one checks nothing more, as `target` never shrinks and the indexes are
# a copy no one else can change. CSR's `dist[adj[k]]` is
# `dist.values_at(adj)[k]`, checked when the edges come in.
@[OnTape]
struct Array::View(T)
  @target : Array(T)
  @at : Array(Int32)?
  @offset : Int32
  @count : Int32

  def initialize(@target : Array(T), indexes : Array(Int32))
    count = target.size
    @at = Array(Int32).new(indexes.size) do |k|
      index = indexes[k]
      Tape.out_of_range(index, count, "elements") if index < 0 || index >= count
      index
    end
    @offset = 0
    @count = indexes.size
  end

  def initialize(@target : Array(T), @offset : Int32, @count : Int32)
    raise "array view out of bounds" if @offset < 0 || @count < 0 ||
      @offset > target.size - @count
    @at = nil
  end

  def size : Int32
    @count
  end

  def index(k : Int32) : Int32
    Tape.out_of_range(k, size, "elements") if k < 0 || k >= size
    if at = @at
      at[k]
    else
      @offset + k
    end
  end

  def [](k : Int32) : T
    @target.unchecked(index(k))
  end

  def []=(k : Int32, value : T) : T
    @target.unchecked_store(index(k), value)
  end

  def __loop_fetch(k : Int32) : T
    self[k]
  end

  def __loop_store(k : Int32, value : T) : T
    self[k] = value
  end

  def each(& : T -> _) : Nil
    i = 0
    while i < size
      yield self[i]
      i += 1
    end
  end

  def to_a : Array(T)
    Array(T).new(size) { |i| self[i] }
  end
end

# A typed link to an element of an `Array(T)`: its index in `I`
# bytes. It holds no pointer, so it stays valid while the array grows and
# moves, may be kept in any value, and is the same in bytes written out
# and loaded back. The array checks it when followed.
struct Array::Link(T, I)
  @index : I

  def initialize(index : Int32)
    raise "link #{index} does not fit #{sizeof(I)} bytes" if index < 0 || index.to_u64 >= Array::Link.top(I)
    @index = Array::Link.narrow(index.to_u64, I)
  end

  # The link to nothing: `none?` is true.
  def self.none : self
    new(Array::Link.narrow(Array::Link.top(I), I), none: true)
  end

  protected def initialize(@index : I, *, none : Bool)
  end

  def none? : Bool
    wide == Array::Link.top(I)
  end

  def index : Int32
    raise "Array::Link: none" if none?
    wide.to_i32
  end

  # The low `I` bytes of *value*, and back: the prelude converts to and
  # from few widths, and a link is unsigned and little-endian either way.
  protected def self.narrow(value : UInt64, width : W.class) : W forall W
    pointerof(value).as(Pointer(W)).value
  end

  protected def self.top(width : W.class) : UInt64 forall W
    case sizeof(W)
    when 1 then 0xff_u64
    when 2 then 0xffff_u64
    when 4 then 0xffffffff_u64
    else        raise "a link is 1, 2 or 4 bytes, not #{sizeof(W)}"
    end
  end

  private def wide : UInt64
    value = 0_u64
    pointerof(value).as(Pointer(I)).value = @index
    value
  end
end

# Text inside a `String`, as its start and length: a record holds
# its text this way, flat, beside the one string all its text is in.
struct String::Span
  getter start : Int32
  getter size : Int32

  def initialize(@start : Int32, @size : Int32)
  end
end

# A tree on the tape as one stream in document order, the layout simdjson
# calls a tape: a container is written when it opens and told where its
# subtree ends when it closes, so its children follow it and a reader
# steps over a child in one jump. The tree is one growing value, written
# once, whole: measured faster than a heap tree, where a `Array` per node
# is slower (measured in ris-bench).
@[OnTape]
struct RisTree(T)
  protected def __iyi_copy_slot(index : Int32) : Pointer(T)
    pointerof(slot(index).value.@value).as(Pointer(T))
  end

  def __iyi_copy_into(target : Pointer(self), work : RisCopyWork) : Nil
    made = self.class.new(size)
    index = 0
    while index < size
      entry = slot(index).value
      made.put(entry.value, entry.stop)
      index += 1
    end
    target.value = made
    while index > 0
      index -= 1
      work.push(slot(index).value.value, made.__iyi_copy_slot(index))
    end
  end

  @state : Pointer(UInt64)

  def initialize(capacity : Int32 | Int64 = 64)
    width = sizeof(Entry(T)).to_u64
    bytes = Tape.storage(capacity, width)
    @state = RisRegion.growing_state(bytes, width)
    (@state + 1_i64).value = 0_u64
    (@state + 2_i64).value = capacity.to_u64
    (@state + 4_i64).value = RisRegion.program_active? ? 1_u64 : 0_u64
  end

  # Unchecked: `Tape.grown` keeps the room, and so the size, an Int32.
  # The mask tells LLVM it is not negative, as the check did.
  def size : Int32
    ((@state + 1_i64).value & 0x7fffffff_u64).unsafe_to_i32
  end

  def __iyi_pending_copy(owner : RisPendingCopy) : self
    copy_to(owner)
  end

  def copy_to(owner) : self
    Tape.owner_copy(self, owner)
  end

  def copy_to(owner : RisPendingCopy) : self
    if owner.is_a?(RisPendingCopy)
      return self unless owner.contains?(@state.address)
      cached = owner.lookup(@state.address)
      if cached != 0
        made = self
        pointerof(made.@state).value = Pointer(UInt64).new(cached)
        return made
      end
    end
    owner.run do
      made = self.class.new(size)
      owner.remember(@state.address, made.@state.address) if owner.is_a?(RisPendingCopy)
      index = 0
      while index < size
        entry = slot(index).value
        made.put(Tape.copy_value(entry.value, owner), entry.stop)
        index += 1
      end
      made
    end
  end

  # A value with no children; its index.
  def leaf(value : T) : Int32
    put(value, size + 1)
  end

  # A container whose children are the values added until `close`; its
  # index, which `close` takes.
  def open(value : T) : Int32
    put(value, -1)
  end

  # Ends the container opened at *at*: its subtree is everything added
  # since.
  def close(at : Int32) : Nil
    entry = slot(at)
    raise "RisTree#close: #{at} is not open" unless entry.value.stop == -1
    entry.value = Entry(T).new(entry.value.value, size)
  end

  def [](index : Int32) : T
    slot(index).value.value
  end

  # The index past *index*'s subtree: the next sibling, if any.
  def stop(index : Int32) : Int32
    stop = slot(index).value.stop
    raise "RisTree: #{index} is not closed" if stop == -1
    stop
  end

  # Each child of the container at *index*, by index.
  def each_child(index : Int32, & : Int32 -> _) : Nil
    child = index + 1
    last = stop(index)
    while child < last
      yield child
      child = stop(child)
    end
  end

  protected def put(value : T, stop : Int32) : Int32
    count = (@state + 1_i64).value
    grow if count >= (@state + 2_i64).value
    width = sizeof(Entry(T)).to_u64
    Pointer(Entry(T)).new(@state.value &+ count &* width).value = Entry(T).new(value, stop)
    (@state + 1_i64).value = count &+ 1_u64
    count.to_i32
  end

  private def slot(index : Int32) : Pointer(Entry(T))
    count = size
    Tape.out_of_range(index, count, "entries") if index < 0 || index >= count
    Pointer(Entry(T)).new(@state.value &+ index.to_u64 &* sizeof(Entry(T)).to_u64)
  end

  @[NoInline]
  private def grow : Nil
    start = @state.value
    room = (@state + 2_i64).value
    capacity = Tape.grown(room)
    width = sizeof(Entry(T)).to_u64
    stop = start &+ RisRegion.size_mul(room, width)
    used = RisRegion.size_mul((@state + 1_i64).value, width)
    bytes = RisRegion.size_mul(capacity, width)
    @state.value = RisRegion.owned_resize(start, stop, used, bytes,
      @state + 3_i64, (@state + 4_i64).value, width)
    (@state + 2_i64).value = capacity
  end
end

# One entry of a `Tree`: the value and the index past its subtree.
@[OnTape]
private struct RisTree::Entry(T)
  getter value : T
  getter stop : Int32

  def initialize(@value : T, @stop : Int32)
  end
end

# Descriptor streams consume tape bytes before their scope can end.
class IyiIO
  # As `read_line`, onto the caller's active tape and with no heap String:
  # a line in the buffer is one copy; one across refills grows a writer.
  def read_line_tape(chomp : Bool = false) : String?
    raise "cannot read from closed IO" if @closed
    if @read_pos >= @read_limit
      return nil if @eof
      return nil if fill_buffer <= 0
    end
    found = @read_pos
    while found < @read_limit && @read_buffer[found] != 10_u8
      found = found + 1
    end
    if found < @read_limit
      start_ptr = @read_buffer + @read_pos
      len = found - @read_pos + 1
      @read_pos = found + 1
      len = len - (len > 1 && start_ptr[len - 2] == 13_u8 ? 2 : 1) if chomp
      # Copied: the buffer is refilled under a view of it.
      bytes = Pointer(UInt8).new(RisRegion.tape_bytes(len.to_u64))
      bytes.copy_from(start_ptr, len)
      return String.new(bytes, len)
    end
    writer = String::Builder.new(256)
    while true
      start = @read_pos
      j = start
      while j < @read_limit && @read_buffer[j] != 10_u8
        j = j + 1
      end
      newline = j < @read_limit
      take = j - start + (newline ? 1 : 0)
      if writer.length.to_i64 + take > 2147483647_i64
        raise "a line is past the 2147483647 bytes a string holds"
      end
      writer.append(@read_buffer + start, take)
      @read_pos = start + take
      break if newline || @eof
      break if fill_buffer <= 0
    end
    text = writer.finish
    len = text.bytesize
    return nil if len == 0 && @eof
    # A `\r` ends a line only before a `\n`; a final lone one is kept.
    if chomp && len > 0 && text[len - 1] == 10_u8
      len = len - (len > 1 && text[len - 2] == 13_u8 ? 2 : 1)
    end
    text[0, len]
  end

  def print(text : String) : Nil
    text.to_s(self)
  end

  # As `puts(String)`: text that already ends its line gets no second one.
  def puts(text : String) : Nil
    text.to_s(self)
    write("\n") unless text.bytesize > 0 && text[-1] == 10_u8
  end

  # Numeric text and its newline share one tape builder and one write.
  def puts(value : Int) : Nil
    print(String.build(66) { |writer| writer << value << '\n' })
  end

  # What a writer holds so far, written straight from the tape.
  def print(writer : String::Builder) : Nil
    print(writer.finish)
  end

  def puts(writer : String::Builder) : Nil
    puts(writer.finish)
  end
end

def print(text : String) : Nil
  stdout.print(text)
end

def print(writer : String::Builder) : Nil
  stdout.print(writer)
end

# Any other value read in `while i < a.size`: `[]` and `[]=` as written,
# since it may shrink in the loop (TapeCheckFreeLowering).
# Ordinary values copy by value. Tape structs enqueue their field copies,
# without calling initialize (which may have unrelated side effects).
struct Struct
  def __iyi_copy_into(target : Pointer(self), work : RisCopyWork) : Nil
    target.value = self
    {% for field in @type.instance_vars %}
      slot = target.as(Pointer(UInt8)) +
        offsetof(self, @{{field.name.id}})
      work.push(@{{field.name.id}},
        slot.as(Pointer(typeof(@{{field.name.id}}))))
    {% end %}
  end

  def __iyi_pending_copy(owner : RisPendingCopy) : self
    made = self
    {% for field in @type.instance_vars %}
      pointerof(made.@{{field.name.id}}).value =
        Tape.copy_value(@{{field.name.id}}, owner)
    {% end %}
    made
  end

  def copy_to(owner)
    Tape.owner_copy(self, owner)
  end
end

struct Tuple
  def __iyi_copy_into(target : Pointer(self), work : RisCopyWork) : Nil
    target.value = self
    {% for type, i in T %}
      slot = target.as(Pointer(UInt8)) + offsetof(self, {{i}})
      work.push(self[{{i}}], slot.as(Pointer({{type}})))
    {% end %}
  end

  def __iyi_pending_copy(owner : RisPendingCopy)
    {% begin %}
      { {% for type, i in T %}
          Tape.copy_value(self[{{i}}], owner),
        {% end %} }
    {% end %}
  end

  def copy_to(owner)
    Tape.owner_copy(self, owner)
  end
end

struct Pointer(T)
  def copy_to(owner)
    {% raise "copy_to refuses raw pointers;\nbuild on the destination with Array nodes and indices" %}
  end
end

struct NamedTuple
  def __iyi_copy_into(target : Pointer(self), work : RisCopyWork) : Nil
    target.value = self
    {% for key, type, i in T %}
      # Named tuples have the corresponding positional tuple's layout.
      offset = offsetof(Tuple({% for k in T.keys %}{{T[k]}}, {% end %}), {{i}})
      slot = target.as(Pointer(UInt8)) + offset
      work.push(self[{{key.symbolize}}], slot.as(Pointer({{type}})))
    {% end %}
  end

  def __iyi_pending_copy(owner : RisPendingCopy)
    {% begin %}
      { {% for key, type in T %}
          {{key.id}}: Tape.copy_value(self[{{key.symbolize}}], owner),
        {% end %} }
    {% end %}
  end

  def copy_to(owner)
    Tape.owner_copy(self, owner)
  end
end

class Object
  # Historical spelling: a deep copy on this tape, never a heap escape.
  def to_heap
    Tape.owner_copy(self, RisCurrentTape.new)
  end

  def __iyi_copy_into(target : Pointer(self), work : RisCopyWork) : Nil
    {% if @type < ::Enum || @type < ::Number || @type == ::Bool || @type == ::Char || @type == ::Symbol || @type == ::Nil %}
      target.value = self
    {% elsif @type.abstract? %}
      raise "cannot copy an abstract instance"
    {% else %}
      made = {{@type}}.allocate
      target.value = made
      {% for field in @type.instance_vars %}
        work.push(@{{field.name.id}}, pointerof(made.@{{field.name.id}}))
      {% end %}
    {% end %}
  end

  def __iyi_pending_copy(owner : RisPendingCopy)
    self
  end

  def copy_to(owner)
    Tape.owner_copy(self, owner)
  end

  def __loop_fetch(index)
    self[index]
  end

  def __loop_store(index, value)
    self[index] = value
  end

  def __loop_read_bytes_at(type, at, room)
    read_bytes_at(type, at)
  end
end


# The intrinsic a writer appends with: the platform's `memcpy`, at its
# speed, where a loop is vectorised only to SSE2. What is appended never
# overlaps where it goes, past the writer's cursor.
lib LibTapeCopy
  fun memcpy = "llvm.memcpy.p0.p0.i64"(destination : Pointer(UInt8), source : Pointer(UInt8), count : UInt64, volatile : Bool) : Nil
end

# Outside the prelude, scopes begin with `__iyi_scope_mark(false)`.
# Loop and block scopes discard scratch; defs receive retained values
# through `__iyi_scope_result` before reset. TapeScopeChecker enables a
# mark only when no unhandled escape can outlive it. Reset includes side
# regions and grown mappings. A disabled mark leaves storage alone.
struct RisScopeMark
  getter region : UInt64
  getter cursor : UInt64
  getter side : UInt64

  def initialize(@region : UInt64, @cursor : UInt64, @side : UInt64)
  end
end

@[AlwaysInline]
def __iyi_scope_mark(on : Bool) : RisScopeMark
  region = on ? RisRegion.tape : 0_u64
  return RisScopeMark.new(0_u64, 0_u64, 0_u64) if region == 0
  RisScopeMark.new(region, IyiHeap.read64(region &+ RisRegion::OFF_CURSOR),
    IyiHeap.read64(region &+ RisRegion::OFF_SIDE))
end

@[AlwaysInline]
def __iyi_scope_reset(mark : RisScopeMark) : Nil
  region = mark.region
  return if region == 0
  # Nothing put on the tape since the mark - most rounds of a loop, and a
  # def that made nothing there - leaves nothing to release: answered
  # here, inline, rather than by a call that finds as much.
  return if RisRegion.tape == region &&
            IyiHeap.read64(region &+ RisRegion::OFF_CURSOR) == mark.cursor &&
            IyiHeap.read64(region &+ RisRegion::OFF_SIDE) == mark.side
  __iyi_scope_release(mark)
end

def __iyi_scope_release(mark : RisScopeMark) : Nil
  region = mark.region
  # The running tape must be the marked one or grown from it; another
  # (a scope that ended oddly) is left alone.
  running = RisRegion.tape
  while running != region
    return if running == 0
    running = IyiHeap.read64(running &+ RisRegion::OFF_PARENT)
  end
  running = RisRegion.tape
  while running != region
    parent = IyiHeap.read64(running &+ RisRegion::OFF_PARENT)
    IyiHeap.write64(running &+ RisRegion::OFF_PARENT, 0_u64)
    RisRegion.release(running)
    running = parent
  end
  RisRegion.tape = region
  side = IyiHeap.read64(region &+ RisRegion::OFF_SIDE)
  while side != mark.side && side != 0
    following = IyiHeap.read64(side &+ RisRegion::OFF_PARENT)
    IyiHeap.write64(side &+ RisRegion::OFF_PARENT, 0_u64)
    RisRegion.release(side)
    side = following
  end
  IyiHeap.write64(region &+ RisRegion::OFF_SIDE, side)
  # Pages written past the warm first MiB go back to the kernel, as the
  # tape's own release hands them back: the cursor that release reads is
  # the mark's now. wasm32's tape is heap blocks, with no pages to return.
  {% unless flag?(:wasm32) %}
    written = IyiHeap.read64(region &+ RisRegion::OFF_CURSOR)
    low = mark.cursor &+ (RisRegion::GRAIN &- 1_u64)
    low = low & 0xFFFFFFFFFFFF0000_u64
    keep = region &+ RisRegion::KEEP_WARM
    low = keep if low < keep
    __iyi_release_pages(low, written &- low) if written > low &+ RisRegion::KEEP_WARM
  {% end %}
  IyiHeap.write64(region &+ RisRegion::OFF_CURSOR, mark.cursor)
end

# A pending result is staged outside the rollback, then copied onto the
# caller's restored mark. Only fresh backing storage is copied: borrowed
# handles and byte views keep their original addresses. The two copies buy
# a simple bounded scratch lifetime without overwriting unread result data.
struct RisPendingCopy
  def initialize(@head : Pointer(UInt64), @depth : Pointer(Int32),
                 @source : RisScopeMark, @source_head : UInt64,
                 @memo : Pointer(UInt64), @back : Bool, @saved : Pointer(UInt64))
  end

  def contains?(address : UInt64) : Bool
    region = @source_head
    while region != 0
      low = region == @source.region ? @source.cursor : region &+ RisRegion::DATA
      return true if address >= low &&
        address < IyiHeap.read64(region &+ RisRegion::OFF_CURSOR)
      side = IyiHeap.read64(region &+ RisRegion::OFF_SIDE)
      stop = region == @source.region ? @source.side : 0_u64
      while side != stop && side != 0
        return true if address >= side &+ RisRegion::DATA &&
          address < IyiHeap.read64(side &+ RisRegion::OFF_CURSOR)
        side = IyiHeap.read64(side &+ RisRegion::OFF_PARENT)
      end
      break if region == @source.region
      region = IyiHeap.read64(region &+ RisRegion::OFF_PARENT)
    end
    false
  end

  def run(&)
    return yield if @back || @depth.value > 0
    @head.value = RisRegion.acquire(RisRegion::CAPACITY) if @head.value == 0
    @saved.value = RisRegion.tape
    RisRegion.tape = @head.value
    @depth.value = 1
    value = yield
    restore(@saved.value)
    value
  end

  # Mutable result handles keep their internal sharing across both copies.
  # The relocation list lives on staging storage, including on copy-back;
  # no bookkeeping is retained on the caller's tape.
  def lookup(source : UInt64) : UInt64
    entry = @memo.value
    while entry != 0
      return IyiHeap.read64(entry &+ 8_u64) if IyiHeap.read64(entry) == source
      entry = IyiHeap.read64(entry &+ 16_u64)
    end
    0_u64
  end

  def remember(source : UInt64, destination : UInt64) : Nil
    saved = RisRegion.tape
    if @back
      @saved.value = saved
      @depth.value = 1
      RisRegion.tape = @head.value
    end
    entry = RisRegion.tape_bytes(24_u64)
    IyiHeap.write64(entry, source)
    IyiHeap.write64(entry &+ 8_u64, destination)
    IyiHeap.write64(entry &+ 16_u64, @memo.value)
    @memo.value = entry
    if @back
      @head.value = RisRegion.tape
      RisRegion.tape = saved
      @depth.value = 0
    end
  end

  def restore(saved : UInt64) : Nil
    @head.value = RisRegion.tape
    @depth.value = 0
    RisRegion.tape = saved
  end
end

def __iyi_pending_drop(head : Pointer(UInt64)) : Nil
  region = head.value
  head.value = 0_u64
  while region != 0
    parent = IyiHeap.read64(region &+ RisRegion::OFF_PARENT)
    IyiHeap.write64(region &+ RisRegion::OFF_PARENT, 0_u64)
    RisRegion.release(region)
    region = parent
  end
end

# A native typed registry node needs neither a closure nor a heap object.
# Its slots remain on the caller's stack until the panic drain runs it.
# Explicit owner copies also use this guard: restore the destination before
# releasing scratch, unless the complete result has been committed.
struct RisPendingGuard
  property next_node : IyiDefer?

  def initialize(@head : Pointer(UInt64), @depth : Pointer(Int32),
                 @saved : Pointer(UInt64),
                 @rollback : RisScopeMark = RisScopeMark.new(0_u64, 0_u64, 0_u64),
                 @committed : Pointer(Bool) = Pointer(Bool).new(0_u64))
    @next_node = nil
  end

  def run : Nil
    if @depth.value != 0
      @head.value = RisRegion.tape
      RisRegion.tape = @saved.value
      @depth.value = 0
    end
    __iyi_scope_reset(@rollback) if @committed.address != 0 && !@committed.value
    __iyi_pending_drop(@head)
  end
end

# Only Pointer(RisPendingGuard) is admitted to the defer registry. These
# methods give its native slot the same small interface as IyiDeferNode.
struct Pointer(T)
  def next_node : IyiDefer?
    value.next_node
  end

  def next_node=(node : IyiDefer?) : Nil
    made = value
    made.next_node = node
    self.value = made
  end

  def run : Nil
    value.run
  end
end

def __iyi_pending_guard(guard : Pointer(RisPendingGuard)) : Nil
  {% if (flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) || (flag?(:win32) && flag?(:x86_64)) %}
    fiber = IyiScheduler.current
    guard.next_node = fiber.defers
    fiber.defers = guard
  {% else %}
    IyiDefers.push(guard)
  {% end %}
end

def __iyi_pending_pop(guard : Pointer(RisPendingGuard)) : Nil
  {% if (flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) || (flag?(:win32) && flag?(:x86_64)) %}
    IyiScheduler.current.defers = guard.next_node
    guard.run
  {% else %}
    IyiDefers.pop_run
  {% end %}
end

def __iyi_scope_result(mark : RisScopeMark, value : T) : T forall T
  return value if mark.region == 0
  {% if T == ::String || T == ::String::Builder || T.name.starts_with?("Array(") || T.name.starts_with?("RisTree(") || T.annotation(::OnTape) || T < ::Tuple || T < ::NamedTuple || T.union? %}
    head = 0_u64
    depth = 0
    memo = 0_u64
    saved = RisRegion.tape
    guard = RisPendingGuard.new(pointerof(head), pointerof(depth), pointerof(saved))
    __iyi_pending_guard(pointerof(guard))
    staged = Tape.copy_value(value, RisPendingCopy.new(
      pointerof(head), pointerof(depth), mark, RisRegion.tape,
      pointerof(memo), false, pointerof(saved)))
    __iyi_scope_reset(mark)
    result = if head == 0
      staged
    else
      first = head
      while (parent = IyiHeap.read64(first &+ RisRegion::OFF_PARENT)) != 0
        first = parent
      end
      source = RisScopeMark.new(first, first &+ RisRegion::DATA, 0_u64)
      memo = 0_u64
      Tape.copy_value(staged, RisPendingCopy.new(
        pointerof(head), pointerof(depth), source, head, pointerof(memo),
        true, pointerof(saved)))
    end
    __iyi_pending_pop(pointerof(guard))
    result
  {% else %}
    __iyi_scope_reset(mark)
    value
  {% end %}
end

# Numeric text is read directly from tape bytes, as heap text is.
module IyiFloatText
  def self.parse(text : String) : Float64
    bytes = text.to_unsafe
    size = text.bytesize
    raise "not a number: #{text.inspect}" if size == 0
    at = 0
    negative = false
    if bytes[0] == 45_u8 || bytes[0] == 43_u8
      negative = bytes[0] == 45_u8
      at = 1
    end
    rest = size - at
    if rest == 8 && tail_is?(bytes + at, "Infinity")
      return from_bits(negative ? 18442240474082181120_u64 : 9218868437227405312_u64)
    end
    return from_bits(9221120237041090560_u64) if rest == 3 && tail_is?(bytes + at, "NaN")

    w = 0_u64
    exponent = 0
    digits = 0
    truncated = false
    seen_point = false
    any = false
    while at < size
      byte = bytes[at]
      if byte >= 48_u8 && byte <= 57_u8
        any = true
        if digits < 19
          if digits > 0 || byte != 48_u8
            w = w &* 10_u64 &+ (byte - 48_u8).to_u64
            digits = digits + 1
          end
          exponent = exponent - 1 if seen_point
        else
          truncated = true if byte != 48_u8
          exponent = exponent + 1 unless seen_point
        end
      elsif byte == 46_u8 && !seen_point
        seen_point = true
      elsif (byte == 101_u8 || byte == 69_u8) && any
        at = at + 1
        raise "not a number: #{text.inspect}" if at >= size
        exponent_negative = false
        if bytes[at] == 45_u8 || bytes[at] == 43_u8
          exponent_negative = bytes[at] == 45_u8
          at = at + 1
        end
        raise "not a number: #{text.inspect}" if at >= size
        read = 0
        while at < size
          byte = bytes[at]
          raise "not a number: #{text.inspect}" if byte < 48_u8 || byte > 57_u8
          # Read past what any double needs: the digits move the exponent
          # by up to the text's length, and a cap of 100000 read
          # "0.<999999 zeros>1e1000000" as 0.0.
          read = read * 10 + (byte - 48_u8).to_i32 if read < 100000000
          at = at + 1
        end
        exponent = exponent + (exponent_negative ? 0 - read : read)
        break
      else
        raise "not a number: #{text.inspect}"
      end
      at = at + 1
    end
    raise "not a number: #{text.inspect}" unless any
    return from_bits(negative ? 9223372036854775808_u64 : 0_u64) if w == 0_u64
    bits = nearest(exponent, w)
    return parse_exact(text) if truncated && nearest(exponent, w &+ 1_u64) != bits
    from_bits(negative ? bits | 9223372036854775808_u64 : bits)
  end

  # The digits read into a bignum - all of them to 800, which is past the
  # 767 that can decide a double, any beyond only telling whether the rest
  # is zero - and the quotient taken to 54 bits with a sticky remainder.
  def self.parse_exact(text : String) : Float64
    bytes = text.to_unsafe
    size = text.bytesize
    at = 0
    negative = false
    if bytes[0] == 45_u8 || bytes[0] == 43_u8
      negative = bytes[0] == 45_u8
      at = 1
    end
    rest = size - at
    if rest == 8 && tail_is?(bytes + at, "Infinity")
      return from_bits(negative ? 18442240474082181120_u64 : 9218868437227405312_u64)
    end
    return from_bits(9221120237041090560_u64) if rest == 3 && tail_is?(bytes + at, "NaN")

    mantissa = IyiBig.new(0_u64)
    exponent = 0
    digits = 0
    sticky = false
    seen_point = false
    any = false
    while at < size
      byte = bytes[at]
      if byte >= 48_u8 && byte <= 57_u8
        any = true
        if digits < 800
          mantissa.mul_small(10_u64)
          mantissa.add_small((byte - 48_u8).to_u64)
          digits = digits + 1 if digits > 0 || byte != 48_u8
          exponent = exponent - 1 if seen_point
        else
          sticky = true if byte != 48_u8
          exponent = exponent + 1 unless seen_point
        end
      elsif byte == 46_u8 && !seen_point
        seen_point = true
      elsif (byte == 101_u8 || byte == 69_u8) && any
        at = at + 1
        raise "not a number: #{text.inspect}" if at >= size
        exponent_negative = false
        if bytes[at] == 45_u8 || bytes[at] == 43_u8
          exponent_negative = bytes[at] == 45_u8
          at = at + 1
        end
        raise "not a number: #{text.inspect}" if at >= size
        read = 0
        while at < size
          byte = bytes[at]
          raise "not a number: #{text.inspect}" if byte < 48_u8 || byte > 57_u8
          read = read * 10 + (byte - 48_u8).to_i32 if read < 100000000
          at = at + 1
        end
        exponent = exponent + (exponent_negative ? 0 - read : read)
        break
      else
        raise "not a number: #{text.inspect}"
      end
      at = at + 1
    end
    raise "not a number: #{text.inspect}" unless any
    return from_bits(negative ? 9223372036854775808_u64 : 0_u64) if mantissa.size == 0
    # Far outside the format either way: the value is under
    # 10^(digits + exponent) and at least a tenth of that.
    return from_bits(negative ? 18442240474082181120_u64 : 9218868437227405312_u64) if digits + exponent > 310
    return from_bits(negative ? 9223372036854775808_u64 : 0_u64) if digits + exponent < -345

    # value = mantissa * 10^exponent as numerator / denominator.
    numerator = mantissa
    denominator = IyiBig.new(1_u64)
    if exponent >= 0
      numerator.mul_pow10(exponent)
    else
      denominator.mul_pow10(0 - exponent)
    end
    # The quotient to 54 bits (one past the significand for the rounding
    # bit), the remainder's emptiness the sticky bit: shift the numerator
    # up until the quotient has that many bits. `scale` is how far.
    top = numerator.bit_length - denominator.bit_length
    scale = 54 - top
    if scale > 0
      numerator.shl(scale)
    elsif scale < 0
      denominator.shl(0 - scale)
    end
    quotient = IyiBig.new(0_u64)
    remainder = numerator.divide(denominator, quotient) || sticky
    if quotient.bit_length > 54
      # The estimate was a bit short of the shift: one more bit of
      # quotient than asked, which the rounding below absorbs by dropping
      # it into the sticky remainder.
      extra = quotient.low_bit
      quotient.shr1
      scale = scale - 1
      remainder = remainder || extra != 0_u64
    end
    # Binary exponent of the quotient's leading bit: value = q * 2^-scale.
    binary_exponent = 53 - scale
    q = quotient.to_u64
    # Subnormal: fewer than 53 bits of significand fit; shift q right until
    # its exponent is the format's floor, folding the dropped bits into
    # the rounding.
    if binary_exponent < -1022
      drop = -1022 - binary_exponent
      return from_bits(negative ? 9223372036854775808_u64 : 0_u64) if drop > 54
      while drop > 0
        remainder = remainder || (q & 1_u64) != 0_u64
        q = q.unsafe_shr(1_u64)
        drop = drop - 1
      end
      binary_exponent = -1022
    end
    # Round half to even on the 54th bit.
    half = q & 1_u64
    q = q.unsafe_shr(1_u64)
    if half != 0_u64 && (remainder || (q & 1_u64) != 0_u64)
      q = q + 1_u64
    end
    if q == 9007199254740992_u64
      q = q.unsafe_shr(1_u64)
      binary_exponent = binary_exponent + 1
    end
    return from_bits(negative ? 18442240474082181120_u64 : 9218868437227405312_u64) if binary_exponent > 1023
    biased = q < 4503599627370496_u64 ? 0_u64 : (binary_exponent + 1023).to_u64
    bits = biased.unsafe_shl(52_u64) | (q & 4503599627370495_u64)
    bits = bits | 9223372036854775808_u64 if negative
    from_bits(bits)
  end
end



struct String
  def byte_index(search : String, offset : Int32 = 0) : Int32?
    offset = offset + bytesize if offset < 0
    return nil if offset < 0 || offset > bytesize
    return offset if search.bytesize == 0
    return nil if search.bytesize > bytesize - offset
    m = search.bytesize
    limit = bytesize - m
    s = self
    t = search.as_tape
    i = offset
    spent = 0
    while i <= limit
      j = 0
      while j < m && s[i + j] == t[j]
        j = j + 1
      end
      return i if j == m
      spent = spent + j
      break if spent > 4 * (i - offset) + 64
      i = i + 1
    end
    return nil if i > limit

    prime = 16777619_u64
    power = 1_u64
    want = 0_u64
    have = 0_u64
    k = 0
    while k < m
      want = want &* prime &+ t[k].to_u64
      have = have &* prime &+ s[i + k].to_u64
      power = power &* prime
      k = k + 1
    end
    while true
      if have == want
        j = 0
        while j < m && s[i + j] == t[j]
          j = j + 1
        end
        return i if j == m
      end
      return nil if i == limit
      have = have &* prime &+ s[i + m].to_u64 &- power &* s[i].to_u64
      i = i + 1
    end
  end

  def includes?(text : String) : Bool
    !byte_index(text).nil?
  end

  def ends_with?(suffix : String) : Bool
    size = suffix.bytesize
    size <= bytesize && self[bytesize - size, size] == suffix
  end

  # Diagnostic text is retained only when a caller asks for inspection.
  def inspect : String
    String.build(bytesize + 2) { |w| inspect(w) }
  end
end

# Jobs own their source value on scratch storage. Destinations are stable
# slots on the owner (or the root native slot), never a job's native local.
@[OnTape]
struct RisCopyJob(T)
  def initialize(@value : T, @target : Pointer(T))
  end

  def self.perform(address : UInt64, work : RisCopyWork) : Nil
    job = Pointer(self).new(address).value
    {% if T.union? %}
      value = job.@value
      {% for member in T.union_types %}
        if value.is_a?({{member}})
          perform_member(value, job.@target, work)
          return
        end
      {% end %}
    {% else %}
      job.@value.__iyi_copy_into(job.@target, work)
    {% end %}
  end

  def self.perform_member(value : U, target : Pointer(T),
                          work : RisCopyWork) : Nil forall U
    # A union needs its concrete value in a stable typed slot until all
    # children finish. The store job runs after them, then tags the union.
    slot = work.slot(value)
    work.add(RisCopyStore(T, U).new(slot, target),
      ->(address : UInt64, work : RisCopyWork) {
        RisCopyStore(T, U).perform(address, work)
      })
    value.__iyi_copy_into(slot, work)
  end
end

@[OnTape]
struct RisCopyStore(T, U)
  def initialize(@source : Pointer(U), @target : Pointer(T))
  end

  def self.perform(address : UInt64, work : RisCopyWork) : Nil
    job = Pointer(self).new(address).value
    job.@target.value = job.@source.value
  end
end

struct RisCopyWork
  def initialize(@head : Pointer(UInt64), @jobs : Pointer(UInt64),
                 @depth : Pointer(Int32), @saved : Pointer(UInt64))
  end

  def scratch(&)
    @saved.value = RisRegion.tape
    @head.value = RisRegion.acquire(RisRegion::CAPACITY) if @head.value == 0
    RisRegion.tape = @head.value
    @depth.value = 1
    result = yield
    @head.value = RisRegion.tape
    RisRegion.tape = @saved.value
    @depth.value = 0
    result
  end

  def slot(value : T) : Pointer(T) forall T
    scratch do
      slot = Pointer(T).new(RisRegion.tape_bytes(sizeof(T).to_u64))
      slot.value = value
      slot
    end
  end

  def push(value, target) : Nil
    # Unwrap recursive aliases before forming Pointer(T); the alias and
    # its resolved union have the same layout but distinct pointer types.
    destination = target.as(Pointer(typeof(value)))
    add(RisCopyJob(typeof(value)).new(value, destination),
      ->(address : UInt64, work : RisCopyWork) {
        RisCopyJob(typeof(value)).perform(address, work)
      })
  end

  def add(job : T, callback : Proc(UInt64, RisCopyWork, Nil)) : Nil forall T
    scratch do
      # A fixed header carries a noncapturing, type-specialized callback.
      header = RisRegion.tape_bytes(16_u64 +
        sizeof(Proc(UInt64, RisCopyWork, Nil)).to_u64)
      IyiHeap.write64(header, @jobs.value)
      Pointer(Proc(UInt64, RisCopyWork, Nil)).new(header + 16_u64).value = callback
      payload = RisRegion.tape_bytes(sizeof(T).to_u64)
      Pointer(T).new(payload).value = job
      IyiHeap.write64(header + 8_u64, payload)
      @jobs.value = header
    end
  end

  def drain : Nil
    while (header = @jobs.value) != 0
      @jobs.value = IyiHeap.read64(header)
      callback = Pointer(Proc(UInt64, RisCopyWork, Nil)).new(header + 16_u64).value
      callback.call(IyiHeap.read64(header + 8_u64), self)
    end
  end
end

struct RisTaskCopy
end

module Tape
  def self.owner_copy(value : T, owner) : T forall T
    check_copy(T, Tuple())
    copy_owned(value, owner)
  end

  def self.task_copy(value : T, owner) : T forall T
    check_copy(T, Tuple(), RisTaskCopy)
    copy_owned(value, owner)
  end

  private def self.copy_owned(value : T, owner) : T forall T
    owner.run do
      head = 0_u64
      jobs = 0_u64
      depth = 0
      saved = RisRegion.tape
      committed = false
      guard = RisPendingGuard.new(pointerof(head), pointerof(depth),
        pointerof(saved), __iyi_scope_mark(true), pointerof(committed))
      __iyi_pending_guard(pointerof(guard))
      work = RisCopyWork.new(pointerof(head), pointerof(jobs),
        pointerof(depth), pointerof(saved))
      result = value
      work.push(value, pointerof(result))
      work.drain
      committed = true
      __iyi_pending_pop(pointerof(guard))
      result
    end
  end
end

# Numeric formatting writes directly into the caller's tape builder.

struct Int64
  def to_s(writer : String::Builder, base : Int32 = 10) : Nil
    writer.append_int(self, base)
  end
end

struct UInt64
  def to_s(writer : String::Builder, base : Int32 = 10) : Nil
    writer.append_uint(self, base)
  end
end

# Byte-for-byte diagnostic quoting, with the inherited String spelling.
struct String
  def inspect(writer : String::Builder) : Nil
    writer.push(34_u8)
    index = 0
    while index < bytesize
      lead = self[index].to_i32
      width = lead < 0xC2 || lead > 0xF4 ? 1 : lead < 0xE0 ? 2 : lead < 0xF0 ? 3 : 4
      point = width > 1 ? lead & (0x7F >> width) : lead < 0x80 ? lead : -1
      k = 1
      while k < width && point >= 0
        byte = index + k < bytesize ? self[index + k].to_i32 : 0
        point = (byte & 0xC0) == 0x80 ? (point << 6) | (byte & 0x3F) : -1
        k += 1
      end
      if width > 1 && (point < (1 << (5 * width - 4)) || point > 0x10FFFF || (point >= 0xD800 && point < 0xE000))
        point = -1
      end
      if point < 0
        writer << "\\x"
        inspect_hex(writer, lead, 2)
        width = 1
      elsif point == 34 || point == 92
        writer.push(92_u8)
        writer.push(point.to_u8)
      elsif point >= 7 && point <= 13
        writer.push(92_u8)
        writer.push("abtnvfr".as_tape[point - 7])
      elsif point == 27
        writer << "\\e"
      elsif point.unsafe_chr.printable?
        writer.push(92_u8) if point == 35 && index + 1 < bytesize && self[index + 1] == 123_u8
        writer << self[index, width]
      elsif point > 0xFFFF
        writer << "\\u{"
        inspect_hex(writer, point, 1)
        writer << "}"
      else
        writer << "\\u"
        inspect_hex(writer, point, 4)
      end
      index += width
    end
    writer.push(34_u8)
  end

  private def inspect_hex(writer : String::Builder, point : Int32, minimum : Int32) : Nil
    digits = 1
    temp = point
    while temp >= 16
      digits += 1
      temp = temp // 16
    end
    digits = minimum if digits < minimum
    while digits > 0
      digit = (point >> ((digits - 1) * 4)) & 15
      writer.push((digit < 10 ? 48 + digit : 55 + digit).to_u8)
      digits -= 1
    end
  end
end

struct Int32
  def to_s(writer : String::Builder, base : Int32 = 10) : Nil
    writer.append_int(to_i64, base)
  end
end

struct UInt8
  def to_s(writer : String::Builder, base : Int32 = 10) : Nil
    writer.append_uint(to_u64, base)
  end
end

# Internal closure storage. No environment survives its documented owner.
fun __ris_task_environment(size : UInt64) : Void*
  Pointer(Void).new(RisRegion.tape_bytes(size))
end

fun __ris_program_environment(size : UInt64) : Void*
  address = 0_u64
  RisRegion.program_scope { address = RisRegion.tape_bytes(size) }
  Pointer(Void).new(address)
end

fun __ris_tape_object(size : UInt64, type_id : UInt64) : Void*
  Pointer(Void).new(RisRegion.tape_object(size, type_id))
end

fun __ris_program_object(size : UInt64, type_id : UInt64) : Void*
  Pointer(Void).new(RisRegion.program_bytes(size, true, type_id))
end

class RisRegion
  # Copy retained text to the explicit program owner.
  def self.program_text(text : String) : String
    text.copy_to(Program.tape)
  end
end

# Typed reusable runs. Freed slots remain initialized until tape release.
@[OnTape]
struct SlicePool(T)
  @data : Array(T)
  @free : Array(String::Span)

  def initialize(capacity : Int32 | Int64 = 4)
    @data = Array(T).new(capacity, RisPoolStorage.new)
    @free = Array(String::Span).new
  end

  def size : Int32
    @data.size
  end

  private def checked(n : Int32 | Int64) : Int32
    Tape.storage(n, sizeof(T).to_u64)
    n.to_i32
  end

  private def run(at : Int32, n : Int32) : Run(T)
    Run(T).new(@data, at, n)
  end

  private def validate(s : Run(T)) : Nil
    return if s.size == 0
    if s.@state.address != @data.@state.address || s.offset < 0 || s.size < 0 ||
       s.offset.to_i64 + s.size > size
      RisRegion.size_error("iyi: SlicePool foreign or invalid run: ", 0_u64)
    end
  end

  private def default_value : T
    {% if T < Number %}
      T.zero
    {% elsif T == String %}
      String.new("")
    {% elsif T == Bool %}
      false
    {% elsif T == Char %}
      '\0'
    {% elsif T.nilable? || T == Nil %}
      nil
    {% else %}
      T.new
    {% end %}
  end

  private def extend_to(stop : Int32, fill : T) : Nil
    while @data.size < stop
      @data << fill
    end
  end

  private def defaults(at : Int32, n : Int32, fill : T) : Nil
    i = 0
    while i < n
      @data[at + i] = fill
      i += 1
    end
  end

  def alloc_slice(n : Int32 | Int64) : Run(T)
    alloc_slice(n, default_value)
  end

  def alloc_slice(n : Int32 | Int64, fill : T) : Run(T)
    count = checked(n)
    return run(0, 0) if count == 0
    i = 0
    while i < @free.size
      span = @free[i]
      if span.size >= count || span.start + span.size == size
        stop = checked(span.start.to_i64 + count)
        extend_to(stop, fill)
        take = (count < span.size ? count : span.size)
        @free[i] = String::Span.new(span.start + take, span.size - take)
        defaults(span.start, take, fill)
        return run(span.start, count)
      end
      i += 1
    end
    at = size
    stop = checked(at.to_i64 + count)
    extend_to(stop, fill)
    run(at, count)
  end

  def free_slice(s : Run(T)) : Nil
    validate(s)
    return if s.size == 0
    start = s.offset
    stop = start + s.size
    # Compact all touching spans, then insert in sorted order.
    kept = 0
    i = 0
    while i < @free.size
      span = @free[i]
      if span.size > 0
        if span.start <= stop && span.start + span.size >= start
          start = (start < span.start ? start : span.start)
          stop = (stop > span.start + span.size ? stop : span.start + span.size)
        else
          @free[kept] = span
          kept += 1
        end
      end
      i += 1
    end
    while @free.size > kept
      @free.pop
    end
    @free << String::Span.new(start, stop - start)
    i = @free.size - 1
    while i > 0 && @free[i - 1].start > start
      @free[i] = @free[i - 1]
      i -= 1
    end
    @free[i] = String::Span.new(start, stop - start)
  end

  # Find the post-free placement before touching data or the freelist.
  private def check_relocation(s : Run(T), count : Int32) : Nil
    start = s.offset
    stop = start + s.size
    @free.each do |span|
      if span.size > 0 && span.start <= stop && span.start + span.size >= start
        start = start < span.start ? start : span.start
        stop = stop > span.start + span.size ? stop : span.start + span.size
      end
    end
    inserted = false
    @free.each do |span|
      if !inserted && span.start >= start
        inserted = true
        if stop - start >= count || stop == size
          checked(start.to_i64 + count)
          return
        end
      end
      next if span.size == 0 || (span.start <= stop && span.start + span.size >= start)
      if span.size >= count || span.start + span.size == size
        checked(span.start.to_i64 + count)
        return
      end
    end
    if !inserted && (stop - start >= count || stop == size)
      checked(start.to_i64 + count)
    else
      checked(size.to_i64 + count)
    end
  end

  def realloc_slice(s : Run(T), n : Int32 | Int64) : Run(T)
    realloc_slice(s, n, default_value)
  end

  def realloc_slice(s : Run(T), n : Int32 | Int64, fill : T) : Run(T)
    Tape.check_slice_relocation(T, Tuple())
    count = checked(n)
    validate(s)
    return alloc_slice(count, fill) if s.size == 0
    if count <= s.size
      free_slice(run(s.offset + count, s.size - count))
      return run(s.offset, count)
    end
    old_stop = s.offset + s.size
    if old_stop == size
      stop = checked(s.offset.to_i64 + count)
      extend_to(stop, fill)
      return run(s.offset, count)
    end
    i = 0
    while i < @free.size
      span = @free[i]
      if span.start == old_stop &&
         (span.size >= count - s.size || span.start + span.size == size)
        stop = checked(s.offset.to_i64 + count)
        extend_to(stop, fill)
        take = (count - s.size < span.size ? count - s.size : span.size)
        @free[i] = String::Span.new(span.start + take, span.size - take)
        defaults(old_stop, take, fill)
        return run(s.offset, count)
      end
      i += 1
    end
    # Save typed values before freeing: the destination can overlap them.
    check_relocation(s, count)
    saved = Array(T).new(s.size, RisPoolStorage.new)
    s.each { |value| saved << value }
    free_slice(s)
    made = alloc_slice(count, fill)
    i = 0
    while i < saved.size
      made[i] = saved[i]
      i += 1
    end
    made
  end

  @[OnTape]
  struct Run(T)
    getter offset : Int32
    getter size : Int32

    @state : Pointer(UInt64)

    def initialize(data : Array(T), @offset : Int32, @size : Int32)
      if @offset < 0 || @size < 0 || @offset.to_i64 + @size > data.size
        RisRegion.size_error("iyi: SlicePool slice out of bounds: ", 0_u64)
      end
      @state = data.@state
    end

    def __iyi_copy_into(target : Pointer(self), work : RisCopyWork) : Nil
      made = Array(T).new(@size) { |i| self[i] }
      target.value = self.class.new(made, 0, @size)
      i = @size
      while i > 0
        i -= 1
        work.push(self[i], Pointer(T).new(made.@state.value +
          i.to_u64 * sizeof(T).to_u64))
      end
    end

    def __iyi_pending_copy(owner : RisPendingCopy) : self
      return self unless owner.contains?(@state.address)
      owner.run do
        made = Array(T).new(@size) { |i| Tape.copy_value(self[i], owner) }
        self.class.new(made, 0, @size)
      end
    end

    def [](index : Int32) : T
      check(index)
      Pointer(T).new(@state.value + (@offset + index).to_u64 *
        sizeof(T).to_u64).value
    end

    def []=(index : Int32, value : T) : T
      check(index)
      Pointer(T).new(@state.value + (@offset + index).to_u64 *
        sizeof(T).to_u64).value = value
    end

    def empty? : Bool
      @size == 0
    end

    def each(& : T -> _) : Nil
      i = 0
      while i < @size
        yield self[i]
        i += 1
      end
    end

    def each_with_index(& : T, Int32 -> _) : Nil
      i = 0
      while i < @size
        yield self[i], i
        i += 1
      end
    end

    def map(& : T -> U) : Array(U) forall U
      Array(U).new(@size) { |i| yield self[i] }
    end

    private def check(index : Int32) : Nil
      if index < 0 || index >= @size
        RisRegion.size_error("iyi: SlicePool index out of bounds: ",
          index.unsafe_to_u64)
      end
    end

    def [](start : Int32, count : Int32) : self
      if start < 0 || count < 0 || start.to_i64 + count > @size
        RisRegion.size_error("iyi: SlicePool slice out of bounds: ", 0_u64)
      end
      made = self
      pointerof(made.@offset).value = @offset + start
      pointerof(made.@size).value = count
      made
    end
  end
end

module Tape
  def self.check_slice_relocation(type : T.class, path : P.class) : Nil forall T, P
    # The compiler checks the resolved fields without naming private types.
  end
end

# Mutable lists share typed slice storage; only the run handle changes.
@[OnTape]
struct SlicePool::List(T)
  @[OnTape]
  struct State(T)
    property pool : SlicePool(T?)
    property run : SlicePool::Run(T?)
    property size : Int32

    def initialize(@pool : SlicePool(T?))
      @run = @pool.alloc_slice(0)
      @size = 0
    end
  end

  @state : Pointer(State(T))

  def initialize(pool : SlicePool(T?))
    @state = Pointer(State(T)).new(
      RisRegion.tape_bytes(sizeof(State(T)).to_u64))
    @state.value = State(T).new(pool)
  end

  def __iyi_copy_into(target : Pointer(self), work : RisCopyWork) : Nil
    made = self.class.new(SlicePool(T?).new(size))
    each { |item| made << item }
    target.value = made
    i = size
    while i > 0
      i -= 1
      work.push(self[i].as(T?), Pointer(T?).new(made.@state.value.run.@state.value +
        (made.@state.value.run.offset + i).to_u64 * sizeof(T?).to_u64))
    end
  end

  def __iyi_pending_copy(owner : RisPendingCopy) : self
    return self unless owner.contains?(@state.address)
    cached = owner.lookup(@state.address)
    if cached != 0
      made = self
      pointerof(made.@state).value = Pointer(State(T)).new(cached)
      return made
    end
    owner.run do
      made = self.class.new(SlicePool(T?).new(size))
      owner.remember(@state.address, made.@state.address)
      each { |item| made << Tape.copy_value(item, owner) }
      made
    end
  end

  def size : Int32
    @state.value.size
  end

  def empty? : Bool
    size == 0
  end

  def [](i : Int32) : T
    if i < 0 || i >= size
      RisRegion.size_error("iyi: SlicePool index out of bounds: ",
        i.unsafe_to_u64)
    end
    @state.value.run[i].as(T)
  end

  def []=(i : Int32, value : T) : T
    if i < 0 || i >= size
      RisRegion.size_error("iyi: SlicePool index out of bounds: ",
        i.unsafe_to_u64)
    end
    @state.value.run[i] = value
  end

  def <<(value : T) : Nil
    state = @state.value
    if state.size == state.run.size
      capacity = Tape.grown(state.run.size.to_u64).to_i32
      state.run = state.pool.realloc_slice(state.run, capacity)
    end
    state.run[state.size] = value
    state.size += 1
    @state.value = state
  end

  def each(& : T -> _) : Nil
    i = 0
    while i < size
      yield self[i]
      i += 1
    end
  end
end

# Each nested container owns typed payload runs and reusable handle slots.
@[OnTape]
private struct RisArrayPool(T)
  getter data : SlicePool(T)
  getter handles : SlicePool(StaticArray(UInt64, 8))
  getter child_pool : UInt64
  @program : Bool

  def program? : Bool
    @program
  end

  def initialize
    @data = SlicePool(T).new
    @handles = SlicePool(StaticArray(UInt64, 8)).new
    @child_pool = self.class.children
    @program = RisRegion.program_active?
  end

  def self.children : UInt64
    {% if T < Array %}
      pool = Pointer(RisArrayPool({{T.type_vars[0]}})).new(
        RisRegion.tape_bytes(sizeof(RisArrayPool({{T.type_vars[0]}})).to_u64))
      pool.value = RisArrayPool({{T.type_vars[0]}}).new
      pool.address
    {% elsif T == String %}
      return 0_u64 unless RisRegion.program_active?
      pool = Pointer(SlicePool(UInt8)).new(
        RisRegion.tape_bytes(sizeof(SlicePool(UInt8)).to_u64))
      pool.value = SlicePool(UInt8).new
      pool.address
    {% else %}
      0_u64
    {% end %}
  end
end

# Runtime-only marker for a pool's already placed slots.
private struct RisPoolStorage
end
