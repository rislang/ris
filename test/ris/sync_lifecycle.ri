module test/ris/sync_lifecycle

old_s = group do |g|
  g.new_semaphore(1)
end
old_e = group do |g|
  g.new_event
end
# Reuse retired slots before observing old handles.
group do |g|
  s = g.new_semaphore(1)
  e = g.new_event
  raise "stale acquire" unless old_s.acquire.is_a?(RisInbox::Closed)
  raise "stale timed acquire" unless old_s.acquire(-1).is_a?(RisInbox::Closed)
  raise "stale release" unless old_s.release.is_a?(RisInbox::Closed)
  ran = false
  raise "stale hold" unless old_s.hold { ran = true }.is_a?(RisInbox::Closed)
  raise "closed hold ran" if ran
  raise "stale wait" unless old_e.wait.is_a?(RisInbox::Closed)
  raise "stale timed wait" unless old_e.wait(-1).is_a?(RisInbox::Closed)
  raise "stale fire" unless old_e.fire.is_a?(RisInbox::Closed)
  raise "stale fired" unless old_e.fired?.is_a?(RisInbox::Closed)
  raise "replacement permit" unless s.acquire(0).nil?
  raise "replacement event" unless e.fired? == false
end

group do |g|
  s = g.new_semaphore(1)
  task = g.spawn do
    s.hold { s.acquire(-1) }
    nil
  end
  result = task.value
  raise "hold did not panic" unless result.is_a?(Panicked)
  # Child panic cancels siblings, not this group's owner.
  raise "hold leaked permit" unless s.acquire(0).nil?
  s.release
end

group do |g|
  s = g.new_semaphore(1)
  task = g.spawn do
    s.release
    nil
  end
  result = task.value
  raise "over-release accepted" unless result.is_a?(Panicked)
  if result.is_a?(Panicked)
    raise "over-release hint" unless result.message.includes?("release only an acquired permit")
  end
end

2.times do |i|
  n = i - 1
  group do |g|
    task = g.spawn do
      g.new_semaphore(n)
      nil
    end
    result = task.value
    raise "invalid permits" unless result.is_a?(Panicked)
    if result.is_a?(Panicked)
      raise "empty start hint" unless result.message.includes?("pre-acquire")
    end
  end
end
puts "PASS: sync lifecycle"
