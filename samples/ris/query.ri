# query: query parameters read a million times on the tape.
# Prints a checksum; report tape memory with RIS_TAPE_STATS=1.
#
#   ./bin/ris build --release -o query samples/ris/query.ri
#   RIS_TAPE_STATS=1 ./query

module samples/query_bench

import std/uri::{Query}

N = 1000000
QUERIES = Ary(Str){
  "q=hello+world&page=2&sort=name",
  "filter=a%2Cb&x=1&y=&z",
  "page=10;limit=50&q=caf%C3%A9",
}

sum = 0_i64
i = 0
while i < N
  text = QUERIES[i % 3]
  tape do
    q = Query.parse(text)
    page = q["page"]?
    words = q["q"]?
    sum += (page ? page.bytesize : 0) + (words ? words.bytesize : 0) + q.size
  end
  i += 1
end
puts sum
