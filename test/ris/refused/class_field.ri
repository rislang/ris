module test/ris/refused/class_field

import std/int

@[OnTape]
struct Resp
  getter id : Int64
  getter user : String

  def initialize(@id : Int64, @user : String)
  end
end

def make : Resp
  Resp.new(1_i64, String.build { |s| s.push(97_u8) })
end

# A class reference must not retain a shorter-lived field.
class Cache
  @last : Resp?

  def initialize
    @last = nil
  end

  def keep(r : Resp) : Nil
    @last = r
  end
end

cache = Cache.new
local_tape { cache.keep(make) }
