# Tape HPACK round-trips fields through connection tables, with and
# without Huffman, and refuses malformed blocks. No heap.
module test/ris/hpack

import std/hpack::{Encoder, Decoder, HpackError,
                  TapeHeaders, TapeHeaderField, IndexingMode, DynamicTable}

encoder = Encoder.new
decoder = Decoder.new
20.times do |i|
  encoder.use_huffman = i % 2 == 0
  encoder.set_max_table_size(128) if i == 5
  tape do
    fields = TapeHeaders.new(5)
    fields.push(TapeHeaderField.new(String.new(":method"), String.new("GET"),
      IndexingMode::Incremental))
    fields.push(TapeHeaderField.new(String.new(":path"), String.new("/hello?q=1"),
      IndexingMode::Incremental))
    fields.push(TapeHeaderField.new(String.new("x-indexed"),
      String.new("retained by the table"), IndexingMode::Incremental))
    fields.push(TapeHeaderField.new(String.new("authorization"),
      String.new("secret"), IndexingMode::NeverIndexed))
    fields.push(TapeHeaderField.new(String.new("x-raw"),
      String.new("utf8: ü and NUL: \x00"), IndexingMode::WithoutIndexing))
    encoded = encoder.encode(fields)
    decoded = TapeHeaders.new(decoder.capacity(encoded))
    failed = decoder.decode(encoded, decoded)
    raise failed.message if failed
    raise "field count" unless decoded.size == 5
    k = 0
    decoded.each do |field|
      raise "name #{k}" unless field.name == fields[k].name
      raise "value #{k}" unless field.value == fields[k].value
      k += 1
    end
  end
end
# Bad integers, index zero, truncated literals and Huffman padding.
["\x80", "\xff", "\x00\x03a", "\x00\x81\x00"].each do |text|
  tape do
    bad = Decoder.new
    into = TapeHeaders.new(bad.capacity(text))
    decoded = bad.decode(text, into)
    raise "accepted malformed block" unless decoded.is_a?(HpackError)
  end
end
# List limits must reject a valid indexed field before writing a slot.
tape do
  text = "\x82"
  counting = Decoder.new(max_header_count: 0)
  counted = TapeHeaders.new(counting.capacity(text))
  count = counting.decode(text, counted)
  raise "count limit" unless count.is_a?(HpackError)
  raise "count error" unless count.message.starts_with?("Decompression bomb")
  sizing = Decoder.new(max_header_list_size: 41)
  sized = TapeHeaders.new(sizing.capacity(text))
  size = sizing.decode(text, sized)
  raise "size limit" unless size.is_a?(HpackError)
  raise "size error" unless size.message.starts_with?("Decompression bomb")
end
# A connection owns its runs; request text never becomes table storage.
def churn(table : DynamicTable, index : Int32) : Nil
  table.add("key#{index % 3}", "v" * (index % 23 + 1))
end

table = DynamicTable.new(128)
table.add("original", "retained")
field = table.get(1)
raise "missing retained field" unless field
kept = field.copy_to(RisCurrentTape.new)
1000.times { |index| churn(table, index) }
raise "pool reuse" unless table.byte_slots <= 512
raise "retained copy" unless kept.name == "original" && kept.value == "retained"
table.clear
raise "table clear" unless table.empty? && table.size == 0

puts "PASS: tape HPACK fields, retained tables and malformed input"
