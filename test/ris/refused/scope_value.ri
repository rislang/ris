module test/ris/refused/scope_value

import std/int

@[OnTape]
struct Resp
  getter id : Int64
  getter user : Str

  def initialize(@id : Int64, @user : Str)
  end
end

def make : Resp
  Resp.new(1_i64, Str.build { |s| s.push(97_u8) })
end

# The block value leaves the scope; its storage does not.
kept = tape { make }
puts kept.id
