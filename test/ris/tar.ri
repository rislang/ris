module test/tar_tape

import std/tar::{TarReader, TarWriter, TarEntry, TarError}
import std/compress::{Gzip}
import std/io::{Memory}
import std/time::{Time}
import std/digest::{CRC32}
import std/base64::{Base64}

# std/tar on the caller's tape: archives Python's tarfile wrote (pax and
# GNU, plain - shipped gzipped and unpacked here - and through gzip,
# bzip2 and xz) listed with each entry's data CRC-32; an archive written
# here, plain and gzipped, read back; a bad checksum refused. No heap.

def hex(v : UInt32) : String
  v.to_s(16).rjust(8, '0')
end

def list(data : String) : Nil
  reader = TarReader.new(Memory.new(data))
  while true
    entry = reader.next_entry
    if entry.is_a?(TarError)
      puts entry.message
      return
    end
    return unless entry
    body = entry.read_all
    if body.is_a?(TarError)
      puts body.message
      return
    end
    link = entry.linkname.empty? ? "-" : entry.linkname
    puts "  #{entry.type_name} #{entry.name} #{entry.size} #{hex(CRC32.checksum(body))} #{link} #{entry.mode.to_s(8)} #{entry.uname}"
  end
end

tape do
  archives = [
    {"plain", ""},
    {"gnu", ""},
    {"gz", ""},
    {"bz2", ""},
    {"xz", ""},
  ]
  archives.each do |pair|
    data = Base64.decode(pair[1])
    data = Gzip.decompress(data) if pair[0] == "plain" || pair[0] == "gnu"
    puts pair[0]
    list(data)
  end
  [false, true].each do |gzip|
    sink = Memory.new
    w = TarWriter.new(sink, gzip: gzip)
    when_ = Time.unix(1700000000_i64)
    w.add_directory("d/", mtime: when_)
    w.add("d/a.txt", "alpha\n" * 100, mtime: when_)
    w.add("d/" + "n" * 150, "long", mtime: when_)
    w.add_symlink("s", "d/a.txt", mtime: when_)
    w.finish
    bytes = sink.to_s
    puts "written #{gzip} #{bytes.bytesize} #{hex(CRC32.checksum(bytes))}"
    list(bytes)
  end
  plain = Gzip.decompress(Base64.decode(archives[0][1]))
  broken = String.build { |b| b << plain[0, 100] << "Z" << plain[101, plain.bytesize - 101] }
  list(broken)
end
