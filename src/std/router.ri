# standard: Go net/http path cleaning
# A request router for std/http: `Router#handle(pattern) { |req, res,
# params| ... }` registers a handler, and `router.call(req, res)` is what
# a `Server.answer` handler's `call` runs. The patterns, their precedence and
# the answers when none applies are Go's `http.ServeMux` - its 1.22
# patterns, its 1.26 redirects - implemented from its documentation
# (pkg.go.dev/net/http#ServeMux), so a table of routes reads the same in
# both.
#
# A pattern is `[METHOD ][HOST]/[PATH]`. A method matches exactly, except
# that `GET` matches `HEAD` too; no method matches every method, no host
# every host. A path is segments: a literal matches the request's segment
# percent-decoded (`/%61` matches `/a`, `/a%2fb` matches one segment
# `a/b`); `{name}` matches one non-empty segment; a last `{name...}`
# matches the rest of the path, slashes and nothing included; a trailing
# `/` is an anonymous one, a subtree; `{$}` matches only the end, so `/{$}`
# is `/` alone where `/` is every path. A wildcard's value is
# percent-decoded and handed to the handler by name in a
# `Hash(String, String)`; a trailing `/` records nothing.
#
# When several patterns match a request the most specific wins: the one
# whose requests are a strict subset of the other's. Two patterns neither
# of which is more specific, but which both match some request, conflict,
# and the second is refused when it is registered, with a sentence naming
# both and a request both match: `GET /` and `/index.html` conflict (one
# has the narrower method, the other the narrower path), as do `/a/{x}`
# and `/{y}/b`. A pattern with a host beats one without, whatever their
# paths, and the two never conflict - Go's one exception, kept for its
# reasons. Precedence is decided by comparing patterns, not by the order
# they were registered in, so a table means the same in any order.
#
# What no pattern answers: a path that matches only patterns of other
# methods - itself, or with a slash added - is 405 with `Allow` listing
# them, sorted, `HEAD` beside `GET`; a request for `/x` where `/x/` (or
# `/x/{rest...}`) is registered and `/x` is not is redirected to `/x/`
# (307, the query kept); a path with a `.` or `..` segment or a repeated
# slash is redirected to its cleaned form (307), as Go's is, so a handler
# is only ever handed the path its pattern matched; anything else is
# 404. An escaped `%2e%2e` or `%2F` is not a dot segment or a separator,
# and arrives in a wildcard's value as `..` or `/`: a handler that turns
# a value into a file name checks it (std/fileserver does its own).
#
# Both redirects are 307 Temporary Redirect, as Go's have been since 1.26;
# 1.22 to 1.25 answered 301 Moved Permanently. Go's reasons, which are
# this router's: a client may turn a POST it is sent on with a 301 into a
# GET, where a 307 is sent again with its method and body, and a client
# may keep a permanent redirect for good, where the redirect is the
# router's and not the program's, and a pattern registered in a later
# version of the program may answer that path itself. Go's release notes
# name the trailing-slash redirect, and its `server.go` answers the
# cleaned path with 307 as well; this follows the code. The status is
# fixed, not an option: a router that could answer either would need its
# tables checked twice, and the older answer is the one Go left.
#
# Where this departs from Go, and why: a path with a malformed percent
# escape is 400 here - Go's server refuses it before its mux sees it, and
# std/http hands it on. A pattern holding one, or whose path is not clean
# (`//`, `.`, `..`), is refused where Go 1.25 takes it as written: no
# request reaches it, cleaned and with its escapes valid. A target that
# is not a path (`OPTIONS *`, `CONNECT`'s authority) is 404. Wildcard
# names are ASCII identifiers (Go takes any Unicode letter). The `Host`
# is matched as Go matches it: its port dropped, otherwise as sent.
# `test/cli/std_router_exercise.sh` hands its tables - 70 requests, 23 pairs
# of patterns registered in turn, 28 patterns read - to Go's own
# `ServeMux` where a Go toolchain is installed. Under Go 1.26 or later
# every answer is the same; under 1.22 to 1.25 the one difference allowed
# is a redirect's 301 where this answers 307 with the same `Location`,
# and the gate names it.
#
# Patterns are registered before the router answers: a `handle` after its
# first `call` panics. Go takes them at any time under a lock; refusing
# them means the table a request is matched against is never written
# while a fiber reads it, and that whether two patterns conflict is known
# before any request depends on which wins. Each request is compared
# with every pattern of its host, which is linear in the table; there is
# no tree, since tables are tens of routes and the comparison that picks
# the winner is the same one that refuses a conflict, which keeps the
# two from disagreeing. Measured, a release build with the gate's first
# table (21 patterns) routed 200,000 requests in 165 ms, under a
# microsecond each.

@[NoSpec("std API predates spec-required; proofs follow")]
module std/router

import std/http::{HTTP, Incoming, Outgoing}
import std/uri::{URI}

# Why a pattern is refused: `Router#parse`'s answer for text that is not
# a pattern. `Router#handle` panics with its `message`.
@[OnTape]
pub struct RouterError
  getter reason : String

  def initialize(@reason : String)
  end

  def to_s : String
    "Router: " + @reason
  end
end

impl Error for RouterError
  def message : String
    "Router: " + @reason
  end
end

# A wildcard's name and value, as `Router#match_pieces` reads them.
@[OnTape]
pub struct Capture
  getter name : String
  getter value : String

  def initialize(@name : String, @value : String)
  end
end

@[OnTape]
pub struct Captures
  getter entries : Array(Capture)

  def initialize
    @entries = Array(Capture).new
  end

  def add(name : String, value : String) : Nil
    @entries << Capture.new(name, value)
  end

  def clear : Nil
    @entries.clear
  end

  def [](name : String) : String
    @entries.each { |entry| return entry.value if entry.name == name }
    raise "no route capture #{name}"
  end

  def to_h : Hash(String, String)
    result = {} of String => String
    @entries.each { |entry| result[entry.name] = entry.value }
    result
  end
end

# One pattern a router read, by its index: what `Router#parse` answers and
# `Router#patterns` lists. It views its router's storage and lives no
# longer than its router. `matches?` asks a request path; `relation` and `conflict` are the comparisons that decide precedence
# and refuse two patterns neither of which is more specific.
@[OnTape]
pub struct PatternView
  getter index : Int32

  def initialize(@router : Router, @index : Int32)
  end

  protected def router : Router
    @router
  end

  # The pattern as it was written.
  def to_s : String
    @router.pattern_text(@index)
  end

  def method : String
    @router.pattern_method(@index)
  end

  def host : String
    @router.pattern_host(@index)
  end

  # Whether *path* - a request path, rooted and clean, still
  # percent-encoded - matches this pattern's path. The method and host
  # are not looked at; a handler is handed the wildcards' values.
  def matches?(path : String) : Bool
    pieces = [] of String
    text = String::Builder.new(path.bytesize)
    return false unless Router.pieces(path, pieces, text)
    @router.match_pieces(@index, pieces, text, Captures.new)
  end

  # How this pattern's requests relate to *other*'s, methods and paths
  # together: `Router::EQUIVALENT`, `MORE_GENERAL`, `MORE_SPECIFIC`,
  # `DISJOINT` or `OVERLAPS`.
  def relation(other : PatternView) : Int32
    @router.relation(@index, same(other))
  end

  def more_specific?(other : PatternView) : Bool
    relation(other) == Router::MORE_SPECIFIC
  end

  # The sentence refusing this pattern beside *other*, nil when the two
  # can be registered together.
  def conflict(other : PatternView) : String?
    @router.conflict(@index, same(other))
  end

  private def same(other : PatternView) : Int32
    raise "Router: two patterns of different routers are not compared" unless other.router.same?(@router)
    other.index
  end
end

# Requests sent to handlers by pattern, Go 1.22's `ServeMux`:
#
#     router = Router.new
#     router.handle("GET /users/{id}") { |req, res, params| res.body << params["id"] }
#     # Files: FileServer.serve(root, req, res) inside a handler.
#     # Build this router inside Handler.new(copied_config), and in
#     # Handler#call(req, res) run @router.call(req, res).
#     Server.answer("0.0.0.0", 3000, config, Handler)
#
# `handle` panics on a pattern that is not one, on one that conflicts with
# a pattern already registered, and after the router has answered a
# request. `call` answers with the most specific pattern's handler, or
# writes a 307 (to the cleaned path, or to a subtree's `/`), a 405 with
# `Allow`, a 400 for a malformed escape, a 404 into *res*.
#
# The router is the one owner of its patterns (SPEC 2.1, 2.2): each
# pattern's text and decoded segments are copied into `@text`, and its
# parts sit in flat arrays, a pattern being an index. A Pattern class per
# route was N owners, each returned from the def that made it.
pub class Router
  # A path segment's kind: a literal, `{name}`, `{name...}` or a trailing
  # slash (with no name), and `{$}`.
  LITERAL = 0
  WILD    = 1
  MULTI   = 2
  ENDS    = 3

  # How the requests one pattern matches relate to another's: the same,
  # a strict superset, a strict subset, none in common, or some in common
  # and some not.
  EQUIVALENT    = 0
  MORE_GENERAL  = 1
  MORE_SPECIFIC = 2
  DISJOINT      = 3
  OVERLAPS      = 4

  # Every pattern's text, method, host and decoded literals and names,
  # each a view of this one builder, which never moves as it grows.
  @text : String::Builder
  @sources : Array(String)
  @methods : Array(String)
  @hosts : Array(String)
  # Per pattern its first segment in @kinds and @names, and their count.
  @firsts : Array(Int32)
  @counts : Array(Int32)
  # Per segment its kind and its text: a literal decoded, a wildcard's
  # name, "" for a trailing slash and for `{$}`.
  @kinds : Array(Int32)
  @names : Array(String)
  # The registered patterns' indexes, and their handlers in that order.
  @routes : Array(Int32)
  @handlers : Array(Proc(Incoming, Outgoing, Hash(String, String), Nil))
  @answering : Bool

  def initialize
    @text = String::Builder.new(4096)
    @sources = [] of String
    @methods = [] of String
    @hosts = [] of String
    @firsts = [] of Int32
    @counts = [] of Int32
    @kinds = [] of Int32
    @names = [] of String
    @routes = [] of Int32
    @handlers = [] of Proc(Incoming, Outgoing, Hash(String, String), Nil)
    @answering = false
  end

  protected def same?(other : Router) : Bool
    object_id == other.object_id
  end

  # *value* copied into @text; the answer views the copy.
  private def keep(value : String) : String
    at = @text.bytesize
    @text << value
    @text.finish[at, value.bytesize]
  end

  def pattern_text(index : Int32) : String
    @sources[index]
  end

  def pattern_method(index : Int32) : String
    @methods[index]
  end

  def pattern_host(index : Int32) : String
    @hosts[index]
  end

  # Sends the requests *pattern* matches to the block, with the request,
  # the answer to write and the wildcards' values by name.
  def handle(pattern : String, &handler : Incoming, Outgoing, Hash(String, String) -> Nil) : Nil
    raise "Router: #{pattern.inspect} is registered after the router answered a request; patterns are registered before it serves" if @answering
    parsed = parse(pattern).or_panic
    @routes.each do |known|
      if sentence = conflict(parsed.index, known)
        raise sentence
      end
    end
    @routes << parsed.index
    @handlers << handler
  end

  # The patterns registered, in the order they were.
  def patterns : Array(PatternView)
    views = Array(PatternView).new(@routes.size)
    @routes.each { |index| views << PatternView.new(self, index) }
    views
  end

  # *text* read as a pattern into this router's storage, not registered,
  # or why it is not one: an invalid method, no `/` to start the path, a
  # `{` in the host, a path a request's cleaned path never equals (`//`,
  # `.`, `..`), a wildcard that is not a whole segment, `{$}` or
  # `{name...}` before the end, a name that is not an identifier or is
  # used twice, a malformed percent escape.
  def parse(text : String) : PatternView | RouterError
    first = @kinds.size
    problem = read_pattern(text)
    if problem
      while @kinds.size > first
        @kinds.pop
        @names.pop
      end
      return problem
    end
    PatternView.new(self, @sources.size - 1)
  end

  private def read_pattern(text : String) : RouterError?
    return Router.refused(text, "it is empty") if text.empty?
    p = text
    n = text.bytesize
    # The method ends at the first space or tab; Go's reading, so a space
    # inside a path is a method that is not one.
    method = ""
    rest = text
    cut = 0
    while cut < n && p[cut] != 32_u8 && p[cut] != 9_u8
      cut = cut + 1
    end
    if cut < n
      method = text[0, cut]
      return Router.refused(text, "#{method.inspect} is not a method") unless HTTP.token?(method)
      start = cut
      while start < n && (p[start] == 32_u8 || p[start] == 9_u8)
        start = start + 1
      end
      rest = text[start, n - start]
    end
    slash = rest.index('/')
    return Router.refused(text, "it has no path, which starts with /") unless slash
    host = rest[0, slash]
    return Router.refused(text, "its host #{host.inspect} holds a { (is the / before it missing?)") if host.includes?("{")
    path = rest[slash, rest.bytesize - slash]
    # A request's path is cleaned before it is matched, so a pattern whose
    # path is not clean could never match one.
    cleaned = Router.clean(path)
    return Router.refused(text, "its path is not clean: a request for it is sent to #{cleaned.inspect}") unless cleaned == path
    first = @kinds.size
    q = path
    size = path.bytesize
    at = 0
    while at < size
      start = at + 1
      if start == size
        @kinds << MULTI
        @names << ""
        break
      end
      stop = start
      while stop < size && q[stop] != 47_u8
        stop = stop + 1
      end
      segment = path[start, stop - start]
      brace = segment.index('{')
      if brace.nil?
        from = @text.bytesize
        return Router.refused(text, "#{segment.inspect} holds a malformed percent escape") unless Router.decode_piece(segment, @text)
        @kinds << LITERAL
        @names << @text.finish[from, @text.bytesize - from]
      else
        return Router.refused(text, "a wildcard is a whole segment, {name}, and #{segment.inspect} is not one") unless brace == 0 && segment.ends_with?("}")
        name = segment[1, segment.bytesize - 2]
        if name == "$"
          return Router.refused(text, "{$} is not at the end") unless stop == size
          @kinds << ENDS
          @names << ""
        else
          multi = name.ends_with?("...")
          name = name[0, name.bytesize - 3] if multi
          return Router.refused(text, "{#{name}...} is not at the end") if multi && stop != size
          return Router.refused(text, "a wildcard has no name") if name.empty?
          return Router.refused(text, "#{name.inspect} is not a wildcard name (a letter or _, then letters, digits and _)") unless Router.identifier?(name)
          k = first
          while k < @kinds.size
            twice = (@kinds[k] == WILD || @kinds[k] == MULTI) && @names[k] == name
            return Router.refused(text, "two wildcards are named #{name.inspect}") if twice
            k = k + 1
          end
          @kinds << (multi ? MULTI : WILD)
          @names << keep(name)
        end
      end
      at = stop
    end
    @sources << keep(text)
    @methods << keep(method)
    @hosts << keep(host)
    @firsts << first
    @counts << @kinds.size - first
    nil
  end

  protected def self.refused(text : String, reason : String) : RouterError
    RouterError.new("#{text.inspect} is not a pattern: #{reason}")
  end

  # A wildcard's name: an ASCII letter or `_`, then letters, digits, `_`.
  def self.identifier?(name : String) : Bool
    p = name
    i = 0
    while i < name.bytesize
      c = p[i]
      letter = (c >= 97_u8 && c <= 122_u8) || (c >= 65_u8 && c <= 90_u8) || c == 95_u8
      return false unless letter || (i > 0 && c >= 48_u8 && c <= 57_u8)
      i = i + 1
    end
    name.bytesize > 0
  end

  private def kind(index : Int32, at : Int32) : Int32
    @kinds[@firsts[index] + at]
  end

  private def name(index : Int32, at : Int32) : String
    @names[@firsts[index] + at]
  end

  private def last_multi?(index : Int32) : Bool
    kind(index, @counts[index] - 1) == MULTI
  end

  # Whether a request of *method* is one pattern *index*'s method takes.
  def matches_method?(index : Int32, method : String) : Bool
    mine = @methods[index]
    mine.empty? || mine == method || (mine == "GET" && method == "HEAD")
  end

  # *path*'s segments after its first `/`, each percent-decoded, appended
  # to *into* as views of *text*: `/` is one empty piece, and a trailing
  # slash is a last empty one. False for a path that is not rooted or
  # holds a malformed escape. Decoded a segment at a time, so `%2F` is
  # inside a segment, never between two.
  def self.pieces(path : String, into : Array(String), text : String::Builder) : Bool
    return false unless path.starts_with?("/")
    path[1, path.bytesize - 1].split('/').each do |segment|
      from = text.bytesize
      return false unless Router.decode_piece(segment, text)
      into << text.finish[from, text.bytesize - from]
      nil
    end
    true
  end

  # `pieces`, or the one empty piece when *path* has none: what a request
  # is matched on.
  protected def self.pieces_or_root(path : String, into : Array(String), text : String::Builder) : Nil
    return if pieces(path, into, text)
    into.clear
    into << ""
  end

  # Whether pattern *index* matches a path already cut into `pieces`; its
  # wildcards' values are added to *found* (cleared first). A trailing
  # wildcard's value is joined into *text*; the others view *pieces*.
  def match_pieces(index : Int32, pieces : Array(String), text : String::Builder, found : Captures) : Bool
    found.clear
    count = @counts[index]
    i = 0
    j = 0
    while i < count
      kind = kind(index, i)
      if kind == MULTI
        # The rest, slashes and all, nothing included - but not past the
        # end: `/x/` does not match `/x`.
        return false if j >= pieces.size
        name = name(index, i)
        from = text.bytesize
        k = j
        while k < pieces.size
          text << "/" if k > j
          text << pieces[k]
          k += 1
        end
        found.add(name.as_tape, text.finish[from, text.bytesize - from]) unless name.empty?
        return true
      end
      return false if j >= pieces.size
      piece = pieces[j]
      if kind == ENDS
        return false unless piece.empty? && j == pieces.size - 1
      elsif kind == WILD
        return false if piece.empty?
        found.add(name(index, i).as_tape, piece)
      else
        return false unless piece == name(index, i)
      end
      i = i + 1
      j = j + 1
    end
    j == pieces.size
  end

  private def self.hex_value(byte : UInt8) : Int32
    return byte.to_i32 - 48 if byte >= 48_u8 && byte <= 57_u8
    return byte.to_i32 - 87 if byte >= 97_u8 && byte <= 102_u8
    return byte.to_i32 - 55 if byte >= 65_u8 && byte <= 70_u8
    -1
  end

  # *text* percent-decoded into *w*; false at a malformed escape.
  protected def self.decode_piece(text : String, w : String::Builder) : Bool
    i = 0
    while i < text.bytesize
      if text[i] == 37_u8
        return false if i + 2 >= text.bytesize
        hi = hex_value(text[i + 1])
        lo = hex_value(text[i + 2])
        return false if hi < 0 || lo < 0
        w.push((hi * 16 + lo).to_u8)
        i += 3
      else
        w << text[i, 1]
        i += 1
      end
    end
    true
  end

  # Whether pattern *index* matched *pieces* without its trailing
  # wildcard taking anything: `/x/` on `/x/`, not on `/x/y`. What decides
  # whether `/x` is redirected to `/x/`.
  def exact?(index : Int32, pieces : Array(String)) : Bool
    return true unless last_multi?(index)
    pieces.size == @counts[index] && pieces.last.empty?
  end

  # How pattern *mine*'s requests relate to pattern *theirs*'s, methods
  # and paths together; hosts are not compared.
  def relation(mine : Int32, theirs : Int32) : Int32
    methods = compare_methods(mine, theirs)
    return DISJOINT if methods == DISJOINT
    Router.combine(methods, compare_paths(mine, theirs))
  end

  # The sentence refusing pattern *mine* beside *theirs*, nil when the two
  # can be registered together: when they have the same host and match
  # the same requests, or some requests in common with neither more
  # specific. It names both and a request both match.
  def conflict(mine : Int32, theirs : Int32) : String?
    return nil unless @hosts[mine] == @hosts[theirs]
    methods = compare_methods(mine, theirs)
    return nil if methods == DISJOINT
    paths = compare_paths(mine, theirs)
    rel = Router.combine(methods, paths)
    return nil unless rel == EQUIVALENT || rel == OVERLAPS
    head = "Router: #{@sources[mine].inspect} conflicts with #{@sources[theirs].inspect}"
    return head + ": both match the same requests" if rel == EQUIVALENT
    verb = @methods[mine]
    verb = @methods[theirs] if verb.empty? || (verb == "GET" && !@methods[theirs].empty?)
    request = (verb.empty? ? "" : verb + " ") + common_path(mine, theirs).inspect
    if paths == OVERLAPS
      head + ": both match #{request}, and neither is more specific than the other"
    elsif methods == MORE_GENERAL
      head + ": it matches more methods but a more specific path, and both match #{request}"
    else
      head + ": it matches fewer methods but a more general path, and both match #{request}"
    end
  end

  private def compare_methods(mine : Int32, theirs : Int32) : Int32
    a = @methods[mine]
    b = @methods[theirs]
    return EQUIVALENT if a == b
    return MORE_GENERAL if a.empty?
    return MORE_SPECIFIC if b.empty?
    return MORE_GENERAL if a == "GET" && b == "HEAD"
    return MORE_SPECIFIC if a == "HEAD" && b == "GET"
    DISJOINT
  end

  private def compare_paths(mine : Int32, theirs : Int32) : Int32
    size = @counts[mine]
    their_size = @counts[theirs]
    mine_multi = last_multi?(mine)
    theirs_multi = last_multi?(theirs)
    # Without a trailing wildcard a path matches only paths of its own
    # number of segments.
    return DISJOINT if size != their_size && !mine_multi && !theirs_multi
    rel = EQUIVALENT
    shared = size < their_size ? size : their_size
    i = 0
    while i < shared
      rel = Router.combine(rel, compare_segments(kind(mine, i), name(mine, i), kind(theirs, i), name(theirs, i)))
      return rel if rel == DISJOINT
      i = i + 1
    end
    return rel if size == their_size
    # The shorter can still match the longer's paths if it ends in a
    # wildcard that takes the rest.
    return Router.combine(rel, MORE_GENERAL) if size < their_size && mine_multi
    return Router.combine(rel, MORE_SPECIFIC) if their_size < size && theirs_multi
    DISJOINT
  end

  # One segment beside the one at the same place in another pattern.
  private def compare_segments(kind : Int32, name : String, their_kind : Int32, their_name : String) : Int32
    return EQUIVALENT if kind == MULTI && their_kind == MULTI
    return MORE_GENERAL if kind == MULTI
    return MORE_SPECIFIC if their_kind == MULTI
    return EQUIVALENT if kind == WILD && their_kind == WILD
    # `{x}` never matches the end that `{$}` matches: a segment is not empty.
    return (their_kind == ENDS ? DISJOINT : MORE_GENERAL) if kind == WILD
    return (kind == ENDS ? DISJOINT : MORE_SPECIFIC) if their_kind == WILD
    kind == their_kind && name == their_name ? EQUIVALENT : DISJOINT
  end

  # Two relations of parts (methods, then each segment) as the relation
  # of the whole: a superset in one part and a subset in another is
  # neither, an overlap.
  def self.combine(first : Int32, second : Int32) : Int32
    case first
    when EQUIVALENT
      second
    when DISJOINT
      DISJOINT
    when OVERLAPS
      second == DISJOINT ? DISJOINT : OVERLAPS
    else
      return first if second == EQUIVALENT
      inverse = first == MORE_GENERAL ? MORE_SPECIFIC : MORE_GENERAL
      second == inverse ? OVERLAPS : second
    end
  end

  # A path both patterns match, for the sentence that refuses them: each
  # segment the literal of whichever has one, else a wildcard by its name
  # (a trailing wildcard taking nothing), and what the longer has left
  # after the shorter's trailing wildcard.
  private def common_path(mine : Int32, theirs : Int32) : String
    size = @counts[mine]
    their_size = @counts[theirs]
    text = String::Builder.new
    i = 0
    while i < size && i < their_size
      k = kind(mine, i)
      if k == MULTI || (k == WILD && kind(theirs, i) != MULTI)
        write_segment(text, kind(theirs, i), name(theirs, i))
      else
        write_segment(text, k, name(mine, i))
      end
      i = i + 1
    end
    while i < size
      write_segment(text, kind(mine, i), name(mine, i))
      i = i + 1
    end
    while i < their_size
      write_segment(text, kind(theirs, i), name(theirs, i))
      i = i + 1
    end
    text.to_s
  end

  private def write_segment(text : String::Builder, kind : Int32, name : String) : Nil
    text << "/"
    text << name if kind == LITERAL || kind == WILD
  end

  # The answer to *req*, written into *res*: its handler's, or the
  # router's own 307, 400, 404 or 405.
  def call(req : Incoming, res : Outgoing) : Nil
    @answering = true
    raw = req.path
    return Router.plain(res, 404, "not found\n") unless raw.starts_with?("/")
    return Router.plain(res, 400, "bad request\n") unless URI.decode?(raw)
    path = Router.clean(raw)
    host = Router.host_of(req.header("Host") || "")
    piece_text = String::Builder.new(path.bytesize * 2 + 2)
    pieces = [] of String
    Router.pieces_or_root(path, pieces, piece_text)
    captures = Captures.new
    found = find(host, req.method, pieces, piece_text, captures)
    # `/x` where only `/x/`'s subtree would take it - or nothing would -
    # is sent to `/x/` when `/x/` itself is a request a pattern matches
    # exactly.
    exact = found >= 0 ? exact?(@routes[found], pieces) : false
    unless exact || path.ends_with?("/")
      slashed = [] of String
      Router.pieces_or_root(path + "/", slashed, piece_text)
      again = find(host, req.method, slashed, piece_text, Captures.new)
      if again >= 0 && exact?(@routes[again], slashed)
        return Router.redirect(res, path + "/", req.query)
      end
    end
    return Router.redirect(res, path, req.query) unless path == raw
    if found >= 0
      @handlers[found].call(req, res, captures.to_h)
      return
    end
    allowed = allowed(host, path, pieces, piece_text)
    unless allowed.empty?
      res.status = 405
      res.header("Allow", allowed.join(", "))
      res.header("Content-Type", "text/plain; charset=utf-8")
      res.body << "method not allowed\n"
      return
    end
    Router.plain(res, 404, "not found\n")
  end

  # The route that takes the request, its index in @routes or -1, its
  # wildcards in *found*: of the host's own patterns if one matches, else
  # of those with no host, the one more specific than every other that
  # matches.
  private def find(host : String, method : String, pieces : Array(String), text : String::Builder, found : Captures) : Int32
    unless host.empty?
      chosen = best(host, method, pieces, text, found)
      return chosen if chosen >= 0
    end
    best("", method, pieces, text, found)
  end

  private def best(host : String, method : String, pieces : Array(String), text : String::Builder, found : Captures) : Int32
    chosen = -1
    i = 0
    while i < @routes.size
      pattern = @routes[i]
      # Of two that match, one is more specific: registration refused
      # every pair for which that is not so.
      if @hosts[pattern] == host && matches_method?(pattern, method) && (chosen < 0 || relation(pattern, @routes[chosen]) == MORE_SPECIFIC)
        chosen = i if match_pieces(pattern, pieces, text, found)
      end
      i = i + 1
    end
    match_pieces(@routes[chosen], pieces, text, found) if chosen >= 0
    chosen
  end

  # The methods of the patterns whose host and path match, sorted, with
  # `HEAD` where `GET` is: the 405's `Allow`. As Go's, the path with a
  # slash added counts too - the request the redirect above would have
  # been, had the method matched - so `POST /x` beside `GET /x/` is 405
  # rather than 404.
  private def allowed(host : String, path : String, pieces : Array(String), piece_text : String::Builder) : Array(String)
    slashed = [] of String
    with_slash = !path.ends_with?("/") && Router.pieces(path + "/", slashed, piece_text)
    methods = [] of String
    scratch = Captures.new
    @routes.each do |pattern|
      method = @methods[pattern]
      next if method.empty? || methods.includes?(method)
      next unless @hosts[pattern].empty? || @hosts[pattern] == host
      if match_pieces(pattern, pieces, piece_text, scratch) || (with_slash && match_pieces(pattern, slashed, piece_text, scratch))
        methods << method
      end
    end
    methods << "HEAD" if methods.includes?("GET") && !methods.includes?("HEAD")
    methods.sorted
  end

  # *path* - rooted - with `.` and empty segments dropped and `..` taking
  # the one before it off, its trailing slash kept: Go's `cleanPath`.

  def self.clean(path : String) : String
    String.build { |w| clean(path, w) }
  end

  def self.clean(path : String,
                 writer : String::Builder) : Nil
    kept = Array(String).new
    path.split('/').each do |segment|
      if segment == ".."
        kept.pop?
      elsif !segment.empty? && segment != "."
        kept << segment
      end
    end
    writer << "/"
    kept.join(writer, "/")
    writer << "/" if path.bytesize > 0 && path[path.bytesize - 1] == 47_u8 &&
                     !kept.empty?
    nil
  end

  # A `Host` value without its port, as Go's `stripHostPort` has it: an
  # IPv6 address in brackets loses the brackets with the port.
  def self.host_of(value : String) : String
    if value.starts_with?("[")
      close = value.index(']')
      return value unless close && close + 1 < value.bytesize && value[close + 1] == 58_u8
      return value[1, close - 1]
    end
    colon = value.index(':')
    return value unless colon
    rest = value[colon + 1, value.bytesize - colon - 1]
    rest.index(':') ? value : value[0, colon]
  end

  # A 307 to *path* and *query*, written into *res*.
  def self.redirect(res : Outgoing, path : String, query : String?) : Nil
    res.status = 307
    res.header("Location") do |w|
      w << path
      if (q = query) && !q.empty?
        w << "?" << q
      end
    end
  end

  # *status* with *text* as a plain body, written into *res*.
  def self.plain(res : Outgoing, status : Int32, text : String) : Nil
    res.status = status
    res.header("Content-Type", "text/plain; charset=utf-8")
    res.body << text
  end
end

spec 8.1  # A std module follows the standard its header names (an RFC, a file…


  kept = ""
  path = "/a//b/../c/./"
  w = String::Builder.new(1)
  w << "prefix:"
  Router.clean(path, w)
  w.finish == "prefix:/a/c/"
  kept = Router.clean(path).copy_to(Program.tape)
  Router.clean("/../../") == "/"
  Router.clean("café/../ok") == "/ok"
  kept == "/a/c/"
  Router.clean("/a//b/../c/./") == kept
  router = Router.new
  view = router.parse("GET /users/{id}").or_panic
  view.method == "GET" && view.host == ""
  view.matches?("/users/42") && !view.matches?("/users/")
  router.pattern_text(view.index) == "GET /users/{id}"
  router.pattern_method(view.index) == "GET"
  router.pattern_host(view.index) == ""
  caps = Captures.new
  caps.add("id", "42")
  caps["id"] == "42"
  caps.clear
  caps.entries.empty?
end
