# HTTP Datagrams and the Capsule Protocol — RFC 9297, RFC 8441, RFC 9220, RFC 9000.
#
# Answers the protocol architecture requirements:
#
# 1. QUIC Variable-Length Integer Encoding (RFC 9000 Section 16 & Appendix A):
#    A 2-bit-prefix variable-length integer encoding scheme supporting 1, 2, 4,
#    or 8 byte representations for values up to 2^62 - 1 (4,611,686,018,427,387,903).
#    Exported as `VarInt` so wave two's HTTP/3 and QUIC implementations can reuse
#    this exact encoding rather than writing a second one.
#    Supports canonical minimum-byte encoding, explicit-length multi-byte encoding
#    (as tested in RFC 9000 Appendix A), and strict decoding that rejects overlong
#    encodings and reserved/out-of-range values.
#
# 2. HTTP Datagrams (RFC 9297 Section 2):
#    Quarter Stream IDs map datagrams to HTTP/3 request streams:
#      quarter_stream_id = stream_id // 4
#      stream_id = quarter_stream_id * 4
#    A stream ID is at most 2^62 - 1, so a Quarter Stream ID is at most
#    2^60 - 1 (Section 2.1); a larger one is refused, not carried.
#    Provides `HttpDatagram` with encoding and decoding over byte slices.
#
# 3. The Capsule Protocol (RFC 9297 Section 3):
#    Framing for datagrams and control messages on reliable streams.
#    Each capsule consists of:
#      Capsule Type (i)
#      Capsule Length (i)
#      Capsule Value (..)
#    Follows RFC 9297 Section 3.2 extensibility rule: unknown capsule types
#    MUST be skipped rather than erroring.
#    Refuses truncated capsules, lengths that overrun buffer boundaries,
#    and invalid varint encodings.
#
# 4. Extended CONNECT (RFC 8441 and RFC 9220):
#    Protocol negotiation via `:protocol` pseudo-header and the
#    SETTINGS_ENABLE_CONNECT_PROTOCOL (0x08) setting for HTTP/2 and HTTP/3.
#
# 5. Capsule-Protocol Header (RFC 9297 Section 3.3):
#    Item Structured Field `Capsule-Protocol: ?1` enabling capsule framing.

@[NoSpec("std API predates spec-required; proofs follow")]
module std/capsule

import std/slice::{Slice, Bytes}

# =============================================================================
# 1. QUIC Variable-Length Integer Encoding (RFC 9000 Section 16 & Appendix A)
# =============================================================================

pub struct VarInt
  # Maximum value representable in a QUIC 62-bit variable-length integer: 2^62 - 1.
  pub MAX = 4611686018427387903_u64

  # Upper bounds for canonical N-byte representations.
  pub MAX_1BYTE =                  63_u64
  pub MAX_2BYTE =               16383_u64
  pub MAX_4BYTE =          1073741823_u64
  pub MAX_8BYTE = 4611686018427387903_u64

  # Checks if value can be represented as a 62-bit QUIC varint.
  def self.valid_value?(value : UInt64) : Bool
    value <= MAX
  end

  # Calculates the minimum number of bytes required to canonically encode value.
  def self.encoded_size(value : UInt64) : Int32
    if value <= MAX_1BYTE
      1
    elsif value <= MAX_2BYTE
      2
    elsif value <= MAX_4BYTE
      4
    elsif value <= MAX_8BYTE
      8
    else
      raise "varint value exceeds maximum 62-bit integer (2^62 - 1): #{value}"
    end
  end

  # Encodes value into its canonical (minimum-length) QUIC varint representation.
  def self.encode(value : UInt64) : Bytes
    encode(value, encoded_size(value))
  end

  # Encodes value using an explicit length (1, 2, 4, or 8 bytes).
  # Used to produce canonical encodings or explicit multi-byte encodings as
  # specified in RFC 9000 Appendix A (e.g. 37 encoded in 2, 4, or 8 bytes).
  def self.encode(value : UInt64, length : Int32) : Bytes
    # One call, so the bytes are made in the caller's destination.
    Bytes.new(checked(value, length)) { |i| byte(value, length, i) }
  end

  # *length*, once it is one a varint has and *value* fits in it.
  private def self.checked(value : UInt64, length : Int32) : Int32
    unless length == 1 || length == 2 || length == 4 || length == 8
      raise "invalid varint encoding length: #{length} (must be 1, 2, 4, or 8)"
    end
    if value > MAX
      raise "varint value exceeds maximum 62-bit integer (2^62 - 1): #{value}"
    end
    if length == 1 && value > MAX_1BYTE
      raise "value #{value} does not fit in 1-byte varint"
    end
    if length == 2 && value > MAX_2BYTE
      raise "value #{value} does not fit in 2-byte varint"
    end
    if length == 4 && value > MAX_4BYTE
      raise "value #{value} does not fit in 4-byte varint"
    end
    length
  end

  # Byte *i* of *value*'s varint of *length* bytes: big-endian, the two
  # high bits of the first naming the length.
  protected def self.byte(value : UInt64, length : Int32, i : Int32) : UInt8
    shift = ((length - 1 - i) * 8).to_u64
    b = (value.unsafe_shr(shift) & 0xff_u64).to_u8
    return b unless i == 0
    prefix = length == 1 ? 0x00_u8 : (length == 2 ? 0x40_u8 : (length == 4 ? 0x80_u8 : 0xc0_u8))
    prefix | (b & 0x3f_u8)
  end

  # Decodes a QUIC variable-length integer, returning nil if truncated, overlong, or reserved.
  def self.decode?(bytes : Bytes, offset : Int32 = 0, strict : Bool = false) : {UInt64, Int32}?
    return nil if offset < 0 || offset >= bytes.size
    # The room left is measured as `size - offset`, which cannot overflow;
    # `offset + 8` did, and panicked, for an offset within 8 of 2^31 - 1.
    room = bytes.size - offset

    b0 = bytes[offset]
    prefix = (b0.to_i32 >> 6) & 0x03

    if prefix == 0_u8
      val = (b0 & 0x3f_u8).to_u64
      {val, 1}
    elsif prefix == 1_u8
      return nil if room < 2
      val = (b0 & 0x3f_u8).to_u64.unsafe_shl(8_u64) | bytes[offset + 1].to_u64
      return nil if strict && val <= MAX_1BYTE
      {val, 2}
    elsif prefix == 2_u8
      return nil if room < 4
      val = (b0 & 0x3f_u8).to_u64.unsafe_shl(24_u64) |
            bytes[offset + 1].to_u64.unsafe_shl(16_u64) |
            bytes[offset + 2].to_u64.unsafe_shl(8_u64) |
            bytes[offset + 3].to_u64
      return nil if strict && val <= MAX_2BYTE
      {val, 4}
    else # prefix == 3_u8
      return nil if room < 8
      val = (b0 & 0x3f_u8).to_u64.unsafe_shl(56_u64) |
            bytes[offset + 1].to_u64.unsafe_shl(48_u64) |
            bytes[offset + 2].to_u64.unsafe_shl(40_u64) |
            bytes[offset + 3].to_u64.unsafe_shl(32_u64) |
            bytes[offset + 4].to_u64.unsafe_shl(24_u64) |
            bytes[offset + 5].to_u64.unsafe_shl(16_u64) |
            bytes[offset + 6].to_u64.unsafe_shl(8_u64) |
            bytes[offset + 7].to_u64
      return nil if strict && val <= MAX_4BYTE
      return nil if val > MAX
      {val, 8}
    end
  end

  # Decodes a QUIC variable-length integer from *bytes* starting at *offset*.
  # Raises on truncated buffers, reserved values, or overlong encodings (if strict).
  def self.decode(bytes : Bytes, offset : Int32 = 0, strict : Bool = false) : {UInt64, Int32}
    res = decode?(bytes, offset, strict: strict)
    if res.nil?
      if offset < 0 || offset >= bytes.size
        raise "varint truncated: buffer empty or offset beyond end"
      end
      b0 = bytes[offset]
      prefix = (b0.to_i32 >> 6) & 0x03
      req = prefix == 0 ? 1 : (prefix == 1 ? 2 : (prefix == 2 ? 4 : 8))
      avail = bytes.size - offset
      if avail < req
        raise "varint truncated: #{req}-byte varint requires #{req} bytes, but only #{avail} available"
      end
      raise "overlong varint encoding: value encoded in non-minimal bytes"
    end
    res
  end

  # Strict decoding shorthand: refuses overlong and reserved encodings.
  def self.decode_strict(bytes : Bytes, offset : Int32 = 0) : {UInt64, Int32}
    decode(bytes, offset, strict: true)
  end

  def self.decode_strict?(bytes : Bytes, offset : Int32 = 0) : {UInt64, Int32}?
    decode?(bytes, offset, strict: true)
  end
end

# =============================================================================
# 2. HTTP Datagrams (RFC 9297 Section 2)
# =============================================================================

@[OnTape]
pub struct HttpDatagram
  # The largest legal Quarter Stream ID (RFC 9297 Section 2.1): the largest
  # stream ID, 2^62 - 1, divided by four.
  pub MAX_QUARTER_STREAM_ID = 1152921504606846975_u64

  @quarter_stream_id : UInt64
  @payload : Bytes

  def initialize(@quarter_stream_id : UInt64, @payload : Bytes)
    if @quarter_stream_id > MAX_QUARTER_STREAM_ID
      raise "http datagram quarter stream id exceeds maximum 2^60 - 1: #{@quarter_stream_id}"
    end
  end

  getter quarter_stream_id : UInt64
  getter payload : Bytes

  # Maps the quarter stream ID back to the associated HTTP/3 stream ID.
  # Stream ID = Quarter Stream ID * 4.
  def stream_id : UInt64
    @quarter_stream_id * 4_u64
  end

  # Creates an HTTP Datagram associated with the given HTTP/3 stream ID,
  # which is a client-initiated bidirectional stream: RFC 9297 Section 2.1
  # associates a datagram with no other kind, and that is why the division
  # by four always comes out even. Any other stream ID is refused. It was
  # divided down instead, so `from_stream_id(19_u64, payload)` was a
  # datagram for stream 16 - another request's - and `stream_id` answered
  # 16. A stream ID past 2^62 - 1 is left to `new`, whose sentence names
  # the quarter it would be.
  def self.from_stream_id(stream_id : UInt64, payload : Bytes) : self
    quarter = stream_id // 4_u64
    if quarter <= MAX_QUARTER_STREAM_ID && (stream_id & 3_u64) != 0_u64
      raise "http datagram stream id #{stream_id} is not a client-initiated bidirectional stream (RFC 9297 Section 2.1)"
    end
    new(quarter, payload)
  end

  # Encodes this datagram into the wire format:
  #   Quarter Stream ID (i)
  #   HTTP Datagram Payload (..)
  def encode : Bytes
    # One call, so the bytes are made in the caller's destination.
    Bytes.new(VarInt.encoded_size(@quarter_stream_id) + @payload.size) { |i|
      encoded_byte(i)
    }
  end

  private def encoded_byte(i : Int32) : UInt8
    head = VarInt.encoded_size(@quarter_stream_id)
    i < head ? VarInt.byte(@quarter_stream_id, head, i) : @payload[i - head]
  end

  # Decodes an HTTP Datagram from a byte slice.
  # Decodes an HTTP Datagram, returning nil if truncated or if the Quarter
  # Stream ID is past 2^60 - 1, which RFC 9297 Section 2.1 makes an error.
  def self.decode?(bytes : Bytes, offset : Int32 = 0, strict : Bool = false) : {HttpDatagram, Int32}?
    return nil if offset < 0 || offset >= bytes.size

    q_res = VarInt.decode?(bytes, offset, strict: strict)
    return nil if q_res.nil?
    qid, qid_len = q_res
    return nil if qid > MAX_QUARTER_STREAM_ID

    payload_offset = offset + qid_len
    payload_size = bytes.size - payload_offset
    return nil if payload_size < 0

    # capsule.8: the payload views the input, nothing copied.
    {new(qid, bytes[payload_offset, payload_size]), bytes.size - offset}
  end

  # Decodes an HTTP Datagram from a byte slice, raising on truncation or on
  # a Quarter Stream ID past 2^60 - 1.
  # Overlong quarter-stream IDs in strict mode raise the varint overlong
  # sentence rather than pretending the buffer was truncated.
  def self.decode(bytes : Bytes, offset : Int32 = 0, strict : Bool = false) : {HttpDatagram, Int32}
    res = decode?(bytes, offset, strict: false)
    if res.nil?
      q_res = VarInt.decode?(bytes, offset)
      if !q_res.nil? && q_res[0] > MAX_QUARTER_STREAM_ID
        raise "http datagram quarter stream id exceeds maximum 2^60 - 1: #{q_res[0]}"
      end
      raise "http datagram truncated: buffer empty or ends before payload"
    end
    if strict
      strict_res = decode?(bytes, offset, strict: true)
      if strict_res.nil?
        raise "overlong varint encoding: value encoded in non-minimal bytes"
      end
      return strict_res
    end
    res
  end
end

# =============================================================================
# 3. The Capsule Protocol (RFC 9297 Section 3)
# =============================================================================

# Standard and extended capsule types.
pub struct CapsuleType
  pub DATAGRAM                   =   0x00_u64
  pub CLOSE_WEBTRANSPORT_SESSION = 0x2843_u64
  pub DRAIN_WEBTRANSPORT_SESSION = 0x78ae_u64
end

@[OnTape]
pub struct Capsule
  @capsule_type : UInt64
  @value : Bytes

  def initialize(@capsule_type : UInt64, @value : Bytes)
  end

  getter capsule_type : UInt64
  getter value : Bytes

  def datagram? : Bool
    @capsule_type == CapsuleType::DATAGRAM
  end

  def close_webtransport_session? : Bool
    @capsule_type == CapsuleType::CLOSE_WEBTRANSPORT_SESSION
  end

  def drain_webtransport_session? : Bool
    @capsule_type == CapsuleType::DRAIN_WEBTRANSPORT_SESSION
  end

  # Returns true if this capsule type is unrecognized by base specifications.
  def unknown? : Bool
    !datagram? && !close_webtransport_session? && !drain_webtransport_session?
  end

  # Encodes the capsule to stream wire format:
  #   Capsule Type (i)
  #   Capsule Length (i)
  #   Capsule Value (..)
  def encode : Bytes
    # One call, so the bytes are made in the caller's destination.
    Bytes.new(VarInt.encoded_size(@capsule_type) +
              VarInt.encoded_size(@value.size.to_u64) + @value.size) { |i|
      encoded_byte(i)
    }
  end

  private def encoded_byte(i : Int32) : UInt8
    type = @capsule_type
    size = @value.size.to_u64
    type_end = VarInt.encoded_size(type)
    head = type_end + VarInt.encoded_size(size)
    if i < type_end
      VarInt.byte(type, type_end, i)
    elsif i < head
      VarInt.byte(size, head - type_end, i - type_end)
    else
      @value[i - head]
    end
  end

  # Decodes a single capsule from bytes starting at offset.
  # Returns {Capsule, total_bytes_consumed}.
  # Refuses truncated capsules or lengths that overrun the buffer.
  # Decodes a single capsule, returning nil if truncated or length overruns buffer.
  def self.decode?(bytes : Bytes, offset : Int32 = 0, strict : Bool = false) : {Capsule, Int32}?
    return nil if offset < 0 || offset >= bytes.size

    t_res = VarInt.decode?(bytes, offset, strict: strict)
    return nil if t_res.nil?
    capsule_type, type_len = t_res

    len_offset = offset + type_len
    return nil if len_offset >= bytes.size

    l_res = VarInt.decode?(bytes, len_offset, strict: strict)
    return nil if l_res.nil?
    capsule_len_u64, len_len = l_res

    hdr_len = type_len + len_len
    val_offset = offset + hdr_len
    remaining = bytes.size - val_offset

    return nil if capsule_len_u64 > remaining.to_u64

    capsule_len = capsule_len_u64.to_i32
    # capsule.8: the value views the input, nothing copied.
    val = bytes[val_offset, capsule_len]

    {new(capsule_type, val), hdr_len + capsule_len}
  end

  # Decodes a single capsule from bytes starting at offset, raising on error.
  def self.decode(bytes : Bytes, offset : Int32 = 0, strict : Bool = false) : {Capsule, Int32}
    if offset < 0 || offset >= bytes.size
      raise "truncated capsule: buffer empty or offset beyond end"
    end

    capsule_type, type_len = VarInt.decode(bytes, offset, strict: strict)
    len_offset = offset + type_len

    if len_offset >= bytes.size
      raise "truncated capsule: buffer ends before capsule length"
    end

    capsule_len_u64, len_len = VarInt.decode(bytes, len_offset, strict: strict)
    hdr_len = type_len + len_len
    val_offset = offset + hdr_len
    remaining = bytes.size - val_offset

    if capsule_len_u64 > remaining.to_u64
      raise "capsule length overruns buffer: length #{capsule_len_u64} exceeds remaining #{remaining} bytes"
    end

    capsule_len = capsule_len_u64.to_i32
    # capsule.8: the value views the input, nothing copied.
    val = bytes[val_offset, capsule_len]

    {new(capsule_type, val), hdr_len + capsule_len}
  end
end

# Capsule stream processing enforcing RFC 9297 Section 3.2 rules:
# - Unknown capsule types are skipped rather than erroring (extensibility).
# - Truncated capsules and length overruns are strictly refused.
pub struct CapsuleReader
  # Decodes all capsules in buffer into an array.
  # Preserves unknown capsules in the list for inspection.
  def self.read_all(bytes : Bytes, strict : Bool = false) : Array(Capsule)
    capsules = [] of Capsule
    offset = 0
    while offset < bytes.size
      capsule, consumed = Capsule.decode(bytes, offset, strict: strict)
      capsules << capsule
      offset = offset + consumed
    end
    capsules
  end

  # Decodes capsules from stream buffer, actively skipping unknown types
  # and returning only recognized capsules, demonstrating RFC 9297 extensibility.
  def self.read_known(bytes : Bytes, strict : Bool = false) : Array(Capsule)
    capsules = [] of Capsule
    offset = 0
    while offset < bytes.size
      capsule, consumed = Capsule.decode(bytes, offset, strict: strict)
      unless capsule.unknown?
        capsules << capsule
      end
      offset = offset + consumed
    end
    capsules
  end

  # Appends the known capsules to *capsules* and answers how many unknown
  # ones it skipped.
  def self.read_with_skip_count(bytes : Bytes, capsules : Array(Capsule),
                                strict : Bool = false) : Int32
    skipped = 0
    offset = 0
    while offset < bytes.size
      capsule, consumed = Capsule.decode(bytes, offset, strict: strict)
      if capsule.unknown?
        skipped = skipped + 1
      else
        capsules << capsule
      end
      offset = offset + consumed
    end
    skipped
  end
end

# =============================================================================
# 4. Extended CONNECT (RFC 8441 & RFC 9220)
# =============================================================================

pub struct ExtendedConnect
  # Setting identifier enabling Extended CONNECT protocol negotiation.
  pub SETTINGS_ENABLE_CONNECT_PROTOCOL = 0x08_u64

  def self.settings_id : UInt64
    SETTINGS_ENABLE_CONNECT_PROTOCOL
  end

  pub HEADER_METHOD    = ":method"
  pub HEADER_PROTOCOL  = ":protocol"
  pub HEADER_SCHEME    = ":scheme"
  pub HEADER_AUTHORITY = ":authority"
  pub HEADER_PATH      = ":path"
  pub HEADER_STATUS    = ":status"

  pub METHOD_CONNECT = "CONNECT"

  pub PROTOCOL_WEBTRANSPORT = "webtransport"
  pub PROTOCOL_WEBSOCKET    = "websocket"

  # Validates whether the given parameters form a valid Extended CONNECT request.
  def self.valid_request?(method : String, protocol : String?, scheme : String?, authority : String?, path : String?) : Bool
    return false unless method == METHOD_CONNECT
    return false if protocol.nil? || protocol.empty?
    return false if scheme.nil? || scheme.empty?
    return false if authority.nil? || authority.empty?
    return false if path.nil? || path.empty?
    true
  end

  # Validates whether a response status code establishes the Extended CONNECT tunnel (2xx).
  def self.valid_response?(status : Int32) : Bool
    status >= 200 && status < 300
  end
end

# =============================================================================
# 5. Capsule-Protocol Header (RFC 9297 Section 3.3)
# =============================================================================

pub struct CapsuleProtocol
  pub HEADER_NAME  = "Capsule-Protocol"
  pub HEADER_VALUE = "?1"

  def self.header_name : String
    HEADER_NAME
  end

  def self.header_value : String
    HEADER_VALUE
  end

  # Checks if a header key-value pair enables the Capsule Protocol.
  def self.valid_header?(name : String, value : String) : Bool
    name.downcase == "capsule-protocol" && is_capsule_protocol_header?(value)
  end

  # True when the value, parsed as an Item Structured Field (RFC 8941
  # Section 4.2), is the Boolean true. Its parameters are parsed and then
  # ignored, as RFC 9297 Section 3.4 requires of unknown ones; a value that
  # does not parse as an Item is as if the field were absent.
  def self.is_capsule_protocol_header?(value : String) : Bool
    p = value
    n = value.bytesize
    i = skip_spaces(p, 0, n)
    return false unless i + 2 <= n && p[i] == 63_u8 && p[i + 1] == 49_u8
    i = i + 2
    while i < n && p[i] == 59_u8
      i = skip_spaces(p, i + 1, n)
      return false unless i < n && (lcalpha?(p[i]) || p[i] == 42_u8)
      i = i + 1
      while i < n && (lcalpha?(p[i]) || digit?(p[i]) || p[i] == 95_u8 || p[i] == 45_u8 || p[i] == 46_u8 || p[i] == 42_u8)
        i = i + 1
      end
      if i < n && p[i] == 61_u8
        i = bare_item_end(p, i + 1, n)
        return false if i < 0
      end
    end
    skip_spaces(p, i, n) == n
  end

  private def self.skip_spaces(p : String, i : Int32, n : Int32) : Int32
    while i < n && p[i] == 32_u8
      i = i + 1
    end
    i
  end

  private def self.lcalpha?(b : UInt8) : Bool
    b >= 97_u8 && b <= 122_u8
  end

  private def self.alpha?(b : UInt8) : Bool
    lcalpha?(b) || (b >= 65_u8 && b <= 90_u8)
  end

  private def self.digit?(b : UInt8) : Bool
    b >= 48_u8 && b <= 57_u8
  end

  # tchar (RFC 9110 Section 5.6.2) and the ":" and "/" a token may also hold.
  private def self.token_char?(b : UInt8) : Bool
    return true if alpha?(b) || digit?(b)
    case b
    when 33_u8, 35_u8, 36_u8, 37_u8, 38_u8, 39_u8, 42_u8, 43_u8, 45_u8, 46_u8, 47_u8, 58_u8, 94_u8, 95_u8, 96_u8, 124_u8, 126_u8
      true
    else
      false
    end
  end

  # Where the bare item (RFC 8941 Section 4.2.3) starting at *i* ends, or -1
  # when there is none there.
  private def self.bare_item_end(p : String, i : Int32, n : Int32) : Int32
    return -1 if i >= n
    c = p[i]
    if c == 45_u8 || digit?(c)
      i = i + 1 if c == 45_u8
      return -1 unless i < n && digit?(p[i])
      digits = 0
      point = -1
      while i < n
        if digit?(p[i])
          digits = digits + 1
        elsif point < 0 && p[i] == 46_u8
          return -1 if digits > 12
          point = digits
        else
          break
        end
        i = i + 1
        return -1 if digits > 15
      end
      return -1 if point >= 0 && (digits == point || digits - point > 3)
      i
    elsif c == 34_u8
      i = i + 1
      while i < n
        b = p[i]
        if b == 92_u8
          return -1 unless i + 1 < n && (p[i + 1] == 34_u8 || p[i + 1] == 92_u8)
          i = i + 2
        elsif b == 34_u8
          return i + 1
        elsif b < 32_u8 || b > 126_u8
          return -1
        else
          i = i + 1
        end
      end
      -1
    elsif c == 42_u8 || alpha?(c)
      i = i + 1
      while i < n && token_char?(p[i])
        i = i + 1
      end
      i
    elsif c == 58_u8
      i = i + 1
      while i < n && p[i] != 58_u8
        b = p[i]
        return -1 unless alpha?(b) || digit?(b) || b == 43_u8 || b == 47_u8 || b == 61_u8
        i = i + 1
      end
      i < n ? i + 1 : -1
    elsif c == 63_u8
      i + 1 < n && (p[i + 1] == 48_u8 || p[i + 1] == 49_u8) ? i + 2 : -1
    else
      -1
    end
  end
end

# capsule.1 VarInt follows RFC 9000 section 16: unsigned values through 2^62 - 1
#   use 1, 2, 4 or 8 bytes with a two-bit length prefix. Default encoding is
#   shortest; explicit lengths must be valid and fit the value.
spec capsule.1
  # Bounds and valid_value?
  capsule_assert_true VarInt.valid_value?(0_u64), "0 is valid varint"
  capsule_assert_true VarInt.valid_value?(37_u64), "37 is valid varint"
  capsule_assert_true VarInt.valid_value?(VarInt::MAX_1BYTE), "MAX_1BYTE is valid varint"
  capsule_assert_true VarInt.valid_value?(VarInt::MAX_2BYTE), "MAX_2BYTE is valid varint"
  capsule_assert_true VarInt.valid_value?(VarInt::MAX_4BYTE), "MAX_4BYTE is valid varint"
  capsule_assert_true VarInt.valid_value?(VarInt::MAX), "MAX is valid varint"
  capsule_assert_false VarInt.valid_value?(4611686018427387904_u64), "MAX+1 exceeds 62 bits"

  # encoded_size (minimum canonical length)
  capsule_assert_i32 1, VarInt.encoded_size(0_u64), "encoded_size 0"
  capsule_assert_i32 1, VarInt.encoded_size(37_u64), "encoded_size 37"
  capsule_assert_i32 1, VarInt.encoded_size(63_u64), "encoded_size 63 (MAX_1BYTE)"
  capsule_assert_i32 2, VarInt.encoded_size(64_u64), "encoded_size 64"
  capsule_assert_i32 2, VarInt.encoded_size(15293_u64), "encoded_size 15293"
  capsule_assert_i32 2, VarInt.encoded_size(16383_u64), "encoded_size 16383 (MAX_2BYTE)"
  capsule_assert_i32 4, VarInt.encoded_size(16384_u64), "encoded_size 16384"
  capsule_assert_i32 4, VarInt.encoded_size(494878333_u64), "encoded_size 494878333"
  capsule_assert_i32 4, VarInt.encoded_size(1073741823_u64), "encoded_size 1073741823 (MAX_4BYTE)"
  capsule_assert_i32 8, VarInt.encoded_size(1073741824_u64), "encoded_size 1073741824"
  capsule_assert_i32 8, VarInt.encoded_size(151288809941952642_u64), "encoded_size 151288809941952642"
  capsule_assert_i32 8, VarInt.encoded_size(VarInt::MAX), "encoded_size MAX"

  # Canonical RFC 9000 Appendix A test vectors: encode and decode
  # 37: 1 byte 0x25
  v37 = VarInt.encode(37_u64)
  capsule_assert_i32 1, v37.size, "37 canonical size"
  capsule_assert_u64 0x25_u64, v37[0].to_u64, "37 byte 0"
  d37, l37 = VarInt.decode(v37)
  capsule_assert_u64 37_u64, d37, "decode 37"
  capsule_assert_i32 1, l37, "consumed 37"

  # 15293: 2 bytes 0x7b, 0xbd
  v15293 = VarInt.encode(15293_u64)
  capsule_assert_i32 2, v15293.size, "15293 canonical size"
  capsule_assert_u64 0x7b_u64, v15293[0].to_u64, "15293 byte 0"
  capsule_assert_u64 0xbd_u64, v15293[1].to_u64, "15293 byte 1"
  d15293, l15293 = VarInt.decode(v15293)
  capsule_assert_u64 15293_u64, d15293, "decode 15293"
  capsule_assert_i32 2, l15293, "consumed 15293"

  # 494878333: 4 bytes 0x9d, 0x7f, 0x3e, 0x7d
  v494 = VarInt.encode(494878333_u64)
  capsule_assert_i32 4, v494.size, "494878333 canonical size"
  capsule_assert_u64 0x9d_u64, v494[0].to_u64, "494 byte 0"
  capsule_assert_u64 0x7f_u64, v494[1].to_u64, "494 byte 1"
  capsule_assert_u64 0x3e_u64, v494[2].to_u64, "494 byte 2"
  capsule_assert_u64 0x7d_u64, v494[3].to_u64, "494 byte 3"
  d494, l494 = VarInt.decode(v494)
  capsule_assert_u64 494878333_u64, d494, "decode 494878333"
  capsule_assert_i32 4, l494, "consumed 494878333"

  # 151288809941952642: 8 bytes 0xc2, 0x19, 0x7c, 0x5e, 0xff, 0x14, 0xe8, 0x82
  v151 = VarInt.encode(151288809941952642_u64)
  capsule_assert_i32 8, v151.size, "151288809941952642 canonical size"
  capsule_assert_u64 0xc2_u64, v151[0].to_u64, "151 byte 0"
  capsule_assert_u64 0x19_u64, v151[1].to_u64, "151 byte 1"
  capsule_assert_u64 0x7c_u64, v151[2].to_u64, "151 byte 2"
  capsule_assert_u64 0x5e_u64, v151[3].to_u64, "151 byte 3"
  capsule_assert_u64 0xff_u64, v151[4].to_u64, "151 byte 4"
  capsule_assert_u64 0x14_u64, v151[5].to_u64, "151 byte 5"
  capsule_assert_u64 0xe8_u64, v151[6].to_u64, "151 byte 6"
  capsule_assert_u64 0x82_u64, v151[7].to_u64, "151 byte 7"
  d151, l151 = VarInt.decode(v151)
  capsule_assert_u64 151288809941952642_u64, d151, "decode 151288809941952642"
  capsule_assert_i32 8, l151, "consumed 151288809941952642"
  # 0: 1 byte 0x00
  v0 = VarInt.encode(0_u64)
  capsule_assert_i32 1, v0.size, "0 canonical size"
  d0, l0 = VarInt.decode(v0)
  capsule_assert_u64 0_u64, d0, "decode 0"
  capsule_assert_i32 1, l0, "consumed 0"

  # MAX: 8 bytes
  vmax = VarInt.encode(VarInt::MAX)
  capsule_assert_i32 8, vmax.size, "MAX canonical size"
  dmax, lmax = VarInt.decode(vmax)
  capsule_assert_u64 VarInt::MAX, dmax, "decode MAX"
  capsule_assert_i32 8, lmax, "consumed MAX"

  # Boundary bytes: 63, 64, 2^30-1
  v63 = VarInt.encode(63_u64)
  capsule_assert_i32 1, v63.size, "63 canonical size"
  capsule_assert_u64 0x3f_u64, v63[0].to_u64, "63 byte 0"
  v64 = VarInt.encode(64_u64)
  capsule_assert_i32 2, v64.size, "64 canonical size"
  capsule_assert_u64 0x40_u64, v64[0].to_u64, "64 byte 0"
  capsule_assert_u64 0x40_u64, v64[1].to_u64, "64 byte 1"
  d64s, l64s = VarInt.decode_strict(v64)
  capsule_assert_u64 64_u64, d64s, "strict decode 64"
  capsule_assert_i32 2, l64s, "strict consumed 64"
  v2p30 = VarInt.encode(1073741823_u64)
  capsule_assert_i32 4, v2p30.size, "2^30-1 canonical size"
  capsule_assert_u64 0xbf_u64, v2p30[0].to_u64, "2^30-1 byte 0"
  capsule_assert_u64 0xff_u64, v2p30[1].to_u64, "2^30-1 byte 1"
  capsule_assert_u64 0xff_u64, v2p30[2].to_u64, "2^30-1 byte 2"
  capsule_assert_u64 0xff_u64, v2p30[3].to_u64, "2^30-1 byte 3"
  d2p30, l2p30 = VarInt.decode_strict(v2p30)
  capsule_assert_u64 1073741823_u64, d2p30, "strict decode 2^30-1"

  # Leftover bytes after a varint are not consumed
  left_buf = Bytes.new(3)
  left_buf[0] = 0x25_u8; left_buf[1] = 0xaa_u8; left_buf[2] = 0xbb_u8
  dl, ll = VarInt.decode(left_buf)
  capsule_assert_u64 37_u64, dl, "leftover decode value"
  capsule_assert_i32 1, ll, "leftover consumed only the varint"

  # Explicit multi-byte encoding (RFC 9000 Appendix A: 37 in 1, 2, 4, 8 bytes)
  m1 = VarInt.encode(37_u64, 1)
  m2 = VarInt.encode(37_u64, 2)
  m4 = VarInt.encode(37_u64, 4)
  m8 = VarInt.encode(37_u64, 8)
  capsule_assert_i32 1, m1.size, "m1 size"
  capsule_assert_i32 2, m2.size, "m2 size"
  capsule_assert_i32 4, m4.size, "m4 size"
  capsule_assert_i32 8, m8.size, "m8 size"
  capsule_assert_u64 0x25_u64, m1[0].to_u64, "m1 bytes"
  capsule_assert_u64 0x40_u64, m2[0].to_u64, "m2 byte 0"
  capsule_assert_u64 0x25_u64, m2[1].to_u64, "m2 byte 1"
  capsule_assert_u64 0x80_u64, m4[0].to_u64, "m4 byte 0"
  capsule_assert_u64 0x25_u64, m4[3].to_u64, "m4 byte 3"
  capsule_assert_u64 0xc0_u64, m8[0].to_u64, "m8 byte 0"
  capsule_assert_u64 0x25_u64, m8[7].to_u64, "m8 byte 7"
end

# capsule.2 VarInt decoding returns the value and consumed byte count. Default
#   decoding permits longer encodings; strict decoding refuses them. Question
#   forms return nil on invalid input, other forms panic.
spec capsule.2
  m1 = VarInt.encode(37_u64, 1)
  m2 = VarInt.encode(37_u64, 2)
  m4 = VarInt.encode(37_u64, 4)
  m8 = VarInt.encode(37_u64, 8)
  # Non-strict decoding permits multi-byte representation
  dm1, lm1 = VarInt.decode(m1)
  dm2, lm2 = VarInt.decode(m2)
  dm4, lm4 = VarInt.decode(m4)
  dm8, lm8 = VarInt.decode(m8)
  capsule_assert_u64 37_u64, dm1, "non-strict dm1"
  capsule_assert_u64 37_u64, dm2, "non-strict dm2"
  capsule_assert_u64 37_u64, dm4, "non-strict dm4"
  capsule_assert_u64 37_u64, dm8, "non-strict dm8"
  capsule_assert_i32 1, lm1, "len lm1"
  capsule_assert_i32 2, lm2, "len lm2"
  capsule_assert_i32 4, lm4, "len lm4"
  capsule_assert_i32 8, lm8, "len lm8"

  # Strict decoding rejects overlong representation
  capsule_assert_false VarInt.decode_strict?(m1).nil?, "m1 valid in strict mode"
  capsule_assert_true VarInt.decode_strict?(m2).nil?, "m2 overlong in strict mode"
  capsule_assert_true VarInt.decode_strict?(m4).nil?, "m4 overlong in strict mode"
  capsule_assert_true VarInt.decode_strict?(m8).nil?, "m8 overlong in strict mode"

  # Truncated buffer detection
  trunc_buf = Bytes.new(1)
  trunc_buf[0] = 0x40_u8 # indicates 2-byte varint, but only 1 byte present
  capsule_assert_true VarInt.decode?(trunc_buf).nil?, "truncated 2-byte varint returns nil"
  capsule_assert_true VarInt.decode?(Bytes.new(0)).nil?, "empty buffer returns nil"
  capsule_assert_true VarInt.decode?(trunc_buf, offset: 5).nil?, "offset beyond buffer returns nil"

  # A varint that starts within 8 bytes of the end of a buffer of 2^31 - 1
  # bytes: its room is `size - offset`, where `offset + 8` overflowed Int32 and
  # panicked. The buffer is a view whose last 8 bytes are `edge_tail`, so no
  # 2 GiB is allocated; nothing before them is read.
  edge_n = 2147483647
  edge_tail = Bytes.new(8)
  edge = Bytes.new(Pointer(UInt8).new(edge_tail.to_unsafe.address &- (edge_n - 8).to_u64), edge_n)
  edge_tail[7] = 0xc0_u8
  capsule_assert_true VarInt.decode?(edge, edge_n - 1).nil?, "8-byte varint in the last byte of a 2^31 - 1 buffer is truncated"
  edge_tail[7] = 0x40_u8
  capsule_assert_true VarInt.decode?(edge, edge_n - 1).nil?, "2-byte varint in the last byte of a 2^31 - 1 buffer is truncated"
  edge_tail[6] = 0x05_u8
  capsule_assert_true Capsule.decode?(edge, edge_n - 2).nil?, "capsule length truncated at the end of a 2^31 - 1 buffer"
  capsule_assert_true HttpDatagram.decode?(edge, edge_n - 1).nil?, "datagram id truncated at the end of a 2^31 - 1 buffer"
  edge_tail[6] = 0x40_u8
  ev, en = VarInt.decode(edge, edge_n - 2)
  capsule_assert_u64 64_u64, ev, "2-byte varint ending a 2^31 - 1 buffer"
  capsule_assert_i32 2, en, "2-byte varint ending a 2^31 - 1 buffer consumed"
end

# capsule.3 HttpDatagram follows RFC 9297 section 2: a quarter stream ID
#   precedes the payload and is at most 2^60 - 1. from_stream_id accepts only
#   client-initiated bidirectional IDs divisible by four.
spec capsule.3
  # Stream ID to Quarter Stream ID mapping
  # Quarter Stream ID = Stream ID // 4
  # Stream ID = Quarter Stream ID * 4
  dg0 = HttpDatagram.from_stream_id(0_u64, Bytes.new(0))
  capsule_assert_u64 0_u64, dg0.quarter_stream_id, "qid from stream 0"
  capsule_assert_u64 0_u64, dg0.stream_id, "stream_id from qid 0"

  dg16 = HttpDatagram.from_stream_id(16_u64, Bytes.new(0))
  capsule_assert_u64 4_u64, dg16.quarter_stream_id, "qid from stream 16"
  capsule_assert_u64 16_u64, dg16.stream_id, "stream_id from qid 4"

  # Every request stream round trips; one that is no request stream is
  # refused (the .sh beside this file): RFC 9297 Section 2.1 carries a
  # datagram on client-initiated bidirectional streams alone, whose IDs are
  # multiples of four, and stream 19 was divided down to stream 16's.
  [4_u64, 8_u64, 1024_u64, VarInt::MAX - 3_u64].each do |sid|
    capsule_assert_u64 sid, HttpDatagram.from_stream_id(sid, Bytes.new(0)).stream_id, "stream #{sid} round trips through its quarter"
  end
  # RFC 9297 Section 2.1: a stream ID is at most 2^62 - 1, so a Quarter Stream
  # ID is at most 2^60 - 1 and a larger one on the wire is an error.
  qid_max = 1152921504606846975_u64
  dg_maxq = HttpDatagram.new(qid_max, Bytes.new(0))
  capsule_assert_u64 VarInt::MAX - 3_u64, dg_maxq.stream_id, "largest quarter stream id maps to the largest request stream"
  dg_maxq_dec, dg_maxq_n = HttpDatagram.decode(dg_maxq.encode)
  capsule_assert_u64 qid_max, dg_maxq_dec.quarter_stream_id, "2^60 - 1 quarter stream id round trips"
  capsule_assert_i32 8, dg_maxq_n, "2^60 - 1 quarter stream id consumed"
  capsule_assert_true HttpDatagram.decode?(VarInt.encode(qid_max + 1_u64)).nil?, "2^60 quarter stream id is refused"
  capsule_assert_true HttpDatagram.decode?(VarInt.encode(VarInt::MAX)).nil?, "2^62 - 1 quarter stream id is refused"

  # Datagram encoding and decoding with binary payload
  pay = Bytes.new(5)
  pay[0] = 0x01_u8; pay[1] = 0x02_u8; pay[2] = 0x03_u8; pay[3] = 0x04_u8; pay[4] = 0x05_u8
  dg_custom = HttpDatagram.new(12_u64, pay)
  capsule_assert_u64 12_u64, dg_custom.quarter_stream_id, "custom datagram qid"
  capsule_assert_u64 48_u64, dg_custom.stream_id, "custom datagram stream_id (12 * 4)"
  capsule_assert_bytes pay, dg_custom.payload, "custom datagram payload"

  dg_encoded = dg_custom.encode
  # Header is VarInt(12) which is 1 byte (0x0c), followed by 5 bytes payload = 6 bytes
  capsule_assert_i32 6, dg_encoded.size, "dg_encoded size"
  capsule_assert_u64 0x0c_u64, dg_encoded[0].to_u64, "dg_encoded qid header"

  dg_decoded, dg_consumed = HttpDatagram.decode(dg_encoded)
  capsule_assert_u64 12_u64, dg_decoded.quarter_stream_id, "decoded datagram qid"
  capsule_assert_u64 48_u64, dg_decoded.stream_id, "decoded datagram stream_id"
  capsule_assert_bytes pay, dg_decoded.payload, "decoded datagram payload"
  capsule_assert_i32 6, dg_consumed, "consumed bytes for datagram"

  # Empty datagram decode and round trip
  dg_empty = HttpDatagram.new(1_u64, Bytes.new(0))
  dg_empty_dec, dg_empty_len = HttpDatagram.decode(dg_empty.encode)
  capsule_assert_u64 1_u64, dg_empty_dec.quarter_stream_id, "empty datagram qid"
  capsule_assert_i32 0, dg_empty_dec.payload.size, "empty datagram payload size"
  capsule_assert_i32 1, dg_empty_len, "empty datagram consumed length"

  # Offset decoding
  offset_buf = Bytes.new(8)
  offset_buf[0] = 0xff_u8; offset_buf[1] = 0xff_u8
  i = 0
  while i < dg_encoded.size
    offset_buf[2 + i] = dg_encoded[i]
    i = i + 1
  end
  dg_off, dg_off_len = HttpDatagram.decode(offset_buf, offset: 2)
  capsule_assert_u64 12_u64, dg_off.quarter_stream_id, "offset datagram qid"
  capsule_assert_bytes pay, dg_off.payload, "offset datagram payload"
  capsule_assert_i32 6, dg_off_len, "offset datagram consumed"

  # Truncated decode returns nil
  capsule_assert_true HttpDatagram.decode?(Bytes.new(0)).nil?, "empty datagram decode returns nil"
  capsule_assert_true HttpDatagram.decode?(offset_buf, offset: 20).nil?, "out of bounds offset returns nil"

  # RFC 9297 §2: HTTP Datagram payload is the remainder of the buffer
  rest_buf = Bytes.new(4)
  rest_buf[0] = 0x01_u8; rest_buf[1] = 0xaa_u8; rest_buf[2] = 0xbb_u8; rest_buf[3] = 0xcc_u8
  dg_rest, dg_rest_n = HttpDatagram.decode(rest_buf)
  capsule_assert_u64 1_u64, dg_rest.quarter_stream_id, "remainder datagram qid"
  capsule_assert_i32 3, dg_rest.payload.size, "remainder datagram payload is the rest"
  capsule_assert_i32 4, dg_rest_n, "remainder datagram consumes to end"

  # Strict mode refuses overlong quarter-stream ID
  ol_qid = Bytes.new(3)
  ol_qid[0] = 0x40_u8; ol_qid[1] = 0x00_u8; ol_qid[2] = 0xaa_u8
  capsule_assert_true HttpDatagram.decode?(ol_qid, 0, true).nil?, "strict overlong qid returns nil"
  ol_ok, ol_n = HttpDatagram.decode(ol_qid)
  capsule_assert_u64 0_u64, ol_ok.quarter_stream_id, "non-strict overlong qid is 0"
  capsule_assert_i32 1, ol_ok.payload.size, "non-strict overlong qid payload"
  capsule_assert_i32 3, ol_n, "non-strict overlong qid consumed"
end

# capsule.4 Capsule encodes RFC 9297 section 3's type, length and value framing.
#   Truncated headers or values are refused, including lengths outside the
#   available bytes.
spec capsule.4
  # Types
  capsule_assert_u64 0x00_u64, CapsuleType::DATAGRAM, "CapsuleType::DATAGRAM"
  capsule_assert_u64 0x2843_u64, CapsuleType::CLOSE_WEBTRANSPORT_SESSION, "CapsuleType::CLOSE_WEBTRANSPORT_SESSION"
  capsule_assert_u64 0x78ae_u64, CapsuleType::DRAIN_WEBTRANSPORT_SESSION, "CapsuleType::DRAIN_WEBTRANSPORT_SESSION"

  # Datagram capsule
  c_data_val = Bytes.new(3)
  c_data_val[0] = 10_u8; c_data_val[1] = 20_u8; c_data_val[2] = 30_u8
  c_data = Capsule.new(CapsuleType::DATAGRAM, c_data_val)
  capsule_assert_true c_data.datagram?, "c_data is datagram"
  capsule_assert_false c_data.close_webtransport_session?, "c_data is not close"
  capsule_assert_false c_data.drain_webtransport_session?, "c_data is not drain"
  capsule_assert_false c_data.unknown?, "c_data is known"

  # Close WebTransport Session capsule
  c_close = Capsule.new(CapsuleType::CLOSE_WEBTRANSPORT_SESSION, Bytes.new(4))
  capsule_assert_false c_close.datagram?, "c_close is not datagram"
  capsule_assert_true c_close.close_webtransport_session?, "c_close is close"
  capsule_assert_false c_close.drain_webtransport_session?, "c_close is not drain"
  capsule_assert_false c_close.unknown?, "c_close is known"

  # Drain WebTransport Session capsule (empty payload)
  c_drain = Capsule.new(CapsuleType::DRAIN_WEBTRANSPORT_SESSION, Bytes.new(0))
  capsule_assert_false c_drain.datagram?, "c_drain is not datagram"
  capsule_assert_false c_drain.close_webtransport_session?, "c_drain is not close"
  capsule_assert_true c_drain.drain_webtransport_session?, "c_drain is drain"
  capsule_assert_false c_drain.unknown?, "c_drain is known"

  # Unknown capsule type
  c_unk = Capsule.new(0x9999_u64, Bytes.new(2))
  capsule_assert_false c_unk.datagram?, "c_unk is not datagram"
  capsule_assert_false c_unk.close_webtransport_session?, "c_unk is not close"
  capsule_assert_false c_unk.drain_webtransport_session?, "c_unk is not drain"
  capsule_assert_true c_unk.unknown?, "c_unk is unknown"

  # Capsule encoding and decoding: round-trip
  # Format: Capsule Type (i), Capsule Length (i), Capsule Value (..)
  c_data_enc = c_data.encode
  # type 0 (1 byte 0x00), len 3 (1 byte 0x03), payload 3 bytes = 5 bytes total
  capsule_assert_i32 5, c_data_enc.size, "c_data_enc size"
  capsule_assert_u64 0x00_u64, c_data_enc[0].to_u64, "c_data_enc type"
  capsule_assert_u64 0x03_u64, c_data_enc[1].to_u64, "c_data_enc len"
  capsule_assert_bytes c_data_val, c_data.value, "c_data payload matches"

  c_data_dec, c_data_consumed = Capsule.decode(c_data_enc)
  capsule_assert_u64 CapsuleType::DATAGRAM, c_data_dec.capsule_type, "decoded capsule type"
  capsule_assert_bytes c_data_val, c_data_dec.value, "decoded capsule value"
  capsule_assert_i32 5, c_data_consumed, "decoded capsule consumed bytes"

  # Drain capsule round-trip (empty value, 4-byte type 0x78ae: 30894 > 16383)
  c_drain_enc = c_drain.encode
  # 0x78ae > 16383 (MAX_2BYTE) so encoded as 4 bytes, length 0 as 1 byte = 5 bytes total
  capsule_assert_i32 5, c_drain_enc.size, "c_drain_enc size"
  c_drain_dec, c_drain_consumed = Capsule.decode(c_drain_enc)
  capsule_assert_u64 CapsuleType::DRAIN_WEBTRANSPORT_SESSION, c_drain_dec.capsule_type, "decoded drain type"
  capsule_assert_i32 0, c_drain_dec.value.size, "decoded drain empty value"
  capsule_assert_i32 5, c_drain_consumed, "decoded drain consumed"

  # Unknown capsule round-trip preserving type and payload
  c_unk_val = Bytes.new(2)
  c_unk_val[0] = 0xde_u8; c_unk_val[1] = 0xad_u8
  c_unk_real = Capsule.new(0x88_u64, c_unk_val)
  c_unk_dec, c_unk_len = Capsule.decode(c_unk_real.encode)
  capsule_assert_u64 0x88_u64, c_unk_dec.capsule_type, "decoded unknown type"
  capsule_assert_true c_unk_dec.unknown?, "decoded unknown is unknown"
  capsule_assert_bytes c_unk_val, c_unk_dec.value, "decoded unknown value preserved"

  # Decode error checks
  capsule_assert_true Capsule.decode?(Bytes.new(0)).nil?, "empty buffer returns nil"
  one_byte = Bytes.new(1); one_byte[0] = 0x00_u8
  capsule_assert_true Capsule.decode?(one_byte).nil?, "buffer ending before length returns nil"
  overrun_buf = Bytes.new(3)
  overrun_buf[0] = 0x00_u8 # type 0
  overrun_buf[1] = 0x10_u8 # length 16
  overrun_buf[2] = 0xaa_u8 # only 1 byte payload present
  capsule_assert_true Capsule.decode?(overrun_buf).nil?, "buffer overrun returns nil"
end

# capsule.5 read_all preserves unknown capsule types; read_known skips them.
#   read_with_skip_count appends recognized capsules to its supplied array and
#   returns the number skipped.
spec capsule.5
  c_data_val = Bytes.new(3)
  c_data_val[0] = 10_u8; c_data_val[1] = 20_u8; c_data_val[2] = 30_u8
  # Stream processing: reading multiple capsules and enforcing RFC 9297 Section 3.2 extensibility
  # Build a concatenated stream of 4 capsules:
  #   1. DATAGRAM (known)
  #   2. UNKNOWN type 0x99
  #   3. CLOSE_WEBTRANSPORT_SESSION (known)
  #   4. DRAIN_WEBTRANSPORT_SESSION (known)
  cap1 = Capsule.new(CapsuleType::DATAGRAM, c_data_val)
  cap2 = Capsule.new(0x99_u64, Bytes.new(1))
  cap3 = Capsule.new(CapsuleType::CLOSE_WEBTRANSPORT_SESSION, Bytes.new(2))
  cap4 = Capsule.new(CapsuleType::DRAIN_WEBTRANSPORT_SESSION, Bytes.new(0))

  e1 = cap1.encode
  e2 = cap2.encode
  e3 = cap3.encode
  e4 = cap4.encode

  total_stream_len = e1.size + e2.size + e3.size + e4.size
  stream = Bytes.new(total_stream_len)
  pos = 0
  idx = 0
  while idx < e1.size
    stream[pos] = e1[idx]
    pos = pos + 1; idx = idx + 1
  end
  idx = 0
  while idx < e2.size
    stream[pos] = e2[idx]
    pos = pos + 1; idx = idx + 1
  end
  idx = 0
  while idx < e3.size
    stream[pos] = e3[idx]
    pos = pos + 1; idx = idx + 1
  end
  idx = 0
  while idx < e4.size
    stream[pos] = e4[idx]
    pos = pos + 1; idx = idx + 1
  end

  # read_all parses every capsule, including unknown
  all_caps = CapsuleReader.read_all(stream)
  capsule_assert_i32 4, all_caps.size, "read_all count"
  capsule_assert_u64 CapsuleType::DATAGRAM, all_caps[0].capsule_type, "all[0] type"
  capsule_assert_u64 0x99_u64, all_caps[1].capsule_type, "all[1] type"
  capsule_assert_true all_caps[1].unknown?, "all[1] is unknown"
  capsule_assert_u64 CapsuleType::CLOSE_WEBTRANSPORT_SESSION, all_caps[2].capsule_type, "all[2] type"
  capsule_assert_u64 CapsuleType::DRAIN_WEBTRANSPORT_SESSION, all_caps[3].capsule_type, "all[3] type"

  # read_known skips unknown capsules per Section 3.2
  known_caps = CapsuleReader.read_known(stream)
  capsule_assert_i32 3, known_caps.size, "read_known count (1 unknown skipped)"
  capsule_assert_u64 CapsuleType::DATAGRAM, known_caps[0].capsule_type, "known[0] type"
  capsule_assert_u64 CapsuleType::CLOSE_WEBTRANSPORT_SESSION, known_caps[1].capsule_type, "known[1] type"
  capsule_assert_u64 CapsuleType::DRAIN_WEBTRANSPORT_SESSION, known_caps[2].capsule_type, "known[2] type"

  # read_with_skip_count appends the known capsules, answers the skip count
  caps_skipped = [] of Capsule
  skip_cnt = CapsuleReader.read_with_skip_count(stream, caps_skipped)
  capsule_assert_i32 3, caps_skipped.size, "read_with_skip_count known count"
  capsule_assert_i32 1, skip_cnt, "read_with_skip_count skipped count"

  empty_known = [] of Capsule
  empty_skip = CapsuleReader.read_with_skip_count(Bytes.new(0), empty_known)
  capsule_assert_i32 0, empty_known.size, "empty stream known count"
  capsule_assert_i32 0, empty_skip, "empty stream skip count"
  unk_only = Capsule.new(0x21_u64, Bytes.new(0))
  unk_known = [] of Capsule
  unk_skip = CapsuleReader.read_with_skip_count(unk_only.encode, unk_known)
  capsule_assert_i32 0, unk_known.size, "all-unknown known count"
  capsule_assert_i32 1, unk_skip, "all-unknown skip count"
end

# capsule.6 ExtendedConnect exposes setting 0x08 from RFC 8441 and RFC 9220. Its
#   request check requires CONNECT and nonempty protocol, scheme, authority and
#   path; its response check accepts status 200 through 299. It does not perform
#   HTTP transport negotiation.
spec capsule.6
  # Extended CONNECT (RFC 8441 and RFC 9220)
  capsule_assert_u64 0x08_u64, ExtendedConnect::SETTINGS_ENABLE_CONNECT_PROTOCOL, "SETTINGS_ENABLE_CONNECT_PROTOCOL"
  capsule_assert_u64 0x08_u64, ExtendedConnect.settings_id, "ExtendedConnect.settings_id"
  capsule_assert_str ":method", ExtendedConnect::HEADER_METHOD, "HEADER_METHOD"
  capsule_assert_str ":protocol", ExtendedConnect::HEADER_PROTOCOL, "HEADER_PROTOCOL"
  capsule_assert_str ":scheme", ExtendedConnect::HEADER_SCHEME, "HEADER_SCHEME"
  capsule_assert_str ":authority", ExtendedConnect::HEADER_AUTHORITY, "HEADER_AUTHORITY"
  capsule_assert_str ":path", ExtendedConnect::HEADER_PATH, "HEADER_PATH"
  capsule_assert_str ":status", ExtendedConnect::HEADER_STATUS, "HEADER_STATUS"
  capsule_assert_str "CONNECT", ExtendedConnect::METHOD_CONNECT, "METHOD_CONNECT"
  capsule_assert_str "webtransport", ExtendedConnect::PROTOCOL_WEBTRANSPORT, "PROTOCOL_WEBTRANSPORT"
  capsule_assert_str "websocket", ExtendedConnect::PROTOCOL_WEBSOCKET, "PROTOCOL_WEBSOCKET"

  # Extended CONNECT request validation
  capsule_assert_true ExtendedConnect.valid_request?("CONNECT", "webtransport", "https", "example.com", "/wt"), "valid WebTransport CONNECT"
  capsule_assert_true ExtendedConnect.valid_request?("CONNECT", "websocket", "https", "example.com", "/chat"), "valid WebSocket CONNECT"
  capsule_assert_false ExtendedConnect.valid_request?("GET", "webtransport", "https", "example.com", "/wt"), "invalid method GET"
  capsule_assert_false ExtendedConnect.valid_request?("CONNECT", "", "https", "example.com", "/wt"), "empty protocol"
  capsule_assert_false ExtendedConnect.valid_request?("CONNECT", nil, "https", "example.com", "/wt"), "nil protocol"
  capsule_assert_false ExtendedConnect.valid_request?("CONNECT", "webtransport", "", "example.com", "/wt"), "empty scheme"
  capsule_assert_false ExtendedConnect.valid_request?("CONNECT", "webtransport", "https", "", "/wt"), "empty authority"
  capsule_assert_false ExtendedConnect.valid_request?("CONNECT", "webtransport", "https", "example.com", ""), "empty path"

  # Extended CONNECT response status validation (2xx)
  capsule_assert_true ExtendedConnect.valid_response?(200), "response 200 is valid"
  capsule_assert_true ExtendedConnect.valid_response?(201), "response 201 is valid"
  capsule_assert_true ExtendedConnect.valid_response?(299), "response 299 is valid"
  capsule_assert_false ExtendedConnect.valid_response?(101), "response 101 is invalid"
  capsule_assert_false ExtendedConnect.valid_response?(301), "response 301 is invalid"
  capsule_assert_false ExtendedConnect.valid_response?(400), "response 400 is invalid"
  capsule_assert_false ExtendedConnect.valid_response?(404), "response 404 is invalid"
  capsule_assert_false ExtendedConnect.valid_response?(500), "response 500 is invalid"
  capsule_assert_false ExtendedConnect.valid_request?("CONNECT", "webtransport", nil, "example.com", "/wt"), "nil scheme"
  capsule_assert_false ExtendedConnect.valid_response?(199), "response 199 is invalid"
  capsule_assert_false ExtendedConnect.valid_response?(300), "response 300 is invalid"
end

# capsule.7 CapsuleProtocol matches its header name without case and accepts a
#   true Boolean Item Structured Field under RFC 8941, parsing and ignoring
#   valid parameters as RFC 9297 requires. Malformed fields do not enable
#   capsules.
spec capsule.7
  # Capsule-Protocol header (RFC 9297 Section 3.3)
  capsule_assert_str "Capsule-Protocol", CapsuleProtocol::HEADER_NAME, "HEADER_NAME"
  capsule_assert_str "?1", CapsuleProtocol::HEADER_VALUE, "HEADER_VALUE"
  capsule_assert_str "Capsule-Protocol", CapsuleProtocol.header_name, "header_name"
  capsule_assert_str "?1", CapsuleProtocol.header_value, "header_value"

  capsule_assert_true CapsuleProtocol.valid_header?("Capsule-Protocol", "?1"), "standard Capsule-Protocol header"
  capsule_assert_true CapsuleProtocol.valid_header?("capsule-protocol", "?1"), "lowercase Capsule-Protocol header"
  capsule_assert_true CapsuleProtocol.valid_header?("CAPSULE-PROTOCOL", "?1"), "uppercase Capsule-Protocol header"
  capsule_assert_true CapsuleProtocol.valid_header?("Capsule-Protocol", "?1 "), "Capsule-Protocol with trailing space"
  capsule_assert_false CapsuleProtocol.valid_header?("Capsule-Protocol", "?0"), "Capsule-Protocol ?0 is invalid"
  capsule_assert_false CapsuleProtocol.valid_header?("Capsule-Protocol", "1"), "Capsule-Protocol 1 is invalid"
  capsule_assert_false CapsuleProtocol.valid_header?("Other-Header", "?1"), "Other-Header is invalid"

  capsule_assert_true CapsuleProtocol.is_capsule_protocol_header?("?1"), "is_capsule_protocol_header ?1"
  capsule_assert_true CapsuleProtocol.is_capsule_protocol_header?("?1 "), "is_capsule_protocol_header ?1 "
  capsule_assert_false CapsuleProtocol.is_capsule_protocol_header?("?0"), "is_capsule_protocol_header ?0"
  capsule_assert_false CapsuleProtocol.is_capsule_protocol_header?(""), "is_capsule_protocol_header empty"
  # RFC 9297 Section 3.4: an Item Structured Field whose parameters receivers
  # MUST ignore; RFC 8941 Section 4.2 drops spaces on either side of the Item.
  capsule_assert_true CapsuleProtocol.valid_header?("Capsule-Protocol", "?1;foo=bar"), "structured-field parameters are ignored"
  capsule_assert_true CapsuleProtocol.valid_header?("Capsule-Protocol", " ?1"), "leading space is dropped"
  capsule_assert_true CapsuleProtocol.is_capsule_protocol_header?("?1;a;b=?0;c=\"x;y\";d=:YWJj:;e=-1.5;f=tok/1  "), "every bare-item kind as a parameter"
  capsule_assert_false CapsuleProtocol.is_capsule_protocol_header?("?0;a=1"), "false with parameters is still false"
  capsule_assert_false CapsuleProtocol.is_capsule_protocol_header?("?1;A=1"), "an uppercase parameter key is not an Item"
  capsule_assert_false CapsuleProtocol.is_capsule_protocol_header?("?1 ;a"), "a space before a parameter is not an Item"
  capsule_assert_false CapsuleProtocol.is_capsule_protocol_header?("?1;a=1.2345"), "a four-digit fraction is not an Item"
  capsule_assert_false CapsuleProtocol.is_capsule_protocol_header?("?1, ?1"), "a List is not an Item"
end

# capsule.8 Decoded payloads and capsule values are slices viewing the input;
#   encoded bytes and result arrays follow SPEC 1.5. A caller retaining decoded
#   views must retain the source under SPEC 3.2.
spec capsule.8
  input = Bytes.new(6)
  input[0] = 0x00_u8 # DATAGRAM
  input[1] = 0x03_u8 # length 3
  input[2] = 0x04_u8
  input[3] = 0x05_u8
  input[4] = 0x06_u8
  input[5] = 0x07_u8
  checked = Capsule.decode(input)[0]
  capsule_assert_i32 3, checked.value.size, "value has its length"
  capsule_assert_true checked.value.same?(input[2, 3]), "decode's value views the input"
  maybe = Capsule.decode?(input) || raise "decode? reads the capsule"
  capsule_assert_true maybe[0].value.same?(input[2, 3]), "decode?'s value views the input"
  input[2] = 0x2a_u8
  capsule_assert_i32 0x2a, checked.value[0].to_i32, "a change to the input shows in the view"
  dg = HttpDatagram.decode(input, 1)[0]
  capsule_assert_true dg.payload.same?(input[2, 4]), "datagram payload views the input"
  capsule_assert_i32 4, dg.payload.size, "payload runs to the end"
  # Encoded bytes and result arrays follow SPEC 1.5: one call makes them.
  capsule_assert_i32 5, checked.encode.size, "encode makes the whole capsule"
end

private def capsule_assert_true(cond : Bool, msg : String) : Bool
  raise "ASSERTION FAILED: #{msg}" unless cond
  true
end

private def capsule_assert_false(cond : Bool, msg : String) : Bool
  raise "ASSERTION FAILED: #{msg}" if cond
  true
end

private def capsule_assert_u64(expected : UInt64, actual : UInt64, msg : String) : Bool
  raise "ASSERTION FAILED: #{msg}\n  expected #{expected}\n  got      #{actual}" unless expected == actual
  true
end

private def capsule_assert_i32(expected : Int32, actual : Int32, msg : String) : Bool
  raise "ASSERTION FAILED: #{msg}\n  expected #{expected}\n  got      #{actual}" unless expected == actual
  true
end

private def capsule_assert_str(expected : String, actual : String, msg : String) : Bool
  raise "ASSERTION FAILED: #{msg}\n  expected #{expected.inspect}\n  got      #{actual.inspect}" unless expected == actual
  true
end

private def capsule_assert_bytes(expected : Bytes, actual : Bytes, msg : String) : Bool
  raise "ASSERTION FAILED: #{msg}\n  expected size #{expected.size}\n  got      size #{actual.size}" unless expected.size == actual.size
  i = 0
  while i < expected.size
    unless expected[i] == actual[i]
      raise "ASSERTION FAILED: #{msg} at index #{i}\n  expected #{expected[i]}\n  got      #{actual[i]}"
    end
    i = i + 1
  end
  true
end
