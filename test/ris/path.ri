module test/path_tape

import std/path::{Path}

kept = ""
tape do
  path = Path.posix("/a//b/../c.txt")
  exit 1 unless path.basename == "c.txt"
  exit 2 unless path.extension == ".txt" && path.stem == "c"
  normal = path.normalize
  exit 3 unless normal.name == "/a/c.txt"
  exit 4 unless normal.parent.name == "/a"
  relative = normal.relative_to?("/a")
  exit 5 unless relative && relative.name == "c.txt"
  exit 6 unless Path.windows("C:/a/../b").normalize.name == "C:\\b"
  exit 7 unless Path.windows("C:").join("foo").name == "C:foo"
  exit 8 unless path.name == path.copy_to(Program.tape).name
  writer = String::Builder.new(1)
  writer << "prefix:"
  normal.write(writer)
  exit 9 unless writer.finish == "prefix:/a/c.txt"
  exit 11 unless Path.posix("").normalize.name == "."
  unc = Path.windows("\\\\srv\\share")
  exit 12 unless unc.absolute?
  exit 13 unless unc.join("a").name == "\\\\srv\\share\\a"
  exit 14 unless Path.posix("/a.txt/").basename(
    ".txt") == "a"
  expanded = Path.windows("C:é").expand("C:\\a")
  exit 15 unless expanded.name == "C:\\a\\é"
  exit 16 unless normal.parents[0].name == "/"
  kept = normal.name.copy_to(Program.tape)
end
exit 10 unless Path.posix("/a//b/../c.txt").normalize.name == kept
puts "PASS: path on tape"
