# Two live growing values each reserve before publishing any elements.
# Their reservations are reused over 10,000 scopes on the main tape:
# four mappings with it, with no copying.
10000.times do
  tape do
    a = Array(Int32).new(4)
    b = Array(Int32).new(4)
    i = 0
    while i < 100
      a << i
      b << i
      i += 1
    end
  end
end
