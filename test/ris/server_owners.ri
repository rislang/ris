# Socket copies share state; idle connections stop with their server.
module test/ris/server_owners

import std/socket::{IyiSocket, SocketError}
import std/http::{Server, Incoming, Outgoing}
import std/log::{Logger, IOBackend, Severity}

listener = IyiSocket.listen(0)
copy = listener
copy.close
raise "socket copy lost close" unless listener.closed?

sink = File.open("/dev/null", "w", owner: Program.tape)
backend = IOBackend.on_program(sink)
source = String::Builder.new(16)
source << "retained"
logger = Logger.on_program(source.finish, Severity::Info, backend)
source.clear
source << "replaced"
raise "logger borrowed its source" unless logger.source == "retained"
logger.info("program-owned sink")
backend.close
sink.close

struct Listening
end
struct Handler
  def initialize(config : Int32)
  end
  def listening(port : Int32) : Nil
    RisBoard.post(Listening.new)
  end
  def call(req : Incoming, res : Outgoing) : Nil
    res.body << "ok"
  end
end

probe = IyiSocket.listen(0)
port = probe.local_port
probe.close
first = nil.as(IyiSocket?)
second = nil.as(IyiSocket?)
group do |g|
  g.spawn do
    Server.answer("127.0.0.1", port, 0, Handler, max_connections: 2)
    0
  end
  2.times { RisBoard.take(Listening).or_panic }
  first = IyiSocket.connect("127.0.0.1", port).or_panic
  second = IyiSocket.connect("127.0.0.1", port).or_panic
  first.write("GET / HTTP/1.1\r\n").or_panic
  second.write("GET / HTTP/1.1\r\n").or_panic
  sleep(10)
  g.cancel_children
end
bytes = String::Builder.new(16)
if peer = first
  peer.read_timeout_ms = 1000
  result = peer.read(bytes, 16)
  raise "first idle peer stayed open" unless result == 0 || result.is_a?(SocketError)
  peer.close
end
bytes.clear
if peer = second
  peer.read_timeout_ms = 1000
  result = peer.read(bytes, 16)
  raise "second idle peer stayed open" unless result == 0 || result.is_a?(SocketError)
  peer.close
end
puts "owners: shared socket copies, program log, task-local shutdown"
