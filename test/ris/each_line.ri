# Str#each_line splits as String#each_line does, each line a view
# into the text: `\r\n` and `\n` end one, a final newline opens none, a
# last `\r` with no newline after it is kept.
def show(text : String) : Nil
  tape do
    count = 0
    text.as_tape.each_line do |line|
      print "[#{line}]"
      count += 1
    end
    puts " #{count}"
  end
end

show("GET /\nPOST /users\r\n\nGET /a")
show("one\n")
show("")
show("b\r")
