# mmap tape support without collector roots or marking.
{% if flag?(:gc_none) && flag?(:darwin) %}
  # macOS: libSystem, as the prelude's darwin arm. Apple's arm64 pages are
  # 16 KiB. MADV_FREE lets the kernel take them back; they read as zero or
  # as they were, and a tape only reads what it has written since.
  lib LibRisMap
    fun munmap(addr : Void*, length : UInt64) : Int32
    fun madvise(addr : Void*, length : UInt64, advice : Int32) : Int32
  end

  fun __iyi_mmap(length : UInt64) : Pointer(Void)
    # PROT_READ|PROT_WRITE = 3, MAP_PRIVATE|MAP_ANON = 0x1002.
    result = LibC.mmap(Pointer(Void).new(0_u64), length, 3, 0x1002, -1, 0_i64)
    RisHeap.mapping_failure(length) if result.address == 0xFFFFFFFFFFFFFFFF_u64
    result
  end

  def __iyi_release_pages(address : UInt64, length : UInt64) : Nil
    start = (address &+ 16383_u64) & 0xFFFFFFFFFFFFC000_u64
    finish = (address &+ length) & 0xFFFFFFFFFFFFC000_u64
    return if finish <= start
    LibRisMap.madvise(Pointer(Void).new(start), finish &- start, 5)
  end

  fun __iyi_munmap(address : UInt64, length : UInt64) : Nil
    if LibRisMap.munmap(Pointer(Void).new(address), length) != 0
      __iyi_write(2, "iyi: munmap failed\n".to_unsafe.as(Void*), 19_u64)
      __iyi_exit(1)
    end
  end
{% end %}

{% if flag?(:gc_none) && (flag?(:linux) || flag?(:darwin)) %}
  {% if flag?(:linux) %}
  # Pages back to the kernel, the mapping kept (MADV_DONTNEED): a spare
  # stays warm only up to KEEP_WARM. The range shrinks to whole pages.
  def __iyi_release_pages(address : UInt64, length : UInt64) : Nil
    start = (address &+ 4095_u64) & 0xFFFFFFFFFFFFF000_u64
    finish = (address &+ length) & 0xFFFFFFFFFFFFF000_u64
    return if finish <= start
    result = uninitialized Int64
    {% if flag?(:x86_64) %}
      asm("syscall" : "={rax}"(result)
                    : "{rax}"(28_i64), "{rdi}"(start),
                      "{rsi}"(finish &- start), "{rdx}"(4_i64)
                    : "rcx", "r11", "memory"
                    : "volatile")
    {% else %}
      asm("svc #0" : "={x0}"(result)
                   : "{x8}"(233_i64), "{x0}"(start),
                     "{x1}"(finish &- start), "{x2}"(4_i64)
                   : "memory"
                   : "volatile")
    {% end %}
  end
  fun __iyi_munmap(address : UInt64, length : UInt64) : Nil
    result = uninitialized Int64
    {% if flag?(:x86_64) %}
      asm("syscall" : "={rax}"(result)
                    : "{rax}"(11_i64), "{rdi}"(address), "{rsi}"(length)
                    : "rcx", "r11", "memory"
                    : "volatile")
    {% else %}
      asm("svc #0" : "={x0}"(result)
                   : "{x8}"(215_i64), "{x0}"(address), "{x1}"(length)
                   : "memory"
                   : "volatile")
    {% end %}
    if result < 0 && result >= -4095
      __iyi_write(2, "iyi: munmap failed\n".to_unsafe.as(Void*), 19_u64)
      __iyi_exit(1)
    end
  end
  {% end %}
  class IyiHeap
    TYPE_SHIFT = 32_u64
    def self.read64(address : UInt64) : UInt64
      Pointer(UInt64).new(address).value
    end
    def self.write64(address : UInt64, value : UInt64) : Nil
      Pointer(UInt64).new(address).value = value
    end
    def self.clear_block(start : UInt64, count : UInt64) : Nil
      words = Pointer(UInt64).new(start)
      filled = 0_u64
      while filled &+ 8_u64 <= count
        words.value = 0_u64
        words = words + 1_i64
        filled = filled &+ 8_u64
      end
      bytes = Pointer(UInt8).new(start &+ filled)
      while filled < count
        bytes.value = 0_u8
        bytes = bytes + 1_i64
        filled = filled &+ 1_u64
      end
    end

    def self.lock : Nil
      IyiRuntimeLock.lock
    end
    def self.unlock : Nil
      IyiRuntimeLock.unlock
    end
  end
  require "./region"
{% end %}
