# std/io: byte streams beyond the standard ones.
#
# The prelude's `IyiIO` reads and writes a descriptor. This module adds to
# it, on top of its public `read_bytes`/`write` only: `read_byte`,
# `write_byte`, `read_char`, `lines`, `each_line`, `<<` and `IyiIO.copy`.
# Positioning (`seek`, `pos`, `rewind`) is not offered on a descriptor
# stream: the prelude has no seek intrinsic and its read buffer would make
# a kernel offset a lie.
#
# `Memory` is an `IyiIO` over a byte buffer in memory: it grows as it is
# written, reads from a cursor that `pos=`, `rewind` and `clear` move, and
# `to_s` gives back everything written. Anything that takes an `IyiIO`
# takes a `Memory`.
#
# `Sized` reads at most a given number of bytes from another `IyiIO`;
# `Delimited` reads up to (and consumes) a byte delimiter, leaving the
# inner stream just past it; `MultiWriter` writes to several `IyiIO`s at
# once. All three are `IyiIO`s themselves: a reader refuses writes, the
# writer refuses reads, each with a sentence.
#
# `Hexdump` prints bytes sixteen to a line, as `hexdump -C` does: an
# eight-digit hex offset, the bytes in two groups of eight, the printable
# ASCII between bars.
#
# `ByteFormat::LittleEndian` / `BigEndian` encode and decode Int32, Int64,
# UInt64 and UInt8 into a String::Builder or an IyiIO, through
# unsigned byte arithmetic: every value, negative or not, round-trips.
# `SystemEndian` follows the target; `NetworkEndian` is big-endian.
#
# Refused: a negative count or limit, a position past the buffer, reading
# a closed stream, writing a reader, reading a writer, malformed UTF-8 in
# `read_char`, and a decode that runs out of bytes.

module std/io

class ::IyiIO
  def write_byte(byte : UInt8) : Nil
    b = byte
    write(pointerof(b), 1)
  end

  # The next UTF-8 code point, or nil at the end. A lead byte that is not
  # one (a continuation byte, C0/C1, F5 and above), a continuation byte that
  # is not one, or a sequence the stream ends inside is refused. The first
  # continuation byte is held to the range its lead allows (Unicode Table
  # 3-7), so an overlong form, a surrogate and a code point past U+10FFFF
  # are refused at the byte that gives them away, not decoded into a Char
  # outside Unicode.
  def read_char : Char?
    lead = read_byte
    return nil unless lead
    return lead.unsafe_chr if lead < 128_u8

    first_lo = 0x80_u8
    first_hi = 0xbf_u8
    if lead < 0xc2_u8
      raise "malformed UTF-8: byte #{lead} cannot begin a character"
    elsif lead <= 0xdf_u8
      code = (lead.to_i32 & 0x1f)
      needed = 1
    elsif lead <= 0xef_u8
      code = (lead.to_i32 & 0x0f)
      needed = 2
      first_lo = 0xa0_u8 if lead == 0xe0_u8
      first_hi = 0x9f_u8 if lead == 0xed_u8
    elsif lead <= 0xf4_u8
      code = (lead.to_i32 & 0x07)
      needed = 3
      first_lo = 0x90_u8 if lead == 0xf0_u8
      first_hi = 0x8f_u8 if lead == 0xf4_u8
    else
      raise "malformed UTF-8: byte #{lead} cannot begin a character"
    end

    while needed > 0
      follow = read_byte
      raise "truncated UTF-8: the stream ended inside a character starting with byte #{lead}" unless follow
      raise "malformed UTF-8: byte #{follow} cannot continue a character starting with byte #{lead}" if follow < first_lo || follow > first_hi
      code = (code << 6) | (follow.to_i32 & 0x3f)
      needed = needed - 1
      first_lo = 0x80_u8
      first_hi = 0xbf_u8
    end
    code.unsafe_chr
  end

  # Every remaining line, `chomp` dropping the line ends.
  def lines(chomp : Bool = false) : Array(String)
    result = [] of String
    while line = read_line(chomp)
      result << line
    end
    result
  end

  def each_line(chomp : Bool = false, &block : String -> Nil) : Nil
    while line = read_line(chomp)
      yield line
    end
  end

  # Everything left in `source` (at most `limit` bytes) written to
  # `target`, which is flushed; answers the number of bytes moved.
  # A pipe end's handle is copied through its checked `io`.
  def self.copy(source : Std::Io::PipeReader | IyiIO,
                target : Std::Io::PipeWriter | IyiIO,
                limit : Int32? = nil) : Int64
    from = source.is_a?(IyiIO) ? source : source.io
    to = target.is_a?(IyiIO) ? target : target.io
    copy_io(from, to, limit)
  end

  def self.copy_io(source : IyiIO, target : IyiIO, limit : Int32? = nil) : Int64
    raise "negative limit: #{limit}" if limit && limit < 0
    total = 0_i64
    while true
      want = 4096
      if limit
        left = limit - total.to_i32
        break if left <= 0
        want = left if left < want
      end
      chunk = source.read_bytes(want)
      break if chunk.bytesize == 0
      target.write(chunk)
      total = total + chunk.bytesize.to_i64
    end
    target.flush
    total
  end

  def <<(value) : self
    print(value)
    self
  end

  # The two ends of a pipe between tasks: what is written to the writer is
  # read from the reader, in order.
  #
  #     reader, writer = IyiIO.pipe
  #     group do |g|
  #       g.spawn { IyiIO.copy(file, writer); writer.close; 0 }
  #       g.spawn { IyiIO.copy(reader, socket.io); 0 }
  #     end
  #
  # An OS pipe on Linux and macOS: a write waits while the kernel's room
  # (64 KiB on Linux) is full, a read waits for bytes; both park on the
  # poller, never the thread. Closing the writer ends the reader after
  # the last byte; closing the reader refuses the next write (EPIPE, never
  # SIGPIPE). Other targets keep an in-process queue of writes.
  def self.pipe : {Std::Io::PipeReader, Std::Io::PipeWriter}
    {% if flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64)) || flag?(:darwin) %}
      pipe_of(Std::Io::PipeSys.make)
    {% else %}
      raise "IyiIO.pipe is only on Linux and macOS"
      {Std::Io::PipeReader.new, Std::Io::PipeWriter.new}
    {% end %}
  end

  {% if flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64)) || flag?(:darwin) %}
    # Handles over pooled ends: a pipe end may be handed to a task, so
    # it is not on the caller's tape; a closed end goes back to the pool
    # and a handle kept past its close is refused. The handles are built
    # in the caller's destination, a tuple of calls (SPEC 1.5).
    def self.pipe_of(fds) : {Std::Io::PipeReader, Std::Io::PipeWriter}
      {Std::Io::PipeReader.new(Std::Io::RisPipeEnd.take(fds[0], false)),
       Std::Io::PipeWriter.new(Std::Io::RisPipeEnd.take(fds[1], true))}
    end
  {% end %}
end

{% if flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64)) || flag?(:darwin) %}
  # The descriptors under `IyiIO.pipe`: both ends close-on-exec and
  # nonblocking, so a wait parks on the poller.
  module PipeSys
    {% if flag?(:darwin) %}
      lib LibPipe
        fun pipe(fds : Int32*) : Int32
        fun fcntl(fd : Int32, command : Int32, ...) : Int32
        fun write(fd : Int32, buffer : Void*, count : UInt64) : Int64
        fun error_location = __error : Int32*
      end

      def self.make : {Int32, Int32}
        pair = uninitialized Int32[2]
        fds = pointerof(pair).as(Int32*)
        raise "pipe: errno #{LibPipe.error_location.value}" if LibPipe.pipe(fds) != 0
        2.times do |i|
          fd = fds[i]
          LibPipe.fcntl(fd, 2, 1)                              # F_SETFD FD_CLOEXEC
          LibPipe.fcntl(fd, 4, LibPipe.fcntl(fd, 3) | 4)       # F_SETFL O_NONBLOCK
        end
        LibPipe.fcntl(fds[1], 73, 1)                           # F_SETNOSIGPIPE
        {fds[0], fds[1]}
      end

      # The count, or -errno.
      def self.write(fd : Int32, buffer : Pointer(UInt8), count : Int32) : Int64
        put = LibPipe.write(fd, buffer.as(Void*), count.to_u64)
        put < 0_i64 ? -(LibPipe.error_location.value.to_i64) : put
      end
    {% else %}
      {% if flag?(:x86_64) %}
        SYS_WRITE           =   1_i64
        SYS_FCNTL           =  72_i64
        SYS_PIPE2           = 293_i64
        SYS_RT_SIGPROCMASK  =  14_i64
        SYS_RT_SIGTIMEDWAIT = 128_i64
      {% else %}
        SYS_WRITE           =  64_i64
        SYS_FCNTL           =  25_i64
        SYS_PIPE2           =  59_i64
        SYS_RT_SIGPROCMASK  = 135_i64
        SYS_RT_SIGTIMEDWAIT = 137_i64
      {% end %}

      def self.make : {Int32, Int32}
        pair = uninitialized Int32[2]
        fds = pointerof(pair).as(Int32*)
        # O_CLOEXEC | O_NONBLOCK
        made = __iyi_conc_syscall3(SYS_PIPE2, fds.address.to_i64, 0x80800_i64, 0_i64)
        raise "pipe: errno #{-made}" if made < 0_i64
        {fds[0], fds[1]}
      end

      # The count, or -errno. A write to a pipe whose reader is gone raises
      # SIGPIPE on this thread: it is held for the write and taken off the
      # thread when the write answered EPIPE, as std/process's writes do.
      def self.write(fd : Int32, buffer : Pointer(UInt8), count : Int32) : Int64
        masks = uninitialized UInt64[4]
        at = pointerof(masks).as(UInt64*)
        at[0] = 1_u64.unsafe_shl(12_u64) # SIGPIPE, 13
        at[1] = 0_u64
        at[2] = 0_u64
        at[3] = 0_u64
        __iyi_conc_syscall6(SYS_RT_SIGPROCMASK, 0_i64, at.address.to_i64, (at + 1).address.to_i64, 8_i64, 0_i64, 0_i64)
        put = __iyi_conc_syscall3(SYS_WRITE, fd.to_i64, buffer.address.to_i64, count.to_i64)
        if put == -32_i64
          __iyi_conc_syscall6(SYS_RT_SIGTIMEDWAIT, at.address.to_i64, 0_i64, (at + 2).address.to_i64, 8_i64, 0_i64, 0_i64)
        end
        __iyi_conc_syscall6(SYS_RT_SIGPROCMASK, 2_i64, (at + 1).address.to_i64, 0_i64, 8_i64, 0_i64, 0_i64)
        put
      end
    {% end %}
  end

  # ris (SPEC 6): one end of an OS pipe, a pooled slot. Its object
  # and buffers are program storage taken once; closed, it goes back to
  # the pool and its generation moves, so a handle kept past the close
  # (`PipeReader`, `PipeWriter`) is refused instead of reading the next
  # pipe that reuses it.
  pub class RisPipeEnd < IyiIO
    @writer : Bool = false

    # A pooled slot (`RisPipeSlot`) holding a closed end, or a new end
    # and slot in program storage.
    def self.take(fd : Int32, writer : Bool) : RisPipeSlot
      slot = RisPipeSlot.take
      if slot.is_a?(RisPipeSlot)
        slot.io.as(RisPipeEnd).start(fd, writer)
        return slot
      end
      io = RisRegion.program_object(RisPipeEnd)
      RisRegion.program_scope { io.initialize(fd, writer) }
      io.start(fd, writer)
      RisPipeSlot.on_program(io)
    end

    def initialize(fd : Int32, writer : Bool)
      super(fd.to_i64, 4096, writer)
    end

    protected def start(fd : Int32, writer : Bool) : Nil
      reopen(fd.to_i64, writer)
      @writer = writer
    end

    # Closes the descriptor even when the last flush fails; the flush's
    # error still reaches the caller.
    def close_always : Nil
      defer { close_fd }
      close
    end

    private def close_fd : Nil
      return if closed?
      wake_closed(fd)
      __iyi_close(handle)
    end

    # A cancelled wait is withdrawn (-2), not the end: the next read waits
    # again.
    private def low_level_read(target_fd : Int64, buffer : Void*, count : UInt64) : Int64
      raise "a pipe's writer is not read from" if @writer && count >= 0_u64
      got = iyi_read(target_fd.to_i32, buffer, count)
      got.is_a?(Cancelled) ? -2_i64 : got
    end

    # A write returns when all of it is in the pipe.
    private def low_level_write(target_fd : Int64, buffer : Void*, count : UInt64) : Int64
      raise "a pipe's reader is not written to" unless @writer
      fd = target_fd.to_i32
      bytes = buffer.as(Pointer(UInt8))
      size = count.to_i64.to_i32
      done = 0
      while done < size
        put = PipeSys.write(fd, bytes + done, size - done)
        if put >= 0_i64
          done = done + put.to_i32
        elsif put == -11_i64 || put == -35_i64 # EAGAIN, Linux and macOS
          raise "a write to a full pipe, its task cancelled while it waited" if wait_writable(fd).is_a?(Cancelled)
        elsif put == -32_i64
          raise "a write to a pipe whose reader is closed"
        elsif put != -4_i64 # EINTR is tried again
          raise "a write to a pipe: errno #{-put}"
        end
      end
      count.to_i64
    end

    private def low_level_close(target_fd : Int64) : Nil
      wake_closed(target_fd.to_i32)
      __iyi_close(target_fd)
    end
  end

  # The reading end of `IyiIO.pipe`: a handle over a pooled end.
  @[OnTape]
  pub struct PipeReader
    @end : RisPipeSlot
    @generation : UInt64

    def initialize(@end : RisPipeSlot)
      @generation = @end.generation
    end

    # A joined task transfers the same handle, never a new fd.
    def __iyi_copy_into(target : Pointer(self), work : RisCopyWork) : Nil
      target.value = self
    end

    # The end as an `IyiIO`, for code that takes one (`IyiIO.copy`, a
    # response body); refused once this handle's end is closed.
    def io : IyiIO
      return @end.io if @end.generation == @generation
      raise "this pipe end is closed; its handle is not used after close"
    end

    def closed? : Bool
      @end.generation != @generation
    end

    # Closing twice is nothing: the end may already serve another pipe.
    def close : Nil
      return if closed?
      defer { @end.recycle }
      @end.io.as(RisPipeEnd).close_always
    end

    def fd : Int32
      io.fd
    end

    def eof? : Bool
      io.eof?
    end

    def read_failed? : Bool
      io.read_failed?
    end

    def read_byte : UInt8?
      io.read_byte
    end

    def read_bytes(count : Int32) : String
      io.read_bytes(count)
    end

    def read_str(count : Int32) : String
      io.read_str(count)
    end

    def read_str(count : Int32, into : String::Builder) : Int32
      io.read_str(count, into)
    end

    def read_line(chomp : Bool = false) : String?
      io.read_line(chomp)
    end

    def each_line(chomp : Bool = false, &block : String -> Nil) : Nil
      while line = io.read_line(chomp)
        yield line
      end
    end
  end

  # The writing end of `IyiIO.pipe`: a handle over a pooled end; a write
  # returns when all of it is in the pipe.
  @[OnTape]
  pub struct PipeWriter
    @end : RisPipeSlot
    @generation : UInt64

    def initialize(@end : RisPipeSlot)
      @generation = @end.generation
    end

    # A joined task transfers the same handle, never a new fd.
    def __iyi_copy_into(target : Pointer(self), work : RisCopyWork) : Nil
      target.value = self
    end

    # The end as an `IyiIO`; refused once this handle's end is closed.
    def io : IyiIO
      return @end.io if @end.generation == @generation
      raise "this pipe end is closed; its handle is not used after close"
    end

    def closed? : Bool
      @end.generation != @generation
    end

    # Closing twice is nothing: the end may already serve another pipe.
    def close : Nil
      return if closed?
      defer { @end.recycle }
      @end.io.as(RisPipeEnd).close_always
    end

    def fd : Int32
      io.fd
    end

    def write(text : String) : Nil
      io.write(text)
    end

    def print(value) : Nil
      io.print(value)
    end

    def puts(value) : Nil
      io.puts(value)
    end

    def <<(value) : self
      io.print(value)
      self
    end

    def flush : Nil
      io.flush
    end
  end
{% else %}
# Other targets have no pipe yet: `IyiIO.pipe` panics there, and these
# ends exist only so code that names them typechecks everywhere.
@[OnTape]
pub class PipeReader < IyiIO
  def initialize
    super(-1_i64, 4096, false)
  end

  private def low_level_read(target_fd : Int64, buffer : Void*, count : UInt64) : Int64
    raise "IyiIO.pipe is only on Linux and macOS" if count >= 0_u64
    -1_i64
  end

  private def low_level_write(target_fd : Int64, buffer : Void*, count : UInt64) : Int64
    raise "a pipe's reader is not written to" if count >= 0_u64
    -1_i64
  end

  private def low_level_close(target_fd : Int64) : Nil
  end
end

@[OnTape]
pub class PipeWriter < IyiIO
  def initialize
    super(-1_i64, 4096, true)
  end

  private def low_level_write(target_fd : Int64, buffer : Void*, count : UInt64) : Int64
    raise "IyiIO.pipe is only on Linux and macOS" if count >= 0_u64
    -1_i64
  end

  private def low_level_read(target_fd : Int64, buffer : Void*, count : UInt64) : Int64
    raise "a pipe's writer is not read from" if count >= 0_u64
    -1_i64
  end

  private def low_level_close(target_fd : Int64) : Nil
  end
end
{% end %}

# An `IyiIO` over bytes in memory. Writes land at the cursor and grow the
# buffer; reads advance the cursor; `to_s` is the whole buffer.
@[OnTape]
pub class Memory < IyiIO
  @buffer : Array(UInt8)
  @capacity : Int32
  @bytesize : Int32
  @pos : Int32
  @shut : Bool

  def initialize(capacity : Int32 = 64)
    raise "negative capacity: #{capacity}" if capacity < 0
    super(-1_i64, 16, false)
    @capacity = capacity < 16 ? 16 : capacity
    @buffer = Array(UInt8).new(@capacity, 0_u8)
    @bytesize = 0
    @pos = 0
    @shut = false
  end

  # A buffer holding a copy of `text`'s bytes, the cursor at its start.
  def initialize(text : String)
    super(-1_i64, 16, false)
    len = text.bytesize
    @capacity = len < 16 ? 16 : len
    @buffer = Array(UInt8).new(@capacity, 0_u8)
    len.times { |i| @buffer[i] = text[i] }
    @bytesize = len
    @pos = 0
    @shut = false
  end

  # Bytes held, written or given.
  def size : Int32
    @bytesize
  end

  def empty? : Bool
    @bytesize == 0
  end

  # The cursor, in bytes from the start. Int64, as a file's position is:
  # with `std/file` imported every `IyiIO` has a `pos : Int64`, and a
  # narrower answer here made `pos` on any `IyiIO` fail to compile.
  def pos : Int64
    @pos.to_i64
  end

  def pos=(position : Int32) : Nil
    raise "position #{position} out of range for #{@bytesize} bytes" if position < 0 || position > @bytesize
    @pos = position
  end

  # The cursor moved through an `IyiIO`: the stream's own position, not
  # the descriptor's that `std/file` would move.
  def pos=(position : Int64) : Int64
    raise "position #{position} out of range for #{@bytesize} bytes" if position < 0_i64 || position > @bytesize.to_i64
    @pos = position.to_i32
    position
  end

  def rewind : Nil
    @pos = 0
  end

  # Forgets every byte; the cursor returns to the start.
  def clear : Nil
    @bytesize = 0
    @pos = 0
  end

  def closed? : Bool
    @shut
  end

  def close : Nil
    @shut = true
  end

  def eof? : Bool
    @shut || @pos >= @bytesize
  end

  def flush : Nil
  end

  def to_s : String
    String.build(@bytesize) { |writer| @bytesize.times { |i| writer.push(@buffer[i]) } }
  end

  def read_byte : UInt8?
    raise "cannot read from closed IO" if @shut
    return nil if @pos >= @bytesize
    b = @buffer[@pos]
    @pos = @pos + 1
    b
  end

  def read_bytes(count : Int32) : String
    raise "cannot read from closed IO" if @shut
    raise "negative count: #{count}" if count < 0
    avail = @bytesize - @pos
    take = count < avail ? count : avail
    start = @pos
    @pos = @pos + take
    String.build(take) { |writer| take.times { |i| writer.push(@buffer[start + i]) } }
  end

  # Up to *count* bytes into the caller's builder; how many, 0 at the end.
  def read_str(count : Int32, into : String::Builder) : Int32
    raise "cannot read from closed IO" if @shut
    return 0 if count <= 0
    avail = @bytesize - @pos
    take = count < avail ? count : avail
    i = 0
    while i < take
      into.push(@buffer[@pos + i])
      i = i + 1
    end
    @pos = @pos + take
    take
  end

  def read_all : String
    read_bytes(@bytesize - @pos)
  end

  def read_line(chomp : Bool = false) : String?
    raise "cannot read from closed IO" if @shut
    return nil if @pos >= @bytesize

    start = @pos
    stop = @bytesize
    i = start
    while i < @bytesize
      if @buffer[i] == 10_u8
        stop = i + 1
        break
      end
      i = i + 1
    end
    @pos = stop

    len = stop - start
    # A `\r` is a line end only before the `\n`: a last line that ends in
    # one at the end of the stream keeps it, as the other library's does.
    if chomp && len > 0 && @buffer[start + len - 1] == 10_u8
      len = len - 1
      len = len - 1 if len > 0 && @buffer[start + len - 1] == 13_u8
    end
    String.build(len) { |writer| len.times { |i| writer.push(@buffer[start + i]) } }
  end

  def write(bytes : Pointer(UInt8), count : Int32) : Nil
    raise "cannot write to closed IO" if @shut
    return if count <= 0

    needed = @pos + count
    if needed > @capacity
      grown = @capacity * 2
      while grown < needed
        grown = grown * 2
      end
      while @buffer.size < grown
        @buffer << 0_u8
      end
      @capacity = grown
    end

    count.times { |i| @buffer[@pos + i] = bytes[i] }
    @pos = needed
    @bytesize = needed if needed > @bytesize
  end
end

# A reader built on `read_byte` alone; `Sized` and `Delimited` supply the
# byte and refuse writes.
@[OnTape]
pub abstract class Reader < IyiIO
  def initialize
    super(-1_i64, 16, false)
  end

  abstract def read_byte : UInt8?

  def flush : Nil
  end

  def close : Nil
  end

  # The buffer grows with what arrives, up to `count`: a count is a most,
  # and `Sized#read_all` asks for its whole limit, so allocating it up
  # front took 2 GB to read two bytes under a limit of Int32::MAX.
  def read_bytes(count : Int32) : String
    raise "negative count: #{count}" if count < 0
    writer = String::Builder.new(count < 256 ? count : 256)
    while writer.length < count
      byte = read_byte
      break unless byte
      writer.push(byte)
    end
    writer.finish
  end

  def read_all : String
    writer = String::Builder.new
    while byte = read_byte
      writer.push(byte)
    end
    writer.finish
  end

  def read_line(chomp : Bool = false) : String?
    writer = String::Builder.new
    while byte = read_byte
      writer.push(byte)
      break if byte == 10_u8
    end
    text = writer.finish
    return nil if text.empty?
    chomp ? text.chomp : text
  end

end

# At most `limit` bytes of another stream.
@[OnTape]
pub class Sized < Reader
  @io : IyiIO
  @remaining : Int32

  def initialize(@io : IyiIO, limit : Int32)
    raise "negative limit: #{limit}" if limit < 0
    super()
    @remaining = limit
  end

  # Bytes the limit still allows, whether or not the stream has them.
  def remaining : Int32
    @remaining
  end

  def eof? : Bool
    @remaining == 0 || @io.eof?
  end

  def read_byte : UInt8?
    return nil if @remaining == 0
    b = @io.read_byte
    @remaining = @remaining - 1 if b
    b
  end

  # The inner stream is asked for at most 64 KB at a time: a descriptor
  # stream's `read_bytes` allocates the whole count before it reads, and
  # `read_all` under a limit of Int32::MAX took 2 GB to read two bytes.
  def read_bytes(count : Int32) : String
    super(count)
  end

  def read_all : String
    read_bytes(@remaining)
  end

  def write(bytes : Pointer(UInt8), count : Int32) : Nil
    raise "cannot write to a Sized reader"
  end
end

# Another stream up to a delimiter. The delimiter is consumed and not
# answered; the inner stream is left just past it. Without a delimiter
# the whole rest of the stream is answered.
@[OnTape]
pub class Delimited < Reader
  @io : IyiIO
  @delimiter : String
  @matched : Int32
  @finished : Bool
  @out : Array(UInt8)
  @out_pos : Int32
  @out_len : Int32

  def initialize(@io : IyiIO, @delimiter : String)
    raise "empty delimiter" if @delimiter.bytesize == 0
    super()
    @matched = 0
    @finished = false
    @out = Array(UInt8).new(@delimiter.bytesize + 1, 0_u8)
    @out_pos = 0
    @out_len = 0
  end

  def delimiter : String
    @delimiter
  end

  # Exact, as the prelude's is: the inner stream is read until a content
  # byte is held or the delimiter (or the end) is met. Answering from the
  # inner stream alone said "not yet" with nothing but the delimiter left,
  # and the next read answered nil.
  def eof? : Bool
    while @out_pos >= @out_len
      return true if @finished
      pull
    end
    false
  end

  def read_byte : UInt8?
    while @out_pos >= @out_len
      return nil if @finished
      pull
    end
    b = @out[@out_pos]
    @out_pos = @out_pos + 1
    b
  end

  # One byte of the inner stream into the held content, or the end.
  private def pull : Nil
    @out_pos = 0
    @out_len = 0
    b = @io.read_byte
    if b
      feed(b)
    else
      # The stream ended holding a prefix of the delimiter: those bytes
      # were content after all.
      @finished = true
      held = @matched
      @matched = 0
      i = 0
      while i < held
        @out[i] = @delimiter[i]
        i = i + 1
      end
      @out_len = held
    end
  end

  # One byte from the inner stream against the delimiter: matched bytes
  # are held back; on a mismatch the first held byte is content and the
  # rest, then `b`, are matched again from the start.
  private def feed(b : UInt8) : Nil
    pattern = @delimiter
    if b == pattern[@matched]
      @matched = @matched + 1
      if @matched == @delimiter.bytesize
        @finished = true
        @matched = 0
      end
    elsif @matched == 0
      @out[@out_len] = b
      @out_len = @out_len + 1
    else
      held = @matched
      @matched = 0
      @out[@out_len] = pattern[0]
      @out_len = @out_len + 1
      i = 1
      while i < held
        feed(pattern[i])
        i = i + 1
      end
      feed(b)
    end
  end

  def write(bytes : Pointer(UInt8), count : Int32) : Nil
    raise "cannot write to a Delimited reader"
  end
end

# One stream written to several. `close` closes this writer, not the
# streams behind it.
@[OnTape]
pub class MultiWriter < IyiIO
  @writers : Array(IyiIO)
  @shut : Bool

  def initialize(@writers : Array(IyiIO))
    super(-1_i64, 16, false)
    @shut = false
  end

  def write(bytes : Pointer(UInt8), count : Int32) : Nil
    raise "cannot write to closed IO" if @shut
    return if count <= 0
    @writers.each do |writer|
      writer.write(bytes, count)
    end
  end

  def flush : Nil
    @writers.each do |writer|
      writer.flush
    end
  end

  def close : Nil
    flush
    @shut = true
  end

  def closed? : Bool
    @shut
  end

  def eof? : Bool
    true
  end

  def read_byte : UInt8?
    raise "cannot read from a MultiWriter"
  end

  def read_bytes(count : Int32) : String
    raise "cannot read from a MultiWriter"
  end

  def read_all : String
    raise "cannot read from a MultiWriter"
  end

  def read_line(chomp : Bool = false) : String?
    raise "cannot read from a MultiWriter"
  end
end

# Bytes printed sixteen to a line, `hexdump -C` style, on an `IyiIO`.
@[OnTape]
pub class Hexdump
  HEX = "0123456789abcdef"

  @out : IyiIO

  def initialize(@out : IyiIO)
  end

  private def dump_bytes(bytes : String, count : Int32) : Nil
    raise "negative count: #{count}" if count < 0
    line = Array(UInt8).new(80, 0_u8)
    writer = String::Builder.new
    hex = HEX
    offset = 0
    while offset < count
      chunk = count - offset
      chunk = 16 if chunk > 16

      value = offset
      i = 7
      while i >= 0
        line[i] = hex[value & 0x0f]
        value = value >> 4
        i = i - 1
      end
      line[8] = 32_u8
      line[9] = 32_u8

      at = 10
      i = 0
      while i < 16
        if i == 8
          line[at] = 32_u8
          at = at + 1
        end
        if i < chunk
          b = bytes[offset + i]
          line[at] = hex[(b.to_i32 >> 4) & 0x0f]
          line[at + 1] = hex[b.to_i32 & 0x0f]
        else
          line[at] = 32_u8
          line[at + 1] = 32_u8
        end
        line[at + 2] = 32_u8
        at = at + 3
        i = i + 1
      end

      line[at] = 32_u8
      line[at + 1] = 124_u8
      at = at + 2
      i = 0
      while i < chunk
        b = bytes[offset + i]
        line[at] = (b >= 32_u8 && b <= 126_u8) ? b : 46_u8
        at = at + 1
        i = i + 1
      end
      line[at] = 124_u8
      line[at + 1] = 10_u8
      writer.clear
      (at + 2).times { |i| writer.push(line[i]) }
      @out.write(writer.finish)

      offset = offset + chunk
    end
    @out.flush
  end

  def dump(text : String) : Nil
    dump_bytes(text, text.bytesize)
  end

  # Everything left in `source`.
  def dump(source : IyiIO) : Nil
    dump(source.read_all)
  end
end

pub struct ByteFormat
  # Two's complement by arithmetic, so a negative value never meets an
  # unsigned conversion: the bit pattern of a signed integer as a UInt64
  # and back.
  struct Bits
    def self.of_int64(value : Int64) : UInt64
      return value.to_u64 if value >= 0_i64
      0xFFFFFFFFFFFFFFFF_u64 - (-(value + 1_i64)).to_u64
    end

    def self.to_int64(bits : UInt64) : Int64
      return bits.to_i64 if bits < 0x8000000000000000_u64
      -((0xFFFFFFFFFFFFFFFF_u64 - bits).to_i64) - 1_i64
    end

    def self.of_int32(value : Int32) : UInt64
      return value.to_u64 if value >= 0
      0x100000000_u64 - (-(value.to_i64)).to_u64
    end

    def self.to_int32(bits : UInt64) : Int32
      return bits.to_i32 if bits < 0x80000000_u64
      (bits.to_i64 - 0x100000000_i64).to_i32
    end

    # The low `count` bytes of `bits`, least significant first.
    def self.put_little(bits : UInt64, buffer : String::Builder | IyiIO, count : Int32) : Nil
      i = 0
      while i < count
        buffer.write_byte((bits & 0xff_u64).to_u8)
        bits = bits.unsafe_shr(8_u64)
        i = i + 1
      end
    end

    def self.put_big(bits : UInt64, buffer : String::Builder | IyiIO,
                     count : Int32) : Nil
      i = count - 1
      while i >= 0
        buffer.write_byte(((bits.unsafe_shr((i * 8).to_u64)) & 0xff_u64).to_u8)
        i -= 1
      end
    end

    def self.get_little(buffer : String, count : Int32) : UInt64
      bits = 0_u64
      i = count - 1
      while i >= 0
        bits = bits.unsafe_shl(8_u64) | buffer[i].to_u64
        i = i - 1
      end
      bits
    end

    def self.get_big(buffer : String, count : Int32) : UInt64
      bits = 0_u64
      i = 0
      while i < count
        bits = bits.unsafe_shl(8_u64) | buffer[i].to_u64
        i = i + 1
      end
      bits
    end

    # `count` bytes out of `io`, or a refusal naming the shortfall.
    def self.take(io : IyiIO, count : Int32) : String
      chunk = io.read_bytes(count)
      raise "unexpected end of input: needed #{count} bytes, got #{chunk.bytesize}" if chunk.bytesize < count
      chunk
    end
  end

  pub struct LittleEndian
    def self.encode(value : Int32, buffer : String::Builder | IyiIO) : Nil
      Bits.put_little(Bits.of_int32(value), buffer, 4)
    end

    def self.encode(value : Int64, buffer : String::Builder | IyiIO) : Nil
      Bits.put_little(Bits.of_int64(value), buffer, 8)
    end

    def self.encode(value : UInt64, buffer : String::Builder | IyiIO) : Nil
      Bits.put_little(value, buffer, 8)
    end

    def self.encode(value : UInt8, buffer : String::Builder | IyiIO) : Nil
      buffer.write_byte(value)
    end





    def self.decode_int32(buffer : String) : Int32
      Bits.to_int32(Bits.get_little(buffer, 4))
    end

    def self.decode_int64(buffer : String) : Int64
      Bits.to_int64(Bits.get_little(buffer, 8))
    end

    def self.decode_uint64(buffer : String) : UInt64
      Bits.get_little(buffer, 8)
    end

    def self.decode_uint8(buffer : String) : UInt8
      buffer[0]
    end

    def self.decode_int32(io : IyiIO) : Int32
      Bits.to_int32(Bits.get_little(Bits.take(io, 4), 4))
    end

    def self.decode_int64(io : IyiIO) : Int64
      Bits.to_int64(Bits.get_little(Bits.take(io, 8), 8))
    end

    def self.decode_uint64(io : IyiIO) : UInt64
      Bits.get_little(Bits.take(io, 8), 8)
    end

    def self.decode_uint8(io : IyiIO) : UInt8
      Bits.take(io, 1)[0]
    end
  end

  pub struct BigEndian
    def self.encode(value : Int32, buffer : String::Builder | IyiIO) : Nil
      Bits.put_big(Bits.of_int32(value), buffer, 4)
    end

    def self.encode(value : Int64, buffer : String::Builder | IyiIO) : Nil
      Bits.put_big(Bits.of_int64(value), buffer, 8)
    end

    def self.encode(value : UInt64, buffer : String::Builder | IyiIO) : Nil
      Bits.put_big(value, buffer, 8)
    end

    def self.encode(value : UInt8, buffer : String::Builder | IyiIO) : Nil
      buffer.write_byte(value)
    end





    def self.decode_int32(buffer : String) : Int32
      Bits.to_int32(Bits.get_big(buffer, 4))
    end

    def self.decode_int64(buffer : String) : Int64
      Bits.to_int64(Bits.get_big(buffer, 8))
    end

    def self.decode_uint64(buffer : String) : UInt64
      Bits.get_big(buffer, 8)
    end

    def self.decode_uint8(buffer : String) : UInt8
      buffer[0]
    end

    def self.decode_int32(io : IyiIO) : Int32
      Bits.to_int32(Bits.get_big(Bits.take(io, 4), 4))
    end

    def self.decode_int64(io : IyiIO) : Int64
      Bits.to_int64(Bits.get_big(Bits.take(io, 8), 8))
    end

    def self.decode_uint64(io : IyiIO) : UInt64
      Bits.get_big(Bits.take(io, 8), 8)
    end

    def self.decode_uint8(io : IyiIO) : UInt8
      Bits.take(io, 1)[0]
    end
  end

  # Every architecture the compiler initialises a machine for (x86_64,
  # aarch64, arm, i386, wasm32) stores its low byte first; a big-endian
  # target arriving takes the other branch.
  {% if flag?(:x86_64) || flag?(:aarch64) || flag?(:arm) || flag?(:i386) || flag?(:wasm32) %}
    pub alias SystemEndian = LittleEndian
  {% else %}
    pub alias SystemEndian = BigEndian
  {% end %}

  pub alias NetworkEndian = BigEndian
end
