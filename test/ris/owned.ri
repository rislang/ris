module test/ris/owned

# A retained destination says what it accepts in its interface.
class Cache
  getter body : String

  def initialize
    @body = ""
  end

  def store(body : String) : Nil
    @body = body
  end
end

# A method name describes the work; the return type describes the lifetime.
def page : Tape::String
  Tape::String.build(1) { |writer| writer.append("café <&>") }
end

def retained_page : String
  Tape.run do
    return page.to_s
  end
  ""
end

cache = Cache.new
Tape.run do
  borrowed = page
  owned = borrowed.to_s
  cache.store(owned)
  raise "copy differs from source" unless borrowed == owned && borrowed.to_s == "café <&>"
  empty = Tape::String.build(0) { |writer| }
  raise "empty copy changed" unless empty.to_s == ""
end
Tape.run do
  overwrite = page
end
raise "retained text changed after scope reuse" unless cache.body == "café <&>"
raise "owned return changed" unless retained_page == "café <&>"
raise "return left tape active" unless IyiRegion.tape == 0_u64
puts "PASS: explicit owned copy, typed cache boundary, UTF-8, empty text and scope reuse"
