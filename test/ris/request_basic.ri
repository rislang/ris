module test/ris/request_basic

group do |g|
  w = g.new_worker(Str | RisInbox::Request(Str, Str), 4) do |inbox|
    plain = inbox.receive
    raise "plain" unless plain == Str.new("plain")
    req = inbox.receive
    if req.is_a?(RisInbox::Request(Str, Str))
      raise "message" unless req.message == Str.new("hello")
      raise "reply" unless req.reply(Str.new("world")).nil?
    else
      raise "request"
    end
  end
  w.send(Str.new("plain"))
  result = w.request(Str.new("hello"), 1000)
  raise "round trip" unless result == Str.new("world")
end
# Payload and reply union tags survive concrete argument specialization.
group do |g|
  w = g.new_worker(RisInbox::Request(Int32 | Str, Int32 | Str), 2) do |q|
    2.times do
      req = q.receive
      if req.is_a?(RisInbox::Request(Int32 | Str, Int32 | Str))
        req.reply(req.message)
      end
    end
    nil
  end
  raise "scalar union" unless w.request(7, 1000) == 7
  raise "text union" unless w.request(Str.new("tagged"), 1000) == Str.new("tagged")
end
puts "PASS: request basic"
