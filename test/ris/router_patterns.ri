# A Pattern views the text it was read from and holds no data of its own
# (doc/drafts/checker-open-questions/, Q3; SPEC 2.1): the router keeps
# them in a flat Array(Pattern). Silent on success.
import std/router::{Router, Pattern, RouterError, Captures}

a = Pattern.parse("GET /users/{id}").or_panic
bad = Pattern.parse("/{id}/x/{id}")
raise "a doubled name is refused" unless bad.is_a?(RouterError) && bad.message.includes?("two wildcards")
b = Pattern.parse("/users/").or_panic
c = Pattern.parse("/a/{x}").or_panic
d = Pattern.parse("/{y}/b").or_panic

raise "to_s #{a.to_s}" unless a.to_s == "GET /users/{id}" && a.method == "GET" && a.host == ""
raise "relation" unless a.relation(b) == Pattern::MORE_SPECIFIC && b.more_specific?(a) == false
raise "conflict" unless (c.conflict(d) || "").includes?("neither is more specific")
got = Captures.new
raise "matches" unless a.match("/users/42", [] of String, String::Builder.new, got) && got["id"] == "42"
raise "no empty id" if a.match("/users/", [] of String, String::Builder.new, nil)

router = Router.new
router.handle("GET /items/{name}") { |_, res, params| res.body << params["name"] }
raise "registered #{router.patterns.size}" unless router.patterns.size == 1 && router.patterns[0].to_s == "GET /items/{name}"
