module test/ris/lifetime_flow
import std/int

def make_text : Tape::String
  return Tape::String.build { |w| w.push(65_u8) }
end

def with_text(&)
  tape { yield make_text }
end

def forward(&)
  yield
end

with_text { |text| puts text }
tape do
  kept = nil
  items = Tape::Array(Tape::String).new(0)
  items.push(make_text)
  items.each { |text| kept = text }
  if text = kept
    puts text
  end
  nested = tape { break make_text }
  if text = nested
    puts text
  end
  forward do
    local = make_text
    puts local
  end
end
