# A value's own to_s, called by the runtime's interpolation, is checked
# as any def is (SPEC 3.4): each round's text is freed with the round,
# so storing it into the outer Array is refused.
@[OnTape]
struct Pair
  def initialize(@a : Array(Int32))
  end

  def to_s : String
    parts = [] of String
    @a.each { |v| parts << v.inspect }
    parts.join(",")
  end
end

tape do
  puts "#{Pair.new([1, 2])}"
end
