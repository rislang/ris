module test/ris/request_enum

# A private scalar type remains usable through a generic inbox or envelope.
enum Flag : UInt64
  High = 9223372036854775808_u64
end

group do |g|
  w = g.new_worker(Flag | RisInbox::Request(Flag, Flag), 2) do |q|
    raise "plain enum" unless q.receive == Flag::High
    req = q.receive
    if req.is_a?(RisInbox::Request(Flag, Flag))
      raise "enum payload" unless req.message == Flag::High
      raise "enum reply" unless req.reply(req.message).nil?
    end
    nil
  end
  w.send(Flag::High)
  raise "enum round trip" unless w.request(Flag::High, 1000) == Flag::High
end
puts "PASS: request enum"
