# A server for `test/cli/std_http_exercise.sh` to drive from Python: prints
# its port, serves until `/stop`, echoes what it was sent. Compressing,
# so Python's gzip reads what it sends, and reading multipart bodies.
module bench/std_http_server

# The probe owns its socket only until it chooses a nonzero pool port.
# Ready and Stop are keyed by factory, so simultaneous pools do not steal
# one another's lifecycle messages. Stop gives the answer time to flush.
import std/file::{File}

module RisExerciseServer
  struct RisReady(H)
  end

  struct RisStop(H)
  end

  @[OnTape]
  struct RisConfig(C, H)
    getter value : C

    def initialize(@value)
    end
  end

  def self.port : Int32
    probe = IyiSocket.listen("127.0.0.1", 0)
    port = probe.local_port
    probe.close
    port
  end

  def self.ready(handler : H.class) : Nil forall H
    raise "ready queue full" unless RisBoard.post(RisReady(H).new)
  end

  def self.wait(handler : H.class) : Nil forall H
    ready = RisBoard.take(RisReady(H), 10000_i64)
    raise "cancelled before listening" if ready.is_a?(Cancelled)
    raise "server did not listen within 10 s" unless ready[1]
  end

  def self.stop(handler : H.class) : Nil forall H
    raise "stop queue full" unless RisBoard.post(RisStop(H).new)
  end

  def self.answer(port : Int32, config : C, handler : H.class,
                 stream_bodies : Bool = false, compress : Bool = false,
                 timeout_ms : Int32 = 60000,
                 request_timeout_ms : Int32 = Server::REQUEST_TIMEOUT,
                 max_connections : Int32 = 64,
                 print_port : Bool = false,
                 port_file : String? = nil) : Nil forall C, H
    raise "config queue full" unless RisBoard.post(RisConfig(C, H).new(config))
    group do |pool|
      pool.spawn do
        copied = RisBoard.take(RisConfig(C, H))
        unless copied.is_a?(Cancelled)
          Server.answer("127.0.0.1", port, copied.value, handler,
            stream_bodies: stream_bodies, compress: compress,
            timeout_ms: timeout_ms, request_timeout_ms: request_timeout_ms,
            max_connections: max_connections)
        end
        0
      end
      pool.spawn do
        unless RisBoard.take(RisStop(H)).is_a?(Cancelled)
          sleep(50)
          pool.cancel_children
        end
        0
      end
      if print_port || port_file
        wait(handler)
        puts port if print_port
        File.write(port_file, port.to_s) if port_file
      end
      0
    end
  end
end

class RisHttpPeerHandler
  def initialize(config)
  end

  def listening(port : Int32) : Nil
    RisExerciseServer.ready(RisHttpPeerHandler)
  end

  def call(req : Incoming, res : Outgoing) : Nil
    if req.path == "/stop"
      RisExerciseServer.stop(RisHttpPeerHandler)
      res.body << "stopping"
    elsif req.path == "/echo"
      res.header("X-Method", req.method)
      res.header("X-Query", req.query || "-")
      res.header("Content-Type", req.header("Content-Type") || "-")
      res.body << req.body
    elsif req.path == "/big"
      res.body << "x" * 1000000
    elsif req.path == "/text"
      res.header("Content-Type", "text/plain")
      res.body << "all work and no play makes jack a dull boy\n" * 2500
    elsif req.path == "/stream"
      res.header("Content-Type", "text/plain")
      res.stream do |w|
        10.times { |i| w.write("piece #{i} " * 100 + "\n") }
      end
    elsif req.path == "/parts"
      boundary = Multipart.boundary(req.header("Content-Type") || "")
      if boundary
        parts = Multipart.new(req.body_io, boundary)
        while true
          part = parts.next_part.or_panic
          break unless part
          res.body << (part.name || "-") << "|" << (part.filename || "-") <<
            "|" << (part.content_type || "-") << "|" <<
            part.read_all.or_panic << ";"
        end
      end
    else
      res.status = 404
      res.body << "no " << req.path << "\n"
    end
  end
end

import std/http::{Server, Incoming, Outgoing, Multipart}
import std/socket::{IyiSocket}

listener = RisExerciseServer.port
RisExerciseServer.answer(listener, 0, RisHttpPeerHandler, compress: true, print_port: true)
puts "stopped"
