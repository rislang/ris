module test/ris/resource_moves
import std/io

reader, writer = IyiIO.pipe
# The writer moves at successful creation, before the child can run.
group do |g|
  task = g.new_task(owns: writer) do
    writer.puts("moved")
    writer.close
    42
  end
  raise "pipe data" unless reader.read_line(true) == "moved"
  raise "task value" unless task.value == 42
end
reader.close

reader2, writer2 = IyiIO.pipe
group do |g|
  worker = g.new_worker(Int32, 1, owns: writer2) do |inbox|
    got = inbox.receive
    writer2.puts("worker") if got == 1
    0
  end
  worker.send(1)
  raise "worker pipe" unless reader2.read_line(true) == "worker"
end
raise "worker did not close owned writer" unless reader2.read_line.nil?
reader2.close

reader3, writer3 = IyiIO.pipe
group do |g|
  g.cancel_children
  child = g.new_task(owns: writer3) { 0 }
  child.value
end
raise "cancelled receiver leaked writer" unless reader3.read_line.nil?
reader3.close
puts "PASS: resource moves"
