tape do
  pool = SlicePool(Int32).new(4)
  run = pool.alloc_slice(2)
  other = SlicePool(Int32).new(4)
  case Program.arguments[0]
  when "negative"
    pool.alloc_slice(-1)
  when "overflow"
    pool.alloc_slice(9223372036854775807_i64)
  when "realloc_overflow"
    pool.realloc_slice(run, 9223372036854775807_i64)
  when "constructor"
    SlicePool(Int32).new(-1)
  when "foreign"
    pool.free_slice(other.alloc_slice(1))
  when "foreign_realloc"
    pool.realloc_slice(other.alloc_slice(1), 3)
  when "bounds"
    run[2]
  when "slice"
    run[1, 2]
  when "run_negative_offset"
    SlicePool::Run(Int32).new(Ary(Int32).new, -1, 0)
  when "run_negative_size"
    SlicePool::Run(Int32).new(Ary(Int32).new, 0, -1)
  when "run_overflow"
    SlicePool::Run(Int32).new(Ary(Int32).new, 2147483647, 2147483647)
  when "run_past_end"
    SlicePool::Run(Int32).new(Ary(Int32).new(4), 0, 1)
  when "borrowed_foreign"
    data = Ary(Int32).new(1) { 7 }
    pool.free_slice(SlicePool::Run(Int32).new(data, 0, 1))
  when "negative_realloc"
    pool.realloc_slice(run, -1)
  end
end
