def consume_byte(byte : UInt8, ignored : Nil)
  raise "byte" unless byte == 97_u8
end

def refill
  b = Str::Builder.new
  b << "abc"
  view = b.finish
  raise "view" unless view == "abc"
  b.clear
  b << "def"
  copied = b.finish.copy_to(Program.tape)
  b.truncate(1)
  b.shift(1)
  raise "copy" unless copied == "def"
  b << "abc"
  consume_byte(b.finish[0], b.clear)
  stale = b.finish
  stale = Str.new("independent")
  b.clear
  raise "rebind" unless stale == "independent"
  a = Ary(Int32).new
  a << 1
  index = 0
  raise "index" unless a[index] == 1
  indexes = Ary(Int32).new
  indexes << 0
  selected = a.values_at(indexes)
  raise "selected" unless selected[0] == 1
  a.pop
  a.clear
  3.times do
    b.clear
    b << "again"
    text = b.finish
    raise "refill" unless text == "again"
  end
  n = 0
  while n < 3
    b.clear
    b << "while"
    text = b.finish
    raise "while refill" unless text == "while"
    2.times do
      a.clear
      a << n
      a.each do |item|
        raise "nested refill" unless item == n
      end
    end
    n += 1
  end
  until n == 6
    b.clear
    b << "until"
    text = b.finish
    raise "until refill" unless text == "until"
    n += 1
  end
  loop do
    b.clear
    b << "loop"
    text = b.finish
    raise "loop refill" unless text == "loop"
    break
  end
end

tape { refill }
puts "PASS: shrink refill"
