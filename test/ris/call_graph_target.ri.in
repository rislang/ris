# Both checker probes keep the same dispatch and proc specializations.
@[Ffi]
module call_graph_target

class Workspace
  getter bytes : Array(UInt8)

  def initialize
    @bytes = Array(UInt8).new
  end
end

class Left
  def invoke(callback)
    callback.call
  end
end

class Right
  def invoke(callback)
    callback.call
  end
end

def exercise(left : Bool)
  target = left ? Left.new : Right.new
  target.invoke(-> do
    @OPERATION@
    nil
  end)
end

tape { exercise(true) }
