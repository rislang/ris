module test/ris/inbox_cancel

group do |g|
  owner = g.spawn do
    q = g.new_inbox(Str, 2)
    g.spawn do
      sleep(1)
      q.send(Str.new("retained"))
      g.cancel_children
      nil
    end
    raise "cancelled wait" unless q.receive.is_a?(Cancelled)
    raise "cancel kept mail" unless q.size == 1
    raise "cancel send ignored" unless q.send(Str.new("also retained")).nil?
    raise "cancel count" unless q.size == 2
    q.close
    raise "closed beats full" unless q.send(Str.new("late")).is_a?(RisInbox::Closed)
    nil
  end
  owner.value
end
puts "PASS: inbox cancel"
