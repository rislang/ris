# Closed resource universe for the first ownership step. A resource has
# shared descriptor/close state; copies never duplicate the OS resource.
abstract class RisResourceResult
  property next_result : RisResourceResult? = nil
  def retire : Nil
  end
end

struct RisResultOwner
  def initialize(@group : IyiGroup)
  end

  def run(&)
    return yield if @group.result_depth > 0
    @group.result_depth += 1
    saved = RisRegion.tape
    @group.result_tape = RisRegion.acquire(Tape::CAPACITY) if @group.result_tape == 0_u64
    RisRegion.tape = @group.result_tape
    defer restore(saved)
    yield
  end

  def restore(saved : UInt64) : Nil
    @group.result_tape = RisRegion.tape
    @group.result_depth -= 1
    RisRegion.tape = saved
  end
end

struct RisCurrentResultOwner
  def run(&)
    yield
  end
end

module RisResources
  def self.check_owned(type : T.class) : Nil forall T
    {% unless T.name == "Std::Socket::IyiSocket" ||
              T.name == "Std::Io::PipeReader" ||
              T.name == "Std::Io::PipeWriter" %}
      {% raise "owns: needs a socket or pipe end; do this work in the receiving task, or send it a message" %}
    {% end %}
  end

  def self.contains(type : T.class, path : P.class = Tuple()) : Bool forall T, P
    {% if P.type_vars.includes?(T) %}
      return false
    {% elsif T.name == "Std::Socket::IyiSocket" ||
          T.name == "Std::Io::PipeReader" ||
          T.name == "Std::Io::PipeWriter" %}
      return true
    {% elsif T.union? %}
      {% for arm in T.union_types %}
        return true if contains({{arm}}, Tuple(*P, T))
      {% end %}
    {% elsif T.name.starts_with?("Ary(") %}
      return contains({{T.type_vars[0]}}, Tuple(*P, T))
    {% elsif T < Tuple %}
      {% for part in T.type_vars %}
        return true if contains({{part}}, Tuple(*P, T))
      {% end %}
    {% elsif T < NamedTuple %}
      {% for key in T.keys %}
        return true if contains({{T[key]}}, Tuple(*P, T))
      {% end %}
    {% elsif (T.struct? || T.class?) && !(T == String || T < Number || T < Enum || T == Bool || T == Char || T == Symbol || T == Nil || T == Str || T < Pointer) %}
      {% for field in T.instance_vars %}
        return true if contains({{field.type}}, Tuple(*P, T))
      {% end %}
    {% end %}
    false
  end

  def self.check_value(type : T.class, path : P.class = Tuple()) : Nil forall T, P
    {% if P.type_vars.includes?(T) %}
      return
    {% elsif T.name == "Std::Socket::IyiSocket" ||
          T.name == "Std::Io::PipeReader" ||
          T.name == "Std::Io::PipeWriter" %}
      {% raise "value refuses a resource result; use task.take" %}
    {% elsif T.union? %}
      {% for arm in T.union_types %}
        check_value({{arm}}, Tuple(*P, T))
      {% end %}
    {% elsif T.name.starts_with?("Ary(") %}
      check_value({{T.type_vars[0]}}, Tuple(*P, T))
    {% elsif T < Tuple %}
      {% for part in T.type_vars %}
        check_value({{part}}, Tuple(*P, T))
      {% end %}
    {% elsif T < NamedTuple %}
      {% for key in T.keys %}
        check_value({{T[key]}}, Tuple(*P, T))
      {% end %}
    {% elsif (T.struct? || T.class?) && !(T == String || T < Number || T < Enum || T == Bool || T == Char || T == Symbol || T == Nil || T == Str || T < Pointer) %}
      {% for field in T.instance_vars %}
        check_value({{field.type}}, Tuple(*P, T))
      {% end %}
    {% end %}
  end

  # No user copy callbacks run in a result transaction. Resource handles
  # remain identities; only the copyable parts acquire destination bytes.
  def self.stage(value : T, owner, path : P.class = Tuple()) : T forall T, P
    {% if P.type_vars.includes?(T) %}
      value
    {% elsif T.name == "Std::Socket::IyiSocket" ||
          T.name == "Std::Io::PipeReader" ||
          T.name == "Std::Io::PipeWriter" %}
      value
    {% elsif T.union? %}
      {% for arm in T.union_types %}
        return stage(value, owner, Tuple(*P, T)) if value.is_a?({{arm}})
      {% end %}
      value
    {% elsif T == Str || T == Str::Builder || T.name.starts_with?("Tre(") || T.name.starts_with?("SlicePool::Run(") || T.name.starts_with?("SlicePool::List(") %}
      value.copy_to(owner)
    {% elsif T.name.starts_with?("Ary(") %}
      owner.run do
        Ary({{T.type_vars[0]}}).new(value.size) do |i|
          stage(value[i], owner, Tuple(*P, T))
        end
      end
    {% elsif T < Tuple %}
      { {% for part, i in T.type_vars %} stage(value[{{i}}], owner, Tuple(*P, T)), {% end %} }
    {% elsif T < NamedTuple %}
      { {% for key in T.keys %} {{key.id}}: stage(value[{{key.symbolize}}], owner, Tuple(*P, T)), {% end %} }
    {% elsif T.struct? && !(T == String || T < Number || T < Enum || T == Bool || T == Char || T == Symbol || T == Nil || T < Pointer) %}
      made = value
      {% for field in T.instance_vars %}
        pointerof(made.@{{field.name.id}}).value = stage(value.@{{field.name.id}}, owner, Tuple(*P, T))
      {% end %}
      made
    {% elsif T.class? && T != String %}
      if contains(T)
        owner.run do
          made = {{T}}.allocate
          {% for field in T.instance_vars %}
            pointerof(made.@{{field.name.id}}).value = stage(value.@{{field.name.id}}, owner, Tuple(*P, T))
          {% end %}
          made
        end
      else
        {% if T.annotation(::OnTape) %}
          value.copy_to(owner)
        {% else %}
          value
        {% end %}
      end
    {% else %}
      value
    {% end %}
  end

  # Shared state makes a child's deferred close inert once the group slot
  # holds the result. A take changes that state only after staging succeeds.
  def self.visit(value : T, action : Symbol, identity : UInt64, path : P.class = Tuple()) : Nil forall T, P
    {% if P.type_vars.includes?(T) %}
      return
    {% elsif T.name == "Std::Socket::IyiSocket" ||
          T.name == "Std::Io::PipeReader" ||
          T.name == "Std::Io::PipeWriter" %}
      value.__ris_resource(action, identity)
    {% elsif T.union? %}
      {% for arm in T.union_types %}
        if value.is_a?({{arm}})
          visit(value, action, identity, Tuple(*P, T))
          return
        end
      {% end %}
    {% elsif T.name.starts_with?("Ary(") %}
      value.each { |part| visit(part, action, identity, Tuple(*P, T)) }
    {% elsif T < Tuple %}
      {% for part, i in T.type_vars %}
        visit(value[{{i}}], action, identity, Tuple(*P, T))
      {% end %}
    {% elsif T < NamedTuple %}
      {% for key in T.keys %}
        visit(value[{{key.symbolize}}], action, identity, Tuple(*P, T))
      {% end %}
    {% elsif (T.struct? || T.class?) && !(T == String || T < Number || T < Enum || T == Bool || T == Char || T == Symbol || T == Nil || T == Str || T < Pointer) %}
      {% for field in T.instance_vars %}
        visit(value.@{{field.name.id}}, action, identity, Tuple(*P, T))
      {% end %}
    {% end %}
  end

  def self.handoff(value, receiver : UInt64) : Nil
    visit(value, :handoff, receiver)
  end

  def self.transfer(value, slot : UInt64) : Nil
    visit(value, :transfer, slot)
  end

  def self.claim(value, slot : UInt64) : Nil
    visit(value, :claim, slot)
  end

  def self.release(value, slot : UInt64) : Nil
    visit(value, :release, slot)
  end

  def self.close_owned(value, owner : UInt64) : Nil
    visit(value, :close, owner)
  end
end

# Called only by task-body lowering, before that body's lexical defers.
def __ris_task_result(value : T) : T forall T
  return value unless RisResources.contains(T)
  fiber = IyiScheduler.current
  group = fiber.group
  return value unless group
  staged = RisResources.stage(value, RisResultOwner.new(group))
  RisStagedResource(T).new(group, staged, fiber.object_id)
  RisResources.transfer(staged, fiber.object_id)
  staged
end

# Independent of the live-child list, including a panic in child cleanup.
# Each slot has its actual result type and is filled before defers run.
class RisStagedResource(T) < RisResourceResult
  @value : UInt64

  def initialize(group : IyiGroup, value : T, @identity : UInt64)
    @value = 0_u64
    RisResultOwner.new(group).run do
      @value = RisRegion.tape_bytes(sizeof(T).to_u64)
      Pointer(T).new(@value).value = value
    end
    self.next_result = group.resource_results
    group.resource_results = self
  end

  def retire : Nil
    return if @value == 0_u64
    RisResources.release(Pointer(T).new(@value).value, @identity)
    @value = 0_u64
  end
end
