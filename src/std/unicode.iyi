  private def self.category_name(index : Int32) : String
    case index
    when 0 then "Lu"
    when 1 then "Ll"
    when 2 then "Lt"
    when 3 then "Lm"
    when 4 then "Lo"
    when 5 then "Mn"
    when 6 then "Mc"
    when 7 then "Me"
    when 8 then "Nd"
    when 9 then "Nl"
    when 10 then "No"
    when 11 then "Pc"
    when 12 then "Pd"
    when 13 then "Ps"
    when 14 then "Pe"
    when 15 then "Pi"
    when 16 then "Pf"
    when 17 then "Po"
    when 18 then "Sm"
    when 19 then "Sc"
    when 20 then "Sk"
    when 21 then "So"
    when 22 then "Zs"
    when 23 then "Zl"
    when 24 then "Zp"
    when 25 then "Cc"
    when 26 then "Cf"
    when 27 then "Cs"
    when 28 then "Co"
    else ""
    end
  end

