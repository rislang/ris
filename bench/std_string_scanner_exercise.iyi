# Exercises `std/string_scanner`.
#
# Run via:
#     ./bin/iyi run bench/std_string_scanner_exercise.iyi
#
# With `patterns` it prints the tokenizer's patterns, `kind<TAB>source`;
# with `tokens PATH` it tokenizes each program in the file (separated by
# byte 0x1E) and prints what it read; with `match_at PATH` it answers each
# `pattern 0x1F text 0x1F byte` line with `begin end` or `-`.
# bench/std_string_scanner_exercise.sh compares those with Python's `re`.

module bench/std_string_scanner_exercise

import std/regex::{Regex}
import std/string_scanner::{StringScanner}

def assert_true(cond : Bool, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}" unless cond
end

def assert_str(expected : String?, actual : String?, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}\n  expected #{expected.inspect}\n  got      #{actual.inspect}" unless expected == actual
end

def assert_int(expected : Int32?, actual : Int32?, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}\n  expected #{expected.inspect}\n  got      #{actual.inspect}" unless expected == actual
end

# What *block* panics with, run as a task of its own, or "answered".
def panic_of(&block : -> _) : String
  group do |g|
    task = g.spawn do
      block.call
      0
    end
    outcome = task.value
    outcome.is_a?(Panicked) ? outcome.message.to_s : "answered"
  end
end

# A small language's tokens: numbers with a fraction and an exponent,
# identifiers that may be written in any script, five keywords, strings
# with backslash escapes, `#` comments, and operators longest first.
@[OnTape]
struct Token
  getter kind : String
  getter text : String
  getter at : Int32

  def initialize(@kind : String, @text : String, @at : Int32)
  end
end

# Source the tokenizer cannot read: a value, because the source is input.
@[OnTape]
struct LexError
  getter at : Int32
  getter reason : String

  def initialize(@reason : String, @at : Int32)
  end
end

impl Error for LexError
  def message : String
    "#{@reason} at byte #{@at}"
  end
end

KEYWORDS = ["let", "fn", "if", "else", "print"]

# *source*'s tokens appended to *tokens*, or why it cannot be read.
def tokenize(source : String, tokens : Array(Token)) : LexError?
  s = StringScanner.new(source)
  while !s.eos?
    at = s.offset
    kind = ""
    if s.scan(/[ \t\r\n]+|#[^\n]*/)
      kind = "space"
    elsif s.scan(/[0-9]+(?:\.[0-9]+)?(?:[eE][-+]?[0-9]+)?/)
      kind = "number"
    elsif s.scan(/[A-Za-z_À-鿿][A-Za-z0-9_À-鿿]*/)
      kind = "ident"
    elsif s.scan(/"(?:[^"\\\n]|\\.)*"/)
      kind = "string"
    elsif s.scan(/==|!=|<=|>=|->|[-+*\/=<>(){},;]/)
      kind = "op"
    end
    if kind.empty?
      return LexError.new("unterminated string", at) if s.check('"')
      return LexError.new("unexpected #{s.peek(1).inspect}", at)
    end
    next if kind == "space"
    text = source[at, s.offset - at]
    kind = "keyword" if kind == "ident" && KEYWORDS.includes?(text)
    tokens << Token.new(kind, text, at)
  end
  nil
end

def hex(text : String) : String
  begin; io = "";
    i = 0
    while i < text.bytesize
      io << text.byte_at(i).to_i32.to_s(16).rjust(2, '0')
      i = i + 1
    end
  io
  end
end

if Program.args.size > 0 && Program.args[0] == "patterns"
  print "space\t"
  puts((/[ \t\r\n]+|#[^\n]*/).source)
  print "number\t"
  puts((/[0-9]+(?:\.[0-9]+)?(?:[eE][-+]?[0-9]+)?/).source)
  print "ident\t"
  puts((/[A-Za-z_À-鿿][A-Za-z0-9_À-鿿]*/).source)
  print "string\t"
  puts((/"(?:[^"\\\n]|\\.)*"/).source)
  print "op\t"
  puts((/==|!=|<=|>=|->|[-+*\/=<>(){},;]/).source)
  exit 0
end

if Program.args.size > 1 && Program.args[0] == "tokens"
  programs = File.read(Program.args[1]).split('\u001E')
  k = 0
  while k < programs.size
    puts "== program #{k}"
    result = [] of Token
    error = tokenize(programs[k], result)
    if error
      puts "error #{error.reason.starts_with?("unterminated") ? "unterminated" : "unexpected"} #{error.at}"
    else
      result.each { |token| puts "#{token.kind} #{token.at} #{hex(token.text)}" }
    end
    k = k + 1
  end
  exit 0
end

if Program.args.size > 1 && Program.args[0] == "match_at"
  File.read(Program.args[1]).split('\n').each do |line|
    next if line.empty?
    parts = line.split('\u001F')
    found = Regex.compile(parts[0]).match_at(parts[1], parts[2].to_i)
    puts found ? "#{found.byte_begin(0)} #{found.byte_end(0)}" : "-"
  end
  exit 0
end

puts "== the other library's scan, scan_until, skip and skip_until"
s1 = StringScanner.new("this is a string")
assert_str "this", s1.scan(/\w+/), "scan a regex"
assert_str " ", s1.scan(' '), "scan a char"
assert_str "is ", s1.scan("is "), "scan a string"
assert_str "a ", s1.scan(/\w+\s/), "scan a regex again"
assert_str "st", s1.scan(2), "scan a count"
assert_str "ring", s1.scan(/\w+/), "scan to the end"

s2 = StringScanner.new("test string")
assert_str "test", s2.scan(/\w+/), "scan test"
assert_str nil, s2.scan(/\w+/), "scan does not search ahead"
assert_str nil, s2.scan('s'), "nor for a char"
assert_str nil, s2.scan("string"), "nor for a string"
assert_str " st", s2.scan(/\s\w\w/), "scan from where the last left"
assert_str "ring", s2.scan(4), "scan 4"
assert_str "", s2.scan(/.*/), "an empty match at the end"
assert_str nil, s2.scan(1), "no character left"

s3 = StringScanner.new("test string")
assert_str "test ", s3.scan_until(/t /), "scan_until a regex"
assert_int 5, s3.offset, "scan_until moves past the match"
assert_str "str", s3.scan_until("tr"), "scan_until a string"
assert_int 8, s3.offset, "offset 8"
assert_str "in", s3.scan_until('n'), "scan_until a char"
assert_int 10, s3.offset, "offset 10"
s3.offset = 8
assert_str nil, s3.scan_until(/tr/), "scan_until finds nothing behind it"
assert_str nil, s3.scan_until('r'), "nor a char"
assert_str nil, s3.scan_until("tr"), "nor a string"

s4 = StringScanner.new("this is a string")
assert_int 5, s4.skip(/\w+\s/), "skip answers how far it moved"
assert_int 5, s4.offset, "skip moves"
assert_str "this ", s4[0]?, "skip records its match"
assert_int nil, s4.skip(/\d+/), "skip nothing"
assert_int 5, s4.offset, "and stay"
assert_str nil, s4[0]?, "and the failure is the last match"
assert_int 1, s4.skip('i'), "skip a char"
assert_str "i", s4[0]?, "skip char match"
assert_int 2, s4.skip("s "), "skip a string"
assert_int 8, s4.offset, "offset 8 after skip"
assert_int 2, s4.skip(/\w+\s/), "skip a regex"
assert_int 5, s4.skip(5), "skip a count"
assert_int 15, s4.offset, "offset 15"
assert_str "strin", s4[0]?, "skip count match"
assert_int nil, s4.skip(100), "skip too far"
assert_int nil, s4.skip(2), "skip two of one"
assert_int 1, s4.skip(1), "skip the last"
assert_int nil, s4.skip(1), "skip past the end"
assert_int 0, s4.skip(0), "skip nothing at the end"

s5 = StringScanner.new("this is a string")
assert_int nil, s5.skip_until(/not/), "skip_until finds nothing"
assert_int 0, s5.offset, "and stays"
assert_str nil, s5[0]?, "and records nothing"
assert_int 8, s5.skip_until(/\sis\s/), "skip_until a regex"
assert_str " is ", s5[0]?, "the last match is the match, not what was skipped"
assert_int 4, s5.skip_until("st"), "skip_until a string"
assert_int 12, s5.offset, "offset 12"
assert_int 4, s5.skip_until("ng"), "skip_until to the end"
assert_true s5.eos?, "skip_until to eos"

s6 = StringScanner.new("this is a string")
assert_true !s6.eos?, "not eos at the start"
s6.skip(/(\w+\s?){4}/)
assert_true s6.eos?, "eos at the end"
puts "  scan, scan_until, skip, skip_until with a regex, a string, a char and a count"

puts "\n== check, check_until, matches? and matched?"
s7 = StringScanner.new("this is a string")
s7.offset = 5
assert_str "is ", s7.check(/\w+\s/), "check a regex"
assert_int 5, s7.offset, "check does not move"
assert_str "is ", s7[0], "check records its match"
assert_str "i", s7.check('i'), "check a char"
assert_str "is a str", s7.check("is a str"), "check a string"
assert_str "is a", s7.check(4), "check a count"
assert_str nil, s7.check(100), "check too far"
assert_int 5, s7.offset, "still 5"
assert_str nil, s7[0]?, "and no last match"
s8 = StringScanner.new("test string")
assert_str nil, s8.check(/\d+/), "check no digits"
assert_str nil, s8.check('0'), "check no char"
assert_str nil, s8.check("01"), "check no string"
assert_str "test str", s8.check_until(/tr/), "check_until a regex"
assert_str "test str", s8.check_until('r'), "check_until a char"
assert_str "test string", s8.check_until("ng"), "check_until a string"
assert_int 0, s8.offset, "check_until does not move"
s8.offset = 8
assert_str nil, s8.check_until(/tr/), "check_until behind"
s9 = StringScanner.new("this is")
assert_int 4, s9.matches?(/\w+/), "matches? a regex"
assert_int 0, s9.offset, "matches? does not move"
assert_int 2, s9.matches?("th"), "matches? a string"
assert_int 1, s9.matches?('t'), "matches? a char"
assert_int nil, s9.matches?("is"), "matches? only at the offset"

s10 = StringScanner.new("sphinx of black quartz, judge my vow")
assert_true !s10.matched?, "nothing matched yet"
s10.check(1000)
assert_true !s10.matched?, "check 1000 does not match"
s10.check(10)
assert_true s10.matched?, "check 10 does"
s10.check(/Sphinx/)
assert_true !s10.matched?, "case matters"
s10.check(/sphinx/)
assert_true s10.matched?, "check sphinx"
s10.skip("nonsense")
assert_true !s10.matched?, "skip nonsense"
s10.skip("sphinx ")
assert_true s10.matched?, "skip sphinx"
s10.scan(/\d+/)
assert_true !s10.matched?, "scan digits"
s10.scan(/\w+/)
assert_true s10.matched?, "scan word"
s10.scan(1000)
s10.peek(10)
assert_true !s10.matched?, "peek leaves the last match alone"
puts "  check, check_until, matches?, matched?"

puts "\n== groups of the last match"
s11 = StringScanner.new("Fri Dec 12 1975 14:39")
date = /(?<wday>\w+) (?<month>\w+) (?<day>\d+)/
assert_str "Fri Dec 12", s11.scan(date), "scan with named groups"
assert_str "Fri Dec 12", s11[0], "group 0"
assert_str "Fri", s11[1], "group 1"
assert_str "Dec", s11[2], "group 2"
assert_str "12", s11[3], "group 3"
assert_str "12", s11[-1], "a negative group counts from the last"
assert_str "Fri", s11["wday"], "named wday"
assert_str "Dec", s11["month"]?, "named month"
assert_str "12", s11["day"], "named day"
assert_str nil, s11[5]?, "a group it does not have is nil"
assert_str nil, s11["something"]?, "a name it does not have is nil"
assert_true panic_of { t = StringScanner.new("Fri Dec 12 1975 14:39"); t.scan(/(?<wday>\w+) (?<month>\w+) (?<day>\d+)/); t[5] }.includes?("string_scanner: the last match has no group 5 (it has 3)"), "[] of a group it does not have panics"
assert_true panic_of { t = StringScanner.new("Fri Dec 12 1975 14:39"); t.scan(/(?<wday>\w+) (?<month>\w+) (?<day>\d+)/); t["something"] }.includes?("string_scanner: the last match has no group named 'something'"), "[] of a name it does not have panics"
assert_str " ", s11.scan(' '), "scan a char after groups"
assert_str " ", s11[0], "the char is group 0"
assert_str nil, s11[1]?, "and has no group 1"
assert_str nil, s11["wday"]?, "nor the old names"
assert_true panic_of { t = StringScanner.new("Fri Dec 12 1975 14:39"); t.scan(/(?<wday>\w+) (?<month>\w+) (?<day>\d+)/); t.scan(' '); t[1] }.includes?("string_scanner: the last match has no group 1 (it has 0)"), "[] of group 1 of a char panics"
assert_str "1975", s11.scan("1975"), "scan a string after groups"
assert_str "1975", s11[0], "the string is group 0"
assert_true panic_of { t = StringScanner.new("Fri Dec 12 1975 14:39"); t.scan(/(?<wday>\w+) (?<month>\w+) (?<day>\d+)/); t.scan(' '); t.scan("1975"); t["something"] }.includes?("no group named 'something'"), "a string match has no names"
s11.scan(/this is not there/)
assert_str nil, s11[0]?, "no last match after a miss"
assert_true panic_of { t = StringScanner.new("x"); t.scan(/this is not there/); t[0] }.includes?("string_scanner: the last scan matched nothing, so it has no group 0"), "[] with no last match panics"
s12 = StringScanner.new("b")
s12.scan(/(a)|(b)/)
assert_str "b", s12[2], "the group that took part"
assert_str nil, s12[1]?, "a group that took no part is nil"
assert_true panic_of { t = StringScanner.new("b"); t.scan(/(a)|(b)/); t[1] }.includes?("string_scanner: group 1 took no part in the last match"), "[] of a group that took no part panics"
s13 = StringScanner.new("key = value")
assert_str "key = ", s13.scan_until(/(?<eq>\s*=\s*)/), "scan_until with a group"
assert_str " = ", s13["eq"], "scan_until's groups are the match's"
puts "  numbered, negative and named groups, [] and []? with and without a match"

puts "\n== offset, rest, peek, reset, terminate"
s14 = StringScanner.new("this is a string")
assert_str "this is a string", s14.string, "string"
assert_str "this is a string", s14.rest, "rest at the start"
assert_int 0, s14.offset, "offset 0"
s14.scan(/this is a /)
assert_str "string", s14.rest, "rest in the middle"
s14.scan(/string/)
assert_str "", s14.rest, "rest at the end"
s15 = StringScanner.new("this is a string")
s15.offset = 5
assert_str "is", s15.scan(/\w+/), "offset= then scan"
s15.offset = 16
assert_true s15.eos?, "the end is an offset"
assert_true panic_of { t = StringScanner.new("this is a string"); t.offset = -2 }.includes?("string_scanner: offset -2 is negative"), "a negative offset panics"
assert_true panic_of { t = StringScanner.new("this is a string"); t.offset = 17 }.includes?("string_scanner: offset 17 is past the end of a string of 16 bytes"), "an offset past the end panics"
s16 = StringScanner.new("this is a string")
assert_str "this", s16.peek(4), "peek"
assert_str "this is", s16.peek(7), "peek more"
assert_int 0, s16.offset, "peek does not move"
assert_str "this is a string", s16.peek(100), "peek past the end answers the rest"
assert_true panic_of { t = StringScanner.new("this is a string"); t.peek(-1) }.includes?("string_scanner: negative lookahead count: -1"), "a negative peek panics"
assert_true panic_of { t = StringScanner.new("this is a string"); t.scan(-10) }.includes?("string_scanner: negative lookahead count: -10"), "a negative scan panics"
s16.scan_until(/str/)
assert_true !s16[0]?.nil? && s16.offset != 0, "something matched"
s16.reset
assert_true s16[0]?.nil? && s16.offset == 0, "reset clears the match and the offset"
s16.scan_until(/str/)
s16.terminate
assert_true s16[0]?.nil? && s16.eos?, "terminate clears the match and ends"
puts "  string, rest, offset=, peek, reset, terminate"

puts "\n== bytes and characters"
s17 = StringScanner.new("テストの文字列")
assert_str "テスト", s17.scan(/\p{L}\p{L}\p{L}/), "a regex reads characters"
assert_int 9, s17.offset, "and the offset is bytes"
assert_str nil, s17.scan(/[a-z]+/), "no ASCII"
assert_str nil, s17.scan('ト'), "not the char behind"
assert_str "の", s17.scan('の'), "a char past ASCII"
assert_str nil, s17.scan(10), "ten characters are not left"
assert_str "文字", s17.scan(2), "a count is characters"
assert_int 18, s17.offset, "six bytes moved"
assert_str nil, s17.scan("不在"), "a string that is not there"
assert_str "列", s17.scan("列"), "the last character"
s18 = StringScanner.new("これは文字列である")
assert_int 9, s18.skip(/\p{L}{3}/), "skip answers bytes"
assert_str "これは", s18[0]?, "skip's match"
assert_int nil, s18.skip(100), "skip 100 characters"
assert_int 6, s18.skip("文字"), "skip a string of two characters"
assert_int 3, s18.skip('列'), "skip a char of three bytes"
assert_int 6, s18.skip(2), "skip two characters"
assert_str "であ", s18[0]?, "the two characters"
assert_int 0, s18.skip(0), "skip none"
assert_str "", s18[0]?, "an empty match"
assert_int 3, s18.skip(1), "skip the last character"
assert_true s18.eos?, "at the end"
s19 = StringScanner.new("これは文字列である")
assert_str "これは", s19.peek(3), "peek is characters"
assert_str "これは文字列", s19.peek(6), "peek six characters"
assert_true panic_of { t = StringScanner.new("é"); t.offset = 1 }.includes?("string_scanner: offset 1 is inside a character"), "an offset inside a character panics"
bad = String.from_bytes(4) { |p| p[0] = 0x80_u8; p[1] = 0xC3_u8; p[2] = 0x28_u8; p[3] = 0xE2_u8 }
t = StringScanner.new(bad)
t.offset = 1
t.offset = 2
t.offset = 3
t.offset = 1
assert_true t.peek(2) == bad[1, 2], "a lead without its continuation is one character"
assert_int 1, t.skip(1), "and is one byte long"
cut = String.from_bytes(2) { |p| p[0] = 0xE2_u8; p[1] = 0x82_u8 }
c = StringScanner.new(cut)
c.offset = 1
assert_int 1, c.offset, "a continuation after a cut-short lead begins a character"
caret = StringScanner.new("ab")
caret.offset = 1
assert_true caret.scan(/^b/).nil? && caret.scan(/b/) == "b", "^ is the string's start, not the offset"
w = StringScanner.new("ab")
w.offset = 1
assert_true w.scan(/\bb/).nil? && w.scan(/\Bb/) == "b", "\\b sees the byte before the offset"
puts "  offsets in bytes, counts in characters, a byte that begins none is one"

puts "\n== inspect"
s20 = StringScanner.new("this is a string")
assert_str "#<StringScanner 0/16 \"‣this …>", s20.inspect, "inspect at the start"
s20.scan(/\w+\s/)
assert_str "#<StringScanner 5/16 …s ‣is …>", s20.inspect, "inspect after a word"
s20.scan(1)
assert_str "#<StringScanner 6/16 … i‣s a…>", s20.inspect, "inspect after one"
s20.scan(/\w+\s/)
assert_str "#<StringScanner 8/16 …s ‣a s…>", s20.inspect, "inspect in the middle"
s20.scan(/\w+\s\w+/)
assert_str "#<StringScanner 16/16 …tring‣\">", s20.inspect, "inspect at the end"
s21 = StringScanner.new("hi")
assert_str "#<StringScanner 0/2 \"‣hi\">", s21.inspect, "a small string"
s21.scan(/\w/)
assert_str "#<StringScanner 1/2 \"h‣i\">", s21.inspect, "a small string, one in"
s21.scan(/\w/)
assert_str "#<StringScanner 2/2 \"hi‣\">", s21.inspect, "a small string at the end"
s22 = StringScanner.new(" a\n\t ")
s22.skip(1)
assert_str "#<StringScanner 1/5 \" ‣a\\n\\t \">", s22.inspect, "escapes"
s23 = StringScanner.new("\u0000\e")
s23.skip(1)
assert_str "#<StringScanner 1/2 \"\\u0000‣\\e\">", s23.inspect, "a NUL and an escape"
s24 = StringScanner.new("これは文字列である")
assert_str "#<StringScanner 0/27 \"‣これは文字…>", s24.inspect, "multi-byte at the start"
s24.scan(1)
assert_str "#<StringScanner 3/27 \"こ‣れは文字…>", s24.inspect, "multi-byte one in"
s24.scan(1)
s24.scan(1)
assert_str "#<StringScanner 9/27 …れは‣文字列…>", s24.inspect, "multi-byte three in"
s24.scan(3)
assert_str "#<StringScanner 18/27 …字列‣である\">", s24.inspect, "multi-byte six in"
s24.terminate
assert_str "#<StringScanner 27/27 …字列である‣\">", s24.inspect, "multi-byte at the end"
s25 = StringScanner.new("")
assert_str "#<StringScanner 0/0 \"‣\">", s25.inspect, "an empty string"
puts "  the other library's inspect, offsets in bytes"

puts "\n== a tokenizer"
program = "let größe = 3.5e2 + foo_bar * (y - 2) # a comment\nprint \"hi \\\"there\\\"\\n\", größe >= 10 -> name;"
result = [] of Token
error = tokenize(program, result)
raise "ASSERTION FAILED: the program tokenizes, not #{error.message}" if error
kinds = result.map { |token| token.kind }
texts = result.map { |token| token.text }
assert_true kinds == ["keyword", "ident", "op", "number", "op", "ident", "op", "op", "ident", "op", "number", "op",
                      "keyword", "string", "op", "ident", "op", "number", "op", "ident", "op"], "token kinds: #{kinds}"
assert_true texts[1] == "größe" && texts[3] == "3.5e2" && texts[13] == "\"hi \\\"there\\\"\\n\"" && texts[16] == ">=" && texts[18] == "->", "token texts: #{texts}"
assert_int 4, result[1].at, "a token's byte offset"
assert_int 52, result[12].at, "a token after a comment and a multi-byte name"
scratch = [] of Token
unterminated = tokenize("let s = \"open", scratch)
assert_true !unterminated.nil? && unterminated.message == "unterminated string at byte 8", "an unterminated string is an error value: #{unterminated.inspect}"
unexpected = tokenize("x = 1 @ 2", scratch)
assert_true !unexpected.nil? && unexpected.message == "unexpected \"@\" at byte 6", "an unknown character is an error value"
scratch.clear
assert_true tokenize("", scratch).nil? && tokenize("  # only\n", scratch).nil? && scratch.empty?, "empty and comment-only sources tokenize to nothing"
puts "  #{result.size} tokens, longest operator first, errors as values"

puts "\nALL CHECKS PASSED"
