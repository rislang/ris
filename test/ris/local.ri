module test/ris/local
import std/int

# The copy a caller keeps, made at the boundary it leaves the tape by.
@[TapeToHeap]
def retain(text : Tape::String) : String
  text.to_s
end

def check(ok : Bool) : Nil
  raise "local check failed" unless ok
end

def early : Int32
  local_tape do
    text = Tape::String.build { |w| w.append("early") }
    return text.bytesize
  end
  0
end

check(early == 5)
check(IyiRegion.tape == 0_u64)
copy = ""
tape do
  outer = Tape::String.build { |w| w.append("outer") }
  saved = IyiRegion.tape
  cursor = IyiHeap.read64(saved)
  first = 0_u64
  20.times do
    local_tape do
      current = IyiRegion.tape
      check(current != saved)
      first = current if first == 0_u64
      check(current == first)
      text = Tape::String.build(1) { |w| w.append(outer) }
      copy = retain(text)
      tape { check(IyiRegion.tape == current) }
      break 9
    end
    check(IyiRegion.tape == saved)
    check(IyiHeap.read64(saved) == cursor)
    check(outer == "outer")
  end
  local_tape do
    current = IyiRegion.tape
    local_tape do
      check(IyiRegion.tape != current)
      inner = Tape::String.build { |w| w.append("inner") }
      check(inner == "inner")
    end
    check(IyiRegion.tape == current)
  end
  local_tape do
    first_mapping = IyiRegion.tape
    # Force the local tape to grow onto a second mapping without touching
    # 64 MiB of pages (the mapping is rounded up to a whole 64 KiB grain).
    # Cleanup must release the whole chain, then restore.
    IyiRegion.tape_bytes(Tape::CAPACITY &+ IyiRegion::GRAIN)
    check(IyiRegion.tape != first_mapping)
  end
  check(IyiRegion.tape == saved)
  check(IyiHeap.read64(saved) == cursor)
  check(early == 5)
  check(IyiRegion.tape == saved)
end
check(copy == "outer")
check(IyiRegion.tape == 0_u64)
puts "PASS: local isolation, reuse, nested scopes, borrowed text, retained copy and early exits"
