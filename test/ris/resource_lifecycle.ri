module test/ris/resource_lifecycle
import std/socket::{IyiSocket}

def early(port : Int32) : Int32
  group do |g|
    g.new_task do
      socket = IyiSocket.listen(port)
      defer socket.close
      socket
    end
    sleep(1)
    return 7
  end
  0
end

probe = IyiSocket.listen(0)
port = probe.local_port
probe.close
raise "early return" unless early(port) == 7
reopened = IyiSocket.listen(port)
reopened.close

stale : IyiTask(IyiSocket)? = nil
group do |g|
  stale = g.new_task { IyiSocket.listen(port) }
end
if stale.is_a?(IyiTask(IyiSocket))
  raise "stale result" unless stale.take.is_a?(RisInbox::Closed)
end
reopened = IyiSocket.listen(port)
reopened.close

group do |g|
  result = g.new_task { IyiSocket.listen(port) }
  thief = g.new_task do
    result.take
    0
  end
  failure = thief.value
  raise "foreign taker" unless failure.is_a?(Panicked)
  if failure.is_a?(Panicked)
    raise "owner hint" unless failure.message.includes?("owning task")
  end
end
reopened = IyiSocket.listen(port)
reopened.close
puts "PASS: resource lifecycle"
