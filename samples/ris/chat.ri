# A chat room: what lasts lives on the heap, each request on a tape.
#
#   ./bin/ris run samples/ris/chat.ri
#
# Read it as Rails: models for users, messages and the room, and a
# `MessagesController.create` that takes the request, reads
# `message_params`, answers 403 when the user is not in the room, has the
# room create the message and renders the room. The params and the view
# are on the request's tape; the model's `create_message` is the one place
# anything is copied to the heap.

# The models: what outlives a request lives on the heap.
class User
  getter id : Int32
  getter name : String

  def initialize(*, @id : Int32, @name : String)
  end
end

class Message
  getter user : User
  getter body : String

  def initialize(*, @user : User, @body : String)
  end
end

class Room
  getter users = Array(User).new
  getter messages = Array(Message).new

  def user(id : Int32) : User?
    users.find { |user| user.id == id }
  end

  # As `messages.create!`: the one copy to the heap, as a posted message
  # outlives its request.
  def create_message(user : User, params : MessageParams) : Nil
    messages << Message.new(user: user, body: params.body.to_heap)
  end
end

# The request's message, as Rails' `message_params`: its body a view
# into the request's bytes.
@[OnTape]
struct MessageParams
  getter user_id : Int32
  getter body : Tape::String

  def initialize(*, @user_id : Int32, @body : Tape::String)
  end
end

module MessagesController
  # The action: one request, start to end on one tape. Its bytes, the
  # params and the rendered room are freed together when it ends.
  def self.create(room : Room, request : String) : Nil
    tape do
      params = message_params(Tape::String.view(request))
      if params.nil?
        puts "400 bad request"
      elsif user = room.user(params.user_id)
        room.create_message(user, params)
        render_room(room)
      else
        puts "403 user #{params.user_id} is not in the room"
      end
    end
  end

  # "7 Ship it": a user id, one space, the text. Nil when it is not.
  def self.message_params(request : Tape::String) : MessageParams?
    user_id = 0
    index = 0
    while index < request.bytesize && request[index] != ' '.ord.to_u8
      digit = request[index] &- '0'.ord.to_u8
      return nil if digit > 9
      user_id = user_id * 10 + digit.to_i32
      index += 1
    end
    return nil if index == 0 || index >= request.bytesize
    body = request[index + 1, request.bytesize - index - 1]
    MessageParams.new(user_id: user_id, body: body)
  end

  # The view: the newest message first, then the users by name, all
  # written into one response on the tape.
  def self.render_room(room : Room) : Nil
    count = room.messages.size
    newest = Tape::Array(Int32).new(count) { |i| count - 1 - i }
    response = Tape::String::Writer.new(256)
    response.append("200 ")
    newest.each_with_index do |i, k|
      message = room.messages[i]
      response.append(" | ") if k > 0
      response.append(message.user.name)
      response.append(": ")
      response.append(message.body)
    end
    response.append(" (users ")
    names = Tape::Array(String).new(room.users.size) { |i| room.users[i].name }
    names.sort_in_place
    names.join(response, ", ")
    response.append(")")
    puts response.finish
  end
end

room = Room.new
room.users << User.new(id: 31, name: "carol")
room.users << User.new(id: 7, name: "alice")
room.users << User.new(id: 12, name: "bob")
MessagesController.create(room, "7 Morning!")
MessagesController.create(room, "12 Deploy is green")
MessagesController.create(room, "7 Ship it")
MessagesController.create(room, "99 Hi")
MessagesController.create(room, "hello")
puts "kept #{room.messages.size} messages"
