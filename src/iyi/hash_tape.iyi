# A hash map on the tape, laid out as Ruby's Hash (st_table): entries in
# insertion order in parallel Array columns, and `@bins`, an Array(Int32) of
# entry indices probed linearly (-1 empty). Deletion compacts the columns
# and rebuilds the bins, returning owned runs for reuse. Links are indices,
# so the map holds no pointer of its own. Everything lives on
# the tape that is current at `new`, and goes when that tape's scope ends.
#
# A program's `{k => v}` and `{} of K => V` are a Hash (the compiler's
# literal expander); std and the runtime keep Hash until they migrate.
@[OnTape]
struct Hash(K, V)
  @keys : Array(K)
  @values : Array(V)
  @live : Array(Bool)
  @bins : Array(Int32)
  # [0] is the live count. Every column is an Array, shared by copies of the
  # struct, so a Hash passed to a method is the same map.
  @head : Array(Int32)
  # Ruby's `Hash.new(0)`: what a missing key reads. Nil for most maps, so
  # they reserve nothing for it; it travels with the map to any method.
  @default : Array(V)? = nil

  def initialize(capacity : Int32 = 8)
    capacity = 8 if capacity < 8
    @keys = Array(K).new(capacity)
    @values = Array(V).new(capacity)
    @live = Array(Bool).new(capacity)
    @bins = Array(Int32).new(Hash.bin_count(capacity), -1)
    @head = Array(Int32).new(1, 0)
  end

  # Bins for *entries*: a power of two at least twice as many, so a probe
  # meets an empty bin soon.
  def self.bin_count(entries : Int32) : Int32
    bins = 16
    while bins < entries * 2
      bins = bins * 2
    end
    bins
  end

  def size : Int32
    @head[0]
  end

  def empty? : Bool
    size == 0
  end

  def []=(key : K, value : V) : V
    index = find(key)
    if index >= 0
      @values[index] = value
      return value
    end
    grow if (@keys.size + 1) * 2 > @bins.size
    entry = @keys.size
    @keys.push(key)
    @values.push(value)
    @live.push(true)
    place(key, entry)
    @head[0] = size + 1
    value
  end

  # A map whose missing keys read *default* (`counts = Hash.new(0)`).
  def self.with_default(default : V) : self
    map = new
    map.__ris_default = Array(V).new(1, default)
    map
  end

  protected def __ris_default=(@default : Array(V)?)
  end

  def [](key : K) : V
    index = find(key)
    if index < 0
      if default = @default
        return default[0]
      end
      raise "Hash: missing key #{key}"
    end
    @values[index]
  end

  def []?(key : K) : V?
    index = find(key)
    index < 0 ? nil : @values[index]
  end

  def fetch(key : K, default : D) : V | D forall D
    index = find(key)
    index < 0 ? default : @values[index]
  end

  def has_key?(key : K) : Bool
    find(key) >= 0
  end

  # Return a caller-owned value and reclaim the removed entry's runs.
  def delete(key : K) : V?
    index = find(key)
    return nil if index < 0
    value = @values.__remove_slot(index)
    @keys.__remove_slot(index)
    @live.__remove_slot(index)
    @head[0] = size - 1
    i = 0
    while i < @bins.size
      @bins[i] = -1
      i += 1
    end
    i = 0
    while i < @keys.size
      place(@keys[i], i)
      i += 1
    end
    value
  end

  def clear : self
    @keys.clear
    @values.clear
    @live.clear
    i = 0
    while i < @bins.size
      @bins[i] = -1
      i = i + 1
    end
    @head[0] = 0
    self
  end

  # Live entries in insertion order.
  def each(& : K, V -> Nil) : Nil
    i = 0
    while i < @keys.size
      yield @keys[i], @values[i] if @live[i]
      i = i + 1
    end
  end

  def each_key(& : K -> Nil) : Nil
    each { |key, _| yield key }
  end

  def each_value(& : V -> Nil) : Nil
    each { |_, value| yield value }
  end

  def keys : Array(K)
    result = Array(K).new(size < 4 ? 4 : size)
    each { |key, _| result.push(key) }
    result
  end

  def values : Array(V)
    result = Array(V).new(size < 4 ? 4 : size)
    each { |_, value| result.push(value) }
    result
  end

  # The entry index of a live key, or -1.
  private def find(key : K) : Int32
    mask = @bins.size - 1
    slot = key.hash & mask
    while true
      entry = @bins[slot]
      return -1 if entry < 0
      return entry if @live[entry] && @keys[entry] == key
      slot = (slot + 1) & mask
    end
  end

  private def place(key : K, entry : Int32) : Nil
    mask = @bins.size - 1
    slot = key.hash & mask
    while @bins[slot] >= 0
      slot = (slot + 1) & mask
    end
    @bins[slot] = entry
  end

  # Twice the bins, in place (the Array grows in its own reservation), and
  # rebuilt from the live entries. Size a map up front to avoid this.
  private def grow : Nil
    old = @bins.size
    i = 0
    while i < old
      @bins[i] = -1
      @bins.push(-1)
      i = i + 1
    end
    i = 0
    while i < @keys.size
      place(@keys[i], i) if @live[i]
      i = i + 1
    end
  end
end
