# Isolated test of @[ThreadLocal] on Windows x86_64 without fibers or groups.

class TlsHolder
  @[ThreadLocal]
  @@value : Int64 = 42_i64

  def self.value : Int64
    @@value
  end

  def self.value=(v : Int64)
    @@value = v
  end
end

def read_teb_tls_slot : UInt64
  slot = uninitialized UInt64
  {% if flag?(:win32) && flag?(:x86_64) %}
    asm("movq %gs:0x58, $0" : "=r"(slot) ::: "volatile")
  {% else %}
    slot = 0_u64
  {% end %}
  slot
end

slot = read_teb_tls_slot
print "tls_probe: teb_tls_slot at start: "
if slot == 0_u64
  print "null\n"
else
  print "non-null\n"
end

print "tls_probe: before touching ThreadLocal\n"
v = TlsHolder.value
print "tls_probe: after touching ThreadLocal\n"
if v == 42_i64
  print "tls_probe: value ok\n"
else
  print "tls_probe: value wrong\n"
end

TlsHolder.value = 99_i64
v2 = TlsHolder.value
if v2 == 99_i64
  print "tls_probe: write ok\n"
else
  print "tls_probe: write wrong\n"
end
print "tls_probe: PASSED\n"
