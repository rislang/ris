# Interned strings: the same bytes become the same String.
#
module std/string_pool

# Interned strings on the pool's tape: `get` answers the one copy of a
# text, made the first time it is asked for. Open addressing over an
# Array of entry numbers; the entries and their hashes are append-only
# Arrays, so a rehash refills only the slot Array, in place.
pub class StringPool
  getter capacity : Int32
  @slots : Array(Int32)
  @hashes : Array(UInt64)
  @values : Array(String)

  def initialize(initial_capacity : Int32 = 8)
    cap = 8
    while cap < initial_capacity
      cap *= 2
    end
    @capacity = cap
    @slots = Array(Int32).new(cap, -1)
    @hashes = [] of UInt64
    @values = [] of String
  end

  def size : Int32
    @values.size
  end

  def empty? : Bool
    @values.empty?
  end

  def get(str : String) : String
    h = compute_hash(str)
    if existing = find_entry(h, str)
      return existing
    end
    rehash if size >= @capacity // 4 * 3
    entry = String.build(str.bytesize > 0 ? str.bytesize : 1) do |writer|
      str.each_byte { |byte| writer.push(byte) }
    end
    @hashes << h
    @values << entry
    insert(h, @values.size - 1)
    entry
  end

  def get?(str : String) : String?
    find_entry(compute_hash(str), str)
  end

  # Twice the slots, every entry placed again.
  def rehash : Nil
    @capacity = @capacity * 2
    @slots.clear
    @capacity.times { @slots << -1 }
    index = 0
    while index < @values.size
      insert(@hashes[index], index)
      index += 1
    end
  end

  private def find_entry(h : UInt64, str : String) : String?
    mask = (@capacity - 1).to_u64
    index = (h & mask).to_i32
    next_probe = 1_u64
    while (entry = @slots[index]) >= 0
      return @values[entry] if @hashes[entry] == h && @values[entry] == str
      index = ((index.to_u64 + next_probe) & mask).to_i32
      next_probe += 1_u64
    end
    nil
  end

  private def insert(h : UInt64, entry : Int32) : Nil
    mask = (@capacity - 1).to_u64
    index = (h & mask).to_i32
    next_probe = 1_u64
    while @slots[index] >= 0
      index = ((index.to_u64 + next_probe) & mask).to_i32
      next_probe += 1_u64
    end
    @slots[index] = entry
  end

  private def compute_hash(str : String) : UInt64
    h = 14695981039346656037_u64
    str.each_byte { |byte| h = (h ^ byte.to_u64) &* 1099511628211_u64 }
    h | 0x8000000000000000_u64
  end
end
