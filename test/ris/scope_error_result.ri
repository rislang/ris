# A def's error result, a struct whose one tape field is its sentence,
# moves the sentence down as a String result moves (SPEC 1.5): the
# def's other scratch is freed, the sentence stays.
@[OnTape]
struct ScopeError
  getter message : String
  getter at : Int32

  def initialize(@message : String, @at : Int32)
  end
end

# Two sentences, one made here and one viewing the caller's text.
@[OnTape]
struct ScopePair
  getter made : String
  getter seen : String
  getter also : String

  def initialize(@made : String, @seen : String, @also : String)
  end
end

def cur : UInt64
  IyiHeap.read64(RisRegion.tape &+ RisRegion::OFF_CURSOR)
end

def read(n : Int32) : String | ScopeError
  scratch = String::Builder.new(65536)
  scratch.push(65_u8)
  return ScopeError.new("bad #{n}", n) if n > 2
  "ok #{n}"
end

def refuse(n : Int32) : ScopeError
  scratch = String::Builder.new(65536)
  scratch.push(65_u8)
  ScopeError.new("refused #{n}", n)
end

def pair(input : String) : ScopePair | Int32
  scratch = String::Builder.new(65536)
  scratch.push(65_u8)
  return ScopePair.new("made #{input.bytesize}", input[1, 2], "also #{input}") if input.bytesize > 1
  0
end

# A Tuple of texts and a number: its texts move down.
def tup(input : String) : Tuple(String, Int32, String)
  scratch = String::Builder.new(65536)
  scratch.push(65_u8)
  {"t #{input}", 3, input[0, 2]}
end

tape do
  c0 = cur
  a = read(5)
  b = read(1)
  c = refuse(7)
  x = "overwrite #{3} #{4}"
  puts a.is_a?(ScopeError) ? "#{a.message} #{a.at}" : "?"
  puts b.is_a?(String) ? b : "?"
  puts "#{c.message} #{c.at}"
  input = String.new("abcd")
  d = pair(input)
  y = "overwrite #{5} #{6} #{7}"
  puts d.is_a?(ScopePair) ? "#{d.made} #{d.seen} #{d.also}" : "?"
  e = tup(input)
  z = "overwrite #{8} #{9} #{10}"
  puts "#{e[0]} #{e[1]} #{e[2]}"
  puts cur - c0 < 1024
end
