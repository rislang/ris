# File system paths, read lexically: nothing here touches the file
# system. A `Path` is a name and a kind, POSIX (`/` separates) or
# Windows (`\` and `/` both separate); `Path.new` takes the kind the
# program was built for, `Path.posix` and `Path.windows` name one.
#
# The anchor of a path is its drive and root: `/` on POSIX; on Windows a
# drive letter (`C:`, `C:\`), a UNC share (`\\server\share`, `\\server\share\`)
# or a bare root (`\`). A Windows path is absolute only with both a drive
# and a root, so `C:foo` (drive-relative) and `\foo` (rooted) are not.
# DOS device paths (`\\.\`, `\\?\`) are not recognised: they read as UNC
# shares named `.` and `?`, except `\\?\UNC\server\share`, the long form
# of `\\server\share`, whose drive runs through the share as Python's
# reads it. Windows names compare case-insensitively: in
# every script on Windows, as its file systems fold them, and in ASCII
# letters alone where the program was built for another platform.
#
# Lexical operations: `basename`, `dirname`, `extension`, `stem`,
# `parent`, `parents`, `parts`, `join` and `/`, `normalize` (`.` and `..`
# folded, repeated separators collapsed, a trailing one dropped, a
# Windows anchor spelled with `\`: `C:/a` is `C:\a`),
# `relative_to?` and `relative_to` (nil, or a panic, when the paths have
# different anchors or the base climbs through `..` — where that leads
# cannot be known without the file system), `sibling`, `to_posix` and
# `to_windows` (the kind changes and, for `to_posix`, `\` becomes `/`;
# `to_windows` keeps the name, since Windows reads `/` as a separator).
#
# `expand(base, home:)` makes the path absolute under *base*, which is
# `Program.env("PWD")` when not given, and the process's own directory
# when no shell set that; on Windows it is the process's own directory
# always, since nothing there keeps `PWD` true. With neither, `expand`
# panics rather than guess. `home: true` reads a leading `~` from
# `HOME`, or from `USERPROFILE` on Windows, which is where that platform
# keeps it.

module std/path

# ris: the Windows arm's `UInt16#+` is `std/int`'s.
import std/int

import std/traits::{Comparable}

{% if flag?(:win32) %}
  lib LibKernel32
    fun LCMapStringEx(locale : UInt16*, flags : Int32, source : UInt16*, source_length : Int32,
                      destination : UInt16*, destination_length : Int32, version : Void*,
                      reserved : Void*, sort_handle : Int64) : Int32
  end
{% end %}

@[OnTape]
pub struct Path
  pub enum Kind : UInt8
    POSIX   = 0
    WINDOWS = 1

    def self.native : Kind
      {% if flag?(:win32) %}
        Kind::WINDOWS
      {% else %}
        Kind::POSIX
      {% end %}
    end

    def posix? : Bool
      value == 0_u8
    end

    def windows? : Bool
      value == 1_u8
    end
  end

  getter name : String
  getter kind : Kind

  def initialize(@name : String = "", @kind : Kind = Kind.native)
  end

  def self.new(path : Path) : Path
    path
  end

  def self.[](name : String = "") : Path
    Path.new(name)
  end

  def self.[](first : String | Path, second : String | Path) : Path
    Path.new(first.to_s).join(second)
  end

  def self.[](first : String | Path, second : String | Path, third : String | Path) : Path
    Path.new(first.to_s).join(second).join(third)
  end

  def self.[](parts : Array(String)) : Path
    Path.new("").join(parts)
  end

  def self.posix(name : String = "") : Path
    Path.new(name, Kind::POSIX)
  end

  def self.windows(name : String = "") : Path
    Path.new(name, Kind::WINDOWS)
  end

  def to_s : String
    @name
  end

  def to_s(io : IO) : Nil
    io.write(@name)
  end

  # A path of the kind this platform does not use names its constructor,
  # as the other library writes it: `Path.posix("/usr/bin")` on Windows
  # inspected as `Path["/usr/bin"]`, a Windows path, which `==` tells
  # apart from it.
  def inspect : String
    return "Path[" + @name.inspect + "]" if native?
    (posix? ? "Path.posix(" : "Path.windows(") + @name.inspect + ")"
  end

  def inspect(io : IO) : Nil
    io.write(inspect)
  end

  def <=>(other : Path) : Int32
    r = if windows? || other.windows?
          Path.compare_strings_ci(@name, other.name)
        else
          Path.compare_strings(@name, other.name)
        end
    return r if r != 0
    @kind.value == other.kind.value ? 0 : (@kind.value < other.kind.value ? -1 : 1)
  end

  def ==(other : Path) : Bool
    (self <=> other) == 0
  end

  def hash : Int32
    (windows? ? Path.windows_fold(@name) : @name).hash &* 31 &+ @kind.value.to_i32
  end

  def self.compare_strings(s1 : String,
                           s2 : String) : Int32
    len1 = s1.bytesize
    len2 = s2.bytesize
    min_len = len1 < len2 ? len1 : len2
    p1 = (s1.is_a?(String) ? s1.as_tape : s1)
    p2 = (s2.is_a?(String) ? s2.as_tape : s2)
    i = 0
    while i < min_len
      b1 = p1[i]
      b2 = p2[i]
      return b1 < b2 ? -1 : 1 if b1 != b2
      i = i + 1
    end
    len1 == len2 ? 0 : (len1 < len2 ? -1 : 1)
  end

  # As the two names' `windows_fold`s compare, read here without folding
  # either while both are ASCII.
  def self.compare_strings_ci(s1 : String,
                              s2 : String) : Int32
    len1 = s1.bytesize
    len2 = s2.bytesize
    min_len = len1 < len2 ? len1 : len2
    p1 = (s1.is_a?(String) ? s1.as_tape : s1)
    p2 = (s2.is_a?(String) ? s2.as_tape : s2)
    i = 0
    while i < min_len
      b1 = p1[i]
      b2 = p2[i]
      return compare_strings(windows_fold(s1), windows_fold(s2)) if b1 >= 128_u8 || b2 >= 128_u8
      b1 = b1 + 32_u8 if b1 >= 65_u8 && b1 <= 90_u8
      b2 = b2 + 32_u8 if b2 >= 65_u8 && b2 <= 90_u8
      b1 = 92_u8 if b1 == 47_u8
      b2 = 92_u8 if b2 == 47_u8
      return b1 < b2 ? -1 : 1 if b1 != b2
      i = i + 1
    end
    len1 == len2 ? 0 : (len1 < len2 ? -1 : 1)
  end

  # *s* as a Windows name compares: `/` written `\`, ASCII letters lower
  # case, and on Windows every other letter in the case its file systems
  # fold it to - LCMAP_UPPERCASE without linguistic casing, measured to
  # make the same classes as CompareStringOrdinal's on every BMP unit. A
  # surrogate pair stays as written, as both leave it. ASCII alone folded,
  # `C:\Ä` and `c:\ä` were two paths where NTFS has one file; built for
  # another platform there is no table to ask, and ASCII alone is folded.
  def self.windows_fold(s : String) : String
    {% if flag?(:win32) %}
      at = 0
      while at < s.bytesize && s[at] < 128_u8
        at += 1
      end
      if at < s.bytesize
        if folded = native_fold(s)
          return folded
        end
      end
    {% end %}
    String.build do |writer|
      s.each_byte do |byte|
        byte += 32_u8 if byte >= 65_u8 && byte <= 90_u8
        writer.push(byte == 47_u8 ? 92_u8 : byte)
      end
    end
  end


  {% if flag?(:win32) %}
    # Text that is not UTF-8 has no UTF-16 to fold, and is folded as ASCII.
    private def self.native_fold(s : String) : String?
      wide = __iyi_win_env_wide(s.to_unsafe, s.bytesize)
      return nil if wide.address == 0_u64
      length = 0
      while wide[length] != 0_u16
        length = length + 1
      end
      upper = Pointer(UInt16).malloc((length + 1).to_u64)
      invariant = Pointer(UInt16).malloc(1_u64)
      invariant[0] = 0_u16
      nothing = Pointer(Void).new(0_u64)
      if LibKernel32.LCMapStringEx(invariant, 0x200, wide, length, upper,
           length, nothing, nothing, 0_i64) != length
        return nil
      end
      at = 0
      while at < length
        unit = wide[at] >= 0xD800_u16 && wide[at] <= 0xDFFF_u16 ? wide[at] : upper[at]
        unit = unit + 32_u16 if unit >= 65_u16 && unit <= 90_u16
        upper[at] = unit == 47_u16 ? 92_u16 : unit
        at = at + 1
      end
      upper[length] = 0_u16
      size = __iyi_utf8_size_from_wide(upper)
      return nil if size <= 1
      String.new(size - 1) { |t| __iyi_utf8_bytes_from_wide(upper, t, size) }
    end

    # Windows folding passes UTF-8 bytes to the native conversion API.
    @[TapeUnsafe]
    private def self.native_fold(s : String) : String?
      wide = __iyi_win_env_wide(s.to_unsafe, s.bytesize)
      return nil if wide.address == 0_u64
      length = 0
      while wide[length] != 0_u16
        length = length + 1
      end
      upper = Pointer(UInt16).malloc((length + 1).to_u64)
      invariant = Pointer(UInt16).malloc(1_u64)
      invariant[0] = 0_u16
      nothing = Pointer(Void).new(0_u64)
      if LibKernel32.LCMapStringEx(invariant, 0x200, wide, length, upper,
           length, nothing, nothing, 0_i64) != length
        return nil
      end
      at = 0
      while at < length
        unit = wide[at] >= 0xD800_u16 && wide[at] <= 0xDFFF_u16 ? wide[at] : upper[at]
        unit = unit + 32_u16 if unit >= 65_u16 && unit <= 90_u16
        upper[at] = unit == 47_u16 ? 92_u16 : unit
        at = at + 1
      end
      upper[length] = 0_u16
      size = __iyi_utf8_size_from_wide(upper)
      return nil if size <= 1
      # Windows writes the UTF-8 straight into the writer's room; the
      # terminator it counts is left out.
      w = String::Builder.new(size)
      w.unsafe_append(size) { |room| __iyi_utf8_bytes_from_wide(upper, room, size) - 1 }
      w.finish
    end
  {% end %}
end

impl Comparable for Path
  def <=>(other : self) : Int32
    self <=> other
  end
end

# Lexical path data owned by the caller's tape. Slices view the name.
@[OnTape]
pub struct Path
  def write(writer : String::Builder) : Nil
    writer << @name
  end

  def posix? : Bool
    @kind.posix?
  end

  def windows? : Bool
    @kind.windows?
  end

  def native? : Bool
    @kind == Kind.native
  end

  def empty? : Bool
    @name.empty?
  end

  private def separator : String
    posix? ? "/" : "\\"
  end

  private def sep?(byte : UInt8) : Bool
    byte == 47_u8 || (windows? && byte == 92_u8)
  end

  private def concat(first : String,
                     second : String) : String
    String.build { |w| w << first << second }
  end

  private def anchor_indices : Tuple(Int32, Int32)
    len = @name.bytesize
    return {0, 0} if len == 0
    ptr = @name
    b0 = ptr[0]

    unless windows?
      return b0 == 47_u8 ? {0, 1} : {0, 0}
    end

    letter = (b0 >= 65_u8 && b0 <= 90_u8) || (b0 >= 97_u8 && b0 <= 122_u8)
    if letter && len >= 2 && ptr[1] == 58_u8 # "C:"
      return len >= 3 && sep?(ptr[2]) ? {2, 3} : {2, 2}
    end

    return {0, 0} unless sep?(b0)
    if len >= 5 && sep?(ptr[1]) && !sep?(ptr[2])
      # "\\server\share": a host run, a separator, a share run. After
      # `\\?\UNC\` the host comes after the prefix: read as host `?` and
      # share `UNC`, `\\?\UNC\srv\sh\x` had the drive `\\?\UNC`, and
      # `\\?\UNC\srv\other\x` relative to `\\?\UNC\srv\sh` was `..\other\x`,
      # across shares.
      i = long_unc? ? 8 : 2
      while i < len && !sep?(ptr[i])
        i = i + 1
      end
      if i + 1 < len && !sep?(ptr[i + 1])
        i = i + 1
        while i < len && !sep?(ptr[i])
          i = i + 1
        end
        share_end = i
        while i < len && sep?(ptr[i])
          i = i + 1
        end
        return {share_end, i}
      end
    end
    {0, 1}
  end

  # `\\?\UNC\` at the start, `UNC` in any case and either separator, as
  # Python's `splitroot` matches it.
  private def long_unc? : Bool
    ptr = @name
    return false unless @name.bytesize > 8 && ptr[2] == 63_u8 &&
                        sep?(ptr[3]) && sep?(ptr[7])
    (ptr[4] | 32_u8) == 117_u8 && (ptr[5] | 32_u8) == 110_u8 &&
      (ptr[6] | 32_u8) == 99_u8
  end

  def drive : String?
    drive_end, _ = anchor_indices
    drive_end > 0 ? @name[0, drive_end] : nil
  end

  def root : String?
    drive_end, anchor_end = anchor_indices
    anchor_end > drive_end ? @name[drive_end, anchor_end - drive_end] : nil
  end

  def anchor : String?
    _, anchor_end = anchor_indices
    anchor_end > 0 ? @name[0, anchor_end] : nil
  end

  # A share is absolute without a separator after it: `\\server\share` is
  # the share's root, as Windows and Python read it. It was relative, so
  # after `Dir.cd` to a share every `expand` panicked "base is not
  # absolute".
  def absolute? : Bool
    drive_end, anchor_end = anchor_indices
    if posix?
      anchor_end > 0
    else
      drive_end > 0 && (anchor_end > drive_end || share?)
    end
  end

  # A `\\server\share` drive, where `C:` is the other kind.
  private def share? : Bool
    drive_end, _ = anchor_indices
    drive_end > 0 && sep?(@name[0])
  end

  # The anchor with the root a share has whether written or not.
  protected def rooted_anchor : String
    found = anchor || "".as_tape
    share? && root.nil? ? concat(found, separator) : found
  end

  def relative? : Bool
    !absolute?
  end

  def ends_with_separator? : Bool
    len = @name.bytesize
    len > 0 && sep?(@name[len - 1])
  end

  # The last byte that is not a trailing separator, plus one; the anchor
  # keeps its own separator.
  private def trimmed_end : Int32
    _, anchor_end = anchor_indices
    last = @name.bytesize
    while last > anchor_end && sep?(@name[last - 1])
      last = last - 1
    end
    last
  end

  # The last component; the anchor, or the empty name, is its own. A
  # *suffix* found at the end is left off.
  def basename(suffix : String? = nil) : String
    _, anchor_end = anchor_indices
    last = trimmed_end
    return @name[0, anchor_end] if last <= anchor_end

    ptr = @name
    first = last
    while first > anchor_end && !sep?(ptr[first - 1])
      first = first - 1
    end

    base_len = last - first
    if suffix && !suffix.empty? && base_len > suffix.bytesize
      s_len = suffix.bytesize
      s_ptr = suffix
      k = 0
      while k < s_len && ptr[first + base_len - s_len + k] == s_ptr[k]
        k = k + 1
      end
      base_len = base_len - s_len if k == s_len
    end

    @name[first, base_len]
  end

  # Everything before the last component: `"."` for a bare name, the
  # anchor for a single component under it.
  def dirname : String
    return ".".as_tape if @name.empty?
    _, anchor_end = anchor_indices
    last = trimmed_end
    return @name[0, anchor_end] if last <= anchor_end

    ptr = @name
    while last > anchor_end && !sep?(ptr[last - 1])
      last = last - 1
    end
    while last > anchor_end && sep?(ptr[last - 1])
      last = last - 1
    end
    return ".".as_tape if last == 0
    @name[0, last]
  end

  def extension : String
    # An anchor is no file name: the UNC share `\\srv\a.\` answered `.\`,
    # a separator inside the extension, with a stem that did not add up.
    _, anchor_end = anchor_indices
    return "".as_tape if trimmed_end <= anchor_end
    base = basename
    len = base.bytesize
    ptr = base
    i = len - 1
    while i > 0 && ptr[i] != 46_u8
      i = i - 1
    end
    return "".as_tape if i <= 0 || i == len - 1
    base[i, len - i]
  end

  def stem : String
    basename(extension)
  end

  # The anchor, if any, then each non-empty component.
  def parts : Array(String)
    res = Array(String).new
    len = @name.bytesize
    return res if len == 0
    ptr = @name
    _, anchor_end = anchor_indices
    res << @name[0, anchor_end] if anchor_end > 0

    i = anchor_end
    while i < len
      while i < len && sep?(ptr[i])
        i = i + 1
      end
      start = i
      while i < len && !sep?(ptr[i])
        i = i + 1
      end
      res << @name[start, i - start] if i > start
    end
    res
  end

  def parent : Path
    Path.new(dirname, @kind)
  end

  def parents : Array(Path)
    result = Array(Path).new
    return result if @name.empty?
    child = self
    up = parent
    while up.name != child.name
      result << up
      child = up
      up = up.parent
    end
    first = 0
    last = result.size - 1
    while first < last
      saved = result[first]
      result[first] = result[last]
      result[last] = saved
      first += 1
      last -= 1
    end
    result
  end

  def each_part(& : String -> Nil) : Nil
    parts.each { |part| yield part }
  end

  def each_parent(& : Path -> Nil) : Nil
    parents.each { |path| yield path }
  end

  def join(part : String) : Path
    return self if part.empty?
    other = Path.new(part, @kind)
    return other if @name.empty?
    if other.anchor
      own = drive
      their = other.drive
      if own && their.nil?
        return Path.new(concat(own, part), @kind)
      end
      unless own && their && other.root.nil? && same?(own, their)
        return other
      end
      part = part[their.bytesize, part.bytesize - their.bytesize]
      return self if part.empty?
    end
    drive_end, anchor_end = anchor_indices
    bare = drive_end == 2 && anchor_end == 2 && @name.bytesize == 2
    joined = String.build do |writer|
      writer << @name
      writer << separator unless ends_with_separator? || bare
      writer << part
    end
    Path.new(joined, @kind)
  end

  def join(part : Path) : Path
    join(part.name)
  end

  def join(first : String | Path,
           second : String | Path) : Path
    join(first).join(second)
  end

  def join(first : String | Path,
           second : String | Path,
           third : String | Path) : Path
    join(first).join(second).join(third)
  end

  def join(parts : Array(String)) : Path
    current = self
    parts.each { |part| current = current.join(part) }
    current
  end

  def /(part : String | Path) : Path
    join(part)
  end

  def sibling(part : String | Path) : Path
    parent.join(part)
  end

  def normalize : Path
    text = String.build { |writer| normalize(writer) }
    Path.new(text, @kind)
  end

  def normalize(writer : String::Builder) : Nil
    components = Array(String).new
    rooted = !root.nil?
    _, anchor_end = anchor_indices
    all = parts
    index = anchor_end > 0 ? 1 : 0
    while index < all.size
      part = all[index]
      if part == "."
      elsif part == ".."
        if !components.empty? && components[components.size - 1] != ".."
          components.pop
        elsif !rooted
          components << part
        end
      else
        components << part
      end
      index += 1
    end
    if anchor_end > 0
      if posix?
        writer << '/'
      else
        if own = drive
          own.each_byte do |byte|
            writer.push(byte == 47_u8 ? 92_u8 : byte)
          end
        end
        writer << '\\' if rooted
      end
    end
    components.each_with_index do |part, i|
      writer << separator if i > 0
      writer << part
    end
    writer << '.' if anchor_end == 0 && components.empty?
  end

  private def same?(a : String, b : String) : Bool
    if windows?
      Path.compare_strings_ci(a, b) == 0
    else
      a == b
    end
  end

  def relative_to?(base : Path | String) : Path?
    base = Path.new(base, @kind) if base.is_a?(String)
    target = normalize
    origin = base.to_kind(@kind).normalize
    ta = target.rooted_anchor
    ba = origin.rooted_anchor
    return nil unless same?(ta, ba)
    targets = target.parts
    bases = origin.parts
    targets = Array(String).new if targets.size == 1 && targets[0] == "."
    bases = Array(String).new if bases.size == 1 && bases[0] == "."
    ti = ta.empty? ? 0 : 1
    bi = ba.empty? ? 0 : 1
    while ti < targets.size && bi < bases.size
      break unless same?(targets[ti], bases[bi])
      ti += 1
      bi += 1
    end
    index = bi
    while index < bases.size
      return nil if bases[index] == ".."
      index += 1
    end
    text = String.build do |writer|
      count = 0
      while bi < bases.size
        writer << separator if count > 0
        writer << ".."
        count += 1
        bi += 1
      end
      while ti < targets.size
        writer << separator if count > 0
        writer << targets[ti]
        count += 1
        ti += 1
      end
      writer << '.' if count == 0
    end
    Path.new(text, @kind)
  end

  def relative_to(base : Path | String) : Path
    relative_to?(base) || raise "no relative path between these anchors"
  end

  # Windows shells do not set `HOME`: the home directory there is named
  # `USERPROFILE`, and `HOME` shows up only under a POSIX-shaped shell
  # such as MSYS or a CI runner. So win32 asks both, its own name first;
  # every other platform asks `HOME` alone.
  def expand(base : Path | String | Nil = nil,
             home : Bool = false) : Path
    name = @name
    if home && (name == "~" || name.starts_with?("~/") ||
       (windows? && name.starts_with?("~\\")))
      directory = nil.as(String?)
      {% if flag?(:win32) %}
        directory = Program.env("USERPROFILE")
        directory = Program.env("HOME") if !directory || directory.empty?
      {% else %}
        directory = Program.env("HOME")
      {% end %}
      raise "cannot expand a path: HOME is not set" unless directory
      name = if name == "~"
               directory.as_tape
             else
               String.build do |writer|
                 writer << directory << name[1, name.bytesize - 1]
               end
             end
    end
    path = Path.new(name, @kind)
    return path.normalize if path.absolute?
    origin = if base.is_a?(Path)
               base.to_kind(@kind)
             elsif base.is_a?(String)
               Path.new(base, @kind)
             else
               pwd = nil.as(String?)
               {% if flag?(:win32) %}
                 pwd = Program.cwd
               {% else %}
                 pwd = Program.env("PWD") || Program.cwd
               {% end %}
               raise "cannot expand a path: no base given" unless pwd
               Path.new(pwd.as_tape, @kind)
             end
    raise "cannot expand a path: base is not absolute" unless origin.absolute?
    if windows?
      own = path.drive
      other = origin.drive
      if own && path.root.nil? && !(other && same?(other, own))
        text = String.build do |writer|
          writer << own << separator
          writer << name[own.bytesize, name.bytesize - own.bytesize]
        end
        return Path.new(text, @kind).normalize
      end
    end
    origin.join(path).normalize
  end

  def to_posix : Path
    return self if posix?
    text = String.build do |writer|
      @name.each_byte do |byte|
        writer.push(byte == 92_u8 ? 47_u8 : byte)
      end
    end
    Path.new(text, Kind::POSIX)
  end

  def to_windows : Path
    Path.new(@name, Kind::WINDOWS)
  end

  def to_kind(kind : Kind) : Path
    kind.windows? ? to_windows : to_posix
  end

  def to_native : Path
    to_kind(Kind.native)
  end
end
