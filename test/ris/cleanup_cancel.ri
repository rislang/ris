module test/ris/cleanup_cancel
import std/int

group do |g|
  task = g.spawn do
    local_tape do
      text = Str.build { |w| w << "cancel alive" }
      value = 1
      defer puts text
      defer puts value
      value = 9
      IyiScheduler.cancel(IyiScheduler.current)
      IyiScheduler.stop_current
    end
  end
  task.value
end
puts "cancel done"
