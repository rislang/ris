# `IyiSocket#write(first, second)`: two pieces, String or on the tape, in
# one write, read back whole on loopback; a second piece of 1 MiB passes the
# send buffer, so the write parks and goes on where the kernel stopped.
module socket_pair

import std/socket::{IyiSocket}

def read_all(socket : IyiSocket, count : Int32) : Str
  writer = Str::Builder.new(count)
  while writer.length < count
    got = socket.read(writer, count - writer.length).or_panic
    break if got == 0
  end
  writer.finish
end

big = ("b" * 1048576)
server = IyiSocket.listen(0)
client = IyiSocket.connect("127.0.0.1", server.local_port).or_panic
conn = server.accept.or_panic
matches = false
group do |g|
  reader = g.spawn do
    expected = "head:abctape:" + ("b" * 1048576)
    text = read_all(client, expected.bytesize)
    client.close
    text == expected
  end
  conn.write("head:", "abc").or_panic
  tape do
    head = Str.build(8) { |w| w.append("tape:") }
    body = Str.build(big.bytesize) { |w| w.append(big) }
    conn.write(head, body).or_panic
  end
  matches = reader.value.or_panic
end
conn.close
server.close
if matches
  puts "PASS: two pieces in one write, String and on the tape, 1 MiB"
else
  raise "socket bytes differ"
end
