module test/xml_tape

import std/xml::{parse, parse?, escape, unescape?, TapeNode, XmlTree}

# std/xml on the caller's tape: a document read into one node array, its
# names, attributes, namespaces and text, written back and read again,
# built from nothing, copied to the program tape; no heap.

tape do
  text = "<root xmlns:p=\"urn:x\" a=\"&amp;\"><p:child>café &lt;" \
    "<![CDATA[raw]]></p:child><!--ok--><item n=\"1\"/><item n=\"2\">" \
    "<item n=\"3\"/></item></root>"
  doc = parse(text)
  exit 1 unless doc.root.name == "root"
  exit 2 unless doc.root["a"] == "&"
  exit 3 unless doc.root.text == "café <raw"
  w = String::Builder.new(1)
  w << "prefix:"
  doc.to_xml(w)
  rendered = doc.to_xml
  puts rendered
  again = parse(rendered)
  exit 4 unless again.to_xml == rendered
  exit 5 unless w.finish.starts_with?("prefix:<?xml")
  exit 6 unless parse?("<bad>").nil?
  exit 7 unless escape("<&\r") == "&lt;&amp;&#13;"
  child = doc.root.first_element_child
  exit 8 if child.nil?
  puts "#{child.name} #{child.local_name} #{child.namespace_uri}"
  puts doc.root.find_all("item").map { |n| n["n"] }.join(",")
  found = doc.root.find("item")
  exit 9 if found.nil?
  up = found.parent
  puts up ? up.name : "-"
  puts doc.root.children.size
  copied = doc.copy_to(Program.tape)
  puts copied.to_xml == rendered

  held_tree = XmlTree.new
  held_root = held_tree.document.add_element("held")
  3.times do |i|
    held_root.set_attribute("value", "temporary #{i}")
    held_root.add_text("#{i}")
    nil
  end
  exit 30 unless held_root["value"] == "temporary 2"
  exit 31 unless held_root.text == "012"

  tree = XmlTree.new
  built = tree.document
  top = built.add_element("list")
  top.set_attribute("kind", "a<b")
  entry = top.add_element("entry")
  entry.add_text("x & y")
  top.set_attribute("size", "1")
  entry.set_attribute("id", "e1")
  top.set_attribute("kind", "c\"d")
  top.append(built.new_comment("end"))
  puts built.to_xml
  puts unescape?("a &lt; &#x41;") || "-"
  puts unescape?("bad &x;").nil?
end
puts "PASS: xml tape"
