# serve: a server's cost per request, measured on loopback. A client sends
# N keep-alive requests at once and reads the N answers: a small JSON body
# and a header of the block's own. Prints the request count; report tape
# memory with RIS_TAPE_STATS=1 and time it from outside.
#
#   ./bin/ris build --release -o serve samples/ris/serve.ri
#   ./serve           # Server.answer: read and written on the tape
#   ./serve answer    # the same (kept for existing workload commands)
#   /usr/bin/time -f '%e s %M KB' env RIS_TAPE_STATS=1 ./serve answer

module test/ris/server_groups

import std/socket::{IyiSocket}
import std/http::{Server, Incoming, Outgoing}

N = 1000
GROUPS = 20
REQUEST = String.view("GET /users/42?full=1 HTTP/1.1\r\nHost: localhost\r\n" \
  "User-Agent: bench\r\nAccept: */*\r\n\r\n")
BODY = %({"id":42,"name":"Mari","email":"mari@example.com"})

# The answers read into one writer on the tape, emptied before each read,
# so the client puts nothing on the heap and what is counted is the
# server's.
def drain(socket : IyiSocket, want : Int64) : Int64
  got = 0_i64
  tape do
    buffer = String::Builder.new(65536)
    while got < want
      buffer.clear
      n = socket.read(buffer, 65536).or_panic
      break if n == 0
      got += n
    end
  end
  got
end

# Select the port before tasks start; only its scalar crosses the board.
def choose_port : Int32
  probe = IyiSocket.listen(0)
  port = probe.local_port
  probe.close
  port
end

struct Settings
  getter port : Int32
  def initialize(@port)
  end
end

struct Ready
end

struct Handler
  def initialize(config : Int32)
  end

  def listening(port : Int32) : Nil
    RisBoard.post(Ready.new)
  end

  def call(req : Incoming, res : Outgoing) : Nil
    res.header("Content-Type", "application/json")
    res.body.append(BODY)
  end
end

# Each group owns its task records, copied config and connection buffers.
GROUPS.times do
  local_tape do
    response = Outgoing.new
    response.header("Content-Type", "application/json")
    response.body << BODY
    reply = Server.format_response(response, false, false)
    want = reply.bytesize.to_i64 * N
    port = choose_port
    RisBoard.post(Settings.new(port))
    batch = REQUEST * 1000
    got = 0_i64
    group do |g|
      g.spawn do
        settings = RisBoard.take(Settings).or_panic
        Server.answer("127.0.0.1", settings.port, 0, Handler, max_connections: 1)
        0
      end
      RisBoard.take(Ready).or_panic
      client = IyiSocket.connect("127.0.0.1", port).or_panic
      # The client owns its socket and alternates bounded writes and reads.
      (N // 1000).times do
        client.write(batch).or_panic
        got += drain(client, reply.bytesize.to_i64 * 1000)
      end
      client.close
      g.cancel_children
    end
    raise "read #{got} of #{want} bytes" unless got == want
  end
end
puts "PASS: server groups"
