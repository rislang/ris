# Semantic versions, as Semantic Versioning 2.0.0 spells them:
# `MAJOR.MINOR.PATCH`, an optional `-prerelease` of dot-separated
# identifiers, an optional `+build` tail.
#
# `SemanticVersion.parse?` answers nil and `SemanticVersion.parse` panics
# with `not a semantic version: "1.0"` for anything the grammar refuses:
# a missing field, a leading zero in a numeric field or in a numeric
# prerelease identifier, an empty identifier (`1.0.0-alpha..1`, `1.0.0-`,
# `1.0.0+`), a byte outside `[0-9A-Za-z-]` in an identifier, a `v` prefix.
# One trailing newline is tolerated, the way a version read from a file
# arrives, and nothing else outside the grammar is.
#
# Ordering is the standard's: numeric fields, then prerelease identifiers
# (numeric before alphanumeric, numeric by value however long, a numeric
# identifier being digits only so `-1` is alphanumeric, alphanumeric by bytes,
# a shorter list first, and no prerelease after every prerelease). Build
# metadata never orders (`1.0.0+a` and `1.0.0+b` compare equal) but does
# distinguish (`==` and `hash` read it), so a set of versions keeps both.

module std/semantic_version

import std/traits::{Comparable}

@[OnTape]
pub struct SemanticVersion
  getter major : Int32
  getter minor : Int32
  getter patch : Int32
  getter prerelease : String
  getter build : String?

  def self.valid?(str : String) : Bool
    !scan(str).nil?
  end

  def self.parse(str : String) : SemanticVersion
    parse?(str) ||
      raise "not a semantic version: #{str.inspect}"
  end

  def self.parse?(str : String) : SemanticVersion?
    parts = scan(str)
    return nil unless parts
    major_range, minor_range, patch_range, pre_range, build_range = parts
    major = str[major_range].to_i?
    minor = str[minor_range].to_i?
    patch = str[patch_range].to_i?
    return nil unless major && minor && patch
    pre = pre_range ? str[pre_range] : "".as_tape
    build = build_range ? str[build_range] : nil
    SemanticVersion.new(major, minor, patch, pre, build)
  end

  # Byte ranges of the five fields, or nil where the grammar is not met.
  private def self.scan(str : String)
    bytes = str
    stop = str.bytesize

    stop -= 1 if stop > 0 && bytes[stop - 1] == 10_u8 # '\n'
    # And its `\r`: a version read from a Windows file ends in CRLF.
    stop -= 1 if stop > 0 && bytes[stop - 1] == 13_u8 && stop < str.bytesize

    major_end = scan_field(bytes, 0, stop)
    return nil unless major_end
    return nil unless major_end < stop && bytes[major_end] == 46_u8 # '.'

    minor_end = scan_field(bytes, major_end + 1, stop)
    return nil unless minor_end
    return nil unless minor_end < stop && bytes[minor_end] == 46_u8 # '.'

    patch_end = scan_field(bytes, minor_end + 1, stop)
    return nil unless patch_end

    pos = patch_end
    prerelease = nil
    build = nil

    if pos < stop && bytes[pos] == 45_u8 # '-'
      pos += 1
      plus = pos
      while plus < stop && bytes[plus] != 43_u8 # '+'
        plus += 1
      end

      return nil unless scan_identifiers?(bytes, pos, plus, reject_leading_zero: true)
      prerelease = pos...plus
      pos = plus
    end

    if pos < stop && bytes[pos] == 43_u8 # '+'
      pos += 1
      return nil unless scan_identifiers?(bytes, pos, stop, reject_leading_zero: false)
      build = pos...stop
      pos = stop
    end

    return nil unless pos == stop

    {0...major_end, (major_end + 1)...minor_end, (minor_end + 1)...patch_end, prerelease, build}
  end

  # A numeric field: `0`, or a digit run that does not start with `0`.
  private def self.scan_field(bytes : String, start : Int32,
                              stop : Int32) : Int32?
    return nil unless start < stop && bytes[start] >= 48_u8 && bytes[start] <= 57_u8
    return start + 1 if bytes[start] == 48_u8 # '0'

    pos = start + 1
    while pos < stop && bytes[pos] >= 48_u8 && bytes[pos] <= 57_u8
      pos += 1
    end
    pos
  end

  private def self.scan_identifiers?(bytes : String, start : Int32,
                                     stop : Int32, *, reject_leading_zero : Bool) : Bool
    pos = start

    while true
      first = pos
      numeric = true

      while pos < stop
        b = bytes[pos]
        break if b == 46_u8 # '.'
        is_num = b >= 48_u8 && b <= 57_u8
        is_alpha = (b >= 65_u8 && b <= 90_u8) || (b >= 97_u8 && b <= 122_u8)
        is_dash = b == 45_u8
        return false unless is_num || is_alpha || is_dash
        numeric = false unless is_num
        pos += 1
      end

      return false if pos == first
      return false if reject_leading_zero && numeric && pos - first > 1 && bytes[first] == 48_u8

      break if pos == stop
      pos += 1
    end

    true
  end

  def initialize(@major : Int32, @minor : Int32, @patch : Int32,
                 @prerelease : String = "", @build : String? = nil)
    if @major < 0 || @minor < 0 || @patch < 0
      raise "negative version field: #{@major}.#{@minor}.#{@patch}"
    end
  end

  def to_s : String
    to_tape
  end

  def to_tape : String
    String.build { |w| write(w) }
  end

  def write(writer : String::Builder) : Nil
    writer << @major << "." << @minor << "." << @patch
    writer << "-" << @prerelease unless @prerelease.empty?
    if b = @build
      writer << "+" << b
    end
  end

  def <=>(other : SemanticVersion) : Int32
    r = compare(@major, other.major)
    return r unless r == 0
    r = compare(@minor, other.minor)
    return r unless r == 0
    r = compare(@patch, other.patch)
    return r unless r == 0
    theirs = other.prerelease
    return theirs.empty? ? 0 : 1 if @prerelease.empty?
    return -1 if theirs.empty?
    left = @prerelease.split('.')
    right = theirs.split('.')
    left.each_with_index do |a, i|
      return 1 if i >= right.size
      b = right[i]
      an = digits?(a)
      bn = digits?(b)
      return an ? -1 : 1 if an != bn
      if an && a.bytesize != b.bytesize
        return compare(a.bytesize, b.bytesize)
      end
      j = 0
      while j < a.bytesize && j < b.bytesize
        return a[j] < b[j] ? -1 : 1 if a[j] != b[j]
        j += 1
      end
      r = compare(a.bytesize, b.bytesize)
      return r unless r == 0
    end
    compare(left.size, right.size)
  end

  def ==(other : SemanticVersion) : Bool
    (self <=> other) == 0 && @build == other.build
  end

  private def compare(a : Int32, b : Int32) : Int32
    a == b ? 0 : (a < b ? -1 : 1)
  end

  private def digits?(text : String) : Bool
    text.each_byte { |b| return false unless b >= 48_u8 && b <= 57_u8 }
    true
  end
end

impl Comparable for SemanticVersion
  def <=>(other : self) : Int32
    self <=> other
  end
end
