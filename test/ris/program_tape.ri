# Program roots survive request scopes, including independent deep copies.
@[OnTape]
struct Saved
  getter text : String
  getter values : Array(String)
  getter pair : Tuple(String, Array(String))
  getter named : NamedTuple(text: String)

  def initialize(@text, @values)
    @pair = {@text, @values}
    @named = {text: @text}
  end
end

TEXT = "program #{42}"
TYPED_TEXT : String = "typed program"
WORDS = Array(String){"one", "two"}
@@shared = Array(String){"top level"}

class State
  @@log : Array(Int32) = Array(Int32).new(1)
  @@text : String = String.new("initial")
  @@saved : Saved? = nil
  @@tree : RisTree(String)? = nil

  def self.request(n : Int32)
    tape do
      scratch = String.new("request #{n}")
      @@text = scratch.copy_to(Program.tape)
      @@log << n
      @@saved = Saved.new(scratch, Array(String){scratch}).copy_to(Program.tape)
      tree = RisTree(String).new(1)
      root = tree.open(scratch)
      tree.leaf(scratch)
      tree.close(root)
      @@tree = tree.copy_to(Program.tape)
    end
  end

  def self.check
    raise "text" unless @@text == "request 99"
    raise "log" unless @@log.size == 100 && @@log[99] == 99
    saved = (@@saved || raise "missing saved")
    raise "struct" unless saved.text == @@text && saved.values[0] == @@text
    raise "tuple" unless saved.pair[0] == @@text
    raise "named tuple" unless saved.named[:text] == @@text
    tree = (@@tree || raise "missing tree")
    raise "tree" unless tree.size == 2 && tree.stop(0) == 2
    raise "tree text" unless tree[1] == @@text
    @@log.clear
    100.times { |n| @@log << n }
    raise "refill" unless @@log.size == 100
  end
end

100.times { |n| State.request(n) }
State.check
raise "constant" unless TEXT == "program 42" && WORDS[1] == "two"
raise "typed constant" unless TYPED_TEXT == "typed program"
raise "top level" unless @@shared[0] == "top level"
puts "PASS: program tape"
