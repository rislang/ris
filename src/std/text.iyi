# standard: Unicode Standard, String operations
# Text methods are part of the tape String and Char core.
module std/text

spec 8.1
  "\u3000\t".blank?
  "\u3000-42\u3000".to_i == -42
  "ééhelloé".lstrip('é') == "helloé"
  "éhelloé".rstrip("é") == "éhello"
  "aabc".tr("ab", "XY") == "XXYc"
  "ééaa".squeeze == "éa"
  "abc".gsub("b") { |s| s.upcase } == "aBc"
  "\u3000-1.5\u3000".to_f? == -1.5
end
