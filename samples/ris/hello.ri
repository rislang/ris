# The first ris program.
#
#   ./bin/ris run samples/ris/hello.ri
#
# ris is iyi with tape memory: values marked `@[OnTape]` live on the running
# fiber's tape inside `tape`, and its owning scope releases the storage
# together when it ends. Everything else is iyi as it is - and so, underneath,
# Crystal.
module samples/hello

import shop/order::*

# One call: the order is built in the caller's scope, so it lives until
# that scope ends. Every def frees its own scratch when it ends; a def
# that made the lines first and then the order would be refused.
def make_order(id : Int64) : Order
  Order.new(id, "ris", [1200_i64, 350_i64, 99_i64])
end

# The caller's builder keeps the greeting past the order's tape.
def greet(order : Order, greeting : String::Builder) : Nil
  greeting << "Hello from " << order.customer << ", order " << order.id
end

total = 0_i64
greeting = String::Builder.new
tape do
  order = make_order(1_i64)
  total = order_total(order)
  greet(order, greeting)
end

puts greeting
puts "total #{total}"
