# The same through a call: `tag` puts a TapeString on the tape, and the
# checker follows calls, so a helper does not hide it.
def tag : TapeString
  TapeString.build { |w| w.push(97_u8) }
end

Tape.scope do
  names = TapeArray(TapeString).new
  i = 0
  while i < 3
    names.push(tag)
    i += 1
  end
  puts names.size
end
