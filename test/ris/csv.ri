module test/csv

import std/csv::{CSV, CSVReader, CSVWriter, CSVRow, CSVError}
import std/io::{Memory}

# std/csv on the caller's tape: parse and build round-trip, a reader over
# a String with a header and over a stream, a writer, and an error.
# CSV.parse yields each row, freed after it: rows kept are copied.

def rows_of(text : String) : Array(Array(String))
  rows = [] of Array(String)
  CSV.parse(text) { |row| rows << row.copy_to(Program.tape) }
  rows
end

tape do
  text = "id,name,says\r\n1,Ada,\"hi, \"\"there\"\"\"\n2,Bob,\"two\nlines\"\n"
  rows = rows_of(text)
  puts rows.size
  rows.each { |row| puts row.join("|") }
  back = CSV.build(rows)
  puts rows_of(back) == rows
  puts back.bytesize

  reader = CSVReader.new(text, headers: true)
  reader.each do |row|
    puts "#{row.line} #{row["name"]}=#{row["says"].bytesize}"
  end

  stream = CSVReader.new(Memory.new("a; b ;c\n x ;\"y\"\n"), separator: ';', strip: true)
  while got = stream.next_row
    break if got.is_a?(CSVError)
    puts got.join("/")
  end

  bad = CSVReader.new("a,b\n\"open,c\n")
  bad.next_row
  failed = bad.next_row
  puts failed.message if failed.is_a?(CSVError)

  sink = Memory.new
  writer = CSVWriter.new(sink, line_end: "\r\n")
  writer.row(["name", " pad", "say \"x\""])
  writer.row([""])
  puts sink.to_s.inspect
  puts writer.rows

  edges = rows_of("id\r\n\"\"\n\n")
  puts "#{edges.size} #{edges[1].size} #{edges[1][0].empty?} #{edges[2].empty?}"
  puts CSV.build(rows_of("\"\uFEFFid\"")) == "\"\uFEFFid\""
  puts rows_of("\uFEFFa,b")[0][0]
  puts rows_of("").empty?
  kept = rows.copy_to(Program.tape)
  puts kept[1][2]
end
