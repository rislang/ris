module test/mail_tape

import std/mail::{Mail}

kept = ""
tape do
  data = "café\nline \t\r\n\x00=".as_tape
  w = Tape::String::Writer.new(1)
  w << "prefix:"
  Mail.encode_base64(data, w)
  exit 1 unless w.finish.starts_with?("prefix:")
  encoded = Mail.encode_base64(data)
  exit 2 unless Mail.decode_base64(encoded) == data
  exit 3 unless Mail.decode_base64("Y!W Jj=ignored".as_tape) == "abc"
  qp = Mail.encode_quoted_printable(data, true)
  exit 4 unless Mail.decode_quoted_printable(qp) == data
  kept = encoded.to_heap
end
exit 5 unless Mail.encode_base64("café\nline \t\r\n\x00=") == kept
exit 6 unless Mail.decode_base64(kept) == "café\nline \t\r\n\x00="
exit 7 unless Mail.decode_quoted_printable("a=3Db=\r\nc \t\r\n") == "a=bc\r\n"
puts "PASS: mail tape and heap APIs"
