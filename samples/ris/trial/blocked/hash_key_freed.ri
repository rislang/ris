# A Hash key made in a block round is kept unrefused; later text overwrites it.
module samples/trial/blocked/hash_key_freed

counts = Hash(String, Int32).new
"The fox".split.each do |word|
  key = word.downcase
  counts[key] = counts.fetch(key, 0) + 1
end
puts "overwriting text #{counts.size}"
counts.each { |key, n| puts "#{key} #{n}" }
