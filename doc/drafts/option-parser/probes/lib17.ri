module lib17

pub struct Flag17
  getter index : Int32
  def initialize(@index : Int32)
  end
end

pub class Found17
  @values : Array({Int32, String})
  def initialize
    @values = [] of {Int32, String}
  end
  protected def values : Array({Int32, String})
    @values
  end
  def add(index : Int32, value : String) : Nil
    @values << {index, value}
  end
  def reset : Nil
    @values.clear
  end
  def []?(flag : Flag17) : String?
    answer = nil
    @values.each { |v| answer = v[1] if v[0] == flag.index }
    answer
  end
end

pub class Reg17
  @names : Array(String)
  def initialize
    @names = [] of String
  end
  def on(flag : String, description : String) : Flag17
    @names << flag.split(' ')[0]
    Flag17.new(@names.size - 1)
  end
  def on(flag : String, description : String, &block : String -> Nil) : Nil
    {% raise "on with a block: a ris program reads its flags after parse" %}
  end
  def parse(args : Array(String), found : Found17) : Nil
    found.reset
    i = 0
    while i + 1 < args.size
      at = @names.index(args[i])
      if at
        found.values << {at, args[i + 1]}
        i = i + 1
      end
      i = i + 1
    end
  end
end
