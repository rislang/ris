# Tape::Array asked what iyi's Array is asked, on a chat app's models:
# users post messages in a room, and others boost them.
@[OnTape]
struct Message
  getter user_id : Int32
  getter boosts : Int32
  getter body : Tape::String

  def initialize(@user_id, @boosts, body : String)
    @body = Tape::String.view(body)
  end
end

tape do
  # The room's members, by user id.
  members = Tape::Array(Int32){7, 12, 31}
  puts "#{members.size} #{members.first} #{members.last?} #{members.empty?}"
  puts "#{members.includes?(31)} #{members.index(31)} #{members.index(99)}"

  messages = Tape::Array(Message){
    Message.new(7, 0, "Morning!"),
    Message.new(12, 3, "Deploy is green"),
    Message.new(7, 1, "Ship it"),
    Message.new(31, 0, "Hi all"),
  }
  boosted = messages.count { |m| m.boosts > 0 }
  hot = messages.any? { |m| m.boosts >= 3 }
  puts "#{boosted} #{hot} #{messages.all? { |m| members.includes?(m.user_id) }}"
  if first = messages.find { |m| m.user_id == 12 }
    puts first.body
  end
  puts messages.find { |m| m.user_id == 99 }.nil?
  total = messages.reduce(0) { |sum, m| sum + m.boosts }
  puts "#{total} #{messages.max_by { |m| m.boosts }.user_id}"
  puts messages.min_by { |m| m.body.bytesize }.body

  # New arrays on the same tape: boosted ones, the rest, newest first.
  boosted_ones = messages.select { |m| m.boosts > 0 }
  plain = messages.reject { |m| m.boosts > 0 }
  newest = messages.reversed
  puts "#{boosted_ones.size} #{plain.size} #{newest.first.body}"

  # Most boosted first, as a "top messages" panel lists them; ties keep
  # the order they were posted in.
  top = messages.sorted_by { |m| -m.boosts }
  top.each { |m| puts "#{m.boosts} #{m.body}" }
  puts messages.first.body

  # Guests join; the room's member list, sorted and written out.
  guests = Tape::Array(Int32){44, 3}
  everyone = members + guests
  everyone.sort_in_place
  list = Tape::String::Writer.new(64)
  everyone.join(list, ", ")
  puts list.finish
  copy = members.dup
  copy.concat(copy)
  down = copy.sorted { |a, b| a < b ? 1 : 0 }
  puts "#{members.size} #{copy.size} #{down.first}"

  # Past 16 elements the sort merges runs: 40 ids, posted newest first.
  ids = Tape::Array(Int32).new(40) { |i| 40 - i }
  ids.sort_in_place
  puts "#{ids.first} #{ids[15]} #{ids[16]} #{ids.last?} #{ids.sum}"

  # The newest message is taken back, as a deleted one is.
  puts "#{messages.pop.user_id} #{messages.size}"

  # Each member's unread count, none yet.
  unread = Tape::Array(Int32).new(members.size, 0)
  puts "#{unread.size} #{unread.sum} #{unread.first?}"

  empty = Tape::Array(Message).new
  puts "#{empty.empty?} #{empty.first?.nil?} #{empty.pop?.nil?}"
  empty.first
end
