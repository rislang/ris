module test/ris/local
import std/int


def check(ok : Bool) : Nil
  raise "local check failed" unless ok
end

def early : Int32
  tape do
    text = String.build { |w| w.append("early") }
    return text.bytesize
  end
  0
end

check(early == 5)
check(RisRegion.tape != 0_u64)
copy = ""
tape do
  outer = String.build { |w| w.append("outer") }
  saved = RisRegion.tape
  cursor = IyiHeap.read64(saved)
  first = 0_u64
  20.times do
    tape do
      current = RisRegion.tape
      check(current != saved)
      first = current if first == 0_u64
      check(current == first)
      text = String.build(1) { |w| w.append(outer) }
      copy = text.copy_to(Program.tape)
      tape { check(RisRegion.tape == current) }
      break 9
    end
    check(RisRegion.tape == saved)
    check(IyiHeap.read64(saved) == cursor)
    check(outer == "outer")
  end
  tape do
    current = RisRegion.tape
    tape do
      check(RisRegion.tape != current)
      inner = String.build { |w| w.append("inner") }
      check(inner == "inner")
    end
    check(RisRegion.tape == current)
  end
  tape do
    first_mapping = RisRegion.tape
    # Force the local tape to grow onto a second mapping without touching
    # 64 MiB of pages (the mapping is rounded up to a whole 64 KiB grain).
    # Cleanup must release the whole chain, then restore.
    RisRegion.tape_bytes(Tape::CAPACITY &+ RisRegion::GRAIN)
    check(RisRegion.tape != first_mapping)
  end
  check(RisRegion.tape == saved)
  check(IyiHeap.read64(saved) == cursor)
  check(early == 5)
  check(RisRegion.tape == saved)
end
check(copy == "outer")
check(RisRegion.tape != 0_u64)
puts "PASS: local isolation, reuse, nested scopes, borrowed text, retained copy and early exits"
