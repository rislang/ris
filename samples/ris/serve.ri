# serve: a server's cost per request, measured on loopback. A client sends
# N keep-alive requests at once and reads the N answers: a small JSON body
# and a header of the block's own. Prints the request count; report tape
# memory with RIS_TAPE_STATS=1 and time it from outside.
#
#   ./bin/ris build --release -o serve samples/ris/serve.ri
#   ./serve           # Server.answer: read and written on the tape
#   ./serve answer    # the same (kept for existing workload commands)
#   /usr/bin/time -f '%e s %M KB' env RIS_TAPE_STATS=1 ./serve answer

module samples/serve

import std/socket::{IyiSocket}
import std/http::{Server, Outgoing}

N = 200000
REQUEST = Str.view("GET /users/42?full=1 HTTP/1.1\r\nHost: localhost\r\n" \
  "User-Agent: bench\r\nAccept: */*\r\n\r\n")
BODY = %({"id":42,"name":"Mari","email":"mari@example.com"})

# The answers read into one writer on the tape, emptied before each read,
# so the client puts nothing on the heap and what is counted is the
# server's.
def drain(socket : IyiSocket, want : Int64) : Int64
  got = 0_i64
  tape do
    buffer = Str::Builder.new(65536)
    while got < want
      buffer.clear
      n = socket.read(buffer, 65536).or_panic
      break if n == 0
      got += n
    end
  end
  got
end

# Program-owned sockets let the joined tasks use noncapturing procs.
module Loopback
  @@listener : IyiSocket? = nil
  @@client : IyiSocket? = nil
  @@want = 0_i64

  def self.listener : IyiSocket
    @@listener || raise "listener not set up"
  end

  def self.client : IyiSocket
    @@client || raise "client not set up"
  end

  def self.want : Int64
    @@want
  end

  def self.setup(want : Int64) : Nil
    @@want = want
    @@listener = IyiSocket.listen(0)
    @@client = IyiSocket.connect("127.0.0.1", listener.local_port).or_panic
  end
end

response = Outgoing.new
response.header("Content-Type", "application/json")
response.body << BODY
reply = Server.format_response(response, false, false)
want = reply.bytesize.to_i64 * N
Loopback.setup(want)
batch = REQUEST * 1000
got = 0_i64
group do |g|
  g.spawn do
    Server.answer(Loopback.listener) do |req, res|
      res.header("Content-Type", "application/json")
      res.body.append(BODY)
    end
    0
  end
  reader = g.spawn { drain(Loopback.client, Loopback.want) }
  (N // 1000).times { Loopback.client.write(batch).or_panic }
  got = reader.value
  Loopback.client.close
  Loopback.listener.close
end
raise "read #{got} of #{Loopback.want} bytes" unless got == Loopback.want
puts "#{N} requests"
