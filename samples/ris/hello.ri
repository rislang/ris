# The first ris program.
#
#   ./bin/ris run samples/ris/hello.ri
#
# ris is iyi with tape memory: values marked `@[OnTape]` live on the running
# fiber's tape inside `Tape.scope`, and all of it is freed with one store when
# the block ends. Everything else is iyi as it is - and so, underneath,
# Crystal.
module samples/hello

import shop/order::*

def make_order(id : Int64) : Order
  name = Tape::String.build do |s|
    "ris".each_char { |c| s.push(c.ord.to_u8) }
  end
  lines = Tape::Array(Int64).new
  lines.push(1200_i64)
  lines.push(350_i64)
  lines.push(99_i64)
  Order.new(id, name, lines)
end

total = 0_i64
greeting = ""
Tape.scope do
  order = make_order(1_i64)
  total = order_total(order)
  greeting = "Hello from #{order.customer.to_s}, order #{order.id}"
end

puts greeting
puts "total #{total}"
