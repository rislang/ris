@[OnTape]
struct InexactHolder
  getter text : Str

  def initialize(@text)
  end
end

def read_then_shrink(holder : InexactHolder, bytes : Str::Builder)
  text = holder.text
  bytes.clear
  puts text
end

tape do
  bytes = Str::Builder.new
  bytes << "held"
  read_then_shrink(InexactHolder.new(bytes.finish), bytes)
end
