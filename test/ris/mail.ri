module test/mail_tape

import std/mail::{Mail, MailError, MailAddresses}

# std/mail on the caller's tape: a message built with text, HTML and an
# attachment, read back into its node tree, addresses, dates, encodings
# and the errors a reader gives; nothing on the heap.

tape do
  msg = Mail::Message.new
  msg.from = Mail::Address.new("jorg@example.com", "Jörg Müller")
  msg.to << Mail::Address.new("ann@example.org")
  msg.cc << Mail::Address.new("\"bo b\"@example.net", "Bob")
  msg.subject = "Grüße aus Köln"
  msg.date = Mail.date(1792224000_i64, 120)
  msg.message_id = "<20261017.1@example.com>"
  msg.text = "Hallo Ann,\nbis bald.\n"
  msg.html = "<p>Hallo Ann,</p>"
  msg.attach("bericht.txt", "line one\nline two\n")
  wire = msg.to_s
  puts wire.bytesize
  recipients = Array(String).new
  recipient_text = String::Builder.new(256)
  msg.recipients(recipients, recipient_text)
  puts recipients.join(",")

  part_parser = Mail::RisMailParser.new(wire)

  part = part_parser.parse
  if part.is_a?(MailError)
    puts part.message
  else
    puts part.media_type
    puts part.subject || "-"
    values = Array(String).new
    texts = String::Builder.new(256)
    part.header_values("To", values, texts)
    puts values.join(";")
    from_parser = MailAddresses.new("")
    from = part.addresses("From", from_parser)
    puts from.is_a?(MailError) ? from.message : "#{from[0].name}|#{from[0].address}"
    cc_parser = MailAddresses.new("")
    cc = part.addresses("cc", cc_parser)
    puts cc.is_a?(MailError) ? cc.message : "#{cc[0].local}|#{cc[0]}"
    puts part.parts.size
    part.walk { |p| puts "  #{p.media_type} #{p.parts.size} #{p.transfer_encoding}" }
    if plain = part.find("text/plain")
      text = plain.text
      puts text.is_a?(MailError) ? text.message : text.inspect
      puts plain.charset
    end
    part.attachments.each do |a|
      body = a.body
      puts "#{a.filename} #{a.disposition} #{body.is_a?(MailError) ? body.message : body.inspect}"
    end
    kept = part.headers.copy_to(Program.tape)
    puts kept.size
  end

  digest = "Content-Type: multipart/digest; boundary=\"d\"\r\n\r\npre\r\n--d\r\n\r\nSubject: =?utf-8?q?inner_=C3=A9?=\r\n\r\nbody\r\n--d--\r\nepi\r\n"
  got_parser = Mail::RisMailParser.new(digest)
  got = got_parser.parse
  unless got.is_a?(MailError)
    inner = got.parts[0]
    puts "#{inner.media_type} #{inner.parts[0].subject}"
  end
  parameter_parser = Mail::RisMailParser.new("Content-Type: text/plain; charset=iso-8859-1; name*=iso-8859-1''caf%E9; title*0=\"a\"; title*1=\"b\"\r\nContent-Transfer-Encoding: quoted-printable\r\n\r\ncaf=E9 =\r\nau lait")
  got = parameter_parser.parse
  unless got.is_a?(MailError)
    puts "#{got.charset} #{got.param("title")} #{got.filename} #{got.text}"
  end

  [" folded: x\r\n\r\n", "bad line\r\n\r\n",
   "Content-Type: multipart/mixed\r\n\r\n",
   "Content-Type: multipart/mixed; boundary=q\r\n\r\nno parts\r\n",
   "Content-Type: multipart/mixed; boundary=q\r\n\r\n--q\r\n\r\nopen\r\n",
   "Content-Transfer-Encoding: x-uu\r\n\r\nzz"].each do |text|
    bad_parser = Mail::RisMailParser.new(text)
    bad = bad_parser.parse
    if bad.is_a?(MailError)
      puts bad.message
    else
      body = bad.body
      puts body.is_a?(MailError) ? body.message : body
    end
  end

  puts Mail.date(0_i64, -330)
  when_ = Mail.parse_date("Tue, 1 Jul 2003 10:52:37 +0200")
  puts when_.is_a?(MailError) ? when_.message : "#{when_[0]} #{when_[1]}"
  when_ = Mail.parse_date("1 Jul 03 10:52 EDT")
  puts when_.is_a?(MailError) ? when_.message : "#{when_[0]} #{when_[1]}"
  puts Mail.fold("Subject", "a very long subject line that has to be folded somewhere near the seventy-eighth column").inspect
  puts Mail.decode_words("=?ISO-8859-1?Q?Andr=E9?= Pirard")
  addresses = MailAddresses.new("A Group:Ed Jones <c@a.test>,joe@where.test;, \"x y\" <z@q.test>")
  list = addresses.list
  puts list.is_a?(MailError) ? list.message : list.map(&.to_s).join(" | ")
  invalid = MailAddresses.new("two@a.test, three@b.test")
  bad = invalid.single
  puts bad.message if bad.is_a?(MailError)
  qp = Mail.encode_quoted_printable("café = ok\n")
  puts qp.inspect
  puts Mail.decode_quoted_printable(qp).inspect
  puts Mail.encode_base64("café").inspect
  data = "café\nline \t\r\n\x00="
  w = String::Builder.new(1)
  w << "prefix:"
  Mail.encode_base64(data, w)
  puts w.finish.inspect
  puts Mail.decode_base64(Mail.encode_base64(data)) == data
  puts Mail.decode_base64("Y!W Jj=ignored")
  puts Mail.decode_quoted_printable(Mail.encode_quoted_printable(data, true)) == data
end
