# Semantic versions, as Semantic Versioning 2.0.0 spells them:
# `MAJOR.MINOR.PATCH`, an optional `-prerelease` of dot-separated
# identifiers, an optional `+build` tail.
#
# `SemanticVersion.parse?` answers nil and `SemanticVersion.parse` panics
# with `not a semantic version: "1.0"` for anything the grammar refuses:
# a missing field, a leading zero in a numeric field or in a numeric
# prerelease identifier, an empty identifier (`1.0.0-alpha..1`, `1.0.0-`,
# `1.0.0+`), a byte outside `[0-9A-Za-z-]` in an identifier, a `v` prefix.
# One trailing newline is tolerated, the way a version read from a file
# arrives, and nothing else outside the grammar is.
#
# Ordering is the standard's: numeric fields, then prerelease identifiers
# (numeric before alphanumeric, numeric by value however long, a numeric
# identifier being digits only so `-1` is alphanumeric, alphanumeric by bytes,
# a shorter list first, and no prerelease after every prerelease). Build
# metadata never orders (`1.0.0+a` and `1.0.0+b` compare equal) but does
# distinguish (`==` and `hash` read it), so a set of versions keeps both.

module std/semantic_version

import std/traits::{Comparable}

pub struct SemanticVersion
  getter major : Int32
  getter minor : Int32
  getter patch : Int32
  getter build : String?
  getter prerelease : Prerelease

  # The dot-separated identifiers after `-`; a numeric identifier is held
  # as a number so that `beta.2 < beta.11`, and one too long for an Int32
  # is held as its digits and still ordered as a number.
  struct Prerelease
    getter identifiers : Array(String | Int32)

    def self.parse(str : String) : self
      identifiers = [] of String | Int32
      tape do
        unless str.empty?
          str.as_tape.split('.').each do |part|
            n = part.to_i?
            if n && part[0] >= 48_u8 && part[0] <= 57_u8
              identifiers << n
            else
              identifiers << part.to_heap
            end
          end
        end
      end
      new(identifiers)
    end

    def initialize(@identifiers : Array(String | Int32) = [] of String | Int32)
    end

    def empty? : Bool
      @identifiers.empty?
    end

    def to_s(io : IO) : Nil
      io.write(to_s)
    end

    def to_s : String
      result = ""
      tape do
        result = Tape::String.build { |w| write(w) }.to_heap
      end
      result
    end

    def write(writer : Tape::String::Writer) : Nil
      @identifiers.each_with_index do |identifier, i|
        writer << "." if i > 0
        writer << identifier
      end
    end

    # `Prerelease`, not `self`: spelled `self` it was the very method the
    # `impl Comparable` below defines, which replaced it, and that one's
    # `self <=> other` then called itself until the stack ran out.
    def <=>(other : Prerelease) : Int32
      if @identifiers.empty?
        return other.identifiers.empty? ? 0 : 1
      elsif other.identifiers.empty?
        return -1
      end

      i = 0
      while i < @identifiers.size
        return 1 if i >= other.identifiers.size
        r = compare_identifier(@identifiers[i], other.identifiers[i])
        return r if r != 0
        i += 1
      end

      @identifiers.size < other.identifiers.size ? -1 : 0
    end

    private def compare_identifier(x : String | Int32, y : String | Int32) : Int32
      if x.is_a?(Int32)
        if y.is_a?(Int32)
          x == y ? 0 : (x < y ? -1 : 1)
        else
          -1
        end
      else
        if y.is_a?(Int32)
          1
        elsif digits?(x) || digits?(y)
          # A digit run held as a string is a number past Int32: numeric
          # before alphanumeric, a longer number the larger. Compared as
          # bytes, `100000000000` came before `99999999999`.
          return digits?(x) ? -1 : 1 unless digits?(x) && digits?(y)
          return x.bytesize < y.bytesize ? -1 : 1 if x.bytesize != y.bytesize
          x == y ? 0 : (x < y ? -1 : 1)
        else
          x == y ? 0 : (x < y ? -1 : 1)
        end
      end
    end

    private def digits?(s : String) : Bool
      return false if s.empty?
      ptr = s.to_unsafe
      i = 0
      while i < s.bytesize
        return false unless ptr[i] >= 48_u8 && ptr[i] <= 57_u8
        i += 1
      end
      true
    end

    def ==(other : Prerelease) : Bool
      (self <=> other) == 0
    end

    def hash : Int32
      value = 17
      i = 0
      while i < @identifiers.size
        value = (value &* 31) &+ @identifiers[i].hash
        i += 1
      end
      value
    end
  end

  impl Comparable for Prerelease
    def <=>(other : self) : Int32
      self <=> other
    end
  end

  def self.valid?(str : String) : Bool
    result = false
    tape do
      result = valid?(str.as_tape)
    end
    result
  end

  def self.valid?(str : Tape::String) : Bool
    !scan(str).nil?
  end

  def self.parse(str : String) : self
    parse?(str) || raise "not a semantic version: #{str.inspect}"
  end

  def self.parse(str : Tape::String) : TapeSemanticVersion
    parse?(str) ||
      raise "not a semantic version: #{str.to_heap.inspect}"
  end

  def self.parse?(str : String) : self?
    result = nil.as(SemanticVersion?)
    tape do
      if parsed = parse?(str.as_tape)
        result = parsed.to_heap
      end
    end
    result
  end

  def self.parse?(str : Tape::String) : TapeSemanticVersion?
    parts = scan(str)
    return nil unless parts
    major_range, minor_range, patch_range, pre_range, build_range = parts
    major = str[major_range].to_i?
    minor = str[minor_range].to_i?
    patch = str[patch_range].to_i?
    return nil unless major && minor && patch
    pre = pre_range ? str[pre_range] : "".as_tape
    build = build_range ? str[build_range] : nil
    TapeSemanticVersion.new(major, minor, patch, pre, build)
  end

  # Byte ranges of the five fields, or nil where the grammar is not met.
  private def self.scan(str : Tape::String)
    bytes = str.to_unsafe
    stop = str.bytesize

    stop -= 1 if stop > 0 && bytes[stop - 1] == 10_u8 # '\n'
    # And its `\r`: a version read from a Windows file ends in CRLF.
    stop -= 1 if stop > 0 && bytes[stop - 1] == 13_u8 && stop < str.bytesize

    major_end = scan_field(bytes, 0, stop)
    return nil unless major_end
    return nil unless major_end < stop && bytes[major_end] == 46_u8 # '.'

    minor_end = scan_field(bytes, major_end + 1, stop)
    return nil unless minor_end
    return nil unless minor_end < stop && bytes[minor_end] == 46_u8 # '.'

    patch_end = scan_field(bytes, minor_end + 1, stop)
    return nil unless patch_end

    pos = patch_end
    prerelease = nil
    build = nil

    if pos < stop && bytes[pos] == 45_u8 # '-'
      pos += 1
      plus = pos
      while plus < stop && bytes[plus] != 43_u8 # '+'
        plus += 1
      end

      return nil unless scan_identifiers?(bytes, pos, plus, reject_leading_zero: true)
      prerelease = pos...plus
      pos = plus
    end

    if pos < stop && bytes[pos] == 43_u8 # '+'
      pos += 1
      return nil unless scan_identifiers?(bytes, pos, stop, reject_leading_zero: false)
      build = pos...stop
      pos = stop
    end

    return nil unless pos == stop

    {0...major_end, (major_end + 1)...minor_end, (minor_end + 1)...patch_end, prerelease, build}
  end

  # A numeric field: `0`, or a digit run that does not start with `0`.
  private def self.scan_field(bytes : Pointer(UInt8), start : Int32, stop : Int32) : Int32?
    return nil unless start < stop && bytes[start] >= 48_u8 && bytes[start] <= 57_u8
    return start + 1 if bytes[start] == 48_u8 # '0'

    pos = start + 1
    while pos < stop && bytes[pos] >= 48_u8 && bytes[pos] <= 57_u8
      pos += 1
    end
    pos
  end

  private def self.scan_identifiers?(bytes : Pointer(UInt8), start : Int32, stop : Int32, *, reject_leading_zero : Bool) : Bool
    pos = start

    while true
      first = pos
      numeric = true

      while pos < stop
        b = bytes[pos]
        break if b == 46_u8 # '.'
        is_num = b >= 48_u8 && b <= 57_u8
        is_alpha = (b >= 65_u8 && b <= 90_u8) || (b >= 97_u8 && b <= 122_u8)
        is_dash = b == 45_u8
        return false unless is_num || is_alpha || is_dash
        numeric = false unless is_num
        pos += 1
      end

      return false if pos == first
      return false if reject_leading_zero && numeric && pos - first > 1 && bytes[first] == 48_u8

      break if pos == stop
      pos += 1
    end

    true
  end

  def initialize(@major : Int32, @minor : Int32, @patch : Int32, prerelease : String | Prerelease | Nil = nil, @build : String? = nil)
    raise "negative version field: #{@major}.#{@minor}.#{@patch}" if @major < 0 || @minor < 0 || @patch < 0
    @prerelease = case prerelease
                  when Prerelease
                    prerelease
                  when String
                    Prerelease.parse(prerelease)
                  else
                    Prerelease.new
                  end
  end

  def to_s(io : IO) : Nil
    io.write(to_s)
  end

  def to_s : String
    result = ""
    tape do
      result = to_tape.to_heap
    end
    result
  end

  def to_tape : Tape::String
    Tape::String.build { |w| write(w) }
  end

  def write(writer : Tape::String::Writer) : Nil
    writer << @major << "." << @minor << "." << @patch
    unless @prerelease.empty?
      writer << "-"
      @prerelease.write(writer)
    end
    if b = @build
      writer << "+" << b
    end
  end

  def copy_with(major : Int32 = @major, minor : Int32 = @minor, patch : Int32 = @patch, prerelease : String | Prerelease | Nil = @prerelease, build : String? = @build) : SemanticVersion
    SemanticVersion.new(major, minor, patch, prerelease, build)
  end

  def bump_major : self
    copy_with(major: @major + 1, minor: 0, patch: 0, prerelease: nil, build: nil)
  end

  def bump_minor : self
    copy_with(minor: @minor + 1, patch: 0, prerelease: nil, build: nil)
  end

  # A prerelease of a patch is bumped to that patch; a release to the next.
  def bump_patch : self
    if @prerelease.empty?
      copy_with(patch: @patch + 1, prerelease: nil, build: nil)
    else
      copy_with(prerelease: nil, build: nil)
    end
  end

  # Precedence, with build metadata ignored as the standard says. The
  # parameter is `SemanticVersion` for the reason `Prerelease#<=>` gives:
  # as `self` the `impl Comparable` replaced this, and every `<=>`, `==`,
  # `<` and sort recursed until the stack ran out (a hang under --release).
  def <=>(other : SemanticVersion) : Int32
    r = @major == other.major ? 0 : (@major < other.major ? -1 : 1)
    return r unless r == 0
    r = @minor == other.minor ? 0 : (@minor < other.minor ? -1 : 1)
    return r unless r == 0
    r = @patch == other.patch ? 0 : (@patch < other.patch ? -1 : 1)
    return r unless r == 0
    @prerelease <=> other.prerelease
  end

  # Identity, with build metadata read: `1.0.0+a` is not `1.0.0+b`.
  def ==(other : SemanticVersion) : Bool
    (self <=> other) == 0 && @build == other.build
  end

  def hash : Int32
    value = @major
    value = (value &* 31) &+ @minor
    value = (value &* 31) &+ @patch
    value = (value &* 31) &+ @prerelease.hash
    if b = @build
      value = (value &* 31) &+ b.hash
    end
    value
  end
end

impl Comparable for SemanticVersion
  def <=>(other : self) : Int32
    self <=> other
  end
end

# Numeric fields and views of the prerelease and build bytes.
@[OnTape]
pub struct TapeSemanticVersion
  getter major : Int32
  getter minor : Int32
  getter patch : Int32
  getter prerelease : Tape::String
  getter build : Tape::String?

  def initialize(@major : Int32, @minor : Int32, @patch : Int32,
                 @prerelease : Tape::String, @build : Tape::String?)
  end

  def to_heap : SemanticVersion
    build = @build
    SemanticVersion.new(@major, @minor, @patch, @prerelease.to_heap,
                        build ? build.to_heap : nil)
  end

  def to_tape : Tape::String
    Tape::String.build { |w| write(w) }
  end

  def write(writer : Tape::String::Writer) : Nil
    writer << @major << "." << @minor << "." << @patch
    writer << "-" << @prerelease unless @prerelease.empty?
    if b = @build
      writer << "+" << b
    end
  end

  def <=>(other : TapeSemanticVersion) : Int32
    r = compare(@major, other.major)
    return r unless r == 0
    r = compare(@minor, other.minor)
    return r unless r == 0
    r = compare(@patch, other.patch)
    return r unless r == 0
    theirs = other.prerelease
    return theirs.empty? ? 0 : 1 if @prerelease.empty?
    return -1 if theirs.empty?
    left = @prerelease.split('.')
    right = theirs.split('.')
    left.each_with_index do |a, i|
      return 1 if i >= right.size
      b = right[i]
      an = digits?(a)
      bn = digits?(b)
      return an ? -1 : 1 if an != bn
      if an && a.bytesize != b.bytesize
        return compare(a.bytesize, b.bytesize)
      end
      j = 0
      while j < a.bytesize && j < b.bytesize
        return a[j] < b[j] ? -1 : 1 if a[j] != b[j]
        j += 1
      end
      r = compare(a.bytesize, b.bytesize)
      return r unless r == 0
    end
    compare(left.size, right.size)
  end

  def ==(other : TapeSemanticVersion) : Bool
    (self <=> other) == 0 && @build == other.build
  end

  private def compare(a : Int32, b : Int32) : Int32
    a == b ? 0 : (a < b ? -1 : 1)
  end

  private def digits?(text : Tape::String) : Bool
    text.each_byte { |b| return false unless b >= 48_u8 && b <= 57_u8 }
    true
  end
end
