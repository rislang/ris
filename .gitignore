# Environment configuration
/Makefile.local
.env
.env.*
.envrc
.envrc.*

# Build artifacts
*.o
*.ll
*.s
*.obj
*.dwo
*.dwarf
*.pdb
*.exe
/.build/
/.build20/
/.build23/
/docs/
/man/

# Spec artifacts
/test/manual/dwarf/

# CI
/coverage/
/tmp/
/.junit/

# Devenv

# direnv
.direnv

# pre-commit
.pre-commit-config.yaml

# Python bytecode from test/cli and test/speed helpers
__pycache__/
*.pyc

# The VS Code extension's build products; the source is three files.
/editors/vscode/node_modules/
/editors/vscode/*.vsix

# Editor-local configuration: a serverPath is one machine's, not the tree's.
/.vscode/


# The compiler's local cache when RIS_CACHE_DIR is unset.
/.ri/

# ris: scripts/test-par.sh
/test-out/
/test-build.log

# ris: the test scripts' work directories, so the probes they write are
# std's exercises under test/cli/ (FfiBoundaryChecker).
/test/cli/.work/
/test/speed/.work/

# ris: EGM drift reports are worksheets, not committed.
/*_DRIFT_REPORT.md

# Local caches
/.iyi/
__pycache__/
