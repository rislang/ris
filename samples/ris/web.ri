# web: a small web server, each request on its own tape.
#
#   ./bin/ris build -o web samples/ris/web.ri && ./web
#   curl http://localhost:3000/users/1/status
#
# `Server.answer` reads each request onto a tape, hands the block the
# request (`req`, its path a view into the bytes read) and a response
# (`res`) to write into, sends it, and frees the tape: the request, the
# view's HTML and every temporary go at once, with nothing to collect.
# Each worker receives its own copy of the users table. The startup
# line follows listener readiness; INT or TERM cancels the server group.

module samples/web

import std/socket::{IyiSocket}
import std/signal::{Signal}
import std/http::{Server, Incoming, Outgoing}

@[OnTape]
pub struct User
  getter id : Int32
  getter name : Str
  getter status : Str
  def initialize(@id, @name, @status)
  end
end

# Construct configuration on the server task before it copies to workers.
def users : Ary(User)
  Ary(User){
    User.new(1, "alice", "Learning sequential memory management :-)"),
    User.new(2, "bob", "Bumping pointers, freeing nothing"),
  }
end

# The user id in "/users/1/status", or nil when the path is another one.
def status_id(path : Str) : Int32?
  parts = path.split('/')
  return nil unless parts.size == 4 && parts[1] == "users"
  return nil unless parts[3] == "status"
  parts[2].to_i?
end

# The view, as a Slim template would write it:
#
#   h1 = name
#   p.status = status
#
# Written straight into the response body on the request's tape, the
# text HTML-escaped on the way.
def status_view(res : Outgoing, name : Str, status : Str) : Nil
  res.header("Content-Type", "text/html; charset=utf-8")
  html = res.body
  html << "<h1>"
  html.append_html_escaped(name)
  html << "</h1>\n<p class=\"status\">"
  html.append_html_escaped(status)
  html << "</p>\n"
end

def not_found(res : Outgoing) : Nil
  res.status = 404
  res.header("Content-Type", "text/plain")
  res.body << "Not Found\n"
end

struct Ready
end

@[OnTape]
struct Handler
  @users : Ary(User)

  def initialize(@users)
  end

  def listening(port : Int32) : Nil
    RisBoard.post(Ready.new)
  end

  def call(req : Incoming, res : Outgoing) : Nil
    if req.method == "GET" && (id = status_id(req.path)) &&
        (user = @users.find { |user| user.id == id })
      status_view(res, user.name, user.status)
    else
      not_found(res)
    end
  end
end

# Keep the sample's port-zero CLI: choose one port before the pool opens.
def choose_port(port : Int32) : Int32
  return port unless port == 0
  probe = IyiSocket.listen(0)
  selected = probe.local_port
  probe.close
  selected
end

struct Settings
  getter port : Int32
  def initialize(@port)
  end
end

COUNT = Server::MAX_CONNECTIONS
port = choose_port(Program.arguments.empty? ? 3000 : Program.arguments[0].to_i)
RisBoard.post(Settings.new(port))
group do |g|
  g.spawn do
    settings = RisBoard.take(Settings).or_panic
    Server.answer("0.0.0.0", settings.port, users, Handler,
      max_connections: COUNT)
    0
  end
  COUNT.times { RisBoard.take(Ready).or_panic }
  puts "listening on http://localhost:#{port}/users/1/status"
  Signal.wait(Signal::INT, Signal::TERM)
  g.cancel_children
end
