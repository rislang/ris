@[OnTape]
struct BoardCopyFailure
  getter text : String
  getter after : Array(String)
  def initialize(@text : String, @after : Array(String))
  end
end

values = Array(String).new(1)
values << "after"
raise "post" unless RisBoard.post(BoardCopyFailure.new("before", values))
group do |g|
  child = g.spawn do
    RisBoard.take(BoardCopyFailure).is_a?(Cancelled)
  end
  answer = child.value
  {% if flag?(:ris_board_test_panic) %}
    raise "expected injected panic" unless answer.is_a?(Panicked)
  {% else %}
    raise "expected injected cancellation" unless answer == true
  {% end %}
end
# The failed claim leaves the original complete image at the queue head.
answer = RisBoard.take(BoardCopyFailure)
raise "lost image" unless answer.is_a?(BoardCopyFailure) &&
  answer.text == "before" && answer.after[0] == "after"
raise "duplicate" unless RisBoard.poll(BoardCopyFailure) == {nil, false}
puts "PASS: board copy rollback"
