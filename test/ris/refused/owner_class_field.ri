@[Owner]
struct Workspace
  getter left : Array(Int32)
  getter right : Array(Int32)

  def initialize
    @left = Array(Int32).new
    @right = Array(Int32).new
  end
end

class Holder
  getter item : Workspace
  def initialize(@item); end
end
tape do
  a = Workspace.new
  h = Holder.new(a)
  nil
end
