module test/ris/heap_kinds

import std/set

class Kept
  getter value : Int32
  def initialize(@value : Int32)
  end
end

# Value construction and direct allocate use stack storage. Neither is a
# heap site, even when an explicit initializer reaches the primitive.
struct InlineValue
  getter value : Int32

  def initialize(@value : Int32)
  end
end

InlineValue.new(7)
InlineValue.allocate

def unused
  Kept.new(99)
end

kept = Kept.new(42)
text = "value #{kept.value}".to_heap
array = Array(Int32).new(2)
hash = Hash(Int32, Int32).new
set = Set(Int32).new
captured = 3
proc = -> { captured + 1 }
puts text, array.size, hash.size, set.size, proc.call
