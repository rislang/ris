module test/ris/scope_cleanup
import std/int

def early : Int32
  tape do
    text = String.build { |w| w.push(65_u8) }
    return text.bytesize
  end
  0
end

puts early
puts RisRegion.tape != 0_u64
tape do
  tape do
    text = String.build { |w| w.push(66_u8) }
    break text.bytesize
  end
  puts RisRegion.tape != 0_u64
  break 7
end
puts RisRegion.tape != 0_u64
tape do
  text = String.build { |w| w.push(67_u8) }
  puts text
end
puts RisRegion.tape != 0_u64
