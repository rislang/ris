class Left
  def step(n : Int32) : Int32
    descend(n)
  end
end
class Right
  def step(n : Int32) : Int32
    n
  end
end
def descend(n : Int32) : Int32
  a = Array(Int32).new
  receiver = n > 0 ? Left.new : Right.new
  child = n > 0 ? receiver.step(n - 1) : 0
  child + a.size
end
tape { descend(2) }
