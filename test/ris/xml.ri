module test/xml_tape

import std/xml::{parse, parse?, escape}

tape do
  text = "<root xmlns:p=\"urn:x\" a=\"&amp;\"><p:child>café &lt;" \
    "<![CDATA[raw]]></p:child><!--ok--></root>"
  doc = parse(text)
  exit 1 unless doc.root.name == "root"
  exit 2 unless doc.root["a".to_heap] == "&"
  exit 3 unless doc.root.text == "café <raw"
  w = Str::Builder.new(1)
  w << "prefix:"
  doc.to_xml(w)
  rendered = doc.to_xml
  exit 4 unless parse(rendered).root.text == doc.root.text
  exit 5 unless w.finish.starts_with?("prefix:<?xml")
  exit 6 unless parse?("<bad>").nil?
  exit 7 unless escape("<&\r") == "&lt;&amp;&#13;"
  heap = doc.to_heap
  exit 8 unless heap.root.name == "root"
end
exit 9 unless parse("<a>heap</a>".to_heap).root.text == "heap"
puts "PASS: xml tape and heap APIs"
