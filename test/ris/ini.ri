module test/ini_tape

import std/ini::{INI, RisIni}

# std/ini on the caller's tape: a byte order mark, CRLF, a repeated
# section and key, Unicode blanks, build round-trip, refusals, and a copy
# kept past the tape.

kept = RisIni.new
tape do
  doc = INI.parse("﻿top=yes\r\n[s]\na = café\n; note\n[t]\nk=v=w\n[s]\na=last\n")
  puts doc.sections.join(",")
  puts "#{doc["", "top"]} #{doc["s", "a"]} #{doc["t", "k"]} #{doc.size}"
  puts doc["s", "b"]?.nil?
  w = String::Builder.new(1)
  w << "prefix:"
  INI.build(doc, w, true)
  puts w.finish.inspect
  puts INI.parse(INI.build(doc)) == doc
  spaced = INI.parse("x= café　\n")
  puts spaced["", "x"]
  kept = doc.copy_to(Program.tape)
end
puts INI.parse(INI.build(kept)) == kept
puts INI.parse("").empty?
puts kept["t", "k"]
