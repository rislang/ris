class Holder
  getter bytes : String::Builder
  property view : String

  def initialize(@view : String)
    @bytes = String::Builder.new(16)
    @bytes << "abc"
  end

  def head : String
    @bytes.finish
  end

  def wipe : Nil
    @bytes.clear
  end

  def wipe_using(borrowed : String) : Int32
    @bytes.clear
    borrowed.bytesize
  end
end

def run
  holder = Holder.new("x")
  puts holder.wipe_using(holder.bytes.finish)
end
tape { run }
