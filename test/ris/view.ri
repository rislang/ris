# Goose's index types and checkfree functions: a CSR graph's edges are
# checked once when they come in, and the breadth-first search reads and
# writes `dist[adj[k]]` with no check left, which @[CheckFree]
def levels(edges : Tape::View(Int32), first : Int32) : Int32
  total = 0
  k = 0
  while k < edges.size
    edges[k] = first + k
    total = total + edges[k]
    k += 1
  end
  total
end

tape do
  # 4 nodes; edges 0->1, 0->2, 1->3, 2->3.
  start = Tape::Array(Int32).new(5)
  [0, 2, 3, 4, 4].each { |s| start.push(s) }
  adj = Tape::Array(Int32).new(4)
  [1, 2, 3, 3].each { |e| adj.push(e) }
  dist = Tape::Array(Int32).new(4) { |i| i == 0 ? 0 : -1 }
  edges = dist.values_at(adj)
  puts "#{edges.size} edges, last names #{edges.index(3)}, reads #{edges[3]}"
  puts "levels #{levels(edges, 1)} dist #{dist[1]} #{dist[2]} #{dist[3]}"
  bad = Tape::Array(Int32).new(1)
  bad.push(9)
  dist.values_at(bad)
end
