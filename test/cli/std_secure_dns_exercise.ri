# Exercises std/secure_dns: a `Resolver` asking DNS over TLS and DNS over
# HTTPS upstreams, against test/cli/std_secure_dns_server.py.
#
#     ./bin/ris run test/cli/std_secure_dns_exercise.ri -- WORKDIR
#
# WORKDIR is the scripted servers': their ports and the test root they
# chain to (see the server's header for the zone and the names that
# misbehave). Each section prints "<name>: ok", or "<name>: skipped: why"
# where the server has no HTTP/2; each answer the zone gives is printed as
# "answer <via> <type> <name> <values>", which the gate asks dig for too.
#
# Without WORKDIR only the wire section runs, which needs no server: that
# is how test/cli/std_exercise.sh runs every exercise, from source and from
# artifacts, and compares what the two print - so nothing printed before
# the stop names a port or a time.

module bench/std_secure_dns_exercise

import std/dns::{DnsError, SvcbStore, DnsTapeMessage, DnsName, DnsTapeRecord, SvcbAnswer}
import std/socket::{DnsUpstream, IPAddress, IPv4Address, IPv6Address, IyiSocket, Resolver, DnsLookup, SocketError}
import std/secure_dns::{DnsOverHttps, DnsOverTls}
import std/tls::{TlsConfig}
import std/x509::{RisCertificateStore, Certificate}
import std/file::{File}

# A PEM text's certificates, kept in *store*; a text that does not read
# panics with the reason.
def pem_certs(store : RisCertificateStore, text : String) : Array(Certificate)
  if problem = store.read_pem(text)
    raise problem.message
  end
  store.kept_certificates
end

def check(cond : Bool, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}" unless cond
end

def same(expected : String, actual : String, msg : String) : Nil
  raise "ASSERTION FAILED: #{msg}\n  expected #{expected}\n  got      #{actual}" unless expected == actual
end

def show(got : Array(IPAddress) | DnsError | Cancelled) : String
  case got
  in Array(IPAddress)
    got.map(&.to_s).join(" ")
  in DnsError
    "error: #{got.message}"
  in Cancelled
    "cancelled"
  end
end

def show_txt(got : Array(String) | DnsError | Cancelled) : String
  case got
  in Array(String)
    got.join(" | ")
  in DnsError
    "error: #{got.message}"
  in Cancelled
    "cancelled"
  end
end

def error_of(got : Array(IPAddress) | Array(String) | DnsError | Cancelled, label : String) : DnsError
  unless got.is_a?(DnsError)
    shown = got.is_a?(Array(String)) ? got.join(" | ") : (got.is_a?(Array(IPAddress)) ? got.map(&.to_s).join(" ") : "cancelled")
    raise "ASSERTION FAILED: #{label}: expected a refusal, got #{shown}"
  end
  got
end

# The addresses of one family: what dig asks for with one type.
def family(got : Array(IPAddress) | DnsError | Cancelled, type : String) : String
  return show(got) unless got.is_a?(Array(IPAddress))
  text = ""
  write_family(got, type, text)
  text
end

def write_family(got : Array(IPAddress), type : String,
                 writer : String::Builder) : Nil
  got.each do |address|
    if (type == "A") == address.is_a?(IPv4Address)
      writer << " " unless writer.bytesize == 0
      writer << address.to_s
    end
  end
  nil
end

# The zone's HTTPS record at svc.zone.test, as `SvcbRecord#to_s` and dig
# print it: alpn h2 and http/1.1, and RFC 9848 3's example ECHConfigList.
SVC_HTTPS = "1 . alpn=\"h2,http/1.1\" ech=AEj+DQBEAQAgACAdd+scUi0IYFsXnUIU7ko2Nd9+F8M26pAGZVpz/KrWPgAEAAEAAWQVZWNoLXNpdGVzLmV4YW1wbGUubmV0AAA="

# What SVCB resolution came to: the name, the aliases followed and the
# ServiceMode records, or the failure.
def show_https(got : SvcbAnswer | DnsError | Cancelled) : String
  case got
  in SvcbAnswer
    "#{got.name} after #{got.aliases} aliases: #{got.records.map(&.to_s).join(" | ")}"
  in DnsError
    "error: #{got.message}"
  in Cancelled
    "cancelled"
  end
end

# The zone's answers through *resolver*, printed for the gate and held to
# the zone as the server's script writes it. Its HTTPS records first, to
# the same text the plaintext path reads them as (`https_plaintext`).
def answers(via : String, resolver : Resolver) : Nil
  https_store_1 = SvcbStore.new
  same "svc.zone.test after 0 aliases: #{SVC_HTTPS}", show_https(resolver.https_records("svc.zone.test", 443, https_store_1)), "#{via}: a ServiceMode HTTPS record, its alpn and ech"
  puts "answer #{via} HTTPS svc.zone.test #{SVC_HTTPS}"
  https_store_2 = SvcbStore.new
  same "svc.zone.test after 1 aliases: #{SVC_HTTPS}", show_https(resolver.https_records("https.zone.test", 443, https_store_2)), "#{via}: an AliasMode HTTPS record followed"
  same "192.0.2.1", show(resolver.resolve("a.zone.test")), "#{via}: an A record"
  puts "answer #{via} A a.zone.test 192.0.2.1"
  same "2001:db8::6", show(resolver.resolve("six.zone.test")), "#{via}: an AAAA record"
  puts "answer #{via} AAAA six.zone.test 2001:db8::6"
  dual = resolver.resolve("dual.zone.test")
  same "192.0.2.2 2001:db8::2", show(dual), "#{via}: A and AAAA together"
  puts "answer #{via} A dual.zone.test #{family(dual, "A")}"
  puts "answer #{via} AAAA dual.zone.test #{family(dual, "AAAA")}"
  alias_of = resolver.resolve("alias.zone.test")
  same "192.0.2.1", show(alias_of), "#{via}: a CNAME followed"
  puts "answer #{via} A alias.zone.test #{family(alias_of, "A")}"
  txt_1_texts = [] of String
  txt_1_bytes = String::Builder.new(1024)
  text = (resolver.txt("txt.zone.test", txt_1_texts, txt_1_bytes) || txt_1_texts)
  same "hello, encrypted worldand a second string | v=spf1 -all", show_txt(text), "#{via}: TXT records, each one's strings joined"
  puts "answer #{via} TXT txt.zone.test #{show_txt(text)}"
  missing = error_of(resolver.resolve("nx.zone.test"), "#{via}: NXDOMAIN")
  check missing.not_found?, "#{via}: NXDOMAIN is not_found?: #{missing.message}"
end

def stats(resolver : Resolver) : Hash(String, Int32)
  stats(resolver, Hash(String, Int32).new, Array(String).new,
    String::Builder.new(1024))
end

def stats(resolver : Resolver, read : Hash(String, Int32),
          txt_2_texts : Array(String),
          txt_2_bytes : String::Builder) : Hash(String, Int32)
  got = (resolver.txt("stats.zone.test", txt_2_texts, txt_2_bytes) || txt_2_texts)
  raise "ASSERTION FAILED: the server's stats: #{show_txt(got)}" unless got.is_a?(Array(String)) && got.size == 1
  got[0].split(' ').each do |pair|
    parts = pair.split('=')
    key = parts[0]
    at = txt_2_bytes.bytesize
    txt_2_bytes << key
    read[txt_2_bytes.finish[at, key.bytesize]] = parts[1].to_i
  end
  read
end

# The server's count of the queries one transport brought it since it was
# last asked, this one included - how many, how many with an OPT record,
# how many not padded as RFC 7830 and RFC 8467 4.1 have a client pad - and
# the sentence it said them in, which names the first fault.
def padding(resolver : Resolver) : Tuple(Int32, Int32, Int32, String)
  padding(resolver, Array(String).new, String::Builder.new(1024))
end

def padding(resolver : Resolver, txt_3_texts : Array(String),
            txt_3_bytes : String::Builder) : Tuple(Int32, Int32, Int32, String)
  got = (resolver.txt("padding.zone.test", txt_3_texts, txt_3_bytes) || txt_3_texts)
  raise "ASSERTION FAILED: the server's padding counts: #{show_txt(got)}" unless got.is_a?(Array(String)) && got.size == 1
  words = got[0].split(' ')
  {words[0].split('=')[1].to_i, words[1].split('=')[1].to_i, words[2].split('=')[1].to_i, got[0]}
end

# The server's counts for a transport started again, whatever an earlier
# run left in them. What it answers is not read: a transport that cannot
# ask is the next check's to report, in that check's words.
def restart_counts(resolver : Resolver) : Nil
  txt_4_texts = [] of String
  txt_4_bytes = String::Builder.new(1024)
  (resolver.txt("padding.zone.test", txt_4_texts, txt_4_bytes) || txt_4_texts)
end

# Why *query*, asked about a name of *chars* characters, is not padded as
# RFC 7830 and RFC 8467 4.1 have a client pad it; nil when it is. The
# length wanted is found by counting up in blocks, not by the module's
# arithmetic.
def padding_fault(query : String, chars : Int32) : String?
  opt = 12 + chars + 2 + 4
  wanted = 128
  while wanted < opt + 15
    wanted = wanted + 128
  end
  return "#{query.bytesize} bytes, not a multiple of 128" unless query.bytesize % 128 == 0
  return "#{query.bytesize} bytes, not #{wanted}, the first multiple of 128 to hold #{opt + 15}" unless query.bytesize == wanted
  return "ARCOUNT #{query[10]} #{query[11]}, not one record" unless query[10] == 0_u8 && query[11] == 1_u8
  return "an OPT record not owned by the root" unless query[opt] == 0_u8
  return "a record of type #{query[opt + 1]} #{query[opt + 2]}, not OPT (41)" unless query[opt + 1] == 0_u8 && query[opt + 2] == 41_u8
  payload = (query[opt + 3].to_i32 << 8) | query[opt + 4].to_i32
  return "a payload size of #{payload}, below the #{query.bytesize} bytes sent (RFC 7830 4)" if payload < 512 || payload < query.bytesize
  index = opt + 5
  while index < opt + 9
    return "byte #{index} of the TTL is #{query[index]}: RCODE, version and flags are 0" unless query[index] == 0_u8
    index = index + 1
  end
  data = (query[opt + 9].to_i32 << 8) | query[opt + 10].to_i32
  return "OPT data of #{data} bytes where #{query.bytesize - opt - 11} follow" unless data == query.bytesize - opt - 11
  code = (query[opt + 11].to_i32 << 8) | query[opt + 12].to_i32
  return "option #{code}, not Padding (12)" unless code == 12
  length = (query[opt + 13].to_i32 << 8) | query[opt + 14].to_i32
  return "a Padding option of #{length} bytes where #{query.bytesize - opt - 15} follow" unless length == query.bytesize - opt - 15
  index = opt + 15
  while index < query.bytesize
    return "padding byte #{index} is #{query[index]}, not 0 (RFC 7830 3)" unless query[index] == 0_u8
    index = index + 1
  end
  return "it ends at #{DnsTapeMessage.ends_at(query)}" unless DnsTapeMessage.ends_at(query) == query.bytesize
  nil
end

# *bytes* as the String a message is.
def wire(bytes : Array(UInt8)) : String
  String.build(bytes.size) { |writer| bytes.each { |byte| writer.push(byte) } }
end

# --- The wire, with no network ---

strings = DnsTapeRecord.character_strings(wire([5_u8, 104_u8, 101_u8, 108_u8, 108_u8, 111_u8, 1_u8, 33_u8]))
check strings == ["hello", "!"], "a TXT record's character-strings: #{strings.inspect}"
check DnsTapeRecord.character_strings(wire([5_u8, 104_u8, 101_u8])).nil?, "a character-string running past the data is refused"
query = DnsTapeMessage.query(0_u16, "a.zone.test", DnsTapeRecord::A)
check query[11] == 0_u8, "a query for the clear has no OPT record (RFC 7830 6)"
check DnsTapeMessage.ends_at(query) == query.bytesize, "a query ends where its question does: #{DnsTapeMessage.ends_at(query)} of #{query.bytesize}"
longer = query + wire([0_u8, 0_u8, 0_u8])
check DnsTapeMessage.ends_at(longer) == query.bytesize, "bytes after a message are not the message's: #{DnsTapeMessage.ends_at(longer)}"
check DnsTapeMessage.ends_at(query[0, query.bytesize - 1]) == -1, "a question cut short runs past the bytes"
# The oracle is Python's base64.urlsafe_b64encode of the same 29 bytes,
# "AAABAAABAAAAAAAAAWEEem9uZQR0ZXN0AAABAAE=", without its "=".
parameter = DnsOverHttps.base64url(query)
same "AAABAAABAAAAAAAAAWEEem9uZQR0ZXN0AAABAAE", parameter, "the dns parameter is base64url without padding (RFC 8484 4.1)"
puts "wire: ok"

# Every name length a host name can have, 1 to 253 characters, so each
# block's last length and the next block's first are both padded: labels
# of 49 characters, a dot after each.
chars = 1
while chars <= 253
  built = String::Builder.new
  index = 0
  while index < chars
    built << (index % 50 == 49 && index != chars - 1 ? '.' : 'a')
    index = index + 1
  end
  name = built.to_s
  check DnsName.valid?(name), "#{chars} characters make a host name"
  padded = DnsTapeMessage.query(0x2A2A_u16, name, DnsTapeRecord::AAAA, DnsTapeMessage::PADDING_BLOCK)
  fault = padding_fault(padded, chars)
  raise "ASSERTION FAILED: a padded query for a name of #{chars} characters: #{fault}" if fault
  read = DnsTapeMessage.parse(padded)
  check read.is_a?(DnsTapeMessage) && read.question_name == name && read.rcode == 0, "a padded query parses back: #{read.is_a?(DnsError) ? read.message : read.question_name}"
  chars = chars + 1
end
puts "wire_padding: ok"

if Program.args.empty?
  puts "no server directory given: the sections over the network are test/cli/std_secure_dns_exercise.sh's"
  exit 0
end

dir = Program.args[0]
dot_port = File.read(dir + "/dot.port").to_i
doh_port = File.read(dir + "/doh.port").to_i
udp_port = File.read(dir + "/udp.port").to_i
pem_store_1 = RisCertificateStore.new
roots = pem_certs(pem_store_1, File.read(dir + "/ca.pem"))

config = TlsConfig.new
config.roots = roots
https = TlsConfig.new
https.roots = roots
https.alpn = ["h2", "http/1.1"]

# A resolver that would answer anything over plaintext: its server is the
# scripted UDP one, so an answer that came that way says "udp". The
# sections that expect a refusal ask through `bare`, which has no
# plaintext server at all, so that a resolver falling back where it should
# not is caught by the section about falling back, not by the first
# refusal it turns into an answer.
plain = Resolver.new(["127.0.0.1:#{udp_port}"], timeout_ms: 3000, attempts: 1)
bare = Resolver.new([] of String, timeout_ms: 3000, attempts: 1)

# --- DNS over TLS ---

dot = DnsOverTls.new("dns.test", "127.0.0.1", dot_port, config)
encrypted_1 = Resolver.new([] of String, timeout_ms: 3000, attempts: 1)
encrypted_1.encrypt(dot)
over_tls = encrypted_1
restart_counts(over_tls)
txt_5_texts = [] of String
txt_5_bytes = String::Builder.new(1024)
encrypted_2 = Resolver.new(["127.0.0.1:#{udp_port}"], timeout_ms: 3000, attempts: 1)
encrypted_2.encrypt(dot)
same "tls", show_txt((encrypted_2.txt("transport.zone.test", txt_5_texts, txt_5_bytes) || txt_5_texts)), "the encrypted resolver asks over TLS, not its plaintext server"
first = stats(over_tls)
answers("dot", over_tls)
puts "dot_answers: ok"

last = stats(over_tls)
check dot.connections_made == 1, "every query over one TLS connection: #{dot.connections_made} made"
same first["connections"].to_s, last["connections"].to_s, "the server accepted no second connection for them"
check last["queries"] > first["queries"] + 10, "the server read every query on the one connection: #{first["queries"]} then #{last["queries"]}"
puts "dot_reuse: ok"

check last["batch"] == 2, "A and AAAA were read by the server before it answered either (pipelined): the most at once was #{last["batch"]}"
puts "dot_pipelined: ok"

idle = DnsOverTls.new("dns.test", "127.0.0.1", dot_port, config, idle_ms: 200)
encrypted_3 = Resolver.new([] of String, timeout_ms: 3000, attempts: 1)
encrypted_3.encrypt(idle)
idling = encrypted_3
same "192.0.2.1", show(idling.resolve("a.zone.test")), "an answer before the idle timeout"
check idle.connections_made == 1, "one connection for the first lookup"
sleep 600
same "192.0.2.1", show(idling.resolve("a.zone.test")), "an answer after it"
check idle.connections_made == 2, "a connection idle past its timeout is closed and another opened: #{idle.connections_made} made"
idling.close
puts "dot_idle: ok"

wrong = DnsOverTls.new("wrong.test", "127.0.0.1", dot_port, config)
encrypted_4 = Resolver.new([] of String, timeout_ms: 3000, attempts: 1)
encrypted_4.encrypt(wrong)
refused = error_of(encrypted_4.resolve("a.zone.test"), "a server whose certificate does not name wrong.test")
check refused.unreachable? && refused.message.includes?("wrong.test"), "the certificate is checked for the configured name (RFC 8310): #{refused.message}"
untrusted_config = TlsConfig.new
untrusted = DnsOverTls.new("dns.test", "127.0.0.1", dot_port, untrusted_config)
encrypted_5 = Resolver.new([] of String, timeout_ms: 3000, attempts: 1)
encrypted_5.encrypt(untrusted)
distrusted = error_of(encrypted_5.resolve("a.zone.test"), "a server whose root is not trusted")
check distrusted.unreachable?, "a chain to a root the configuration lacks is refused: #{distrusted.message}"
puts "dot_wrong_name: ok"

mismatched_lookup = DnsLookup.new
mismatched_replies = [] of String
mismatched = dot.exchange([DnsTapeMessage.query(0x1234_u16, "wrong-id.zone.test", DnsTapeRecord::A, DnsTapeMessage::PADDING_BLOCK)], 3000, mismatched_lookup, mismatched_replies) || mismatched_replies
check mismatched.is_a?(DnsError) && mismatched.malformed? && mismatched.message.includes?("ID"), "an answer with an ID no query has is refused over TLS: #{mismatched.is_a?(DnsError) ? mismatched.message : "accepted"}"
forged = error_of(over_tls.resolve("wrong-id.zone.test"), "a lookup answered with another ID")
check forged.malformed?, "and through the resolver: #{forged.message}"
puts "dot_id_mismatch: ok"

cut = error_of(over_tls.resolve("cut.zone.test"), "an answer cut short by the connection's end")
check cut.malformed? && cut.message.includes?("truncated"), "a frame that ends early is truncated: #{cut.message}"
tc = error_of(over_tls.resolve("tc.zone.test"), "an answer with TC over TLS")
check tc.malformed? && tc.message.includes?("TC"), "TC over a stream is refused: #{tc.message}"
puts "dot_truncated: ok"

long = error_of(over_tls.resolve("long.zone.test"), "a frame longer than its message")
check long.malformed? && long.message.includes?("oversized"), "bytes past the message in its frame are refused: #{long.message}"
puts "dot_oversized: ok"

same "192.0.2.1", show(over_tls.resolve("a.zone.test")), "the upstream answers again after the failures, on a new connection"
puts "dot_recovers: ok"

queries, edns, unpadded, said = padding(over_tls)
check queries > 10 && edns == queries && unpadded == 0, "every DoT query is padded to a multiple of 128 with zero bytes (RFC 7830, RFC 8467 4.1): #{said}"
puts "dot_padding: ok"

# An answer as a server that speaks EDNS(0) writes it: an OPT record in
# the additional section, padded to 468 octets (RFC 8467 4.1), and an
# NXDOMAIN with the zone's SOA in its authority section, which every
# `answers` above read through already (nx.zone.test).
exchanged_lookup = DnsLookup.new
exchanged_replies = [] of String
exchanged = dot.exchange([DnsTapeMessage.query(0x4242_u16, "a.zone.test", DnsTapeRecord::A, DnsTapeMessage::PADDING_BLOCK)], 3000, exchanged_lookup, exchanged_replies) || exchanged_replies
raise "ASSERTION FAILED: a padded query over TLS: #{exchanged.is_a?(DnsError) ? exchanged.message : "cancelled"}" unless exchanged.is_a?(Array(String))
opt_answer = exchanged[0]
check opt_answer[11] == 1_u8 && opt_answer.bytesize % 468 == 0, "the server answers with an OPT record and pads to 468: #{opt_answer.bytesize} bytes, ARCOUNT #{opt_answer[11]}"
parsed = DnsTapeMessage.parse(opt_answer)
check parsed.is_a?(DnsTapeMessage) && parsed.rcode == DnsTapeMessage::RCODE_NOERROR && parsed.answers.size == 1, "an answer with an OPT record parses: #{parsed.is_a?(DnsError) ? parsed.message : parsed.rcode}"
check DnsTapeMessage.ends_at(opt_answer) == opt_answer.bytesize, "and ends where its OPT record does: #{DnsTapeMessage.ends_at(opt_answer)} of #{opt_answer.bytesize}"
badvers = error_of(over_tls.resolve("badvers.zone.test"), "an answer of BADVERS")
check badvers.refused? && badvers.message.includes?("BADVERS"), "the OPT record's extended RCODE is read: BADVERS (16) is not NOERROR: #{badvers.message}"
puts "edns_answers: ok"

# --- DNS over HTTPS, HTTP/1.1 ---

doh = DnsOverHttps.new("https://127.0.0.1:#{doh_port}/dns-query", config: https)
encrypted_6 = Resolver.new([] of String, timeout_ms: 3000, attempts: 1)
encrypted_6.encrypt(doh)
over_https = encrypted_6
restart_counts(over_https)
txt_6_texts = [] of String
txt_6_bytes = String::Builder.new(1024)
same "https/1.1", show_txt((over_https.txt("transport.zone.test", txt_6_texts, txt_6_bytes) || txt_6_texts)), "over HTTPS from a server without h2, HTTP/1.1"
answers("doh", over_https)
puts "doh_post: ok"

doh_get = DnsOverHttps.new("https://127.0.0.1:#{doh_port}/dns-query", config: https, method: "GET")
encrypted_7 = Resolver.new([] of String, timeout_ms: 3000, attempts: 1)
encrypted_7.encrypt(doh_get)
answers("doh-get", encrypted_7)
puts "doh_get: ok"

txt_7_texts = [] of String
txt_7_bytes = String::Builder.new(1024)
same "id=0", show_txt((over_https.txt("id.zone.test", txt_7_texts, txt_7_bytes) || txt_7_texts)), "a POST's query has the ID 0 (RFC 8484 4.1)"
txt_8_texts = [] of String
txt_8_bytes = String::Builder.new(1024)
encrypted_8 = Resolver.new([] of String, timeout_ms: 3000, attempts: 1)
encrypted_8.encrypt(doh_get)
same "id=0", show_txt((encrypted_8.txt("id.zone.test", txt_8_texts, txt_8_bytes) || txt_8_texts)), "and a GET's"
puts "doh_zero_id: ok"

check doh.connections_made == 1 && doh.connections_reused > 5, "one connection kept for every request: #{doh.connections_made} made, #{doh.connections_reused} reused"
puts "doh_reuse: ok"

encrypted_9_upstream = DnsOverHttps.new("https://127.0.0.1:#{doh_port}/status-500", config: https)
encrypted_9 = Resolver.new([] of String, timeout_ms: 3000, attempts: 1)
encrypted_9.encrypt(encrypted_9_upstream)
status = error_of(encrypted_9.resolve("a.zone.test"), "a 500")
check status.refused? && status.message.includes?("HTTP 500"), "a status other than 200 is refused: #{status.message}"
puts "doh_status: ok"

encrypted_10_upstream = DnsOverHttps.new("https://127.0.0.1:#{doh_port}/wrong-type", config: https)
encrypted_10 = Resolver.new([] of String, timeout_ms: 3000, attempts: 1)
encrypted_10.encrypt(encrypted_10_upstream)
typed = error_of(encrypted_10.resolve("a.zone.test"), "an answer as text/plain")
check typed.malformed? && typed.message.includes?("text/plain"), "a Content-Type other than application/dns-message is refused: #{typed.message}"
puts "doh_content_type: ok"

huge = error_of(over_https.resolve("long.zone.test"), "a body past 65535 bytes")
check huge.malformed? && huge.message.includes?("oversized"), "a body longer than any DNS message is refused: #{huge.message}"
puts "doh_oversized: ok"

short = error_of(over_https.resolve("cut.zone.test"), "a body cut short")
check !short.not_found?, "a body that ends before its length is refused: #{short.message}"
flagged = error_of(over_https.resolve("tc.zone.test"), "TC over HTTPS")
check flagged.malformed? && flagged.message.includes?("TC"), "TC over HTTPS is refused: #{flagged.message}"
puts "doh_truncated: ok"

misnamed = DnsOverHttps.new("https://wrong.test:#{doh_port}/dns-query", "127.0.0.1", https)
encrypted_11 = Resolver.new([] of String, timeout_ms: 3000, attempts: 1)
encrypted_11.encrypt(misnamed)
mistaken = error_of(encrypted_11.resolve("a.zone.test"), "an HTTPS server whose certificate does not name wrong.test")
check mistaken.unreachable? && mistaken.message.includes?("wrong.test"), "the certificate is checked for the URL's host: #{mistaken.message}"
pinned = DnsOverHttps.new("https://dns.test:#{doh_port}/dns-query", "127.0.0.1", https)
encrypted_12 = Resolver.new([] of String, timeout_ms: 3000, attempts: 1)
encrypted_12.encrypt(pinned)
same "192.0.2.1", show(encrypted_12.resolve("a.zone.test")), "a URL's host pinned to an address, checked by name"
puts "doh_wrong_name: ok"

queries, edns, unpadded, said = padding(over_https)
check queries > 10 && edns == queries && unpadded == 0, "every DoH query, POST and GET, is padded to a multiple of 128 with zero bytes: #{said}"
puts "doh_padding: ok"

# --- DNS over HTTPS, HTTP/2 ---

if File.file?(dir + "/h2.port")
  h2_port = File.read(dir + "/h2.port").to_i
  encrypted_13_upstream = DnsOverHttps.new("https://127.0.0.1:#{h2_port}/dns-query", config: https)
  encrypted_13 = Resolver.new([] of String, timeout_ms: 3000, attempts: 1)
  encrypted_13.encrypt(encrypted_13_upstream)
  over_h2 = encrypted_13
  restart_counts(over_h2)
  txt_9_texts = [] of String
  txt_9_bytes = String::Builder.new(1024)
  same "h2", show_txt((over_h2.txt("transport.zone.test", txt_9_texts, txt_9_bytes) || txt_9_texts)), "h2 is preferred where the server speaks it"
  answers("h2", over_h2)
  encrypted_14_upstream = DnsOverHttps.new("https://127.0.0.1:#{h2_port}/dns-query", config: https, method: "GET")
  encrypted_14 = Resolver.new([] of String, timeout_ms: 3000, attempts: 1)
  encrypted_14.encrypt(encrypted_14_upstream)
  answers("h2-get", encrypted_14)
  queries, edns, unpadded, said = padding(over_h2)
  check queries > 10 && edns == queries && unpadded == 0, "every DoH query over HTTP/2 is padded: #{said}"
  puts "doh_h2: ok"
else
  puts "doh_h2: skipped: #{File.read(dir + "/h2.missing").strip}"
end

# --- Plaintext, unpadded ---

restart_counts(plain)
same "192.0.2.1", show(plain.resolve("a.zone.test")), "a lookup over plaintext UDP"
queries, edns, unpadded, said = padding(plain)
check queries >= 3 && edns == 0, "a plaintext query carries no OPT record, so no padding (RFC 7830 6): #{said}"
puts "plaintext_unpadded: ok"

# The same HTTPS records asked in the clear, of the same zone's UDP server:
# the text `answers` holds every encrypted upstream to.
https_store_3 = SvcbStore.new
same "svc.zone.test after 0 aliases: #{SVC_HTTPS}", show_https(plain.https_records("svc.zone.test", 443, https_store_3)), "plaintext: a ServiceMode HTTPS record, its alpn and ech"
https_store_4 = SvcbStore.new
same "svc.zone.test after 1 aliases: #{SVC_HTTPS}", show_https(plain.https_records("https.zone.test", 443, https_store_4)), "plaintext: an AliasMode HTTPS record followed"
puts "answer udp HTTPS svc.zone.test #{SVC_HTTPS}"
puts "https_plaintext: ok"

# --- Plaintext only when asked ---

dead = DnsOverTls.new("wrong.test", "127.0.0.1", dot_port, config)
txt_10_texts = [] of String
txt_10_bytes = String::Builder.new(1024)
encrypted_15 = Resolver.new(["127.0.0.1:#{udp_port}"], timeout_ms: 3000, attempts: 1)
encrypted_15.encrypt(dead)
strict = error_of((encrypted_15.txt("transport.zone.test", txt_10_texts, txt_10_bytes) || txt_10_texts), "a dead upstream, no fallback asked for")
check strict.unreachable? && strict.server == dead.label, "no plaintext server is asked unless the caller says so: #{strict.message}"
puts "no_plaintext_fallback: ok"

txt_11_texts = [] of String
txt_11_bytes = String::Builder.new(1024)
encrypted_16 = Resolver.new(["127.0.0.1:#{udp_port}"], timeout_ms: 3000, attempts: 1)
encrypted_16.encrypt(dead, plaintext_fallback: true)
same "udp", show_txt((encrypted_16.txt("transport.zone.test", txt_11_texts, txt_11_bytes) || txt_11_texts)), "with plaintext_fallback the plaintext server answers when no upstream can"
txt_12_texts = [] of String
txt_12_bytes = String::Builder.new(1024)
encrypted_17 = Resolver.new(["127.0.0.1:#{udp_port}"], timeout_ms: 3000, attempts: 1)
encrypted_17.encrypt(dot, plaintext_fallback: true)
same "tls", show_txt((encrypted_17.txt("transport.zone.test", txt_12_texts, txt_12_bytes) || txt_12_texts)), "and an upstream that can is still the one asked"
puts "plaintext_fallback: ok"

# --- What a program connects with ---

listener = IyiSocket.listen("127.0.0.1", 0)
port = listener.local_port
[over_tls, over_https].each do |resolver|
  conn = IyiSocket.connect("svc.zone.test", port, resolver)
  raise "ASSERTION FAILED: connect by name over #{resolver.upstreams[0].label}: #{conn.is_a?(SocketError) ? conn.message : "cancelled"}" unless conn.is_a?(IyiSocket)
  check conn.remote_port == port && conn.remote_address == "127.0.0.1", "connected to svc.zone.test's address: #{conn.remote_address}:#{conn.remote_port}"
  conn.close
end
listener.close
puts "connect_by_name: ok"

over_tls.close
over_https.close
puts "all checks passed"
