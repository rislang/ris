struct Reader
  def apply(b : String::Builder)
    b.length
  end
end
struct Resetter
  def apply(b : String::Builder)
    b.clear
  end
end

def exercise
  b = String::Builder.new
  b << "abc"
  v = b.finish
  (Program.args.empty? ? Reader.new : Resetter.new).apply(b)
  puts v
end

tape { exercise }
