# Structural tree nesting is a flat stream; preserve every subtree stop.
tape do
  tree = Tre(Str).new(100_001)
  100_000.times { tree.open(Str.new("branch")) }
  tree.leaf(Str.new("leaf"))
  index = 100_000
  while index > 0
    index -= 1
    tree.close(index)
  end
  copied = tree.copy_to(Program.tape)
  raise "bad tree size" unless copied.size == 100_001
  raise "bad subtree" unless copied.stop(0) == 100_001
  raise "bad tree leaf" unless copied[100_000] == "leaf"
end
puts "PASS: 100000 deep arrays and trees"

# Every union variant and positional/named field must be placed only after
# its child jobs finish, including unequal alignment and zero-sized values.
tape do
  source = {1_u8, {text: Str.new("named"), n: 2_i64},
    Ary(Str | Int32 | Nil){Str.new("union"), 3, nil}, Str::Builder.new(8)}
  source[3].append("builder")
  copied = source.copy_to(Program.tape)
  source[2][0] = Str.new("changed")
  source[3].append("!")
  raise "tuple byte" unless copied[0] == 1_u8
  raise "named field" unless copied[1][:text] == "named"
  raise "named integer" unless copied[1][:n] == 2_i64
  raise "union text" unless copied[2][0] == "union"
  raise "union integer" unless copied[2][1] == 3
  raise "union nil" unless copied[2][2].nil?
  raise "builder" unless copied[3].finish == "builder"
end
puts "PASS: copy work list shapes and sharing"
