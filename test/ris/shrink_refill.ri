def consume_byte(byte : UInt8, ignored : Nil)
  raise "byte" unless byte == 97_u8
end

def refill
  b = String::Builder.new
  b << "abc"
  view = b.finish
  raise "view" unless view == "abc"
  b.clear
  b << "def"
  copied = b.finish.copy_to(Program.tape)
  b.truncate(1)
  b.shift(1)
  raise "copy" unless copied == "def"
  b << "abc"
  consume_byte(b.finish[0], b.clear)
  stale = b.finish
  stale = String.new("independent")
  b.clear
  raise "rebind" unless stale == "independent"
  a = Array(Int32).new
  a << 1
  index = 0
  raise "index" unless a[index] == 1
  indexes = Array(Int32).new
  indexes << 0
  selected = a.values_at(indexes)
  raise "selected" unless selected[0] == 1
  a.pop
  a.clear
  3.times do
    b.clear
    b << "again"
    text = b.finish
    raise "refill" unless text == "again"
  end
  n = 0
  while n < 3
    b.clear
    b << "while"
    text = b.finish
    raise "while refill" unless text == "while"
    2.times do
      a.clear
      a << n
      a.each do |item|
        raise "nested refill" unless item == n
      end
    end
    n += 1
  end
  until n == 6
    b.clear
    b << "until"
    text = b.finish
    raise "until refill" unless text == "until"
    n += 1
  end
  loop do
    b.clear
    b << "loop"
    text = b.finish
    raise "loop refill" unless text == "loop"
    break
  end
end

# Owner fields may shrink once the round's indexed read is finished.
class RefillOwner
  getter vals = Array(Int32).new
end

def refill_owner
  owner = RefillOwner.new
  owner.vals << 1 << 2
  while owner.vals.size > 0
    raise "owner read" unless owner.vals[0] == 1
    owner.vals.clear
  end
  owner.vals << 3
  while owner.vals.size > 0
    owner.vals.pop
  end
  owner.vals << 4
  owner.vals.clear
  owner.vals << 5
  raise "owner refill" unless owner.vals[0] == 5
end

def borrowed_view(values : Array::View(Int32)) : Array::View(Int32)
  values
end

def consume_borrowed_view
  values = [7]
  view = borrowed_view(values)
  raise "returned view" unless view[0] == 7
  values.clear
end

tape do
  refill
  refill_owner
  consume_borrowed_view
end
puts "PASS: shrink refill"
