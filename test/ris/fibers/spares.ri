# Scopes open at once keep their mappings warm: eight fibers each write
# 512 KiB on their tape and park inside the scope, twice. The second round
# reuses the first round's mappings, so it faults in next to none of the
# 1,024 pages it writes; with one spare a thread kept, seven of the eight
# took a fresh mapping and faulted in every page. A scope that wrote 8 MiB
# keeps only its first MiB resident.
module test/ris/fibers/spares
import std/file::{File}
import std/text

# Minor faults so far, the tenth field of `/proc/self/stat` after the name.
def minor_faults : Int64
  stat = String.build(4096) { |writer| File.read("/proc/self/stat", writer) }
  tail = stat.split(')')[-1]
  fields = tail[1, tail.bytesize - 1].split(' ')
  fields[7].to_i64? || raise "invalid proc stat"
end

def hold : Int64
  sum = 0_i64
  tape do
    text = String.build(512 * 1024) do |w|
      n = 0
      while n < 512 * 1024
        w.push((97 + n % 26).to_u8)
        n += 1
      end
    end
    sleep(20)
    sum = text.bytesize.to_i64
  end
  sum
end

def start(g : IyiGroup) : IyiTask(Int64)
  g.spawn { hold }
end

def round : Int64
  total = 0_i64
  group do |g|
    tasks = Array(IyiTask(Int64)).new(8)
    8.times { tasks << start(g) }
    tasks.each do |task|
      got = task.value
      total = total + got if got.is_a?(Int64)
    end
    0
  end
  total
end

def resident_kb : Int64
  text = String.build(4096) { |writer| File.read("/proc/self/status", writer) }
  text.split('\n').each do |line|
    if line.starts_with?("RssAnon:")
      return line.split(' ').reject(&.empty?)[1].to_i64? ||
        raise "invalid proc status"
    end
  end
  0_i64
end

# Each round in its own local_tape: on the program's tape (a nested tape
# shares it) a round's task array would never be released, and the next
# round's array would take a text's spare side reservation.
local_tape { round }
before = minor_faults
total = 0_i64
local_tape { total = round }
faults = minor_faults - before
puts faults < 128 ? "warm: #{total // 1024} KiB written again" : "COLD: #{faults} faults for #{total // 1024} KiB"

before_kb = resident_kb
local_tape do
  big = String.build(8 * 1024 * 1024) do |w|
    n = 0
    while n < 8 * 1024 * 1024
      w.push(1_u8)
      n += 1
    end
  end
  puts big.bytesize
end
grown = resident_kb - before_kb
puts grown < 4096 ? "trimmed" : "KEPT #{grown} KiB"
