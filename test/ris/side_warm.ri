# Two live growing values each reserve before publishing any elements.
# Their reservations and the local tape are reused over 10,000 scopes:
# four mappings including the implicit main tape, with no copying.
10000.times do
  local_tape do
    a = Ary(Int32).new(4)
    b = Ary(Int32).new(4)
    i = 0
    while i < 100
      a << i
      b << i
      i += 1
    end
  end
end
