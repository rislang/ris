# The same through a call: `tag` puts a Tape::String on the tape, and the
# checker follows calls, so a helper does not hide it.
def tag : Tape::String
  Tape::String.build { |w| w.push(97_u8) }
end

Tape.run do
  names = Tape::Array(Tape::String).new
  i = 0
  while i < 3
    names.push(tag)
    i += 1
  end
  puts names.size
end
