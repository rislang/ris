  # tables-end

  # Options the case mappings take; combine them with `|`.
  @[Flags]
  pub enum CaseOptions
    # Map ASCII letters only; everything else stays as it is.
    ASCII

    # Turkic and Azeri rules: `i` upcases to `İ` and `I` downcases to `ı`.
    Turkic

    # Case folding instead of lowercase mapping — the comparison form, which
    # reaches further (`ẞ` and `ß` both fold to `ss`).
    Fold
  end

  # The normalization forms `normalize` writes.
  pub enum NormalizationForm
    # Canonical decomposition.
    NFD

    # Canonical decomposition, then canonical composition.
    NFC

    # Compatibility decomposition.
    NFKD

    # Compatibility decomposition, then canonical composition.
    NFKC
  end

  # ---------------------------------------------------------------------
  # Tables: read in place, searched by rows.
  # ---------------------------------------------------------------------

  private def self.letter_table : RisCodeTable
    RisCodeTable.new(LETTER)
  end

  private def self.number_table : RisCodeTable
    RisCodeTable.new(NUMBER)
  end

  private def self.mark_table : RisCodeTable
    RisCodeTable.new(MARK)
  end

  private def self.whitespace_table : RisCodeTable
    RisCodeTable.new(WHITESPACE)
  end

  private def self.control_table : RisCodeTable
    RisCodeTable.new(CONTROL)
  end

  private def self.lowercase_table : RisCodeTable
    RisCodeTable.new(LOWERCASE)
  end

  private def self.uppercase_table : RisCodeTable
    RisCodeTable.new(UPPERCASE)
  end

  private def self.titlecase_table : RisCodeTable
    RisCodeTable.new(TITLECASE)
  end

  private def self.cased_table : RisCodeTable
    RisCodeTable.new(CASED)
  end

  private def self.case_ignorable_table : RisCodeTable
    RisCodeTable.new(CASE_IGNORABLE)
  end

  private def self.upcase_table : RisCodeTable
    RisCodeTable.new(UPCASE)
  end

  private def self.downcase_table : RisCodeTable
    RisCodeTable.new(DOWNCASE)
  end

  private def self.alternate_table : RisCodeTable
    RisCodeTable.new(ALTERNATE)
  end

  private def self.casefold_table : RisCodeTable
    RisCodeTable.new(CASEFOLD)
  end

  private def self.special_upcase_table : RisCodeTable
    RisCodeTable.new(SPECIAL_UPCASE)
  end

  private def self.special_downcase_table : RisCodeTable
    RisCodeTable.new(SPECIAL_DOWNCASE)
  end

  private def self.special_titlecase_table : RisCodeTable
    RisCodeTable.new(SPECIAL_TITLECASE)
  end

  private def self.special_fold_table : RisCodeTable
    RisCodeTable.new(SPECIAL_FOLD)
  end

  private def self.combining_class_table : RisCodeTable
    RisCodeTable.new(COMBINING_CLASS)
  end

  private def self.canonical_decomposition_table : RisCodeTable
    RisCodeTable.new(CANONICAL_DECOMPOSITION)
  end

  private def self.compatibility_decomposition_table : RisCodeTable
    RisCodeTable.new(COMPATIBILITY_DECOMPOSITION)
  end

  private def self.compatibility_data_table : RisCodeTable
    RisCodeTable.new(COMPATIBILITY_DATA)
  end

  private def self.composition_table : RisCodeTable
    RisCodeTable.new(COMPOSITION)
  end

  private def self.general_category_table : RisCodeTable
    RisCodeTable.new(GENERAL_CATEGORY)
  end

  private def self.script_table : RisCodeTable
    RisCodeTable.new(SCRIPT)
  end

  private def self.simple_fold_table : RisCodeTable
    RisCodeTable.new(SIMPLE_FOLD)
  end

  private def self.grapheme_table : RisCodeTable
    RisCodeTable.new(GRAPHEME)
  end

  # The row of a `{from, to, ...}` table whose range holds *needle*, as the
  # index of its first integer, or -1. Rows are *width* integers wide and
  # sorted by `from`, so the first row whose `to` is not below the needle is
  # the only candidate.
  private def self.search_range(table : RisCodeTable, width : Int32, needle : Int32) : Int32
    data = table
    low = 0
    high = table.size // width
    while low < high
      middle = (low + high) // 2
      if data[middle * width + 1] < needle
        low = middle + 1
      else
        high = middle
      end
    end
    return -1 if low == table.size // width
    at = low * width
    data[at] <= needle ? at : -1
  end

  # The row of a table keyed by its first integer, as the index of that
  # integer, or -1.
  private def self.search_key(table : RisCodeTable, width : Int32, needle : Int32) : Int32
    data = table
    low = 0
    high = table.size // width
    while low < high
      middle = (low + high) // 2
      if data[middle * width] < needle
        low = middle + 1
      else
        high = middle
      end
    end
    return -1 if low == table.size // width
    data[low * width] == needle ? low * width : -1
  end

  # Whether a `{from, to, stride}` table names *cp*: inside a row's range and
  # a whole number of strides from its start.
  private def self.in_category?(table : RisCodeTable, cp : Int32) : Bool
    at = search_range(table, 3, cp)
    return false if at < 0
    data = table
    (cp - data[at]) % data[at + 2] == 0
  end

  # ---------------------------------------------------------------------
  # General categories
  # ---------------------------------------------------------------------

  def self.ascii?(char : Char) : Bool
    char.ord < 0x80
  end

  # Category L: Lu, Ll, Lt, Lm and Lo.
  def self.letter?(char : Char) : Bool
    in_category?(letter_table, char.ord)
  end

  # Category N: Nd, Nl and No — digits in every script, letter numbers, and
  # the fractions and superscripts.
  def self.number?(char : Char) : Bool
    in_category?(number_table, char.ord)
  end

  # Category M: Mn, Mc and Me — the combining marks.
  def self.mark?(char : Char) : Bool
    in_category?(mark_table, char.ord)
  end

  # Category Z: Zs, Zl and Zp — the spaces and the line and paragraph
  # separators. Tab and newline are controls, not whitespace, here.
  def self.whitespace?(char : Char) : Bool
    in_category?(whitespace_table, char.ord)
  end

  # Category C: Cc, Cf, Cs and Co — controls, format characters,
  # surrogates and private use.
  def self.control?(char : Char) : Bool
    in_category?(control_table, char.ord)
  end

  # Category Ll.
  def self.lowercase?(char : Char) : Bool
    in_category?(lowercase_table, char.ord)
  end

  # Category Lu.
  def self.uppercase?(char : Char) : Bool
    in_category?(uppercase_table, char.ord)
  end

  # Category Lt: the digraphs whose first half is capital, `ǅ` and `ᾈ`.
  def self.titlecase?(char : Char) : Bool
    in_category?(titlecase_table, char.ord)
  end

  # The two-letter general category of a character: `"Lu"` for `A`, `"Po"`
  # for `!`, `"Sm"` for `+`; `"Cn"` for a code point no character is
  # assigned to.
  def self.general_category(char : Char) : String
    table = general_category_table
    at = search_range(table, 3, char.ord)
    at < 0 ? "Cn" : category_name(table[at + 2])
  end

  # The script a character is written in, as `Scripts.txt` names it:
  # `"Latin"`, `"Greek"`, `"Han"`, and `"Common"` for the digits and
  # punctuation every script shares; `"Unknown"` for a code point the file
  # does not list.
  def self.script(char : Char) : String
    table = script_table
    at = search_range(table, 3, char.ord)
    at < 0 ? "Unknown" : script_name(table[at + 2])
  end

  # The code points a property names, as sorted `{from, to}` pairs that
  # neither overlap nor touch: a general category (`"Lu"`), a major class
  # by its letter (`"L"` is Lu, Ll, Lt, Lm and Lo; `"C"` is Cc, Cf, Cs and
  # Co, unassigned code points being in no category), or a script
  # (`"Greek"`). Nil for a name that is none of those. A class is built
  # from the ranges once rather than asking per character, which is what a
  # regex's `\p{..}` needs: ranges it can negate and case-fold.
  def self.property_ranges(name : String) : Array(Int32)?
    wanted = [] of Int32
    if name.bytesize == 1 || name.bytesize == 2
      i = 0
      while i < CATEGORY_COUNT
        category = category_name(i)
        wanted << i if category == name || (name.bytesize == 1 && category.starts_with?(name))
        i = i + 1
      end
    end
    table = general_category_table
    if wanted.empty?
      i = 0
      while i < SCRIPT_COUNT
        wanted << i if script_name(i) == name
        i = i + 1
      end
      table = script_table
    end
    return nil if wanted.empty?
    ranges = [] of Int32
    data = table
    row = 0
    while row < table.size
      if wanted.includes?(data[row + 2])
        if ranges.size > 0 && ranges[ranges.size - 1] + 1 == data[row]
          ranges[ranges.size - 1] = data[row + 1]
        else
          ranges << data[row]
          ranges << data[row + 1]
        end
      end
      row = row + 3
    end
    ranges
  end

  # ---------------------------------------------------------------------
  # Case mapping
  # ---------------------------------------------------------------------

  private def self.simple_upcase(cp : Int32) : Int32
    # The titlecase digraphs `ǅ`, `ǈ`, `ǋ` and `ǲ` (category Lt) sit between
    # their capital and small forms and have no row in the table; their
    # uppercase is the capital one before them.
    return cp - 1 if cp == 0x1C5 || cp == 0x1C8 || cp == 0x1CB || cp == 0x1F2
    table = upcase_table
    at = search_range(table, 3, cp)
    return cp + table[at + 2] if at >= 0
    alternate = alternate_table
    at = search_range(alternate, 2, cp)
    return cp - 1 if at >= 0 && (cp - alternate[at]).odd?
    cp
  end

  private def self.simple_downcase(cp : Int32) : Int32
    table = downcase_table
    at = search_range(table, 3, cp)
    return cp + table[at + 2] if at >= 0
    alternate = alternate_table
    at = search_range(alternate, 2, cp)
    return cp + 1 if at >= 0 && (cp - alternate[at]).even?
    cp
  end

  private def self.ascii_upcase?(cp : Int32, options : CaseOptions) : Bool
    (cp < 0x80 && options.none?) || options.ascii?
  end

  private def self.ascii_upcase(cp : Int32) : Int32
    cp >= 97 && cp <= 122 ? cp - 32 : cp
  end

  private def self.ascii_downcase(cp : Int32) : Int32
    cp >= 65 && cp <= 90 ? cp + 32 : cp
  end

  # The Turkic answer for the four letters that have one, or -1.
  private def self.turkic_upcase(cp : Int32) : Int32
    return 0x49 if cp == 0x131 # ı -> I
    return 0x130 if cp == 0x69 # i -> İ
    -1
  end

  private def self.turkic_downcase(cp : Int32) : Int32
    return 0x131 if cp == 0x49 # I -> ı
    return 0x69 if cp == 0x130 # İ -> i
    -1
  end

  # Yields the up to three code points of a `{code point, first, second,
  # third}` row, stopping at the first zero; answers whether there was a row.
  private def self.yield_special(table : RisCodeTable, cp : Int32, & : Int32 -> Nil) : Bool
    at = search_key(table, 4, cp)
    return false if at < 0
    data = table
    yield data[at + 1]
    yield data[at + 2] unless data[at + 2] == 0
    yield data[at + 3] unless data[at + 3] == 0
    true
  end

  # The uppercase of one character: the simple mapping, so `ß` stays `ß`
  # (its full mapping is two letters; the block form gives it).
  def self.upcase(char : Char, options : CaseOptions = CaseOptions::None) : Char
    cp = char.ord
    return ascii_upcase(cp).unsafe_chr if ascii_upcase?(cp, options)
    if options.turkic?
      turkic = turkic_upcase(cp)
      return turkic.unsafe_chr if turkic >= 0
    end
    simple_upcase(cp).unsafe_chr
  end

  # The full uppercase mapping, one character at a time: `ß` yields `S` twice,
  # `ŉ` yields `ʼ` and `N`.
  def self.upcase(char : Char, options : CaseOptions = CaseOptions::None, & : Char -> Nil) : Nil
    cp = char.ord
    if ascii_upcase?(cp, options)
      yield ascii_upcase(cp).unsafe_chr
      return
    end
    if options.turkic?
      turkic = turkic_upcase(cp)
      if turkic >= 0
        yield turkic.unsafe_chr
        return
      end
    end
    return if yield_special(special_upcase_table, cp) { |part| yield part.unsafe_chr }
    yield simple_upcase(cp).unsafe_chr
  end

  # The lowercase of one character, the simple mapping: `İ` becomes `i`
  # under Turkic rules and stays `İ` otherwise, because its full mapping is
  # `i` plus a combining dot.
  def self.downcase(char : Char, options : CaseOptions = CaseOptions::None) : Char
    return foldcase(char) if options.fold?
    cp = char.ord
    return ascii_downcase(cp).unsafe_chr if ascii_upcase?(cp, options)
    if options.turkic?
      turkic = turkic_downcase(cp)
      return turkic.unsafe_chr if turkic >= 0
    end
    simple_downcase(cp).unsafe_chr
  end

  # The full lowercase mapping, one character at a time.
  def self.downcase(char : Char, options : CaseOptions = CaseOptions::None, & : Char -> Nil) : Nil
    if options.fold?
      foldcase(char) { |part| yield part }
      return
    end
    cp = char.ord
    if ascii_upcase?(cp, options)
      yield ascii_downcase(cp).unsafe_chr
      return
    end
    if options.turkic?
      turkic = turkic_downcase(cp)
      if turkic >= 0
        yield turkic.unsafe_chr
        return
      end
    end
    return if yield_special(special_downcase_table, cp) { |part| yield part.unsafe_chr }
    yield simple_downcase(cp).unsafe_chr
  end

  # The titlecase of one character, the simple mapping: the uppercase, except
  # for the digraphs, where `ǆ` and `Ǆ` both become `ǅ`.
  def self.titlecase(char : Char, options : CaseOptions = CaseOptions::None) : Char
    cp = char.ord
    return ascii_upcase(cp).unsafe_chr if ascii_upcase?(cp, options)
    if options.turkic?
      turkic = turkic_upcase(cp)
      return turkic.unsafe_chr if turkic >= 0
    end
    table = special_titlecase_table
    at = search_key(table, 4, cp)
    if at >= 0 && table[at + 2] == 0
      return table[at + 1].unsafe_chr
    end
    simple_upcase(cp).unsafe_chr
  end

  # The full titlecase mapping, one character at a time: `ß` yields `S`, `s`.
  def self.titlecase(char : Char, options : CaseOptions = CaseOptions::None, & : Char -> Nil) : Nil
    cp = char.ord
    if ascii_upcase?(cp, options)
      yield ascii_upcase(cp).unsafe_chr
      return
    end
    if options.turkic?
      turkic = turkic_upcase(cp)
      if turkic >= 0
        yield turkic.unsafe_chr
        return
      end
    end
    return if yield_special(special_titlecase_table, cp) { |part| yield part.unsafe_chr }
    return if yield_special(special_upcase_table, cp) { |part| yield part.unsafe_chr }
    yield simple_upcase(cp).unsafe_chr
  end

  # The case folding of one character where it is one code point (`Σ`, `σ`
  # and `ς` all fold to `σ`); a character whose folding is longer, like `ß`,
  # is answered unchanged — the block form and the string form fold it.
  def self.foldcase(char : Char) : Char
    cp = char.ord
    table = casefold_table
    at = search_range(table, 3, cp)
    return (cp + table[at + 2]).unsafe_chr if at >= 0
    special = special_fold_table
    at = search_key(special, 4, cp)
    return special[at + 1].unsafe_chr if at >= 0 && special[at + 2] == 0
    char
  end

  # The full case folding, one character at a time: `ß` yields `s` twice.
  def self.foldcase(char : Char, & : Char -> Nil) : Nil
    cp = char.ord
    table = casefold_table
    at = search_range(table, 3, cp)
    if at >= 0
      yield (cp + table[at + 2]).unsafe_chr
      return
    end
    return if yield_special(special_fold_table, cp) { |part| yield part.unsafe_chr }
    yield char
  end

  # Every character whose simple case folding is this one's, itself among
  # them, in code point order: `k` answers `K`, `k` and the Kelvin sign
  # U+212A, `σ` answers `Σ`, `ς` and `σ`, and `ß` answers `ß` and `ẞ`. A
  # character without case answers itself alone. It is what a
  # case-insensitive comparison of one character has to accept, and folding
  # both sides is not enough to build it: a class holding the Kelvin sign
  # has to take `K` as well, and only the folding read backwards says so.
  #
  # The simple folding here is CaseFolding.txt's C and S rows, which is
  # RE2's. `foldcase` answers the other library's, which has no S rows:
  # there `ẞ` folds to itself.
  def self.case_orbit(char : Char) : Array(Char)
    chars = [] of Char
    table = orbit_table
    at = search_key(table, 3, simple_fold(char.ord))
    if at >= 0
      members = orbit_members_table
      index = table[at + 1]
      stop = index + table[at + 2]
      while index < stop
        chars << members[index].unsafe_chr
        index = index + 1
      end
    else
      chars << char
    end
    chars
  end

  # Every orbit `case_orbit` answers that holds more than one character,
  # each once, as code points in order and in no particular order between
  # them. A case-insensitive class folds itself against these, about 1,400
  # of them, rather than asking `case_orbit` of each of the hundred
  # thousand code points a class like `\p{L}` holds.
  def self.each_case_orbit(& : Array(Int32) -> Nil) : Nil
    table = orbit_table
    data = orbit_members_table
    row = 0
    while row < table.size
      members = Array(Int32).new(table[row + 2])
      index = table[row + 1]
      stop = index + table[row + 2]
      while index < stop
        members << data[index]
        index = index + 1
      end
      yield members
      row = row + 3
    end
  end

  private def self.simple_fold(cp : Int32) : Int32
    table = simple_fold_table
    at = search_key(table, 2, cp)
    at >= 0 ? table[at + 1] : foldcase(cp.unsafe_chr).ord
  end

  private def self.orbit_table : RisCodeTable
    RisCodeTable.new(ORBIT)
  end

  private def self.orbit_members_table : RisCodeTable
    RisCodeTable.new(ORBIT_MEMBERS)
  end

  # The string in uppercase, full mappings: `"straße"` is `"STRASSE"`.
  # An ASCII-only string is the prelude's `upcase`, unless the Turkic rule
  # is on, which is a question about `i` itself.
  def self.upcase(text : String, options : CaseOptions = CaseOptions::None) : String
    check_utf8(text)
    return text.upcase if !options.turkic? && ascii_only?(text)
    points = Array(Int32).new(text.size)
    text.each_char do |char|
      upcase(char, options) { |part| points << part.ord }
    end
    from_codepoints(points)
  end

  # The string in lowercase, full mappings, with the final sigma: a capital
  # sigma that ends a word — a cased letter before it, none after, the
  # case-ignorable characters (combining marks, format characters, modifier
  # letters and the apostrophes, periods and colons that can sit inside a
  # word) looked through — becomes `ς`, so `"ΟΔΥΣΣΕΥΣ"` is `"οδυσσευς"`.
  # With `CaseOptions::Fold` this is `foldcase`.
  def self.downcase(text : String, options : CaseOptions = CaseOptions::None) : String
    check_utf8(text)
    return foldcase(text) if options.fold?
    return text.downcase if !options.turkic? && ascii_only?(text)
    source = codepoints(text)
    points = Array(Int32).new(source.size)
    downcase_from(points, source, 0, options)
    from_codepoints(points)
  end

  # Appends the lowercase of `source[from..]`, the final sigma judged by the
  # whole of *source*: the letters before *from* are still before it.
  private def self.downcase_from(points : Array(Int32), source : Array(Int32), from : Int32, options : CaseOptions) : Nil
    index = from
    while index < source.size
      cp = source[index]
      # The Turkic `I` with a combining dot above is the dotted `i`, the
      # dot taken in (SpecialCasing's After_I and Not_Before_Dot): one
      # character at a time it was `ı` and the dot left over it. Marks of
      # a class other than 0 and 230 may sit between the two (Before_Dot),
      # so the NFD of `İ` with a dot below, `I`, U+0323, U+0307, is `i` and
      # U+0323 like its NFC form; looking only at the next code point it
      # was `ı`, U+0323, U+0307.
      if cp == 0x49 && options.turkic?
        dot = dot_above_after(source, index)
        if dot >= 0
          points << 0x69
          index = index + 1
          while index < dot
            downcase(source[index].unsafe_chr, options) { |part| points << part.ord }
            index = index + 1
          end
          index = dot + 1
          next
        end
      end
      if cp == 0x3A3 && !options.ascii? && !options.fold? && final_sigma?(source, index)
        points << 0x3C2
      else
        downcase(cp.unsafe_chr, options) { |part| points << part.ord }
      end
      index = index + 1
    end
  end

  # The index of the U+0307 a Turkic `I` at *index* takes in, or -1: the
  # first code point after it whose combining class is 0 or 230, when that
  # is the dot above (SpecialCasing's Before_Dot and After_I).
  private def self.dot_above_after(source : Array(Int32), index : Int32) : Int32
    after = index + 1
    while after < source.size
      cp = source[after]
      return after if cp == 0x307
      ccc = combining_class(cp)
      return -1 if ccc == 0 || ccc == 230
      after = after + 1
    end
    -1
  end

  # The first character in titlecase and the rest in lowercase: `"ǆemal"` is
  # `"ǅemal"`, `"STRASSE"` is `"Strasse"`. The first character is still a
  # letter before the rest, so `"ΑΣ"` is `"Ας"`.
  def self.capitalize(text : String, options : CaseOptions = CaseOptions::None) : String
    check_utf8(text)
    return text if text.empty?
    source = codepoints(text)
    points = Array(Int32).new(source.size)
    titlecase(source[0].unsafe_chr, options) { |part| points << part.ord }
    downcase_from(points, source, 1, options)
    from_codepoints(points)
  end

  # The string folded for comparison: `"Straße"` and `"STRASSE"` both fold
  # to `"strasse"`.
  def self.foldcase(text : String) : String
    check_utf8(text)
    return text.downcase if ascii_only?(text)
    points = Array(Int32).new(text.size)
    text.each_char do |char|
      foldcase(char) { |part| points << part.ord }
    end
    from_codepoints(points)
  end

  # Whether the sigma at *index* ends a word: a cased letter somewhere before
  # it and none after it, case-ignorable code points skipped on both sides.
  private def self.final_sigma?(points : Array(Int32), index : Int32) : Bool
    before = index - 1
    while before >= 0 && case_ignorable?(points[before])
      before = before - 1
    end
    return false if before < 0 || !cased?(points[before])
    after = index + 1
    while after < points.size && case_ignorable?(points[after])
      after = after + 1
    end
    after == points.size || !cased?(points[after])
  end

  # Cased and Case_Ignorable are the Unicode properties (D135 and D136), not
  # general categories: `ª`, `ʰ`, `Ⅻ` and `Ⓐ` are cased though not Ll, Lu
  # or Lt, and a spacing mark (Mc) is not case-ignorable while a format
  # character (Cf), a modifier letter (Lm) and a modifier symbol (Sk) are.
  # Answered from the categories and a list of punctuation, `"ΑΣ\u200BΑ"`
  # lowered to a final `ς` and `"\u216BΣ"` to `σ`.
  private def self.cased?(cp : Int32) : Bool
    in_category?(cased_table, cp)
  end

  private def self.case_ignorable?(cp : Int32) : Bool
    in_category?(case_ignorable_table, cp)
  end

  # ---------------------------------------------------------------------
  # UTF-8
  # ---------------------------------------------------------------------

  # The length of the well-formed sequence that starts at *at*, or, negated,
  # the length of the maximal ill-formed subpart there — the bytes that could
  # still have begun a well-formed sequence, at least the one byte. That is
  # the unit U+FFFD replaces, which is what the standard recommends.
  private def self.sequence_at(bytes : String | Array(UInt8), size : Int32, at : Int32) : Int32
    lead = bytes[at]
    return 1 if lead < 0x80_u8
    need = 0
    low = 0x80_u8
    high = 0xBF_u8
    if lead >= 0xC2_u8 && lead <= 0xDF_u8
      need = 1
    elsif lead == 0xE0_u8
      need = 2
      low = 0xA0_u8
    elsif lead == 0xED_u8
      need = 2
      high = 0x9F_u8
    elsif lead >= 0xE1_u8 && lead <= 0xEF_u8
      need = 2
    elsif lead == 0xF0_u8
      need = 3
      low = 0x90_u8
    elsif lead == 0xF4_u8
      need = 3
      high = 0x8F_u8
    elsif lead >= 0xF1_u8 && lead <= 0xF3_u8
      need = 3
    else
      return -1
    end
    taken = 1
    while taken <= need
      return 0 - taken if at + taken >= size
      byte = bytes[at + taken]
      return 0 - taken if byte < low || byte > high
      low = 0x80_u8
      high = 0xBF_u8
      taken = taken + 1
    end
    taken
  end

  private def self.valid_bytes?(bytes : String | Array(UInt8), size : Int32) : Bool
    at = 0
    while at < size
      length = sequence_at(bytes, size, at)
      return false if length < 0
      at = at + length
    end
    true
  end

  # Whether the string's bytes are well-formed UTF-8.
  def self.valid?(text : String) : Bool
    valid_bytes?(text, text.bytesize)
  end

  # Whether the bytes are well-formed UTF-8.
  def self.valid?(bytes : Array(UInt8)) : Bool
    valid_bytes?(bytes, bytes.size)
  end

  private def self.clean_bytes(bytes : String | Array(UInt8), size : Int32) : String
    total = 0
    at = 0
    while at < size
      length = sequence_at(bytes, size, at)
      if length < 0
        total = total + 3
        at = at - length
      else
        total = total + length
        at = at + length
      end
    end
    String.build(total) do |buffer|
      at = 0
      while at < size
        length = sequence_at(bytes, size, at)
        if length < 0
          buffer << '\u{FFFD}'
          at -= length
        else
          length.times { |i| buffer.push(bytes[at + i]) }
          at += length
        end
      end
    end
  end

  # The string with every maximal ill-formed subpart replaced by U+FFFD; a
  # well-formed string is answered as it is.
  def self.clean(text : String) : String
    return text if valid?(text)
    clean_bytes(text, text.bytesize)
  end

  # The bytes as a string, every maximal ill-formed subpart replaced by U+FFFD.
  def self.clean(bytes : Array(UInt8)) : String
    clean_bytes(bytes, bytes.size)
  end

  private def self.check_utf8(text : String) : Nil
    bytes = text
    size = text.bytesize
    at = 0
    while at < size
      length = sequence_at(bytes, size, at)
      raise "invalid UTF-8 at byte #{at}" if length < 0
      at = at + length
    end
  end

  private def self.ascii_only?(text : String) : Bool
    bytes = text
    at = 0
    while at < text.bytesize
      return false if bytes[at] >= 0x80_u8
      at = at + 1
    end
    true
  end

  private def self.utf8_width(cp : Int32) : Int32
    return 1 if cp < 0x80
    return 2 if cp < 0x800
    return 3 if cp < 0x10000
    4
  end

  private def self.codepoints(text : String) : Array(Int32)
    points = Array(Int32).new(text.size)
    text.each_char { |char| points << char.ord }
    points
  end

  # A string from code points, each in one to four bytes.
  private def self.from_codepoints(points : Array(Int32)) : String
    total = 0
    points.each { |cp| total = total + utf8_width(cp) }
    buffer = ""
    points.each { |cp| buffer << cp.unsafe_chr }
    buffer
  end

  # ---------------------------------------------------------------------
  # UTF-16
  # ---------------------------------------------------------------------

  # The string's UTF-16 code units: one per character up to U+FFFF, a
  # surrogate pair above.
  def self.encode_utf16(text : String) : Array(UInt16)
    check_utf8(text)
    units = Array(UInt16).new(text.size)
    text.each_char do |char|
      cp = char.ord
      if cp < 0x10000
        units << cp.to_u16
      else
        cp = cp - 0x10000
        units << (0xD800 + (cp >> 10)).to_u16
        units << (0xDC00 + (cp & 0x3FF)).to_u16
      end
    end
    units
  end

  # The string the UTF-16 code units spell, or nil at an unpaired surrogate.
  def self.decode_utf16?(units : Array(UInt16)) : String?
    at = unpaired_surrogate(units)
    return nil if at >= 0
    decode_units(units)
  end

  # The string the UTF-16 code units spell. An unpaired surrogate is refused
  # with its index: `unpaired surrogate 0xD800 at index 3`.
  def self.decode_utf16(units : Array(UInt16)) : String
    at = unpaired_surrogate(units)
    raise "unpaired surrogate 0x#{units[at].to_i32.to_s(16).upcase} at index #{at}" if at >= 0
    decode_units(units)
  end

  # The index of the first surrogate without its partner, or -1.
  private def self.unpaired_surrogate(units : Array(UInt16)) : Int32
    index = 0
    while index < units.size
      unit = units[index].to_i32
      if unit >= 0xD800 && unit <= 0xDBFF
        return index if index + 1 >= units.size
        low = units[index + 1].to_i32
        return index if low < 0xDC00 || low > 0xDFFF
        index = index + 2
      elsif unit >= 0xDC00 && unit <= 0xDFFF
        return index
      else
        index = index + 1
      end
    end
    -1
  end

  private def self.decode_units(units : Array(UInt16)) : String
    points = Array(Int32).new(units.size)
    index = 0
    while index < units.size
      unit = units[index].to_i32
      if unit >= 0xD800 && unit <= 0xDBFF
        low = units[index + 1].to_i32
        points << 0x10000 + ((unit - 0xD800) << 10) + (low - 0xDC00)
        index = index + 2
      else
        points << unit
        index = index + 1
      end
    end
    from_codepoints(points)
  end

  # ---------------------------------------------------------------------
  # Normalization
  # ---------------------------------------------------------------------

  # Hangul syllables decompose and compose by arithmetic (the Unicode
  # Standard, chapter 3.12): a syllable is a leading consonant, a vowel and
  # an optional trailing consonant.
  HANGUL_S_BASE  = 0xAC00
  HANGUL_L_BASE  = 0x1100
  HANGUL_V_BASE  = 0x1161
  HANGUL_T_BASE  = 0x11A7
  HANGUL_L_COUNT =     19
  HANGUL_V_COUNT =     21
  HANGUL_T_COUNT =     28
  HANGUL_N_COUNT =    588 # V_COUNT * T_COUNT
  HANGUL_S_COUNT =  11172 # L_COUNT * N_COUNT

  # The string in the given normalization form, NFC when none is named.
  def self.normalize(text : String, form : NormalizationForm = NormalizationForm::NFC) : String
    check_utf8(text)
    return text if ascii_only?(text)
    points = Array(Int32).new(text.size)
    compatibility = form.nfkd? || form.nfkc?
    text.each_char { |char| decompose(points, char.ord, compatibility) }
    canonical_order(points)
    if form.nfc? || form.nfkc?
      compose(points)
    end
    from_codepoints(points)
  end

  # Whether the string is already in the given form.
  def self.normalized?(text : String, form : NormalizationForm = NormalizationForm::NFC) : Bool
    normalize(text, form) == text
  end

  private def self.combining_class(cp : Int32) : Int32
    table = combining_class_table
    at = search_range(table, 3, cp)
    at < 0 ? 0 : table[at + 2]
  end

  # Appends the full decomposition of *cp*: Hangul by arithmetic, then the
  # canonical mapping, then — under a compatibility form — the compatibility
  # mapping, each part decomposed again.
  private def self.decompose(points : Array(Int32), cp : Int32,
                             compatibility : Bool) : Nil
    decompose_into(points, cp, compatibility, canonical_decomposition_table,
      compatibility_decomposition_table, compatibility_data_table)
  end

  private def self.decompose_into(points : Array(Int32), cp : Int32,
                                  compatibility : Bool,
                                  canonical : RisCodeTable,
                                  compat : RisCodeTable,
                                  data : RisCodeTable) : Nil
    if cp >= HANGUL_S_BASE && cp < HANGUL_S_BASE + HANGUL_S_COUNT
      s_index = cp - HANGUL_S_BASE
      points << HANGUL_L_BASE + s_index // HANGUL_N_COUNT
      points << HANGUL_V_BASE + (s_index % HANGUL_N_COUNT) // HANGUL_T_COUNT
      trailing = HANGUL_T_BASE + s_index % HANGUL_T_COUNT
      points << trailing unless trailing == HANGUL_T_BASE
      return
    end
    at = search_key(canonical, 3, cp)
    if at >= 0
      decompose_into(points, canonical[at + 1], compatibility,
        canonical, compat, data)
      second = canonical[at + 2]
      decompose_into(points, second, compatibility,
        canonical, compat, data) unless second == 0
      return
    end
    if compatibility
      at = search_key(compat, 3, cp)
      if at >= 0
        offset = compat[at + 1]
        count = compat[at + 2]
        index = 0
        while index < count
          decompose_into(points, data[offset + index], compatibility,
            canonical, compat, data)
          index = index + 1
        end
        return
      end
    end
    points << cp
  end

  # Sorts every run of code points with a non-zero combining class by that
  # class, stably: the canonical ordering algorithm.
  private def self.canonical_order(points : Array(Int32)) : Nil
    size = points.size
    start = 0
    while start < size
      if combining_class(points[start]) == 0
        start = start + 1
        next
      end
      stop = start + 1
      while stop < size && combining_class(points[stop]) != 0
        stop = stop + 1
      end
      # Insertion sort over the run: runs are short, and it keeps order
      # between equal classes.
      index = start + 1
      while index < stop
        cp = points[index]
        ccc = combining_class(cp)
        place = index
        while place > start && combining_class(points[place - 1]) > ccc
          points[place] = points[place - 1]
          place = place - 1
        end
        points[place] = cp
        index = index + 1
      end
      start = stop + 1
    end
  end

  # The primary composite of *first* and *second*, or -1: Hangul by
  # arithmetic, everything else from the table.
  private def self.composite(first : Int32, second : Int32) : Int32
    if first >= HANGUL_L_BASE && first < HANGUL_L_BASE + HANGUL_L_COUNT &&
       second >= HANGUL_V_BASE && second < HANGUL_V_BASE + HANGUL_V_COUNT
      return HANGUL_S_BASE + (first - HANGUL_L_BASE) * HANGUL_N_COUNT + (second - HANGUL_V_BASE) * HANGUL_T_COUNT
    end
    s_index = first - HANGUL_S_BASE
    if s_index >= 0 && s_index < HANGUL_S_COUNT && s_index % HANGUL_T_COUNT == 0 &&
       second > HANGUL_T_BASE && second < HANGUL_T_BASE + HANGUL_T_COUNT
      return first + (second - HANGUL_T_BASE)
    end
    table = composition_table
    data = table
    low = 0
    high = table.size // 3
    while low < high
      middle = (low + high) // 2
      at = middle * 3
      if data[at] < first || (data[at] == first && data[at + 1] < second)
        low = middle + 1
      else
        high = middle
      end
    end
    return -1 if low == table.size // 3
    at = low * 3
    data[at] == first && data[at + 1] == second ? data[at + 2] : -1
  end

  # The canonical composition algorithm over decomposed, ordered code points:
  # each starter takes every following character that composes with it and
  # is not blocked by a mark of the same or higher class in between.
  private def self.compose(points : Array(Int32)) : Nil
    size = points.size
    return if size == 0
    written = 0
    starter_at = -1
    last_ccc = 0
    index = 0
    while index < size
      cp = points[index]
      ccc = combining_class(cp)
      if starter_at >= 0
        blocked = written - 1 > starter_at && (last_ccc == 0 || last_ccc >= ccc)
        unless blocked
          composed = composite(points[starter_at], cp)
          if composed >= 0
            points[starter_at] = composed
            index = index + 1
            next
          end
        end
      end
      starter_at = written if ccc == 0
      last_ccc = ccc
      points[written] = cp
      written = written + 1
      index = index + 1
    end
    while points.size > written
      points.pop
    end
  end

  # ---------------------------------------------------------------------
  # Grapheme clusters
  # ---------------------------------------------------------------------

  # A GRAPHEME value's Grapheme_Cluster_Break, its low four bits, as the
  # generator counts them; 0 is Other.
  GCB_PREPEND  =  1
  GCB_CR       =  2
  GCB_LF       =  3
  GCB_CONTROL  =  4
  GCB_EXTEND   =  5
  GCB_RI       =  6
  GCB_SPACING  =  7
  GCB_L        =  8
  GCB_V        =  9
  GCB_T        = 10
  GCB_LV       = 11
  GCB_LVT      = 12
  GCB_ZWJ      = 13
  PICTOGRAPHIC = 16
  # Indic_Conjunct_Break, the value shifted right five.
  INCB_CONSONANT = 1
  INCB_EXTEND    = 2
  INCB_LINKER    = 3

  # The string's extended grapheme clusters, as UAX #29 divides them: what
  # a reader sees as one character - `e` and a combining acute, a flag's
  # two regional indicators, a family emoji joined by ZWJs, a Devanagari
  # conjunct - is one string. A piece of ill-formed UTF-8 is a cluster of
  # its own, as the U+FFFD that stands for it would be.
  def self.graphemes(text : String) : Array(String)
    found = [] of String
    each_grapheme(text) { |cluster| found << cluster }
    found
  end

  # How many grapheme clusters the string has: what a reader counts.
  def self.grapheme_size(text : String) : Int32
    count = 0
    each_grapheme(text) { |cluster| count = count + 1 }
    count
  end

  # Each grapheme cluster, in order.
  def self.each_grapheme(text : String, & : String -> _) : Nil
    bytes = text
    size = text.bytesize
    return if size == 0
    start = 0
    at = 0
    previous = 0
    # Regional indicators in a row before here, whose parity pairs them;
    # whether here ends Extended_Pictographic Extend* (GB11), and whether
    # the ZWJ before here followed one; whether here is in a conjunct's
    # tail after its consonant (GB9c), and whether that tail has a linker.
    indicators = 0
    pictographic = false
    joined = false
    conjunct = false
    linked = false
    while at < size
      length = sequence_at(bytes, size, at)
      width = length < 0 ? 0 - length : length
      value = length < 0 ? 0 : grapheme_value(code_point_at(bytes, at, length))
      if at > 0 && grapheme_break?(previous, value, indicators, joined, conjunct && linked)
        yield text[start, at - start]
        start = at
      end
      kind = value & 15
      indicators = kind == GCB_RI ? indicators + 1 : 0
      joined = kind == GCB_ZWJ && pictographic
      pictographic = value & PICTOGRAPHIC != 0 || (pictographic && kind == GCB_EXTEND)
      conjoining = value >> 5
      if conjoining == INCB_CONSONANT
        conjunct = true
        linked = false
      elsif conjunct && (conjoining == INCB_EXTEND || conjoining == INCB_LINKER)
        linked = linked || conjoining == INCB_LINKER
      else
        conjunct = false
        linked = false
      end
      previous = value
      at = at + width
    end
    yield text[start, size - start]
  end

  # UAX #29's rules between a code point and the next, in its order: true
  # is a boundary.
  private def self.grapheme_break?(before : Int32, after : Int32, indicators : Int32, joined : Bool, linked : Bool) : Bool
    left = before & 15
    right = after & 15
    return false if left == GCB_CR && right == GCB_LF                                                          # GB3
    return true if left == GCB_CONTROL || left == GCB_CR || left == GCB_LF                                     # GB4
    return true if right == GCB_CONTROL || right == GCB_CR || right == GCB_LF                                  # GB5
    return false if left == GCB_L && (right == GCB_L || right == GCB_V || right == GCB_LV || right == GCB_LVT) # GB6
    return false if (left == GCB_LV || left == GCB_V) && (right == GCB_V || right == GCB_T)                    # GB7
    return false if (left == GCB_LVT || left == GCB_T) && right == GCB_T                                       # GB8
    return false if right == GCB_EXTEND || right == GCB_ZWJ                                                    # GB9
    return false if right == GCB_SPACING                                                                       # GB9a
    return false if left == GCB_PREPEND                                                                        # GB9b
    return false if linked && after >> 5 == INCB_CONSONANT                                                     # GB9c
    return false if joined && after & PICTOGRAPHIC != 0                                                        # GB11
    return false if left == GCB_RI && right == GCB_RI && indicators % 2 == 1                                   # GB12, GB13
    true                                                                                                       # GB999
  end

  private def self.grapheme_value(cp : Int32) : Int32
    return 0 if cp >= 0x20 && cp < 0x7F
    table = grapheme_table
    at = search_range(table, 3, cp)
    at < 0 ? 0 : table[at + 2]
  end

  # The code point a well-formed sequence of *length* bytes at *at* spells.
  private def self.code_point_at(bytes : String | Array(UInt8), at : Int32, length : Int32) : Int32
    lead = bytes[at].to_i32
    return lead if length == 1
    cp = length == 2 ? lead & 0x1F : (length == 3 ? lead & 0x0F : lead & 0x07)
    index = 1
    while index < length
      cp = (cp << 6) | (bytes[at + index].to_i32 & 0x3F)
      index = index + 1
    end
    cp
  end
end

# The other library's names for the same questions, on the string.
struct ::String
  def graphemes : Array(String)
    Std::Unicode::Unicode.graphemes(self)
  end

  def grapheme_size : Int32
    Std::Unicode::Unicode.grapheme_size(self)
  end

  def each_grapheme(& : String -> _) : Nil
    Std::Unicode::Unicode.each_grapheme(self) { |cluster| yield cluster }
  end
end

# A table's integers, read in place from its string: four characters each,
# six bits apiece from `0` up, biased by 2^23 (scripts/generate_unicode_std.py).
@[OnTape]
struct RisCodeTable
  def initialize(@text : String)
  end

  def size : Int32
    @text.bytesize >> 2
  end

  @[AlwaysInline]
  def [](index : Int32) : Int32
    at = index << 2
    ((@text.byte_at(at).to_i32 &- 48) << 18) &+
      ((@text.byte_at(at &+ 1).to_i32 &- 48) << 12) &+
      ((@text.byte_at(at &+ 2).to_i32 &- 48) << 6) &+
      (@text.byte_at(at &+ 3).to_i32 &- 48) &- 0x800000
  end
end
