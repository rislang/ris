# Tape-fiber: fibers each in their own Tape.scope, each building a Tape::Array
# and sleeping between elements so the others run on the same thread. Fiber A
# ends a short scope while B is in the middle of a long one, then opens
# another and writes different bytes. With one tape per thread, A's scope end
# frees the tape B is still using and A's next scope writes over B's values;
# with the tape swapped on every fiber switch, every fiber reads back exactly
# what it wrote.

module test/ris/fibers/interleave

def fill(tag : UInt8, rounds : Int32) : Int32
  wrong = 0
  Tape.scope do
    items = Tape::Array(Tape::String).new(rounds) do
      text = Tape::String.build { |s| s.push(tag); s.push(tag) }
      sleep(1)
      text
    end
    items.each do |text|
      wrong += 1 unless text.bytesize == 2 && text[0] == tag && text[1] == tag
    end
  end
  wrong
end

wrong_a = 0
wrong_b = 0
group do |g|
  g.spawn { wrong_a = fill(65_u8, 10) + fill(67_u8, 40) }
  g.spawn { wrong_b = fill(66_u8, 50) }
end
puts "fiber A wrong: #{wrong_a}"
puts "fiber B wrong: #{wrong_b}"
