# JSON, read and written in iyi: a byte lexer and a recursive parser into
# `Any`, a streaming `PullParser`, a `Builder` that writes a document one
# value at a time, and `JSON.parse` / `JSON.parse?` / `JSON.build` /
# `JSON.to_json` / `JSON.from_json` on top of them.
#
# What a document becomes: `null` is `Nil`, `true`/`false` are `Bool`, an
# integer literal that fits Int64 is `Int64` (`-0` is the integer 0), every
# other number is `Float64` (a fraction, an exponent, or an integer past what
# Int64 holds, read as the nearest double), a string is `String` with its
# escapes decoded (`\uXXXX` pairs into one code point), an array is
# `Array(Any)` and an object is `Hash(String, Any)` in the order the keys
# were written.
#
# What the reader refuses, each with the line and column it stopped at:
# anything that is not a JSON document (bare words, leading zeros, a trailing
# comma, a raw control character, invalid UTF-8 or a lone surrogate inside a
# string, an invalid escape, a byte order mark, text after the root value,
# nesting past 256 levels, a number too large for a Float64) and an object
# that names the same key twice, in `JSON.parse` and in the `PullParser`
# alike. `JSON.parse` panics with that sentence; `JSON.parse?` answers `nil`.
# Nor does `JSON.to_json` write such an object: two keys of a Hash written
# as one text (`nil` and `"null"`, `1` and `"1"`) are refused, naming both.
#
# What the writer refuses: `NaN` and `Infinity`, which are not JSON numbers;
# a value where an object key is due, a field outside an object, a second
# value at the document root, a container closed that was never opened, and
# `to_s` of a document with a container still open or no value written.
# Every control byte under 0x20 and the byte 0x7f are written as `\u00XX`;
# bytes in a string that are not a code point are written as U+FFFD, one
# per ill-formed subpart, so what is written is UTF-8 the reader takes
# back; `to_ascii_json` also writes every non-ASCII code point as `\uXXXX`,
# with a surrogate pair past the basic plane, and U+FFFD as `\ufffd`.
#
# `ToJSON` is the trait a type implements to be written by `JSON.to_json`;
# `Any` implements it, and so do the prelude's scalars, arrays and hashes
# through `write_value`.

module std/json

# A growable byte buffer for the text a string or a document is assembled in.
class StringBuffer
  @buffer : Pointer(UInt8)
  @capacity : Int32
  @size : Int32

  def initialize(initial_capacity : Int32 = 64)
    @capacity = initial_capacity < 16 ? 16 : initial_capacity
    @buffer = Pointer(UInt8).malloc(@capacity.to_u64)
    @size = 0
  end

  def size : Int32
    @size
  end

  def clear : Nil
    @size = 0
  end

  def append(byte : UInt8) : Nil
    ensure_capacity(@size + 1)
    @buffer[@size] = byte
    @size = @size + 1
  end

  def append(str : String) : Nil
    len = str.bytesize
    return if len == 0
    ensure_capacity(@size + len)
    (@buffer + @size).copy_from(str.to_unsafe, len)
    @size = @size + len
  end

  def append(bytes : Pointer(UInt8), len : Int32) : Nil
    return if len == 0
    ensure_capacity(@size + len)
    (@buffer + @size).copy_from(bytes, len)
    @size = @size + len
  end

  def append_codepoint(codepoint : Int32) : Nil
    if codepoint <= 0x7F
      append(codepoint.to_u8)
    elsif codepoint <= 0x7FF
      append((0xC0 | (codepoint >> 6)).to_u8)
      append((0x80 | (codepoint & 0x3F)).to_u8)
    elsif codepoint <= 0xFFFF
      append((0xE0 | (codepoint >> 12)).to_u8)
      append((0x80 | ((codepoint >> 6) & 0x3F)).to_u8)
      append((0x80 | (codepoint & 0x3F)).to_u8)
    else
      append((0xF0 | (codepoint >> 18)).to_u8)
      append((0x80 | ((codepoint >> 12) & 0x3F)).to_u8)
      append((0x80 | ((codepoint >> 6) & 0x3F)).to_u8)
      append((0x80 | (codepoint & 0x3F)).to_u8)
    end
  end

  private def ensure_capacity(needed : Int32) : Nil
    return if needed <= @capacity
    while @capacity < needed
      @capacity = @capacity * 2
    end
    @buffer = @buffer.realloc(@capacity.to_u64)
  end

  def to_s : String
    len = @size
    ptr = @buffer
    String.new(len) do |target|
      target.copy_from(ptr, len)
    end
  end

  # The bytes appended since *start*, as a String.
  def slice_from(start : Int32) : String
    len = @size - start
    ptr = @buffer + start
    String.new(len) do |target|
      target.copy_from(ptr, len)
    end
  end
end

# The length of the well-formed UTF-8 sequence that starts at *at*, or,
# negated, the length of the maximal ill-formed subpart there: the bytes that
# could still have begun a well-formed sequence, at least the one byte. An
# overlong form, a surrogate and anything past U+10FFFF are ill-formed.
def utf8_sequence_at(bytes : Pointer(UInt8), size : Int32, at : Int32) : Int32
  lead = bytes[at]
  return 1 if lead < 0x80_u8
  need = 0
  low = 0x80_u8
  high = 0xBF_u8
  if lead >= 0xC2_u8 && lead <= 0xDF_u8
    need = 1
  elsif lead == 0xE0_u8
    need = 2
    low = 0xA0_u8
  elsif lead == 0xED_u8
    need = 2
    high = 0x9F_u8
  elsif lead >= 0xE1_u8 && lead <= 0xEF_u8
    need = 2
  elsif lead == 0xF0_u8
    need = 3
    low = 0x90_u8
  elsif lead == 0xF4_u8
    need = 3
    high = 0x8F_u8
  elsif lead >= 0xF1_u8 && lead <= 0xF3_u8
    need = 3
  else
    return -1
  end
  taken = 1
  while taken <= need
    return 0 - taken if at + taken >= size
    byte = bytes[at + taken]
    return 0 - taken if byte < low || byte > high
    low = 0x80_u8
    high = 0xBF_u8
    taken = taken + 1
  end
  taken
end

# A type that can write itself into a `Builder`. `JSON.to_json` accepts any
# value whose type implements it, as a `derive serializable` type does.
pub trait ToJSON
  abstract def to_json(json : Builder) : Nil
end

# `derive serializable`, in a struct or class whose fields are written with
# their types: the type reads and writes itself as a JSON object, a key per
# field, named as the field is.
#
#     pub struct Coord
#       getter x : Float64
#       getter name : String
#       derive serializable
#     end
#
#     Coord.from_json(%({"x": 1.5, "name": "a"})).x   # => 1.5
#     coord.to_json                                   # => {"x":1.5,"name":"a"}
#
# A field's value is read and written as `JSON.read_value` and
# `JSON.write_value` read and write its type: the built-in values, an
# `Array` or `Hash(String, V)` of them, an `Any`, another serializable
# type. A key the type has no field for is passed over; a field with no
# key keeps its default when it is written with one, as does a field with
# a default whose key holds `null` where its type does not admit nil; a
# field with neither is refused by name unless its type admits `nil`,
# which it then holds. It is what the other library's `include
# JSON::Serializable` writes, and the derive runs once, in the type's own
# module (SPEC.md II.4), so a consumer calls the methods without the macro.
pub macro serializable(declaration)
  impl ::Std::Json::ToJSON for {{ declaration[:name].id }}
    def to_json(json : ::Std::Json::Builder) : Nil
      json.object do
        {% for field in declaration[:fields] %}
          json.field({{ field[:name][1..] }})
          {% if field[:type].nilable? %}
            json_written = {{ field[:name].id }}
            if json_written.nil?
              json.null
            else
              ::Std::Json::JSON.write_value(json_written, json)
            end
          {% else %}
            ::Std::Json::JSON.write_value({{ field[:name].id }}, json)
          {% end %}
        {% end %}
      end
    end
  end

  def to_json : String
    ::Std::Json::JSON.build { |json| to_json(json) }
  end

  def self.from_json(text : String) : self
    ::Std::Json::JSON.from_json(text, self)
  end

  def initialize(pull : ::Std::Json::PullParser)
    # Each field's type is asked of the field itself (`typeof`): written
    # out, a type from this module arrives fully qualified, and a qualified
    # name reaches a type the way another module would. A field that may
    # be nil reads `null` as the nil and anything else as the other type,
    # which is the field's type with the nil taken out: `x || raise`.
    {% for field in declaration[:fields] %}
      json_value_{{ field[:name][1..].id }} = nil
      json_found_{{ field[:name][1..].id }} = false
    {% end %}
    pull.read_object do |json_key|
      {% if declaration[:fields].empty? %}
        pull.skip
      {% else %}
        # `json_found_` tells a key that was not there, where a field
        # keeps its default, from a `null`.
        case json_key
        {% for field in declaration[:fields] %}
        when {{ field[:name][1..] }}
          json_found_{{ field[:name][1..].id }} = true
          {% if field[:type].nilable? %}
            json_value_{{ field[:name][1..].id }} = pull.read_null? ? nil : ::Std::Json::JSON.read_value(pull, typeof({{ field[:name].id }} || raise("")))
          {% else %}
            # A `null` for a field with a default whose type does not admit
            # nil is no value, and the field keeps its default, as the other
            # library's derive reads it; it was refused as not the type.
            \{% if @type.instance_vars.any? { |ivar| ivar.name.stringify == {{ field[:name][1..] }} && ivar.has_default_value? } %}
              json_value_{{ field[:name][1..].id }} = pull.read_null? ? nil : ::Std::Json::JSON.read_value(pull, typeof({{ field[:name].id }}))
            \{% else %}
              json_value_{{ field[:name][1..].id }} = ::Std::Json::JSON.read_value(pull, typeof({{ field[:name].id }}))
            \{% end %}
          {% end %}
        {% end %}
        else
          pull.skip
        end
      {% end %}
    end
    # A field written with a default (`@port : Int32 = 8080`) holds it
    # already, so on a missing key, or a `null` its type does not admit, it
    # keeps its default; a key that is there wins, `null` included where the
    # type admits nil. Whether there is a default is asked of the type when
    # this method is compiled, not of the declaration, which carries names
    # and types only: the port was refused by name, and
    # `@host : String? = "localhost"` was overwritten with nil.
    {% for field in declaration[:fields] %}
      \{% if @type.instance_vars.any? { |ivar| ivar.name.stringify == {{ field[:name][1..] }} && ivar.has_default_value? } %}
        {% if field[:type].nilable? %}
          {{ field[:name].id }} = json_value_{{ field[:name][1..].id }} if json_found_{{ field[:name][1..].id }}
        {% else %}
          json_field_{{ field[:name][1..].id }} = json_value_{{ field[:name][1..].id }}
          {{ field[:name].id }} = json_field_{{ field[:name][1..].id }} unless json_field_{{ field[:name][1..].id }}.nil?
        {% end %}
      \{% elsif {{ field[:type].nilable? }} %}
        {{ field[:name].id }} = json_value_{{ field[:name][1..].id }}
      \{% else %}
        json_field_{{ field[:name][1..].id }} = json_value_{{ field[:name][1..].id }}
        raise "JSON for #{ {{ declaration[:name] }} } has no key #{ {{ field[:name][1..] }}.inspect }" if json_field_{{ field[:name][1..].id }}.nil?
        {{ field[:name].id }} = json_field_{{ field[:name][1..].id }}
      \{% end %}
    {% end %}
  end
end

# One JSON value of any kind, the result of `JSON.parse`. The `as_x` methods
# panic when the value is of another kind; the `as_x?` ones answer `nil`.
pub struct Any
  alias Type = Nil | Bool | Int64 | Float64 | String | Array(Any) | Hash(String, Any)

  getter raw : Type

  def initialize(@raw : Type)
  end

  def self.new(val : Int32) : Any
    new(val.to_i64)
  end

  # The kind of value this is, in the word a refusal uses: `null`, `bool`,
  # `integer`, `float`, `string`, `array` or `object`.
  def kind : String
    if @raw.nil?
      "null"
    elsif @raw.is_a?(Bool)
      "bool"
    elsif as_s?
      "string"
    elsif as_i64?
      "integer"
    elsif float_value?
      "float"
    elsif as_a?
      "array"
    else
      "object"
    end
  end

  def as_nil : Nil
    raise "as_nil of a JSON #{kind}" unless @raw.nil?
    nil
  end

  def as_bool : Bool
    raise "as_bool of a JSON #{kind}" unless @raw.is_a?(Bool)
    @raw.as(Bool)
  end

  def as_bool? : Bool?
    case r = @raw
    when Bool then r
    else           nil
    end
  end

  def as_i : Int32
    r = as_i64? || raise "as_i of a JSON #{kind}"
    if r < -2147483648_i64 || r > 2147483647_i64
      raise "integer #{r} out of Int32 range"
    end
    r.to_i32
  end

  def as_i? : Int32?
    r = as_i64?
    return nil if r.nil?
    r >= -2147483648_i64 && r <= 2147483647_i64 ? r.to_i32 : nil
  end

  def as_i64 : Int64
    as_i64? || raise "as_i64 of a JSON #{kind}"
  end

  def as_i64? : Int64?
    case r = @raw
    when Int64 then r
    else            nil
    end
  end

  # A float, or an integer read as one.
  def as_f : Float64
    as_f? || raise "as_f of a JSON #{kind}"
  end

  def as_f? : Float64?
    case r = @raw
    when Float64 then r
    when Int64   then r.to_f64
    else              nil
    end
  end

  protected def float_value? : Float64?
    case r = @raw
    when Float64 then r
    else              nil
    end
  end

  def as_s : String
    as_s? || raise "as_s of a JSON #{kind}"
  end

  def as_s? : String?
    case r = @raw
    when String then r
    else             nil
    end
  end

  def as_a : Array(Any)
    as_a? || raise "as_a of a JSON #{kind}"
  end

  def as_a? : Array(Any)?
    case r = @raw
    when Array(Any) then r
    else                 nil
    end
  end

  def as_h : Hash(String, Any)
    as_h? || raise "as_h of a JSON #{kind}"
  end

  def as_h? : Hash(String, Any)?
    case r = @raw
    when Hash(String, Any) then r
    else                        nil
    end
  end

  # How many elements an array or an object holds. A scalar has no size.
  def size : Int32
    size? || raise "size of a JSON #{kind}"
  end

  def size? : Int32?
    if a = as_a?
      a.size
    elsif h = as_h?
      h.size
    else
      nil
    end
  end

  def [](index : Int32) : Any
    a = as_a? || raise "index #{index} into a JSON #{kind}"
    actual = index < 0 ? index + a.size : index
    if actual < 0 || actual >= a.size
      raise "index #{index} out of range for #{a.size} elements"
    end
    a[actual]
  end

  def []?(index : Int32) : Any?
    a = as_a?
    return nil if a.nil?
    actual = index < 0 ? index + a.size : index
    actual < 0 || actual >= a.size ? nil : a[actual]
  end

  def [](key : String) : Any
    h = as_h? || raise "key #{key.inspect} into a JSON #{kind}"
    h[key]? || raise "no such key #{key.inspect}"
  end

  def []?(key : String) : Any?
    h = as_h?
    h.nil? ? nil : h[key]?
  end

  def dig?(key : String) : Any?
    self[key]?
  end

  def dig?(index : Int32) : Any?
    self[index]?
  end

  def dig?(k : String, *subkeys : String | Int32) : Any?
    v = self[k]?
    return nil unless v
    v.dig?(*subkeys)
  end

  def dig?(idx : Int32, *subkeys : String | Int32) : Any?
    v = self[idx]?
    return nil unless v
    v.dig?(*subkeys)
  end

  def dig(key : String) : Any
    self[key]
  end

  def dig(index : Int32) : Any
    self[index]
  end

  def dig(k : String, *subkeys : String | Int32) : Any
    self[k].dig(*subkeys)
  end

  def dig(idx : Int32, *subkeys : String | Int32) : Any
    self[idx].dig(*subkeys)
  end

  # Equal when the values are: an integer equals the float with the same
  # value, arrays element by element, objects key by key in any order.
  def ==(other : Any) : Bool
    if @raw.nil?
      other.raw.nil?
    elsif @raw.is_a?(Bool)
      other.raw.is_a?(Bool) && @raw.as(Bool) == other.raw.as(Bool)
    elsif s = as_s?
      o = other.as_s?
      o.nil? ? false : s == o
    elsif i = as_i64?
      if oi = other.as_i64?
        i == oi
      elsif of = other.float_value?
        integer_equals_float?(i, of)
      else
        false
      end
    elsif f = float_value?
      if oi = other.as_i64?
        integer_equals_float?(oi, f)
      elsif of = other.float_value?
        f == of
      else
        false
      end
    elsif a = as_a?
      b = other.as_a?
      return false if b.nil?
      return false if a.size != b.size
      idx = 0
      while idx < a.size
        return false unless a[idx] == b[idx]
        idx = idx + 1
      end
      true
    elsif h = as_h?
      oh = other.as_h?
      return false if oh.nil?
      return false if h.size != oh.size
      keys = h.keys
      idx = 0
      while idx < keys.size
        k = keys[idx]
        ov = oh[k]?
        return false if ov.nil?
        return false unless h[k] == ov
        idx = idx + 1
      end
      true
    else
      false
    end
  end

  # Only a whole float in Int64's range can equal an integer, and then the
  # comparison is exact in the integer, not rounded through the float.
  private def integer_equals_float?(i : Int64, f : Float64) : Bool
    return false unless f >= -9223372036854775808.0 && f < 9223372036854775808.0
    t = f.to_i64
    t.to_f64 == f && t == i
  end

  # Consistent with `==`: a whole float hashes as the integer it equals, an
  # object's hash does not depend on the order its keys were written in.
  def hash : Int32
    if @raw.nil?
      0
    elsif @raw.is_a?(Bool)
      @raw.as(Bool) ? 1 : 2
    elsif s = as_s?
      s.hash
    elsif i = as_i64?
      i.hash
    elsif f = float_value?
      if f >= -9223372036854775808.0 && f < 9223372036854775808.0
        t = f.to_i64
        return t.hash if t.to_f64 == f
      end
      bits = IyiFloatText.bits_of(f)
      ((bits ^ bits.unsafe_shr(32_u64)) & 0x7FFFFFFF_u64).to_i32
    elsif a = as_a?
      # As an `Array` hashes. It was `31 * h + e`, an integer hashing as
      # itself: `[1,0]` and `[0,31]` hashed alike, and a 150 by 150 grid of
      # `[i, j]` had 4,769 hashes for its 22,500 values.
      a.hash
    elsif h = as_h?
      # A sum over the pairs, each pair's two hashes packed into one word and
      # put through splitmix64's finaliser, so the terms share no structure
      # the sum could cancel. It was the sum of `31 * k.hash + v.hash`:
      # `{"a":1,"b":2}` and `{"a":2,"b":1}` hashed alike, and 160,000 objects
      # `{"x":i,"y":j}` took 26 s to go into a `Hash(Any, Bool)`.
      value = 0x9E3779B97F4A7C15_u64 ^ h.size.to_i64.unsafe_to_u64
      h.each do |k, v|
        pair = k.hash.to_i64.unsafe_to_u64.unsafe_shl(32_u64) | (v.hash.to_i64.unsafe_to_u64 & 0xFFFFFFFF_u64)
        pair = (pair ^ pair.unsafe_shr(30_u64)) &* 0xBF58476D1CE4E5B9_u64
        pair = (pair ^ pair.unsafe_shr(27_u64)) &* 0x94D049BB133111EB_u64
        value = value &+ (pair ^ pair.unsafe_shr(31_u64))
      end
      value.hash
    else
      0
    end
  end

  def to_json : String
    b = Builder.new
    to_json(b)
    b.to_s
  end

  def to_pretty_json(indent : String = "  ") : String
    b = Builder.new
    b.indent = indent
    to_json(b)
    b.to_s
  end

  def to_ascii_json : String
    b = Builder.new
    b.ascii_only = true
    to_json(b)
    b.to_s
  end

  # A string as itself and null as nothing, as `YAML::Any#to_s` and the
  # other library answer them; a number, a boolean or a collection as its
  # JSON text. A string was its JSON text too, so `"hello #{doc["name"]}"`
  # printed `hello "Ada"`, and null printed `null`.
  def to_s : String
    if s = as_s?
      s
    elsif @raw.nil?
      ""
    else
      to_json
    end
  end

  def inspect : String
    to_json
  end
end

impl ToJSON for Any
  def to_json(json : Builder) : Nil
    if @raw.nil?
      json.null
    elsif @raw.is_a?(Bool)
      json.bool(@raw.as(Bool))
    elsif s = as_s?
      json.string(s)
    elsif i = as_i64?
      json.number(i)
    elsif f = float_value?
      json.number(f)
    elsif a = as_a?
      json.start_array
      idx = 0
      while idx < a.size
        a[idx].to_json(json)
        idx = idx + 1
      end
      json.end_array
    elsif h = as_h?
      json.start_object
      keys = h.keys
      idx = 0
      while idx < keys.size
        k = keys[idx]
        json.field(k)
        h[k].to_json(json)
        idx = idx + 1
      end
      json.end_object
    end
  end
end

enum TokenKind
  Null
  False
  True
  Int
  Float
  String
  BeginArray
  EndArray
  BeginObject
  EndObject
  Colon
  Comma
  EOF
  Error
end

class Token
  property kind : TokenKind
  # A number's text, as the span of the input it was read from: made into
  # a string only when asked, which a reader of the number's value never
  # does - a substring a number was an allocation for every number read.
  property raw_input : String
  property raw_start : Int32
  property raw_size : Int32
  property string_value : String
  property int_value : Int64
  property float_value : Float64
  # A string's text read as a span (`raw_start`, `raw_size`) of the input
  # by a lexer on the tape, and whether it holds an escape to decode.
  property escaped : Bool
  property line_number : Int32
  property column_number : Int32

  def initialize
    @kind = TokenKind::EOF
    @raw_input = ""
    @raw_start = 0
    @raw_size = 0
    @string_value = ""
    @int_value = 0_i64
    @float_value = 0.0
    @escaped = false
    @line_number = 1
    @column_number = 1
  end

  def raw_value : String
    @raw_input[@raw_start, @raw_size]
  end
end

# Reads tokens from the bytes of a document. A malformed token is not a
# panic here: `next_token` answers a token of kind `Error` and `error` holds
# the sentence, so `JSON.parse?` can answer `nil` and `JSON.parse` can panic.
class Lexer
  @input : String
  @bytes : Pointer(UInt8)
  @bytesize : Int32
  @pos : Int32
  @line_number : Int32
  @column_number : Int32
  @token : Token
  @string_buffer : StringBuffer
  @error : String?
  # Short strings the lexer has already made, by a hash of their bytes: an
  # object's keys are the same few strings in every object of an array,
  # and each was a new substring. A slot holds the last string that hashed
  # there, so a miss costs the substring it always did.
  @short : Array(String)
  # Strings are spans of the input, not Strings: the tape reader's mode.
  @spans : Bool

  def initialize(@input : String)
    @bytes = @input.to_unsafe
    @bytesize = @input.bytesize
    @pos = 0
    @line_number = 1
    @column_number = 1
    @token = Token.new
    @string_buffer = StringBuffer.new(64)
    @error = nil
    @short = Array(String).new(SHORT_SLOTS) { "" }
    @spans = false
  end

  # A lexer over bytes on the tape (`JSON.parse(TapeString)`): a string
  # token is its span, with `escaped` set when it must be decoded, and
  # nothing of it is copied.
  def initialize(@bytes : Pointer(UInt8), @bytesize : Int32)
    @input = ""
    @pos = 0
    @line_number = 1
    @column_number = 1
    @token = Token.new
    @string_buffer = StringBuffer.new(16)
    @error = nil
    @short = [] of String
    @spans = true
  end

  # The thread's spare span lexer, kept between parses: made anew, its
  # objects were the only heap a parse on the tape made. A parse does not
  # switch fibers, so one a thread is enough.
  @[ThreadLocal]
  @@spare : Lexer? = nil

  def self.spans(bytes : Pointer(UInt8), size : Int32) : Lexer
    lexer = @@spare
    return new(bytes, size) unless lexer
    @@spare = nil
    lexer.restart(bytes, size)
    lexer
  end

  def self.give_back(lexer : Lexer) : Nil
    @@spare = lexer
  end

  protected def restart(@bytes : Pointer(UInt8), @bytesize : Int32) : Nil
    @pos = 0
    @line_number = 1
    @column_number = 1
    @token.kind = TokenKind::EOF
    @token.escaped = false
    @error = nil
  end

  # The input's bytes from *start* as a String, in either mode.
  private def slice(start : Int32, size : Int32) : String
    return @input[start, size] unless @spans
    from = @bytes + start
    String.new(size) { |target| target.copy_from(from, size) }
  end

  SHORT_SLOTS = 256
  SHORT_MAX   =  24

  # The string the input spells from *start* for *size* bytes.
  private def text_at(start : Int32, size : Int32) : String
    return @input[start, size] if size > SHORT_MAX || size == 0
    p = @bytes + start
    h = 2166136261_u64
    i = 0
    while i < size
      h = (h ^ p[i].to_u64) &* 16777619_u64
      i = i + 1
    end
    slot = (h ^ h.unsafe_shr(8_u64)).unsafe_to_i32 & (SHORT_SLOTS - 1)
    cached = @short[slot]
    if cached.bytesize == size
      q = cached.to_unsafe
      same = true
      i = 0
      while i < size
        if q[i] != p[i]
          same = false
          break
        end
        i = i + 1
      end
      return cached if same
    end
    made = @input[start, size]
    @short[slot] = made
    made
  end

  def token : Token
    @token
  end

  def error : String?
    @error
  end

  private def fail(reason : String, line : Int32, col : Int32) : Nil
    @error = "#{reason} at line #{line}, column #{col}" if @error.nil?
    @token.kind = TokenKind::Error
    nil
  end

  private def current_byte : UInt8
    @pos < @bytesize ? @bytes[@pos] : 0_u8
  end

  private def advance : UInt8
    b = current_byte
    if @pos < @bytesize
      if b == 10_u8 # '\n'
        @line_number = @line_number + 1
        @column_number = 1
      elsif (b & 0xC0_u8) != 0x80_u8
        # A column is a character: continuation bytes do not advance it.
        @column_number = @column_number + 1
      end
      @pos = @pos + 1
    end
    current_byte
  end

  private def skip_whitespace : Nil
    while @pos < @bytesize
      b = current_byte
      if b == 32_u8 || b == 9_u8 || b == 10_u8 || b == 13_u8
        advance
      else
        break
      end
    end
  end

  def next_token : Token
    return @token unless @error.nil?
    skip_whitespace

    tok_line = @line_number
    tok_col = @column_number

    if @pos >= @bytesize
      set_token(TokenKind::EOF, tok_line, tok_col)
      return @token
    end

    b = current_byte
    case b
    when 123_u8 # '{'
      advance
      set_token(TokenKind::BeginObject, tok_line, tok_col)
    when 125_u8 # '}'
      advance
      set_token(TokenKind::EndObject, tok_line, tok_col)
    when 91_u8 # '['
      advance
      set_token(TokenKind::BeginArray, tok_line, tok_col)
    when 93_u8 # ']'
      advance
      set_token(TokenKind::EndArray, tok_line, tok_col)
    when 58_u8 # ':'
      advance
      set_token(TokenKind::Colon, tok_line, tok_col)
    when 44_u8 # ','
      advance
      set_token(TokenKind::Comma, tok_line, tok_col)
    when 34_u8 # '"'
      consume_string(tok_line, tok_col)
    when 116_u8 # 't'
      consume_word("true", TokenKind::True, tok_line, tok_col)
    when 102_u8 # 'f'
      consume_word("false", TokenKind::False, tok_line, tok_col)
    when 110_u8 # 'n'
      consume_word("null", TokenKind::Null, tok_line, tok_col)
    when 45_u8, 48_u8, 49_u8, 50_u8, 51_u8, 52_u8, 53_u8, 54_u8, 55_u8, 56_u8, 57_u8 # '-', '0'..'9'
      consume_number(tok_line, tok_col)
    else
      if identifier_byte?(b)
        consume_bare_identifier(tok_line, tok_col)
      elsif b >= 32_u8 && b < 127_u8
        fail("unexpected character '#{b.unsafe_chr}'", tok_line, tok_col)
      elsif b == 0xEF_u8 && @pos + 2 < @bytesize && @bytes[@pos + 1] == 0xBB_u8 && @bytes[@pos + 2] == 0xBF_u8
        fail("unexpected UTF-8 byte order mark", tok_line, tok_col)
      else
        fail("unexpected byte #{b}", tok_line, tok_col)
      end
    end

    @token
  end

  private def set_token(kind : TokenKind, line : Int32, col : Int32) : Nil
    @token.kind = kind
    @token.line_number = line
    @token.column_number = col
  end

  private def identifier_byte?(b : UInt8) : Bool
    (b >= 97_u8 && b <= 122_u8) || (b >= 65_u8 && b <= 90_u8) || (b >= 48_u8 && b <= 57_u8) || b == 95_u8
  end

  private def consume_bare_identifier(line : Int32, col : Int32) : Nil
    start = @pos
    while @pos < @bytesize && identifier_byte?(current_byte)
      advance
    end
    fail("bare identifier '#{slice(start, @pos - start)}'", line, col)
  end

  # `true`, `false`, `null`: the whole word, and nothing joined to it.
  private def consume_word(word : String, kind : TokenKind, line : Int32, col : Int32) : Nil
    start = @pos
    expected = word.to_unsafe
    i = 0
    while i < word.bytesize
      if current_byte != expected[i]
        @pos = start
        return consume_bare_identifier(line, col)
      end
      advance
      i = i + 1
    end
    if identifier_byte?(current_byte)
      @pos = start
      return consume_bare_identifier(line, col)
    end
    set_token(kind, line, col)
  end

  private def consume_string(line : Int32, col : Int32) : Nil
    advance # the opening quote
    start_pos = @pos
    has_escape = false

    while @pos < @bytesize
      b = current_byte
      if b == 34_u8 # '"'
        break
      elsif b == 92_u8 # '\\'
        has_escape = true
        break
      elsif b < 32_u8
        return fail("unescaped control character (ASCII #{b}) in string", @line_number, @column_number)
      elsif b >= 128_u8
        return unless take_utf8_sequence
      else
        step_ascii
      end
    end

    if @spans && @pos < @bytesize
      return consume_span(start_pos, has_escape, line, col)
    end

    if !has_escape && @pos < @bytesize && current_byte == 34_u8
      # No escape: the text is a substring of the input.
      str_val = text_at(start_pos, @pos - start_pos)
      advance
      set_token(TokenKind::String, line, col)
      @token.string_value = str_val
      return
    end

    if @pos >= @bytesize
      return fail("unterminated string", line, col)
    end

    @string_buffer.clear
    if @pos > start_pos
      @string_buffer.append(@bytes + start_pos, @pos - start_pos)
    end

    while @pos < @bytesize
      b = current_byte
      if b == 34_u8 # '"'
        advance
        set_token(TokenKind::String, line, col)
        @token.string_value = @string_buffer.to_s
        return
      elsif b == 92_u8 # '\\'
        esc_col = @column_number
        advance
        if @pos >= @bytesize
          return fail("unterminated string after backslash", line, esc_col)
        end
        esc = current_byte
        case esc
        when 34_u8 # '"'
          @string_buffer.append(34_u8)
          advance
        when 92_u8 # '\\'
          @string_buffer.append(92_u8)
          advance
        when 47_u8 # '/'
          @string_buffer.append(47_u8)
          advance
        when 98_u8 # 'b'
          @string_buffer.append(8_u8)
          advance
        when 102_u8 # 'f'
          @string_buffer.append(12_u8)
          advance
        when 110_u8 # 'n'
          @string_buffer.append(10_u8)
          advance
        when 114_u8 # 'r'
          @string_buffer.append(13_u8)
          advance
        when 116_u8 # 't'
          @string_buffer.append(9_u8)
          advance
        when 117_u8 # 'u'
          u_line = @line_number
          u_col = @column_number - 1
          advance
          hex1 = read_hex4(u_line, u_col)
          return if hex1 < 0

          if hex1 >= 0xD800 && hex1 <= 0xDBFF
            # A high surrogate must be followed at once by `\u` and a low one.
            if current_byte != 92_u8
              return fail("lone high surrogate \\u#{hex1.to_s(16)} without low surrogate", u_line, u_col)
            end
            advance
            if current_byte != 117_u8
              return fail("lone high surrogate \\u#{hex1.to_s(16)} without following \\u escape", u_line, u_col)
            end
            u2_line = @line_number
            u2_col = @column_number - 1
            advance
            hex2 = read_hex4(u2_line, u2_col)
            return if hex2 < 0
            if hex2 < 0xDC00 || hex2 > 0xDFFF
              return fail("invalid surrogate pair: expected low surrogate (0xDC00..0xDFFF), got \\u#{hex2.to_s(16)}", u2_line, u2_col)
            end
            @string_buffer.append_codepoint(0x10000 + ((hex1 - 0xD800) << 10) + (hex2 - 0xDC00))
          elsif hex1 >= 0xDC00 && hex1 <= 0xDFFF
            return fail("lone low surrogate \\u#{hex1.to_s(16)} without preceding high surrogate", u_line, u_col)
          else
            @string_buffer.append_codepoint(hex1)
          end
        else
          if esc >= 32_u8 && esc < 127_u8
            return fail("invalid escape sequence '\\#{esc.unsafe_chr}'", line, esc_col)
          end
          return fail("invalid escape sequence '\\' before byte #{esc}", line, esc_col)
        end
      elsif b < 32_u8
        return fail("unescaped control character (ASCII #{b}) in string", @line_number, @column_number)
      elsif b >= 128_u8
        from = @pos
        return unless take_utf8_sequence
        @string_buffer.append(@bytes + from, @pos - from)
      else
        @string_buffer.append(b)
        advance
      end
    end

    fail("unterminated string", line, col)
  end

  # The rest of a string from the current byte, checked as `consume_string`
  # checks it, and taken as the span from *start* to the closing quote.
  private def consume_span(start : Int32, has_escape : Bool, line : Int32, col : Int32) : Nil
    while @pos < @bytesize
      b = current_byte
      if b == 34_u8 # '"'
        @token.raw_start = start
        @token.raw_size = @pos - start
        @token.escaped = has_escape
        advance
        set_token(TokenKind::String, line, col)
        return
      elsif b == 92_u8 # '\\'
        has_escape = true
        esc_col = @column_number
        advance
        return fail("unterminated string after backslash", line, esc_col) if @pos >= @bytesize
        esc = current_byte
        if esc == 117_u8 # 'u'
          u_line = @line_number
          u_col = @column_number - 1
          advance
          hex1 = read_hex4(u_line, u_col)
          return if hex1 < 0
          if hex1 >= 0xD800 && hex1 <= 0xDBFF
            if current_byte != 92_u8
              return fail("lone high surrogate \\u#{hex1.to_s(16)} without low surrogate", u_line, u_col)
            end
            advance
            if current_byte != 117_u8
              return fail("lone high surrogate \\u#{hex1.to_s(16)} without following \\u escape", u_line, u_col)
            end
            u2_line = @line_number
            u2_col = @column_number - 1
            advance
            hex2 = read_hex4(u2_line, u2_col)
            return if hex2 < 0
            if hex2 < 0xDC00 || hex2 > 0xDFFF
              return fail("invalid surrogate pair: expected low surrogate (0xDC00..0xDFFF), got \\u#{hex2.to_s(16)}", u2_line, u2_col)
            end
          elsif hex1 >= 0xDC00 && hex1 <= 0xDFFF
            return fail("lone low surrogate \\u#{hex1.to_s(16)} without preceding high surrogate", u_line, u_col)
          end
        elsif esc == 34_u8 || esc == 92_u8 || esc == 47_u8 || esc == 98_u8 || esc == 102_u8 || esc == 110_u8 || esc == 114_u8 || esc == 116_u8
          advance
        elsif esc >= 32_u8 && esc < 127_u8
          return fail("invalid escape sequence '\\#{esc.unsafe_chr}'", line, esc_col)
        else
          return fail("invalid escape sequence '\\' before byte #{esc}", line, esc_col)
        end
      elsif b < 32_u8
        return fail("unescaped control character (ASCII #{b}) in string", @line_number, @column_number)
      elsif b >= 128_u8
        return unless take_utf8_sequence
      else
        step_ascii
      end
    end
    fail("unterminated string", line, col)
  end

  # Passes over the UTF-8 sequence at the current byte and answers true, or
  # records why the bytes there are not one (RFC 8259 §8.1: a document is
  # UTF-8) and answers false.
  private def take_utf8_sequence : Bool
    b = current_byte
    length = utf8_sequence_at(@bytes, @bytesize, @pos)
    if length < 0
      if b >= 0xC2_u8 && b <= 0xF4_u8
        fail("malformed UTF-8 sequence starting with byte #{b} in string", @line_number, @column_number)
      else
        fail("invalid UTF-8 byte #{b} in string", @line_number, @column_number)
      end
      return false
    end
    while length > 0
      advance
      length = length - 1
    end
    true
  end

  # Four hex digits, or -1 after recording why not.
  private def read_hex4(line : Int32, col : Int32) : Int32
    val = 0
    i = 0
    while i < 4
      if @pos >= @bytesize
        fail("unterminated \\u escape sequence: expected 4 hexadecimal digits", line, col)
        return -1
      end
      b = current_byte
      d = hex_digit_value(b)
      if d < 0
        if b >= 32_u8 && b < 127_u8
          fail("invalid hex digit '#{b.unsafe_chr}' in \\u escape sequence", @line_number, @column_number)
        else
          fail("invalid hex digit (byte #{b}) in \\u escape sequence", @line_number, @column_number)
        end
        return -1
      end
      val = (val << 4) | d
      advance
      i = i + 1
    end
    val
  end

  private def hex_digit_value(b : UInt8) : Int32
    if b >= 48_u8 && b <= 57_u8 # '0'..'9'
      (b - 48_u8).to_i
    elsif b >= 97_u8 && b <= 102_u8 # 'a'..'f'
      (b - 97_u8).to_i + 10
    elsif b >= 65_u8 && b <= 70_u8 # 'A'..'F'
      (b - 65_u8).to_i + 10
    else
      -1
    end
  end

  private def digit?(b : UInt8) : Bool
    b >= 48_u8 && b <= 57_u8
  end

  private def consume_number(line : Int32, col : Int32) : Nil
    start_pos = @pos
    has_fraction = false
    has_exponent = false
    negative = false
    # The significant digits as one integer while it fits nineteen of them,
    # and the power of ten they are scaled by: what the fast conversion
    # below reads instead of the number's text.
    mantissa = 0_u64
    digits = 0
    scale = 0

    if current_byte == 45_u8 # '-'
      negative = true
      advance
      if @pos >= @bytesize
        return fail("expected digit after minus sign in number", line, col)
      end
      unless digit?(current_byte)
        return fail("expected digit after minus sign in number", @line_number, @column_number)
      end
    end

    if current_byte == 48_u8 # '0'
      step_ascii
      if @pos < @bytesize && digit?(current_byte)
        return fail("leading zero not allowed in number", @line_number, @column_number)
      end
    else
      while @pos < @bytesize && digit?(current_byte)
        if digits < 19
          mantissa = mantissa &* 10_u64 &+ (current_byte &- 48_u8).to_u64
          digits = digits + 1
        else
          scale = scale + 1
        end
        step_ascii
      end
    end

    if @pos < @bytesize && current_byte == 46_u8 # '.'
      has_fraction = true
      step_ascii
      if @pos >= @bytesize
        return fail("expected at least one digit after decimal point", line, col)
      end
      unless digit?(current_byte)
        return fail("expected at least one digit after decimal point", @line_number, @column_number)
      end
      while @pos < @bytesize && digit?(current_byte)
        if digits < 19
          if digits > 0 || current_byte != 48_u8
            mantissa = mantissa &* 10_u64 &+ (current_byte &- 48_u8).to_u64
            digits = digits + 1
          end
          scale = scale - 1
        end
        step_ascii
      end
    end

    exponent = 0
    exponent_digits = 0
    if @pos < @bytesize && (current_byte == 101_u8 || current_byte == 69_u8) # 'e' or 'E'
      has_exponent = true
      step_ascii
      exponent_negative = false
      if @pos < @bytesize && (current_byte == 43_u8 || current_byte == 45_u8) # '+' or '-'
        exponent_negative = current_byte == 45_u8
        step_ascii
      end
      if @pos >= @bytesize
        return fail("expected at least one digit in exponent", line, col)
      end
      unless digit?(current_byte)
        return fail("expected at least one digit in exponent", @line_number, @column_number)
      end
      while @pos < @bytesize && digit?(current_byte)
        exponent = exponent * 10 + (current_byte - 48_u8).to_i32 if exponent < 100000
        exponent_digits = exponent_digits + 1
        step_ascii
      end
      exponent = 0 - exponent if exponent_negative
    end

    # `0x12`, `1a`, `1.2.3`: a number does not run into letters or a second point.
    if @pos < @bytesize
      tail_b = current_byte
      if (tail_b >= 97_u8 && tail_b <= 122_u8) || (tail_b >= 65_u8 && tail_b <= 90_u8) || tail_b == 46_u8
        return fail("unexpected character '#{tail_b.unsafe_chr}' in number", @line_number, @column_number)
      end
    end

    set_token(TokenKind::Int, line, col)
    @token.raw_input = @input
    @token.raw_start = start_pos
    @token.raw_size = @pos - start_pos

    unless has_fraction || has_exponent
      val = parse_int64?(@bytes + start_pos, @pos - start_pos)
      unless val.nil?
        @token.int_value = val
        return
      end
    end

    # Clinger's fast path: an integer under 2^53 and a power of ten a
    # double holds exactly are both exact, so their product or quotient is
    # rounded once, which is the correctly rounded value `to_f` answers.
    # Anything else - more digits, a larger exponent - is read from the
    # text as before.
    f = 0.0
    fast = false
    if digits <= 15 && exponent_digits <= 3
      power = scale + exponent
      if power >= 0 && power <= 22
        f = mantissa.to_f64 * POW10[power]
        fast = true
      elsif power < 0 && power >= -22
        f = mantissa.to_f64 / POW10[0 - power]
        fast = true
      end
    end
    if fast
      # The sign flipped, not subtracted from zero: `0.0 - 0.0` is `0.0`,
      # and `-0.0` is what the text says.
      f = f * -1.0 if negative
    else
      f = slice(start_pos, @pos - start_pos).to_f
      if f.abs > 1.7976931348623157e308
        return fail("number #{slice(start_pos, @pos - start_pos)} out of range", line, col)
      end
    end
    @token.kind = TokenKind::Float
    @token.float_value = f
  end

  # A byte known to be ASCII and not a line break: one column on.
  private def step_ascii : Nil
    @pos = @pos + 1
    @column_number = @column_number + 1
  end

  # The Int64 these digits spell, or nil when they do not fit. The negative
  # magnitude is accumulated so the smallest Int64 needs no negation.
  private def parse_int64?(bytes : Pointer(UInt8), len : Int32) : Int64?
    i = 0
    negative = false
    if bytes[0] == 45_u8
      negative = true
      i = 1
    end
    val = 0_i64
    if negative
      while i < len
        d = (bytes[i] - 48_u8).to_i64
        return nil if val < -922337203685477580_i64 || (val == -922337203685477580_i64 && d > 8_i64)
        val = val * 10_i64 - d
        i = i + 1
      end
    else
      while i < len
        d = (bytes[i] - 48_u8).to_i64
        return nil if val > 922337203685477580_i64 || (val == 922337203685477580_i64 && d > 7_i64)
        val = val * 10_i64 + d
        i = i + 1
      end
    end
    val
  end
end

# The deepest document read: deep enough for any data a person wrote, and
# shallow enough for a task's stack. It was 512, Crystal's, whose fibers
# have megabytes; a task here has 256 KB (`IyiFiber::STACK_BYTES`), and a
# task that parsed 480 nested arrays - a request body, in a server whose
# handlers are tasks - died of a stack overflow that took the whole
# process, and `==` on two such values died at 334. At 256 a plain build
# parses, compares, prints and hashes the deepest document in a task with
# a fifth of the stack to spare.
MAX_NESTING = 256

# The powers of ten a double holds exactly, for the lexer's fast path.
POW10 = [1.0, 1e1, 1e2, 1e3, 1e4, 1e5, 1e6, 1e7, 1e8, 1e9, 1e10, 1e11, 1e12, 1e13, 1e14, 1e15,
         1e16, 1e17, 1e18, 1e19, 1e20, 1e21, 1e22]

# Reads a whole document into an `Any`. Like the lexer it records the first
# failure instead of panicking; `JSON.parse` and `JSON.parse?` decide what to
# do with it.
pub class Parser
  @lexer : Lexer
  @nesting : Int32
  @error : String?

  def initialize(input : String)
    @lexer = Lexer.new(input)
    @nesting = 0
    @error = nil
    @lexer.next_token
  end

  def error : String?
    @error
  end

  private def token : Token
    @lexer.token
  end

  private def next_token : Token
    @lexer.next_token
  end

  # The lexer's sentence when the current token is the one it refused, the
  # parser's otherwise. The first failure is the one kept.
  private def fail(reason : String, line : Int32, col : Int32) : Any
    if @error.nil?
      lexer_error = @lexer.error
      @error = lexer_error.nil? ? "#{reason} at line #{line}, column #{col}" : lexer_error
    end
    Any.new(nil)
  end

  private def fail(reason : String) : Any
    fail(reason, token.line_number, token.column_number)
  end

  def parse : Any
    if token.kind == TokenKind::EOF
      return fail("empty JSON input", 1, 1)
    end
    result = parse_value
    return result unless @error.nil?
    unless token.kind == TokenKind::EOF
      return fail("unexpected #{token_text} after JSON root value")
    end
    result
  end

  private def token_text : String
    case token.kind
    when TokenKind::BeginArray  then "'['"
    when TokenKind::BeginObject then "'{'"
    when TokenKind::EndArray    then "']'"
    when TokenKind::EndObject   then "'}'"
    when TokenKind::Colon       then "':'"
    when TokenKind::Comma       then "','"
    when TokenKind::True        then "'true'"
    when TokenKind::False       then "'false'"
    when TokenKind::Null        then "'null'"
    when TokenKind::EOF         then "end of input"
    when TokenKind::String      then "string"
    when TokenKind::Int         then "number #{token.raw_value}"
    when TokenKind::Float       then "number #{token.raw_value}"
    else                             "value"
    end
  end

  private def parse_value : Any
    case token.kind
    when TokenKind::Null
      next_token
      Any.new(nil)
    when TokenKind::True
      next_token
      Any.new(true)
    when TokenKind::False
      next_token
      Any.new(false)
    when TokenKind::Int
      val = token.int_value
      next_token
      Any.new(val)
    when TokenKind::Float
      val = token.float_value
      next_token
      Any.new(val)
    when TokenKind::String
      str = token.string_value
      next_token
      Any.new(str)
    when TokenKind::BeginArray
      parse_array
    when TokenKind::BeginObject
      parse_object
    else
      fail("unexpected #{token_text}")
    end
  end

  private def parse_array : Any
    line = token.line_number
    col = token.column_number

    @nesting = @nesting + 1
    if @nesting > MAX_NESTING
      return fail("nesting depth of #{@nesting} exceeds maximum depth #{MAX_NESTING}", line, col)
    end

    next_token # '['
    ary = [] of Any

    if token.kind == TokenKind::EndArray
      next_token
      @nesting = @nesting - 1
      return Any.new(ary)
    end

    while true
      ary << parse_value
      return Any.new(nil) unless @error.nil?
      case token.kind
      when TokenKind::Comma
        comma_line = token.line_number
        comma_col = token.column_number
        next_token
        if token.kind == TokenKind::EndArray
          return fail("trailing comma in array", comma_line, comma_col)
        end
      when TokenKind::EndArray
        break
      else
        return fail("expected ',' or ']' in array")
      end
    end

    next_token # ']'
    @nesting = @nesting - 1
    Any.new(ary)
  end

  private def parse_object : Any
    line = token.line_number
    col = token.column_number

    @nesting = @nesting + 1
    if @nesting > MAX_NESTING
      return fail("nesting depth of #{@nesting} exceeds maximum depth #{MAX_NESTING}", line, col)
    end

    next_token # '{'
    obj = {} of String => Any

    if token.kind == TokenKind::EndObject
      next_token
      @nesting = @nesting - 1
      return Any.new(obj)
    end

    while true
      unless token.kind == TokenKind::String
        return fail("expected string key in object")
      end
      key = token.string_value
      if obj.has_key?(key)
        return fail("duplicate key '#{key}'")
      end

      next_token # the key
      unless token.kind == TokenKind::Colon
        return fail("expected ':' after object key")
      end
      next_token # ':'

      obj[key] = parse_value
      return Any.new(nil) unless @error.nil?

      case token.kind
      when TokenKind::Comma
        comma_line = token.line_number
        comma_col = token.column_number
        next_token
        if token.kind == TokenKind::EndObject
          return fail("trailing comma in object", comma_line, comma_col)
        end
      when TokenKind::EndObject
        break
      else
        return fail("expected ',' or '}' in object")
      end
    end

    next_token # '}'
    @nesting = @nesting - 1
    Any.new(obj)
  end
end

# Reads a document one event at a time: `kind` names what the reader is on,
# the `read_x` methods take it and move on. The grammar is checked as it is
# read, so a missing comma or colon is refused where it is, with a panic.
pub class PullParser
  enum Kind
    Null
    Bool
    Int
    Float
    String
    BeginArray
    EndArray
    BeginObject
    EndObject
    EOF

    def null? : ::Bool
      self == Kind::Null
    end

    def bool? : ::Bool
      self == Kind::Bool
    end

    def int? : ::Bool
      self == Kind::Int
    end

    def float? : ::Bool
      self == Kind::Float
    end

    def string? : ::Bool
      self == Kind::String
    end

    def begin_array? : ::Bool
      self == Kind::BeginArray
    end

    def end_array? : ::Bool
      self == Kind::EndArray
    end

    def begin_object? : ::Bool
      self == Kind::BeginObject
    end

    def end_object? : ::Bool
      self == Kind::EndObject
    end

    def eof? : ::Bool
      self == Kind::EOF
    end
  end

  # Where the reader is inside the grammar, one entry per open container plus
  # the root: what may come next.
  ARRAY_FIRST  = 0 # after '[': a value or ']'
  ARRAY_VALUE  = 1 # after a value: ',' or ']'
  ARRAY_COMMA  = 2 # after ',': a value
  OBJECT_FIRST = 3 # after '{': a key or '}'
  OBJECT_KEY   = 4 # after a key: ':'
  OBJECT_COLON = 5 # after ':': a value
  OBJECT_VALUE = 6 # after a value: ',' or '}'
  OBJECT_COMMA = 7 # after ',': a key
  ROOT         = 8 # the document's one value
  ROOT_DONE    = 9 # after it: the end of the input

  @lexer : Lexer
  getter kind : Kind
  getter bool_value : Bool
  getter int_value : Int64
  getter float_value : Float64
  getter string_value : String
  @raw_input : String
  @raw_start : Int32
  @raw_size : Int32
  # The keys of the objects open on the way down (`read_object_key`).
  @keys : Array(String)
  property max_nesting : Int32
  @states : Array(Int32)

  def initialize(input : String)
    @lexer = Lexer.new(input)
    @kind = Kind::EOF
    @bool_value = false
    @int_value = 0_i64
    @float_value = 0.0
    @string_value = ""
    @raw_input = ""
    @raw_start = 0
    @raw_size = 0
    @keys = [] of String
    @max_nesting = MAX_NESTING
    @states = [ROOT]
    read_next
  end

  # The number the reader is on, as it was written.
  def raw_value : String
    @raw_input[@raw_start, @raw_size]
  end

  private def keep_raw(tok : Token) : Nil
    @raw_input = tok.raw_input
    @raw_start = tok.raw_start
    @raw_size = tok.raw_size
  end

  def line_number : Int32
    @lexer.token.line_number
  end

  def column_number : Int32
    @lexer.token.column_number
  end

  private def parse_error(reason : String) : NoReturn
    raise "#{reason} at line #{line_number}, column #{column_number}"
  end

  private def state : Int32
    @states.last
  end

  private def set_state(s : Int32) : Nil
    @states[@states.size - 1] = s
  end

  private def value_allowed : Nil
    st = state
    return if st == ARRAY_FIRST || st == ARRAY_COMMA || st == OBJECT_COLON || st == ROOT
    parse_error("unexpected value") if st == ARRAY_VALUE || st == OBJECT_VALUE || st == ROOT_DONE
    parse_error("expected string key in object") if st == OBJECT_FIRST || st == OBJECT_COMMA
    parse_error("expected ':' after object key")
  end

  private def after_value : Nil
    st = state
    if st == ARRAY_FIRST || st == ARRAY_COMMA
      set_state(ARRAY_VALUE)
    elsif st == OBJECT_COLON
      set_state(OBJECT_VALUE)
    else
      set_state(ROOT_DONE)
    end
  end

  private def open(container_state : Int32) : Nil
    value_allowed
    after_value
    if @states.size > @max_nesting
      parse_error("nesting depth of #{@states.size} exceeds maximum depth #{@max_nesting}")
    end
    @states << container_state
  end

  def read_next : Kind
    while true
      tok = @lexer.next_token
      case tok.kind
      when TokenKind::Error
        lexer_error = @lexer.error
        raise lexer_error unless lexer_error.nil?
        parse_error("malformed input")
      when TokenKind::Comma
        st = state
        if st == ARRAY_VALUE
          set_state(ARRAY_COMMA)
        elsif st == OBJECT_VALUE
          set_state(OBJECT_COMMA)
        else
          parse_error("unexpected ','")
        end
      when TokenKind::Colon
        parse_error("unexpected ':'") unless state == OBJECT_KEY
        set_state(OBJECT_COLON)
      when TokenKind::Null
        value_allowed
        after_value
        @kind = Kind::Null
        return @kind
      when TokenKind::True, TokenKind::False
        value_allowed
        after_value
        @kind = Kind::Bool
        @bool_value = tok.kind == TokenKind::True
        return @kind
      when TokenKind::Int
        value_allowed
        after_value
        @kind = Kind::Int
        @int_value = tok.int_value
        keep_raw(tok)
        return @kind
      when TokenKind::Float
        value_allowed
        after_value
        @kind = Kind::Float
        @float_value = tok.float_value
        keep_raw(tok)
        return @kind
      when TokenKind::String
        st = state
        if st == OBJECT_FIRST || st == OBJECT_COMMA
          set_state(OBJECT_KEY)
        else
          value_allowed
          after_value
        end
        @kind = Kind::String
        @string_value = tok.string_value
        return @kind
      when TokenKind::BeginArray
        open(ARRAY_FIRST)
        @kind = Kind::BeginArray
        return @kind
      when TokenKind::EndArray
        st = state
        parse_error("trailing comma in array") if st == ARRAY_COMMA
        parse_error("unexpected ']'") unless st == ARRAY_FIRST || st == ARRAY_VALUE
        @states.pop
        @kind = Kind::EndArray
        return @kind
      when TokenKind::BeginObject
        open(OBJECT_FIRST)
        @kind = Kind::BeginObject
        return @kind
      when TokenKind::EndObject
        st = state
        parse_error("trailing comma in object") if st == OBJECT_COMMA
        parse_error("expected ':' after object key") if st == OBJECT_KEY
        parse_error("expected value after ':'") if st == OBJECT_COLON
        parse_error("unexpected '}'") unless st == OBJECT_FIRST || st == OBJECT_VALUE
        @states.pop
        @kind = Kind::EndObject
        return @kind
      when TokenKind::EOF
        parse_error("empty JSON input") if state == ROOT
        parse_error("unexpected end of input") unless state == ROOT_DONE
        @kind = Kind::EOF
        return @kind
      end
    end
  end

  def read_begin_array : Nil
    parse_error("expected begin of array, got #{@kind}") unless @kind == Kind::BeginArray
    read_next
  end

  def read_end_array : Nil
    parse_error("expected end of array, got #{@kind}") unless @kind == Kind::EndArray
    read_next
  end

  def read_begin_object : Nil
    parse_error("expected begin of object, got #{@kind}") unless @kind == Kind::BeginObject
    read_next
  end

  def read_end_object : Nil
    parse_error("expected end of object, got #{@kind}") unless @kind == Kind::EndObject
    read_next
  end

  def read_object_key : String
    parse_error("expected object key string, got #{@kind}") unless @kind == Kind::String
    key = @string_value
    read_next
    key
  end

  def read_null : Nil
    parse_error("expected null, got #{@kind}") unless @kind == Kind::Null
    read_next
    nil
  end

  def read_bool : Bool
    parse_error("expected bool, got #{@kind}") unless @kind == Kind::Bool
    val = @bool_value
    read_next
    val
  end

  def read_int : Int64
    parse_error("expected int, got #{@kind}") unless @kind == Kind::Int
    val = @int_value
    read_next
    val
  end

  # A float, or an integer read as one.
  def read_float : Float64
    if @kind == Kind::Float
      val = @float_value
      read_next
      val
    elsif @kind == Kind::Int
      val = @int_value.to_f64
      read_next
      val
    else
      parse_error("expected float, got #{@kind}")
    end
  end

  def read_string : String
    parse_error("expected string, got #{@kind}") unless @kind == Kind::String
    val = @string_value
    read_next
    val
  end

  def read_array(& : -> Nil) : Nil
    read_begin_array
    while @kind != Kind::EndArray
      yield
    end
    read_end_array
  end

  # Yields each key of the object the reader is on, with the reader at its
  # value. A key named twice is refused, as `JSON.parse` refuses it.
  def read_object(& : String -> Nil) : Nil
    read_begin_object
    mark = @keys.size
    seen = nil.as(Hash(String, Bool)?)
    while @kind != Kind::EndObject
      key, seen = read_object_key(mark, seen)
      yield key
    end
    drop_keys(mark)
    read_end_object
  end

  # The key the reader is on, refused when this object already had it,
  # where the key is rather than where its value is. The keys of every
  # object open on the way down are one stack, each object's from its
  # mark: a hash per object was an allocation for every object read, where
  # an object has a few keys and a scan of them is cheaper than the hash.
  #
  # Past KEYS_SCANNED keys an object's are put in a hash, so an object
  # with thousands of keys is not a scan of all of them per key.
  KEYS_SCANNED = 32

  private def read_object_key(mark : Int32, seen : Hash(String, Bool)?) : {String, Hash(String, Bool)?}
    if @kind == Kind::String
      candidate = @string_value
      if seen
        parse_error("duplicate key '#{candidate}'") if seen.has_key?(candidate)
      else
        i = mark
        while i < @keys.size
          parse_error("duplicate key '#{candidate}'") if @keys[i] == candidate
          i = i + 1
        end
      end
    end
    key = read_object_key
    if seen
      seen[key] = true
    else
      @keys << key
      if @keys.size - mark > KEYS_SCANNED
        seen = {} of String => Bool
        i = mark
        while i < @keys.size
          seen[@keys[i]] = true
          i = i + 1
        end
      end
    end
    {key, seen}
  end

  private def drop_keys(mark : Int32) : Nil
    while @keys.size > mark
      @keys.pop
    end
  end

  # Passes over the value the reader is on, whole.
  def skip : Nil
    if @kind == Kind::BeginArray
      read_begin_array
      while @kind != Kind::EndArray
        skip
      end
      read_end_array
    elsif @kind == Kind::BeginObject
      read_object do |_key|
        skip
      end
    else
      read_next
    end
  end

  def read_null? : Bool
    if @kind == Kind::Null
      read_next
      true
    else
      false
    end
  end

  # Reads an object, yields once at the value of `key`, and skips the rest.
  def on_key(key : String, & : -> Nil) : Nil
    read_begin_object
    found = false
    mark = @keys.size
    seen = nil.as(Hash(String, Bool)?)
    while @kind != Kind::EndObject
      current_key, seen = read_object_key(mark, seen)
      if current_key == key
        found = true
        yield
      else
        skip
      end
    end
    drop_keys(mark)
    read_end_object
    parse_error("missing key #{key.inspect}") unless found
  end

  # The value the reader is on, as an `Any`.
  def read_any : Any
    if @kind == Kind::Null
      read_next
      Any.new(nil)
    elsif @kind == Kind::Bool
      Any.new(read_bool)
    elsif @kind == Kind::Int
      Any.new(read_int)
    elsif @kind == Kind::Float
      Any.new(read_float)
    elsif @kind == Kind::String
      Any.new(read_string)
    elsif @kind == Kind::BeginArray
      ary = [] of Any
      read_array do
        ary << read_any
      end
      Any.new(ary)
    elsif @kind == Kind::BeginObject
      obj = {} of String => Any
      read_object do |k|
        obj[k] = read_any
      end
      Any.new(obj)
    else
      parse_error("expected a value, got #{@kind}")
    end
  end

  # The value the reader is on, written into `json` as it is read. A number
  # is written as its own text, the text it was read from: rebuilt from the
  # Int64 or Float64 it parsed to, `12345678901234567890` came back as
  # `1.2345678901234567e+19` and `1E+2` as `100.0`, and a UInt64 id passed
  # through here did not read back as itself.
  def read_raw(json : Builder) : Nil
    if @kind == Kind::Null
      read_next
      json.null
    elsif @kind == Kind::Bool
      json.bool(read_bool)
    elsif @kind == Kind::Int || @kind == Kind::Float
      number_text = raw_value
      read_next
      json.raw(number_text)
    elsif @kind == Kind::String
      json.string(read_string)
    elsif @kind == Kind::BeginArray
      json.array do
        read_array do
          read_raw(json)
        end
      end
    elsif @kind == Kind::BeginObject
      json.object do
        read_object do |k|
          json.field(k)
          read_raw(json)
        end
      end
    else
      parse_error("expected a value, got #{@kind}")
    end
  end

  # The value the reader is on, as JSON text.
  def read_raw : String
    json = Builder.new
    read_raw(json)
    json.to_s
  end
end

# Writes a document one value at a time. `indent=` makes it pretty;
# `ascii_only=` escapes every non-ASCII code point.
pub class Builder
  # Where the writer is: what may be written next.
  ROOT         = 0
  ARRAY_FIRST  = 1
  ARRAY_NEXT   = 2
  OBJECT_FIRST = 3 # a key is due
  OBJECT_NEXT  = 4 # a key is due, after a value
  OBJECT_VALUE = 5 # a value is due, after its key
  ROOT_DONE    = 6

  @buffer : StringBuffer
  @indent_str : String?
  @level : Int32
  @states : Array(Int32)
  # The key texts of every object still open, innermost last, each with the
  # String it was written from.
  @keys : Array(Hash(String, String))

  property max_nesting : Int32
  property ascii_only : Bool

  def initialize
    @buffer = StringBuffer.new(64)
    @indent_str = nil
    @level = 0
    @states = [ROOT]
    @keys = [] of Hash(String, String)
    @max_nesting = MAX_NESTING
    @ascii_only = false
  end

  def indent=(spaces : Int32) : Nil
    @indent_str = spaces > 0 ? " " * spaces : nil
  end

  def indent=(str : String) : Nil
    @indent_str = str.empty? ? nil : str
  end

  private def state : Int32
    @states.last
  end

  private def set_state(s : Int32) : Nil
    @states[@states.size - 1] = s
  end

  private def write_indent : Nil
    if indent_str = @indent_str
      @buffer.append(10_u8) # '\n'
      i = 0
      while i < @level
        @buffer.append(indent_str)
        i = i + 1
      end
    end
  end

  private def before_value : Nil
    st = state
    if st == ROOT
      set_state(ROOT_DONE)
    elsif st == ARRAY_FIRST
      set_state(ARRAY_NEXT)
      write_indent
    elsif st == ARRAY_NEXT
      @buffer.append(44_u8) # ','
      write_indent
    elsif st == OBJECT_VALUE
      set_state(OBJECT_NEXT)
    elsif st == ROOT_DONE
      raise "a second value at the document root"
    else
      raise "a value where an object key is expected"
    end
  end

  def null : Nil
    before_value
    @buffer.append("null")
  end

  def bool(val : Bool) : Nil
    before_value
    @buffer.append(val ? "true" : "false")
  end

  def number(val : Int32) : Nil
    before_value
    @buffer.append(val.to_s)
  end

  def number(val : Int64) : Nil
    before_value
    @buffer.append(val.to_s)
  end

  def number(val : UInt8) : Nil
    before_value
    @buffer.append(val.to_s)
  end

  def number(val : UInt64) : Nil
    before_value
    @buffer.append(val.to_s)
  end

  def number(val : Float64) : Nil
    raise "NaN is not a JSON number" if val != val
    raise "#{val} is not a JSON number" if val.abs > 1.7976931348623157e308
    before_value
    @buffer.append(val.to_s)
  end

  # Text written as it is: the caller's own JSON.
  def raw(str : String) : Nil
    before_value
    @buffer.append(str)
  end

  def string(val : String) : Nil
    before_value
    write_escaped_string(val)
  end

  private def write_escaped_string(val : String) : Nil
    JSON.each_escaped_byte(val.to_unsafe, val.bytesize, @ascii_only) { |b| @buffer.append(b) }
  end

  def start_array : Nil
    before_value
    @buffer.append(91_u8) # '['
    @level = @level + 1
    raise "nesting depth of #{@level} exceeds maximum depth #{@max_nesting}" if @level > @max_nesting
    @states << ARRAY_FIRST
  end

  def end_array : Nil
    st = state
    raise "end_array without start_array" unless st == ARRAY_FIRST || st == ARRAY_NEXT
    @states.pop
    @level = @level - 1
    write_indent if st == ARRAY_NEXT
    @buffer.append(93_u8) # ']'
  end

  def array(& : -> Nil) : Nil
    start_array
    yield
    end_array
  end

  def start_object : Nil
    before_value
    @buffer.append(123_u8) # '{'
    @level = @level + 1
    raise "nesting depth of #{@level} exceeds maximum depth #{@max_nesting}" if @level > @max_nesting
    @states << OBJECT_FIRST
    @keys << Hash(String, String).new
  end

  def end_object : Nil
    st = state
    raise "end_object with a field's value still due" if st == OBJECT_VALUE
    raise "end_object without start_object" unless st == OBJECT_FIRST || st == OBJECT_NEXT
    @states.pop
    @keys.pop
    @level = @level - 1
    write_indent if st == OBJECT_NEXT
    @buffer.append(125_u8) # '}'
  end

  def object(& : -> Nil) : Nil
    start_object
    yield
    end_object
  end

  # A key; the value that follows it is written by the next call. A key
  # whose text is one this object already holds is refused, naming both:
  # the reader refuses a duplicate key, and the builder wrote one - a key
  # given twice, or two Strings whose bytes are not UTF-8 and are both
  # written as U+FFFD (`{"a\xFF" => 1, "a\xFE" => 2}` was written
  # `{"a\uFFFD":1,"a\uFFFD":2}`, and `JSON.parse` refused it).
  def field(name : String) : Nil
    st = state
    raise "a field outside an object" unless st == OBJECT_FIRST || st == OBJECT_NEXT
    @buffer.append(44_u8) if st == OBJECT_NEXT # ','
    set_state(OBJECT_VALUE)
    write_indent
    from = @buffer.size
    write_escaped_string(name)
    text = @buffer.slice_from(from)
    keys = @keys.last
    if earlier = keys[text]?
      raise "the key #{name.inspect} is written twice in one object" if earlier == name
      raise "the keys #{earlier.inspect} and #{name.inspect} are both written as #{text}"
    end
    keys[text] = name
    @buffer.append(58_u8)                         # ':'
    @buffer.append(32_u8) unless @indent_str.nil? # ' '
  end

  def field(name : String, & : -> Nil) : Nil
    field(name)
    yield
  end

  def field(name : String, val : Any) : Nil
    field(name)
    val.to_json(self)
  end

  def field(name : String, val : String) : Nil
    field(name)
    string(val)
  end

  def field(name : String, val : Int32) : Nil
    field(name)
    number(val)
  end

  def field(name : String, val : Int64) : Nil
    field(name)
    number(val)
  end

  def field(name : String, val : Float64) : Nil
    field(name)
    number(val)
  end

  def field(name : String, val : Bool) : Nil
    field(name)
    bool(val)
  end

  def field(name : String, val : Nil) : Nil
    field(name)
    null
  end

  # Whether no value has been written yet.
  def empty? : Bool
    state == ROOT
  end

  # The document's text. A container still open or no value written at all
  # is not a document, and is refused.
  def to_s : String
    st = state
    raise "to_s with an array still open" if st == ARRAY_FIRST || st == ARRAY_NEXT
    raise "to_s with an object still open" if st == OBJECT_FIRST || st == OBJECT_NEXT || st == OBJECT_VALUE
    raise "to_s with no value written" if st == ROOT
    @buffer.to_s
  end
end

# A document's state in a `TapeBuilder`, on the stack of `JSON.build`:
# the level, the count of keys of the open objects, then a state per level,
# the first key of each open object, and the keys as (start, size) spans of
# the output. Past `KEYS` keys open at once they go to the heap.
TAPE_STATES = MAX_NESTING + 2
TAPE_KEYS   = 128

# Writes a document into the caller's `TapeWriter`, as `Builder` writes one
# into a String: the same values, checks and escapes, and nothing on the
# heap. `JSON.build(writer) { |json| ... }` hands one.
@[OnTape]
pub struct TapeBuilder
  @out : TapeWriter
  @slots : Pointer(Int32)
  @keys : Pointer(Pointer(Int32))
  @indent : String?
  @ascii_only : Bool

  def initialize(@out : TapeWriter, @slots : Pointer(Int32), @keys : Pointer(Pointer(Int32)), @indent : String?, @ascii_only : Bool)
    @slots[0] = 0
    @slots[1] = 0
    @slots[2] = Builder::ROOT
  end

  private def level : Int32
    @slots[0]
  end

  private def state : Int32
    @slots[2 + level]
  end

  private def set_state(s : Int32) : Nil
    @slots[2 + level] = s
  end

  private def write_indent : Nil
    if indent = @indent
      @out.push(10_u8)
      i = 0
      while i < level
        @out.append(indent)
        i = i + 1
      end
    end
  end

  private def before_value : Nil
    st = state
    if st == Builder::ROOT
      set_state(Builder::ROOT_DONE)
    elsif st == Builder::ARRAY_FIRST
      set_state(Builder::ARRAY_NEXT)
      write_indent
    elsif st == Builder::ARRAY_NEXT
      @out.push(44_u8)
      write_indent
    elsif st == Builder::OBJECT_VALUE
      set_state(Builder::OBJECT_NEXT)
    elsif st == Builder::ROOT_DONE
      raise "a second value at the document root"
    else
      raise "a value where an object key is expected"
    end
  end

  def null : Nil
    before_value
    @out.append("null")
  end

  def bool(val : Bool) : Nil
    before_value
    @out.append(val ? "true" : "false")
  end

  def number(val : Int32) : Nil
    before_value
    @out.append_int(val)
  end

  def number(val : Int64) : Nil
    before_value
    @out.append_int(val)
  end

  def number(val : UInt8) : Nil
    before_value
    @out.append_int(val.to_i64)
  end

  def number(val : UInt64) : Nil
    before_value
    if val > 9223372036854775807_u64
      @out.append(val.to_s)
    else
      @out.append_int(val.to_i64)
    end
  end

  def number(val : Float64) : Nil
    raise "NaN is not a JSON number" if val != val
    raise "#{val} is not a JSON number" if val.abs > 1.7976931348623157e308
    before_value
    @out.append_float(val)
  end

  # Text written as it is: the caller's own JSON.
  def raw(str : String) : Nil
    before_value
    @out.append(str)
  end

  def raw(str : TapeString) : Nil
    before_value
    @out.append(str)
  end

  def string(val : String) : Nil
    before_value
    escaped(val.to_unsafe, val.bytesize)
  end

  def string(val : TapeString) : Nil
    before_value
    escaped(val.to_unsafe, val.bytesize)
  end

  private def escaped(bytes : Pointer(UInt8), size : Int32) : Nil
    JSON.each_escaped_byte(bytes, size, @ascii_only) { |b| @out.push(b) }
  end

  private def open(byte : UInt8, first : Int32) : Nil
    before_value
    @out.push(byte)
    depth = level + 1
    raise "nesting depth of #{depth} exceeds maximum depth #{MAX_NESTING}" if depth > MAX_NESTING
    @slots[0] = depth
    set_state(first)
    @slots[2 + TAPE_STATES + depth] = @slots[1]
  end

  def start_array : Nil
    open(91_u8, Builder::ARRAY_FIRST)
  end

  def end_array : Nil
    st = state
    raise "end_array without start_array" unless st == Builder::ARRAY_FIRST || st == Builder::ARRAY_NEXT
    @slots[0] = level - 1
    write_indent if st == Builder::ARRAY_NEXT
    @out.push(93_u8)
  end

  def array(& : -> Nil) : Nil
    start_array
    yield
    end_array
  end

  def start_object : Nil
    open(123_u8, Builder::OBJECT_FIRST)
  end

  def end_object : Nil
    st = state
    raise "end_object with a field's value still due" if st == Builder::OBJECT_VALUE
    raise "end_object without start_object" unless st == Builder::OBJECT_FIRST || st == Builder::OBJECT_NEXT
    @slots[1] = @slots[2 + TAPE_STATES + level]
    @slots[0] = level - 1
    write_indent if st == Builder::OBJECT_NEXT
    @out.push(125_u8)
  end

  def object(& : -> Nil) : Nil
    start_object
    yield
    end_object
  end

  # A key, refused when this object already holds its text, as `Builder`
  # refuses it. The object's keys are compared one by one: an object of
  # thousands of keys is better written with `Builder`.
  def field(name : String) : Nil
    key(name.to_unsafe, name.bytesize)
  end

  def field(name : TapeString) : Nil
    key(name.to_unsafe, name.bytesize)
  end

  private def key(bytes : Pointer(UInt8), size : Int32) : Nil
    st = state
    raise "a field outside an object" unless st == Builder::OBJECT_FIRST || st == Builder::OBJECT_NEXT
    @out.push(44_u8) if st == Builder::OBJECT_NEXT
    set_state(Builder::OBJECT_VALUE)
    write_indent
    from = @out.length
    escaped(bytes, size)
    length = @out.length - from
    text = @out.finish.to_unsafe
    keys = @keys.value
    i = @slots[2 + TAPE_STATES + level]
    count = @slots[1]
    while i < count
      if keys[2 * i + 1] == length && JSON.same?(text + keys[2 * i], text + from, length)
        written = String.new(length) { |target| target.copy_from(text + from, length) }
        name = String.new(size) { |target| target.copy_from(bytes, size) }
        raise "the key #{name.inspect} is written twice in one object" if JSON.utf8?(bytes, size)
        raise "the key #{name.inspect} is written as #{written}, as an earlier key was"
      end
      i = i + 1
    end
    if count >= TAPE_KEYS && (count & (count - 1)) == 0
      # Past the stack's room: the spans move to the heap, doubling.
      grown = Pointer(Int32).malloc((4 * count).to_u64)
      grown.copy_from(keys, 2 * count)
      @keys.value = grown
      keys = grown
    end
    keys[2 * count] = from
    keys[2 * count + 1] = length
    @slots[1] = count + 1
    @out.push(58_u8)
    @out.push(32_u8) unless @indent.nil?
  end

  def field(name : String | TapeString, & : -> Nil) : Nil
    field(name)
    yield
  end

  def field(name : String | TapeString, val : String) : Nil
    field(name)
    string(val)
  end

  def field(name : String | TapeString, val : TapeString) : Nil
    field(name)
    string(val)
  end

  def field(name : String | TapeString, val : Int32) : Nil
    field(name)
    number(val)
  end

  def field(name : String | TapeString, val : Int64) : Nil
    field(name)
    number(val)
  end

  def field(name : String | TapeString, val : Float64) : Nil
    field(name)
    number(val)
  end

  def field(name : String | TapeString, val : Bool) : Nil
    field(name)
    bool(val)
  end

  def field(name : String | TapeString, val : Nil) : Nil
    field(name)
    null
  end

  # The key the value at *index* of *doc* has, as `field` writes a key: a
  # copy from one document into another puts nothing on the tape but what
  # it writes. A key with an escape is decoded on the heap, so the check
  # for a repeat sees the key and not its spelling.
  def field(doc : TapeDocument, index : Int32) : Nil
    node = doc.tree[index]
    bytes = doc.input.to_unsafe + node.key_at
    if (node.flags & TapeNode::ESCAPED_KEY) == 0
      key(bytes, node.key_size)
    else
      field(JSON.decoded_s(TapeString.new(bytes, node.key_size)))
    end
  end

  # The value at *index* of *doc*, and all it holds, as the calls that
  # would write it: an object's fields through `field(doc, index)`.
  def value(doc : TapeDocument, index : Int32) : Nil
    node = doc.tree[index]
    case node.kind
    when TapeDocument::Kind::Null
      null
    when TapeDocument::Kind::Bool
      bool(node.payload != 0)
    when TapeDocument::Kind::Int
      number(node.payload)
    when TapeDocument::Kind::Float
      number(doc.float(index))
    when TapeDocument::Kind::String
      bytes = doc.input.to_unsafe + (node.payload >> 32)
      size = (node.payload & 0xFFFFFFFF).to_i32
      before_value
      if (node.flags & TapeNode::ESCAPED_TEXT) == 0
        escaped(bytes, size)
      else
        text = JSON.decoded_s(TapeString.new(bytes, size))
        escaped(text.to_unsafe, text.bytesize)
      end
    when TapeDocument::Kind::Array
      start_array
      doc.each(index) { |child| value(doc, child) }
      end_array
    else
      start_object
      doc.each(index) do |child|
        field(doc, child)
        value(doc, child)
      end
      end_object
    end
  end

  # Whether no value has been written yet.
  def empty? : Bool
    level == 0 && state == Builder::ROOT
  end

  # Refuses a document left unfinished, as `Builder#to_s` does.
  def finish : Nil
    st = state
    raise "build with an array still open" if st == Builder::ARRAY_FIRST || st == Builder::ARRAY_NEXT
    raise "build with an object still open" if st == Builder::OBJECT_FIRST || st == Builder::OBJECT_NEXT || st == Builder::OBJECT_VALUE
    raise "build wrote no value" if st == Builder::ROOT
  end
end

# One value of a `TapeDocument`, in 24 bytes: its kind and which of its
# texts hold an escape, the span of its key in the input, and its payload:
# an integer's or a bool's value, a float's bits, or a string's span (start
# in the high half, size in the low). Spans, not `TapeString`s, halve the
# stream: a parse writes it whole, past the tape's warm megabyte.
@[OnTape]
pub struct TapeNode
  ESCAPED_TEXT = 256
  ESCAPED_KEY  = 512

  @flags : Int32
  @key_at : Int32
  @key_size : Int32
  @payload : Int64

  def initialize(@flags : Int32, @key_at : Int32, @key_size : Int32, @payload : Int64)
  end

  def kind : TapeDocument::Kind
    TapeDocument::Kind.new(@flags & 255)
  end

  def flags : Int32
    @flags
  end

  def key_at : Int32
    @key_at
  end

  def key_size : Int32
    @key_size
  end

  def payload : Int64
    @payload
  end
end

# A document read by `JSON.parse(bytes : TapeString)`: every value in one
# `TapeStream` in document order, its strings spans of the input, all of it
# the caller's `Tape.scope`'s. A value is named by its index; the root's is
# 0. A string with an escape is decoded when it is asked for.
@[OnTape]
pub struct TapeDocument
  enum Kind
    Null
    Bool
    Int
    Float
    String
    Array
    Object
  end

  getter tree : TapeStream(TapeNode)
  getter input : TapeString

  def initialize(@tree : TapeStream(TapeNode), @input : TapeString)
  end

  def root : Int32
    0
  end

  def kind(index : Int32) : Kind
    @tree[index].kind
  end

  def bool(index : Int32) : Bool
    expect(index, Kind::Bool).payload != 0
  end

  def int(index : Int32) : Int64
    expect(index, Kind::Int).payload
  end

  # A float, or an integer as one.
  def float(index : Int32) : Float64
    node = @tree[index]
    return node.payload.to_f64 if node.kind == Kind::Int
    bits = expect(index, Kind::Float).payload
    pointerof(bits).as(Pointer(Float64)).value
  end

  def null?(index : Int32) : Bool
    @tree[index].kind == Kind::Null
  end

  # The string at *index*, decoded: the input's own bytes unless it holds
  # an escape, a new string on the tape if it does.
  def string(index : Int32) : TapeString
    node = expect(index, Kind::String)
    text = TapeString.new(@input.to_unsafe + (node.payload >> 32), (node.payload & 0xFFFFFFFF).to_i32)
    JSON.decoded(text, (node.flags & TapeNode::ESCAPED_TEXT) != 0)
  end

  # The key *index* has in its object, decoded as `string` is.
  def key(index : Int32) : TapeString
    node = @tree[index]
    JSON.decoded(TapeString.new(@input.to_unsafe + node.key_at, node.key_size), (node.flags & TapeNode::ESCAPED_KEY) != 0)
  end

  # The count of an array's values or an object's fields.
  def size(index : Int32) : Int32
    count = 0
    each(index) { count = count + 1 }
    count
  end

  # Each value of the array or object at *index*, by index.
  def each(index : Int32, & : Int32 -> _) : Nil
    kind = @tree[index].kind
    raise "#{kind} is not an array or an object" unless kind == Kind::Array || kind == Kind::Object
    @tree.each_child(index) { |child| yield child }
  end

  # The *nth* value of the array at *index*, or -1.
  def at(index : Int32, nth : Int32) : Int32
    expect(index, Kind::Array)
    found = -1
    seen = 0
    @tree.each_child(index) do |child|
      found = child if seen == nth
      seen = seen + 1
    end
    found
  end

  # The value of the field *name* of the object at *index*, or -1.
  def at(index : Int32, name : String) : Int32
    expect(index, Kind::Object)
    found = -1
    @tree.each_child(index) do |child|
      if found < 0
        node = @tree[child]
        key = @input.to_unsafe + node.key_at
        if (node.flags & TapeNode::ESCAPED_KEY) == 0
          found = child if node.key_size == name.bytesize && JSON.same?(key, name.to_unsafe, name.bytesize)
        elsif JSON.decoded_s(TapeString.new(key, node.key_size)) == name
          found = child
        end
      end
    end
    found
  end

  private def expect(index : Int32, kind : Kind) : TapeNode
    node = @tree[index]
    raise "expected #{kind}, not #{node.kind}" unless node.kind == kind
    node
  end
end

# Reads a document onto the tape for `JSON.parse(bytes : TapeString)`: the
# same grammar, limits and sentences as `Parser`, through the same lexer in
# its span mode, so that only the stream of values goes on the tape.
@[OnTape]
pub struct TapeParser
  @lexer : Lexer
  @input : TapeString
  @tree : TapeStream(TapeNode)
  @nesting : Int32
  @error : String?

  def initialize(@input : TapeString)
    @lexer = Lexer.spans(@input.to_unsafe, @input.bytesize)
    @tree = TapeStream(TapeNode).new(@input.bytesize // 16 + 8)
    @nesting = 0
    @error = nil
    @lexer.next_token
  end

  def error : String?
    @error
  end

  def document : TapeDocument
    TapeDocument.new(@tree, @input)
  end

  # The lexer back to the thread, for the next parse; this parser is done.
  def finish : Nil
    Lexer.give_back(@lexer)
  end

  private def token : Token
    @lexer.token
  end

  private def fail(reason : String, line : Int32, col : Int32) : Nil
    if @error.nil?
      lexer_error = @lexer.error
      @error = lexer_error.nil? ? "#{reason} at line #{line}, column #{col}" : lexer_error
    end
    nil
  end

  private def fail(reason : String) : Nil
    fail(reason, token.line_number, token.column_number)
  end

  private def text(at : Int32, size : Int32) : TapeString
    TapeString.new(@input.to_unsafe + at, size)
  end

  def parse : Nil
    return fail("empty JSON input", 1, 1) if token.kind == TokenKind::EOF
    parse_value(0, 0, 0)
    return unless @error.nil?
    fail("unexpected #{token_text} after JSON root value") unless token.kind == TokenKind::EOF
  end

  private def token_text : String
    case token.kind
    when TokenKind::BeginArray  then "'['"
    when TokenKind::BeginObject then "'{'"
    when TokenKind::EndArray    then "']'"
    when TokenKind::EndObject   then "'}'"
    when TokenKind::Colon       then "':'"
    when TokenKind::Comma       then "','"
    when TokenKind::True        then "'true'"
    when TokenKind::False       then "'false'"
    when TokenKind::Null        then "'null'"
    when TokenKind::EOF         then "end of input"
    when TokenKind::String      then "string"
    when TokenKind::Int, TokenKind::Float
      "number #{text(token.raw_start, token.raw_size).to_s}"
    else "value"
    end
  end

  private def leaf(kind : TapeDocument::Kind, flags : Int32, key_at : Int32, key_size : Int32, payload : Int64) : Nil
    @tree.leaf(TapeNode.new(kind.value | flags, key_at, key_size, payload))
    @lexer.next_token
  end

  # The value at the current token, in its object under the key at
  # *key_at* (*flags* saying whether it holds an escape).
  private def parse_value(flags : Int32, key_at : Int32, key_size : Int32) : Nil
    case token.kind
    when TokenKind::Null
      leaf(TapeDocument::Kind::Null, flags, key_at, key_size, 0_i64)
    when TokenKind::True
      leaf(TapeDocument::Kind::Bool, flags, key_at, key_size, 1_i64)
    when TokenKind::False
      leaf(TapeDocument::Kind::Bool, flags, key_at, key_size, 0_i64)
    when TokenKind::Int
      leaf(TapeDocument::Kind::Int, flags, key_at, key_size, token.int_value)
    when TokenKind::Float
      real = token.float_value
      leaf(TapeDocument::Kind::Float, flags, key_at, key_size, pointerof(real).as(Pointer(Int64)).value)
    when TokenKind::String
      flags = flags | TapeNode::ESCAPED_TEXT if token.escaped
      leaf(TapeDocument::Kind::String, flags, key_at, key_size, (token.raw_start.to_i64 << 32) | token.raw_size.to_i64)
    when TokenKind::BeginArray
      parse_array(flags, key_at, key_size)
    when TokenKind::BeginObject
      parse_object(flags, key_at, key_size)
    else
      fail("unexpected #{token_text}")
    end
  end

  private def nest : Bool
    @nesting = @nesting + 1
    return true if @nesting <= MAX_NESTING
    fail("nesting depth of #{@nesting} exceeds maximum depth #{MAX_NESTING}")
    false
  end

  private def parse_array(flags : Int32, key_at : Int32, key_size : Int32) : Nil
    return unless nest
    at = @tree.open(TapeNode.new(TapeDocument::Kind::Array.value | flags, key_at, key_size, 0_i64))
    @lexer.next_token # '['
    if token.kind == TokenKind::EndArray
      @lexer.next_token
    else
      while true
        parse_value(0, 0, 0)
        return unless @error.nil?
        if token.kind == TokenKind::Comma
          comma_line = token.line_number
          comma_col = token.column_number
          @lexer.next_token
          return fail("trailing comma in array", comma_line, comma_col) if token.kind == TokenKind::EndArray
        elsif token.kind == TokenKind::EndArray
          @lexer.next_token
          break
        else
          return fail("expected ',' or ']' in array")
        end
      end
    end
    @tree.close(at)
    @nesting = @nesting - 1
  end

  private def parse_object(flags : Int32, key_at : Int32, key_size : Int32) : Nil
    return unless nest
    at = @tree.open(TapeNode.new(TapeDocument::Kind::Object.value | flags, key_at, key_size, 0_i64))
    @lexer.next_token # '{'
    # Past this many keys, the object's are looked up in a hash rather
    # than compared one by one.
    seen = nil.as(Hash(String, Bool)?)
    count = 0
    if token.kind == TokenKind::EndObject
      @lexer.next_token
    else
      while true
        return fail("expected string key in object") unless token.kind == TokenKind::String
        name_at = token.raw_start
        name_size = token.raw_size
        name_flags = token.escaped ? TapeNode::ESCAPED_KEY : 0
        if (set = seen)
          name = key_s(name_at, name_size, name_flags)
          return fail("duplicate key '#{name}'") if set.has_key?(name)
          set[name] = true
        else
          return fail("duplicate key '#{key_s(name_at, name_size, name_flags)}'") if duplicate?(at, name_at, name_size, name_flags)
          if count == 32
            set = {} of String => Bool
            child = at + 1
            while child < @tree.size
              node = @tree[child]
              set[key_s(node.key_at, node.key_size, node.flags)] = true
              child = @tree.stop(child)
            end
            set[key_s(name_at, name_size, name_flags)] = true
            seen = set
          end
        end
        count = count + 1
        @lexer.next_token # the key
        return fail("expected ':' after object key") unless token.kind == TokenKind::Colon
        @lexer.next_token # ':'
        parse_value(name_flags, name_at, name_size)
        return unless @error.nil?
        if token.kind == TokenKind::Comma
          comma_line = token.line_number
          comma_col = token.column_number
          @lexer.next_token
          return fail("trailing comma in object", comma_line, comma_col) if token.kind == TokenKind::EndObject
        elsif token.kind == TokenKind::EndObject
          @lexer.next_token
          break
        else
          return fail("expected ',' or '}' in object")
        end
      end
    end
    @tree.close(at)
    @nesting = @nesting - 1
  end

  # The key at *at* decoded into a String.
  private def key_s(at : Int32, size : Int32, flags : Int32) : String
    JSON.decoded_s(text(at, size), (flags & TapeNode::ESCAPED_KEY) != 0)
  end

  # Whether the object opened at *at* already has a field with this key.
  private def duplicate?(at : Int32, key_at : Int32, key_size : Int32, flags : Int32) : Bool
    child = at + 1
    count = @tree.size
    bytes = @input.to_unsafe
    while child < count
      node = @tree[child]
      if ((flags | node.flags) & TapeNode::ESCAPED_KEY) == 0
        return true if node.key_size == key_size && JSON.same?(bytes + node.key_at, bytes + key_at, key_size)
      elsif key_s(node.key_at, node.key_size, node.flags) == key_s(key_at, key_size, flags)
        return true
      end
      child = @tree.stop(child)
    end
    false
  end
end

pub struct JSON
  # The document as an `Any`; panics with the line and column of the first
  # thing it refuses.
  def self.parse(input : String) : Any
    parser = Parser.new(input)
    result = parser.parse
    failure = parser.error
    raise failure unless failure.nil?
    result
  end

  # The document in *bytes* read onto the caller's tape, its strings views
  # into *bytes*; panics with the line and column of the first thing it
  # refuses, as `parse(String)` does.
  def self.parse(bytes : TapeString) : TapeDocument
    parser = TapeParser.new(bytes)
    parser.parse
    failure = parser.error
    raise failure unless failure.nil?
    parser.finish
    parser.document
  end

  # The document in *bytes* on the tape, or `nil` when it is not one.
  def self.parse?(bytes : TapeString) : TapeDocument?
    parser = TapeParser.new(bytes)
    parser.parse
    parser.finish
    return nil unless parser.error.nil?
    parser.document
  end

  # A document written into the caller's *writer* through a `TapeBuilder` the
  # block is handed, as `build` writes a String. Its state is on this
  # method's stack: the builder is not used after the block.
  def self.build(writer : TapeWriter, indent : String | Int32 | Nil = nil, ascii_only : Bool = false, & : TapeBuilder -> Nil) : Nil
    slots = uninitialized Int32[520]
    spans = uninitialized Int32[256]
    keys = pointerof(spans).as(Pointer(Int32))
    text = indent.is_a?(Int32) ? (indent.as(Int32) > 0 ? " " * indent.as(Int32) : nil) : indent.as(String?)
    text = nil if text && text.empty?
    builder = TapeBuilder.new(writer, pointerof(slots).as(Pointer(Int32)), pointerof(keys), text, ascii_only)
    yield builder
    builder.finish
  end

  # The bytes of a string as the lexer found them, decoded: themselves
  # when they hold no escape, else a new string on the tape.
  def self.decoded(text : TapeString, escaped : Bool) : TapeString
    return text unless escaped
    TapeString.build(text.bytesize) do |w|
      each_decoded_byte(text.to_unsafe, text.bytesize) { |b| w.push(b) }
    end
  end

  # The same decoded into a String.
  def self.decoded_s(text : TapeString, escaped : Bool = true) : String
    return text.to_s unless escaped
    buffer = StringBuffer.new(text.bytesize)
    each_decoded_byte(text.to_unsafe, text.bytesize) { |b| buffer.append(b) }
    buffer.to_s
  end

  # Each byte of a string's text whose escapes the lexer has checked,
  # decoded: `\uXXXX` (a surrogate pair into one code point) as UTF-8.
  def self.each_decoded_byte(bytes : Pointer(UInt8), size : Int32, & : UInt8 -> Nil) : Nil
    i = 0
    while i < size
      b = bytes[i]
      if b != 92_u8
        yield b
        i = i + 1
        next
      end
      esc = bytes[i + 1]
      i = i + 2
      if esc == 117_u8
        cp = hex4(bytes + i)
        i = i + 4
        if cp >= 0xD800 && cp <= 0xDBFF
          cp = 0x10000 + ((cp - 0xD800) << 10) + (hex4(bytes + i + 2) - 0xDC00)
          i = i + 6
        end
        if cp <= 0x7F
          yield cp.to_u8
        elsif cp <= 0x7FF
          yield (0xC0 | (cp >> 6)).to_u8
          yield (0x80 | (cp & 0x3F)).to_u8
        elsif cp <= 0xFFFF
          yield (0xE0 | (cp >> 12)).to_u8
          yield (0x80 | ((cp >> 6) & 0x3F)).to_u8
          yield (0x80 | (cp & 0x3F)).to_u8
        else
          yield (0xF0 | (cp >> 18)).to_u8
          yield (0x80 | ((cp >> 12) & 0x3F)).to_u8
          yield (0x80 | ((cp >> 6) & 0x3F)).to_u8
          yield (0x80 | (cp & 0x3F)).to_u8
        end
      elsif esc == 98_u8
        yield 8_u8
      elsif esc == 102_u8
        yield 12_u8
      elsif esc == 110_u8
        yield 10_u8
      elsif esc == 114_u8
        yield 13_u8
      elsif esc == 116_u8
        yield 9_u8
      else
        yield esc
      end
    end
  end

  # Whether *a* and *b* hold the same *size* bytes.
  def self.same?(a : Pointer(UInt8), b : Pointer(UInt8), size : Int32) : Bool
    i = 0
    while i < size
      return false if a[i] != b[i]
      i = i + 1
    end
    true
  end

  # Whether *bytes* are well-formed UTF-8.
  def self.utf8?(bytes : Pointer(UInt8), size : Int32) : Bool
    i = 0
    while i < size
      length = utf8_sequence_at(bytes, size, i)
      return false if length < 0
      i = i + length
    end
    true
  end

  private def self.hex4(p : Pointer(UInt8)) : Int32
    val = 0
    i = 0
    while i < 4
      c = p[i]
      d = c <= 57_u8 ? c.to_i - 48 : (c | 0x20_u8).to_i - 87
      val = (val << 4) | d
      i = i + 1
    end
    val
  end

  # Each byte of *bytes* written as a JSON string, quotes and all: the
  # escapes, control bytes as `\u00XX`, and bytes that are not a code
  # point as U+FFFD, one per ill-formed subpart, so what is written is
  # UTF-8 the reader takes back (RFC 8259 §8.1: a String holds any bytes,
  # a file name or a log line). Under *ascii_only* every code point past
  # ASCII is a `\uXXXX`, a surrogate pair past the basic plane.
  def self.each_escaped_byte(bytes : Pointer(UInt8), len : Int32, ascii_only : Bool, & : UInt8 -> Nil) : Nil
    yield 34_u8
    i = 0
    while i < len
      b = bytes[i]
      if b == 34_u8 || b == 92_u8
        yield 92_u8
        yield b
        i = i + 1
      elsif b >= 32_u8 && b < 127_u8
        yield b
        i = i + 1
      elsif b == 8_u8 || b == 12_u8 || b == 10_u8 || b == 13_u8 || b == 9_u8
        yield 92_u8
        yield (b == 8_u8 ? 98_u8 : b == 12_u8 ? 102_u8 : b == 10_u8 ? 110_u8 : b == 13_u8 ? 114_u8 : 116_u8)
        i = i + 1
      elsif b < 128_u8
        hex_u4(b.to_i) { |h| yield h }
        i = i + 1
      else
        length = utf8_sequence_at(bytes, len, i)
        if length < 0
          if ascii_only
            hex_u4(0xFFFD) { |h| yield h }
          else
            yield 0xEF_u8
            yield 0xBF_u8
            yield 0xBD_u8
          end
          i = i - length
        elsif !ascii_only
          while length > 0
            yield bytes[i]
            i = i + 1
            length = length - 1
          end
        elsif length == 2
          hex_u4(((b.to_i & 0x1F) << 6) | (bytes[i + 1].to_i & 0x3F)) { |h| yield h }
          i = i + 2
        elsif length == 3
          hex_u4(((b.to_i & 0x0F) << 12) | ((bytes[i + 1].to_i & 0x3F) << 6) | (bytes[i + 2].to_i & 0x3F)) { |h| yield h }
          i = i + 3
        else
          cp = ((b.to_i & 0x07) << 18) | ((bytes[i + 1].to_i & 0x3F) << 12) | ((bytes[i + 2].to_i & 0x3F) << 6) | (bytes[i + 3].to_i & 0x3F)
          sub = cp - 0x10000
          hex_u4(0xD800 + (sub >> 10)) { |h| yield h }
          hex_u4(0xDC00 + (sub & 0x3FF)) { |h| yield h }
          i = i + 4
        end
      end
    end
    yield 34_u8
  end

  private def self.hex_u4(val : Int32, & : UInt8 -> Nil) : Nil
    hex = "0123456789abcdef".to_unsafe
    yield 92_u8
    yield 117_u8
    yield hex[(val >> 12) & 0x0F]
    yield hex[(val >> 8) & 0x0F]
    yield hex[(val >> 4) & 0x0F]
    yield hex[val & 0x0F]
  end

  # The document as an `Any`, or `nil` when it is not one.
  def self.parse?(input : String) : Any?
    parser = Parser.new(input)
    result = parser.parse
    parser.error.nil? ? result : nil
  end

  # Text written through a `Builder` the block is handed. `indent` is a
  # count of spaces or the string one level is indented by. A block that
  # writes no value, or leaves a container open, is refused.
  def self.build(indent : String | Int32 | Nil = nil, & : Builder -> Nil) : String
    builder = Builder.new
    if indent.is_a?(Int32)
      builder.indent = indent.as(Int32)
    elsif indent.is_a?(String)
      builder.indent = indent.as(String)
    end
    yield builder
    raise "build wrote no value" if builder.empty?
    builder.to_s
  end

  # Any value `write_value` knows: `nil`, a `Bool`, a prelude integer, a
  # `Float64`, a `String`, an `Any`, an `Array` or `Hash` of those, or a type
  # that implements `ToJSON`; each of them or `nil`.
  def self.to_json(obj : T) : String forall T
    build do |b|
      write_or_null(obj, b)
    end
  end

  # A value that may be nil, written as `null` or as what it holds. Handed
  # to `write_value` whole, `Int32 | Nil` was matched against the `ToJSON`
  # overload as one type and refused at compile time, so
  # `JSON.to_json([1, nil] of Int32?)` and a `Hash(String, String?)` did not
  # build; with the nil taken out here the rest dispatches as it would alone.
  private def self.write_or_null(val, b : Builder) : Nil
    if val.nil?
      b.null
    else
      write_value(val, b)
    end
  end

  def self.write_value(val : Nil, b : Builder) : Nil
    b.null
  end

  def self.write_value(val : Bool, b : Builder) : Nil
    b.bool(val)
  end

  def self.write_value(val : Int32, b : Builder) : Nil
    b.number(val)
  end

  def self.write_value(val : Int64, b : Builder) : Nil
    b.number(val)
  end

  def self.write_value(val : UInt8, b : Builder) : Nil
    b.number(val)
  end

  def self.write_value(val : UInt64, b : Builder) : Nil
    b.number(val)
  end

  def self.write_value(val : Float64, b : Builder) : Nil
    b.number(val)
  end

  def self.write_value(val : String, b : Builder) : Nil
    b.string(val)
  end

  def self.write_value(val : Any, b : Builder) : Nil
    val.to_json(b)
  end

  def self.write_value(val : Array(T), b : Builder) : Nil forall T
    b.array do
      val.each { |e| write_or_null(e, b) }
    end
  end

  # A String key is written as it is, and two of them are never one text.
  def self.write_value(val : Hash(String, V), b : Builder) : Nil forall V
    b.object do
      val.each do |k, v|
        b.field(k)
        write_or_null(v, b)
      end
    end
  end

  # Any other key is written by its `to_s`, `nil` as `"null"`, the word a
  # JSON null is, so two keys can be one text: `{nil => 1, "null" => 2}`
  # was written `{"null":1,"null":2}`, which `JSON.parse` refuses
  # ("duplicate key 'null' at line 1, column 11"). The texts written are
  # kept, and a repeat is refused, naming both keys.
  def self.write_value(val : Hash(K, V), b : Builder) : Nil forall K, V
    written = Hash(String, K).new
    b.object do
      val.each do |k, v|
        text = key_text(k)
        raise "the keys #{written[text].inspect} and #{k.inspect} are both written as #{text.inspect}" if written.has_key?(text)
        written[text] = k
        b.field(text)
        write_or_null(v, b)
      end
    end
  end

  private def self.key_text(key : Nil) : String
    "null"
  end

  private def self.key_text(key : String) : String
    key
  end

  private def self.key_text(key) : String
    key.to_s
  end

  def self.write_value(val : T, b : Builder) : Nil forall T : ToJSON
    val.to_json(b)
  end

  # The document read into `type`: `Nil`, `Bool`, `Int32`, `Int64`, `UInt8`,
  # `UInt64`, `Float64`, `String`, `Any`, a type with `derive serializable`,
  # one of those or `nil`, or an `Array` or `Hash(String, V)` of those. An
  # integer outside the type is refused, as is anything after the root
  # value.
  def self.from_json(str : String, type : T.class) : T forall T
    pull = PullParser.new(str)
    value = read_value(pull, type)
    raise "unexpected value after JSON root value at line #{pull.line_number}, column #{pull.column_number}" unless pull.kind.eof?
    value
  end

  def self.read_value(pull : PullParser, type : Nil.class) : Nil
    pull.read_null
  end

  def self.read_value(pull : PullParser, type : Bool.class) : Bool
    pull.read_bool
  end

  def self.read_value(pull : PullParser, type : Int32.class) : Int32
    v = pull.read_int
    raise "integer #{v} out of Int32 range" if v < -2147483648_i64 || v > 2147483647_i64
    v.to_i32
  end

  def self.read_value(pull : PullParser, type : Int64.class) : Int64
    pull.read_int
  end

  def self.read_value(pull : PullParser, type : UInt8.class) : UInt8
    v = pull.read_int
    raise "integer #{v} out of UInt8 range" if v < 0_i64 || v > 255_i64
    v.to_u8
  end

  # An integer past Int64 reaches the reader as a float that still carries
  # its digits; those are read here, so the whole UInt64 range comes back.
  def self.read_value(pull : PullParser, type : UInt64.class) : UInt64
    if pull.kind.int?
      v = pull.read_int
      raise "integer #{v} out of UInt64 range" if v < 0_i64
      return v.to_u64
    end
    raw = pull.raw_value
    if pull.kind.float? && integer_digits?(raw)
      v = digits_to_u64?(raw) || raise "integer #{raw} out of UInt64 range"
      pull.read_next
      return v
    end
    pull.read_int.to_u64
  end

  # Whether the number's text is an integer literal: an optional minus and
  # digits, no fraction or exponent.
  private def self.integer_digits?(raw : String) : Bool
    bytes = raw.to_unsafe
    i = bytes[0] == 45_u8 ? 1 : 0
    return false if i >= raw.bytesize
    while i < raw.bytesize
      return false unless bytes[i] >= 48_u8 && bytes[i] <= 57_u8
      i = i + 1
    end
    true
  end

  # The UInt64 these digits spell, or nil when they do not fit.
  private def self.digits_to_u64?(raw : String) : UInt64?
    bytes = raw.to_unsafe
    return nil if bytes[0] == 45_u8
    val = 0_u64
    i = 0
    while i < raw.bytesize
      d = (bytes[i] - 48_u8).to_u64
      return nil if val > 1844674407370955161_u64 || (val == 1844674407370955161_u64 && d > 5_u64)
      val = val * 10_u64 + d
      i = i + 1
    end
    val
  end

  def self.read_value(pull : PullParser, type : Float64.class) : Float64
    pull.read_float
  end

  def self.read_value(pull : PullParser, type : String.class) : String
    pull.read_string
  end

  def self.read_value(pull : PullParser, type : Any.class) : Any
    pull.read_any
  end

  def self.read_value(pull : PullParser, type : Array(T).class) : Array(T) forall T
    ary = [] of T
    pull.read_begin_array
    while !pull.kind.end_array?
      ary << read_value(pull, T)
    end
    pull.read_end_array
    ary
  end

  def self.read_value(pull : PullParser, type : Hash(String, V).class) : Hash(String, V) forall V
    h = Hash(String, V).new
    pull.read_object do |k|
      h[k] = read_value(pull, V)
    end
    h
  end

  # A type that reads itself: the `initialize(pull)` a `derive
  # serializable` wrote. A type that admits nil reads `null` as the nil and
  # anything else as the other type (`x || raise`, as the derive asks it),
  # the way `write_or_null` writes it. That was `T.new(pull)` too, and
  # `Int32 | Nil` has no such `new`, so `JSON.from_json("5", Int32?)` and
  # `Array(Int32?)` did not build.
  def self.read_value(pull : PullParser, type : T.class) : T forall T
    {% if T.nilable? %}
      pull.read_null? ? nil : read_value(pull, typeof(nil.as(T) || raise("")))
    {% else %}
      T.new(pull)
    {% end %}
  end
end
