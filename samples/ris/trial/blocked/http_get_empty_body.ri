# HTTP.get answers status and headers (Content-Length: 5) but an empty body.
module samples/trial/blocked/http_get_empty_body

import std/socket::{IyiSocket}
import std/http::{Server, Incoming, Outgoing, HTTP}

struct Ready
end

struct Handler
  def initialize(config : Int32)
  end

  def listening(port : Int32) : Nil
    RisBoard.post(Ready.new)
  end

  def call(req : Incoming, res : Outgoing) : Nil
    res.body << "hello"
  end
end

group do |g|
  g.spawn do
    Server.answer("127.0.0.1", 18099, 0, Handler, max_connections: 1)
    0
  end
  RisBoard.take(Ready).or_panic
  response = HTTP.get("http://127.0.0.1:18099/").or_panic
  puts response.headers["Content-Length"]
  puts response.body.bytesize
  exit 0
end
