module test/ris/inbox_early

observed = false
group do |g|
  w = g.new_worker(Int32, 1) do |q|
    result = q.receive(10000)
    raise "early cancel" unless result.is_a?(Cancelled)
    observed = true
    nil
  end
  g.spawn do
    sleep(1)
    g.cancel_children
    nil
  end
end
raise "cancelled worker joined" unless observed

# Cancellation during ordered drain must wake later workers too.
second_cancelled = false
group do |g|
  g.new_worker(Int32, 1) do |q|
    raise "first closes" unless q.receive.is_a?(RisInbox::Closed)
    g.cancel_children
    nil
  end
  g.new_worker(Int32, 1) do |q|
    raise "second cancelled" unless q.receive.is_a?(Cancelled)
    second_cancelled = true
    nil
  end
end
raise "drain cancellation joined" unless second_cancelled
# A returned failure during drain switches to cancellation as well.
failure_cancelled = false
group do |g|
  g.new_worker(Int32, 1) do |q|
    raise "failure worker close" unless q.receive.is_a?(RisInbox::Closed)
    RisInbox::Full.new
  end
  g.new_worker(Int32, 1) do |q|
    raise "failure cancels peer" unless q.receive.is_a?(Cancelled)
    failure_cancelled = true
    nil
  end
end
raise "failure peer joined" unless failure_cancelled

group do |outer|
  notify = outer.new_inbox(Int32, 1)
  group do |g|
    g.new_worker(Int32, 1) do |q|
      raise "break cancels worker" unless q.receive.is_a?(Cancelled)
      notify.send(1)
      nil
    end
    break nil
  end
  raise "break joined worker" unless notify.receive(0) == 1
end
puts "PASS: inbox early"
