# request: one HTTP request in, one response out, all on one tape.
#
#   ./bin/ris run samples/ris/request.ri
#
# The request's bytes, the parsed head and the response are made inside
# `tape do ... end` and freed together when it ends: nothing to collect.
# This parser example has no listener or spawned task. Its users table
# stays on the caller's tape.

module samples/request

import std/http::{Server, ParsedHead, Field}

@[OnTape]
struct User
  getter id : Int32
  getter name : String
  def initialize(@id, @name)
  end
end

USERS = Array(User){User.new(42, "alice"), User.new(7, "bob")}

# GET /users/42 -> 200 {"id":42,"name":"alice"}
# The body is written into the caller's writer, on its tape.
def route(head : ParsedHead, body : String::Builder) : Int32
  path = head.target
  return 405 unless head.method == "GET"
  if path == "/"
    body << "Hello"
    return 200
  end
  return 404 unless path.starts_with?("/users/")
  id = path[7..].to_i? || return 404
  user = USERS.find { |user| user.id == id } || return 404
  name = user.name
  body << %({"id":) << id << %(,"name":") << name << %("})
  200
end

def reason(status : Int32) : String
  case status
  when 200 then "OK"
  when 404 then "Not Found"
  when 405 then "Method Not Allowed"
  else          "Bad Request"
  end
end

def handle(raw : String) : Nil
  tape do
    head = Server.parse_head(raw, 0, true, Array(Field).new(16))
    unless head.is_a?(ParsedHead)
      puts "400 Bad Request"
      return
    end
    body = String::Builder.new
    status = route(head, body)
    puts "#{status} #{reason(status)} #{body.finish}"
  end
end

handle("GET / HTTP/1.1\r\nHost: localhost\r\n\r\n")
handle("GET /users/42 HTTP/1.1\r\nHost: localhost\r\n\r\n")
handle("GET /users/9 HTTP/1.1\r\nHost: localhost\r\n\r\n")
handle("POST /users/42 HTTP/1.1\r\nHost: localhost\r\n\r\n")
handle("not http")
