module test/ini_tape

import std/ini::{INI}

kept = Hash(String, Hash(String, String)).new
tape do
  doc = INI.parse("\uFEFFtop=yes\r\n[s]\na = café\n[s]\na=last\n")
  exit 1 unless doc[""]["top"] == "yes"
  exit 2 unless doc["s"]["a"] == "last"
  w = String::Builder.new(1)
  w << "prefix:"
  INI.build(doc, w, true)
  exit 3 unless w.finish == "prefix:top = yes\n[s]\na = last\n\n"
  exit 4 unless INI.parse(INI.build(doc)) == doc
  spaced = INI.parse("x=\u00A0café\u3000\n")
  exit 7 unless spaced[""]["x"] == "café"
  kept = doc.copy_to(Program.tape)
end
exit 5 unless INI.parse(INI.build(kept)) == kept
exit 6 unless INI.parse("").empty?
puts "PASS: ini tape Hash and retained copy"
