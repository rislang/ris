# logline: a million log lines through `IOBackend` and the default
# formatter, to /dev/null. Prints the line count; report tape memory
# with RIS_TAPE_STATS=1 and time it from outside.
#
#   ./bin/ris build --release -o logline samples/ris/logline.ri && ./logline

module samples/logline

import std/log::{Logger, IOBackend, Severity}

N = 1000000
sink = File.open("/dev/null", "w", owner: Program.tape)
log = Logger.on_program("web", Severity::Info, IOBackend.on_program(sink))
i = 0
while i < N
  log.info("GET /users/42 200")
  i += 1
end
puts "#{N} lines"
