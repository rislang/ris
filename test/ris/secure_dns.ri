module test/secure_dns

import std/secure_dns::{DnsOverHttps, DnsOverTls}
import std/dns::{DnsError}
import std/socket::{DnsUpstream, IPAddress, Resolver}
import std/tls::{TlsConfig}
import std/x509::{RisCertificateStore, Certificate}

# std/secure_dns on the caller's tape against bench/std_secure_dns_server.py
# on loopback (its directory the first argument): a resolver asking DNS
# over TLS, then DNS over HTTPS by POST and GET. Each upstream connects
# by address and looks nothing up, so no exchange calls back into the
# resolver that asks it (SPEC 3.5).

dir = Program.arguments[0]
roots_store = RisCertificateStore.new
root_error = roots_store.read_pem(File.read("#{dir}/ca.pem"))
raise root_error.message if root_error
roots = roots_store.kept_certificates
raise "ca.pem" unless roots.is_a?(Array(Certificate))
dot_port = File.read("#{dir}/dot.port").as_tape.strip.to_i
doh_port = File.read("#{dir}/doh.port").as_tape.strip.to_i

def config(roots : Array(Certificate)) : TlsConfig
  made = TlsConfig.new
  made.roots = roots
  made.alpn = ["http/1.1"]
  made
end

def ask(resolver : Resolver, name : String) : Nil
  got = resolver.resolve(name)
  if got.is_a?(Array(IPAddress))
    puts "#{name} #{got.map(&.to_s).join(" ")}"
  elsif got.is_a?(DnsError)
    puts "#{name} failed: not found #{got.not_found?}"
  else
    puts "#{name} cancelled"
  end
end

tape do
  dot = DnsOverTls.new("dns.test", "127.0.0.1", dot_port, config(roots))
  resolver = Resolver.new
  resolver.read_system
  resolver.encrypt([dot] of DnsUpstream)
  ask(resolver, "a.zone.test")
  ask(resolver, "dual.zone.test")
  puts "dot connections #{dot.connections_made}"
  resolver.close
end

tape do
  url = "https://dns.test:#{doh_port}/dns-query"
  post = DnsOverHttps.new(url, "127.0.0.1", config(roots))
  resolver = Resolver.new
  resolver.read_system
  resolver.encrypt([post] of DnsUpstream)
  ask(resolver, "a.zone.test")
  ask(resolver, "six.zone.test")
  puts "post connections #{post.connections_made} reused #{post.connections_reused}"
  resolver.close
  get = DnsOverHttps.new(url, "127.0.0.1", config(roots), "GET")
  resolver.read_system
  resolver.encrypt([get] of DnsUpstream)
  ask(resolver, "dual.zone.test")
  ask(resolver, "missing.zone.test")
  resolver.close
  # The URL's host an address: nothing to bootstrap; the certificate
  # names 127.0.0.1 too.
  bare = DnsOverHttps.new("https://127.0.0.1:#{doh_port}/dns-query", nil, config(roots))
  resolver.read_system
  resolver.encrypt([bare] of DnsUpstream)
  ask(resolver, "alias.zone.test")
  resolver.close
end
