/.build20/
/.build23/
/docs/
/man/

# Spec artifacts
/spec/manual/dwarf/

# CI
/coverage/
/tmp/
/.junit/

# Devenv

# direnv
.direnv

# pre-commit
.pre-commit-config.yaml

# Python bytecode from bench helpers
__pycache__/
*.pyc

# The VS Code extension's build products; the source is three files.
/editors/vscode/node_modules/
/editors/vscode/*.vsix

# Editor-local configuration: a serverPath is one machine's, not the tree's.
/.vscode/


# The compiler's local cache when IYI_CACHE_DIR is unset.
/.iyi/

# ris: scripts/spec-par.sh
/spec-out/
/spec-build.log

# ris: the bench scripts' work directories, so the probes they write are
# std's exercises under bench/ (FfiBoundaryChecker).
/bench/.work/

# ris: EGM drift reports are worksheets, not committed.
/*_DRIFT_REPORT.md
