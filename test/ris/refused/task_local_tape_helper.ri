# A helper def that spawns into a group it was handed, called inside a
# `local_tape`: the task's captures are on the local tape, freed before
# the group joins. The lexical check cannot see the spawn here.
def start(g, n : Int64)
  g.spawn do
    sleep 0
    puts "task reads #{n}"
  end
end

def via(g, n : Int64)
  start(g, n)
end

def run
  group do |g|
    local_tape do
      via(g, 42_i64)
    end
  end
end
run
