# iyi: the rest of `Bool`, added to the prelude's.
#
# The prelude gives `Bool` its literals, `!`, `==`, `&&`/`||` and `to_s`.
# This module adds the eager operators `|`, `&` and `^` (both sides are
# evaluated; `&&`/`||` are the short-circuit ones), `to_unsafe` for the 1
# or 0 a foreign interface wants, the `io` spelling of `to_s`, `clone`,
# and a `hash` that tells true from false so both can be keys in one
# `Hash` (the prelude's `Object#hash` answers the type's id for both).
#
# There is no ordering. A Bool is a truth, not a number; `false < true` is
# a convention some languages adopt and nothing in the prelude records.
# A program that wants to sort by a Bool sorts by `to_unsafe`.

@[NoSpec("std API predates spec-required; proofs follow")]
module std/bool

struct ::Bool
  # `self` or `other`, both evaluated.
  def |(other : Bool) : Bool
    self ? true : other
  end

  # `self` and `other`, both evaluated.
  def &(other : Bool) : Bool
    self ? other : false
  end

  # Exactly one of the two.
  def ^(other : Bool) : Bool
    self != other
  end

  # 1 for true, 0 for false.
  def to_unsafe : Int32
    self ? 1 : 0
  end

  def to_s(io : IyiIO) : Nil
    io.print(to_s)
  end

  def clone : Bool
    self
  end

  # Two different numbers, so `{true => .., false => ..}` has two keys.
  def hash : Int32
    self ? 1231 : 1237
  end
end

# bool.1 The | and & operators evaluate both operands and return Boolean
#   disjunction and conjunction; ^ is true exactly when the operands differ.
spec bool.1
  (true | false) == true
  (false | false) == false
  (true & false) == false
  (true & true) == true
  (true ^ true) == false
  (true ^ false) == true
end

# bool.2 to_unsafe returns Int32 1 for true and 0 for false; clone returns the
#   same Boolean value.
spec bool.2
  true.to_unsafe == 1
  false.to_unsafe == 0
  true.clone == true
  false.clone == false
end

# bool.3 to_s(io) writes the same text as the prelude to_s; hash is 1231 for
#   true and 1237 for false.
spec bool.3
  true.hash != false.hash
  true.hash == true.hash
  true.hash == 1231
  false.hash == 1237
end
