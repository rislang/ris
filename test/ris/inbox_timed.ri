module test/ris/inbox_timed

group do |g|
  q = g.new_inbox(Int32, 2)
  raise "poll" unless q.receive(0).is_a?(TimedOut)
  before = __iyi_monotonic_ns
  result = q.receive(5)
  raise "timeout" unless result.is_a?(TimedOut)
  raise "monotonic deadline" unless __iyi_monotonic_ns - before >= 5000000
  raise "timeout message" unless result.is_a?(TimedOut) &&
    result.message == "timed out"
  g.spawn do
    sleep(1)
    q.send(17)
    nil
  end
  raise "timed wake" unless q.receive(1000) == 17
  # A removed timer must not wake a later, unrelated wait.
  raise "stale data timer" if IyiScheduler.sleeping?(IyiScheduler.current)
  sleep(2)
  q.send(23)
  q.close
  raise "data before closed and timeout" unless q.receive(0) == 23
  raise "closed before timeout" unless q.receive(0).is_a?(RisInbox::Closed)
  closing = g.new_inbox(Int32, 1)
  g.spawn do
    sleep(1)
    closing.close
    nil
  end
  raise "timed close wake" unless closing.receive(1000).is_a?(RisInbox::Closed)
  raise "stale close timer" if IyiScheduler.sleeping?(IyiScheduler.current)
end

group do |g|
  t = g.spawn do
    q = g.new_inbox(Int32, 2)
    q.send(31)
    q.close
    g.cancel_children
    raise "cancel before data" unless q.receive(0).is_a?(Cancelled)
    raise "cancel preserves data" unless q.size == 1
    nil
  end
  t.value
end
puts "PASS: inbox timed"
