# serve: a server's cost per request, measured on loopback. A client sends
# N keep-alive requests at once and reads the N answers: a small JSON body
# and a header of the block's own. Prints the requests and the bytes the
# GC heap took per request, collection off; time it from outside, with
# `gc` for the collector on as a server runs it.
#
#   ./bin/ris build --release -o serve samples/ris/serve.ri
#   ./serve           # Server.serve: Request in, Response out, on the heap
#   ./serve answer    # Server.answer: read and written on the tape
#   /usr/bin/time -f '%e s %M KB' ./serve answer gc

module samples/serve

import std/socket::{IyiSocket}
import std/http::{Server, Request, Response, Incoming, Outgoing}
import std/gc::{GC}

N = 200000
REQUEST = "GET /users/42?full=1 HTTP/1.1\r\nHost: localhost\r\nUser-Agent: bench\r\nAccept: */*\r\n\r\n"
BODY = %({"id":42,"name":"Mari","email":"mari@example.com"})

# The answers read into one buffer, so the client puts nothing on the heap
# and what is counted is the server's.
def drain(socket : IyiSocket, want : Int64) : Int64
  buffer = Pointer(UInt8).malloc(65536)
  got = 0_i64
  while got < want
    n = socket.read(buffer, 65536).or_panic
    break if n == 0
    got += n
  end
  got
end

on_tape = Program.args.includes?("answer")
reply = Server.format_response(Response.new(200, BODY, {"Content-Type" => "application/json"}), false, false)
want = reply.bytesize.to_i64 * N
listener = IyiSocket.listen(0)
batch = REQUEST * 1000
collecting = Program.args.includes?("gc")
GC.disable unless collecting
before = GC.stats.bytes_since_collection
got = 0_i64
group do |g|
  g.spawn do
    if on_tape
      Server.answer(listener) do |req, res|
        res.header("Content-Type", "application/json")
        res.body.append(BODY)
      end
    else
      Server.serve(listener) { |req| Response.new(200, BODY, {"Content-Type" => "application/json"}) }
    end
    0
  end
  client = IyiSocket.connect("127.0.0.1", listener.local_port).or_panic
  reader = g.spawn { drain(client, want) }
  (N // 1000).times { client.write(batch).or_panic }
  got = reader.value
  client.close
  listener.close
end
raise "read #{got} of #{want} bytes" unless got == want
if collecting
  puts "#{N} requests"
else
  puts "#{N} requests, #{(GC.stats.bytes_since_collection - before) // N.to_u64} heap bytes a request"
end
