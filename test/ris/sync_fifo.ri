module test/ris/sync_fifo

def cancel(task : IyiTask(T)) : Nil forall T
  IyiSchedLock.lock
  IyiScheduler.cancel(task.fiber)
  IyiSchedLock.unlock
end

group do |g|
  s = g.new_semaphore(1)
  s.acquire
  order = g.new_inbox(Int32, 8)
  4.times do |i|
    g.spawn do
      raise "queued acquire" unless s.acquire.nil?
      order.send(i)
      s.release
      nil
    end
    sleep(1)
  end
  s.release
  raise "newcomer barged" unless s.acquire(0).is_a?(TimedOut)
  4.times do |i|
    raise "FIFO" unless order.receive == i
  end
end

group do |g|
  s = g.new_semaphore(1)
  s.acquire
  first = g.spawn do
    raise "cancelled acquire" unless s.acquire.is_a?(Cancelled)
    nil
  end
  sleep(1)
  next_task = g.spawn do
    raise "successor" unless s.acquire(1000).nil?
    s.release
    nil
  end
  sleep(1)
  # Ready the head, then cancel before its acquisition commits.
  s.release
  cancel(first)
  first.value
  next_task.value
  raise "cancel consumed permit" unless s.acquire(0).nil?
  s.release
end

group do |g|
  s = g.new_semaphore(1)
  s.acquire
  timed = g.spawn do
    raise "queued timeout" unless s.acquire(2).is_a?(TimedOut)
    nil
  end
  sleep(1)
  next_task = g.spawn do
    raise "timed successor" unless s.acquire(1000).nil?
    s.release
    nil
  end
  timed.value
  s.release
  next_task.value
  raise "timeout consumed permit" unless s.acquire(0).nil?
  s.release
end

group do |g|
  e = g.new_event
  task = g.spawn do
    raise "event cancellation" unless e.wait.is_a?(Cancelled)
    nil
  end
  sleep(1)
  g.cancel_children
  task.value
end
puts "PASS: sync fifo"
