module test/base32_driver

import std/base32::{Base32, Base32Hex, Base32Error}

kept = ""
tape do
  text = "foobar"
  encoded = Base32.encode(text)
  decoded = Base32.decode(encoded)
  w = String::Builder.new(1)
  w << "prefix:"
  Base32.encode("f", w, false)
  Base32Hex.decode("CO======", w)
  kept = encoded.copy_to(Program.tape)
end
puts "PASS: base32 views and owned copy"
