# Cookies (RFC 6265), for both ends of std/http: `Cookie` reads a
# `Set-Cookie` line as a user agent reads one and writes one as a server
# writes one, and `CookieJar` is the client's store, handed to
# `HTTP.request(..., jar: jar)` (it is std/http's `CookieStore`).
#
# A line is read as §5.2 has it: a name and value, then attributes in
# any case, an unknown one passed over, `Expires` in any of RFC 9110's
# three date forms, `Max-Age` before `Expires` (§5.3, step 3), a
# `Domain`'s leading dot dropped. A line without a name-value pair is no
# cookie. A server's line is refused, with the byte that would break it,
# when its name is not a token or its value holds what a cookie-octet
# cannot (§4.1.1): a space, a comma, a semicolon, a backslash, a quote.
#
# The jar matches a request as §5.4 does - domain, path at a slash, not
# lapsed - sends the longer paths first, and sends a `Secure` cookie over
# `https://` alone, taking one only from an answer that came over it
# (RFC 6265bis: an http page cannot overwrite a secure cookie). There is
# no public-suffix list: a `Domain` of one label is refused, and one like
# `co.uk` is taken, which a browser would refuse. This module is apart
# from std/http because it reads the clock: std/time is what knows what
# an `Expires` date means, and std/http reaches the network alone.

module std/cookie

import std/http::{HTTP, Response, CookieStore}
import std/uri::{URI}
import std/time::{Time, Span}

# A cookie (RFC 6265): what a `Set-Cookie` line says, and what a jar
# keeps. `Cookie.parse(line)` reads a `Set-Cookie` value as RFC 6265 §5.2
# has a user agent read one - a name and value, then attributes in any
# case, an unknown attribute ignored - and answers nil for a line that
# has no name-value pair. `to_set_cookie` writes one, refusing a name or
# value that would break the line. `expires` is the instant it lapses,
# from `Max-Age` before `Expires` (§5.3, step 3); nil is a session cookie.
pub class Cookie
  getter name : String
  getter value : String
  getter path : String?
  getter domain : String?
  getter expires : Time?
  getter max_age : Int64?
  getter secure : Bool
  getter http_only : Bool
  getter same_site : String?

  def initialize(@name : String, @value : String, @path : String? = nil, @domain : String? = nil, @expires : Time? = nil, @max_age : Int64? = nil, @secure : Bool = false, @http_only : Bool = false, @same_site : String? = nil)
  end

  def self.parse(line : String) : Cookie?
    result = nil.as(Cookie?)
    tape do
      if parsed = parse(line.as_tape)
        result = parsed.to_heap
      end
    end
    result
  end

  def self.parse(line : Tape::String) : TapeCookie?
    TapeCookie.parse(line)
  end

  # The cookies an answer's `Set-Cookie` lines set, a line each.
  def self.from_response(response : Response) : Array(Cookie)
    found = [] of Cookie
    response.header_values("Set-Cookie").each do |line|
      if cookie = Cookie.parse(line)
        found << cookie
      end
    end
    found
  end

  # The pairs of a request's `Cookie` header: `a=1; b=2`.
  def self.parse_header(value : String) : Hash(String, String)
    result = Hash(String, String).new
    tape do
      result = parse_header(value.as_tape).to_heap
    end
    result
  end

  def self.parse_header(value : Tape::String) : TapeCookiePairs
    found = TapeCookiePairs.new
    value.split(';').each do |part|
      eq = part.index('=')
      next unless eq
      name = TapeCookie.trim(part[0, eq])
      next if name.empty?
      text = TapeCookie.trim(part[eq + 1, part.bytesize - eq - 1])
      if text.bytesize >= 2 && text[0] == 34_u8 && text[-1] == 34_u8
        text = text[1, text.bytesize - 2]
      end
      found[name] = text unless found[name]?
    end
    found
  end

  # The `Set-Cookie` value a server writes (§4.1). A name is a token, and a
  # value the cookie-octets: a space, a comma, a semicolon, a backslash or
  # a quote inside one would end it or another field early.
  def to_set_cookie : String
    result = ""
    tape do
      result = to_tape.to_heap
    end
    result
  end

  def to_tape : Tape::String
    Tape::String.build { |w| to_set_cookie(w) }
  end

  def to_set_cookie(writer : Tape::String::Writer) : Nil
    TapeCookie.view(self).to_set_cookie(writer)
  end

  # Whether the cookie has lapsed at *now*.
  def expired?(now : Time) : Bool
    if lapse = @expires
      return lapse <= now
    end
    false
  end
end

# The cookies a client keeps between requests (RFC 6265 §5.3, §5.4): what
# each answer's `Set-Cookie` lines set, by domain and path, and what a
# request to a URL sends back. A cookie without `Domain` goes back to its
# own host alone; one with a `Domain` the host is not within is refused,
# and so is a `Domain` of one label, `com` - there is no public-suffix
# list here, so a cookie for `co.uk` would be taken, which a browser would
# refuse. A cookie that has lapsed, or is set lapsed, is gone. A `Secure`
# cookie is taken from an `https://` answer only, and goes back over
# `https://` only (§5.4 step 1). A jar may be shared by tasks on one
# thread, not across threads.
pub class CookieJar
  # Each cookie, the host it was set by (what one without a `Domain` goes
  # back to), and the order it was made in.
  @kept : Array({Cookie, String, Int64})
  @made : Int64

  def initialize
    @kept = [] of {Cookie, String, Int64}
    @made = 0_i64
  end

  def size : Int32
    @kept.size
  end

  # The `Set-Cookie` lines of *response*, from *url*, taken in.
  def update(url : String, response : Response) : Nil
    response.header_values("Set-Cookie").each do |line|
      if cookie = Cookie.parse(line)
        add(url, cookie)
      end
    end
  end

  # *cookie*, as set by an answer from *url*: it replaces one of the same
  # name, domain and path, and one set already lapsed removes it.
  def add(url : String, cookie : Cookie) : Nil
    uri = URI.parse?(url)
    return unless uri
    host = (uri.hostname || "").downcase
    return if host.bytesize == 0
    return if cookie.secure && !CookieJar.secure?(uri)
    if domain = cookie.domain
      return unless domain.includes?(".") && CookieJar.domain_match?(host, domain)
    end
    path = cookie.path || CookieJar.default_path(uri.path)
    stored = Cookie.new(cookie.name, cookie.value, path, cookie.domain, cookie.expires, cookie.max_age, cookie.secure, cookie.http_only, cookie.same_site)
    scope = cookie.domain || host
    @kept = @kept.reject do |entry|
      other = entry[0]
      other.name == stored.name && (other.domain || entry[1]) == scope && other.path == stored.path
    end
    return if stored.expired?(Time.utc)
    @made = @made + 1_i64
    @kept << {stored, host, @made}
  end

  # The cookies a request to *url* carries: domain and path matching,
  # unexpired, `Secure` only over `https://`; longer paths first, then
  # older (§5.4, step 2).
  def cookies_for(url : String) : Array(Cookie)
    uri = URI.parse?(url)
    return [] of Cookie unless uri
    secure = CookieJar.secure?(uri)
    host = (uri.hostname || "").downcase
    path = uri.path
    path = "/" if path.bytesize == 0
    now = Time.utc
    @kept = @kept.reject { |entry| entry[0].expired?(now) }
    found = [] of {Cookie, Int64}
    @kept.each do |entry|
      cookie = entry[0]
      next if cookie.secure && !secure
      if domain = cookie.domain
        next unless CookieJar.domain_match?(host, domain)
      else
        next unless host == entry[1]
      end
      next unless CookieJar.path_match?(path, cookie.path || "/")
      found << {cookie, entry[2]}
    end
    found = found.sorted do |a, b|
      long_a = (a[0].path || "/").bytesize
      long_b = (b[0].path || "/").bytesize
      long_a == long_b ? (a[1] < b[1] ? -1 : (a[1] > b[1] ? 1 : 0)) : (long_a > long_b ? -1 : 1)
    end
    found.map { |pair| pair[0] }
  end

  # The `Cookie` header for a request to *url*, nil when nothing goes.
  def header_for(url : String) : String?
    cookies = cookies_for(url)
    return nil if cookies.empty?
    cookies.map { |cookie| cookie.name + "=" + cookie.value }.join("; ")
  end

  # Whether *uri* is over a secure protocol: `https://` (and `wss://`).
  protected def self.secure?(uri : URI) : Bool
    scheme = (uri.scheme || "").downcase
    scheme == "https" || scheme == "wss"
  end

  # §5.1.3: the host is the domain, or ends with it after a dot, and is
  # not an IP address.
  protected def self.domain_match?(host : String, domain : String) : Bool
    return true if host == domain
    return false unless host.ends_with?("." + domain)
    return false if host.includes?(":")
    p = host.to_unsafe
    i = 0
    while i < host.bytesize
      return true unless p[i] == 46_u8 || (p[i] >= 48_u8 && p[i] <= 57_u8)
      i = i + 1
    end
    false
  end

  # §5.1.4.
  protected def self.path_match?(request : String, cookie : String) : Bool
    return true if request == cookie
    return false unless request.starts_with?(cookie)
    cookie.ends_with?("/") || request.to_unsafe[cookie.bytesize] == 47_u8
  end

  # §5.1.4: the request path up to its last `/`, or `/`.
  protected def self.default_path(path : String) : String
    return "/" unless path.starts_with?("/")
    last = 0
    p = path.to_unsafe
    i = 0
    while i < path.bytesize
      last = i if p[i] == 47_u8
      i = i + 1
    end
    last == 0 ? "/" : path[0, last]
  end
end

impl CookieStore for CookieJar
end

# A Set-Cookie line's fields, retained with the caller's input bytes.
@[OnTape]
pub struct TapeCookie
  getter name : Tape::String
  getter value : Tape::String
  getter path : Tape::String?
  getter domain : Tape::String?
  getter expires : Time?
  getter max_age : Int64?
  getter secure : Bool
  getter http_only : Bool
  getter same_site : Tape::String?

  def initialize(@name : Tape::String, @value : Tape::String,
                 @path : Tape::String? = nil,
                 @domain : Tape::String? = nil, @expires : Time? = nil,
                 @max_age : Int64? = nil, @secure : Bool = false,
                 @http_only : Bool = false,
                 @same_site : Tape::String? = nil)
  end

  def self.parse(line : Tape::String) : TapeCookie?
    parts = line.split(';')
    return nil if parts.empty?
    pair = parts[0]
    eq = pair.index('=')
    return nil unless eq
    name = TapeCookie.trim(pair[0, eq])
    value = TapeCookie.trim(pair[eq + 1, pair.bytesize - eq - 1])
    return nil if name.bytesize == 0
    if value.bytesize >= 2 && value[0] == 34_u8 && value[-1] == 34_u8
      value = value[1, value.bytesize - 2]
    end
    path = nil.as(Tape::String?)
    domain = nil.as(Tape::String?)
    expires = nil.as(Time?)
    max_age = nil.as(Int64?)
    secure = false
    http_only = false
    same_site = nil.as(Tape::String?)
    i = 1
    while i < parts.size
      attribute = parts[i]
      i = i + 1
      key = attribute
      text = "".as_tape
      if at = attribute.index('=')
        key = attribute[0, at]
        text = TapeCookie.trim(attribute[at + 1, attribute.bytesize - at - 1])
      end
      key = lower(TapeCookie.trim(key))
      if key == "expires"
        expires = CookieDate.new(text).parse || expires
      elsif key == "max-age"
        if seconds = seconds(text)
          max_age = seconds
        end
      elsif key == "domain"
        name_of = text.starts_with?(".") ? text[1, text.bytesize - 1] : text
        domain = lower(name_of) if name_of.bytesize > 0
      elsif key == "path"
        path = text if text.starts_with?("/")
      elsif key == "secure"
        secure = true
      elsif key == "httponly"
        http_only = true
      elsif key == "samesite"
        same_site = text if text.bytesize > 0
      end
    end
    if age = max_age
      expires = age <= 0_i64 ? Time.unix(0_i64) : Time.utc + Span.seconds(age)
    end
    TapeCookie.new(name, value, path, domain, expires, max_age, secure,
      http_only, same_site)
  end

  # `Max-Age`'s digits, with a sign (§5.2.2); nil for anything else.
  private def self.seconds(text : Tape::String) : Int64?
    return nil if text.bytesize == 0
    p = text
    negative = p[0] == 45_u8
    i = negative ? 1 : 0
    return nil if i == text.bytesize
    value = 0_i64
    while i < text.bytesize
      return nil unless p[i] >= 48_u8 && p[i] <= 57_u8
      value = value * 10_i64 + (p[i] - 48_u8).to_i64 if value < 100000000000_i64
      i = i + 1
    end
    negative ? 0_i64 - value : value
  end

  def to_set_cookie(text : Tape::String::Writer) : Nil
    unless HTTP.token?(@name)
      raise "Cookie: not a cookie name: #{@name.to_heap.inspect}"
    end
    p = @value
    i = 0
    while i < @value.bytesize
      c = p[i]
      unless c == 0x21_u8 || (c >= 0x23_u8 && c <= 0x2B_u8) ||
             (c >= 0x2D_u8 && c <= 0x3A_u8) ||
             (c >= 0x3C_u8 && c <= 0x5B_u8) ||
             (c >= 0x5D_u8 && c <= 0x7E_u8)
        raise "Cookie: #{@name.to_heap} has a byte a cookie value " \
              "cannot hold: #{@value.to_heap.inspect}"
      end
      i = i + 1
    end
    text << @name << "=" << @value
    if path = @path
      text << "; Path=" << path
    end
    if domain = @domain
      text << "; Domain=" << domain
    end
    if age = @max_age
      text << "; Max-Age=" << age
    elsif expires = @expires
      text << "; Expires="
      CookieDate.write(expires, text)
    end
    text << "; Secure" if @secure
    text << "; HttpOnly" if @http_only
    if same = @same_site
      text << "; SameSite=" << same
    end
    nil
  end

  def to_tape : Tape::String
    Tape::String.build { |w| to_set_cookie(w) }
  end

  def self.view(cookie : Cookie) : TapeCookie
    path = cookie.path
    domain = cookie.domain
    same = cookie.same_site
    new(cookie.name.as_tape, cookie.value.as_tape,
      path ? path.as_tape : nil, domain ? domain.as_tape : nil,
      cookie.expires, cookie.max_age, cookie.secure, cookie.http_only,
      same ? same.as_tape : nil)
  end

  def to_heap : Cookie
    path = @path
    domain = @domain
    same = @same_site
    Cookie.new(@name.to_heap, @value.to_heap,
      path ? path.to_heap : nil, domain ? domain.to_heap : nil,
      @expires, @max_age, @secure, @http_only,
      same ? same.to_heap : nil)
  end

  def self.trim(text : Tape::String) : Tape::String
    first = 0
    last = text.bytesize
    while first < last && (text[first] == 32_u8 || text[first] == 9_u8)
      first += 1
    end
    while last > first && (text[last - 1] == 32_u8 || text[last - 1] == 9_u8)
      last -= 1
    end
    text[first, last - first]
  end

  private def self.lower(text : Tape::String) : Tape::String
    Tape::String.build(text.bytesize) do |w|
      text.each_byte do |b|
        w.push(b >= 65_u8 && b <= 90_u8 ? b + 32_u8 : b)
      end
    end
  end
end

@[OnTape]
pub struct TapeCookiePair
  getter key : Tape::String
  getter value : Tape::String

  def initialize(@key : Tape::String, @value : Tape::String)
  end
end

@[OnTape]
pub struct TapeCookiePairs
  @entries : Tape::Array(TapeCookiePair)

  def initialize
    @entries = Tape::Array(TapeCookiePair).new
  end

  def []?(key : String | Tape::String) : Tape::String?
    @entries.each do |field|
      return field.value if field.key == key
    end
    nil
  end

  def [](key : String | Tape::String) : Tape::String
    self[key]? || raise "COOKIE: missing key"
  end

  def []=(key : Tape::String, value : Tape::String) : Nil
    @entries.each_with_index do |field, i|
      if field.key == key
        @entries[i] = TapeCookiePair.new(key, value)
        return
      end
    end
    @entries << TapeCookiePair.new(key, value)
  end

  def size : Int32
    @entries.size
  end

  def empty? : Bool
    @entries.empty?
  end

  def has_key?(key : String | Tape::String) : Bool
    !self[key]?.nil?
  end

  def each(& : Tape::String, Tape::String -> Nil) : Nil
    @entries.each { |field| yield field.key, field.value }
  end

  def to_heap : Hash(String, String)
    result = Hash(String, String).new
    each { |key, value| result[key.to_heap] = value.to_heap }
    result
  end
end

# The HTTP-date grammar from std/time, over a tape view. Invalid dates
# are ignored by Cookie.parse, so this reader needs no error strings.
@[OnTape]
struct CookieDate
  DAYS = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday",
          "Friday", "Saturday"]
  MONTHS = ["January", "February", "March", "April", "May", "June",
            "July", "August", "September", "October", "November",
            "December"]

  @pos : Int32 = 0

  def initialize(@text : Tape::String)
  end

  def parse : Time?
    return nil unless name(DAYS, false)
    offset = 0
    if accept(',')
      return nil unless space
      day = number(2)
      return nil unless day
      if accept('-')
        month = name(MONTHS, true)
        return nil unless month && accept('-')
        start = @pos
        year = number(4)
        return nil unless year
        count = @pos - start
        if count == 2
          now = Time.utc.year
          year = now - now % 100 + year
          year += 100 if year + 100 <= now + 50
          year -= 100 if year > now + 50
        elsif count != 4
          return nil
        end
      else
        return nil unless space
        month = name(MONTHS, true)
        return nil unless month && space
        year = exact(4)
        return nil unless year
      end
      return nil unless space
      clock = time_of_day
      return nil unless clock && space
      zone_offset = zone
      return nil unless zone_offset
      offset = zone_offset
    else
      return nil unless space
      month = name(MONTHS, true)
      return nil unless month && space
      padded = accept(' ')
      day = number(padded ? 1 : 2)
      return nil unless day && space
      clock = time_of_day
      return nil unless clock && space
      year = exact(4)
      return nil unless year
    end
    return nil unless @pos == @text.bytesize
    month += 1
    return nil if day < 1 || day > Time.days_in_month(year, month)
    hour, minute, second = clock
    return nil if hour > 23 || minute > 59 || second > 60
    Time.utc(year, month, day, hour, minute, 0) +
      Span.seconds((second - offset).to_i64)
  end

  private def peek(ahead : Int32 = 0) : UInt8
    at = @pos + ahead
    at < @text.bytesize ? @text[at] : 0_u8
  end

  private def accept(char : Char) : Bool
    return false unless @pos < @text.bytesize && peek == char.ord
    @pos += 1
    true
  end

  private def space : Bool
    b = peek
    return false unless b == 32_u8 || (b >= 9_u8 && b <= 13_u8)
    @pos += 1
    true
  end

  private def number(max : Int32) : Int32?
    start = @pos
    value = 0
    while @pos - start < max && peek >= 48_u8 && peek <= 57_u8
      value = value * 10 + (peek - 48_u8).to_i32
      @pos += 1
    end
    @pos == start ? nil : value
  end

  private def exact(count : Int32) : Int32?
    start = @pos
    value = number(count)
    @pos - start == count ? value : nil
  end

  private def same?(text : Tape::String, name : String) : Bool
    return false if text.bytesize > name.bytesize
    i = 0
    while i < text.bytesize
      return false if (text[i] | 0x20_u8) != (name.to_unsafe[i] | 0x20_u8)
      i += 1
    end
    true
  end

  private def name(names : Array(String), short : Bool) : Int32?
    start = @pos
    while (b = peek | 0x20_u8) >= 97_u8 && b <= 122_u8
      @pos += 1
    end
    size = @pos - start
    return nil unless short ? size == 3 : size >= 3
    text = @text[start, size]
    names.each_with_index { |n, i| return i if same?(text, n) }
    nil
  end

  private def time_of_day : {Int32, Int32, Int32}?
    hour = number(2)
    return nil unless hour && accept(':')
    minute = number(2)
    return nil unless minute && accept(':')
    second = number(2)
    return nil unless second
    {hour, minute, second}
  end

  private def zone : Int32?
    if peek == 43_u8 || peek == 45_u8
      negative = accept('-')
      accept('+') unless negative
      hours = exact(2)
      minutes = exact(2)
      return nil unless hours && minutes && hours <= 23 && minutes <= 59
      offset = hours * 3600 + minutes * 60
      return negative ? -offset : offset
    end
    start = @pos
    while (b = peek | 0x20_u8) >= 97_u8 && b <= 122_u8
      @pos += 1
    end
    text = @text[start, @pos - start]
    names = ZONES
    offsets = OFFSETS
    names.each_with_index do |name, i|
      return offsets[i] if text.bytesize == name.bytesize && same?(text, name)
    end
    return 0 if text.bytesize == 1 && (text[0] | 0x20_u8) != 106_u8
    nil
  end

  ZONES = ["UT", "UTC", "GMT", "EST", "EDT", "CST", "CDT", "MST",
           "MDT", "PST", "PDT"]
  OFFSETS = [0, 0, 0, -18000, -14400, -21600, -18000, -25200,
             -21600, -28800, -25200]

  def self.write(time : Time, writer : Tape::String::Writer) : Nil
    utc = time.to_utc
    writer << DAYS[utc.day_of_week.value % 7].as_tape[0, 3] << ", "
    padded(utc.day, 2, writer)
    writer << " " << MONTHS[utc.month - 1].as_tape[0, 3] << " "
    padded(utc.year, 4, writer)
    writer << " "
    padded(utc.hour, 2, writer)
    writer << ":"
    padded(utc.minute, 2, writer)
    writer << ":"
    padded(utc.second, 2, writer)
    writer << " GMT"
  end

  private def self.padded(n : Int32, width : Int32,
                          writer : Tape::String::Writer) : Nil
    value = n.to_i64
    if value < 0
      writer << "-"
      value = -value
    end
    digits = 1
    rest = value
    while rest >= 10_i64
      digits += 1
      rest //= 10_i64
    end
    while digits < width
      writer << "0"
      digits += 1
    end
    writer << value
  end
end
