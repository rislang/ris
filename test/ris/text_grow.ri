
@[OnTape]
class GrowingTextEvent
  getter data : String

  def initialize(@data : String)
  end
end

@[OnTape]
class GrowingField
  property text : String = "odd"

  def append(value : String)
    @text << value
    nil
  end

  def rebind(value : String)
    @text = value
  end

  def take_event(owner)
    # The event and its text are copied onto *owner* together.
    event = GrowingTextEvent.new(@text).copy_to(owner)
    @text = ""
    event
  end
end

@[OnTape]
class InferredGrowingField
  getter text

  def initialize(value : String)
    @text = value
  end

  def append(value : String)
    @text << value
    nil
  end
end

class OwnedGrowingField
  getter text : String = "owner"

  def append(value : String)
    @text << value
    nil
  end
end

def copies : UInt64
  RisRegion.text_copied_bytes
end

def reservations : UInt64
  RisRegion.text_reservations
end

def check_count(before : UInt64, bytes : UInt64)
  raise "text copied after first append" unless copies == before + bytes
end

# Every round displaces the ordinary tape cursor. Growing text must not
# copy its prefix, even at odd lengths or after another growing value.
before = copies
before_reservations = reservations
s = ""
10000.times do
  padding = String.new("other tape writes")
  s << "x"
  raise "padding" unless padding.bytesize == 17
end
raise "local length" unless s.bytesize == 10000
check_count(before, 0_u64)
raise "local reservation" unless reservations == before_reservations + 1_u64

before = copies
literal = "abc"
literal << "d"
10000.times { literal << 'e' }
raise "literal prefix" unless literal[0, 4] == "abcd"
raise "literal length" unless literal.bytesize == 10004
check_count(before, 3_u64)

before = copies
odd = String.new("1234567")
odd << "8"
odd << "9"
odd << "0"
raise "odd lengths" unless odd == "1234567890"
check_count(before, 7_u64)

# Appending preserves existing prefix views until an explicit reset.
snapshot_text = "old"
snapshot_text << "!"
early = snapshot_text
10000.times { snapshot_text << "x" }
raise "append view" unless early == "old!"

# Each reset rewinds the same reservation.
before = reservations
text = ""
10000.times do
  text = ""
  text << "x"
  raise "local reset" unless text == "x"
end
raise "local reset reservation" unless reservations == before + 1_u64
puts "PASS: 10000 local resets: 1 reservation"

before = copies
typed : String = "typed"
typed << "!"
raise "typed local" unless typed == "typed!"
check_count(before, 5_u64)

before = copies
field_reservations = reservations
made = GrowingField.new
field = made.copy_to(Program.tape)
10000.times do
  padding = String.new("displace")
  field.append("x")
end
raise "field length" unless field.text.bytesize == 10003
check_count(before, 3_u64)
# Copies can leave in the same statement before the next reset.
saved = field.text.copy_to(Program.tape)
event = field.take_event(Program.tape)
before = reservations
reset_copies = copies
10000.times do
  field.rebind("reset")
  field.append("!")
  raise "field reset" unless field.text == "reset!"
end
raise "field reset reservation" unless reservations == before
raise "field total reservation" unless reservations == field_reservations + 1
check_count(reset_copies, 50000_u64)
puts "PASS: 10000 field resets: 1 reservation total"
raise "copied field" unless saved.bytesize == 10003
raise "copied event" unless event.data.bytesize == 10003

# A generated property setter follows the same checked reset path.
setter = GrowingField.new
setter.append("!")
before = reservations
setter.text = ""
setter.append("z")
raise "setter reset" unless setter.text == "z"
raise "setter reservation" unless reservations == before

tape do
  nested = "nested"
  nested << "!"
  raise "nested tape local" unless nested == "nested!"
end

# Other << methods retain their ordinary meaning.
struct TextGrowBits
  @bits : Int32 = 1

  def shift : Int32
    @bits << 1
  end
end
raise "integer shift" unless TextGrowBits.new.shift == 2

before = copies
inferred = InferredGrowingField.new(String.new("seed"))
3.times { inferred.append("!") }
raise "inferred field" unless inferred.text == "seed!!!"
check_count(before, 4_u64)

before = copies
owned = OwnedGrowingField.new
5.times { owned.append("!") }
raise "owner field" unless owned.text == "owner!!!!!"
check_count(before, 5_u64)

# Pool handles keep object fields on the same owner as other tape data.
pool = SlicePool(GrowingField).new
seed = GrowingField.new
run = pool.alloc_slice(1, seed)
before = copies
5.times { run[0].append("p") }
raise "pool field" unless run[0].text == "oddppppp"
check_count(before, 3_u64)

# The lazy slot follows a deeply copied object's owner, not its caller.
kept = GrowingField.new
retained = kept.copy_to(Program.tape)
before = copies
tape do
  retained.append("?")
end
raise "retained field" unless retained.text == "odd?"
check_count(before, 3_u64)

before = reservations
never = "never appended"
raise "never text" unless never.bytesize == 14
raise "never reservation" unless reservations == before
puts "PASS: text grows in locals and fields"
