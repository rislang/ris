module test/bzip2_tape

import std/bzip2::{Bzip2, Bzip2Reader, Bzip2Error}
import std/io::{Memory}
import std/digest::{CRC32}
import std/base64::{Base64}

# std/bzip2 on the caller's tape: streams Python's bz2 wrote (levels 1
# and 9, 250 KB past one block, random bytes, two streams) decoded whole
# and through Bzip2Reader over an IO, sizes and CRC-32s Python's; text
# compressed and read back; what a reader refuses. No heap.

def hex(v : UInt32) : String
  v.to_s(16).rjust(8, '0')
end

tape do
  good = [
    {"l9", ""},
    {"l1", ""},
    {"random", ""},
    {"two", "QlpoOTFBWSZTWaRjnbsAAACRgEAAASAcACAAIYAMAycu4u5IpwoSFIxzt2BCWmg5MUFZJlNZJooCNAAAAoGADgGIACAAIhhoMAcCmF3JFOFCQJooCNA="},
    {"one", "QlpoOTFBWSZTWRmTm2sAAAABACAAIAAhGEaC7kinChIDMnNtYA=="},
  ]
  good.each do |pair|
    data = Base64.decode(pair[1])
    got = Bzip2.decompress(data)
    if got.is_a?(Bzip2Error)
      puts "#{pair[0]} #{got.message}"
    else
      source = Memory.new(data)
      reader = Bzip2Reader.new(source)
      pieces = 0
      sum = 0_u32
      size = 0
      while true
        piece = reader.read(30000)
        if piece.is_a?(Bzip2Error)
          puts piece.message
          break
        end
        break if piece.empty?
        pieces = pieces + 1
        size = size + piece.bytesize
        sum = CRC32.update(sum, piece, piece.bytesize)
      end
      puts "#{pair[0]} #{got.bytesize} #{hex(CRC32.checksum(got))} #{size} #{hex(sum)} #{pieces} #{reader.finished?}"
    end
  end
  text = String.build { |w| 3000.times { |i| w << "line " << (i * 7 % 13) << "\n" } }
  [1, 9].each do |level|
    packed = Bzip2.compress(text, level)
    back = Bzip2.decompress(packed)
    puts "#{level} #{packed.bytesize} #{hex(CRC32.checksum(packed))} #{back.is_a?(String) && back == text}"
  end
  puts Bzip2.decompress(Bzip2.compress("")).or("x").bytesize
  bad = [
    {"magic", ""},
    {"cut", ""},
    {"crc", ""},
  ]
  bad.each do |pair|
    got = Bzip2.decompress(Base64.decode(pair[1]))
    puts "#{pair[0]} #{got.is_a?(Bzip2Error) ? got.message : got.bytesize}"
  end
end
