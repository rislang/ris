module test/ris/escape_boundary

import std/io::{Memory}

# A copy off the tape in a def marked @[TapeToHeap] compiles: it is the
# boundary where the text leaves for what outlives the tape.
CACHE = [] of String

@[TapeToHeap]
def keep(text : String) : Nil
  CACHE << text.to_s
end

@[TapeToHeap]
def memory_copy(text : String) : String
  memory = Memory.new
  text.to_s(memory)
  10.times do
    memory.clear
    memory.print(text)
    memory.clear
    text.to_s(memory)
  end
  memory.to_s
end

@[TapeToHeap]
def interpolated_copy(text : String) : String
  "#{text}".to_heap
end

@[TapeToHeap]
def builder_copy(text : String) : String
  String.build { |io| io.append(text) }
end

tape do
  text = "abc"
  keep(text)
  empty = ""
  print(empty)
  stdout.print(empty)
  10.times do
    print(empty)
    stdout.print(empty)
    empty.to_s(stdout)
  end
  raise "memory copy differs" unless memory_copy(text) == "abc"
  raise "interpolation differs" unless interpolated_copy(text) == "abc"
  raise "builder copy differs" unless builder_copy(text) == "abc"
end
puts CACHE.first
