module test/ris/cleanup_allocations
import std/int

def work : Nil
  tape do
    items = Array(Int64).new(0)
    items.push(7_i64)
    tape { items.push(8_i64) }
  end
end

# Warm the fiber, mapping and reusable cleanup before measuring steady state.
work
100000.times { work }
puts "no GC allocation per scope"
puts RisRegion.tape != 0_u64
