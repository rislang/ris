def temporary(n : Int32) : Int32
  text = Str.new("hello")
  items = Ary(Int32).new(4)
  items << n
  writer = Str::Builder.new(16)
  writer << text
  writer.append_int(items[0])
  writer.length
end

before = IyiHeap.read64(IyiRegion.tape &+ IyiRegion::OFF_CURSOR)
temporary(42)
raise "def kept temporaries" unless before ==
  IyiHeap.read64(IyiRegion.tape &+ IyiRegion::OFF_CURSOR)
i = 0
total = 0_i64
while i < 1_000_000
  total += temporary(i)
  i += 1
end
after = IyiHeap.read64(IyiRegion.tape &+ IyiRegion::OFF_CURSOR)
raise "implicit tape grew" unless before == after
raise "wrong work result" unless total == 10_888_890
puts "PASS: million calls, flat tape"
