class State
  @@names = Array(String).new
  def self.names
    @@names
  end
end
@[OnTape]
struct Held
  getter names : Array(String)
  def initialize(@names)
  end
end
def level0(names : Array(String)) : Held
  Held.new(names)
end
def level1(names : Array(String)) : Held
  level0(names)
  level0(names)
end
def level2(names : Array(String)) : Held
  level1(names)
  level1(names)
end
def level3(names : Array(String)) : Held
  level2(names)
  level2(names)
end
