#!/bin/sh

# Use `./bin/check-compiler-flag FLAG` to check the behaviour of the given compiler flag.
# This is useful if `crystal build` is affected when using `-DFLAG` option.
#
# This script will
#   * run the compiler_test using the flag
#   * build the compiler to have the flag available (in case the flag is introduced in this version)
#   * run the std_test and primitives_test with and without the flag
#   * check the compiler_test built with and without the flag (eg: the tests build with the flag can generate a compiler without the flag)
#   * build a 2nd generation of the compiler using the flag
#   * repeat the checks for the test suites with and without the flag

set -eux

COMPILER_FLAG=$1

# test compiler_test
make clean_cache clean_crystal
RIS_LIBRARY_PATH=$(./bin/crystal env RIS_LIBRARY_PATH) CRYSTAL_SPEC_COMPILER_FLAGS="$COMPILER_FLAG" make compiler_test

# first gen compiler
make clean_cache clean_crystal crystal
./bin/crystal --version
md5 .build/crystal

# run tests
make clean_cache std_test
make clean_cache std_test FLAGS="-D$COMPILER_FLAG"
make clean_cache primitives_test
make clean_cache primitives_test FLAGS="-D$COMPILER_FLAG"

# test compiler_test
make clean_cache
RIS_LIBRARY_PATH=$(./bin/crystal env RIS_LIBRARY_PATH) CRYSTAL_SPEC_COMPILER_FLAGS="$COMPILER_FLAG" make compiler_test FLAGS="-D$COMPILER_FLAG"
make clean_cache
RIS_LIBRARY_PATH=$(./bin/crystal env RIS_LIBRARY_PATH) make compiler_test FLAGS="-D$COMPILER_FLAG"
make clean_cache
RIS_LIBRARY_PATH=$(./bin/crystal env RIS_LIBRARY_PATH) make compiler_test

# building 2nd gen compiler
make clean_crystal clean_cache crystal # first
md5 .build/crystal
touch src/compiler/crystal.cr
sleep 2
make clean_cache crystal FLAGS="-D$COMPILER_FLAG" # second
md5 .build/crystal

# run tests
make clean_cache std_test
make clean_cache std_test FLAGS="-D$COMPILER_FLAG"
make clean_cache primitives_test
make clean_cache primitives_test FLAGS="-D$COMPILER_FLAG"

# run compiler tests
make clean_cache
RIS_LIBRARY_PATH=$(./bin/crystal env RIS_LIBRARY_PATH) CRYSTAL_SPEC_COMPILER_FLAGS="$COMPILER_FLAG" make compiler_test FLAGS="-D$COMPILER_FLAG"
make clean_cache
RIS_LIBRARY_PATH=$(./bin/crystal env RIS_LIBRARY_PATH) make compiler_test FLAGS="-D$COMPILER_FLAG"
make clean_cache
RIS_LIBRARY_PATH=$(./bin/crystal env RIS_LIBRARY_PATH) make compiler_test
