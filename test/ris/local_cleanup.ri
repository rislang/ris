module test/ris/local_cleanup
import std/int

def check(ok : Bool) : Nil
  raise "local cleanup check failed" unless ok
end

# A cleanup's event: its code, negative when it saw the wrong tape. The
# task posts them on the board; the spawner takes them after the group.
record CleanupEvent, code : Int32

def note(code : Int32, ok : Bool) : Nil
  check(RisBoard.post(CleanupEvent.new(ok ? code : -code)))
end

def fail_local : Int32
  defer note(4, RisRegion.tape != 0_u64)
  tape do
    outer = RisRegion.tape
    defer note(3, RisRegion.tape == outer)
    local_tape do
      local_tape = RisRegion.tape
      defer note(2, RisRegion.tape == local_tape)
      local_tape do
        defer note(1, RisRegion.tape != local_tape)
        raise "expected local panic"
      end
    end
  end
  0
end

def interleave(tag : UInt8) : Nil
  tape do
    outer = String.build { |w| w.push(tag) }
    saved = RisRegion.tape
    local_tape do
      text = String.build { |w| w.append(outer) }
      current = RisRegion.tape
      sleep(1)
      check(RisRegion.tape == current)
      check(text[0] == tag)
    end
    check(RisRegion.tape == saved)
    check(outer[0] == tag)
  end
end

group do |g|
  a = g.spawn { interleave(65_u8) }
  b = g.spawn { interleave(66_u8) }
  task = g.spawn { fail_local }
  check(!a.value.is_a?(Panicked))
  check(!b.value.is_a?(Panicked))
  check(task.value.is_a?(Panicked))
end
4.times do |index|
  event = RisBoard.poll(CleanupEvent)
  next check(false) if event.is_a?(Cancelled)
  got = event[0]
  check(!got.nil? && got.code == index + 1)
end
check(RisRegion.tape != 0_u64)
puts "PASS: local panic cleanup and fiber switching"
