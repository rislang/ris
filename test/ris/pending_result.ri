@[PointerUnsafe("test that returned input slices retain their byte address")]
def pending_address(text : String) : UInt64
  IyiHeap.read64(pointerof(text).address)
end

# A result moves down; the helper's 64 KiB scratch is freed.
def pending_number(n : Int32) : String
  big = String::Builder.new(65_536)
  big.push(65_u8)
  String.build(16) { |w| w.append_int(n) }
end

def pending_borrow(text : String, early : Bool) : String
  big = String::Builder.new(65_536)
  big.push(66_u8)
  return text[1, 3] if early
  text[2, 2]
end

# Each fresh result moves down to its caller's boundary, once (SPEC 1.5):
# 10,000 results, read in the round that made them.
tape do
  source = String.new("abcdef")
  i = 0
  while i < 10_000
    expected = String.build(16) { |w| w.append_int(i) }
    raise "wrong pending result" unless pending_number(i) == expected
    i += 1
  end
  early = pending_borrow(source, true)
  late = pending_borrow(source, false)
  raise "wrong borrowed result" unless early == "bcd" && late == "cd"
  address = pending_address(source)
  raise "copied borrowed early view" unless \
    pending_address(early) == address + 1
  raise "copied borrowed final view" unless \
    pending_address(late) == address + 2
  puts "PASS: pending results and borrowed views"
end
