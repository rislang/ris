module test/eiy_tape

import std/eiy::{Eiy}

kept = ""
tape do
  text = "héllo <%= name %>\n  <%- if ok -%>\nend<% end %>".as_tape
  w = Tape::String::Writer.new(1)
  w << "prefix:"
  Eiy.process_string(text, w)
  code = Eiy.process_string(text)
  exit 1 unless w.finish == Tape::String.build { |o| o << "prefix:" << code }
  exit 2 unless code.starts_with?("__io__.print(\"héllo \")")
  kept = code.to_heap
  exit 3 unless Eiy.process_string?("<%= bad".as_tape).nil?
  lexer = Eiy::TapeLexer.new("abc<%=x%>".as_tape)
  exit 4 unless lexer.next_token.value == "abc"
  exit 5 unless lexer.next_token.value == "x"
end
exit 6 unless Eiy.process_string(
  "héllo <%= name %>\n  <%- if ok -%>\nend<% end %>") == kept
exit 7 unless Eiy.process_string?("<% bad").nil?
puts "PASS: eiy tape and heap APIs"
