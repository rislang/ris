# A value that outgrows its room while another follows it moves to a
# region of its own (`a`, with `b` after it; `b` grows in place). That
# region joins the spares when the local tape ends: a thousand scopes use
# two mappings, plus the implicit main tape (RIS_TAPE_STATS counts them).
1000.times do
  local_tape do
    a = Ary(Int32).new(4)
    b = Ary(Int32).new(4)
    i = 0
    while i < 100
      a << i
      b << i
      i += 1
    end
  end
end
