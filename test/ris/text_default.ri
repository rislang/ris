# Every def drops its interpolation when its result keeps no tape data.
def format_size(n : Int32) : Int32
  text = "number #{n}"
  raise "interpolation is not Str" unless text.is_a?(Str)
  text.bytesize
end

literal_cursor = IyiHeap.read64(RisRegion.tape &+ RisRegion::OFF_CURSOR)
literal = "static"
heap_literal = "static".to_heap
raise "literal used tape storage" unless literal_cursor ==
  IyiHeap.read64(RisRegion.tape &+ RisRegion::OFF_CURSOR)
raise "static retention type" unless heap_literal.is_a?(String)
puts typeof("static")
raise "literal allocated" unless "static".is_a?(Str)
before = IyiHeap.read64(RisRegion.tape &+ RisRegion::OFF_CURSOR)
format_size(42)
raise "def kept interpolation" unless before ==
  IyiHeap.read64(RisRegion.tape &+ RisRegion::OFF_CURSOR)
case "key".to_heap
when "key" then nil
else raise "case comparison failed"
end
i = 0
while i < 1_000_000
  format_size(i)
  i += 1
end
after = IyiHeap.read64(RisRegion.tape &+ RisRegion::OFF_CURSOR)
raise "interpolation retained tape" unless before == after
puts "PASS: default text, million calls, flat tape"
