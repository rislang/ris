# request: one HTTP request in, one response out, all on one tape.
#
#   ./bin/ris run samples/ris/request.ri
#
# The request's bytes, the parsed head and the response are made on the
# tape `@[Tape]` gives `handle`, freed together when it ends.
# Only the user table lives on, on the heap.

module samples/request

import std/http::{Server, ParsedHead}

USERS = {42 => "alice", 7 => "bob"}

# GET /users/42 -> 200 {"id":42,"name":"alice"}
# The body is written into the caller's writer, on its tape.
def route(head : ParsedHead, body : Tape::String::Writer) : Int32
  path = head.target
  return 405 unless head.method == "GET"
  if path == "/"
    body << "Hello"
    return 200
  end
  return 404 unless path.starts_with?("/users/")
  id = path[7, path.bytesize - 7].to_i? || return 404
  name = USERS[id]? || return 404
  body << %({"id":) << id << %(,"name":") << name << %("})
  200
end

def reason(status : Int32) : String
  case status
  when 200 then "OK"
  when 404 then "Not Found"
  when 405 then "Method Not Allowed"
  else          "Bad Request"
  end
end

# One request on its own tape: `@[Tape]` runs the def's body on one.
@[Tape]
def handle(raw : String) : Nil
  head = Server.parse_head(raw.as_tape)
  unless head.is_a?(ParsedHead)
    puts "400 Bad Request"
    return
  end
  body = Tape::String::Writer.new(128)
  status = route(head, body)
  puts "#{status} #{reason(status)} #{body.finish}"
end

handle("GET / HTTP/1.1\r\nHost: localhost\r\n\r\n")
handle("GET /users/42 HTTP/1.1\r\nHost: localhost\r\n\r\n")
handle("GET /users/9 HTTP/1.1\r\nHost: localhost\r\n\r\n")
handle("POST /users/42 HTTP/1.1\r\nHost: localhost\r\n\r\n")
handle("not http")
