module test/shlex_tape

import std/shlex::{Shlex, ShlexError}

kept = [] of String
tape do
  text = "plain 'two words' \"café\" a\\ b ''".as_tape
  words = Shlex.split(text)
  exit 1 if words.is_a?(ShlexError)
  exit 2 unless words.size == 5
  exit 3 unless words[1] == "two words" && words[2] == "café"
  exit 4 unless words[3] == "a b" && words[4].empty?
  w = Tape::String::Writer.new(1)
  w << "prefix:"
  Shlex.join(words, w)
  exit 5 unless w.finish.starts_with?("prefix:plain 'two words'")
  again = Shlex.split(Shlex.join(words))
  exit 6 if again.is_a?(ShlexError)
  exit 7 unless again.to_heap == words.to_heap
  exit 8 unless Shlex.quote("a'b".as_tape) == "'a'\"'\"'b'"
  exit 9 unless Shlex.split("'bad".as_tape).is_a?(ShlexError)
  exit 10 unless Shlex.split("bad\\".as_tape).is_a?(ShlexError)
  comments = Shlex.split("a# rest\nb".as_tape, true)
  exit 11 if comments.is_a?(ShlexError)
  exit 12 unless comments.to_heap == ["a", "b"]
  kept = words.to_heap
end
exit 13 unless kept == ["plain", "two words", "café", "a b", ""]
exit 14 unless Shlex.split(Shlex.join(kept)) == kept
puts "PASS: shlex tape and heap APIs"
