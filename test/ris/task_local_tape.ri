# The safe forms of a task with captures and a local_tape: the group
# opened inside the local_tape, or the spawn outside it.
def inside : Int64
  total = 0_i64
  local_tape do
    n = 42_i64
    group do |g|
      task = g.spawn do
        sleep 0
        n
      end
      raise "inside" unless task.value == 42_i64
      total = n
    end
  end
  total
end

def outside : Int64
  n = 7_i64
  answer = 0_i64
  group do |g|
    task = g.spawn do
      sleep 0
      n
    end
    local_tape do
      m = [99_i64, 98_i64]
      sleep 0
      raise "m" unless m.size == 2
    end
    raise "outside" unless task.value == 7_i64
    answer = n
  end
  answer
end

# A helper spawning into a handed group, the group inside the local_tape.
def start(g, n : Int64)
  g.spawn do
    sleep 0
    n
  end
end

def helper : Int64
  got = 0_i64
  local_tape do
    group do |g|
      task = start(g, 5_i64)
      v = task.value
      got = v if v.is_a?(Int64)
    end
  end
  got
end

raise "helper" unless helper == 5_i64
raise "inside" unless inside == 42_i64
raise "outside" unless outside == 7_i64
puts "PASS: task local_tape"
