# Base64, RFC 4648, written in iyi.
#
# `encode` is the alphabet with `+` `/` and `=` padding, no line
# breaks (RFC 4648 §4). `urlsafe_encode` uses `-` `_` and the same
# padding. `decode` accepts both alphabets, ignores ASCII whitespace,
# and panics on a byte that is neither. Missing padding is allowed
# (`"QQ"` is `"A"`), but nothing is dropped without a word: data after
# the padding, data inside it (`"QU=JD"`), more `=` than the group
# needs, and a final group of one character (`"Q"`, which cannot encode a
# byte) are each refused.

module std/base64

# A data character's value, by byte; -1 for everything else, which the
# byte-at-a-time path sorts into whitespace, padding and refusals.
DECODE_VALUES = Base64.decode_values

# Two characters per twelve bits, the first in the low byte: the encoder
# writes eight characters for every six bytes it reads, as one word.
PAIRS_STD = Base64.pairs_of("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/")
PAIRS_URL = Base64.pairs_of("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_")

pub struct Base64
  def self.encode(data : String) : String
    result = ""
    tape do
      result = encode(data.as_tape).to_heap
    end
    result
  end

  def self.encode(data : Tape::String) : Tape::String
    encode_with(data, plus_slash, PAIRS_STD, true)
  end

  def self.encode(data : Tape::String,
                  writer : Tape::String::Writer) : Nil
    writer << encode(data)
  end

  def self.urlsafe_encode(data : String) : String
    result = ""
    tape do
      result = urlsafe_encode(data.as_tape).to_heap
    end
    result
  end

  def self.urlsafe_encode(data : Tape::String) : Tape::String
    encode_with(data, minus_underscore, PAIRS_URL, true)
  end

  def self.urlsafe_encode(data : Tape::String,
                          writer : Tape::String::Writer) : Nil
    writer << urlsafe_encode(data)
  end

  def self.decode(text : String) : String
    result = ""
    tape do
      result = decode(text.as_tape).to_heap
    end
    result
  end

  # Room for every byte the text can hold, sized up front.
  def self.decode(text : Tape::String) : Tape::String
    Tape::String.build(text.bytesize // 4 * 3 + 3) do |w|
      decode_into(w, text)
    end
  end

  def self.decode(text : Tape::String,
                  writer : Tape::String::Writer) : Nil
    writer << decode(text)
  end

  # Decodes *src* into *w*.
  private def self.decode_into(w : Tape::String::Writer, src : Tape::String) : Nil
    values = DECODE_VALUES
    n = src.bytesize
    acc = 0
    bits = 0
    pads = 0
    pads_needed = 0
    chars = 0
    i = 0
    while i < n
      # Between groups with no padding seen, four data characters are three
      # bytes, which is what the path below makes of them one at a time.
      if bits == 0 && pads == 0 && i + 4 <= n
        v0 = values[src[i].to_i32]
        v1 = values[src[i + 1].to_i32]
        v2 = values[src[i + 2].to_i32]
        v3 = values[src[i + 3].to_i32]
        if (v0 | v1 | v2 | v3) >= 0
          group = (v0 << 18) | (v1 << 12) | (v2 << 6) | v3
          w.push((group >> 16).to_u8)
          w.push(((group >> 8) & 255).to_u8)
          w.push((group & 255).to_u8)
          i = i + 4
          chars = chars + 4
          next
        end
      end
      b = src[i]
      i = i + 1
      # ASCII whitespace, as the header says: `\v` and `\f` were refused as
      # invalid bytes.
      next if b == 32_u8 || (b >= 9_u8 && b <= 13_u8)
      if b == 61_u8 # '='
        if pads == 0
          raise "base64: #{chars} data characters, 1 more than a multiple of 4: a single character cannot encode a byte" if bits == 6
          raise "base64: padding with no group to close" if bits == 0
          pads_needed = bits == 4 ? 2 : 1
        end
        pads = pads + 1
        raise "base64: excess padding" if pads > pads_needed
        next
      end
      v = values[b.to_i32]
      raise "base64: invalid byte #{b}" if v < 0
      if pads > 0
        raise "base64: discontinuous padding" if pads < pads_needed
        raise "base64: data after padding"
      end
      chars = chars + 1
      acc = (acc << 6) | v
      bits = bits + 6
      if bits >= 8
        bits = bits - 8
        w.push(((acc >> bits) & 255).to_u8)
      end
    end
    raise "base64: #{chars} data characters, 1 more than a multiple of 4: a single character cannot encode a byte" if bits == 6
  end

  # Six bytes read as one word and eight characters written as one, while
  # eight bytes can be read; then three bytes at a time. Words are
  # little-endian on every target iyi builds for, which is what the byte
  # order below and the pair table's order are written for.
  private def self.encode_with(data : Tape::String, alphabet : String,
                               pairs : Array(Int32),
                               pad : Bool) : Tape::String
    n = data.bytesize
    whole = n - n % 3
    table = Tape::String.view(alphabet)
    Tape::String.build((n + 2) // 3 * 4) do |w|
      i = 0
      while i &+ 8 <= n
        word = data.read_bytes_at(UInt64, i)
        bits = (word & 0xFF_u64).unsafe_shl(40) | (word.unsafe_shr(8) & 0xFF_u64).unsafe_shl(32) |
               (word.unsafe_shr(16) & 0xFF_u64).unsafe_shl(24) | (word.unsafe_shr(24) & 0xFF_u64).unsafe_shl(16) |
               (word.unsafe_shr(32) & 0xFF_u64).unsafe_shl(8) | (word.unsafe_shr(40) & 0xFF_u64)
        c01 = pairs[bits.unsafe_shr(36).unsafe_to_i32].unsafe_to_u64
        c23 = pairs[(bits.unsafe_shr(24) & 0xFFF_u64).unsafe_to_i32].unsafe_to_u64
        c45 = pairs[(bits.unsafe_shr(12) & 0xFFF_u64).unsafe_to_i32].unsafe_to_u64
        c67 = pairs[(bits & 0xFFF_u64).unsafe_to_i32].unsafe_to_u64
        w.write_bytes(c01 | c23.unsafe_shl(16) | c45.unsafe_shl(32) | c67.unsafe_shl(48))
        i = i &+ 6
      end
      while i < whole
        triple = (data[i].to_i32 << 16) | (data[i + 1].to_i32 << 8) | data[i + 2].to_i32
        w.push(table[triple >> 18])
        w.push(table[(triple >> 12) & 63])
        w.push(table[(triple >> 6) & 63])
        w.push(table[triple & 63])
        i = i + 3
      end
      if i < n
        rest = n - i
        b1 = rest > 1 ? data[i + 1].to_i32 : 0
        triple = (data[i].to_i32 << 16) | (b1 << 8)
        w.push(table[triple >> 18])
        w.push(table[(triple >> 12) & 63])
        if rest == 1
          w.push(pad ? 61_u8 : table[(triple >> 6) & 63])
          w.push(61_u8)
        else
          w.push(table[(triple >> 6) & 63])
          w.push(pad ? 61_u8 : table[triple & 63])
        end
      end
    end
  end

  private def self.plus_slash : String
    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
  end

  private def self.minus_underscore : String
    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
  end

  protected def self.pairs_of(alphabet : String) : Array(Int32)
    chars = alphabet.to_unsafe
    Array.new(4096) { |k| chars[k.unsafe_shr(6)].to_i32 | chars[k & 63].to_i32.unsafe_shl(8) }
  end

  protected def self.decode_values : Array(Int32)
    Array.new(256) { |b| value_of(b.to_u8) }
  end

  private def self.value_of(b : UInt8) : Int32
    if b >= 65_u8 && b <= 90_u8
      (b - 65_u8).to_i32
    elsif b >= 97_u8 && b <= 122_u8
      (b - 97_u8).to_i32 + 26
    elsif b >= 48_u8 && b <= 57_u8
      (b - 48_u8).to_i32 + 52
    elsif b == 43_u8 || b == 45_u8
      62
    elsif b == 47_u8 || b == 95_u8
      63
    else
      -1
    end
  end
end
