module test/ris/inbox_storage

group do |g|
  q = g.new_inbox(Str, 1)
  text = Str.new("hello")
  q.send(text)
  q.receive
  maps = __ris_inbox_storage_maps
  raise "warm-up mapping" unless maps > 0_u64
  100000.times do
    local_tape do
      raise "send" unless q.send(text).nil?
      value = q.receive
      raise "receive" unless value.is_a?(Str) && value == "hello"
    end
  end
  raise "steady storage mmap" unless __ris_inbox_storage_maps == maps
  # Cross a small slab boundary, then reuse every block and message slot.
  many = g.new_inbox(Str, 3000, bytes: 120000)
  2.times do
    3000.times { raise "slab send" unless many.send(text).nil? }
    3000.times do
      local_tape do
        value = many.receive
        raise "slab receive" unless value.is_a?(Str) && value == "hello"
      end
    end
  end
  # Exercise the largest pooled block and the first directly mapped size.
  large = g.new_inbox(Str, 1, bytes: 2097152)
  local_tape do
    bytes = Str.build(1048561) { |w| 1048561.times { w.push(120_u8) } }
    2.times do
      before = __ris_inbox_storage_maps
      2.times do
        raise "large pooled send" unless large.send(bytes[0, 1048560]).nil?
        local_tape do
          value = large.receive
          raise "large pooled receive" unless value.is_a?(Str) &&
            value.bytesize == 1048560 && value[1048559] == 120_u8
        end
      end
      after = __ris_inbox_storage_maps
      raise "large pooled reuse" unless after - before <= 1_u64
      before = after
      raise "direct send" unless large.send(bytes).nil?
      local_tape do
        value = large.receive
        raise "direct receive" unless value.is_a?(Str) &&
          value.bytesize == 1048561 && value[1048560] == 120_u8
      end
      raise "direct mapping" unless __ris_inbox_storage_maps == before + 1_u64
    end
  end
end
puts "PASS: inbox storage"
