module test/yaml_tape

import std/yaml::{YAML, TapeValue, yaml_serializable}

# std/yaml on the caller's tape: documents read into TapeValue, dumped,
# read back and compared; derive yaml_serializable; no heap.

@[OnTape]
pub struct Point
  getter name : String
  getter x : Int32
  getter tags : Array(String)
  getter scale : Float64?
  derive yaml_serializable
end

tape do
  text = "name: café\nlist: [1, true, null, 0.125]\nquoted: \"a\\nb\"\n"
  doc = YAML.parse(text)
  exit 14 unless YAML.parse("[1, 2]")[-1].as_i == 2
  copied = doc.copy_to(Program.tape)
  exit 13 unless copied == doc
  exit 1 unless doc["name"].as_s == "café"
  exit 2 unless doc["list"][0].as_i == 1
  exit 3 unless doc["quoted"].as_s == "a\nb"
  w = String::Builder.new(1)
  w << "prefix:"
  YAML.dump(doc, w)
  rendered = YAML.dump(doc)
  print rendered
  exit 4 unless YAML.parse(rendered) == doc
  exit 15 unless YAML.parse(rendered).hash == doc.hash
  exit 5 unless w.finish.starts_with?("prefix:name:")
  exit 6 unless YAML.parse?("[bad").nil?
  nested = YAML.parse("- [1, [2], 3]\n-\n  - 4\n  - [5, 6]\n")
  exit 9 unless nested[0][1][0].as_i == 2
  exit 10 unless nested[1][1][1].as_i == 6
  exit 11 unless YAML.parse(YAML.dump(nested)) == nested
  print YAML.dump(nested)
  puts nested.inspect
  puts doc.inspect
  docs = YAML.parse_all("a: 1\n---\n- x\n- {k: v}\n")
  puts docs.size
  docs.each { |d| print YAML.dump(d) }
  p = Point.from_yaml("name: p\nx: 3\ntags: [a, b]\n")
  puts "#{p.name} #{p.x} #{p.tags.join(",")} #{p.scale.nil?}"
  print p.to_yaml
end
puts "PASS: yaml tape"
