# A chat room: what lasts lives on the heap, each request on a tape.
#
#   ./bin/ris run samples/ris/chat.ri

module Chat
  # What outlives a request lives on the heap: users, the room, and the
  # messages posted in it.
  class User
    getter id : Int32
    getter name : String

    def initialize(@id, @name)
    end
  end

  class Message
    getter user : User
    getter body : String

    def initialize(@user, @body)
    end
  end

  class Room
    getter users = Array(User).new
    getter messages = Array(Message).new

    def user(id : Int32) : User?
      users.find { |user| user.id == id }
    end
  end

  # A request's message, its body a view into the request's bytes.
  @[OnTape]
  struct Post
    getter user_id : Int32
    getter body : Tape::String

    def initialize(@user_id, @body)
    end
  end

  # "7 Ship it": a user id, one space, the text. Nil when it is not.
  def self.parse(request : Tape::String) : Post?
    user_id = 0
    index = 0
    while index < request.bytesize && request[index] != ' '.ord.to_u8
      digit = request[index] &- '0'.ord.to_u8
      return nil if digit > 9
      user_id = user_id * 10 + digit.to_i32
      index += 1
    end
    return nil if index == 0 || index >= request.bytesize
    Post.new(user_id, request[index + 1, request.bytesize - index - 1])
  end

  # The one copy to the heap: a posted message outlives its request.
  def self.keep(room : Room, user : User, post : Post) : Nil
    room.messages << Message.new(user, post.body.to_heap)
  end

  # One request, start to end on one tape: its bytes, the parse, the
  # room's view and the response are freed together when it ends.
  def self.handle(room : Room, request : String) : Nil
    tape do
      post = parse(Tape::String.view(request))
      if post.nil?
        puts "400 bad request"
      elsif user = room.user(post.user_id)
        keep(room, user, post)
        respond(room)
      else
        puts "403 user #{post.user_id} is not in the room"
      end
    end
  end

  # The room as the client shows it: the newest message first, then
  # the users by name, all written into one response on the tape.
  def self.respond(room : Room) : Nil
    count = room.messages.size
    newest = Tape::Array(Int32).new(count) { |i| count - 1 - i }
    response = Tape::String::Writer.new(256)
    response.append("200 ")
    newest.each_with_index do |i, k|
      message = room.messages[i]
      response.append(" | ") if k > 0
      response.append(message.user.name)
      response.append(": ")
      response.append(message.body)
    end
    response.append(" (users ")
    names = Tape::Array(String).new(room.users.size) { |i| room.users[i].name }
    names.sort_in_place
    names.join(response, ", ")
    response.append(")")
    puts response.finish
  end
end

room = Chat::Room.new
room.users << Chat::User.new(31, "carol")
room.users << Chat::User.new(7, "alice")
room.users << Chat::User.new(12, "bob")
Chat.handle(room, "7 Morning!")
Chat.handle(room, "12 Deploy is green")
Chat.handle(room, "7 Ship it")
Chat.handle(room, "99 Hi")
Chat.handle(room, "hello")
puts "kept #{room.messages.size} messages"
