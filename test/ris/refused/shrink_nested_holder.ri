@[OnTape]
struct InnerView
  property text : String

  def initialize(@text)
  end
end

@[OnTape]
struct OuterView
  getter inner : InnerView

  def initialize(@inner)
  end
end

tape do
  bytes = String::Builder.new
  bytes << "abc"
  holder = OuterView.new(InnerView.new(bytes.finish))
  bytes.clear
  puts holder.inner.text
end
