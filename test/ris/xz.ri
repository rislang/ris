module test/xz_tape

import std/xz::{Xz, XzReader, XzFormat, XzError}
import std/io::{Memory}
import std/digest::{CRC32}
import std/base64::{Base64}

# std/xz on the caller's tape: streams Python's lzma wrote - every check,
# stored chunks, a 150 KB text past the first ring, two streams with
# padding, a .lzma file, the delta and x86 filters - decoded whole and
# through XzReader over an IO; sizes and CRC-32s are Python's. Then what
# a reader refuses. No heap.

def hex(v : UInt32) : String
  v.to_s(16).rjust(8, '0')
end

tape do
  good = [
    {"crc64", ""},
    {"crc32", ""},
    {"sha256", ""},
    {"none", ""},
    {"stored", ""},
    {"big", ""},
    {"two", "/Td6WFoAAATm1rRGAgAhARYAAAB0L+WjAQAFZmlyc3QgAAAA5vUbUSR5EHIAAR4GwS+kHR+2830BAAAAAARZWgAAAAAAAAAA/Td6WFoAAATm1rRGAgAhARYAAAB0L+WjAQAFc2Vjb25kAAAAOOiIxcYwtHQAAR4GwS+kHR+2830BAAAAAARZWg=="},
    {"alone", ""},
    {"delta", "/Td6WFoAAATm1rRGAgEDAQMhARaXj3H84Af/ABZdAAAAUlAKoO+cVKoJ39UB062YeCTVAAAAAAAVkAkCk1naGQABMoAQAAAAdpUYa7HEZ/sCAAAAAARZWg=="},
    {"x86", ""},
  ]
  good.each do |pair|
    format = pair[0] == "alone" ? XzFormat::Lzma : XzFormat::Xz
    data = Base64.decode(pair[1])
    got = Xz.decompress(data, format)
    if got.is_a?(XzError)
      puts "#{pair[0]} #{got.message}"
    else
      reader = XzReader.new(Memory.new(data), format)
      pieces = 0
      sum = 0_u32
      size = 0
      while true
        piece = reader.read(4000)
        if piece.is_a?(XzError)
          puts piece.message
          break
        end
        break if piece.empty?
        pieces = pieces + 1
        size = size + piece.bytesize
        sum = CRC32.update(sum, piece, piece.bytesize)
      end
      puts "#{pair[0]} #{got.bytesize} #{hex(CRC32.checksum(got))} #{size} #{hex(sum)} #{pieces} #{reader.finished?}"
    end
  end
  bad = [
    {"magic", ""},
    {"cut", ""},
    {"check", ""},
    {"trail", ""},
    {"pad", ""},
  ]
  bad.each do |pair|
    got = Xz.decompress(Base64.decode(pair[1]))
    puts "#{pair[0]} #{got.is_a?(XzError) ? got.message : got.bytesize}"
  end
  small = Xz.decompress(Base64.decode(good[5][1]), dict_limit: 4096_i64)
  puts small.message if small.is_a?(XzError)
end
