class Kept
  getter text : String
  def initialize
    @text = "value #{42}"
  end
end
# The object and its text share the caller's tape. Callee and loop
# scratch may reset without invalidating the field.
kept = Kept.new
100.times do |n|
  scratch = "overwrite #{n}"
end
raise "field text changed" unless kept.text == "value 42"
puts "PASS: text_literal_field survives"
