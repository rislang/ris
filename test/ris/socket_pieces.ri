# `IyiSocket#write(pieces)`: pieces on the tape in order, as one write where
# the platform takes several buffers, read back whole on loopback. More
# pieces than one call takes, empty ones among them, and a 1 MiB piece past
# the send buffer, so the write parks and goes on mid-piece.
module socket_pieces

import std/socket::{IyiSocket}

def read_all(socket : IyiSocket, count : Int32) : String
  writer = String::Builder.new(count)
  while writer.length < count
    got = socket.read(writer, count - writer.length).or_panic
    break if got == 0
  end
  writer.finish
end

big = ("b" * 1048576)
def expected_text : String
  String.build(1049000) do |io|
    io << "head:"
    100.times { |i| io << i << (i.even? ? "" : ",") }
    io << ("b" * 1048576) << "end"
  end
end
expected_size = expected_text.bytesize
server = IyiSocket.listen(0)
client = IyiSocket.connect("127.0.0.1", server.local_port).or_panic
conn = server.accept.or_panic
matches = false
group do |g|
  reader = g.spawn do
    expected = expected_text
    text = read_all(client, expected.bytesize)
    client.close
    text == expected
  end
  tape do
    pieces = Array(String).new(4)
    pieces << "head:"
    100.times do |i|
      pieces << String.build(4) { |w| w.append_int(i) }
      pieces << (i.even? ? "" : ",")
    end
    pieces << String.build(big.bytesize) { |w| w.append(big) }
    pieces << "end"
    written = conn.write(pieces).or_panic
    raise "wrote #{written}" unless written == expected_size
  end
  matches = reader.value.or_panic
end
conn.close
server.close
if matches
  puts "PASS: 203 pieces in order, empty ones and 1 MiB among them"
else
  raise "socket pieces differ"
end
