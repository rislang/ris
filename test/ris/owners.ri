# initialize fills its own fields in place.
class Filled
  getter items = Array(Int32).new

  def initialize
    @items << 5
  end
end

class Workspace
  getter left : Array(Int32)
  getter right : Array(Int32)
  property ticks = 0
  getter initial_header : UInt64

  @[PointerUnsafe("inspect final field header address")]
  def header_address : UInt64
    pointerof(@left).address
  end

  def grow_left
    @ticks += 1
    @left << 123
    nil
  end

  def accept_view(view : Array(Int32))
    nil
  end

  @[PointerUnsafe("compare constructor and final field header addresses")]
  def initialize
    @left = Array(Int32).new
    @right = Array(Int32).new
    @initial_header = pointerof(@left).address
    accept_view(@left)
  end
end

# Exercise a larger owner through ordinary class references.
class LargeWorkspace
  getter padding = {
    0_i64, 0_i64, 0_i64, 0_i64, 0_i64, 0_i64,
    0_i64, 0_i64, 0_i64, 0_i64, 0_i64, 0_i64,
    0_i64, 0_i64, 0_i64, 0_i64, 0_i64, 0_i64,
  }
  property ticks = 0
  getter a = Array(Int32).new
  getter b = Array(Int32).new
  getter c = Array(Int32).new
  getter d = Array(Int32).new
  getter e = Array(Int32).new
  getter f = Array(Int32).new
end

def grow_large(w : LargeWorkspace)
  w.ticks += 1
  100.times do |i|
    w.a << i
    w.f << i
  end
  nil
end

ROOT = Workspace.new

def left_view(w : Workspace) : Array(Int32)
  w.left
end

def explicit_view(w : Workspace) : Array(Int32)
  return w.left
end

def count(w : Workspace) : Int32
  w.left.size + w.right.size
end

def grow(w : Workspace, ignored : Int32 = 0)
  w.ticks += 1
  100.times do |i|
    w.left << i
    w.right << i * 2
  end
  nil
end

def middle(w : Workspace)
  grow(w)
end

def outer(w : Workspace)
  middle(w)
end

def effect : Int32
  1
end

tape do
  large = LargeWorkspace.new
  grow_large(large)
  raise "large owner storage" unless large.ticks == 1
  raise "large owner argument" unless large.a.size == 100
  raise "large owner argument" unless large.f.size == 100
  borrowed = Workspace.new
  raise "returned field view" unless left_view(borrowed).empty?
  raise "explicit field view" unless explicit_view(borrowed).empty?
  # Three calls must all keep the original owner header.
  outer(borrowed)
  raise "borrowed fields" unless count(borrowed) == 200
  raise "nested owner storage" unless borrowed.ticks == 1
  borrowed.grow_left
  raise "owner self storage" unless borrowed.ticks == 2
  raise "owner self" unless borrowed.left.size == 101
  # Evaluating a later argument must not snapshot an owner.
  grow(borrowed, effect)
  raise "argument storage" unless borrowed.ticks == 3
  raise "argument snapshot" unless count(borrowed) == 401
  # Class construction initializes the final instance in place.
  raise "program construction copy" unless ROOT.initial_header == ROOT.header_address
  raise "program owner" unless ROOT.left.empty?
  workspace = Workspace.new
  raise "local construction copy" unless workspace.initial_header == workspace.header_address
  100.times do |i|
    workspace.left << i
    workspace.right << i * 2
  end
  raise "owner growth" unless workspace.left[99] == 99
  raise "owner growth" unless workspace.right[99] == 198
  raise "owner argument" unless count(workspace) == 200
  filled = Filled.new
  raise "owner initialize fill" unless filled.items[0] == 5
  puts "PASS: owner fields"
end
