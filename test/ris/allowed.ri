module test/ris/allowed

import std/int

@[OnTape]
struct Resp
  getter id : Int64
  getter user : Str

  def initialize(@id : Int64, @user : Str)
  end
end

# The copy a caller keeps, made at the boundary it leaves the tape by.
@[TapeToHeap]
def retain(text : Str) : String
  text.to_s
end

def make : Resp
  Resp.new(1_i64, Str.build { |s| s.push(97_u8) })
end

# Everything here stays inside the scope, and compiles.
@[OnTape]
struct Page
  getter items : Ary(Resp)

  def initialize(@items : Ary(Resp))
  end
end

def total(p : Page) : Int64
  sum = 0_i64
  p.items.each { |r| sum += r.id }
  sum
end

copied = ""
tape do
  items = Ary(Resp).new
  items.push(make)
  items.push(make)
  page = Page.new(items)
  puts total(page)
  copied = retain(page.items[0].user)
end
puts copied
