module test/ris/array_api

a = [1, 2, 1, 3]
raise "difference" unless a - [2] == [1, 1, 3]
raise "intersection" unless a & [1, 3] == [1, 3]
raise "union" unless a | [3, 4] == [1, 2, 3, 4]
raise "repeat" unless [1, 2] * 2 == [1, 2, 1, 2]
raise "key uniq" unless a.uniq { |x| x % 2 } == [1, 2]
raise "zip" unless [1, 2].zip([3, 4])[1] == {2, 4}
raise "prefix" unless a.first(2) == [1, 2]
raise "suffix" unless a.last(2) == [1, 3]
raise "sum" unless a.sum { |x| x.to_i64 } == 7_i64
a.push(4, 5)
a.unshift(-1, 0)
raise "mutate" unless a.first == -1 && a.last == 5
raise "delete" unless a.delete(1) == 1 && !a.includes?(1)
raise "transpose" unless [[1, 2], [3, 4]].transpose[0] == [1, 3]
raise "flatten" unless [[1, 2], [3]].flatten == [1, 2, 3]
raise "false compact map" unless [1].compact_map { |x| false } == [false]
raise "string max" unless ["a", "b"].max == "b"
raise "compact" unless ([nil, 1, 2] of Int32?).compact == [1, 2]
raise "product" unless [1, 2, 3].product == 6
raise "float product" unless [1.5, 2.0].product == 3.0
raise "empty product" unless ([] of Int32).product == 1
# Transforms, views and replacement exercise core methods without imports.
b = [1, 2, 3, 4]
raise "range view" unless b[1..2].to_a == [2, 3]
raise "view equality" unless b[1, 2] == [2, 3]
raise "view inequality" if b[1, 2] == [2]
raise "view join" unless b[1, 2].join(":") == "2:3"
writer = String::Builder.new
writer << "prefix:"
b[1, 2].join(writer, "/")
raise "view writer" unless writer.finish == "prefix:2/3"
raise "empty view join" unless b[0, 0].join.empty?
raise "optional range" unless b[9..10]?.nil?
raise "optional span" unless (b[1, 99]? || raise "span").size == 3
b[1, 2] = [8, 9, 10]
raise "splice" unless b == [1, 8, 9, 10, 4]
b[1..3] = 2
raise "range splice" unless b == [1, 2, 4]
b.insert(2, 3)
raise "insert" unless b == [1, 2, 3, 4]
raise "delete at" unless b.delete_at(-1) == 4
b.reverse_in_place
raise "reverse in place" unless b == [3, 2, 1]
b.rotate_in_place
raise "rotate" unless b == [2, 1, 3]
b.fill { |i| i + 1 }
raise "fill" unless b == [1, 2, 3]
raise "fetch" unless b.fetch(9, 7) == 7
raise "search" unless b.bsearch { |x| x >= 2 } == 2
raise "reverse search" unless b.rindex { |x| x <= 2 } == 1
raise "values at" unless b.values_at(0, -1) == [1, 3]
raise "take" unless b.take(2) == [1, 2] && b.skip(2) == [3]
raise "map index" unless b.map_with_index { |x, i| x + i } == [1, 3, 5]
raise "group" unless b.group_by { |x| x % 2 }[1] == [1, 3]
raise "partition" unless b.partition { |x| x > 1 }[0] == [2, 3]
raise "windows" unless b.each_cons(2)[1] == [2, 3]
raise "slices" unless b.each_slice(2)[1] == [3]
raise "minmax" unless b.minmax == {1, 3}
raise "minmax key" unless b.minmax_by { |x| -x } == {3, 1}
raise "accumulate" unless b.accumulate(0) { |a, x| a + x } == [0, 1, 3, 6]
raise "reduce" unless b.reduce? { |a, x| a + x } == 6
raise "tally by" unless b.tally_by { |x| x % 2 }[1] == 2
raise "cartesian" unless b.cartesian([0]).size == 3

# Array asked what iyi's Array is asked, on a chat app's models:
# users post messages in a room.
@[OnTape]
struct Message
  getter user_id : Int32
  getter body : String

  def initialize(@user_id, body : String)
    @body = body
  end
end

tape do
  # The room's users, by id.
  users = Array(Int32){7, 12, 31}
  puts "#{users.size} #{users.first} #{users.last?} #{users.empty?}"
  puts "#{users.includes?(31)} #{users.index(31)} #{users.index(99)}"

  messages = Array(Message){
    Message.new(7, "Morning!"),
    Message.new(12, "Deploy is green"),
    Message.new(7, "Ship it"),
    Message.new(31, "Hi all"),
  }
  long = messages.count { |m| m.body.bytesize > 7 }
  longer = messages.any? { |m| m.body.bytesize >= 15 }
  puts "#{long} #{longer} #{messages.all? { |m| users.includes?(m.user_id) }}"
  if first = messages.find { |m| m.user_id == 12 }
    puts first.body
  end
  puts messages.find { |m| m.user_id == 99 }.nil?
  total = messages.reduce(0) { |sum, m| sum + m.body.bytesize }
  puts "#{total} #{messages.max_by { |m| m.body.bytesize }.user_id}"
  puts messages.min_by { |m| m.body.bytesize }.body

  # New arrays on the same tape: long ones, the rest, newest first.
  long_ones = messages.select { |m| m.body.bytesize > 7 }
  short = messages.reject { |m| m.body.bytesize > 7 }
  newest = messages.reversed
  puts "#{long_ones.size} #{short.size} #{newest.first.body}"

  # Grouped by author; one author's messages keep the order they were
  # posted in.
  by_author = messages.sorted_by { |m| m.user_id }
  by_author.each { |m| puts "#{m.user_id} #{m.body}" }
  puts messages.first.body

  # Guests join; the room's user list, sorted and written out.
  guests = Array(Int32){44, 3}
  everyone = users + guests
  everyone.sort_in_place
  list = String::Builder.new(64)
  everyone.join(list, ", ")
  puts list.finish
  copy = users.dup
  copy.concat(copy)
  down = copy.sorted { |a, b| a < b ? 1 : 0 }
  puts "#{users.size} #{copy.size} #{down.first}"

  # Past 16 elements the sort merges runs: 40 ids, posted newest first.
  ids = Array(Int32).new(40) { |i| 40 - i }
  ids.sort_in_place
  puts "#{ids.first} #{ids[15]} #{ids[16]} #{ids.last?} #{ids.sum}"

  # The newest message is taken back, as a deleted one is.
  puts "#{messages.pop.user_id} #{messages.size}"

  # Each user's unread count, none yet.
  unread = Array(Int32).new(users.size, 0)
  puts "#{unread.size} #{unread.sum} #{unread.first?}"

  empty = Array(Message).new
  puts "#{empty.empty?} #{empty.first?.nil?} #{empty.pop?.nil?}"
end

puts "PASS: array_api"
