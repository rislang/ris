# A panic in initialize must release both already-built fields with the
# enclosing tape. Repeated task scopes must not retain their mappings.
# Both growing fields reserve stable storage before initialize fails.
@[Owner]
struct BrokenOwner
  getter left : Array(Int32)
  getter right : Array(Int32)

  def initialize(fail : Bool)
    @left = Array(Int32).new(10_000_000)
    @right = Array(Int32).new(10_000_000)
    @left << 17
    @right << 23
    raise "expected owner construction panic" if fail
  end
end

100.times do
  group do |g|
    task = g.spawn do
      tape do
        w = BrokenOwner.new(true)
        raise "half-built owner became observable"
      end
    end
    raise "construction did not panic" unless task.value.is_a?(Panicked)
  end
end
puts "PASS: owner construction panic cleanup"
