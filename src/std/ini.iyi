# INI configuration text: `[section]` headers, `key = value` lines,
# comments opened by `#` or `;`, and keys before the first header filed
# under the section named `""`.
#
# `INI.parse` reads a String or an IO into `Hash(String, Hash(String, String))`
# and panics with a located sentence for what it refuses: a `[` with no
# `]` (`unterminated section at line 3, column 6`), anything after the
# `]` including a trailing space (`data after section at line 3, column 7`),
# and a line that is neither header, comment nor assignment (`expected
# declaration at line 4, column 4`). The column counts characters, so a
# section named `[café]` is a section and not an error. A line of nothing
# but whitespace is skipped like an empty one. Repeating a header
# continues the earlier section; a value keeps every `=` after its first.
#
# `INI.build(ini, space)` and `INI.build(io, ini, space)` write the same
# text: top-level keys first, then each section as `[name]`, its keys and
# one blank line. `space` chooses `key = value` over `key=value` and is
# false unless asked, so `parse(build(x))` and `build(parse(text))` round
# trip for text written the compact way. What `parse` would read back as
# something else is refused rather than written: a line break in a name
# or a value, a `]` in a section's name, a key that is empty, holds `=`
# or opens with `#`, `;`, `[` or U+FEFF (read as a byte order mark), and
# blanks at either end of a key or a value. INI has no escapes, so the
# one honest answer is the panic. The IO form takes the IO first, the
# way `io.write` reads, and calls only `write`.

module std/ini

pub struct INI
  # Past a byte order mark, which Windows PowerShell 5.1's `Set-Content
  # -Encoding UTF8` and older Notepad write: it panicked "expected
  # declaration at line 1, column 8" at a `[section]` behind one, and the
  # first key of a file without a section kept it and never matched.
  def self.parse(string : String) : Hash(String, Hash(String, String))
    result = Hash(String, Hash(String, String)).new
    tape do
      result = parse(string.as_tape).to_heap
    end
    result
  end

  def self.parse(string : Tape::String) : TapeINI
    text = string.starts_with?("\uFEFF") ? string[3..] : string
    parse_lines(text.split('\n'))
  end

  def self.parse(io : IO) : Hash(String, Hash(String, String))
    parse(io.read_all)
  end

  private def self.parse_lines(lines : Tape::Array(Tape::String)) : TapeINI
    ini = TapeINI.new
    current_section = TapeProperties.new
    ini["".as_tape] = current_section
    lineno = 0

    lines.each do |line|
      lineno += 1
      raw = line
      len = line.bytesize
      len -= 1 if len > 0 && raw[len - 1] == 13_u8 # a CRLF file's '\r'

      # Leading whitespace is ASCII whitespace, as the other library skips
      # it: only space and tab were, so `\v[s]` was refused as a key with no
      # `=` and a line of just `\f` was not the blank line it is.
      offset = 0
      while offset < len && (raw[offset] == 32_u8 || (raw[offset] >= 9_u8 && raw[offset] <= 13_u8))
        offset += 1
      end
      next if offset >= len

      first_byte = raw[offset]
      next if first_byte == 35_u8 || first_byte == 59_u8 # '#' or ';'

      if first_byte == 91_u8 # '['
        end_idx = -1
        i = offset + 1
        while i < len
          if raw[i] == 93_u8 # ']'
            end_idx = i
            break
          end
          i += 1
        end

        raise "unterminated section at line #{lineno}, column #{column(line, len)}" if end_idx < 0
        raise "data after section at line #{lineno}, column #{column(line, end_idx + 1)}" unless end_idx == len - 1

        name = line[offset + 1, end_idx - offset - 1]
        if existing = ini[name]?
          current_section = existing
        else
          current_section = TapeProperties.new
          ini[name] = current_section
        end
      else
        eq_idx = -1
        i = offset
        while i < len
          if raw[i] == 61_u8 # '='
            eq_idx = i
            break
          end
          i += 1
        end

        raise "expected declaration at line #{lineno}, column #{column(line, len)}" if eq_idx < 0

        key = trim(line[offset, eq_idx - offset])
        value = trim(line[eq_idx + 1, len - eq_idx - 1])
        current_section[key] = value
      end
    end

    if top = ini[""]?
      ini.delete("") if top.empty?
    end
    ini
  end

  # The 1-based character column of byte *index* in *line*: every byte
  # that is not a UTF-8 continuation byte begins a character.
  private def self.column(line : Tape::String, index : Int32) : Int32
    raw = line
    count = 0
    i = 0
    while i < index
      count += 1 if (raw[i] & 0xC0_u8) != 0x80_u8
      i += 1
    end
    count + 1
  end

  def self.build(ini : Hash(String, Hash(String, String)),
                 space : Bool = false) : String
    result = ""
    tape do
      view = TapeINI.new
      ini.each do |section, properties|
        fields = TapeProperties.new
        properties.each { |key, value| fields[key.as_tape] = value.as_tape }
        view[section.as_tape] = fields
      end
      result = build(view, space).to_heap
    end
    result
  end

  def self.build(ini : TapeINI, space : Bool = false) : Tape::String
    Tape::String.build { |w| build(ini, w, space) }
  end

  def self.build(ini : TapeINI, writer : Tape::String::Writer,
                 space : Bool = false) : Nil
    delim = space ? " = " : "="
    # Written verbatim, a value holding a line break wrote lines of its
    # own: `"hello\r\n[admin]\r\nrole=root"` read back as a section
    # `admin` with a key `role`, and a padded value came back unpadded.
    ini.each do |section, properties|
      if why = unwritable_section(section)
        raise "INI.build: section #{section.to_heap.inspect} " \
              "cannot be written: #{why}"
      end
      properties.each do |key, value|
        if why = unwritable_key(key)
          raise "INI.build: key #{key.to_heap.inspect} in section " \
                "#{section.to_heap.inspect} cannot be written: #{why}"
        end
        if why = unwritable_value(value)
          raise "INI.build: the value of #{key.to_heap.inspect} in " \
                "section #{section.to_heap.inspect} cannot be written: #{why}"
        end
      end
    end

    if top = ini[""]?
      top.each do |key, value|
        writer << key
        writer << delim
        writer << value
        writer << "\n"
      end
    end

    ini.each do |section, properties|
      next if section.empty?
      writer << "["
      writer << section
      writer << "]\n"
      properties.each do |key, value|
        writer << key
        writer << delim
        writer << value
        writer << "\n"
      end
      writer << "\n"
    end
    nil
  end

  def self.build(io : IO, ini : Hash(String, Hash(String, String)), space : Bool = false) : Nil
    io.write(build(ini, space))
  end

  private def self.unwritable_section(name : Tape::String) : String?
    return "it holds a line break" if line_break?(name)
    return "it holds `]`" if name.includes?(']')
    nil
  end

  # `parse` reads past a U+FEFF at the front of the text as a byte order
  # mark, so a top-level key opening with one, written first, came back
  # without it: `{"" => {"\uFEFFkey" => "v"}}` read back as `key`. Which
  # key is first is the hash's order, so it is refused wherever it is.
  private def self.unwritable_key(key : Tape::String) : String?
    return "it is empty" if key.empty?
    return "it holds a line break" if line_break?(key)
    return "it holds `=`" if key.includes?('=')
    if key.starts_with?("#") || key.starts_with?(";") || key.starts_with?("[")
      return "it opens with #{key[0].unsafe_chr.inspect}, which starts " \
             "a comment or a section"
    end
    if key.starts_with?("\uFEFF")
      return "it opens with U+FEFF, which is read as a byte order mark"
    end
    return "blanks at either end are not read back" if key != trim(key)
    nil
  end

  private def self.unwritable_value(value : Tape::String) : String?
    return "it holds a line break" if line_break?(value)
    return "blanks at either end are not read back" if value != trim(value)
    nil
  end

  private def self.trim(text : Tape::String) : Tape::String
    first = 0
    last = text.bytesize
    while first < last
      width = blank_width(text, first)
      break if width == 0
      first += width
    end
    while last > first
      at = last - 1
      while at > first && (text[at] & 0xC0_u8) == 0x80_u8
        at -= 1
      end
      break unless blank_width(text, at) == last - at
      last = at
    end
    text[first, last - first]
  end

  # Char#whitespace?'s UTF-8 bytes, as String#strip reads them.
  private def self.blank_width(text : Tape::String, at : Int32) : Int32
    b = text[at]
    return 1 if b == 32_u8 || (b >= 9_u8 && b <= 13_u8)
    left = text.bytesize - at
    return 2 if left >= 2 && b == 0xC2_u8 && text[at + 1] == 0xA0_u8
    return 0 if left < 3
    c = text[at + 1]
    d = text[at + 2]
    return 3 if b == 0xE1_u8 && c == 0x9A_u8 && d == 0x80_u8
    if b == 0xE2_u8
      if c == 0x80_u8
        return 3 if (d >= 0x80_u8 && d <= 0x8A_u8) ||
                    d == 0xA8_u8 || d == 0xA9_u8 || d == 0xAF_u8
      end
      return 3 if c == 0x81_u8 && d == 0x9F_u8
    end
    return 3 if b == 0xE3_u8 && c == 0x80_u8 && d == 0x80_u8
    0
  end

  private def self.line_break?(text : Tape::String) : Bool
    text.includes?('\n') || text.includes?('\r')
  end
end

# Ordered fields on the caller's tape; names and values view the input.
@[OnTape]
pub struct TapeProperty
  getter key : Tape::String
  getter value : Tape::String

  def initialize(@key : Tape::String, @value : Tape::String)
  end
end

@[OnTape]
pub struct TapeProperties
  @entries : Tape::Array(TapeProperty)

  def initialize
    @entries = Tape::Array(TapeProperty).new
  end

  def []?(key : String | Tape::String) : Tape::String?
    @entries.each do |field|
      return field.value if field.key == key
    end
    nil
  end

  def [](key : String | Tape::String) : Tape::String
    self[key]? || raise "INI: missing key"
  end

  def []=(key : Tape::String, value : Tape::String) : Nil
    @entries.each_with_index do |field, i|
      if field.key == key
        @entries[i] = TapeProperty.new(key, value)
        return
      end
    end
    @entries << TapeProperty.new(key, value)
  end

  def size : Int32
    @entries.size
  end

  def empty? : Bool
    @entries.empty?
  end

  def has_key?(key : String | Tape::String) : Bool
    !self[key]?.nil?
  end

  def each(& : Tape::String, Tape::String -> Nil) : Nil
    @entries.each { |field| yield field.key, field.value }
  end

  def to_heap : Hash(String, String)
    result = Hash(String, String).new
    each { |key, value| result[key.to_heap] = value.to_heap }
    result
  end
end

# Ordered fields on the caller's tape; names and values view the input.
@[OnTape]
pub struct TapeSection
  getter key : Tape::String
  getter value : TapeProperties

  def initialize(@key : Tape::String, @value : TapeProperties)
  end
end

@[OnTape]
pub struct TapeINI
  @entries : Tape::Array(TapeSection)

  def initialize
    @entries = Tape::Array(TapeSection).new
  end

  def []?(key : String | Tape::String) : TapeProperties?
    @entries.each do |field|
      return field.value if field.key == key
    end
    nil
  end

  def [](key : String | Tape::String) : TapeProperties
    self[key]? || raise "INI: missing key"
  end

  def []=(key : Tape::String, value : TapeProperties) : Nil
    @entries.each_with_index do |field, i|
      if field.key == key
        @entries[i] = TapeSection.new(key, value)
        return
      end
    end
    @entries << TapeSection.new(key, value)
  end

  def size : Int32
    @entries.size
  end

  def empty? : Bool
    @entries.empty?
  end

  def has_key?(key : String | Tape::String) : Bool
    !self[key]?.nil?
  end

  def each(& : Tape::String, TapeProperties -> Nil) : Nil
    @entries.each { |field| yield field.key, field.value }
  end

  def delete(key : String) : Nil
    @entries = @entries.reject { |field| field.key == key }
  end

  def to_heap : Hash(String, Hash(String, String))
    result = Hash(String, Hash(String, String)).new
    each { |key, value| result[key.to_heap] = value.to_heap }
    result
  end
end
