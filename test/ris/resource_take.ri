module test/ris/resource_take
import std/socket::{IyiSocket}

loser_port = 0
group do |g|
  winner = g.new_task do
    socket = IyiSocket.listen(0)
    defer socket.close
    {socket, Str.new("winner"), Ary(Str).new(2) { |i| Str.new("field") }}
  end
  loser = g.new_task do
    socket = IyiSocket.listen(0)
    loser_port = socket.local_port
    defer socket.close
    socket
  end
  value = winner.take
  if value.is_a?({IyiSocket, Str, Ary(Str)})
    socket = value[0]
    raise "child defer closed result" if socket.closed?
    raise "mixed result copy" unless value[1] == "winner"
    raise "mixed array copy" unless value[2][1] == "field"
    socket.close
  else
    raise "no winner"
  end
end
# An unclaimed listener no longer owns its port after the group ends.
raise "loser did not run" if loser_port == 0
reopened = IyiSocket.listen(loser_port)
reopened.close
puts "PASS: resource take"
