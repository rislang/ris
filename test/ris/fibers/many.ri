# More tapes alive at once than the 256 a fixed table held: each fiber
# keeps its scope open while it sleeps.
module test/ris/fibers/many
import std/int

def hold(i : Int32) : Int64
  total = 0_i64
  tape do
    values = Ary(Int64).new(4)
    values.push(i.to_i64)
    sleep(200)
    values.each { |v| total = total + v }
  end
  total
end

N = 1000
group do |g|
  tasks = Ary(IyiTask(Int64)).new(N)
  N.times do |i|
    tasks << g.spawn { hold(i) }
  end
  sleep(50)
  sum = 0_i64
  tasks.each do |task|
    got = task.value
    sum = sum + got if got.is_a?(Int64)
  end
  puts "#{N} tapes at once, sum #{sum}"
  0
end
