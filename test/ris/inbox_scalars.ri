module test/ris/inbox_scalars

import std/int
import std/float
# No arbitrary union is cleared into a fabricated value on slot reuse.
def roundtrip(g : IyiGroup, value : T) : Nil forall T
  q = g.new_inbox(T, 1)
  raise "scalar send" unless q.send(value).nil?
  got = q.receive
  raise "scalar type" unless got.is_a?(T)
  raise "scalar receive" unless got.is_a?(T) && got == value
end

enum Flag : UInt64
  High = 9223372036854775808_u64
end

group do |g|
  roundtrip(g, -128_i8)
  roundtrip(g, 65535_u16)
  roundtrip(g, -2147483648_i32)
  roundtrip(g, 18446744073709551615_u64)
  roundtrip(g, 170141183460469231731687303715884105727_i128)
  roundtrip(g, 340282366920938463463374607431768211455_u128)
  roundtrip(g, 1.5_f32)
  roundtrip(g, -2.75_f64)
  roundtrip(g, true)
  roundtrip(g, false)
  roundtrip(g, 'λ')
  roundtrip(g, :symbol)
  roundtrip(g, nil)
  roundtrip(g, Flag::High)
end
puts "PASS: inbox scalars"
