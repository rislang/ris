# refill_branch_loop's neighbour: a name read before the loop views the
# buffer a later round's refill clears, so reading it after is refused.

class RefillViewClient
  @text : String::Builder = String::Builder.new(16)
  @names = [] of String

  def refill : Int32
    @text.clear
    @names.clear
    @text << "ab"
    @names << @text.finish[0, 1]
    @names.size
  end

  def first : String
    @names[0]
  end
end

owner = RefillViewClient.new
owner.refill
held = owner.first
client = Program.args.size < 5 ? owner : nil
2.times do
  if c = client
    c.refill
  end
end
puts held
