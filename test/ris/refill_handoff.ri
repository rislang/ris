# Rows use fixed run handles; refill the temporary row after copying.
@[OnTape]
struct Table
  getter rows : Array(SlicePool::Run(Int32))
  @pool : SlicePool(Int32)
  @row : Array(Int32)

  def initialize
    @rows = Array(SlicePool::Run(Int32)).new
    @pool = SlicePool(Int32).new
    @row = Array(Int32).new
  end

  def add(value : Int32) : Nil
    @row << value
  end

  def end_row : Nil
    row = @pool.alloc_slice(@row.size)
    i = 0
    while i < @row.size
      row[i] = @row[i]
      i += 1
    end
    @rows << row
    @row.clear
  end

  # The row handed to the caller's Array, then refilled: a new Array made
  # here would be freed when the def ends.
  def take(into : Array(Int32)) : Array(Int32)
    @row.each { |value| into << value }
    @row.clear
    into
  end
end

tape do
  table = Table.new
  table.add(1)
  table.add(2)
  table.end_row
  table.add(3)
  table.end_row
  table.add(4)
  last = table.take(Array(Int32).new)
  puts "#{table.rows.size} #{table.rows[0].size} #{table.rows[1][0]} #{last[0]}"
end
