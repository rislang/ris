# Text made in a block round, carried out through rebound locals, would
# outlive the round that frees it (SPEC 1.1, 3.2): refused at the store.
class State
  @@log = Array(String).new
  def self.keep(text : String)
    @@log << text
  end
end
text = "static".copy_to(Program.tape)
a = text
b = text
c = text
3.times do
  a = b
  b = c
  c = String.new("request")
end
State.keep(a)
