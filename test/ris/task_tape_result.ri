module test/ris/task_tape_result

# A task answers tape values (String, Array, Hash, tuples); a def's closures
# and a struct holding a String survive the copy. Zero heap.
record Pair, a : Int32, b : Int32
group do |g|
  t = g.spawn { "<#{21 * 2}>" }
  u = g.spawn { [1, 2, 3].map { |x| x * 10 } }
  v = g.spawn { {"k" => 7} }
  w = g.spawn { {"one".upcase, "two"} }
  n = g.spawn { 5 }
  got = t.value
  puts got.is_a?(String) ? got : "panic"
  arr = u.value
  puts arr.sum if arr.is_a?(Array(Int32))
  m = v.value
  puts m["k"] if m.is_a?(Hash(String, Int32))
  tup = w.value
  puts tup[0] if tup.is_a?(Tuple(String, String))
  puts n.value
end
struct Tm
  getter what : String
  def initialize(@what : String)
  end
end
def rd(name : String) : String | Tm
  return Tm.new(name) if name == "slow"
  "<#{name}>"
end
def one(n : String) : String | Tm | Panicked
  group do |g|
    t = g.spawn { rd(n) }
    t.value
  end
end
r = one("slow")
puts r.what if r.is_a?(Tm)
r2 = one("ok")
puts r2 if r2.is_a?(String)
