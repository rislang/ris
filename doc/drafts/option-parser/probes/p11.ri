module p11
# The stub as it ships: no flag condition, and a second def that is
# never called, which must report nothing.
class Reg
  def on(flag : String, &block : String -> Nil) : Nil
    {% if flag?(:ris_no_gc) %}{% raise "on with a block: read the value after parse instead" %}{% end %}
  end

  def parse(args : Array(String)) : Nil
    {% if flag?(:ris_no_gc) %}{% raise "parse(args): use parse(args, found)" %}{% end %}
  end
end
r = Reg.new
r.on("-v") { |v| }
