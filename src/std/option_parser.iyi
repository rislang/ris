# Flag parsing, written in iyi; ris reads the flags after parse.
#
# `on` registers a flag and answers a `RisFlag`, a handle to it. `parse`
# walks the command line and fills a `RisOptions`, which is read through
# the handles: a misspelled flag is an undefined local at compile time.
#
#     parser = OptionParser.new
#     verbose = parser.on("-v", "--verbose", "say more")
#     ending = parser.on("-e EXT", "ending")
#     help = parser.on("-h", "--help", "this help")
#     found = RisOptions.new
#     rest = parser.parse(Program.args, found)
#     if found.has?(help)
#       puts parser   # the banner, then a line for each flag
#       exit
#     end
#     ext = found[ending]? || ".txt"
#
# A pair, `-v` and `--verbose`, is one flag spelled two ways; a value
# either spelling states, `-e EXT` or `--ending=EXT`, both take.
# `on("--color [WHEN]", …)` registers a flag whose value may be left out.
#
# The parser keeps views of the texts given to `on`, `banner=` and
# `separator`, and `found` views of `args`: pass `Program.args`, and do
# not let `found` outlive `args`. `parse` drops what `found` held; a value
# read from an earlier parse stays valid. A `RisFlag` belongs to the
# parser that made it.
#
# A bad command line panics: `unknown flag: --x`, `flag --x takes no
# value`, `flag --name needs a value`. After `parser.record_errors`,
# `parse` records them in `found.invalid` (unknown flags and values given
# to a flag that takes none) and `found.missing` (a flag that needs a
# value and is last), and goes on. Both lists are read-only.
#
# There are no commands: list them with `separator` and dispatch on
# `rest[0]`.

module std/option_parser

# A flag registered with `OptionParser#on`, read from `RisOptions`.
pub struct RisFlag
  getter index : Int32

  def initialize(@index : Int32)
  end
end

# What one `OptionParser#parse` found: each flag given, with its value (a
# view of the parsed args, `""` when it has none), and the flags it could
# not take after `record_errors`.
pub class RisOptions
  @given : Array({Int32, String})
  @invalid : Array(String)
  @missing : Array(String)

  def initialize
    @given = [] of {Int32, String}
    @invalid = [] of String
    @missing = [] of String
  end

  # Whether the command line gave *flag*.
  def has?(flag : RisFlag) : Bool
    @given.each { |entry| return true if entry[0] == flag.index }
    false
  end

  # The value *flag* was last given, `""` for a flag without one; nil when
  # it was not given.
  def []?(flag : RisFlag) : String?
    answer = nil
    @given.each { |entry| answer = entry[1] if entry[0] == flag.index }
    answer
  end

  # Unknown flags, and flags given a value they take none of, as typed.
  def invalid : Array(String)
    @invalid
  end

  # Flags that need a value and were last, as typed.
  def missing : Array(String)
    @missing
  end

  protected def given : Array({Int32, String})
    @given
  end
end

pub class OptionParser
  # What a flag does with the argument after it: `--name VALUE` needs one,
  # `--color [WHEN]` takes one unless it is missing or is a flag itself,
  # and `--verbose` takes none.
  enum Value
    None
    Required
    Optional
  end

  # Each name, a view of the text given to `on`, with what it takes and
  # its registration's index.
  @long : Hash(String, {Value, Int32})
  @short : Hash(String, {Value, Int32})
  # The help's lines: flag, second spelling or "", description. A
  # separator is {text, "", ""}, its text with no dash.
  @help : Array({String, String, String})
  @banner : String?
  @record : Bool
  @count : Int32

  def initialize
    @long = {} of String => {Value, Int32}
    @short = {} of String => {Value, Int32}
    @help = [] of {String, String, String}
    @banner = nil
    @record = false
    @count = 0
  end

  # The help's first line, "options:" until it is set.
  def banner=(text : String) : Nil
    @banner = text
  end

  def banner : String?
    @banner
  end

  # A line of its own in the help, between the flags registered before it
  # and after it.
  def separator(text : String) : Nil
    @help << {text, "", ""}
  end

  # Bad flags are recorded in `found.invalid` and `found.missing` instead
  # of panicking.
  def record_errors : Nil
    @record = true
  end

  # A value is taken by `--name VALUE`, `--name=VALUE`, `-n VALUE` and
  # `-nVALUE`. A short flag is one character, not one byte: `-é` is one.
  # A bracketed value, `--color [WHEN]`, `-c [WHEN]` or `-c[WHEN]`, may be
  # left out.
  def on(flag : String, description : String) : RisFlag
    name, takes = spelled(flag)
    index = @count
    @count = @count + 1
    @help << {flag, "", description}
    store(name, takes, index)
    RisFlag.new(index)
  end

  # One flag spelled two ways, `-v` and `--verbose`: the value either
  # states, both take.
  def on(short : String, long : String, description : String) : RisFlag
    first, first_takes = spelled(short)
    second, second_takes = spelled(long)
    if !first_takes.none? && !second_takes.none? && first_takes != second_takes
      raise "option: #{short} and #{long} differ on the value: one needs it, the other may leave it out"
    end
    takes = first_takes.none? ? second_takes : first_takes
    index = @count
    @count = @count + 1
    @help << {short, long, description}
    store(first, takes, index)
    store(second, takes, index)
    RisFlag.new(index)
  end

  def on(flag : String, description : String, &block : String -> Nil) : Nil
    {% raise "a ris program reads its flags after parse:
  flag = parser.on(\"-e EXT\", \"ending\")
  found = RisOptions.new
  parser.parse(Program.args, found)
  found[flag]?" %}
  end

  def on(short : String, long : String, description : String, &block : String -> Nil) : Nil
    {% raise "a ris program reads its flags after parse:
  flag = parser.on(\"-e EXT\", \"ending\")
  found = RisOptions.new
  parser.parse(Program.args, found)
  found[flag]?" %}
  end

  def invalid_option(&block : String -> Nil) : Nil
    {% raise "a ris program records bad flags: parser.record_errors, then read found.invalid and found.missing after parse" %}
  end

  def missing_option(&block : String -> Nil) : Nil
    {% raise "a ris program records bad flags: parser.record_errors, then read found.invalid and found.missing after parse" %}
  end

  # The name *flag* is looked up by, a view of it, and what it does with
  # a value.
  private def spelled(flag : String) : {String, Value}
    unless flag.starts_with?("-")
      raise "option: not a flag: #{flag}; list commands with separator and dispatch on rest[0]"
    end
    space = flag.index(' ')
    name = space ? flag[0, space] : flag
    takes = space ? Value::Required : Value::None
    takes = Value::Optional if space && bracketed?(flag[space, flag.bytesize - space].strip)
    if name.starts_with?("--")
      eq = name.index('=')
      if eq
        takes = Value::Required
        name = name[0, eq]
      end
    elsif name.bytesize >= 2
      at = char_end(name, 1)
      if at < name.bytesize
        takes = bracketed?(name[at, name.bytesize - at]) ? Value::Optional : Value::Required
        name = name[0, at]
      end
    else
      raise "option: not a flag: #{flag}"
    end
    {name, takes}
  end

  private def store(name : String, takes : Value, index : Int32) : Nil
    if name.starts_with?("--")
      @long[name] = {takes, index}
    else
      @short[name] = {takes, index}
    end
  end

  # `[WHEN]`: a name in brackets, the way a usage line marks what may be
  # left out.
  private def bracketed?(text : String) : Bool
    text.bytesize >= 3 && text.starts_with?("[") && text.ends_with?("]")
  end

  # Whether *arg* is a flag this parser knows, which an optional value
  # never takes as its own.
  private def known?(arg : String) : Bool
    @long.has_key?(arg) || @short.has_key?(arg)
  end

  # Where the character starting at byte *at* ends: a short flag is `-`
  # and one character.
  private def char_end(s : String, at : Int32) : Int32
    b = s[at]
    width = b < 0xC0_u8 ? 1 : (b < 0xE0_u8 ? 2 : (b < 0xF0_u8 ? 3 : 4))
    e = at + width
    e > s.bytesize ? s.bytesize : e
  end

  # Reads *args* into *found*, dropping what it held, and answers the
  # operands. `--` ends the flags.
  def parse(args : Array(String), found : RisOptions) : Array(String)
    found.given.clear
    found.invalid.clear
    found.missing.clear
    rest = [] of String
    i = 0
    n = args.size
    while i < n
      a = args[i]
      if a == "--"
        i = i + 1
        while i < n
          rest << args[i]
          i = i + 1
        end
        break
      elsif a.starts_with?("--")
        eq = a.index('=')
        if eq
          name = a[0, eq]
          spec = @long[name]?
          if !spec
            raise "unknown flag: #{name}" unless @record
            found.invalid << name
          elsif spec[0].none?
            raise "flag #{name} takes no value" unless @record
            found.invalid << name
          else
            found.given << {spec[1], a[eq + 1, a.bytesize - eq - 1]}
          end
        else
          spec = @long[a]?
          if !spec
            raise "unknown flag: #{a}" unless @record
            found.invalid << a
          elsif spec[0].none?
            found.given << {spec[1], ""}
          elsif i + 1 < n && (spec[0].required? || !known?(args[i + 1]))
            i = i + 1
            found.given << {spec[1], args[i]}
          elsif spec[0].required?
            raise "flag #{a} needs a value" unless @record
            found.missing << a
          else
            found.given << {spec[1], ""}
          end
        end
      elsif a.starts_with?("-") && a.bytesize >= 2
        at = char_end(a, 1)
        name = a[0, at]
        spec = @short[name]?
        if !spec
          raise "unknown flag: #{name}" unless @record
          found.invalid << name
        elsif !spec[0].none?
          if a.bytesize > at
            found.given << {spec[1], a[at, a.bytesize - at]}
          elsif i + 1 < n && (spec[0].required? || !known?(args[i + 1]))
            i = i + 1
            found.given << {spec[1], args[i]}
          elsif spec[0].required?
            raise "flag #{name} needs a value" unless @record
            found.missing << name
          else
            found.given << {spec[1], ""}
          end
        elsif a.bytesize == at
          found.given << {spec[1], ""}
        elsif bundle?(a)
          run_bundle(a, found)
        else
          raise "flag #{name} takes no value" unless @record
          found.invalid << name
        end
      else
        rest << a
      end
      i = i + 1
    end
    rest
  end

  # `-vq` is `-v -q`, and `-vp8080` is `-v -p 8080`: every character up to
  # the first flag that takes a value is a flag, and what follows that one
  # is its value. A bundle with a character that is no flag takes none of
  # it: it is `-v` handed a value it does not take.
  private def bundle?(a : String) : Bool
    pos = 1
    while pos < a.bytesize
      e = char_end(a, pos)
      spec = @short["-" + a[pos, e - pos]]?
      return false unless spec
      return true unless spec[0].none?
      pos = e
    end
    true
  end

  private def run_bundle(a : String, found : RisOptions) : Nil
    pos = 1
    while pos < a.bytesize
      e = char_end(a, pos)
      spec = @short["-" + a[pos, e - pos]]?
      if spec
        unless spec[0].none?
          found.given << {spec[1], a[e, a.bytesize - e]}
          return
        end
        found.given << {spec[1], ""}
      end
      pos = e
    end
  end

  # The banner, then `  FLAG  DESC` or `  SHORT, LONG  DESC` for each flag
  # and each separator as given, one per line.
  def help(io : String::Builder) : Nil
    io << (@banner || "options:")
    @help.each do |entry|
      io << '\n'
      if entry[0].starts_with?("-")
        io << "  " << entry[0]
        io << ", " << entry[1] unless entry[1].empty?
        io << "  " << entry[2]
      else
        io << entry[0]
      end
    end
  end

  def help : String
    String.build { |io| help(io) }
  end

  def to_s : String
    String.build { |io| help(io) }
  end
end
