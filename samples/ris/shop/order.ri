# A module of a ris program: a `.ri` file, imported by its path.
module shop/order

# A response that lives on the request's tape. `@[OnTape]` makes it a tape
# type: the compiler refuses to keep one anywhere that outlives the
# `Tape.scope` that made it.
@[OnTape]
pub struct Order
  getter id : Int64
  getter customer : TapeString
  getter lines : TapeArray(Int64)

  def initialize(@id : Int64, @customer : TapeString, @lines : TapeArray(Int64))
  end
end

pub def order_total(order : Order) : Int64
  sum = 0_i64
  order.lines.each { |price| sum += price }
  sum
end
