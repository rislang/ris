# UUIDs, RFC 9562 (which replaced RFC 4122), written in iyi.
#
# `UUID.v4` is 122 random bits with version 4 and the RFC variant bits;
# `UUID.v7` is the Unix time in milliseconds in its first 48 bits, then
# version 7, then random bits, so that UUIDs made later sort later - the
# kind a database index wants as a key. Every random bit comes from
# `Random::Secure`, the operating system's entropy: a UUID is often a
# name nobody else may guess, and the PCG generator `v4` drew from before
# is built for speed, not to keep its state from someone reading it.
#
# Either answers the hyphenated form through `to_s`; `parse` reads it
# back, or the 32 digits with no hyphens, and panics on a length, hyphen
# or hex digit that is not one.

module std/uuid

import std/int

import std/random::{Random}
import std/time::{Time}

pub struct UUID
  @bytes : Array(UInt8)

  # The sixteen bytes are the UUID's own, copied in here and out of
  # `bytes`, as the other library's are a value: held as the caller's
  # array, a buffer reused for the next record changed every UUID made
  # from it (`b[0] = 255_u8` after `UUID.new(b)` turned `00000000-...`
  # into `ff000000-...`), and `u.bytes[1] = 255_u8` changed a UUID that
  # was already a hash key, which its table then could not find.
  def initialize(bytes : Array(UInt8))
    raise "UUID: need 16 bytes, got #{bytes.size}" if bytes.size != 16
    @bytes = bytes.dup
  end

  def initialize(bytes : Str)
    raise "UUID: need 16 bytes" unless bytes.bytesize == 16
    @bytes = Array(UInt8).new(16) { |i| bytes[i] }
  end

  # Sixteen bytes from the operating system, six bits of them then set to
  # say version 4 and the RFC variant. Drawn from `Random.new`, they were
  # sixteen outputs of a fresh PCG generator: every UUID was a function of
  # the generator's 127 bits of state, and PCG makes no promise that its
  # outputs do not give that state away, where a version 4 UUID promises
  # 122 bits nobody can predict.
  def self.v4 : UUID
    result = nil.as(UUID?)
    tape do
      result = v4_on_tape.to_heap
    end
    result || raise "UUID: no result"
  end

  def self.v4_on_tape : TapeUUID
    storage = uninitialized StaticArray(UInt8, 16)
    bytes = pointerof(storage).as(Pointer(UInt8))
    Random::Secure.fill(bytes, 16)
    bytes[6] = (bytes[6] & 0x0f_u8) | 0x40_u8
    bytes[8] = (bytes[8] & 0x3f_u8) | 0x80_u8
    TapeUUID.new(Str.build(16) do |writer|
      i = 0
      while i < 16
        writer.push(bytes[i])
        i += 1
      end
    end)
  end

  # The millisecond `v7` last stamped and the 12-bit counter beside it.
  @@v7_ms = 0_i64
  @@v7_counter = 0

  # RFC 9562 version 7: 48 bits of Unix milliseconds, big-endian, then the
  # version, 12 bits of `rand_a`, the variant and 62 random bits.
  #
  # Two UUIDs from one millisecond would sort at random by their random
  # bits, so `rand_a` is a counter here (the RFC's "fixed bit-length
  # dedicated counter", section 6.2 method 1): a new millisecond starts it
  # at a random 11 bits, leaving at least 2,048 steps before it runs out,
  # and every UUID in the same millisecond, or one the clock stepped back
  # into, counts one up from the last. Past 4,095 the stamp moves on a
  # millisecond early, as the RFC allows. Each UUID this process makes
  # therefore sorts after the one before it, as bytes and as text; the
  # 62 bits after the counter are random every time, so two processes in
  # one millisecond still do not collide.
  def self.v7 : UUID
    result = nil.as(UUID?)
    tape do
      result = v7_on_tape.to_heap
    end
    result || raise "UUID: no result"
  end

  def self.v7_on_tape : TapeUUID
    storage = uninitialized StaticArray(UInt8, 16)
    bytes = pointerof(storage).as(Pointer(UInt8))
    Random::Secure.fill(bytes, 16)
    now = Time.utc.to_unix_ms
    if now > @@v7_ms
      @@v7_ms = now
      @@v7_counter = ((bytes[6].to_i32 & 7) << 8) | bytes[7].to_i32
    elsif @@v7_counter < 4095
      @@v7_counter = @@v7_counter + 1
    else
      @@v7_ms = @@v7_ms + 1_i64
      @@v7_counter = ((bytes[6].to_i32 & 7) << 8) | bytes[7].to_i32
    end
    ms = @@v7_ms.to_u64
    i = 0
    while i < 6
      bytes[i] = ((ms >> ((5 - i) * 8)) & 255_u64).to_u8
      i = i + 1
    end
    bytes[6] = (0x70 | (@@v7_counter >> 8)).to_u8
    bytes[7] = (@@v7_counter & 255).to_u8
    bytes[8] = (bytes[8] & 0x3f_u8) | 0x80_u8
    TapeUUID.new(Str.build(16) do |writer|
      i = 0
      while i < 16
        writer.push(bytes[i])
        i += 1
      end
    end)
  end

  def self.parse(text : String) : UUID
    result = nil.as(UUID?)
    tape do
      result = parse(text.as_tape).to_heap
    end
    result || raise "UUID: no result"
  end

  def self.parse(text : Str) : TapeUUID
    n = text.bytesize
    unless n == 32 || (n == 36 && text[8] == 45_u8 &&
           text[13] == 45_u8 && text[18] == 45_u8 && text[23] == 45_u8)
      raise "UUID: not 32 hex digits: #{text.to_heap}"
    end
    bytes = Str.build(16) do |w|
      i = 0
      while i < n
        if n == 36 && (i == 8 || i == 13 || i == 18 || i == 23)
          i += 1
          next
        end
        hi = nibble(text[i].unsafe_chr)
        lo = nibble(text[i + 1].unsafe_chr)
        w.push(((hi << 4) | lo).to_u8)
        i += 2
      end
    end
    TapeUUID.new(bytes)
  end

  def to_s : String
    result = ""
    tape do
      result = to_tape.to_heap
    end
    result
  end

  def to_tape : Str
    Str.build(36) { |w| write(w) }
  end

  def write(writer : Str::Builder) : Nil
    digits = "0123456789abcdef"
    i = 0
    while i < 16
      writer << "-" if i == 4 || i == 6 || i == 8 || i == 10
      b = @bytes[i].to_i32
      writer << digits[b >> 4] << digits[b & 15]
      i += 1
    end
  end

  def bytes : Array(UInt8)
    @bytes.dup
  end

  def ==(other : UUID) : Bool
    theirs = other.stored
    i = 0
    while i < 16
      return false if @bytes[i] != theirs[i]
      i = i + 1
    end
    true
  end

  protected def stored : Array(UInt8)
    @bytes
  end

  # Hashing follows `==`: the sixteen bytes, as an array of them hashes.
  # Without it every UUID hashed to its type, so the all-zero and the all-f
  # UUIDs hashed alike and a table of 16,000 UUID keys took 2.0 s to fill
  # where the same UUIDs as strings took 5 ms.
  def hash : Int32
    @bytes.hash
  end

  def version : Int32
    (@bytes[6].to_i32 >> 4) & 15
  end

  private def self.nibble(ch : Char) : Int32
    o = ch.ord
    return o - 48 if o >= 48 && o <= 57
    return o - 97 + 10 if o >= 97 && o <= 102
    return o - 65 + 10 if o >= 65 && o <= 70
    raise "UUID: not a hex digit: #{ch}"
  end
end

# Sixteen decoded bytes on the caller's tape.
@[OnTape]
pub struct TapeUUID
  getter bytes : Str

  def initialize(@bytes : Str)
    raise "UUID: need 16 bytes" unless @bytes.bytesize == 16
  end

  def version : Int32
    (@bytes[6].to_i32 >> 4) & 15
  end

  def to_heap : UUID
    UUID.new(@bytes)
  end

  def to_tape : Str
    Str.build(36) { |w| write(w) }
  end

  def write(writer : Str::Builder) : Nil
    digits = "0123456789abcdef"
    i = 0
    while i < 16
      writer << "-" if i == 4 || i == 6 || i == 8 || i == 10
      b = @bytes[i].to_i32
      writer << digits[b >> 4] << digits[b & 15]
      i += 1
    end
  end
end
