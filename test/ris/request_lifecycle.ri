module test/ris/request_lifecycle

# Accepted requests retain their effects after timeout, including stale reuse.
group do |g|
  ready = g.new_event
  done = g.new_event
  w = g.new_worker(RisInbox::Request(Str, Int32), 2) do |inbox|
    req = inbox.receive
    if req.is_a?(RisInbox::Request(Str, Int32))
      ready.fire
      sleep(15)
      raise "late reply" unless req.reply(1).is_a?(RisInbox::Expired)
      raise "accepted message" unless req.message == Str.new("retained")
      done.fire
    end
  end
  raise "timeout" unless w.request(Str.new("retained"), 5).is_a?(TimedOut)
  raise "accepted" unless ready.fired? == true
  done.wait
end

# Graceful close retains queued requests and permits replies.
group do |g|
  w = g.new_worker(RisInbox::Request(Int32, Int32), 2) do |inbox|
    sleep(2)
    inbox.close
    req = inbox.receive
    if req.is_a?(RisInbox::Request(Int32, Int32))
      raise "close reply" unless req.reply(req.message + 1).nil?
    end
  end
  raise "closed queue" unless w.request(41, 1000) == 42
end

# Owner exits after accepting a request but before replying.
group do |g|
  w = g.new_worker(RisInbox::Request(Int32, Int32), 1) do |inbox|
    inbox.receive
    nil
  end
  raise "owner death" unless w.request(1, 1000).is_a?(RisInbox::Closed)
end

# Full copies nothing, preserves the live slot and permits a smaller reply.
group do |g|
  w = g.new_worker(RisInbox::Request(Int32, Str), 1) do |inbox|
    req = inbox.receive
    if req.is_a?(RisInbox::Request(Int32, Str))
      raise "full" unless req.reply(Str.new("too large")).is_a?(RisInbox::Full)
      raise "smaller" unless req.reply(Str.new("ok")).nil?
    end
  end
  raise "retry" unless w.request(1, 1000, reply_bytes: 40) == Str.new("ok")
end

# Cancel a requester without cancelling the inbox owner.
group do |g|
  started = g.new_event
  release = g.new_event
  w = g.new_worker(RisInbox::Request(Int32, Int32), 1) do |inbox|
    req = inbox.receive
    started.fire
    release.wait
    if req.is_a?(RisInbox::Request(Int32, Int32))
      raise "cancelled token" unless req.reply(2).is_a?(RisInbox::Expired)
    end
  end
  group do |requests|
    t = requests.spawn { w.request(1, 1000) }
    started.wait
    requests.cancel_children
    raise "cancel" unless t.value.is_a?(Cancelled)
  end
  release.fire
  w.value
end
puts "PASS: request lifecycle"
