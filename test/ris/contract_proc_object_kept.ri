# A proc handed an object whose methods neither shrink nor keep storage
# (no getter hands out its text): the call needs no proof.
class Label
  getter uses : Int32 = 0

  def initialize(@name : String)
  end

  def size : Int32
    @name.bytesize
  end

  def use : Nil
    @uses += 1
  end
end

def invoke(callback : Proc(Label, Nil), label : Label)
  callback.call(label)
  puts "#{label.size} #{label.uses}"
end

callback = ->(label : Label) { label.use; nil }
tape do
  name = ""
  name << "tag"
  invoke(callback, Label.new(name))
end
