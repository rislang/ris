module test/ris/sync_basic

group do |g|
  s = g.new_semaphore(1)
  raise "initial permit" unless s.acquire.nil?
  raise "empty poll" unless s.acquire(0).is_a?(TimedOut)
  before = __iyi_monotonic_ns
  raise "timed acquire" unless s.acquire(3).is_a?(TimedOut)
  raise "early timeout" unless __iyi_monotonic_ns - before >= 3000000
  s.release
  raise "hold value" unless s.hold { 17 } == 17
  raise "hold release" unless s.acquire(0).nil?
  s.release
  e = g.new_event
  raise "initial event" unless e.fired? == false
  raise "event poll" unless e.wait(0).is_a?(TimedOut)
  raise "timed event" unless e.wait(3).is_a?(TimedOut)
  100.times do
    g.spawn do
      raise "broadcast" unless e.wait.nil?
      nil
    end
  end
  sleep(1)
  e.fire
  e.fire
  raise "fired" unless e.fired? == true
  raise "latch" unless e.wait(0).nil?
end
puts "PASS: sync basic"
