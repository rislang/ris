# ls: lists a directory, sorted. Options: -l sizes, -e EXT filter by ending.
module samples/trial/ls

import std/dir::{Dir}
import std/file
import std/option_parser::{OptionParser, RisOptions}

parser = OptionParser.new
parser.banner = "usage: ls [-l] [-e EXT] DIR"
long = parser.on("-l", "sizes")
ending = parser.on("-e EXT", "list only names with this ending")
found = RisOptions.new
rest = parser.parse(Program.args, found)
if rest.empty?
  puts parser
  exit 2
end
dir = rest[0]
ext = found[ending]? || ""
Dir.children(dir).sort.each do |name|
  next unless name.ends_with?(ext)
  if found.has?(long)
    puts "#{File.size(File.join(dir, name))} #{name}"
  else
    puts name
  end
end
