@[OnTape]
struct N
  getter a : String
  def initialize(@a : String)
  end
end

@[OnTape]
struct P
  def initialize
    @nodes = Array(N).new(8)
  end

  def node(a : Int32) : Int32
    @nodes << N.new("node #{a}")
    @nodes.size - 1
  end

  def pipe(d : Int32) : Int32
    return 0 if d > 3
    b = other(d + 1)
    node(b)
  end

  def other(d : Int32) : Int32
    pipe(d)
  end
end
p = P.new
puts p.pipe(0)
