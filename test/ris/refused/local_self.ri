module test/ris/refused/local_self
@[OnTape]
struct Holder
  @values : Tape::Array(Tape::String)
  def initialize
    @values = Tape::Array(Tape::String).new
  end
  def escape : Nil
    Tape.local do
      @values.push(Tape::String.build { |w| w.append("inner") })
    end
  end
end
Tape.run do
  h = Holder.new
  h.escape
end
