# spec: 1.4@6085c194, 7.3@1ce159dc
# Array and builders are handles: growth through b shows through a; a
# String alias keeps its bytes when the builder grows (SPEC 1.4, 7.3).
a = [1, 2]
b = a
b << 3
raise "array alias" unless a.size == 3 && a[2] == 3
s = String::Builder.new
s << "ab"
t = s.to_s
u = s
u << "cd"
raise "builder alias" unless s.to_s == "abcd"
raise "text kept" unless t == "ab"
puts "PASS: handles alias"
