def invoke(callback : Proc(String::Builder, Nil), bytes : String::Builder)
  chosen = if Program.args.empty?
             ->(value : String::Builder) { puts value.finish }
           else
             callback
           end
  view = bytes.finish
  chosen.call(bytes)
  puts view
end

callback = ->(bytes : String::Builder) { bytes.clear; nil }
tape { invoke(callback, String::Builder.new) }
