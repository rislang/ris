# Runtime-private storage for the future board. Mutations require the
# scheduler lock; unpublished copies may write their own bytes unlocked.
# release returns unpublished storage on rollback as well as after use.
private struct RisMessageRecord
  property free_next : Int32 = -1
  property recycled : Bool = false
  property generation : UInt64 = 1_u64
  property live : Bool = false
  property pins : Int32 = 0

  def initialize
  end
end

private struct RisMessageImage
  property live : Bool = false
  property following : Int32 = -1
  property charge : UInt64 = 0_u64
  property text : UInt64 = 0_u64
  property length : Int32 = 0
  # Inline scalar representation; read only with the handle's T.
  property kind : Int32 = 0
  property bits : UInt128 = 0_u128

  def initialize
  end
end

private module RisMessagePool
  RECORDS = 4096
  MESSAGES = 65536
  @@record_free : Int32 = 0
  @@message_free : Int32 = 0
  @@storage_heads : UInt64 = 0_u64
  @@storage_maps : UInt64 = 0_u64
  @@records : UInt64 = 0_u64
  @@messages : UInt64 = 0_u64

  def self.init : Nil
    return if @@records != 0
    @@records = __iyi_mmap(RECORDS.to_u64 * sizeof(RisMessageRecord)).address
    @@messages = __iyi_mmap(MESSAGES.to_u64 * sizeof(RisMessageImage)).address
    @@storage_heads = __iyi_mmap(16_u64 * 8_u64).address
    i = 0
    while i < RECORDS
      record(i).value = RisMessageRecord.new
      record(i).value.free_next = i + 1 < RECORDS ? i + 1 : -1
      i += 1
    end
    i = 0
    while i < MESSAGES
      message(i).value = RisMessageImage.new
      message(i).value.following = i + 1 < MESSAGES ? i + 1 : -1
      i += 1
    end
  end

  def self.record(slot : Int32) : Pointer(RisMessageRecord)
    Pointer(RisMessageRecord).new(@@records) + slot
  end

  def self.message(slot : Int32) : Pointer(RisMessageImage)
    Pointer(RisMessageImage).new(@@messages) + slot
  end

  def self.valid?(slot : Int32, generation : UInt64) : Bool
    @@records != 0 && slot >= 0 && slot < RECORDS &&
      record(slot).value.live && record(slot).value.generation == generation
  end

  def self.exhausted : NoReturn
    RisHeap.text("ris: fatal: message storage exhausted; use fewer live slots\n")
    __iyi_exit(1)
  end

  def self.allocate : Tuple(Int32, UInt64)
    init
    slot = @@record_free
    exhausted if slot < 0
    p = record(slot)
    generation = p.value.generation
    @@record_free = p.value.free_next
    r = RisMessageRecord.new
    r.generation = generation
    r.live = true
    p.value = r
    {slot, generation}
  end

  # Retire only after every private copy has released its pin.
  def self.retire(slot : Int32, generation : UInt64) : Nil
    return unless valid?(slot, generation)
    p = record(slot)
    r = p.value
    r.live = false
    r.generation += 1_u64 unless r.generation == 18446744073709551615_u64
    p.value = r
    recycle(p)
  end

  def self.allocate_message : Int32
    i = @@message_free
    exhausted if i < 0
    @@message_free = message(i).value.following
    m = RisMessageImage.new
    m.live = true
    message(i).value = m
    i
  end

  # Power-of-two classes 32 bytes through 1 MiB, including the header.
  # Slabs have at least 64 KiB; larger texts map directly.
  def self.storage_size(length : Int32) : UInt64
    size = 32_u64
    needed = length.to_u64 + 16_u64
    while size < needed && size < 1048576_u64
      size *= 2_u64
    end
    size
  end

  def self.storage_head(size : UInt64) : Pointer(UInt64)
    index = 0
    n = 32_u64
    while n < size
      index += 1
      n *= 2_u64
    end
    Pointer(UInt64).new(@@storage_heads) + index
  end

  def self.allocate_text(length : Int32) : UInt64
    needed = length.to_u64 + 16_u64
    if needed > 1048576_u64
      @@storage_maps += 1_u64
      return __iyi_mmap(needed).address
    end
    size = storage_size(length)
    head = storage_head(size)
    if head.value == 0
      bytes = size < 65536_u64 ? 65536_u64 : size
      @@storage_maps += 1_u64
      base = __iyi_mmap(bytes).address
      offset = 0_u64
      while offset < bytes
        Pointer(UInt64).new(base + offset).value = head.value
        head.value = base + offset
        offset += size
      end
    end
    result = head.value
    head.value = Pointer(UInt64).new(result).value
    result
  end

  def self.release(slot : Int32) : Nil
    m = message(slot).value
    if m.text != 0
      if m.length.to_u64 + 16_u64 > 1048576_u64
        __iyi_munmap(m.text, m.length.to_u64 + 16_u64)
      else
        head = storage_head(storage_size(m.length))
        Pointer(UInt64).new(m.text).value = head.value
        head.value = m.text
      end
    end
    message(slot).value = RisMessageImage.new
    message(slot).value.following = @@message_free
    @@message_free = slot
  end

  def self.storage_maps : UInt64
    @@storage_maps
  end

  def self.recycle(p : Pointer(RisMessageRecord)) : Nil
    r = p.value
    return if r.live || r.pins != 0 || r.recycled
    return if r.generation == 18446744073709551615_u64
    r.recycled = true
    r.free_next = @@record_free
    @@record_free = (p - Pointer(RisMessageRecord).new(@@records)).to_i32
    p.value = r
  end

end

private module RisMessageCodec(T)
  def self.extra(value : T) : UInt64
    {% for arm in T.union_types %}
      if value.is_a?({{arm}})
        {% if arm == Str %}
          return (value.bytesize.to_u64 + 23_u64) & 0xFFFFFFFFFFFFFFF8_u64
        {% else %}
          return 0_u64
        {% end %}
      end
    {% end %}
    0_u64
  end

  # Caller owns m privately, or holds the scheduler lock.
  def self.store(value : T, m : RisMessageImage, locked : Bool = false) : RisMessageImage
    {% for arm, index in T.union_types %}
      if value.is_a?({{arm}})
        {% if arm == Str %}
          m.length = value.bytesize
          IyiSchedLock.lock unless locked
          m.text = RisMessagePool.allocate_text(m.length)
          IyiSchedLock.unlock unless locked
          Pointer(UInt8).new(m.text + 16_u64).copy_from(value.to_unsafe, m.length)
        {% else %}
          pointerof(m.@bits).as(Pointer({{arm}})).value = value
        {% end %}
        m.kind = {{index}}
        return m
      end
    {% end %}
    m
  end

  def self.load(m : RisMessageImage) : T
    {% for arm, index in T.union_types %}
      if m.kind == {{index}}
        {% if arm == Str %}
          return Str.new(Str.new(Pointer(UInt8).new(m.text + 16_u64), m.length))
        {% else %}
          return pointerof(m.@bits).as(Pointer({{arm}})).value
        {% end %}
      end
    {% end %}
    raise "invalid message payload tag"
  end
end
