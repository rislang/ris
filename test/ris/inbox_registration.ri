module test/ris/inbox_registration

module ::RegistrationRace
  @@group : IyiGroup? = nil
  @@phase : Atomic(Int32) = Atomic(Int32).new(0)
  @@finished : Atomic(Int32) = Atomic(Int32).new(0)

  def self.reset : Nil
    @@phase.set(0)
    @@finished.set(0)
  end

  def self.publish(g : IyiGroup) : Nil
    @@group = g
    @@phase.set(1)
  end

  def self.scope : IyiGroup
    while @@phase.get == 0
      sleep(0)
    end
    g = @@group
    return g if g
    raise "missing group"
  end

  def self.finished=(n : Int32) : Nil
    @@finished.set(n)
  end

  def self.finished : Int32
    @@finished.get
  end
end

100.times do |iteration|
  RegistrationRace.reset
  group do |outer|
    contender = outer.spawn_parallel do
      g = RegistrationRace.scope
      if iteration % 3 == 0
        g.spawn { RegistrationRace.finished = 1; nil }
      elsif iteration % 3 == 1
        g.new_worker(Int32, 1) do |q|
          raise "race worker close" unless q.receive.is_a?(RisInbox::Closed)
          RegistrationRace.finished = 1
          nil
        end
      else
        g.spawn_parallel { RegistrationRace.finished = 1; nil }
      end
      7
    end
    group do |draining|
      RegistrationRace.publish(draining)
      # Alternate immediate sealing with an open registration window.
      sleep(1) if iteration % 4 >= 2
    end
    completed_at_end = RegistrationRace.finished
    result = contender.value
    if result.is_a?(Panicked)
      raise "wrong seal refusal" unless result.message ==
        "the group has ended; create this work in a live outer group"
      raise "sealed work ran" unless completed_at_end == 0
    else
      raise "adopted work unjoined" unless result == 7 && completed_at_end == 1
    end
  end
end
puts "PASS: inbox registration"
