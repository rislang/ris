import std/rsa::{RsaPublicKey, RsaHash}

def unhex(hex : String) : Array(UInt8)
  Array(UInt8).new(hex.bytesize // 2) do |i|
    hex[i * 2, 2].to_i(16).to_u8
  end
end

key = RsaPublicKey.from_spki(unhex("")).or_panic
signature = unhex("")
raise "byte message" unless key.verify_pss(RsaHash::SHA256,
                              [97_u8, 98_u8, 99_u8], signature)
raise "borrowed String message" unless key.verify_pss(RsaHash::SHA256,
                                         "abc", signature)
