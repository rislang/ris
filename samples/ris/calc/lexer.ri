@[NoSpec("sample program; its defs are shown, not promised")]
module calc/lexer

# What the scanner produces. A token is its kind, the text it covers and where
# it started, because an error that cannot say where is half an error.
@[OnTape]
pub struct Token
  getter kind : String
  getter text : String
  getter at : Int32

  def initialize(@kind : String, @text : String, @at : Int32)
  end
end

pub struct BadCharacter
  getter at : Int32
  getter found : UInt8

  def initialize(@at : Int32, @found : UInt8)
  end
end

impl Error for BadCharacter
  def message : String
    "unexpected character at #{at}"
  end
end

pub def scan(source : String) : Array(Token) | BadCharacter
  tokens = [] of Token
  index = 0

  while index < source.size
    c = source[index]

    # A line ends in CRLF on Windows: `echo 2 + 3 * 4| iyi run
    # samples\iyi\calc.ri` in cmd answered "unexpected character at 9",
    # the `\r`.
    if c == 32_u8 || c == 10_u8 || c == 9_u8 || c == 13_u8
      index = index + 1
    elsif digit?(c)
      start = index
      while index < source.size && digit?(source[index])
        index = index + 1
      end
      tokens << Token.new("number", source[start, index - start], start)
    elsif letter?(c)
      start = index
      while index < source.size && (letter?(source[index]) || digit?(source[index]))
        index = index + 1
      end
      tokens << Token.new("name", source[start, index - start], start)
    elsif operator?(c)
      tokens << Token.new("op", source[index, 1], index)
      index = index + 1
    else
      return BadCharacter.new(index, c)
    end
  end

  tokens << Token.new("end", "", index)
  tokens
end

def digit?(c : UInt8) : Bool
  c >= '0'.ord.to_u8 && c <= '9'.ord.to_u8
end

def letter?(c : UInt8) : Bool
  (c >= 'a'.ord.to_u8 && c <= 'z'.ord.to_u8) ||
    (c >= 'A'.ord.to_u8 && c <= 'Z'.ord.to_u8) || c == '_'.ord.to_u8
end

def operator?(c : UInt8) : Bool
  c == '+'.ord.to_u8 || c == '-'.ord.to_u8 || c == '*'.ord.to_u8 ||
    c == '/'.ord.to_u8 || c == '('.ord.to_u8 || c == ')'.ord.to_u8 ||
    c == '='.ord.to_u8
end
