module test/ris/owned

# A retained destination says what it accepts in its interface.
class Cache
  getter body : String

  def initialize
    @body = ""
  end

  def store(body : String) : Nil
    @body = body
  end
end

# The copy a caller keeps, made at the boundary it leaves the tape by.
@[TapeToHeap]
def retain(text : String) : String
  text.to_s
end

# A method name describes the work; the return type describes the lifetime.
def page : String
  String.build(1) { |writer| writer.append("café <&>") }
end

@[TapeToHeap]
def retained_page : String
  tape do
    return page.to_s
  end
  "".to_heap
end

cache = Cache.new
tape do
  borrowed = page
  owned = retain(borrowed)
  cache.store(owned)
  same = borrowed == owned && borrowed == "café <&>"
  raise "copy differs from source" unless same
  empty = String.build(0) { |writer| }
  raise "empty copy changed" unless empty == ""
end
tape do
  overwrite = page
end
raise "retained text changed after scope reuse" unless cache.body == "café <&>"
raise "owned return changed" unless retained_page == "café <&>"
raise "return lost implicit tape" unless RisRegion.tape != 0_u64
puts "PASS: explicit owned copy, typed cache boundary, UTF-8, empty text and scope reuse"
