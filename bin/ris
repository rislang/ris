#!/bin/sh

# ris, run out of this checkout: `./bin/ris run samples/ris/hello.ri`.
#
# `bin/crystal` next to this file is the wrapper Crystal ships, and it has work
# to do: find a parent compiler to bootstrap from, set `IYI_PATH` to this
# checkout, ask the installed compiler where its libraries are, and say which
# binary it ended up using. None of that applies here. `.build/iyi` is built
# with its prelude's location baked in relative to itself, which is the same
# thing that makes the tarball relocatable, so this script only has to find the
# binary and get out of the way.

root=$(cd -- "$(dirname -- "$0")/.." && pwd -P)

if [ -x "$root/.build/ris.exe" ]; then
  exec "$root/.build/ris.exe" "$@"
elif [ -x "$root/.build/ris" ]; then
  exec "$root/.build/ris" "$@"
fi

echo "ris is not built yet. Run \`make ris\` in $root." 1>&2
exit 1
