@[Owner]
struct BranchOwner
  getter bytes = String::Builder.new
end

tape do
  outer = String::Builder.new
  outer.append("outer")
  text = if Program.args.empty?
           owner = BranchOwner.new
           owner.bytes << "inner"
           owner.bytes.finish
         else
           outer.finish
         end
  puts text
end
