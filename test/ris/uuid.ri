module test/uuid_driver

import std/uuid::{UUID}

kept = ""
owned = nil.as(UUID?)
tape do
  text = "550E8400-E29B-41D4-A716-446655440000"
  uuid = UUID.parse(text)
  canonical = uuid.to_tape
  w = String::Builder.new(1)
  w << "prefix:"
  uuid.write(w)
  compact = UUID.parse("550e8400e29b41d4a716446655440000")
  owned = uuid.copy_to(Program.tape)
  kept = canonical.copy_to(Program.tape)
end
puts "PASS: uuid views and owned copy"
