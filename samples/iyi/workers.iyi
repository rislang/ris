# A worker pool and a typed pair of tasks (SPEC.md III.4).
#
#   ./bin/ris run samples/iyi/workers.iyi
module samples/workers

# 1. Work and quit share one nominal queue; results use another.
pub struct Job
  pub struct Work
    getter number : Int32

    def initialize(@number : Int32)
    end
  end

  pub struct Quit
  end

  getter kind : Work | Quit

  def initialize(@kind : Work | Quit)
  end

  def self.work(number : Int32) : Job
    new(Work.new(number))
  end

  def self.quit : Job
    new(Quit.new)
  end
end

pub struct Result
  getter square : Int32

  def initialize(@square : Int32)
  end
end

# Room for all six jobs and three quits, even before workers run.
RisBoard.limit(Job, 9_i64)
RisBoard.limit(Result, 6_i64)

group do |g|
  3.times do
    g.spawn do
      loop do
        job = RisBoard.take(Job)
        break if job.is_a?(Cancelled)
        case job.kind
        in Job::Work
          unless RisBoard.post(Result.new(it.number * it.number))
            raise "result queue full; result was not published"
          end
        in Job::Quit then break
        end
      end
      0
    end
  end

  (1..6).each do |n|
    unless RisBoard.post(Job.work(n))
      raise "job queue full; job was not published"
    end
  end
  # Each accepted quit ends one worker, after earlier work is taken.
  3.times do
    unless RisBoard.post(Job.quit)
      raise "job queue full; quit was not published"
    end
  end

  total = 0
  6.times do
    result = RisBoard.take(Result)
    raise "result collection cancelled" if result.is_a?(Cancelled)
    total += result.square
  end
  puts total # => 91, the squares of one to six
end

# Group end joins every worker; it does not close or drain the board.

# 2. Two fetches at once, and the pair or the first error.
struct Timeout
  def initialize(@what : String)
  end
end

impl Error for Timeout
  # Error#message answers a String, built without text of its own; the
  # caller adds the rest where it prints.
  def message : String
    @what
  end
end

def read(name : String) : Str | Timeout
  return Timeout.new(name) if name == "slow"
  "<#{name}>"
end

# `end!` makes the group a value: the tuple of what the two tasks answered,
# or the first error member. `Panicked` is there because a task that panics
# answers it (III.1.4), and the signature says so.
def both(a : String, b : String) : Tuple(Str, Str) | Timeout | Panicked
  group do |g|
    x = g.spawn { read(a) }
    y = g.spawn { read(b) }
  end!
end

case both("one", "two")
in Tuple(Str, Str)       then puts it # => {"<one>", "<two>"}
in Timeout               then puts it.message
in Panicked              then puts "panicked"
end

case both("one", "slow")
in Tuple(Str, Str)       then puts it
in Timeout               then puts "#{it.message} timed out" # => slow timed out
in Panicked              then puts "panicked"
end
