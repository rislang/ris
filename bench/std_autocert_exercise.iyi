# Exercises std/autocert.
#
# With no argument, or a directory to keep its cache in: the directory
# cache read, written over and refused a key that is not a file's name;
# the host policy refusing a name before the CA is asked, counted at a
# listener that stands where the CA's directory would be; a failure
# remembered, so the next handshake asks nothing; a cached chain shown
# when it reaches the manager's roots and not otherwise; a handshake's
# wait for an order cut to its deadline, with `run` and without, against
# a CA that never answers; when a certificate is due for renewal;
# tls-alpn-01's certificate shown under acme-tls/1 alone and http-01's
# answer on port 80.
#
# The modes the gate script drives (bench/std_autocert_client.py):
#   challenge-serve DIR
#       an HTTPS server whose manager holds a tls-alpn-01 challenge for
#       alpn.autocert.example, on a port written to DIR/port, its key
#       authorization to DIR/alpn.txt, until it is stopped;
#   serve DIRECTORY MINICA ROOTS CACHE TLS_PORT HTTP_PORT HOSTS CHALLENGES READY
#       an HTTPS server on TLS_PORT whose manager gets certificates for
#       HOSTS (by commas) from the ACME server at DIRECTORY - trusted by
#       MINICA - by CHALLENGES in that order, checks each chain to ROOTS,
#       answers http-01 on HTTP_PORT, keeps them in CACHE and renews
#       them; READY written once it listens. It answers every request
#       with the count of orders and renewals it has made.

import std/autocert::{Autocert, AutocertConfig, AutocertView,
  AutocertDirCache, AutocertError, AutocertHeld}
import std/x509::{Certificate, SigningKey, X509Error}
import std/ecdsa::{EcdsaPublicKey, EcdsaCurve}
import std/http::{HTTP, Request, Response, Server}
import std/socket::{IyiSocket}
import std/tls::{TlsConfig, TlsError, TlsIdentity, TlsVersion, TlsAlert, TlsServer, TlsClient, TlsServerConfig}
import std/file::{File}
import std/dir::{Dir}
import std/random::{Random}
import std/time::{Time, Span}

# Part A API/capture migration only. The driver and its mutation rules
# are updated in Part B; observations still use the existing board probe.
def autocert_view(directory : String, cache : AutocertDirCache,
                  hosts : Array(String)) : AutocertView
  names = Array(String).new(hosts.size)
  hosts.each { |name| names << name.as_tape }
  AutocertView.new(AutocertConfig.new(directory.as_tape,
    cache.dir.as_tape, names))
end

@[OnTape]
struct AutocertBenchStartup
  getter config : AutocertConfig
  def initialize(@config : AutocertConfig)
  end
end

@[OnTape]
struct AutocertBenchServer
  getter config : AutocertConfig
  getter port : Int32
  def initialize(@config : AutocertConfig, @port : Int32)
  end
end

@[OnTape]
struct AutocertBenchClient
  getter name : String
  getter port : Int32
  def initialize(@name : String, @port : Int32)
  end
end

@[OnTape]
class AutocertBenchHandler
  @view : AutocertView
  getter tls_config : TlsServerConfig?
  @ready : String

  def initialize(settings : Tuple(AutocertConfig, Bool, String))
    config, tls, @ready = settings
    @view = AutocertView.new(config)
    @tls_config = tls ? @view.tls_config : nil
    if server = @tls_config
      server.min_version = TlsVersion::TLS12
    end
  end

  def listening(port : Int32) : Nil
    File.write(@ready.to_heap, "ready\n") unless @ready.empty?
  end

  def call(request : Request) : Response
    @view.answer(request) || Response.new(200,
      "orders #{@view.orders} renewals #{@view.renewals}\n")
  end
end

ACME_IDENTIFIER = "1.3.6.1.5.5.7.1.31"

