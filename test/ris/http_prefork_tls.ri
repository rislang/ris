# TLS configuration and ticket state are constructed within each worker.
module test/ris/http_prefork_tls

import std/http::{Server, Request, Response}
import std/tls::{TlsIdentity, TlsServerConfig, TlsError}
import std/socket::{IyiSocket}
import std/signal::{Signal}
import std/time::{Time}

struct Ready
end

class Handler
  getter tls_config : TlsServerConfig
  @calls : Int32 = 0

  def initialize(paths : Tuple(String, String))
    identity = TlsIdentity.new(
      File.read(paths[0]), File.read(paths[1]))
    raise identity.error.as(TlsError).message if identity.error
    config = TlsServerConfig.new(identity)
    @tls_config = config
    @tls_config.alpn = ["h2", "http/1.1"]
  end

  def listening(port : Int32) : Nil
    RisBoard.post(Ready.new)
  end

  def call(req : Request) : Response
    Response.new(200, answer_text(req))
  end

  def answer_text(req : Request) : String
    raise "TLS request panic" if req.path == "/panic"
    @calls += 1
    started = Time.monotonic_nanoseconds
    sleep(100) if req.path == "/hold"
    "#{IyiScheduler.current.object_id} #{@calls} " +
      "#{started} #{Time.monotonic_nanoseconds}"
  end

end

port = Program.arguments[0].to_i
count = Program.arguments[1].to_i
group do |g|
  g.spawn do
    args = Program.arguments
    Server.serve("127.0.0.1", port, {args[2], args[3]}, Handler,
      max_connections: count)
    0
  end
  g.spawn do
    ready = true
    count.times do
      if RisBoard.take(Ready).is_a?(Cancelled)
        ready = false
        break
      end
    end
    if ready
      puts "READY"
      Signal.wait(Signal::TERM)
      g.cancel_children
    end
    0
  end
  0
end
# Rebind before process exit: OS teardown must not hide leaked listeners.
probe = IyiSocket.listen("127.0.0.1", port)
probe.close
puts "STOPPED"
sleep(500)
