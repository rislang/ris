module test/ris/math_no_heap

import std/math::{Math}

# Exact bits captured before moving the tables to StaticArray.
# Include small, ordinary, large and out-of-domain arguments.
# NaN results are checked by bits too, including their sign and payload.

raise "Math.sin(0.125)" unless
  IyiFloatText.bits_of(Math.sin(0.125)) == 4593648181988224566_u64
raise "Math.sin(0.75)" unless
  IyiFloatText.bits_of(Math.sin(0.75)) == 4604314875676561165_u64
