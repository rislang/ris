module test/password

import std/password::{Scrypt, Bcrypt}

# std/password on the tape: scrypt (RFC 7914 vectors) in one tape Array,
# bcrypt (an OpenBSD vector) with its table built on the tape.

def hex(bytes : Array(UInt8)) : String
  text = ""
  bytes.each do |byte|
    text << "0123456789abcdef"[byte.to_i32 >> 4, 1]
    text << "0123456789abcdef"[byte.to_i32 & 15, 1]
  end
  text
end

tape do
  puts hex(Scrypt.derive("", "", 16, 1, 1, 64))
  puts hex(Scrypt.derive("password", "NaCl", 1024, 8, 16, 64))
  puts Bcrypt.verify("U*U", "$2a$05$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOeW")
  puts Bcrypt.verify("U*V", "$2a$05$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOeW")
  made = Bcrypt.hash("tape", 4)
  puts "#{made.bytesize} #{made[0, 7]} #{Bcrypt.verify("tape", made)}"
end
