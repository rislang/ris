def pending_after_growth : Str
  temporary = Str::Builder.new(70 * 1024 * 1024)
  temporary.push(65_u8)
  Str.build(8) { |w| w.append("grown") }
end

def pending_from_side : Str
  writer = Str::Builder.new(1)
  writer.push(65_u8)
  blocker = Str::Builder.new(8)
  writer.append("BCDEFGHIJK")
  writer.finish[1, 3]
end

def pending_region : UInt64
  RisRegion.tape
end

tape do
  original = pending_region
  grown = pending_after_growth
  raise "wrong grown result" unless grown == "grown"
  raise "grown scratch retained" unless pending_region == original
  side = pending_from_side
  raise "wrong side result" unless side == "BCD"
  raise "side scratch retained" unless pending_region == original
  puts "PASS: pending results survive grown and side scratch rollback"
end
