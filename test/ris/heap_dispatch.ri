# spec: 1.2@08914ecc
# Virtual dispatch and union payloads never box: a class hierarchy and a
# String | Int32 | Nil union run with no heap allocation (SPEC 1.2).
abstract class Shape
  abstract def area : Int32
end

class Square < Shape
  def initialize(@side : Int32)
  end

  def area : Int32
    @side * @side
  end
end

class Rect < Shape
  def initialize(@w : Int32, @h : Int32)
  end

  def area : Int32
    @w * @h
  end
end

def pick(n : Int32) : String | Int32 | Nil
  case n
  when 0 then "zero"
  when 1 then n * 7
  else        nil
  end
end

total = 0
shapes = [Square.new(3), Rect.new(2, 5)] of Shape
shapes.each { |s| total += s.area }
3.times do |i|
  v = pick(i)
  total += v.size if v.is_a?(String)
  total += v if v.is_a?(Int32)
end
puts total
