GET = "GET / HTTP/1.1\r\nHost: localhost\r\n\r\n"

def check(label : String, got : String, wanted : String, failures : Array(String)) : Nil
  puts "#{label}: #{got}"
  return if got == wanted
  puts "FAIL #{label}: #{got}, not #{wanted}"
  failures << label
end

def dial(port : Int32) : IyiSocket
  socket = IyiSocket.connect("127.0.0.1", port, 2000)
  raise "cannot connect to #{port}" unless socket.is_a?(IyiSocket)
  socket
end

# An HTTP/1.1 answer read whole - its body is "HTTP/1.1" - within *ms*:
# its status line, or what came instead.
def answered(socket : IyiSocket, ms : Int32) : String
  socket.read_timeout_ms = ms
  heard = ""
  until heard.ends_with?("\r\n\r\nHTTP/1.1")
    got = socket.read(4096)
    return "timed out" if got.is_a?(SocketError) && got.timed_out?
    return "an error: #{got.operation}" if got.is_a?(SocketError)
    return "cancelled" if got.is_a?(Cancelled)
    return "the end" if got.empty?
    heard << got
  end
  heard.split("\r\n").first
end

# What the next read finds within *ms*: "the end" (0), "timed out",
# bytes, or an error (a reset among them).
def next_read(socket : IyiSocket, ms : Int32) : String
  socket.read_timeout_ms = ms
  got = socket.read(4096)
  return "timed out" if got.is_a?(SocketError) && got.timed_out?
  return "an error: #{got.operation} (#{got.code})" if got.is_a?(SocketError)
  return "cancelled" if got.is_a?(Cancelled)
  got.empty? ? "the end" : "#{got.bytesize} bytes"
end

def tls_asked(tls : TlsClient) : String
  tls.write(GET)
  heard = ""
  until heard.ends_with?("\r\n\r\nHTTP/1.1")
    got = tls.read
    return "no answer: #{got.message}" if got.is_a?(TlsError)
    return "the end" if got.empty?
    heard << got
  end
  heard.split("\r\n").first
end

# -- HTTP/2 by hand: frames of the bytes given.

def frame(type : Int32, flags : Int32, stream : Int32, payload : String) : String
  size = payload.bytesize
  head = String.build(9) do |w|
    w.push(((size >> 16) & 0xFF).to_u8)
    w.push(((size >> 8) & 0xFF).to_u8)
    w.push((size & 0xFF).to_u8)
    w.push(type.to_u8)
    w.push(flags.to_u8)
    w.push(((stream >> 24) & 0x7F).to_u8)
    w.push(((stream >> 16) & 0xFF).to_u8)
    w.push(((stream >> 8) & 0xFF).to_u8)
    w.push((stream & 0xFF).to_u8)
    nil
  end
  head + payload
end

# A field as a literal without indexing, its name the static table's
# *index*, so every byte is below 128.
def field(index : Int32, value : String) : String
  String.build(2 + value.bytesize) do |w|
    w.push(index.to_u8)
    w.push(value.bytesize.to_u8)
    w << value
    nil
  end
end

# The preface, an empty SETTINGS, and a GET of *path* on *stream*.
def h2_open(path : String, stream : Int32) : String
  "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n" + frame(4, 0, 0, "") + h2_get(path, stream)
end

def h2_get(path : String, stream : Int32) : String
  block = field(2, "GET") + field(6, "http") + field(4, path) + field(1, "localhost")
  frame(1, 5, stream, block)
end

# Frames read until stream *stream* ends (DATA or HEADERS with
# END_STREAM): "answered", or what came instead; a GOAWAY ends the wait
# as "GOAWAY <last stream id>". *held* keeps what was read, *at* (one
# number) how far frames were taken.
def h2_answered(socket : IyiSocket, held : String::Builder, at : Array(Int32), stream : Int32, ms : Int32) : String
  socket.read_timeout_ms = ms
  while true
    bytes = held.to_s
    while bytes.bytesize - at[0] >= 9
      from = at[0]
      size = (bytes.byte_at(from).to_i32 << 16) | (bytes.byte_at(from + 1).to_i32 << 8) | bytes.byte_at(from + 2).to_i32
      break if bytes.bytesize - from < 9 + size
      type = bytes.byte_at(from + 3).to_i32
      flags = bytes.byte_at(from + 4).to_i32
      id = ((bytes.byte_at(from + 5).to_i32 & 0x7F) << 24) | (bytes.byte_at(from + 6).to_i32 << 16) | (bytes.byte_at(from + 7).to_i32 << 8) | bytes.byte_at(from + 8).to_i32
      at[0] = from + 9 + size
      if type == 7
        last = ((bytes.byte_at(from + 9).to_i32 & 0x7F) << 24) | (bytes.byte_at(from + 10).to_i32 << 16) | (bytes.byte_at(from + 11).to_i32 << 8) | bytes.byte_at(from + 12).to_i32
        return "GOAWAY #{last}"
      end
      return "answered" if id == stream && (type == 0 || type == 1) && (flags & 1) == 1
    end
    got = socket.read(4096)
    return "timed out" if got.is_a?(SocketError) && got.timed_out?
    return "an error: #{got.operation}" if got.is_a?(SocketError)
    return "cancelled" if got.is_a?(Cancelled)
    return "the end" if got.empty?
    held << got
  end
  ""
end

failures = [] of String
clear = RisYieldServer.port
secure = RisYieldServer.port
stopping = RisYieldServer.port

group do |g|
  g.spawn do
    RisYieldServer.answer(clear, RisClearHandler)
    0
  end
  RisYieldServer.wait(RisClearHandler)
  g.spawn do
    RisYieldServer.answer(secure, RisTlsHandler)
    0
  end
  RisYieldServer.wait(RisTlsHandler)

  # 1, in the clear.
  a = dial(clear)
  a.write(GET)
  check("1 clear: A's first", answered(a, 2000), "HTTP/1.1 200 OK", failures)
  b = dial(clear)
  b.write(GET)
  check("1 clear: B, within 2 s", answered(b, 2000), "HTTP/1.1 200 OK", failures)
  check("1 clear: A then reads", next_read(a, 2000), "the end", failures)
  a.close
  b.close

  # 1, over TLS.
  store = RisCertificateStore.new
  if problem = store.read_pem(ROOT_PEM)
    raise problem.message
  end
  config = TlsConfig.new
  config.roots = store.kept_certificates
  config.alpn << "http/1.1"
  ta = TlsClient.new("localhost", config)
  if problem = ta.connect(secure, 2000)
    raise problem.message
  end
  check("1 TLS: A's first", tls_asked(ta), "HTTP/1.1 200 OK", failures)
  tb = TlsClient.new("localhost", config)
  if problem = tb.connect(secure, 2000)
    check("1 TLS: B's handshake, within 2 s", problem.message, "done", failures)
  else
    check("1 TLS: B, within 2 s", tls_asked(tb), "HTTP/1.1 200 OK", failures)
  end
  ended = ta.read
  check("1 TLS: A then reads", ended.is_a?(TlsError) ? ended.message : (ended.empty? ? "close_notify" : "#{ended.bytesize} bytes"), "close_notify", failures)
  ta.close
  tb.close

  # 2, HTTP/2.
  a = dial(clear)
  a.write(h2_open("/", 1))
  held = String::Builder.new(256)
  at = [0]
  check("2 h2: A's stream 1", h2_answered(a, held, at, 1, 2000), "answered", failures)
  b = dial(clear)
  b.write(GET)
  check("2 h2: B, within 2 s", answered(b, 2000), "HTTP/1.1 200 OK", failures)
  check("2 h2: A reads", h2_answered(a, held, at, 3, 2000), "GOAWAY 1", failures)
  check("2 h2: A then reads", held.bytesize > at[0] ? "#{held.bytesize - at[0]} bytes" : next_read(a, 2000), "the end", failures)
  a.close
  b.close

  # 3, a partial head.
  a = dial(clear)
  a.write(GET)
  check("3 partial: A's first", answered(a, 2000), "HTTP/1.1 200 OK", failures)
  a.write("GET / HT")
  sleep(100)
  b = dial(clear)
  b.write(GET)
  check("3 partial: B, while A's head is partial", next_read(b, 500), "timed out", failures)
  a.write("TP/1.1\r\nHost: localhost\r\n\r\n")
  check("3 partial: A's second", answered(a, 2000), "HTTP/1.1 200 OK", failures)
  check("3 partial: B, after A's answer", answered(b, 2000), "HTTP/1.1 200 OK", failures)
  a.close
  b.close

  # 4, an HTTP/2 stream open.
  a = dial(clear)
  a.write(h2_open("/", 1))
  held = String::Builder.new(256)
  at = [0]
  check("4 h2 open: A's stream 1", h2_answered(a, held, at, 1, 2000), "answered", failures)
  a.write(h2_get("/wait", 3))
  sleep(100)
  b = dial(clear)
  b.write(GET)
  check("4 h2 open: B, while A's stream is open", next_read(b, 500), "timed out", failures)
  raise "go queue full" unless RisBoard.post(RisGo.new)
  check("4 h2 open: A's stream 3", h2_answered(a, held, at, 3, 2000), "answered", failures)
  check("4 h2 open: B, after A's answer", answered(b, 2000), "HTTP/1.1 200 OK", failures)
  a.close
  b.close

  # 5, upgraded.
  a = dial(clear)
  a.write("GET /upgrade HTTP/1.1\r\nHost: localhost\r\nConnection: Upgrade\r\nUpgrade: hold\r\n\r\n")
  a.read_timeout_ms = 2000
  up = a.read(4096)
  check("5 upgraded: A", up.is_a?(String) ? up.split("\r\n").first : "no answer", "HTTP/1.1 101 Switching Protocols", failures)
  b = dial(clear)
  b.write(GET)
  check("5 upgraded: B, while A holds it", next_read(b, 500), "timed out", failures)
  a.close
  check("5 upgraded: B, after A ends it", answered(b, 2000), "HTTP/1.1 200 OK", failures)
  b.close

  # 6, connect only.
  a = dial(clear)
  a.write(GET)
  check("6 connect only: A's first", answered(a, 2000), "HTTP/1.1 200 OK", failures)
  b = dial(clear)
  sleep(1000)
  a.write(GET)
  check("6 connect only: A's second", answered(a, 2000), "HTTP/1.1 200 OK", failures)
  a.close
  b.close

  RisYieldServer.stop(RisClearHandler)
  RisYieldServer.stop(RisTlsHandler)
  check("the servers stop", "#{RisYieldServer.stopped?(RisClearHandler)}, #{RisYieldServer.stopped?(RisTlsHandler)}", "true, true", failures)

  # 7, the stop.
  g.spawn do
    RisYieldServer.answer(stopping, RisStopHandler)
    0
  end
  RisYieldServer.wait(RisStopHandler)
  a = dial(stopping)
  a.write(GET)
  check("7 stop: A's first", answered(a, 2000), "HTTP/1.1 200 OK", failures)
  sleep(100)
  RisYieldServer.stop(RisStopHandler)
  check("7 stop: serve returns", RisYieldServer.stopped?(RisStopHandler).to_s, "true", failures)
  check("7 stop: A then reads", next_read(a, 2000), "the end", failures)
  a.close
end

exit 1 unless failures.empty?
puts "ALL CHECKS PASSED"
exit 0
