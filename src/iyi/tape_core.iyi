# The everyday String and Array surface on Str and Ary, so a program's
# usual calls answer tape values and need no heap. Every result is built
# on the current tape; names follow Crystal's String and Array.

struct Str
  def split(separator : String | Str) : Ary(Str)
    pieces = Ary(Str).new
    if separator.bytesize == 0
      i = 0
      while i < bytesize
        pieces << self[i, 1]
        i += 1
      end
      return pieces
    end
    start = 0
    while at = byte_index(separator, start)
      pieces << self[start, at - start]
      start = at + separator.bytesize
    end
    pieces << self[start, bytesize - start]
    pieces
  end

  # Words split on runs of ASCII whitespace, as String#split with no
  # argument.
  def split : Ary(Str)
    pieces = Ary(Str).new
    i = 0
    while i < bytesize
      while i < bytesize && Str.space?(self[i])
        i += 1
      end
      start = i
      while i < bytesize && !Str.space?(self[i])
        i += 1
      end
      pieces << self[start, i - start] if i > start
    end
    pieces
  end

  def self.space?(byte : UInt8) : Bool
    byte == 32_u8 || (byte >= 9_u8 && byte <= 13_u8)
  end

  def upcase : Str
    Str.build(bytesize) do |w|
      each_byte { |b| w.push(b >= 97_u8 && b <= 122_u8 ? b - 32_u8 : b) }
    end
  end

  def downcase : Str
    Str.build(bytesize) do |w|
      each_byte { |b| w.push(b >= 65_u8 && b <= 90_u8 ? b + 32_u8 : b) }
    end
  end

  def capitalize : Str
    Str.build(bytesize) do |w|
      i = 0
      each_byte do |b|
        if i == 0
          w.push(b >= 97_u8 && b <= 122_u8 ? b - 32_u8 : b)
        else
          w.push(b >= 65_u8 && b <= 90_u8 ? b + 32_u8 : b)
        end
        i += 1
      end
    end
  end

  def lstrip : Str
    i = 0
    while i < bytesize && Str.space?(self[i])
      i += 1
    end
    self[i, bytesize - i]
  end

  def rstrip : Str
    j = bytesize
    while j > 0 && Str.space?(self[j - 1])
      j -= 1
    end
    self[0, j]
  end

  def strip : Str
    lstrip.rstrip
  end

  def chomp : Str
    return self[0, bytesize - 2] if bytesize >= 2 && self[bytesize - 2] == 13_u8 && self[bytesize - 1] == 10_u8
    return self[0, bytesize - 1] if bytesize >= 1 && self[bytesize - 1] == 10_u8
    self
  end

  def includes?(search : String | Str) : Bool
    !byte_index(search).nil?
  end

  def index(search : String | Str, offset : Int32 = 0) : Int32?
    byte_index(search, offset)
  end

  def count(search : String | Str) : Int32
    return 0 if search.bytesize == 0
    n = 0
    at = 0
    while found = byte_index(search, at)
      n += 1
      at = found + search.bytesize
    end
    n
  end

  # Every *search* replaced by *replacement*.
  def gsub(search : String | Str, replacement : String | Str) : Str
    return self if search.bytesize == 0
    Str.build(bytesize) do |w|
      start = 0
      while at = byte_index(search, start)
        w.append(self[start, at - start])
        w.append(replacement)
        start = at + search.bytesize
      end
      w.append(self[start, bytesize - start])
    end
  end

  # The first *search* replaced by *replacement*.
  def sub(search : String | Str, replacement : String | Str) : Str
    at = byte_index(search)
    return self unless at
    Str.build(bytesize) do |w|
      w.append(self[0, at])
      w.append(replacement)
      w.append(self[at + search.bytesize, bytesize - at - search.bytesize])
    end
  end

  def reverse : Str
    Str.build(bytesize) do |w|
      i = bytesize
      while i > 0
        i -= 1
        w.push(self[i])
      end
    end
  end

  def lines : Ary(Str)
    result = Ary(Str).new
    each_line { |line| result << line }
    result
  end

  def chars : Ary(Char)
    result = Ary(Char).new(bytesize < 4 ? 4 : bytesize)
    each_char { |c| result << c }
    result
  end

  def each_char(& : Char -> Nil) : Nil
    i = 0
    while i < bytesize
      lead = self[i].to_i32
      width = lead < 0x80 ? 1 : lead < 0xE0 ? 2 : lead < 0xF0 ? 3 : 4
      point = width == 1 ? lead : lead & (0x7F >> width)
      k = 1
      while k < width && i + k < bytesize
        point = (point << 6) | (self[i + k].to_i32 & 0x3F)
        k += 1
      end
      yield point.unsafe_chr
      i += width
    end
  end

  def ljust(width : Int32, pad : Char = ' ') : Str
    return self if bytesize >= width
    Str.build(width) do |w|
      w.append(self)
      (width - bytesize).times { w << pad }
    end
  end

  def rjust(width : Int32, pad : Char = ' ') : Str
    return self if bytesize >= width
    Str.build(width) do |w|
      (width - bytesize).times { w << pad }
      w.append(self)
    end
  end
end

struct Ary(T)
  # Element by element, as Array#== compares.
  def ==(other : Ary) : Bool
    return false unless size == other.size
    i = 0
    while i < size
      return false unless self[i] == other[i]
      i += 1
    end
    true
  end

  def sort : self
    sorted
  end

  def sort(& : T, T -> Int32) : self
    sorted { |a, b| yield a, b }
  end

  def sort_by(& : T -> U) : self forall U
    sorted_by { |v| yield v }
  end

  def reverse : self
    reversed
  end

  def last : T
    raise "Ary#last: empty" if size == 0
    self[size - 1]
  end

  def []?(index : Int32) : T?
    index += size if index < 0
    index >= 0 && index < size ? self[index] : nil
  end

  def reject(& : T -> Bool) : self
    self.select { |v| !(yield v) }
  end

  def min : T
    raise "Ary#min: empty" if size == 0
    best = self[0]
    each { |v| best = v if v < best }
    best
  end

  def max : T
    raise "Ary#max: empty" if size == 0
    best = self[0]
    each { |v| best = v if v > best }
    best
  end

  def uniq : self
    result = self.class.new(size < 4 ? 4 : size)
    each { |v| result << v unless result.includes?(v) }
    result
  end

  def each_slice(n : Int32, & : Ary(T) -> Nil) : Nil
    i = 0
    while i < size
      piece = self.class.new(n < 4 ? 4 : n)
      j = i
      while j < i + n && j < size
        piece << self[j]
        j += 1
      end
      yield piece
      i += n
    end
  end

  def find(& : T -> Bool) : T?
    each { |v| return v if yield v }
    nil
  end

  def reduce(initial : U, & : U, T -> U) : U forall U
    acc = initial
    each { |v| acc = yield acc, v }
    acc
  end

  def compact_map(& : T -> U?) : Ary(U) forall U
    result = Ary(U).new(size < 4 ? 4 : size)
    each do |v|
      if got = yield v
        result << got
      end
    end
    result
  end

  def flat_map(& : T -> Ary(U)) : Ary(U) forall U
    result = Ary(U).new(size < 4 ? 4 : size)
    each { |v| (yield v).each { |u| result << u } }
    result
  end

  def tally : Hsh(T, Int32)
    counts = Hsh(T, Int32).new
    each { |v| counts[v] = counts.fetch(v, 0) + 1 }
    counts
  end
end

struct Hsh(K, V)
  def map(& : K, V -> U) : Ary(U) forall U
    result = Ary(U).new(size < 4 ? 4 : size)
    each { |k, v| result << (yield k, v) }
    result
  end

  def select(& : K, V -> Bool) : Hsh(K, V)
    result = Hsh(K, V).new(size)
    each { |k, v| result[k] = v if yield k, v }
    result
  end

  def reject(& : K, V -> Bool) : Hsh(K, V)
    self.select { |k, v| !(yield k, v) }
  end

  def transform_values(& : V -> U) : Hsh(K, U) forall U
    result = Hsh(K, U).new(size)
    each { |k, v| result[k] = yield v }
    result
  end

  def any?(& : K, V -> Bool) : Bool
    each { |k, v| return true if yield k, v }
    false
  end

  def count(& : K, V -> Bool) : Int32
    n = 0
    each { |k, v| n += 1 if yield k, v }
    n
  end

  def sum(& : K, V -> Int32) : Int32
    n = 0
    each { |k, v| n += yield k, v }
    n
  end

  def to_a : Ary(Tuple(K, V))
    result = Ary(Tuple(K, V)).new(size < 4 ? 4 : size)
    each { |k, v| result << {k, v} }
    result
  end
end

struct Str::Builder
  def append_value(value : Bool) : Nil
    append(value ? "true" : "false")
  end

  def append_value(value : Symbol) : Nil
    append(value.to_s)
  end

  def append_value(value : Ary) : Nil
    push(91_u8)
    first = true
    value.each do |item|
      append(", ") unless first
      append_inspect(item)
      first = false
    end
    push(93_u8)
  end

  def append_value(value : Hsh) : Nil
    push(123_u8)
    first = true
    value.each do |key, item|
      append(", ") unless first
      append_inspect(key)
      append(" => ")
      append_inspect(item)
      first = false
    end
    push(125_u8)
  end

  def append_value(value : Tuple(*T)) : Nil forall T
    push(123_u8)
    {% for i in 0...T.size %}
      append(", ") if {{i}} > 0
      append_inspect(value[{{i}}])
    {% end %}
    push(125_u8)
  end

  # A value as `inspect` shows it inside a collection: text quoted.
  def append_inspect(value) : Nil
    if value.is_a?(Str)
      value.inspect(self)
    elsif value.is_a?(String)
      Str.new(value).inspect(self)
    elsif value.is_a?(Char)
      push(39_u8)
      append_value(value)
      push(39_u8)
    elsif value.nil?
      append("nil")
    else
      append_value(value)
    end
  end
end
