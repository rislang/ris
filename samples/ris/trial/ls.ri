# ls: lists a directory, sorted. Options: -l sizes, -e EXT filter by ending.
module samples/trial/ls

import std/dir::{Dir}
import std/file

long = false
ext = ""
dir = ""
args = Program.args
i = 0
while i < args.size
  arg = args[i]
  if arg == "-l"
    long = true
  elsif arg == "-e" && i + 1 < args.size
    i += 1
    ext = args[i]
  else
    dir = arg
  end
  i += 1
end
if dir.empty?
  puts "usage: ls [-l] [-e EXT] DIR"
  exit 2
end
names = [] of String
Dir.each_child(dir) { |name| names << name.copy_to(Program.tape) }
names.sort.each do |name|
  next unless name.ends_with?(ext)
  if long
    puts "#{File.size(File.join(dir, name))} #{name}"
  else
    puts name
  end
end
