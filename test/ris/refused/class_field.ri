module test/ris/refused/class_field

import std/int

@[OnTape]
struct Resp
  getter id : Int64
  getter user : Str

  def initialize(@id : Int64, @user : Str)
  end
end

def make : Resp
  Resp.new(1_i64, Str.build { |s| s.push(97_u8) })
end

# A class instance lives on the heap, beyond any scope.
class Cache
  @last : Resp?

  def initialize
    @last = nil
  end

  def keep(r : Resp) : Nil
    @last = r
  end
end

cache = Cache.new
tape { cache.keep(make) }
