# `puts "…#{x}"` in a tape block writes its text on the tape, and the
# same line with no tape running builds it on the heap as before.
tape do
  name = Tape::String.new("tape")
  puts "on the #{name}: #{42} #{-7_i64} #{1.5} #{'x'} #{nil}#{true}"
  print "no newline #{name}\n"
  [1, 2].each { |i| puts "item #{i}" }
  puts "ends its line\n"
end
proc = ->(i : Int32) { puts "heap #{i}" }
proc.call(3)
later = ->(i : Int32) { i }
tape do
  later = ->(i : Int32) { puts "no tape when called #{i}"; i }
end
later.call(4)
# A variable the text only passes through is on the tape as well; one the
# code around the block reads stays on the heap.
kept = ""
tape do
  name = Tape::String.new("var")
  line = "through a #{name}"
  puts line
  line = "again #{1}"
  print line
  puts
  kept = "kept #{2}"
  puts kept
end
puts kept
