# Keep a parsed certificate after its validator's scratch is gone.
import std/asn1::{Der, Asn1Error}
import std/x509::{Certificate, X509Error}

def der_error(bytes : Array(UInt8), kind : Int32) : String
  value = Der.parse(bytes)
  return value.message if value.is_a?(Asn1Error)
  result = case kind
           when 0 then value.children
           when 1 then value.bit_string_bits
           when 2 then value.time
           when 3 then value.explicit(0)
           else        value.sequence
           end
  result.is_a?(Asn1Error) ? result.message : "accepted"
end

raise "primitive children sentence" unless der_error([2_u8, 1_u8, 1_u8], 0) ==
                                             "asn1: INTEGER is primitive and holds no values at offset 0"
raise "nested offset sentence" unless der_error([0x30_u8, 2_u8, 2_u8, 2_u8], 0) ==
                                        "asn1: a length of 2 where 0 bytes are left at offset 2"
raise "bit string sentence" unless der_error([3_u8, 0_u8], 1) ==
                                     "asn1: a BIT STRING with no bytes at offset 0"
raise "time sentence" unless der_error([0x17_u8, 0_u8], 2) ==
                               "asn1: a UTCTime of 0 bytes, where DER writes YYMMDDHHMMSSZ at offset 0"
raise "explicit sentence" unless der_error([0xa0_u8, 0_u8], 3) ==
                                   "asn1: an explicit [0] holds 0 values, not one at offset 0"
raise "sequence sentence" unless der_error([2_u8, 1_u8, 1_u8], 4) ==
                                   "asn1: expected a SEQUENCE, found INTEGER at offset 0"

text = File.read(Program.arguments[0])
der = Array(UInt8).new(text.bytesize) { |at| text[at] }
certificate = Certificate.parse(der)
if certificate.is_a?(X509Error)
  puts certificate.message
else
  raise "wrong subject" unless certificate.subject_name == "CN=tape.test"
  raise "wrong issuer" unless certificate.issuer_name == "CN=tape.test"
  raise "wrong DER" unless certificate.raw == der
  raise "wrong serial" unless certificate.serial == [1_u8]
  raise "wrong names" unless certificate.dns_names[0] == "tape.test"
  raise "wrong IP" unless certificate.ip_addresses[0] == [127_u8, 0_u8,
                                                          0_u8, 1_u8]
  usage = certificate.extended_key_usage
  raise "wrong usage" unless usage && usage[0] == "1.3.6.1.5.5.7.3.1"
  raise "wrong constraints" unless certificate.permitted_dns[0] ==
                                     ".example.test" && certificate.excluded_dns[0] == "bad.example.test"
  raise "wrong IP constraints" unless certificate.permitted_ips[0].size == 8
  id = certificate.subject_key_id
  raise "wrong key id" unless id && id.size == 20
  authority = certificate.authority_key_id
  raise "wrong authority id" unless authority && authority == id
  features = certificate.tls_features
  raise "wrong TLS feature" unless features && features[0] == 5
  raise "wrong nocheck" unless certificate.ocsp_nocheck
  puts "PASS: certificate fields survive validation"
end
