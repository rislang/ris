# A Pattern views the text it was read from
# (doc/drafts/checker-open-questions/, Q3): kept past the round that made
# the text, it would read freed storage.
import std/router::{Pattern}

kept = [] of Pattern
3.times do |i|
  text = "GET /" + i.to_s
  kept << Pattern.parse(text).as(Pattern)
end
puts kept[0].to_s
