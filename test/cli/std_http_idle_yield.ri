# spec: 5.6@10d17e95
# A connection between requests yields to a new one (SPEC 5.6).
#
#   ./bin/ris run test/cli/std_http_idle_yield.ri
#
# Servers with one serving task (`max_connections: 1`), so one listener
# and no hash decides which task a connection meets: each step is
# deterministic. *timeout_ms* is 30 s, far from the 2 s a yield must take.
# A and B are raw sockets (TLS: std/tls clients; HTTP/2 framed by hand).
#
# 1. In the clear and over TLS: A asks once and waits; B asks. B is
#    answered within 2 s, and A reads the end (over TLS close_notify).
# 2. HTTP/2: A's stream 1 answered, A waits; B asks. B is answered, and
#    A reads GOAWAY naming stream 1, then the end.
# 3. A partial head: A sends half a request line, B asks, A finishes.
#    A is answered first, then B.
# 4. An HTTP/2 stream open: A's handler waits on a board message; B asks.
#    A is answered once the message is posted, then B.
# 5. Upgraded: A holds an upgrade; B asks. B is answered once A ends it.
# 6. Connect only: B connects and sends nothing for 1 s. A's next
#    request is answered on A's connection.
# 7. Stop: the server is stopped while it waits on A and its listener;
#    `serve` returns and A reads the end.
#
# Each check prints its line; a wrong one is followed by "FAIL <check>:
# <found>, not <wanted>". The run ends "ALL CHECKS PASSED" or exits 1.

module bench/std_http_idle_yield

import std/http::{Incoming, Outgoing, Server, TlsStream}
import std/socket::{IyiSocket, SocketError}
import std/tls::{TlsIdentity, TlsClient, TlsConfig, TlsError, TlsServerConfig}
import std/x509::{RisCertificateStore, Certificate}

module RisYieldServer
  struct RisReady(H)
  end

  struct RisStop(H)
  end

  struct RisStopped(H)
  end

  def self.port : Int32
    probe = IyiSocket.listen("127.0.0.1", 0)
    port = probe.local_port
    probe.close
    port
  end

  def self.ready(handler : H.class) : Nil forall H
    raise "ready queue full" unless RisBoard.post(RisReady(H).new)
  end

  def self.wait(handler : H.class) : Nil forall H
    ready = RisBoard.take(RisReady(H), 10000_i64)
    raise "cancelled before listening" if ready.is_a?(Cancelled)
    raise "server did not listen within 10 s" unless ready[1]
  end

  def self.stop(handler : H.class) : Nil forall H
    raise "stop queue full" unless RisBoard.post(RisStop(H).new)
  end

  # Whether the server stopped within 10 s of `stop`.
  def self.stopped?(handler : H.class) : Bool forall H
    result = RisBoard.take(RisStopped(H), 10000_i64)
    !result.is_a?(Cancelled) && result[1]
  end

  # One serving task until `stop`.
  def self.answer(port : Int32, handler : H.class) : Nil forall H
    group do |pool|
      pool.spawn do
        Server.answer("127.0.0.1", port, 0, handler, timeout_ms: 30000,
          max_connections: 1)
        0
      end
      pool.spawn do
        unless RisBoard.take(RisStop(H)).is_a?(Cancelled)
          pool.cancel_children
        end
        0
      end
      0
    end
    raise "stopped queue full" unless RisBoard.post(RisStopped(H).new)
  end
end

# What step 4's handler waits for.
struct RisGo
end

# The answer: the request's version, "HTTP/1.1" or "HTTP/2". /wait waits
# for `RisGo` first; /upgrade hands the connection over until it ends.
def answer(req : Incoming, res : Outgoing) : Nil
  if req.path == "/upgrade"
    res.header("Upgrade", "hold")
    res.upgrade
    return
  end
  RisBoard.take(RisGo, 10000_i64) if req.path == "/wait"
  res.body << req.version
end

# The upgraded connection, read until its client ends it.
def hold(socket : IyiSocket | TlsStream) : Nil
  while true
    got = socket.read(4096)
    break unless got.is_a?(String) && !got.empty?
  end
end

class RisClearHandler
  def initialize(config)
  end

  def listening(port : Int32) : Nil
    RisYieldServer.ready(RisClearHandler)
  end

  def call(req : Incoming, res : Outgoing) : Nil
    answer(req, res)
  end

  def take_over(socket : IyiSocket | TlsStream, leftover : String, res : Outgoing) : Nil
    hold(socket)
  end
end

class RisStopHandler
  def initialize(config)
  end

  def listening(port : Int32) : Nil
    RisYieldServer.ready(RisStopHandler)
  end

  def call(req : Incoming, res : Outgoing) : Nil
    answer(req, res)
  end
end

class RisTlsHandler
  @tls : TlsServerConfig
  @identity : TlsIdentity

  def initialize(config)
    identity = TlsIdentity.new(LEAF_PEM + ROOT_PEM, KEY_PEM)
    @identity = identity
    raise identity.error.to_s if identity.error
    server_config = TlsServerConfig.new(identity)
    @tls = server_config
    @tls.alpn << "http/1.1"
  end

  def listening(port : Int32) : Nil
    RisYieldServer.ready(RisTlsHandler)
  end

  def tls_config : TlsServerConfig
    @tls
  end

  def call(req : Incoming, res : Outgoing) : Nil
    answer(req, res)
  end
end

# The test PKI of std_http_stop.ri: a root and a leaf for localhost it
# signed, Ed25519, valid to 9999. The key guards nothing but tests.
LEAF_PEM = "-----BEGIN CERTIFICATE-----\n" \
           "MIIBQzCB9qADAgECAgEDMAUGAytlcDAZMRcwFQYDVQQDDA5peWkgYmVuY2ggcm9v\n" \
           "dDAgFw0yNTAxMDEwMDAwMDBaGA85OTk5MTIzMTIzNTk1OVowFDESMBAGA1UEAwwJ\n" \
           "bG9jYWxob3N0MCowBQYDK2VwAyEAOeskudtTVi76JObK6QHqJy6M7PaEu/aLlC5H\n" \
           "B5OLks+jZjBkMBQGA1UdEQQNMAuCCWxvY2FsaG9zdDAMBgNVHRMBAf8EAjAAMB0G\n" \
           "A1UdDgQWBBQN8ZJay/U7zf07disj78hKukvGAjAfBgNVHSMEGDAWgBSNjkTWVhBs\n" \
           "a874Ao2cPFX4w4saajAFBgMrZXADQQAcAgj9qe58GnzceRkYfxyfNHxmqWOgDJkn\n" \
