module test/ris/pending_cleanup

# Inject a panic at the same native-slot boundary as result placement.
@[PointerUnsafe("exercise pending-result cleanup during a panic")]
def pending_failure : NoReturn
  head = 0_u64
  depth = 0
  saved = IyiRegion.tape
  guard = IyiPendingGuard.new(pointerof(head), pointerof(depth),
    pointerof(saved))
  __iyi_pending_guard(pointerof(guard))
  head = IyiRegion.acquire(IyiRegion::CAPACITY)
  IyiRegion.tape = head
  depth = 1
  # Force growth before the guard has had a normal return to save its head.
  IyiRegion.tape_bytes(IyiRegion::CAPACITY + 1_u64)
  raise "pending cleanup test"
end

group do |g|
  task = g.spawn do
    saved = IyiRegion.tape
    defer check_pending_restored(saved)
    pending_failure
  end
  raise "missing pending panic" unless task.value.is_a?(Panicked)
end
puts "PASS: pending panic restores caller and releases staging"

def check_pending_restored(saved : UInt64) : Nil
  raise "pending cleanup lost caller" unless IyiRegion.tape == saved
end
