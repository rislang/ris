# Numbers as people read them: digits in groups, and quantities with a
# prefix.
#
#     import std/number_format::{BinaryPrefixFormat}
#
#     1234567.format                          # => "1,234,567"
#     1234.5678.format(decimal_places: 2)     # => "1,234.57"
#     1234.5.format(',', '.')                 # => "1.234,5"
#     1_234_567.humanize                      # => "1.23M"
#     0.000_012.humanize                      # => "12µ"
#     1536.humanize_bytes                     # => "1.5KiB"
#     1536.humanize_bytes(format: BinaryPrefixFormat::JEDEC)   # => "1.5KB"
#
# **Exact.** Every rounding is of the value the number holds, half to
# even, on `std/format`'s bignum: `1.005.format(decimal_places: 2)` is
# "1.00", because the double is 1.00499999999999989..., and 2.5 rounds to
# "2". A float with no places asked for prints its shortest digits, the
# ones `to_s` prints, written out in full: `1e20.format` is
# "100,000,000,000,000,000,000.0". A number that prints as zero carries no
# sign. NaN and the infinities print as `to_s` prints them.
#
# **`humanize`** keeps *precision* significant digits by default and
# trims the zeros after them: 1000 is "1k", 1234 "1.23k", 999,999 "1M".
# With `significant: false` *precision* is the places after the point,
# kept as written. The SI prefixes run from q (10^-30) to Q (10^30); past
# them the digits grow, grouped: 1e40 is "10,000,000,000Q".
#
# **`humanize_bytes`** divides by 1024: IEC's KiB, MiB, ... EiB by
# default, JEDEC's KB, MB, ... EB on request. Under 1024 a count is whole
# bytes, "1023B".
#
# Two differences from the other library's methods of these names: IEC's
# kilo is written `KiB`, as IEC 80000-13 writes it, where the other
# library writes `kiB`; and the trimmed zeros take the point with them,
# "1k" where it writes "1.0k".
#
# What each refuses, by panic: a group under 1, negative decimal places,
# a precision under 1 significant digit or under 0 places.

module std/number_format

import std/int
import std/float
import std/tuple
import std/format

# Which binary prefixes `humanize_bytes` writes.
pub enum BinaryPrefixFormat
  # KiB, MiB, GiB, TiB, PiB, EiB.
  IEC
  # KB, MB, GB, TB, PB, EB, each a power of 1024.
  JEDEC
end

struct ::Number
  # The number with its integer digits in groups of *group*, *delimiter*
  # between them and *separator* before the fraction. *decimal_places*
  # rounds to that many places, half to even; nil keeps an integer whole
  # and a float's shortest digits. *only_significant* drops the fraction's
  # trailing zeros, and the separator if nothing is left.
  def format(separator : ::Char = '.', delimiter : ::Char = ',',
             decimal_places : Int32? = nil, *, group : Int32 = 3,
             only_significant : ::Bool = false) : ::String
    result = ""
    tape do
      result = Tape::String.build do |writer|
        Std::NumberFormat::NumberText.format(writer, self, separator,
          delimiter, decimal_places, group, only_significant)
      end.to_heap
    end
    result
  end

  def format(writer : Tape::String::Writer,
             separator : ::Char = '.', delimiter : ::Char = ',',
             decimal_places : Int32? = nil, *, group : Int32 = 3,
             only_significant : ::Bool = false) : Nil
    Std::NumberFormat::NumberText.format(writer, self, separator, delimiter,
      decimal_places, group, only_significant)
  end

  # The number scaled to an SI prefix, with *precision* significant
  # digits (or, with `significant: false`, places), *unit_separator*
  # between it and the prefix.
  def humanize(precision : Int32 = 3, separator : ::Char = '.',
               delimiter : ::Char = ',', *, significant : ::Bool = true,
               unit_separator : ::String = "") : ::String
    result = ""
    tape do
      result = Tape::String.build do |writer|
        Std::NumberFormat::NumberText.humanize(writer, self, precision,
          separator, delimiter, significant, unit_separator)
      end.to_heap
    end
    result
  end

  def humanize(writer : Tape::String::Writer,
               precision : Int32 = 3, separator : ::Char = '.', delimiter : ::Char = ',',
               *, significant : ::Bool = true,
               unit_separator : ::String | Tape::String = "") : Nil
    Std::NumberFormat::NumberText.humanize(writer, self, precision, separator,
      delimiter, significant, unit_separator)
  end
end

struct ::Int
  # A count of bytes scaled by powers of 1024, as `humanize` scales by
  # 1000.
  def humanize_bytes(precision : Int32 = 3, separator : ::Char = '.', *,
                     significant : ::Bool = true, unit_separator : ::String = "",
                     format : Std::NumberFormat::BinaryPrefixFormat = Std::NumberFormat::BinaryPrefixFormat::IEC) : ::String
    result = ""
    tape do
      result = Tape::String.build do |writer|
        Std::NumberFormat::NumberText.humanize_bytes(writer, self, precision,
          separator, significant, unit_separator, format)
      end.to_heap
    end
    result
  end

  def humanize_bytes(writer : Tape::String::Writer,
                     precision : Int32 = 3, separator : ::Char = '.', *,
                     significant : ::Bool = true,
                     unit_separator : ::String | Tape::String = "",
                     format : Std::NumberFormat::BinaryPrefixFormat = Std::NumberFormat::BinaryPrefixFormat::IEC) : Nil
    Std::NumberFormat::NumberText.humanize_bytes(writer, self, precision,
      separator, significant, unit_separator, format)
  end
end

module NumberText
  # From q (10^-30) to Q (10^30), one per power of a thousand.
  SI_PREFIXES = ["q", "r", "y", "z", "a", "f", "p", "n", "µ", "m", "", "k",
                 "M", "G", "T", "P", "E", "Z", "Y", "R", "Q"]
  IEC_UNITS   = ["B", "KiB", "MiB", "GiB", "TiB", "PiB", "EiB"]
  JEDEC_UNITS = ["B", "KB", "MB", "GB", "TB", "PB", "EB"]

  def self.format(writer : Tape::String::Writer, value : ::Int,
                  separator : ::Char, delimiter : ::Char, places : Int32?, group : Int32,
                  only_significant : ::Bool) : Nil
    check_format(places, group)
    text = number(value)
    negative = text.starts_with?("-")
    digits = negative ? text[1, text.bytesize - 1] : text
    fraction = "".as_tape
    if count = places
      fraction = zeros(count) unless only_significant
    end
    assemble(writer, negative, digits, fraction, separator, delimiter, group)
  end

  def self.format(writer : Tape::String::Writer, value : Float32,
                  separator : ::Char, delimiter : ::Char, places : Int32?, group : Int32,
                  only_significant : ::Bool) : Nil
    check_format(places, group)
    # The single's own shortest digits; widened, its places are exact.
    return float_text(writer, number(value), separator, delimiter, group,
      only_significant) if places.nil?
    format(writer, value.to_f64, separator, delimiter, places, group,
      only_significant)
  end

  def self.format(writer : Tape::String::Writer, value : Float64,
                  separator : ::Char, delimiter : ::Char, places : Int32?, group : Int32,
                  only_significant : ::Bool) : Nil
    check_format(places, group)
    return emit(writer, number(value)) unless finite?(value)
    if count = places
      fixed = fixed(value < 0.0 ? 0.0 - value : value, count)
      point = fixed.index('.')
      whole = point ? fixed[0, point] : fixed
      fraction = point ? fixed[point + 1,
        fixed.bytesize - point - 1] : "".as_tape
      fraction = trim_zeros(fraction) if only_significant
      return assemble(writer, value < 0.0, whole, fraction, separator,
        delimiter, group)
    end
    float_text(writer, number(value), separator, delimiter, group,
      only_significant)
  end

  private def self.check_format(places : Int32?, group : Int32) : Nil
    raise "Number#format: group must be at least 1, not #{group}" if group < 1
    if count = places
      if count < 0
        raise "Number#format: decimal_places must be at least 0, not #{count}"
      end
    end
  end

  # `to_s`'s shortest digits, "1.25e-7" or "1234.5", written out in full.
  private def self.float_text(writer : Tape::String::Writer,
                              text : Tape::String, separator : ::Char, delimiter : ::Char,
                              group : Int32, only_significant : ::Bool) : Nil
    if text == "NaN" || text == "Infinity" || text == "-Infinity"
      return emit(writer, text)
    end
    negative = text.starts_with?("-")
    text = text[1, text.bytesize - 1] if negative
    exponent = 0
    if mark = text.index('e')
      exponent = text[mark + 1, text.bytesize - mark - 1].to_i
      text = text[0, mark]
    end
    point = text.index('.') || text.bytesize
    digits = cat(text[0, point], (point < text.bytesize ? text[point + 1,
      text.bytesize - point - 1] : "".as_tape))
    point = point + exponent
    if point <= 0
      whole = "0".as_tape
      fraction = cat(zeros(0 - point), digits)
    elsif point >= digits.bytesize
      whole = cat(digits, zeros(point - digits.bytesize))
      fraction = "".as_tape
    else
      whole = digits[0, point]
      fraction = digits[point, digits.bytesize - point]
    end
    whole = trim_leading_zeros(whole)
    fraction = trim_zeros(fraction)
    fraction = "0".as_tape if fraction.empty? && !only_significant
    assemble(writer, negative, whole, fraction, separator, delimiter, group)
  end

  def self.humanize(writer : Tape::String::Writer, value : ::Int,
                    precision : Int32, separator : ::Char, delimiter : ::Char,
                    significant : ::Bool, unit_separator : ::String | Tape::String) : Nil
    negative, magnitude = magnitude_of(value)
    return emit(writer, "0") if magnitude == 0_u64
    scaled(writer, negative, magnitude, 0, number(magnitude).bytesize - 1,
      precision, separator, delimiter, significant, unit_separator)
  end

  def self.humanize(writer : Tape::String::Writer, value : Float32,
                    precision : Int32, separator : ::Char, delimiter : ::Char,
                    significant : ::Bool, unit_separator : ::String | Tape::String) : Nil
    humanize(writer, value.to_f64, precision, separator, delimiter,
      significant, unit_separator)
  end

  def self.humanize(writer : Tape::String::Writer, value : Float64,
                    precision : Int32, separator : ::Char, delimiter : ::Char,
                    significant : ::Bool, unit_separator : ::String | Tape::String) : Nil
    check_precision("Number#humanize", precision, significant)
    return emit(writer, number(value)) unless finite?(value)
    return emit(writer, "0") if value == 0.0
    bits = IyiFloatText.bits_of(value)
    exponent_bits = bits.unsafe_shr(52_u64) & 2047_u64
    fraction = bits & 4503599627370495_u64
    f = exponent_bits == 0_u64 ? fraction : fraction | 4503599627370496_u64
    e = exponent_bits == 0_u64 ? -1074 : exponent_bits.to_i64.to_i32 - 1075
    # 0.d1d2... x 10^k: the decimal exponent of the leading digit is k - 1,
    # or one less when the shortest digits rounded up to a power of ten;
    # `scaled` corrects it.
    k = IyiFloatText.dragon4(value < 0.0 ? 0.0 - value : value)[2]
    scaled(writer, value < 0.0, f, e, k - 1, precision, separator, delimiter,
      significant, unit_separator)
  end

  def self.humanize_bytes(writer : Tape::String::Writer, value : ::Int,
                          precision : Int32, separator : ::Char, significant : ::Bool,
                          unit_separator : ::String | Tape::String,
                          format : Std::NumberFormat::BinaryPrefixFormat) : Nil
    check_precision("Int#humanize_bytes", precision, significant)
    units = format == Std::NumberFormat::BinaryPrefixFormat::IEC ? IEC_UNITS : JEDEC_UNITS
    negative, magnitude = magnitude_of(value)
    sign = negative ? "-" : ""
    if magnitude < 1024_u64
      writer << sign << number(magnitude) << unit_separator << "B"
      return
    end
    power = 0
    while power < 6 && magnitude.unsafe_shr((10 * (power + 1)).to_u64) != 0_u64
      power = power + 1
    end
    while true
      e = 0 - 10 * power
      if significant
        lead = number(magnitude.unsafe_shr((10 * power).to_u64)).bytesize - 1
        digits, low = significant_digits(magnitude, e, lead, precision)
      else
        digits = scaled_digits(magnitude, e, precision)
        low = 0 - precision
      end
      whole, fraction = place(digits, low)
      # Rounded up to a whole 1024: the next unit's 1.
      if power < 6 && whole.to_i >= 1024
        power = power + 1
        next
      end
      fraction = trim_zeros(fraction) if significant
      writer << sign << whole
      writer << separator << fraction unless fraction.empty?
      writer << unit_separator << units[power]
      return
    end
  end

  # *magnitude* x 2^*e*, its leading digit at 10^*lead* or near it, as
  # humanize writes it.
  private def self.scaled(writer : Tape::String::Writer, negative : ::Bool,
                          magnitude : UInt64, e : Int32, lead : Int32, precision : Int32,
                          separator : ::Char, delimiter : ::Char, significant : ::Bool,
                          unit_separator : ::String | Tape::String) : Nil
    check_precision("Number#humanize", precision, significant)
    if significant
      digits, low = significant_digits(magnitude, e, lead, precision)
      lead = low + precision - 1
      prefix = prefix_of(lead)
      whole, fraction = place(digits, low - prefix)
      fraction = trim_zeros(fraction)
    else
      # The leading digit's place, from a value rounded to one digit, which
      # may have rounded up to the power of ten above it: one prefix lower
      # is the value's own if it stays under a thousand there.
      prefix = prefix_of(significant_digits(magnitude, e, lead, 1)[1])
      if prefix > -30
        lower = scaled_digits(magnitude, e, precision - prefix + 3)
        prefix = prefix - 3 if place(lower, 0 - precision)[0].bytesize <= 3
      end
      while true
        digits = scaled_digits(magnitude, e, precision - prefix)
        whole, fraction = place(digits, 0 - precision)
        # Rounded up to a whole thousand: the next prefix's 1.
        if prefix < 30 && whole.bytesize > 3
          prefix = prefix + 3
          next
        end
        break
      end
    end
    symbol = SI_PREFIXES[prefix // 3 + 10]
    writer << '-' if negative
    group_digits(writer, whole, delimiter, 3)
    writer << separator << fraction unless fraction.empty?
    writer << unit_separator << symbol unless symbol.empty?
  end

  # *precision* significant digits of *magnitude* x 2^*e*, rounded half to
  # even, and the power of ten of the last one. *lead* is where the first
  # digit is thought to be; a guess off is put right here.
  private def self.significant_digits(magnitude : UInt64, e : Int32,
                                      lead : Int32, precision : Int32) : {Tape::String, Int32}
    while true
      low = lead - precision + 1
      digits = scaled_digits(magnitude, e, 0 - low)
      if digits.bytesize > precision
        lead = lead + 1
      elsif digits.bytesize < precision
        lead = lead - 1
      elsif power_of_ten?(digits)
        # "10...0" is also what a value whose first digit is a place lower
        # rounds up to - 1023.5 KiB is 0.99951 MiB, and at four digits a
        # guess of the ones place made it "1000", 1 MiB. Rounded at that
        # lower place, such a value still has *precision* digits.
        below = scaled_digits(magnitude, e, 1 - low)
        return below.bytesize == precision ? {below, low - 1} : {digits, low}
      else
        return {digits, low}
      end
    end
  end

  private def self.power_of_ten?(digits : Tape::String) : ::Bool
    digits[0] == 49_u8 && all_zero?(digits[1, digits.bytesize - 1])
  end

  # The power of a thousand at or below 10^*lead*, within q and Q.
  private def self.prefix_of(lead : Int32) : Int32
    prefix = lead >= 0 ? (lead // 3) * 3 : 0 - ((2 - lead) // 3) * 3
    prefix < -30 ? -30 : (prefix > 30 ? 30 : prefix)
  end

  # *digits* x 10^*low* as its whole part and its fraction.
  private def self.place(digits : Tape::String, low : Int32) : {Tape::String, Tape::String}
    return {cat(digits, zeros(low)), "".as_tape} if low >= 0
    point = digits.bytesize + low
    return {"0".as_tape, cat(zeros(0 - point), digits)} if point <= 0
    {digits[0, point], digits[point, digits.bytesize - point]}
  end

  private def self.check_precision(what : ::String, precision : Int32,
                                   significant : ::Bool) : Nil
    if significant && precision < 1
      raise "#{what}: precision must be at least 1 significant digit, " \
            "not #{precision}"
    elsif precision < 0
      raise "#{what}: precision must be at least 0 places, not #{precision}"
    end
  end

  # The sign, and the size as a UInt64 - the least integer's too.
  private def self.magnitude_of(value : ::Int) : {::Bool, UInt64}
    return {false, value.to_u64} if value >= 0
    {true, (value + 1).abs.to_u64 + 1_u64}
  end

  private def self.finite?(value : Float64) : ::Bool
    IyiFloatText.bits_of(value).unsafe_shr(52_u64) & 2047_u64 != 2047_u64
  end

  private def self.assemble(writer : Tape::String::Writer, negative : ::Bool,
                            whole : Tape::String, fraction : Tape::String, separator : ::Char,
                            delimiter : ::Char, group : Int32) : Nil
    zero = all_zero?(whole) && all_zero?(fraction)
    writer << '-' if negative && !zero
    group_digits(writer, whole, delimiter, group)
    writer << separator << fraction unless fraction.empty?
  end

  private def self.group_digits(writer : Tape::String::Writer,
                                digits : Tape::String,
                                delimiter : ::Char, group : Int32) : Nil
    return emit(writer, digits) if digits.bytesize <= group
    first = digits.bytesize % group
    first = group if first == 0
    writer << digits[0, first]
    at = first
    while at < digits.bytesize
      writer << delimiter << digits[at, group]
      at += group
    end
  end

  private def self.emit(writer : Tape::String::Writer,
                        text : Tape::String | ::String) : Nil
    writer << text
  end

  private def self.trim_zeros(fraction : Tape::String) : Tape::String
    stop = fraction.bytesize
    while stop > 0 && fraction[stop - 1] == 48_u8
      stop = stop - 1
    end
    fraction[0, stop]
  end

  private def self.trim_leading_zeros(whole : Tape::String) : Tape::String
    start = 0
    while start < whole.bytesize - 1 && whole[start] == 48_u8
      start = start + 1
    end
    whole[start, whole.bytesize - start]
  end

  private def self.all_zero?(digits : Tape::String) : ::Bool
    index = 0
    while index < digits.bytesize
      return false if digits[index] != 48_u8
      index = index + 1
    end
    true
  end

  private def self.cat(*parts) : Tape::String
    Tape::String.build do |writer|
      parts.each { |part| writer << part }
    end
  end

  private def self.zeros(count : Int32) : Tape::String
    Tape::String.build { |writer| count.times { writer << '0' } }
  end

  private def self.number(value : UInt64) : Tape::String
    digits = Tape::Array(UInt8).new(20)
    loop do
      digits << (48_u64 + value % 10_u64).to_u8
      value = value // 10_u64
      break if value == 0_u64
    end
    Tape::String.build do |writer|
      at = digits.size - 1
      while at >= 0
        writer.push(digits[at])
        at -= 1
      end
    end
  end

  private def self.number(value : ::Int) : Tape::String
    negative, magnitude = magnitude_of(value)
    negative ? cat("-", number(magnitude)) : number(magnitude)
  end

  private def self.number(value : Float64) : Tape::String
    Tape::String.build { |writer| writer << value }
  end

  private def self.number(value : Float32) : Tape::String
    bits32 = Std::Float::Float32Text.bits_of(value)
    bits = bits32.to_u64
    negative = bits.unsafe_shr(31_u64) != 0_u64
    exponent_bits = bits.unsafe_shr(23_u64) & 255_u64
    fraction = bits & 8388607_u64
    if exponent_bits == 255_u64
      return "NaN".as_tape if fraction != 0_u64
      return negative ? "-Infinity".as_tape : "Infinity".as_tape
    end
    if exponent_bits == 0_u64 && fraction == 0_u64
      return negative ? "-0.0".as_tape : "0.0".as_tape
    end

    # value = f * 2^e, f the 24-bit significand (23 for a subnormal).
    hidden = 8388608_u64
    f = exponent_bits == 0_u64 ? fraction : fraction | hidden
    e = exponent_bits == 0_u64 ? -149 : exponent_bits.to_i64.to_i32 - 150

    # r/s is the value, m+/s and m-/s the distances to the neighbours'
    # midpoints; a significand at the bottom of its binade has a nearer
    # neighbour below, so the gap above is twice the gap below.
    unequal = fraction == 0_u64 && exponent_bits > 1_u64
    r = IyiBig.new(f)
    s = IyiBig.new(1_u64)
    if e >= 0
      r.shl(e + (unequal ? 2 : 1))
      s.shl(unequal ? 2 : 1)
      m_plus = IyiBig.new(1_u64)
      m_plus.shl(unequal ? e + 1 : e)
      m_minus = IyiBig.new(1_u64)
      m_minus.shl(e)
    else
      r.shl(unequal ? 2 : 1)
      s.shl(-e + (unequal ? 2 : 1))
      m_plus = IyiBig.new(unequal ? 2_u64 : 1_u64)
      m_minus = IyiBig.new(1_u64)
    end
    scratch = IyiBig.new(0_u64)

    # An even significand owns its boundaries (round-half-even reads a
    # midpoint back as the even neighbour), an odd one does not.
    even = f & 1_u64 == 0_u64

    # k, the decimal exponent, estimated from the binary one and corrected
    # below by the comparisons the digits will use anyway.
    length = 0
    probe = f
    while probe != 0_u64
      probe = probe.unsafe_shr(1_u64)
      length = length + 1
    end
    k = ((e + length - 1) * 1233) // 4096
    k = k - 1 if (e + length - 1) < 0 && ((e + length - 1) * 1233) % 4096 != 0
    k = k + 1
    if k >= 0
      s.mul_pow10(k)
    else
      r.mul_pow10(-k)
      m_plus.mul_pow10(-k)
      m_minus.mul_pow10(-k)
    end
    while (c = r.compare_sum(m_plus, s, scratch)) > 0 || (c == 0 && even)
      s.mul_small(10_u64)
      k = k + 1
    end
    while true
      r_ten = r.copy
      r_ten.mul_small(10_u64)
      m_ten = m_plus.copy
      m_ten.mul_small(10_u64)
      c = r_ten.compare_sum(m_ten, s, scratch)
      break if c > 0 || (c == 0 && even)
      r.mul_small(10_u64)
      m_plus.mul_small(10_u64)
      m_minus.mul_small(10_u64)
      k = k - 1
    end

    # The digits as one integer, nine at most for a single.
    digits = 0_u64
    count = 0
    while true
      r.mul_small(10_u64)
      m_plus.mul_small(10_u64)
      m_minus.mul_small(10_u64)
      digit = r.divide_digit(s)
      low_c = r.compare(m_minus)
      low = low_c < 0 || (low_c == 0 && even)
      high_c = r.compare_sum(m_plus, s, scratch)
      high = high_c > 0 || (high_c == 0 && even)
      if !low && !high
        digits = digits &* 10_u64 &+ digit.to_u64
        count = count + 1
        next
      end
      if low && high
        twice = r.copy
        twice.shl(1)
        c = twice.compare(s)
        digit = digit + 1 if c > 0 || (c == 0 && digit % 2 == 1)
      elsif high
        digit = digit + 1
      end
      digits = digits &* 10_u64 &+ digit.to_u64
      count = count + 1
      break
    end

    storage = uninitialized StaticArray(UInt8, 32)
    buffer = pointerof(storage).as(Pointer(UInt8))
    size = IyiFloatText.format_into(buffer, negative, digits, count, k)
    Tape::String.build(size) do |writer|
      i = 0
      while i < size
        writer.push(buffer[i])
        i += 1
      end
    end
  end

  private def self.fixed(value : Float64, places : Int32) : Tape::String
    if places > IyiFloatText::MAX_PLACES
      raise "precision must be at most #{IyiFloatText::MAX_PLACES}"
    end
    bits = IyiFloatText.bits_of(value)
    exponent = bits.unsafe_shr(52_u64) & 2047_u64
    fraction = bits & 4503599627370495_u64
    f = exponent == 0_u64 ? fraction : fraction | 4503599627370496_u64
    e = exponent == 0_u64 ? -1074 : exponent.to_i64.to_i32 - 1075
    digits = scaled_digits(f, e, places)
    return digits if places <= 0
    if digits.bytesize <= places
      digits = cat(zeros(places + 1 - digits.bytesize), digits)
    end
    cat(digits[0, digits.bytesize - places], ".",
      digits[digits.bytesize - places, places])
  end

  private def self.scaled_digits(f : UInt64, e : Int32,
                                 places : Int32) : Tape::String
    if quick = IyiFloatText.scaled_quick(f, e, places)
      return number(quick)
    end
    num = IyiBig.new(f)
    den = IyiBig.new(1_u64)
    if places > 0
      num.mul_pow10(places)
    elsif places < 0
      den.mul_pow10(0 - places)
    end
    if e >= 0
      num.shl(e)
    else
      den.shl(0 - e)
    end
    quotient = IyiBig.new(0_u64)
    num.divide(den, quotient)
    num.shl(1)
    compared = num.compare(den)
    if compared > 0 || (compared == 0 && quotient.low_bit == 1_u64)
      quotient.add_small(1_u64)
    end
    return "0".as_tape if quotient.size == 0
    chunks = Tape::Array(UInt64).new
    while quotient.size > 0
      chunks << quotient.div_small(1000000000_u64)
    end
    Tape::String.build do |writer|
      at = chunks.size - 1
      while at >= 0
        digits = number(chunks[at])
        if at < chunks.size - 1
          (9 - digits.bytesize).times { writer << '0' }
        end
        writer << digits
        at -= 1
      end
    end
  end
end
