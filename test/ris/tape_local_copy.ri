# Checked tape/local boundaries, including noncontiguous views.
@[PointerUnsafe("the copy fixture uses only its own stack block")]
def exercise : Nil
  local = uninitialized StaticArray(UInt8, 8)
  bytes = pointerof(local).as(Pointer(UInt8))
  text = "abcdef"
  text.copy_to_local(1, bytes, 4)
  raise "text copy" unless bytes[0] == 98 && bytes[3] == 101
  array = Array(UInt8).new(6, 0_u8)
  array.copy_from_local(1, bytes, 4)
  array[1, 4].copy_to_local(1, bytes, 2)
  raise "view offset" unless bytes[0] == 99 && bytes[1] == 100
  indexes = [4, 1, 3]
  array.values_at(indexes).copy_to_local(0, bytes, 3)
  raise "indexed view" unless bytes[0] == 101 && bytes[1] == 98 && bytes[2] == 100
  text.copy_to_local(6, bytes, 0)
  array.copy_from_local(6, bytes, 0)
  array[1, 4].copy_to_local(4, bytes, 0)
  unless Program.args.empty?
    case Program.args[0]
    when "text" then text.copy_to_local(-1, bytes, 1)
    when "array" then array.copy_to_local(5, bytes, 2)
    when "store" then array.copy_from_local(0, bytes, -1)
    when "view" then array[1, 4].copy_to_local(3, bytes, 2)
    end
    raise "missed range check"
  end
  puts "PASS: checked local copies"
end

exercise
