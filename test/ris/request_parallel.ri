module test/ris/request_parallel

group do |g|
  w = g.new_worker(RisInbox::Request(Str, Str), 16) do |q|
    800.times do
      req = q.receive(10000)
      raise "receive" unless req.is_a?(RisInbox::Request(Str, Str))
      if req.is_a?(RisInbox::Request(Str, Str))
        raise "commit" unless req.reply(req.message).nil?
      end
    end
    nil
  end
  8.times do
    g.spawn_parallel do
      100.times do
        answer = w.request(Str.new("copied"), 10000)
        raise "reply copy" unless answer == Str.new("copied")
      end
      nil
    end
  end
end
puts "PASS: request parallel"
