# XML for ris: a well-formedness parser, a document tree on the caller's
# tape, and a serializer.
#
# `parse` reads an XML 1.0 document - declaration, comments, processing
# instructions, an internal DTD subset with its entity, element,
# attribute-list and notation declarations, elements, attributes,
# namespaces, text, CDATA, character and entity references - into an
# `XmlTree`: one array of nodes, node 0 the document, and a `TapeNode` a
# view (tree, index) of one. `parse?` answers nil where `parse` panics. A
# node can be walked (`each_child`, `children`, `parent`, `root`),
# searched (`find`, `find_all`), built (`TapeNode.document`, `add_element`,
# `add_text`, `new_comment` and its kin with `append`, `set_attribute`)
# and written back out (`to_xml`). `copy_to(owner)` copies a whole tree.
# XPath, which only the heap tree had, is not ported yet. `escape`,
# `escape_attribute` and `unescape` are the character-reference rules on
# their own.
#
# Bytes are UTF-8 and stay as they are: text is copied by the run, never
# decoded and re-encoded, so a document with "café" or an emoji reads and
# writes the same bytes. Line ends are normalised (`\r\n` and `\r` become
# `\n`) and attribute values have their literal tabs and newlines replaced by
# spaces, as XML 1.0 says. The serializer writes what a document reads back
# as: `&amp; &lt; &gt;` and `&#13;` in text, `&quot;` and `&#9; &#10; &#13;` in
# attribute values as well, `]]>` inside CDATA as the end of one section and
# the start of the next (and a carriage return in it as `&#13;` between two),
# namespace declarations before attributes, an empty element as `<a/>`, and a
# newline after the declaration and after every top-level node; a document
# declared US-ASCII (or `ascii`) has every other character in its text,
# attribute values and CDATA written as a decimal reference. A comment or a
# processing instruction has no such escape, so `--` in a comment, a comment
# ending in `-`, and `?>` in a processing instruction are refused when the
# node is made, as are an element name or a processing instruction target
# that is not an XML name (and the target `xml`): written as they were,
# they made a document no parser reads. A parsed document holds none.
#
# What it refuses, each with the line and column:
#   * an undeclared entity (`&bogus;`), an unterminated one (`&amp` without
#     the `;`), and a character reference that is not an XML character
#     (surrogates, U+0000 and the other C0 controls, anything past U+10FFFF);
#   * `--` inside a comment and `]]>` in text; a control character (other than
#     tab, newline and carriage return) anywhere; a byte that is not UTF-8, a
#     character that is not an XML character (U+FFFE, U+FFFF, an encoded
#     surrogate), and in a document declared US-ASCII any byte past 0x7F;
#   * an XML declaration without its version first, or with `version`,
#     `encoding`, `standalone` out of that order or twice, or a version that
#     is not digits, a dot and digits;
#   * a raw `<` in an attribute value, an attribute given twice - by one
#     spelling or through two prefixes bound to the same uri - a namespace
#     prefix nobody declared, a code point a name cannot hold (XML 1.0, fifth
#     edition: `<a×b/>`, `<·a/>`), a name with a colon first, last or twice
#     or a local part that cannot start a name, a colon in an entity name or a
#     processing instruction target, a declaration of the `xmlns` prefix or
#     of `xml` to another uri, the `xml` or `xmlns` uri bound to any other
#     prefix or to the default namespace, an unquoted value, a second root
#     element, a closing tag that does not match, an unclosed anything;
#   * an external DTD subset or entity (`SYSTEM`/`PUBLIC`) - there is no
#     file or network access here, so there is no XXE;
#   * more than `max_entity_expansions` entity expansions (1,000 by default),
#     an entity that expands more than ten levels deep, or expansions that
#     copy more than 100 times the document's size (8 MiB at least), which
#     is what a "billion laughs" or a quadratic-blowup document is;
#   * elements nested deeper than `max_depth` (256 by default);
#   * an entity whose replacement text holds a `<` - markup where the
#     reference is in content, an error where it is in an attribute value -
#     or, in content, `]]>`;
#   * an `<!ELEMENT>`, `<!ATTLIST>` or `<!NOTATION>` declaration that is not
#     its production in XML 1.0 (`<!ELEMENT>`, `(a,|b)`, an attribute with
#     no default), and an attribute default a written value could not be;
#   * markup inside an entity's replacement text, a parameter entity
#     reference, and an encoding other than UTF-8 or US-ASCII: each is named
#     as unsupported rather than read as something else.
#
# `unescape` follows the same reference rules as the parser: the five
# predefined entities and valid character references are decoded, everything
# else is refused with the same sentence. The DTD is read for its entities and
# its attribute-list declarations: an attribute given a default is added to
# an element written without it, and a value whose declared type is not CDATA
# has its spaces trimmed and collapsed. Element and notation declarations are
# checked and not used, as nothing is validated. The DTD is not kept:
# `to_xml` writes no DOCTYPE, and entity references come out as the text
# they stood for.

module std/xml

pub enum NodeType
  Element
  Text
  CData
  Comment
  ProcessingInstruction
  Document

  def cdata? : Bool
    self == NodeType::CData
  end

  def pi? : Bool
    self == NodeType::ProcessingInstruction
  end
end

# The namespace the `xml:` prefix is bound to without a declaration.
XML_NAMESPACE = "http://www.w3.org/XML/1998/namespace"
# The namespace the `xmlns` prefix is bound to; nothing may be bound to it.
XMLNS_NAMESPACE = "http://www.w3.org/2000/xmlns/"

@[OnTape]
struct TapeMap(K, V)
  @keys : Array(K)
  @values : Array(V)

  def initialize
    @keys = Array(K).new
    @values = Array(V).new
  end

  def empty? : Bool
    @keys.empty?
  end

  def size : Int32
    @keys.size
  end

  def []?(key : K) : V?
    @keys.each_with_index do |item, i|
      return @values[i] if item == key
    end
    nil
  end

  def [](key : K) : V
    self[key]? || raise "missing YAML key"
  end

  def has_key?(key : K) : Bool
    @keys.each { |item| return true if item == key }
    false
  end

  def []=(key : K, value : V) : Nil
    @keys.each_with_index do |item, i|
      if item == key
        @values[i] = value
        return
      end
    end
    @keys << key
    @values << value
  end

  def each(& : K, V -> _) : Nil
    @keys.each_with_index { |key, i| yield key, @values[i] }
  end
end

@[OnTape]
pub struct TapeNamespace
  getter prefix : String
  getter uri : String

  def initialize(prefix : String | String, uri : String)
    @prefix = tape_view(prefix)
    @uri = uri
  end
end

@[OnTape]
pub struct TapeAttribute
  getter name : String
  getter value : String
  getter namespace_uri : String

  def initialize(@name : String, @value : String,
                 namespace_uri : String | String = "")
    @namespace_uri = tape_view(namespace_uri)
  end

  def prefix : String
    colon = @name.index(':')
    colon ? @name[0, colon] : "".as_tape
  end

  def local_name : String
    colon = @name.index(':')
    colon ? @name[colon + 1, @name.bytesize - colon - 1] : @name
  end
end

# One node of an `XmlTree`: its kind, name and text, and its links as
# indices into the tree's arrays (-1 for none). Children are a linked
# list, so a node is appended to any parent at any time; its attributes
# and namespace declarations are a range of the tree's flat arrays.
@[OnTape]
struct XmlNodeData
  property node_type : NodeType
  property name : String
  property content : String
  property parent : Int32
  property first_child : Int32
  property last_child : Int32
  property next_sibling : Int32
  property attr_first : Int32
  property attr_last : Int32
  property ns_first : Int32
  property ns_last : Int32

  def initialize(@node_type : NodeType, @name : String, @content : String)
    @parent = -1
    @first_child = -1
    @last_child = -1
    @next_sibling = -1
    @attr_first = -1
    @attr_last = -1
    @ns_first = -1
    @ns_last = -1
  end
end

# An attribute or a namespace declaration of a node, and the index of the
# node's next one (-1 after the last).
@[OnTape]
struct XmlLink(T)
  getter item : T
  property next : Int32

  def initialize(@item : T)
    @next = -1
  end
end

# What the XML declaration says, one per tree.
@[OnTape]
struct XmlDeclaration
  property version : String
  property encoding : String
  property standalone : Bool?

  def initialize
    @version = "1.0".as_tape
    @encoding = "UTF-8".as_tape
    @standalone = nil
  end
end

# A document on the caller's tape: every node in one array, node 0 the
# document, every attribute and namespace declaration in two more. A
# `TapeNode` is a view (tree, index) of it; `copy_to(owner)` copies the
# whole tree, as it holds no reference to itself.
@[OnTape]
pub class XmlTree
  getter nodes : Array(XmlNodeData)
  getter attributes : Array(XmlLink(TapeAttribute))
  getter namespaces : Array(XmlLink(TapeNamespace))
  getter declaration : Array(XmlDeclaration)

  def initialize
    @nodes = Array(XmlNodeData).new
    @attributes = Array(XmlLink(TapeAttribute)).new
    @namespaces = Array(XmlLink(TapeNamespace)).new
    @declaration = Array(XmlDeclaration).new
    @declaration << XmlDeclaration.new
    @nodes << XmlNodeData.new(NodeType::Document, "#document".as_tape,
      "".as_tape)
  end

  def document : TapeNode
    TapeNode.new(self, 0)
  end

  def add(kind : NodeType, name : String | String,
          content : String | String) : TapeNode
    @nodes << XmlNodeData.new(kind, tape_view(name), tape_view(content))
    TapeNode.new(self, @nodes.size - 1)
  end
end

# A node of an `XmlTree`: the tree and the node's index. Two are `==` when
# they are the same node of the same tree. A node made by `new_element`
# and its kin belongs to its tree before it is appended anywhere.
@[OnTape]
pub struct TapeNode
  getter tree : XmlTree
  getter index : Int32

  def initialize(@tree : XmlTree, @index : Int32)
  end

  # A new document: a tree holding its document node alone.
  def self.document : TapeNode
    XmlTree.new.document
  end

  def ==(other : TapeNode) : Bool
    @index == other.index && @tree.object_id == other.tree.object_id
  end

  def !=(other : TapeNode) : Bool
    !(self == other)
  end

  private def data : XmlNodeData
    @tree.nodes[@index]
  end

  private def at(index : Int32) : TapeNode
    TapeNode.new(@tree, index)
  end

  # Nodes of this node's tree, not yet in it: append each where it goes.
  def new_element(name : String | String) : TapeNode
    unless TapeParser.name_shaped?(name)
      raise "<#{name}> is not an XML element name"
    end
    @tree.add(NodeType::Element, name, "")
  end

  def new_text(text : String | String) : TapeNode
    @tree.add(NodeType::Text, "", text)
  end

  def new_comment(text : String | String) : TapeNode
    if text.includes?("--") || text.ends_with?("-")
      raise "an XML comment cannot hold '--' or end in '-'"
    end
    @tree.add(NodeType::Comment, "", text)
  end

  def new_cdata(text : String | String) : TapeNode
    @tree.add(NodeType::CData, "", text)
  end

  def new_pi(name : String | String, text : String | String) : TapeNode
    if !TapeParser.name_shaped?(name) || name.includes?(':') ||
       tape_lower(name) == "xml"
      raise "'#{name}' is not a processing instruction target"
    end
    raise "a processing instruction cannot hold '?>'" if text.includes?("?>")
    @tree.add(NodeType::ProcessingInstruction, name, text)
  end

  # A new element appended to this node, answered.
  def add_element(name : String | String) : TapeNode
    append(new_element(name))
  end

  def add_text(text : String | String) : TapeNode
    append(new_text(text))
  end

  def node_type : NodeType
    data.node_type
  end

  def name : String
    data.name
  end

  def content : String
    data.content
  end

  def version : String
    @tree.declaration[0].version
  end

  def version=(value : String | String) : Nil
    decl = @tree.declaration[0]
    decl.version = tape_view(value)
    @tree.declaration[0] = decl
  end

  def encoding : String
    @tree.declaration[0].encoding
  end

  def encoding=(value : String | String) : Nil
    decl = @tree.declaration[0]
    decl.encoding = tape_view(value)
    @tree.declaration[0] = decl
  end

  def standalone : Bool?
    @tree.declaration[0].standalone
  end

  def standalone=(value : Bool?) : Nil
    decl = @tree.declaration[0]
    decl.standalone = value
    @tree.declaration[0] = decl
  end

  def each_child(& : TapeNode -> _) : Nil
    child = data.first_child
    while child >= 0
      yield at(child)
      child = @tree.nodes[child].next_sibling
    end
  end

  def children : Array(TapeNode)
    list = Array(TapeNode).new
    each_child { |child| list << child }
    list
  end

  def children? : Bool
    data.first_child >= 0
  end

  def first_child : TapeNode?
    first = data.first_child
    first < 0 ? nil : at(first)
  end

  def last_child : TapeNode?
    last = data.last_child
    last < 0 ? nil : at(last)
  end

  def next_sibling : TapeNode?
    following = data.next_sibling
    following < 0 ? nil : at(following)
  end

  def first_element_child : TapeNode?
    each_child { |child| return child if child.node_type.element? }
    nil
  end

  def element_children : Array(TapeNode)
    list = Array(TapeNode).new
    each_child { |child| list << child if child.node_type.element? }
    list
  end

  def each_attribute(& : TapeAttribute -> _) : Nil
    i = data.attr_first
    while i >= 0
      link = @tree.attributes[i]
      yield link.item
      i = link.next
    end
  end

  def attributes : Array(TapeAttribute)
    list = Array(TapeAttribute).new
    each_attribute { |attr| list << attr }
    list
  end

  def each_namespace(& : TapeNamespace -> _) : Nil
    i = data.ns_first
    while i >= 0
      link = @tree.namespaces[i]
      yield link.item
      i = link.next
    end
  end

  def namespaces : Array(TapeNamespace)
    list = Array(TapeNamespace).new
    each_namespace { |ns| list << ns }
    list
  end

  # Adds an attribute; a name already there is not checked (the parser
  # checks it, `set_attribute` replaces it).
  def add_attribute(attr : TapeAttribute) : Nil
    d = data
    list = @tree.attributes
    list << XmlLink(TapeAttribute).new(attr)
    at = list.size - 1
    if d.attr_last < 0
      d.attr_first = at
    else
      last = list[d.attr_last]
      last.next = at
      list[d.attr_last] = last
    end
    d.attr_last = at
    @tree.nodes[@index] = d
  end

  # Sets the attribute `name` (no namespace), replacing one given before.
  def set_attribute(name : String | String, value : String | String) : Nil
    i = data.attr_first
    while i >= 0
      link = @tree.attributes[i]
      if link.item.name == name
        @tree.attributes[i] = XmlLink(TapeAttribute).new(
          TapeAttribute.new(tape_view(name), tape_view(value)))
        fixed = @tree.attributes[i]
        fixed.next = link.next
        @tree.attributes[i] = fixed
        return
      end
      i = link.next
    end
    add_attribute(TapeAttribute.new(tape_view(name), tape_view(value)))
  end

  def add_namespace(ns : TapeNamespace) : Nil
    d = data
    list = @tree.namespaces
    list << XmlLink(TapeNamespace).new(ns)
    at = list.size - 1
    if d.ns_last < 0
      d.ns_first = at
    else
      last = list[d.ns_last]
      last.next = at
      list[d.ns_last] = last
    end
    d.ns_last = at
    @tree.nodes[@index] = d
  end

  def parent : TapeNode?
    up = data.parent
    up < 0 ? nil : at(up)
  end

  def parent=(node : TapeNode) : Nil
    d = data
    d.parent = node.index
    @tree.nodes[@index] = d
  end

  # Appends `child`, a node of this tree not yet in it, and answers it.
  def append(child : TapeNode) : TapeNode
    unless child.tree.object_id == @tree.object_id && child.index > 0
      raise "an XML node joins the tree it was made in"
    end
    c = @tree.nodes[child.index]
    if c.parent >= 0 && c.next_sibling >= 0
      raise "an XML node has a parent already"
    end
    c.parent = @index
    @tree.nodes[child.index] = c
    d = data
    if d.last_child < 0
      d.first_child = child.index
    else
      last = @tree.nodes[d.last_child]
      last.next_sibling = child.index
      @tree.nodes[d.last_child] = last
    end
    d.last_child = child.index
    @tree.nodes[@index] = d
    child
  end

  def append_parsed(node : TapeNode) : Nil
    append(node)
  end

  def root : TapeNode
    each_child { |child| return child if child.node_type.element? }
    raise "document has no root element"
  end

  def prefix : String
    colon = name.index(':')
    colon ? name[0, colon] : "".as_tape
  end

  def local_name : String
    colon = name.index(':')
    colon ? name[colon + 1, name.bytesize - colon - 1] : name
  end

  def resolve_namespace_prefix(prefix : String | String) : TapeNamespace?
    each_namespace { |ns| return ns if ns.prefix == prefix }
    up = parent
    return up.resolve_namespace_prefix(prefix) if up
    if prefix == "xml"
      return TapeNamespace.new("xml", XML_NAMESPACE.as_tape)
    end
    nil
  end

  # The uri of this element's namespace: of its prefix, or the default.
  def namespace_uri : String
    found = resolve_namespace_prefix(prefix)
    found ? found.uri : "".as_tape
  end

  def []?(key : String | String) : String?
    each_attribute { |attr| return attr.value if attr.name == key }
    nil
  end

  def [](key : String | String) : String
    found = self[key]?
    raise "no XML attribute #{key}" if found.nil?
    found
  end

  def has_attribute?(key : String | String) : Bool
    !self[key]?.nil?
  end

  # The first element under this node (depth first) named `name`.
  def find(name : String | String) : TapeNode?
    each_child do |child|
      next unless child.node_type.element?
      return child if child.name == name
      found = child.find(name)
      return found if found
    end
    nil
  end

  # Every element under this node named `name`, in document order.
  def find_all(name : String | String) : Array(TapeNode)
    list = Array(TapeNode).new
    find_all(name, list)
    list
  end

  def find_all(name : String | String, list : Array(TapeNode)) : Nil
    each_child do |child|
      next unless child.node_type.element?
      list << child if child.name == name
      child.find_all(name, list)
    end
  end

  def text(writer : String::Builder) : Nil
    if node_type.text? || node_type.cdata?
      writer << content
    else
      each_child do |child|
        child.text(writer) unless child.node_type.comment? || child.node_type.pi?
      end
    end
  end

  def text : String
    String.build { |w| text(w) }
  end

  def to_xml(writer : String::Builder) : Nil
    ascii = node_type.document? &&
            (tape_lower(encoding) == "us-ascii" || tape_lower(encoding) == "ascii")
    serialize(writer, ascii)
  end

  protected def serialize(writer : String::Builder,
                          ascii : Bool) : Nil
    if node_type.document?
      writer << "<?xml version=\"" << version << "\""
      unless encoding.empty?
        writer << " encoding=\"" << encoding << "\""
      end
      unless standalone.nil?
        writer << " standalone=\"" << (standalone ? "yes" : "no") << "\""
      end
      writer << "?>\n"
      each_child do |child|
        child.serialize(writer, ascii)
        writer << "\n"
      end
    elsif node_type.element?
      writer << "<" << name
      each_namespace do |ns|
        writer << " xmlns"
        writer << ":" << ns.prefix unless ns.prefix.empty?
        writer << "=\""
        Std::Xml.escape_attribute(ns.uri, writer, ascii)
        writer << "\""
      end
      each_attribute do |attr|
        writer << " " << attr.name << "=\""
        Std::Xml.escape_attribute(attr.value, writer, ascii)
        writer << "\""
      end
      if children?
        writer << ">"
        each_child { |child| child.serialize(writer, ascii) }
        writer << "</" << name << ">"
      else
        writer << "/>"
      end
    elsif node_type.cdata?
      writer << "<![CDATA["
      i = 0
      start = 0
      while i < content.bytesize
        if i + 2 < content.bytesize && content[i, 3] == "]]>"
          writer << content[start, i + 2 - start] << "]]><![CDATA["
          i += 2
          start = i
        elsif content[i] == 13_u8 || (ascii && content[i] >= 128_u8)
          writer << content[start, i - start] << "]]>"
          width = content[i] < 128_u8 ? 1 : utf8_width(content[i])
          Std::Xml.escape(content[i, width], writer, ascii)
          writer << "<![CDATA["
          i += width
          start = i
        else
          i += 1
        end
      end
      writer << content[start, content.bytesize - start] << "]]>"
    elsif node_type.comment?
      writer << "<!--" << content << "-->"
    elsif node_type.pi?
      writer << "<?" << name
      writer << " " << content unless content.empty?
      writer << "?>"
    else
      # Escaping also preserves CDATA content containing a carriage return.
      Std::Xml.escape(content, writer, ascii)
    end
  end

  def to_xml : String
    String.build { |w| to_xml(w) }
  end

end

private def tape_view(text : String) : String
  text
end

private def tape_view(text : String) : String
  text.as_tape
end

private def tape_lower(text : String) : String
  String.build do |w|
    text.each_byte do |byte|
      byte += 32_u8 if byte >= 65_u8 && byte <= 90_u8
      w.push(byte)
    end
  end
end

# An attribute the internal subset declares: of which element, whether
# its type is other than CDATA, and its default if it has one, in the
# order they were declared; the first declaration of a name holds.
@[OnTape]
struct XmlAttributeDecl
  getter element : String
  getter name : String
  getter value : String
  @tokenized : Bool
  @default : Bool

  def initialize(@element : String, @name : String, @tokenized : Bool,
                 @default : Bool, @value : String)
  end

  def tokenized? : Bool
    @tokenized
  end

  def default? : Bool
    @default
  end
end

@[OnTape]
struct TapeParser
  @input : String
  @len : Int32
  @pos : Int32
  @line : Int32
  @col : Int32
  @max_depth : Int32
  @depth : Int32
  @entities : TapeMap(String, String)
  # What the internal subset's attribute-list declarations say, by element
  # name: whether each declared attribute's type is other than CDATA, and
  # the defaults, in the order they were declared.
  @attribute_decls : Array(XmlAttributeDecl)
  @expansions : Int32
  @max_expansions : Int32
  # Bytes of replacement text copied so far, and how many a document may
  # have: 100 times its own size, and never less than 8 MiB.
  @expanded_bytes : Int64
  @max_expanded_bytes : Int64
  @error : String
  @bad_at : Int32
  @bad_message : String
  @tree : XmlTree

  def initialize(input : String, @max_depth : Int32 = 256, @max_expansions : Int32 = 1000)
    @tree = XmlTree.new
    @input = TapeParser.normalize_line_ends(input)
    @len = @input.bytesize
    @pos = 0
    @line = 1
    @col = 1
    @depth = 0
    @entities = TapeMap(String, String).new
    @attribute_decls = Array(XmlAttributeDecl).new
    @expansions = 0
    @expanded_bytes = 0_i64
    @max_expanded_bytes = @len.to_i64 * 100
    @max_expanded_bytes = 8_i64 * 1024 * 1024 if @max_expanded_bytes < 8_i64 * 1024 * 1024
    @error = ""
    bad = TapeParser.first_bad_character(@input, 0, false)
    @bad_at = bad[0]
    @bad_message = bad[1]
  end

  # The sentence the last parse failed with, or "" when it did not.
  def error : String
    @error
  end

  def parse? : TapeNode?
    doc = parse_document
    @error.empty? ? doc : nil
  end

  def parse : TapeNode
    doc = parse_document
    raise @error unless @error.empty?
    doc
  end

  # `\r\n` and a lone `\r` both mean `\n` (XML 1.0, 2.11).
  protected def self.normalize_line_ends(input : String) : String
    return input unless input.includes?('\r')
    String.build do |w|
      i = 0
      while i < input.bytesize
        byte = input[i]
        if byte == 13_u8
          w << "\n"
          i += 1 if i + 1 < input.bytesize && input[i + 1] == 10_u8
        else
          w.push(byte)
        end
        i += 1
      end
    end
  end

  # -- the cursor ----------------------------------------------------------

  private def failed? : Bool
    !@error.empty?
  end

  private def fail(message : String) : Nil
    fail_at(@line, @col, message)
  end

  private def fail_at(line : Int32, col : Int32, message : String) : Nil
    return unless @error.empty?
    @error = "#{message} at line #{line}, column #{col}"
    @pos = @len
  end

  private def byte_at(i : Int32) : UInt8
    @input[i]
  end

  # One byte on; a column is a character, so a continuation byte is not one.
  # Every byte the parser reads passes here, so the first one that is not
  # part of an XML character is refused where it stands, in document order.
  private def step : Nil
    if @pos == @bad_at
      fail(@bad_message)
      return
    end
    b = @input[@pos]
    @pos = @pos + 1
    if b == 10_u8
      @line = @line + 1
      @col = 1
    elsif (b & 192_u8) != 128_u8
      @col = @col + 1
    end
  end

  # Where the first byte at or after *from* that does not begin an XML
  # character is, with the sentence it is refused with; -1 and "" when there
  # is none. Only a C0 control is caught where the text is read, so without
  # this a byte that is not UTF-8, an encoded surrogate, U+FFFE and U+FFFF
  # were read and written back, while their character references were
  # refused. With *ascii*, any byte past 0x7F is one.
  protected def self.first_bad_character(input : String, from : Int32, ascii : Bool) : Tuple(Int32, String)
    ptr = input
    len = input.bytesize
    i = from
    while i < len
      b = ptr[i]
      if b < 128_u8
        i = i + 1
        next
      end
      byte = "0x" + TapeParser.hex4(b.to_i32)[2, 2]
      return {i, "byte #{byte} is not US-ASCII, the declared encoding"} if ascii
      n = b >= 0xF5_u8 ? 0 : (b >= 0xF0_u8 ? 4 : (b >= 0xE0_u8 ? 3 : (b >= 0xC2_u8 ? 2 : 0)))
      return {i, "byte #{byte} is not UTF-8"} if n == 0 || i + n > len
      cp = (b & (n == 2 ? 0x1F_u8 : (n == 3 ? 0x0F_u8 : 0x07_u8))).to_i32
      k = 1
      while k < n
        c = ptr[i + k]
        return {i, "byte #{byte} is not UTF-8"} if (c & 0xC0_u8) != 0x80_u8
        cp = (cp << 6) | (c & 0x3F_u8).to_i32
        k = k + 1
      end
      overlong = (n == 3 && cp < 0x800) || (n == 4 && cp < 0x10000)
      return {i, "byte #{byte} is not UTF-8"} if overlong || cp > 0x10FFFF
      return {i, "character U+#{TapeParser.hex4(cp)} is not an XML character"} unless xml_char?(cp)
      i = i + n
    end
    {-1, ""}
  end

  private def skip_whitespace : Bool
    skipped = false
    while @pos < @len
      b = byte_at(@pos)
      break unless b == 32_u8 || b == 9_u8 || b == 10_u8
      step
      skipped = true
    end
    skipped
  end

  private def match?(literal : String) : Bool
    n = literal.bytesize
    return false if @pos + n > @len
    ptr = @input[@pos, n]
    lit = literal
    i = 0
    while i < n
      return false if ptr[i] != lit[i]
      i = i + 1
    end
    true
  end

  private def consume(literal : String) : Bool
    return false unless match?(literal)
    i = 0
    while i < literal.bytesize
      step
      i = i + 1
    end
    true
  end

  private def slice_from(from : Int32) : String
    @input[from, @pos - from]
  end

  private def control?(b : UInt8) : Bool
    b < 32_u8 && b != 9_u8 && b != 10_u8
  end

  private def fail_control(b : UInt8) : Nil
    fail("control character U+#{TapeParser.hex4(b.to_i32)} is not allowed")
  end

  # One or more digits, a dot, then digits: the version numbers the other
  # library reads (`1.0`, `1.1`, `1.`).
  protected def self.version_number?(value : String) : Bool
    ptr = value
    len = value.bytesize
    i = 0
    while i < len && ptr[i] >= 48_u8 && ptr[i] <= 57_u8
      i = i + 1
    end
    return false if i == 0 || i >= len || ptr[i] != 46_u8
    i = i + 1
    while i < len && ptr[i] >= 48_u8 && ptr[i] <= 57_u8
      i = i + 1
    end
    i == len
  end

  protected def self.hex4(value : Int32) : String
    digits = value.to_s(16).upcase
    while digits.bytesize < 4
      digits = "0" + digits
    end
    digits
  end

  # -- the document --------------------------------------------------------

  private def parse_document : TapeNode
    doc = @tree.document
    # A UTF-16 file opens with its byte order mark, FF FE or FE FF - what
    # Windows PowerShell 5.1's `Out-File`, `>` and `Export-Clixml` write -
    # and was read as UTF-8 until the first `<`: "text outside the root
    # element at line 1, column 1", about a document that has none.
    if @len >= 2 && ((byte_at(0) == 0xFF_u8 && byte_at(1) == 0xFE_u8) || (byte_at(0) == 0xFE_u8 && byte_at(1) == 0xFF_u8))
      fail_at(1, 1, "encoding 'UTF-16' is not supported: the input is read as UTF-8")
      return doc
    end
    @pos = 3 if match?("\u{FEFF}")
    if match?("<?xml") && @pos + 5 < @len && whitespace_byte?(byte_at(@pos + 5))
      parse_xml_declaration(doc)
    end

    has_root = false
    seen_doctype = false
    while @pos < @len
      skip_whitespace
      break if @pos >= @len
      if match?("<!--")
        doc.append_parsed(parse_comment)
      elsif match?("<?")
        doc.append_parsed(parse_pi)
      elsif match?("<!DOCTYPE")
        if has_root
          fail("DOCTYPE must come before the root element")
        elsif seen_doctype
          fail("a second DOCTYPE")
        else
          seen_doctype = true
          parse_doctype
        end
      elsif match?("<![CDATA[")
        fail("CDATA is only allowed inside an element")
      elsif match?("</")
        fail("closing tag outside the root element")
      elsif match?("<")
        if has_root
          fail("a second root element")
        else
          doc.append_parsed(parse_element(doc))
          has_root = true
        end
      else
        fail("text outside the root element")
      end
    end

    fail("document has no root element") if !has_root && !failed?
    doc
  end

  private def whitespace_byte?(b : UInt8) : Bool
    b == 32_u8 || b == 9_u8 || b == 10_u8
  end

  # The declaration is `version`, then `encoding`, then `standalone`, the
  # first required and each at most once (XML 1.0, production [23]): taking
  # any of them in any order, or none, read `<?xml ?>` and
  # `<?xml standalone="yes" version="1.0"?>` as declarations.
  private def parse_xml_declaration(doc : TapeNode) : Nil
    start_line = @line
    start_col = @col
    consume("<?xml")
    doc.encoding = ""
    stage = 0 # 1 after version, 2 after encoding, 3 after standalone
    while @pos < @len
      had_space = skip_whitespace
      if consume("?>")
        fail_at(start_line, start_col, "the XML declaration has no version") if stage == 0
        return
      end
      if !had_space
        fail("expected whitespace in the XML declaration")
        return
      end
      attr_line = @line
      attr_col = @col
      attr_name = parse_name
      return if failed?
      skip_whitespace
      if !consume("=")
        fail("expected '=' after '#{attr_name}' in the XML declaration")
        return
      end
      skip_whitespace
      attr_val = parse_quoted_literal
      return if failed?
      in_place = (attr_name == "version" && stage == 0) || (attr_name == "encoding" && stage == 1) ||
                 (attr_name == "standalone" && (stage == 1 || stage == 2))
      if !in_place && (attr_name == "version" || attr_name == "encoding" || attr_name == "standalone")
        fail_at(attr_line, attr_col, "'#{attr_name}' is out of " \
                                     "place in the XML declaration: it is version, encoding, " \
                                     "standalone, each once")
        return
      end
      if attr_name == "version"
        # Digits, a dot, digits: `1.0`, `1.1`; any text was taken, a control
        # character or a `<` included.
        if !TapeParser.version_number?(attr_val)
          fail_at(attr_line, attr_col, "version '#{attr_val}' is " \
                                       "not a version number")
          return
        end
        doc.version = attr_val
        stage = 1
      elsif attr_name == "encoding"
        lowered = tape_lower(attr_val)
        if lowered != "utf-8" && lowered != "utf8" && lowered != "us-ascii" && lowered != "ascii"
          fail_at(start_line, start_col, "encoding '#{attr_val}' is " \
                                         "not supported: the input is read as UTF-8")
          return
        end
        doc.encoding = attr_val
        stage = 2
        # A US-ASCII document has no byte past 0x7F: one is refused where it
        # stands rather than read as UTF-8.
        if lowered == "us-ascii" || lowered == "ascii"
          bad = TapeParser.first_bad_character(@input, @pos, true)
          if bad[0] >= 0 && (@bad_at < 0 || bad[0] < @bad_at)
            @bad_at = bad[0]
            @bad_message = bad[1]
          end
        end
      elsif attr_name == "standalone"
        if attr_val == "yes"
          doc.standalone = true
        elsif attr_val == "no"
          doc.standalone = false
        else
          fail("standalone must be 'yes' or 'no', not '#{attr_val}'")
          return
        end
        stage = 3
      else
        fail("'#{attr_name}' is not an XML declaration attribute")
        return
      end
    end
    fail_at(start_line, start_col, "unclosed XML declaration")
  end

  # -- the DTD -------------------------------------------------------------

  private def parse_doctype : Nil
    start_line = @line
    start_col = @col
    consume("<!DOCTYPE")
    # `<!DOCTYPEa>` is no DOCTYPE: the name follows whitespace.
    if !skip_whitespace
      fail("expected whitespace after <!DOCTYPE")
      return
    end
    parse_name
    return if failed?
    skip_whitespace
    if match?("SYSTEM") || match?("PUBLIC")
      fail("external DTD subset refused: no SYSTEM or PUBLIC identifier is read")
      return
    end
    if consume("[")
      parse_internal_subset
      return if failed?
      if !consume("]")
        fail_at(start_line, start_col, "unclosed DOCTYPE internal subset")
        return
      end
      skip_whitespace
    end
    fail_at(start_line, start_col, "unclosed DOCTYPE") unless consume(">")
  end

  private def parse_internal_subset : Nil
    while @pos < @len
      skip_whitespace
      return if match?("]")
      if match?("<!ENTITY")
        parse_entity_decl
      elsif match?("<!--")
        parse_comment
      elsif match?("<?")
        parse_pi
      elsif match?("<!ELEMENT")
        parse_element_decl
      elsif match?("<!ATTLIST")
        parse_attlist_decl
      elsif match?("<!NOTATION")
        parse_notation_decl
      elsif match?("%")
        fail("parameter entity references are not supported")
      else
        fail("unexpected text in the DOCTYPE internal subset")
      end
      return if failed?
    end
  end

  # The three declarations below were skipped to their `>` unread, so
  # `<!ELEMENT>`, `(a,|b)`, `<!NOTATION n>` and `<!ATTLIST garbage !!!>`
  # were taken, an attribute-list declaration's default was never given to
  # an element, and `xmlns:p` declared with one left `<p:x/>` unbound. Each
  # is now read by its production in XML 1.0.

  # Whitespace inside a markup declaration. A `%` after it starts a
  # parameter entity reference, which the internal subset does not allow
  # there: it is named as unsupported rather than as an unexpected byte.
  private def declaration_space : Bool
    skipped = skip_whitespace
    fail("parameter entity references are not supported") if match?("%")
    skipped
  end

  # The `>` that ends a declaration: at the end of the input the
  # declaration is unclosed, and anything else is refused where it stands.
  private def end_declaration(what : String, line : Int32, col : Int32) : Nil
    declaration_space
    return if consume(">")
    if @pos >= @len
      fail_at(line, col, "unclosed #{what}")
    else
      fail("expected '>' to end the #{what}")
    end
  end

  # An element or attribute name in a declaration, held to the same shape
  # as one in the document.
  private def declared_name : String
    line = @line
    col = @col
    name = parse_name
    return "".as_tape if failed? || !qualified_name?(name, line, col)
    name
  end

  # `<!ELEMENT name EMPTY|ANY|(...)>` ([45]-[51]): checked, and not kept,
  # as nothing is validated.
  private def parse_element_decl : Nil
    start_line = @line
    start_col = @col
    consume("<!ELEMENT")
    if !declaration_space
      fail("expected whitespace after <!ELEMENT")
      return
    end
    name = declared_name
    return if failed?
    what = "<!ELEMENT #{name}> declaration"
    if !declaration_space
      fail("expected whitespace after the element name '#{name}'")
      return
    end
    if match?("(")
      parse_content_model(name)
      return if failed?
    else
      word_line = @line
      word_col = @col
      word = parse_name?
      if word.nil? || (word != "EMPTY" && word != "ANY")
        fail_at(word_line, word_col, "expected EMPTY, ANY or '(' in the #{what}")
        return
      end
    end
    end_declaration(what, start_line, start_col)
  end

  # From its `(`: `(#PCDATA)`, `(#PCDATA|a|b)*`, or names and groups joined
  # by `,` or by `|` - never both in one group - each with an optional `?`,
  # `*` or `+`. Each open group's separator is kept on a list rather than
  # the call stack, so no depth of nesting runs the stack out.
  private def parse_content_model(element : String) : Nil
    what = "content model of element '#{element}'"
    consume("(")
    declaration_space
    if consume("#PCDATA")
      names = false
      while !failed?
        declaration_space
        close_line = @line
        close_col = @col
        if consume(")")
          if !consume("*") && names
            fail_at(close_line, close_col, "expected ')*' to end the #{what}, which mixes #PCDATA and elements")
          end
          return
        end
        if !consume("|")
          fail("expected '|' or ')' in the #{what}")
          return
        end
        declaration_space
        declared_name
        names = true
      end
      return
    end
    groups = [0_u8] # each open group's separator, 0 before its first
    want_particle = true
    while !failed?
      if want_particle
        if consume("(")
          groups << 0_u8
          declaration_space
        else
          name_line = @line
          name_col = @col
          name = parse_name?
          if name.nil?
            fail("expected a name or '(' in the #{what}")
            return
          end
          return unless qualified_name?(name, name_line, name_col)
          skip_occurrence
          want_particle = false
        end
      else
        declaration_space
        if consume(")")
          skip_occurrence
          groups.pop
          return if groups.empty?
        else
          b = @pos < @len ? byte_at(@pos) : 0_u8
          if b != 44_u8 && b != 124_u8
            fail("expected ',', '|' or ')' in the #{what}")
            return
          end
          if groups.last != 0_u8 && groups.last != b
            fail("',' and '|' cannot join one group in the #{what}")
            return
          end
          groups[groups.size - 1] = b
          step
          declaration_space
          want_particle = true
        end
      end
    end
  end

  # The `?`, `*` or `+` after a content particle, if there is one.
  private def skip_occurrence : Nil
    return if @pos >= @len
    b = byte_at(@pos)
    step if b == 63_u8 || b == 42_u8 || b == 43_u8
  end

  # `<!ATTLIST element (name type default)*>` ([52]-[60]). What it says is
  # kept: whether an attribute's type is other than CDATA, so its values
  # are trimmed and their spaces collapsed, and its default, which an
  # element without the attribute is given (3.3.2, 3.3.3). The first
  # declaration of an attribute is the one that counts (3.3).
  private def parse_attlist_decl : Nil
    start_line = @line
    start_col = @col
    consume("<!ATTLIST")
    if !declaration_space
      fail("expected whitespace after <!ATTLIST")
      return
    end
    element = declared_name
    return if failed?
    what = "<!ATTLIST #{element}> declaration"
    while !failed?
      # Another attribute follows whitespace; where none does, or at a `>`
      # or a `<`, the declaration should end.
      if !declaration_space || @pos >= @len || byte_at(@pos) == 62_u8 || byte_at(@pos) == 60_u8
        end_declaration(what, start_line, start_col)
        return
      end
      parse_attribute_definition(element, what)
    end
  end

  private def parse_attribute_definition(element : String, what : String) : Nil
    name = declared_name
    return if failed?
    if !declaration_space
      fail("expected whitespace after the attribute name '#{name}' " \
           "in the #{what}")
      return
    end
    tokenized = true
    id_type = false
    if match?("(")
      parse_value_list(name, false, what)
    else
      type_line = @line
      type_col = @col
      word = parse_name?
      type = word.nil? ? "" : word
      id_type = type == "ID"
      if type == "CDATA"
        tokenized = false
      elsif type == "NOTATION"
        if !declaration_space
          fail("expected whitespace after NOTATION in the #{what}")
          return
        end
        if !match?("(")
          fail("expected '(' after NOTATION in the #{what}")
          return
        end
        parse_value_list(name, true, what)
      elsif type != "ID" && type != "IDREF" && type != "IDREFS" && type != "ENTITY" && type != "ENTITIES" && type != "NMTOKEN" && type != "NMTOKENS"
        fail_at(type_line, type_col, "expected the type of attribute " \
                                     "'#{name}' in the #{what}: CDATA, ID, IDREF, IDREFS, " \
                                     "ENTITY, ENTITIES, NMTOKEN, NMTOKENS, NOTATION or a list in " \
                                     "parentheses")
        return
      end
    end
    return if failed?

    had_space = declaration_space
    default_line = @line
    default_col = @col
    b = @pos < @len ? byte_at(@pos) : 0_u8
    if b != 35_u8 && b != 34_u8 && b != 39_u8
      fail("expected #REQUIRED, #IMPLIED, #FIXED or a quoted default for " \
           "attribute '#{name}' in the #{what}")
      return
    end
    if !had_space
      fail("expected whitespace before the default of attribute " \
           "'#{name}' in the #{what}")
      return
    end
    has_value = true
    if b == 35_u8
      step
      word = parse_name?
      keyword = word.nil? ? "" : word
      if keyword == "REQUIRED" || keyword == "IMPLIED"
        has_value = false
      elsif keyword != "FIXED"
        fail_at(default_line, default_col, "expected #REQUIRED, #IMPLIED, " \
                                           "#FIXED or a quoted default for attribute '#{name}' in " \
                                           "the #{what}")
        return
      elsif !declaration_space
        fail("expected whitespace after #FIXED in the #{what}")
        return
      end
    end
    # The default is read as a value written on the element would be: its
    # references expanded with the entities declared so far, a `<` refused.
    value = has_value ? parse_attribute_value : "".as_tape
    return if failed?

    return unless attribute_decl(element, name).nil?
    value = TapeParser.collapse_spaces(value) if tokenized && has_value
    @attribute_decls << XmlAttributeDecl.new(element, name, tokenized,
      has_value, value)
  end

  # The `(a|b)` of an enumerated type, name tokens, or of a NOTATION type,
  # names.
  private def parse_value_list(attribute : String, notation : Bool, what : String) : Nil
    consume("(")
    while !failed?
      declaration_space
      if parse_name?(!notation).nil?
        fail("expected a #{notation ? "name" : "name token"} in the values " \
             "of attribute '#{attribute}' in the #{what}")
        return
      end
      declaration_space
      return if consume(")")
      if !consume("|")
        fail("expected '|' or ')' in the values of attribute " \
             "'#{attribute}' in the #{what}")
        return
      end
    end
  end

  # `<!NOTATION name SYSTEM "..."|PUBLIC "..." ["..."]>` ([82], [75], [83]):
  # checked, and not kept. Its identifiers name nothing that is read.
  private def parse_notation_decl : Nil
    start_line = @line
    start_col = @col
    consume("<!NOTATION")
    if !declaration_space
      fail("expected whitespace after <!NOTATION")
      return
    end
    name_line = @line
    name_col = @col
    notation = parse_name
    return if failed?
    # Namespaces in XML, section 7: no notation name holds a colon.
    if notation.includes?(':')
      fail_at(name_line, name_col, "notation name '#{notation}' " \
                                   "cannot hold a colon")
      return
    end
    what = "<!NOTATION #{notation}> declaration"
    if !declaration_space
      fail("expected whitespace after the notation name '#{notation}'")
      return
    end
    if consume("SYSTEM")
      if !declaration_space
        fail("expected whitespace after SYSTEM in the #{what}")
        return
      end
      parse_identifier_literal(false)
    elsif consume("PUBLIC")
      if !declaration_space
        fail("expected whitespace after PUBLIC in the #{what}")
        return
      end
      parse_identifier_literal(true)
      if declaration_space && @pos < @len && (byte_at(@pos) == 34_u8 || byte_at(@pos) == 39_u8)
        parse_identifier_literal(false)
      end
    else
      fail("expected SYSTEM or PUBLIC in the #{what}")
      return
    end
    return if failed?
    end_declaration(what, start_line, start_col)
  end

  # A system literal, any characters in quotes, or with *public_id* a
  # public identifier, which holds only the characters production [13]
  # lists.
  private def parse_identifier_literal(public_id : Bool) : Nil
    kind = public_id ? "public" : "system"
    start_line = @line
    start_col = @col
    quote = @pos < @len ? byte_at(@pos) : 0_u8
    if quote != 34_u8 && quote != 39_u8
      fail("expected a quoted #{kind} identifier")
      return
    end
    step
    while @pos < @len
      b = byte_at(@pos)
      if b == quote
        step
        return
      elsif public_id && @pos != @bad_at && !TapeParser.public_id_byte?(b)
        fail("#{found_here} is not allowed in a public identifier")
        return
      elsif control?(b)
        fail_control(b)
        return
      end
      step
    end
    fail_at(start_line, start_col, "unclosed #{kind} identifier")
  end

  # Production [13]: space, newline, ASCII letters and digits, and
  # -'()+,./:=?;!*#@$_%
  protected def self.public_id_byte?(b : UInt8) : Bool
    return true if (b >= 97_u8 && b <= 122_u8) || (b >= 65_u8 && b <= 90_u8) || (b >= 48_u8 && b <= 57_u8)
    b == 32_u8 || b == 10_u8 || (b >= 39_u8 && b <= 47_u8) || b == 33_u8 || (b >= 35_u8 && b <= 37_u8) ||
      b == 58_u8 || b == 59_u8 || b == 61_u8 || b == 63_u8 || b == 64_u8 || b == 95_u8
  end

  private def parse_entity_decl : Nil
    start_line = @line
    start_col = @col
    consume("<!ENTITY")
    if !skip_whitespace
      fail("expected whitespace after <!ENTITY")
      return
    end
    parameter = consume("%")
    # `<!ENTITY % p ...>`: the space after the `%` is not optional.
    if parameter && !skip_whitespace
      fail("expected whitespace after '%' in <!ENTITY")
      return
    end
    name_line = @line
    name_col = @col
    name = parse_name
    return if failed?
    # Namespaces in XML, section 7: no entity name holds a colon.
    if name.includes?(':')
      fail_at(name_line, name_col, "entity name '#{name}' cannot " \
                                   "hold a colon")
      return
    end
    if !skip_whitespace
      fail("expected whitespace after the entity name '#{name}'")
      return
    end
    if match?("SYSTEM") || match?("PUBLIC")
      fail("external entity '#{name}' refused: no SYSTEM or PUBLIC " \
           "identifier is read")
      return
    end
    value = parse_entity_value(name)
    return if failed?
    @entities[name] = value if !parameter && !@entities.has_key?(name)
    skip_whitespace
    unless consume(">")
      fail_at(start_line, start_col, "unclosed entity declaration for " \
                                     "'#{name}'")
    end
  end

  # The literal in quotes: character references are decoded now, a general
  # entity reference is checked and kept for the moment it is used.
  private def parse_entity_value(entity : String) : String
    start_line = @line
    start_col = @col
    quote = @pos < @len ? byte_at(@pos) : 0_u8
    if quote != 34_u8 && quote != 39_u8
      fail("entity value must be quoted")
      return "".as_tape
    end
    step
    parts = Array(String).new
    run_start = @pos
    while @pos < @len
      b = byte_at(@pos)
      if b == quote
        parts << slice_from(run_start)
        step
        return String.build { |w| parts.join(w) }
      elsif b == 60_u8
        fail("markup inside the value of entity '#{entity}' is not " \
             "supported")
        return "".as_tape
      elsif b == 37_u8
        # A `%` here starts a parameter entity reference, which the internal
        # subset does not allow inside a declaration; it was kept as text.
        fail("parameter entity references are not supported")
        return "".as_tape
      elsif b == 38_u8
        parts << slice_from(run_start)
        parts << parse_reference(0, true)
        return "".as_tape if failed?
        run_start = @pos
      elsif control?(b)
        fail_control(b)
        return "".as_tape
      else
        step
      end
    end
    fail_at(start_line, start_col, "unclosed entity value")
    "".as_tape
  end

  # -- comments, PIs, CDATA ------------------------------------------------

  private def parse_comment : TapeNode
    start_line = @line
    start_col = @col
    consume("<!--")
    run_start = @pos
    while @pos < @len
      if match?("-->")
        body = slice_from(run_start)
        consume("-->")
        return @tree.add(NodeType::Comment, "", body)
      elsif match?("--")
        fail("'--' is not allowed inside a comment")
        return @tree.add(NodeType::Comment, "", "")
      end
      b = byte_at(@pos)
      if control?(b)
        fail_control(b)
        return @tree.add(NodeType::Comment, "", "")
      end
      step
    end
    fail_at(start_line, start_col, "unclosed comment")
    @tree.add(NodeType::Comment, "", "")
  end

  private def parse_pi : TapeNode
    start_line = @line
    start_col = @col
    consume("<?")
    target = parse_name
    return @tree.add(NodeType::ProcessingInstruction, "", "") if failed?
    if tape_lower(target) == "xml"
      fail_at(start_line, start_col, "processing instruction target " \
                                     "'#{target}' is reserved")
      return @tree.add(NodeType::ProcessingInstruction, "", "")
    end
    # Namespaces in XML, section 7: no processing instruction target holds
    # a colon.
    if target.includes?(':')
      fail_at(start_line, start_col, "processing instruction target " \
                                     "'#{target}' cannot hold a colon")
      return @tree.add(NodeType::ProcessingInstruction, "", "")
    end
    return @tree.add(NodeType::ProcessingInstruction, target, "") if consume("?>")
    if !skip_whitespace
      fail("expected whitespace after the processing instruction target " \
           "'#{target}'")
      return @tree.add(NodeType::ProcessingInstruction, "", "")
    end
    run_start = @pos
    while @pos < @len
      if match?("?>")
        body = slice_from(run_start)
        consume("?>")
        return @tree.add(NodeType::ProcessingInstruction, target, body)
      end
      b = byte_at(@pos)
      if control?(b)
        fail_control(b)
        return @tree.add(NodeType::ProcessingInstruction, "", "")
      end
      step
    end
    fail_at(start_line, start_col, "unclosed processing instruction")
    @tree.add(NodeType::ProcessingInstruction, "", "")
  end

  private def parse_cdata : TapeNode
    start_line = @line
    start_col = @col
    consume("<![CDATA[")
    run_start = @pos
    while @pos < @len
      if match?("]]>")
        body = slice_from(run_start)
        consume("]]>")
        return @tree.add(NodeType::CData, "", body)
      end
      b = byte_at(@pos)
      if control?(b)
        fail_control(b)
        return @tree.add(NodeType::CData, "", "")
      end
      step
    end
    fail_at(start_line, start_col, "unclosed CDATA section")
    @tree.add(NodeType::CData, "", "")
  end

  # -- elements ------------------------------------------------------------

  private def parse_element(parent : TapeNode) : TapeNode
    start_line = @line
    start_col = @col
    step
    elem = @tree.add(NodeType::Element, "", "")
    @depth = @depth + 1
    if @depth > @max_depth
      fail_at(start_line, start_col, "elements nested deeper than #{@max_depth}")
      return elem
    end

    name = parse_name
    return elem if failed?
    return elem unless qualified_name?(name, start_line, start_col)
    elem = @tree.add(NodeType::Element, name, "")
    elem.parent = parent

    seen = TapeMap(String, Bool).new
    raw_names = Array(String).new
    raw_values = Array(String).new
    raw_lines = Array(Int32).new
    raw_cols = Array(Int32).new
    self_closing = false
    closed = false
    while @pos < @len
      had_space = skip_whitespace
      if consume("/>")
        self_closing = true
        closed = true
        break
      elsif consume(">")
        closed = true
        break
      end
      if !had_space
        fail("expected whitespace before the next attribute of " \
             "<#{name}>")
        return elem
      end
      attr_line = @line
      attr_col = @col
      attr_name = parse_name
      return elem if failed?
      return elem unless qualified_name?(attr_name, attr_line, attr_col)
      if seen.has_key?(attr_name)
        fail_at(attr_line, attr_col, "attribute '#{attr_name}' " \
                                     "given twice on <#{name}>")
        return elem
      end
      seen[attr_name] = true
      skip_whitespace
      if !consume("=")
        fail("expected '=' after the attribute name '#{attr_name}'")
        return elem
      end
      skip_whitespace
      attr_val = parse_attribute_value
      return elem if failed?
      attr_val = TapeParser.collapse_spaces(attr_val) if tokenized?(name, attr_name)
      raw_names << attr_name
      raw_values << attr_val
      raw_lines << attr_line
      raw_cols << attr_col
    end
    if !closed
      fail_at(start_line, start_col, "unclosed start tag <#{name}>")
      return elem
    end
    # An attribute the internal subset gives a default and the element was
    # not written with is taken as if it had been, at the element's `<`.
    @attribute_decls.each do |decl|
      next unless decl.default? && decl.element == name
      next if seen.has_key?(decl.name)
      raw_names << decl.name
      raw_values << decl.value
      raw_lines << start_line
      raw_cols << start_col
    end

    # With the tag read, its namespace declarations, written or defaulted,
    # are taken first, so a defaulted `xmlns:p` binds `p` as a written one
    # does; one the tag does not allow is refused now, as an undeclared
    # prefix is (and as the other library does).
    i = 0
    while i < raw_names.size
      attr_name = raw_names[i]
      attr_val = raw_values[i]
      attr_line = raw_lines[i]
      attr_col = raw_cols[i]
      # The uris of the `xml` and `xmlns` prefixes are theirs alone: no other
      # prefix and not the default namespace may be bound to either
      # (Namespaces in XML, 3). Only the `xml` uri on a prefix was refused.
      if attr_name == "xmlns"
        if attr_val == XML_NAMESPACE || attr_val == XMLNS_NAMESPACE
          fail_at(attr_line, attr_col, "the default namespace cannot be bound to the uri of the '#{attr_val == XML_NAMESPACE ? "xml" : "xmlns"}' prefix")
          return elem
        end
        elem.add_namespace(TapeNamespace.new("", attr_val))
      elsif attr_name.starts_with?("xmlns:")
        ns_prefix = attr_name[6, attr_name.bytesize - 6]
        if attr_val.empty?
          fail_at(attr_line, attr_col, "namespace prefix " \
                                       "'#{ns_prefix}' cannot be bound to an empty uri")
          return elem
        elsif ns_prefix == "xmlns"
          fail_at(attr_line, attr_col, "namespace prefix 'xmlns' is reserved and cannot be declared")
          return elem
        elsif ns_prefix == "xml" && attr_val != XML_NAMESPACE
          fail_at(attr_line, attr_col, "namespace prefix 'xml' cannot be bound to a uri other than '#{XML_NAMESPACE}'")
          return elem
        elsif ns_prefix != "xml" && attr_val == XML_NAMESPACE
          fail_at(attr_line, attr_col, "namespace prefix " \
                                       "'#{ns_prefix}' cannot be bound to the uri of the 'xml' " \
                                       "prefix")
          return elem
        elsif attr_val == XMLNS_NAMESPACE
          fail_at(attr_line, attr_col, "namespace prefix " \
                                       "'#{ns_prefix}' cannot be bound to the uri of the " \
                                       "'xmlns' prefix")
          return elem
        end
        elem.add_namespace(TapeNamespace.new(ns_prefix, attr_val))
      end
      i = i + 1
    end

    if !elem.prefix.empty? && elem.resolve_namespace_prefix(elem.prefix).nil?
      fail_at(start_line, start_col, "namespace prefix " \
                                     "'#{elem.prefix}' of <#{name}> is not declared")
      return elem
    end
    # Two spellings of one attribute - the same local name through two
    # prefixes bound to the same uri - are a duplicate as much as one
    # spelling twice.
    expanded = TapeMap(String, String).new
    i = 0
    while i < raw_names.size
      if raw_names[i] == "xmlns" || raw_names[i].starts_with?("xmlns:")
        i = i + 1
        next
      end
      attr = TapeAttribute.new(raw_names[i], raw_values[i])
      if !attr.prefix.empty?
        ns = elem.resolve_namespace_prefix(attr.prefix)
        if ns.nil?
          fail_at(start_line, start_col, "namespace prefix " \
                                         "'#{attr.prefix}' of attribute '#{attr.name}' " \
                                         "on <#{name}> is not declared")
          return elem
        end
        attr = TapeAttribute.new(raw_names[i], raw_values[i], ns.uri)
        key = String.build { |w| w << ns.uri << "\n" << attr.local_name }
        first = expanded[key]?
        if !first.nil?
          fail_at(raw_lines[i], raw_cols[i], "attribute " \
                                             "'#{attr.local_name}' in namespace '#{ns.uri}' " \
                                             "given twice on <#{name}>, as '#{first}' and " \
                                             "'#{attr.name}'")
          return elem
        end
        expanded[key] = attr.name
      end
      elem.add_attribute(attr)
      i = i + 1
    end

    if self_closing
      @depth = @depth - 1
      return elem
    end

    parts = Array(String).new
    run_start = @pos
    while @pos < @len
      b = byte_at(@pos)
      if b == 60_u8
        parts << slice_from(run_start)
        flush_text(elem, parts)
        parts = Array(String).new
        if match?("</")
          end_line = @line
          end_col = @col
          consume("</")
          closing = parse_name
          return elem if failed?
          skip_whitespace
          if !consume(">")
            fail("expected '>' to end the closing tag </#{closing}>")
            return elem
          end
          if closing != name
            fail_at(end_line, end_col, "mismatched closing tag: expected " \
                                       "</#{name}>, got </#{closing}>")
            return elem
          end
          @depth = @depth - 1
          return elem
        elsif match?("<!--")
          elem.append_parsed(parse_comment)
        elsif match?("<![CDATA[")
          elem.append_parsed(parse_cdata)
        elsif match?("<?")
          elem.append_parsed(parse_pi)
        else
          elem.append_parsed(parse_element(elem))
        end
        return elem if failed?
        run_start = @pos
      elsif b == 38_u8
        parts << slice_from(run_start)
        parts << parse_reference(0)
        return elem if failed?
        run_start = @pos
      elsif b == 93_u8 && match?("]]>")
        fail("']]>' is not allowed in text")
        return elem
      elsif control?(b)
        fail_control(b)
        return elem
      else
        step
      end
    end
    fail_at(start_line, start_col, "unclosed element <#{name}>")
    elem
  end

  # Whether the internal subset declares *attribute* of *element* with a
  # type other than CDATA.
  private def tokenized?(element : String, attribute : String) : Bool
    decl = attribute_decl(element, attribute)
    !decl.nil? && decl.tokenized?
  end

  private def attribute_decl(element : String,
                             attribute : String) : XmlAttributeDecl?
    @attribute_decls.each do |decl|
      return decl if decl.element == element && decl.name == attribute
    end
    nil
  end

  # A value whose declared type is not CDATA, normalised further (XML 1.0,
  # 3.3.3): the spaces at either end dropped and each run of them made one.
  # Only U+0020 counts; a tab a character reference wrote stays. Values
  # were kept as written: `x="  p   q  "` of an NMTOKENS `x` read as is.
  protected def self.collapse_spaces(value : String) : String
    ptr = value
    start = 0
    stop = value.bytesize
    while start < stop && ptr[start] == 32_u8
      start = start + 1
    end
    while stop > start && ptr[stop - 1] == 32_u8
      stop = stop - 1
    end
    kept = 0
    i = start
    while i < stop
      kept = kept + 1 unless ptr[i] == 32_u8 && ptr[i - 1] == 32_u8
      i = i + 1
    end
    return value if kept == value.bytesize
    String.build do |w|
      i = start
      while i < stop
        w.push(ptr[i]) if i == start || ptr[i] != 32_u8 || ptr[i - 1] != 32_u8
        i += 1
      end
    end
  end

  private def flush_text(elem : TapeNode, parts : Array(String)) : Nil
    return if parts.empty?
    text = String.build { |w| parts.join(w) }
    elem.append_parsed(@tree.add(NodeType::Text, "", text)) unless text.empty?
  end

  # A quoted value with references decoded and a literal tab or newline
  # read as a space (attribute-value normalisation, XML 1.0 3.3.3).
  private def parse_attribute_value : String
    start_line = @line
    start_col = @col
    quote = @pos < @len ? byte_at(@pos) : 0_u8
    if quote != 34_u8 && quote != 39_u8
      fail("attribute value must be quoted")
      return "".as_tape
    end
    step
    parts = Array(String).new
    run_start = @pos
    while @pos < @len
      b = byte_at(@pos)
      if b == quote
        parts << slice_from(run_start)
        step
        return String.build { |w| parts.join(w) }
      elsif b == 60_u8
        fail("raw '<' is not allowed in an attribute value")
        return "".as_tape
      elsif b == 38_u8
        parts << slice_from(run_start)
        parts << parse_reference(0, false, true)
        return "".as_tape if failed?
        run_start = @pos
      elsif b == 9_u8 || b == 10_u8
        parts << slice_from(run_start)
        parts << " ".as_tape
        step
        run_start = @pos
      elsif control?(b)
        fail_control(b)
        return "".as_tape
      else
        step
      end
    end
    fail_at(start_line, start_col, "unclosed attribute value")
    "".as_tape
  end

  # A quoted value taken as written: the XML declaration's.
  private def parse_quoted_literal : String
    start_line = @line
    start_col = @col
    quote = @pos < @len ? byte_at(@pos) : 0_u8
    if quote != 34_u8 && quote != 39_u8
      fail("expected a quoted value")
      return "".as_tape
    end
    step
    run_start = @pos
    while @pos < @len
      if byte_at(@pos) == quote
        value = slice_from(run_start)
        step
        return value
      end
      step
    end
    fail_at(start_line, start_col, "unclosed quote")
    "".as_tape
  end

  # -- references ----------------------------------------------------------

  # At an `&`: the text the reference stands for. With *keep_names*, an
  # entity reference is checked for shape and answered as written (`&name;`),
  # which is what an entity's own value keeps until it is used. With
  # *in_attribute*, the reference stands in an attribute value.
  private def parse_reference(depth : Int32, keep_names : Bool = false, in_attribute : Bool = false) : String
    ref_line = @line
    ref_col = @col
    ref_start = @pos
    step
    while @pos < @len && byte_at(@pos) != 59_u8 && !reference_stop?(byte_at(@pos))
      step
    end
    if @pos >= @len || byte_at(@pos) != 59_u8
      kind = @pos > ref_start + 1 && byte_at(ref_start + 1) == 35_u8 ? "character" : "entity"
      fail_at(ref_line, ref_col, "unterminated #{kind} reference " \
                                 "#{slice_from(ref_start)}: expected ';'")
      return "".as_tape
    end
    ref = @input[ref_start + 1, @pos - ref_start - 1]
    step
    if ref.empty?
      fail_at(ref_line, ref_col, "empty entity reference")
      return "".as_tape
    end
    if ref.starts_with?("#")
      cp = char_ref_value(ref)
      if cp < 0
        fail_at(ref_line, ref_col, "invalid character reference " \
                                   "'&#{ref};'")
        return "".as_tape
      elsif !xml_char?(cp)
        fail_at(ref_line, ref_col, "character reference &#{ref}; is " \
                                   "not an XML character")
        return "".as_tape
      end
      return String.build { |w| w << cp.unsafe_chr }
    end
    # `&a]b;` and `&0;` are no references: kept as written in an entity's
    # value, they were accepted wherever that entity went unused.
    if !TapeParser.name_shaped?(ref)
      fail_at(ref_line, ref_col, "'&#{ref};' is not a reference: " \
                                 "'#{ref}' is not a name")
      return "".as_tape
    end
    return slice_from(ref_start) if keep_names
    expand_entity(ref, ref_line, ref_col, depth, in_attribute)
  end

  private def expand_entity(name : String, line : Int32, col : Int32, depth : Int32, in_attribute : Bool) : String
    String.build { |w| expand_entity(name, line, col, depth, in_attribute, w) }
  end

  private def expand_entity(name : String, line : Int32, col : Int32, depth : Int32, in_attribute : Bool, text : String::Builder) : Nil
    if name == "lt"
      text << "<"
      return
    end
    if name == "gt"
      text << ">"
      return
    end
    if name == "amp"
      text << "&"
      return
    end
    if name == "apos"
      text << "'"
      return
    end
    if name == "quot"
      text << "\""
      return
    end
    value = @entities[name]?
    if value.nil?
      fail_at(line, col, "undefined entity reference &#{name};")
      return
    end
    if depth >= 10
      fail_at(line, col, "entity &#{name}; expands more than 10 " \
                         "levels deep")
      return
    end
    @expansions = @expansions + 1
    if @expansions > @max_expansions
      fail_at(line, col, "entity expansion limit of #{@max_expansions} " \
                         "exceeded at &#{name};")
      return
    end
    # Counting expansions alone let one large entity used a thousand times
    # make a thousand times the document: 1 MB of input read as 1 GB of text.
    @expanded_bytes = @expanded_bytes + value.bytesize
    if @expanded_bytes > @max_expanded_bytes
      fail_at(line, col, "entity expansion past #{@max_expanded_bytes} " \
                         "bytes at &#{name};")
      return
    end
    # The replacement text is read where the reference stands, and it was
    # read as plain text everywhere. In an attribute value a `<` in it is an
    # error (XML 1.0, "No < in Attribute Values") and its tabs and line ends
    # are spaces (3.3.3); in content a `<` is markup, which is not supported,
    # and `]]>` is refused as it is in text.
    if value.includes?('<')
      if in_attribute
        fail_at(line, col, "entity &#{name}; holds a '<', which an " \
                           "attribute value cannot")
      else
        fail_at(line, col, "markup inside the value of entity " \
                           "'#{name}' is not supported")
      end
      return
    end
    if !in_attribute && TapeParser.contains_end?(value)
      fail_at(line, col, "']]>' is not allowed in text, nor in the value of " \
                         "entity '#{name}'")
      return
    end
    unless value.includes?('&')
      text << (in_attribute ? TapeParser.attribute_spaces(value) : value)
      return
    end

    # The replacement text is read as content: a character reference is
    # decoded, an entity reference expanded a level deeper.
    ptr = value
    len = value.bytesize
    run_start = 0
    i = 0
    while i < len
      if ptr[i] == 38_u8
        literal = value[run_start, i - run_start]
        text << (in_attribute ? TapeParser.attribute_spaces(literal) : literal)
        semi = i + 1
        while semi < len && ptr[semi] != 59_u8 && !reference_stop?(ptr[semi])
          semi = semi + 1
        end
        if semi >= len || ptr[semi] != 59_u8
          fail_at(line, col, "unterminated reference " \
                             "#{value[i, semi - i]} in the value of entity " \
                             "'#{name}': expected ';'")
          return
        end
        ref = value[i + 1, semi - i - 1]
        if ref.empty?
          fail_at(line, col, "empty entity reference in the value of entity " \
                             "'#{name}'")
          return
        elsif ref.starts_with?("#")
          cp = char_ref_value(ref)
          if cp < 0
            fail_at(line, col, "invalid character reference " \
                               "'&#{ref};' in the value of entity '#{name}'")
            return
          elsif !xml_char?(cp)
            fail_at(line, col, "character reference &#{ref}; in the " \
                               "value of entity '#{name}' is not an XML character")
            return
          end
          text << String.build { |w| w << cp.unsafe_chr }
        else
          expand_entity(ref, line, col, depth + 1, in_attribute, text)
          return if failed?
        end
        i = semi + 1
        run_start = i
      else
        i = i + 1
      end
    end
    literal = value[run_start, len - run_start]
    text << (in_attribute ? TapeParser.attribute_spaces(literal) : literal)
  end

  # An entity's replacement text in an attribute value: a tab, newline or
  # carriage return in it is a space, as one written in the value is. One
  # that a character reference in the replacement text names is not.
  protected def self.attribute_spaces(text : String) : String
    ptr = text
    len = text.bytesize
    i = 0
    while i < len && ptr[i] != 9_u8 && ptr[i] != 10_u8 && ptr[i] != 13_u8
      i = i + 1
    end
    return text if i == len
    String.build do |w|
      j = 0
      while j < len
        b = ptr[j]
        w.push(b == 9_u8 || b == 10_u8 || b == 13_u8 ? 32_u8 : b)
        j += 1
      end
    end
  end

  protected def self.contains_end?(text : String) : Bool
    i = 0
    while i + 2 < text.bytesize
      return true if text[i, 3] == "]]>"
      i += 1
    end
    false
  end

  # -- names ---------------------------------------------------------------

  private def parse_name : String
    name = parse_name?
    return name unless name.nil?
    if @pos >= @len
      fail("expected a name, found the end of the input")
    else
      fail("expected a name, found #{found_here}")
    end
    "".as_tape
  end

  # The character at the cursor, for a sentence: `'x'`, or its code point
  # (`U+00B7`) where it does not print as itself.
  private def found_here : String
    cp = code_point_at(@input, @len, @pos)
    cp = byte_at(@pos).to_i32 if cp < 0
    cp >= 32 && cp < 127 ? "'#{cp.unsafe_chr}'" : "U+#{TapeParser.hex4(cp)}"
  end

  # An element or attribute name is `local` or `prefix:local`, with neither
  # part empty (Namespaces in XML, productions [7] and [8]): a colon first,
  # last, or twice is refused with the name's line and column, and so is a
  # local part that does not start as a name does (`p:-a`, `p:1`), which was
  # taken.
  private def qualified_name?(name : String, line : Int32, col : Int32) : Bool
    ptr = name
    len = name.bytesize
    colons = 0
    colon_at = 0
    i = 0
    while i < len
      if ptr[i] == 58_u8
        colons = colons + 1
        colon_at = i
      end
      i = i + 1
    end
    return true if colons == 0
    if colons == 1 && ptr[0] != 58_u8 && ptr[len - 1] != 58_u8 && TapeParser.name_start?(code_point_at(ptr, len, colon_at + 1))
      return true
    end
    fail_at(line, col, "'#{name}' is not a qualified name: a name " \
                       "is 'local' or 'prefix:local'")
    false
  end

  # XML 1.0 (fifth edition), production [4]: the characters that start a
  # name, by code point. Any byte past 0x7F was taken as starting and
  # continuing one, so `<a×b/>` read as an element named "a×b", a no-break
  # space after a name became part of it, and `<·a/>` was an element.
  protected def self.name_start?(cp : Int32) : Bool
    return (cp >= 97 && cp <= 122) || (cp >= 65 && cp <= 90) || cp == 95 || cp == 58 if cp < 0xC0
    return cp != 0xD7 && cp != 0xF7 if cp <= 0x2FF
    return cp != 0x37E if cp >= 0x370 && cp <= 0x1FFF
    (cp >= 0x200C && cp <= 0x200D) || (cp >= 0x2070 && cp <= 0x218F) || (cp >= 0x2C00 && cp <= 0x2FEF) ||
      (cp >= 0x3001 && cp <= 0xD7FF) || (cp >= 0xF900 && cp <= 0xFDCF) || (cp >= 0xFDF0 && cp <= 0xFFFD) ||
      (cp >= 0x10000 && cp <= 0xEFFFF)
  end

  # Production [4a]: digits, `-`, `.`, U+00B7, the combining marks
  # U+0300-036F and U+203F-2040 continue a name without starting one.
  protected def self.name_char?(cp : Int32) : Bool
    return true if name_start?(cp)
    (cp >= 48 && cp <= 57) || cp == 45 || cp == 46 || cp == 0xB7 || (cp >= 0x300 && cp <= 0x36F) || cp == 0x203F || cp == 0x2040
  end

  # Whether all of *text* is one name.
  def self.name_shaped?(text : String) : Bool
    ptr = text
    len = text.bytesize
    return false if len == 0
    i = 0
    while i < len
      cp = code_point_at(ptr, len, i)
      return false unless i == 0 ? name_start?(cp) : name_char?(cp)
      i = i + utf8_width(ptr[i])
    end
    true
  end

  # A name, or with *token* a name token (production [7]), which any
  # character that continues a name may start.
  private def parse_name?(token : Bool = false) : String?
    ptr = @input
    start = @pos
    while @pos < @len
      cp = code_point_at(ptr, @len, @pos)
      break unless @pos == start && !token ? TapeParser.name_start?(cp) : TapeParser.name_char?(cp)
      width = utf8_width(ptr[@pos])
      while width > 0 && !failed?
        step
        width = width - 1
      end
    end
    # A byte that is not part of a character ends the name where it stands
    # and is refused there for what it is, as it was when it was read as
    # part of the name.
    if @pos == @bad_at
      step
      return nil
    end
    return nil if failed? || @pos == start
    slice_from(start)
  end
end

pub def parse(xml : String, max_depth : Int32 = 256,
              max_entity_expansions : Int32 = 1000) : TapeNode
  TapeParser.new(xml, max_depth, max_entity_expansions).parse
end

pub def parse?(xml : String, max_depth : Int32 = 256,
               max_entity_expansions : Int32 = 1000) : TapeNode?
  TapeParser.new(xml, max_depth, max_entity_expansions).parse?
end

pub def escape(text : String, ascii : Bool = false) : String
  String.build { |w| escape(text, w, ascii) }
end

pub def escape(text : String, writer : String::Builder,
               ascii : Bool = false) : Nil
  escape_bytes(text, false, ascii, writer)
end

pub def escape_attribute(text : String, ascii : Bool = false) : String
  String.build { |w| escape_attribute(text, w, ascii) }
end

pub def escape_attribute(text : String, writer : String::Builder,
                         ascii : Bool = false) : Nil
  escape_bytes(text, true, ascii, writer)
end

def escape_bytes(text : String, attribute : Bool, ascii : Bool,
                 parts : String::Builder) : Nil
  ptr = text
  len = text.bytesize
  run_start = 0
  i = 0
  while i < len
    b = ptr[i]
    if ascii && b >= 128_u8
      width = b >= 0xF0_u8 ? 4 : (b >= 0xE0_u8 ? 3 : (b >= 0xC0_u8 ? 2 : 1))
      width = len - i if i + width > len
      cp = width == 1 ? b.to_i32 : (b & (width == 2 ? 0x1F_u8 : (width == 3 ? 0x0F_u8 : 0x07_u8))).to_i32
      k = 1
      while k < width
        cp = (cp << 6) | (ptr[i + k] & 0x3F_u8).to_i32
        k = k + 1
      end
      parts << text[run_start, i - run_start] if i > run_start
      parts << "&#"
      parts.append_int(cp)
      parts << ";"
      i = i + width
      run_start = i
      next
    end
    replacement = if b == 38_u8
                    "&amp;"
                  elsif b == 60_u8
                    "&lt;"
                  elsif b == 62_u8
                    "&gt;"
                  elsif b == 13_u8
                    "&#13;"
                  elsif attribute && b == 34_u8
                    "&quot;"
                  elsif attribute && b == 9_u8
                    "&#9;"
                  elsif attribute && b == 10_u8
                    "&#10;"
                  else
                    ""
                  end
    if !replacement.empty?
      parts << text[run_start, i - run_start] if i > run_start
      parts << replacement
      run_start = i + 1
    end
    i = i + 1
  end
  parts << text[run_start, len - run_start] if len > run_start
  nil
end

# -- the module's functions --------------------------------------------------

# Whether *cp* is a character XML 1.0 allows in a document (production [2]).
pub def xml_char?(cp : Int32) : Bool
  return true if cp == 9 || cp == 10 || cp == 13
  return true if cp >= 0x20 && cp <= 0xD7FF
  return true if cp >= 0xE000 && cp <= 0xFFFD
  cp >= 0x10000 && cp <= 0x10FFFF
end

# The code point the UTF-8 character at byte *i* of *ptr* (*len* bytes)
# encodes, or -1 where the bytes there are not one (an overlong form and
# one past U+10FFFF included); the parser refuses those where its cursor
# reaches them, and `name_shaped?` does not take them for a name.
def code_point_at(ptr : String, len : Int32,
                  i : Int32) : Int32
  b = ptr[i]
  return b.to_i32 if b < 0x80_u8
  n = utf8_width(b)
  return -1 if b < 0xC2_u8 || b >= 0xF5_u8 || i + n > len
  cp = (b & (n == 2 ? 0x1F_u8 : (n == 3 ? 0x0F_u8 : 0x07_u8))).to_i32
  k = 1
  while k < n
    c = ptr[i + k]
    return -1 if (c & 0xC0_u8) != 0x80_u8
    cp = (cp << 6) | (c & 0x3F_u8).to_i32
    k = k + 1
  end
  return -1 if (n == 3 && cp < 0x800) || (n == 4 && (cp < 0x10000 || cp > 0x10FFFF))
  cp
end

# How many bytes the UTF-8 character that starts with *b* takes.
def utf8_width(b : UInt8) : Int32
  b < 0x80_u8 ? 1 : (b >= 0xF0_u8 ? 4 : (b >= 0xE0_u8 ? 3 : 2))
end

# The five predefined entities and character references decoded, the same
# way and with the same refusals as inside a document; nil where `unescape`
# panics.
pub def unescape?(text : String) : String?
  result = unescape_or_error(text)
  result[1].empty? ? result[0] : nil
end

pub def unescape(text : String) : String
  result = unescape_or_error(text)
  raise result[1] unless result[1].empty?
  result[0]
end

# The decoded text and "", or "" and the sentence it was refused with.
def unescape_or_error(text : String) : Tuple(String, String)
  return {text, ""} unless text.includes?("&")
  ptr = text
  len = text.bytesize
  parts = String::Builder.new(len)
  run_start = 0
  line = 1
  col = 1
  i = 0
  while i < len
    b = ptr[i]
    if b == 38_u8
      parts << text[run_start, i - run_start]
      semi = i + 1
      while semi < len && ptr[semi] != 59_u8 && !reference_stop?(ptr[semi])
        semi = semi + 1
      end
      if semi >= len || ptr[semi] != 59_u8
        kind = semi > i + 1 && ptr[i + 1] == 35_u8 ? "character" : "entity"
        return {"", "unterminated #{kind} reference #{text[i, semi - i]}: expected ';' at line #{line}, column #{col}"}
      end
      ref = text[i + 1, semi - i - 1]
      if ref.empty?
        return {"", "empty entity reference at line #{line}, column #{col}"}
      elsif ref.starts_with?("#")
        cp = char_ref_value(ref)
        return {"", "invalid character reference '&#{ref};' at line #{line}, column #{col}"} if cp < 0
        return {"", "character reference &#{ref}; is not an XML character at line #{line}, column #{col}"} unless xml_char?(cp)
        parts << cp.unsafe_chr
      elsif ref == "lt"
        parts << "<"
      elsif ref == "gt"
        parts << ">"
      elsif ref == "amp"
        parts << "&"
      elsif ref == "apos"
        parts << "'"
      elsif ref == "quot"
        parts << "\""
      else
        return {"", "undefined entity reference &#{ref}; at line #{line}, column #{col}"}
      end
      col = col + (semi - i + 1)
      i = semi + 1
      run_start = i
    else
      if b == 10_u8
        line = line + 1
        col = 1
      elsif (b & 192_u8) != 128_u8
        col = col + 1
      end
      i = i + 1
    end
  end
  parts << text[run_start, len - run_start]
  {parts.finish, ""}
end

# A byte that cannot be part of a reference, so a reference reaching one
# without its `;` is unterminated.
def reference_stop?(b : UInt8) : Bool
  b == 32_u8 || b == 9_u8 || b == 10_u8 || b == 13_u8 || b == 60_u8 || b == 62_u8 || b == 38_u8 || b == 34_u8 || b == 39_u8
end

# The code point a character reference names, given the text between its
# `&` and `;` (`#65`, `#x41`); -1 where that is not digits. Accumulation
# stops past U+10FFFF, so a long reference is merely too large.
def char_ref_value(ref : String | String) : Int32
  ptr = ref
  len = ref.bytesize
  i = 1
  hex = i < len && ptr[i] == 120_u8
  i = i + 1 if hex
  return -1 if i >= len
  cp = 0
  while i < len
    d = digit_value(ptr[i], hex)
    return -1 if d < 0
    cp = cp * (hex ? 16 : 10) + d if cp <= 0x10FFFF
    i = i + 1
  end
  cp
end

def digit_value(b : UInt8, hex : Bool) : Int32
  return (b - 48_u8).to_i32 if b >= 48_u8 && b <= 57_u8
  return -1 unless hex
  return (b - 65_u8).to_i32 + 10 if b >= 65_u8 && b <= 70_u8
  return (b - 97_u8).to_i32 + 10 if b >= 97_u8 && b <= 102_u8
  -1
end
