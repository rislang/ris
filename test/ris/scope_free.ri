# Goose's every scope freeing: a loop round or block that keeps nothing
# frees what it put on the tape; one that keeps something does not.
def used : UInt64
  IyiHeap.read64(IyiRegion.tape &+ IyiRegion::OFF_CURSOR)
end

tape do
  before = used
  i = 0
  while i < 100_000
    line = "round #{i}"
    text = Str.build { |w| w.append_int(i) }
    puts line if text == "99999"
    i += 1
  end
  puts "while frees: #{used == before}"

  before = used
  3.times do |n|
    big = Str::Builder.new(8)
    200_000.times { big.push(65_u8) }
    puts "block wrote #{big.length}" if n == 2
  end
  puts "block frees: #{used == before}"

  kept = Ary(Str).new(4)
  before = used
  j = 0
  while j < 3
    kept.push(Str.build { |w| w.append_int(j) })
    j += 1
  end
  puts "kept stays: #{used != before} #{kept[2] == "2"}"

  sink = Str::Builder.new(4)
  [1, 2, 3].each { |k| sink.append_int(k) }
  puts sink.finish
end

# A def frees its temporaries when its result is no tape value.
def count_digits(n : Int32) : Int32
  text = Str.build { |w| w.append_int(n) }
  first = text[0, 1]
  text.bytesize
end

def number(n : Int32) : Str
  Str.build { |w| w.append_int(n) }
end

tape do
  before = used
  total = count_digits(12345)
  puts "def frees: #{used == before} #{total}"
  kept = number(42)
  puts "result stays: #{used != before} #{kept}"
end
