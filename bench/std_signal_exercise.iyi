# Exercises `std/signal`.
#
#     ./bin/iyi run bench/std_signal_exercise.iyi
#     ./bin/iyi run bench/std_signal_exercise.iyi external   # waits for TERM
#
# The program sends itself the signals it waits for: `kill` on Linux,
# `pthread_kill` on darwin, and on Windows a Ctrl-Break into a console of its own, so the
# event reaches this process and not the shell that started it. Every wait
# has a watchdog beside it, so a signal that never arrives is a failure
# and not a hang.

module bench/std_signal_exercise

import std/signal::{Signal}
import std/socket::{IyiSocket}

{% if flag?(:win32) %}
  lib LibKernel32
    fun FreeConsole : Int32
    fun AllocConsole : Int32
    fun SetStdHandle(which : Int32, handle : Void*) : Int32
    fun GenerateConsoleCtrlEvent(event : Int32, group : Int32) : Int32
  end
{% elsif flag?(:darwin) %}
  # The thread layer's own two, so the exercise adds nothing to the
  # program's floor (bench/floor_base.sh).
  lib LibC
    fun pthread_self : Void*
    fun pthread_kill(thread : Void*, signal : Int32) : Int32
  end
{% end %}

pub struct TimedOut
  def initialize
  end
end

impl Error for TimedOut
  def message : String
    "a signal did not arrive within five seconds"
  end
end

# How a task that has seen enough ends the `Signal.each` beside it.
pub struct Handled
  def initialize
  end
end

impl Error for Handled
  def message : String
    "the handler's task has seen what it waited for"
  end
end

def fail(message : String) : NoReturn
  puts "FAIL: #{message}"
  __iyi_exit(1)
end

# A console of this process's own, keeping the output where it was.
def own_console : Nil
  {% if flag?(:win32) %}
    output = ::LibC.GetStdHandle(-11)
    error = ::LibC.GetStdHandle(-12)
    LibKernel32.FreeConsole
    fail("AllocConsole refused") if LibKernel32.AllocConsole == 0
    LibKernel32.SetStdHandle(-11, output)
    LibKernel32.SetStdHandle(-12, error)
  {% end %}
end

# INT, the one signal every platform can send itself: Windows' Ctrl-Break.
def interrupt_self : Nil
  {% if flag?(:win32) %}
    fail("GenerateConsoleCtrlEvent refused") if LibKernel32.GenerateConsoleCtrlEvent(1, 0) == 0
  {% elsif flag?(:darwin) %}
    LibC.pthread_kill(LibC.pthread_self, 2)
  {% elsif flag?(:x86_64) %}
    __iyi_conc_syscall3(62_i64, __iyi_conc_syscall3(39_i64, 0_i64, 0_i64, 0_i64), 2_i64, 0_i64)
  {% else %}
    __iyi_conc_syscall3(129_i64, __iyi_conc_syscall3(172_i64, 0_i64, 0_i64, 0_i64), 2_i64, 0_i64)
  {% end %}
end

# *signal* sent to this process; Windows can send itself INT alone.
def send_self(signal : Signal) : Nil
  {% if flag?(:win32) %}
    fail("Windows sends itself INT alone, not #{signal}") unless signal == Signal::INT
    interrupt_self
  {% elsif flag?(:darwin) %}
    LibC.pthread_kill(LibC.pthread_self, signal.value)
  {% elsif flag?(:x86_64) %}
    __iyi_conc_syscall3(62_i64, __iyi_conc_syscall3(39_i64, 0_i64, 0_i64, 0_i64), signal.value.to_i64, 0_i64)
  {% else %}
    __iyi_conc_syscall3(129_i64, __iyi_conc_syscall3(172_i64, 0_i64, 0_i64, 0_i64), signal.value.to_i64, 0_i64)
  {% end %}
end

# Fails the group unless *done* turns true within five seconds; returns as
# soon as it does.
def watchdog(done : -> Bool) : Nil | Cancelled | TimedOut
  500.times do
    return nil if done.call
    slept = sleep(10)
    return slept if slept.is_a?(Cancelled)
  end
  # Said here: the group's failure cancels the waiter, and the waiter's
  # own report would only say it was cancelled.
  puts "FAIL: #{TimedOut.new.message}"
  TimedOut.new
end

# A waiter's answer as text: a task answers it from its `value`, as a
# task shares no local with its spawner (SPEC 5.1).
def waited_text(answer) : String
  answer.is_a?(Signal) ? answer.to_s : "cancelled"
end

# One handled signal, posted from the handler's task to its checker.
pub struct SeenProbe
  getter value : Int32

  def initialize(@value : Int32)
  end
end

own_console

if Program.args.size > 0 && Program.args[0] == "external"
  # The shell's side: the waiter is parked, which installs the handler,
  # before "ready" is printed; the shell sends TERM and reads the rest.
  got = group do |g|
    waiter = g.spawn { Signal.wait(Signal::TERM) }
    g.spawn do
      sleep(50)
      puts "ready"
      0
    end
    waited_text(waiter.value)
  end
  puts "stopped on #{got}"
  __iyi_exit(0)
end

# The shell's side of a reset: an ignored signal leaves the process alive,
# and the same signal after `Signal.reset` ends it - TERM on Linux and
# darwin, which the shell reads as death by TERM, and on Windows a
# Ctrl-Break into the program's own console.
def reset_probe : Signal
  {% if flag?(:win32) %}
    Signal::INT
  {% else %}
    Signal::TERM
  {% end %}
end

if Program.args.size > 0 && Program.args[0] == "reset"
  Signal.ignore(reset_probe)
  send_self(reset_probe)
  sleep(50)
  puts "an ignored #{reset_probe} left the process alive"
  Signal.reset(reset_probe)
  send_self(reset_probe)
  sleep(200)
  puts "the process outlived #{reset_probe} after its reset"
  __iyi_exit(0)
end

puts "== a signal the program sends itself wakes the waiting fiber"
got = group do |g|
  waiter = g.spawn { Signal.wait(Signal::INT, Signal::TERM) }
  g.spawn do
    sleep(20)
    interrupt_self
    0
  end
  g.spawn { watchdog(-> { waiter.done? }) }
  waited_text(waiter.value)
end
fail("woke with #{got}") unless got == "INT"
puts "  Signal.wait answered INT, and the process lived"

puts "== one that arrives with nobody waiting is kept"
interrupt_self
sleep(50)
started = __iyi_monotonic_ns
kept = group do |g|
  waiter = g.spawn { Signal.wait(Signal::INT) }
  g.spawn { watchdog(-> { waiter.done? }) }
  waited_text(waiter.value)
end
fail("the kept signal was #{kept}") unless kept == "INT"
waited_ms = (__iyi_monotonic_ns - started) // 1000000_i64
fail("the kept signal took #{waited_ms} ms to be taken") if waited_ms > 1000
puts "  the next wait answered at once"
# Twice in a row and taken once: a pending signal is a bit, not a count.
# Windows added each Ctrl-Break to the arrivals, and two INT bits added
# are one bit higher: the wait after them never answered, so the first
# has a watchdog beside it.
interrupt_self
interrupt_self
sleep(50)
once = group do |g|
  waiter = g.spawn { Signal.wait(Signal::INT) }
  g.spawn { watchdog(-> { waiter.done? }) }
  waited_text(waiter.value)
end
fail("the first of two answered #{once}") unless once == "INT"
# The first task to mark *first* says which came first: 1 the wait,
# 2 the sender.
first = Atomic(Int32).new(0)
group do |g|
  g.spawn do
    signal = Signal.wait(Signal::INT)
    first.compare_and_set(0, 1)
    signal.is_a?(Cancelled) ? signal : 0
  end
  g.spawn do
    sleep(100)
    first.compare_and_set(0, 2)
    interrupt_self
    0
  end
end
second = first.get == 2 ? "waited for the third" : "taken before the third was sent"
fail("two arrivals were #{second}") unless second == "waited for the third"
puts "  two arrivals nobody waited for are one"

puts "== a graceful stop: the signal stops the listener's task, the group joins"
# The listener's task owns the socket; the signal's waiter holds only its
# task handle, the Share stop handle, and cancels it: the accept answers
# Cancelled and the owner closes the listener (SPEC 5.1).
server = IyiSocket.listen("127.0.0.1", 0)
port = server.local_port
answered = ""
served = 0
group do |g|
  listener = g.spawn do
    count = 0
    while true
      client = server.accept
      break unless client.is_a?(IyiSocket)
      request = client.read
      client.write("served #{request}") if request.is_a?(String)
      client.close
      count = count + 1
    end
    server.close
    count
  end
  stopper = g.spawn do
    signal = Signal.wait(Signal::INT, Signal::TERM)
    next signal if signal.is_a?(Cancelled)
    listener.cancel
    0
  end
  asker = g.spawn do
    client = IyiSocket.connect("127.0.0.1", port).or_panic
    client.write("one")
    reply = client.read
    client.close
    interrupt_self
    reply.is_a?(String) ? reply : ""
  end
  g.spawn { watchdog(-> { stopper.done? }) }
  reply = asker.value
  answered = reply if reply.is_a?(String)
  count = listener.value
  served = count if count.is_a?(Int32)
end
fail("the request in flight was answered #{answered.inspect}") unless answered == "served one"
fail("served #{served}") unless served == 1
puts "  one request served, the listener closed, the group joined"

# Two signals a task's handler takes, on Windows the one it can send.
def first_probe : Signal
  {% if flag?(:win32) %}
    Signal::INT
  {% else %}
    Signal::USR1
  {% end %}
end

def second_probe : Signal
  {% if flag?(:win32) %}
    Signal::INT
  {% else %}
    Signal::USR2
  {% end %}
end

puts "== a task's handler, and signals ignored"
handled = [] of String
group do |g|
  g.spawn do
    Signal.each(first_probe, second_probe) { |signal| RisBoard.post(SeenProbe.new(signal.value)) }
  end
  g.spawn do
    sleep(20)
    send_self(first_probe)
    sleep(50)
    send_self(second_probe)
    0
  end
  2.times do
    seen = RisBoard.take(SeenProbe, 5000_i64)
    break unless seen.is_a?(Tuple) && (probe = seen[0])
    handled << Signal.new(probe.value).to_s
  end
  g.cancel_children
end
fail("the handler saw #{handled}") unless handled == [first_probe.to_s, second_probe.to_s]
puts "  Signal.each ran its block for #{handled.join(" and ")}, and ended with its task"

# Kept with nobody waiting, then ignored: the arrival is dropped with it,
# and the next wait - which takes the signal back - waits for a new one.
send_self(second_probe)
sleep(50)
Signal.ignore(second_probe)
marked = Atomic(Int32).new(0)
group do |g|
  waiter = g.spawn do
    signal = Signal.wait(second_probe)
    marked.compare_and_set(0, 1)
    signal.is_a?(Cancelled) ? signal : 0
  end
  g.spawn do
    sleep(100)
    marked.compare_and_set(0, 2)
    send_self(second_probe)
    0
  end
  g.spawn { watchdog(-> { waiter.done? }) }
end
after_ignore = marked.get == 2 ? "waited for the next" : "taken before the next was sent"
fail("an arrival kept before the ignore was #{after_ignore}") unless after_ignore == "waited for the next"
puts "  an arrival kept before the ignore was dropped, and a wait took the signal back"

# Ignored with no handler of this module's: its default, the end of the
# process, is not taken.
Signal.ignore(first_probe)
send_self(first_probe)
sleep(50)
puts "  an ignored #{first_probe} left the process alive"
{% if flag?(:win32) %}
  assert_panics("has no Windows console event") { Signal.wait(Signal::USR1) }
  assert_panics("Windows can ignore INT (Ctrl-C and Ctrl-Break) alone, not TERM") { Signal.ignore(Signal::TERM) }
  puts "  Windows refuses USR1 and an ignored TERM by name"
{% end %}

puts "== a cancelled task's wait answers Cancelled"
outcome = ""
group do |g|
  waiter = g.spawn { Signal.wait(Signal::TERM) }
  g.spawn do
    sleep(20)
    TimedOut.new
  end
  outcome = waited_text(waiter.value)
end
fail("the wait answered #{outcome}") unless outcome == "cancelled"
puts "  the waiter left with Cancelled"

puts "ALL CHECKS PASSED"
