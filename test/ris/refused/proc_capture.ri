module test/ris/refused/proc_capture

import std/int

@[OnTape]
struct Resp
  getter id : Int64
  getter user : Str

  def initialize(@id : Int64, @user : Str)
  end
end

def make : Resp
  Resp.new(1_i64, Str.build { |s| s.push(97_u8) })
end

# A proc may be called after the scope has ended.
tape do
  r = make
  callback = -> { r.id }
  puts callback.call
end
