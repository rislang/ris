module test/ris/allowed

import std/int

@[OnTape]
struct Resp
  getter id : Int64
  getter user : Tape::String

  def initialize(@id : Int64, @user : Tape::String)
  end
end

def make : Resp
  Resp.new(1_i64, Tape::String.build { |s| s.push(97_u8) })
end

# Everything here stays inside the scope, and compiles.
@[OnTape]
struct Page
  getter items : Tape::Array(Resp)

  def initialize(@items : Tape::Array(Resp))
  end
end

def total(p : Page) : Int64
  sum = 0_i64
  p.items.each { |r| sum += r.id }
  sum
end

copied = ""
Tape.run do
  items = Tape::Array(Resp).new
  items.push(make)
  items.push(make)
  page = Page.new(items)
  puts total(page)
  copied = page.items[0].user.to_s
end
puts copied
