module test/ris/pipe_wait

import std/io
import std/text

# A pipe's writer waits while the kernel's room is full, then every byte
# arrives whole and in order; closing the writer is the reader's end, and
# a write after the reader closed is refused, not a SIGPIPE.
# Events on the board: 1 for "all written", 100 for "reading".
record PipeEvent, code : Int32

pipe_in, pipe_out = IyiIO.pipe
group do |g|
  g.spawn do
    piece = Str.build(16384) { |w| 1024.times { w << "0123456789abcdef" } }
    64.times { pipe_out.write(piece) }
    RisBoard.post(PipeEvent.new(1))
    pipe_out.close
    0
  end
  g.spawn do
    sleep(20)
    RisBoard.post(PipeEvent.new(100))
    total = 0
    while (got = pipe_in.read_str(65536)).bytesize > 0
      got.each_byte do |byte|
        raise "byte #{total}" unless byte == "0123456789abcdef".byte_at(total % 16)
        total += 1
      end
    end
    raise "total #{total}" unless total == 16384 * 64
    pipe_in.close
    0
  end
end
events = [] of Int32
2.times do
  event = RisBoard.poll(PipeEvent)
  next if event.is_a?(Cancelled)
  if got = event[0]
    events << got.code
  end
end
raise "writer waits: #{events.join(",")}" unless events == [100, 1]
gone_in, gone_out = IyiIO.pipe
gone_in.close
outcome = group do |g|
  g.spawn do
    gone_out.write("x")
    gone_out.flush
    0
  end.value
end
refused = outcome.is_a?(Panicked) &&
  outcome.message.includes?("reader is closed")
raise "closed reader: #{outcome.inspect}" unless refused
puts "PASS: pipe writer waits"
