# escape: HTML escaping ten million short texts into a tape writer.
# Prints a checksum; report tape memory with RIS_TAPE_STATS=1.
#
#   ./bin/ris build --release -o escape samples/ris/escape.ri
#   RIS_TAPE_STATS=1 ./escape

module samples/escape_bench

import std/html::{HTML}

N = 10000000
TEXTS = Array(String){
  "Mari Maasikas, Tallinn",
  "Tom & Jerry <cartoon>",
  "a plain sentence of words",
}

sum = 0_i64
i = 0
while i < N
  tape do
    w = String::Builder.new(64)
    HTML.escape(TEXTS[i % 3], w)
    sum += w.length
  end
  i += 1
end
puts sum
